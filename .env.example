# MODRISS environment template
# Copy to .env for local overrides: cp .env.example .env
# Never commit .env: it may contain secrets.
#
# Docker Compose:
# - Run from the repository root: docker compose up --build
# - Backend loads this file via deploy/compose.yaml env_file (../.env)
# - After editing credentials, recreate the backend:
#     docker compose up --build --force-recreate backend
# - Shell exports (e.g. $env:OPENAI_COMPATIBLE_API_KEY) override compose ${VAR} substitution
#   when you run from the repo root; env_file avoids that for the backend container.

# -----------------------------------------------------------------------------
# Compose / infrastructure ports
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
CADDY_HTTP_PORT=8088
BACKEND_PORT=8080
FRONTEND_PORT=8082
LANDING_PORT=8083
ADMIN_PORT=8084
AWS_EMULATOR_GATEWAY_PORT=4566
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# -----------------------------------------------------------------------------
# Diagram editor
# -----------------------------------------------------------------------------
# The modeling frontend uses the AntV G6 canvas renderer.
MODRISS_DIAGRAM_RENDERER=antv-g6

# -----------------------------------------------------------------------------
# PostgreSQL (required)
# -----------------------------------------------------------------------------
POSTGRES_DB=modriss
POSTGRES_USER=modriss
POSTGRES_PASSWORD=modriss

MODRISS_DB_URL=jdbc:postgresql://localhost:5432/modriss
MODRISS_DB_USER=modriss
MODRISS_DB_PASSWORD=modriss
MODRISS_DB_MAX_POOL_SIZE=10
MODRISS_DB_MIN_IDLE=2

# -----------------------------------------------------------------------------
# Spring profiles
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# MDE execution limits
# -----------------------------------------------------------------------------
MODRISS_MDE_EXECUTION_TIMEOUT=5m
MODRISS_MDE_JOB_TIMEOUT=10m
MODRISS_MDE_MAX_CAPTURED_OUTPUT_BYTES=1048576
MODRISS_MDE_MAX_CONCURRENT_JOBS=2
MODRISS_MDE_QUEUE_CAPACITY=32
MODRISS_MDE_MAX_MODEL_UPLOAD_BYTES=20971520
MODRISS_MDE_MAX_GENERATED_FILES=2000
MODRISS_MDE_MAX_GENERATED_FILE_BYTES=5242880
MODRISS_MDE_MAX_GENERATED_ARTIFACT_BYTES=52428800
MODRISS_MDE_STAGED_IMPORT_TTL=2h
MODRISS_MDE_IMPORT_CLEANUP_INTERVAL=PT15M
MODRISS_UPLOAD_ROOT=uploads
MODRISS_UPLOAD_MAX_FILE_BYTES=1048576
MODRISS_UPLOAD_MAX_TEXT_CHARS=120000

# -----------------------------------------------------------------------------
# Admin workspace
# -----------------------------------------------------------------------------
# One-time bootstrap is disabled by default. Temporarily set true only for first admin creation.
MODRISS_ADMIN_BOOTSTRAP_ENABLED=false
# Comma-separated emails that receive the initial ADMIN role after login.
# Bootstrap requires this email, the setup token below, and an empty admin_roles table.
MODRISS_ADMIN_BOOTSTRAP_EMAILS=
# One-time setup token used only for first admin creation. Keep blank unless bootstrapping.
MODRISS_ADMIN_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# AI assistant (disabled by default unless explicitly enabled here or in the environment)
# -----------------------------------------------------------------------------
MODRISS_AI_ENABLED=false
# Assistant metamodel surface: normal (complete CIM/PIM) or excerpt (curated core concepts).
# Excerpt mode still validates generated models against the complete canonical Ecore metamodels.
MODRISS_AI_METAMODEL_MODE=normal
# Available modes: unified (production), agent-test, conceptual-test (acceptance only).
MODRISS_AI_MODE=unified
# Workflow Engine V2 is the only supported assistant execution path. Keep this true in every
# environment; the live evaluation gate records the deployed configuration before release.
MODRISS_AI_WORKFLOW_ENGINE_V2=true
# Available provider families: openai, openai-compatible, openai_compatible, gemini.
MODRISS_AI_PROVIDER=openai
# Keep `none` unless a verified local transformers/ONNX embedding model is configured.
MODRISS_AI_EMBEDDING_PROVIDER=none
MODRISS_AI_REQUEST_TIMEOUT=240s
MODRISS_AI_TURN_TIMEOUT=25m
MODRISS_AI_SOURCE_TURN_TIMEOUT=45m
MODRISS_AI_MAX_CIM_MODELING_PASSES=4
MODRISS_AI_PREFER_LLM_SOURCE_EXTRACTION=true
# Optional independent LLM judge/reviewer. Structural Ecore validation always remains enabled.
MODRISS_AI_LLM_REVIEW_ENABLED=true
# Automatically advance successful multi-phase work within its original bounded deadline.
MODRISS_AI_AUTOMATIC_CONTINUATION_ENABLED=true
MODRISS_AI_REQUIRE_IDEMPOTENCY_KEY=true
MODRISS_AI_MAX_TOOL_CALLS=0
MODRISS_AI_MAX_REPAIR_ATTEMPTS=4
MODRISS_AI_MAX_AGENT_STEPS=8
MODRISS_AI_MAX_TOOL_CALLS_PER_STEP=8
MODRISS_AI_TOKEN_BUDGET=16000
MODRISS_AI_MAX_PROMPT_TOKENS=24000
MODRISS_AI_MAX_COMPLETION_TOKENS=16000
MODRISS_GUEST_PROMPT_LIMIT=5
MODRISS_AI_MAX_CONTEXT_SNIPPETS=16
MODRISS_AI_RESERVED_SCHEMA_SNIPPETS=10
MODRISS_AI_MAX_SNIPPET_CHARS=1600
MODRISS_AI_MAX_SYSTEM_CHARS=32000
MODRISS_AI_MAX_SOURCE_CHUNK_TOKENS=4000
MODRISS_AI_MAX_SOURCE_CHUNKS_PER_TURN=24
# The staged Gemma workflow uses a bounded conceptual budget plus up to two routing calls.
MODRISS_AI_MAX_PROVIDER_CALLS_PER_TURN=64
MODRISS_AI_MAX_PROVIDER_CALLS_SOURCE_TURN=96
MODRISS_AI_MAX_PATCH_CREATES=64
MODRISS_AI_MAX_PATCH_CONNECTIONS=96
MODRISS_AI_MAX_PATCH_EVIDENCE=64
MODRISS_AI_MAX_CONTRACT_COUNT=12
MODRISS_AI_NATIVE_TOOLS_PREFERRED=false
MODRISS_AI_FORCED_TOOL_CHOICE_RELIABLE=false
MODRISS_AI_RATE_LIMIT_REQUESTS=30
MODRISS_AI_RATE_LIMIT_WINDOW=1m
MODRISS_AI_CIRCUIT_FAILURE_THRESHOLD=3
MODRISS_AI_CIRCUIT_OPEN_DURATION=1m
MODRISS_AI_PROVIDER_RETRY_ATTEMPTS=0
MODRISS_AI_RETRY_BACKOFF=500ms
MODRISS_AI_RECENT_MESSAGE_WINDOW=24
MODRISS_AI_FALLBACK_PROVIDER=

# Optional eval and smoke toggles (off by default)

# Provider credentials: set in production via secret manager.
# The backend normalizes OPENAI_COMPATIBLE_BASE_URL to end in /v1.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
GEMINI_API_KEY=
MODRISS_AI_MODEL=Gemma-4-31B-IT
MODRISS_AI_TEST_MODEL=

# Optional outbound proxy for AI provider calls
MODRISS_AI_PROXY_ENABLED=false
MODRISS_AI_PROXY_TYPE=HTTP
MODRISS_AI_PROXY_HOST=127.0.0.1
MODRISS_AI_PROXY_PORT=2081
MODRISS_AI_PROXY_CONNECT_TIMEOUT=2s
MODRISS_AI_OPENAI_PROTOCOL=json_schema
MODRISS_AI_OPENAI_PROXY_ENABLED=false
MODRISS_AI_OPENAI_PROXY_TYPE=HTTP
MODRISS_AI_OPENAI_PROXY_HOST=127.0.0.1
MODRISS_AI_OPENAI_PROXY_PORT=2081
MODRISS_AI_OPENAI_PROXY_CONNECT_TIMEOUT=2s
MODRISS_AI_GEMINI_PROXY_ENABLED=false
MODRISS_AI_GEMINI_PROXY_TYPE=HTTP
MODRISS_AI_GEMINI_PROXY_HOST=127.0.0.1
MODRISS_AI_GEMINI_PROXY_PORT=2081
MODRISS_AI_GEMINI_PROXY_CONNECT_TIMEOUT=2s
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
MODRISS_METRICS_ENABLED=true
MODRISS_TRACING_ENABLED=false
MODRISS_TRACING_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=modriss-backend
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# AWS emulator (generated-project deployment and runtime tests)
# -----------------------------------------------------------------------------
# Select exactly one Compose profile: `floci` (recommended) or `localstack`.
# Compose expands COMPOSE_PROFILES from AWS_EMULATOR, so `docker compose up` starts only the
# selected emulator. Keep AWS_EMULATOR as a simple lowercase provider name.
AWS_EMULATOR=floci
COMPOSE_PROFILES=${AWS_EMULATOR}
AWS_EMULATOR_ENDPOINT_URL=http://127.0.0.1:4566
AWS_DEFAULT_REGION=us-east-1

# Floci is free/open source and requires no token. `memory` gives repeatable clean test runs;
# use `persistent`, `hybrid`, or `wal` to retain state in `modriss-floci-data`.
FLOCI_IMAGE=floci/floci:2.0.1
FLOCI_HOSTNAME=localhost.floci.io
FLOCI_STORAGE_MODE=memory
FLOCI_CFN_ALLOW_STUB_UNSUPPORTED_RESOURCE_TYPES=false
FLOCI_LOG_LEVEL=INFO
FLOCI_HTTP_PROXY=
FLOCI_HTTPS_PROXY=
FLOCI_NO_PROXY=localhost,127.0.0.1,localhost.floci.io,floci,aws-emulator

# LocalStack remains available by setting AWS_EMULATOR=localstack.
LOCALSTACK_IMAGE=localstack/localstack:latest
LOCALSTACK_GATEWAY_PORT=4566
LOCALSTACK_DEBUG=0
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_PROXY_ENABLED=false
LOCALSTACK_PERSISTENCE=0
LOCALSTACK_CFN_IGNORE_UNSUPPORTED_RESOURCE_TYPES=1
LAMBDA_RUNTIME_ENVIRONMENT_TIMEOUT=120
LOCALSTACK_HTTP_PROXY=
LOCALSTACK_HTTPS_PROXY=
LOCALSTACK_NO_PROXY=localhost,127.0.0.1,localstack

# -----------------------------------------------------------------------------
# Compose-only overrides (optional; see deploy/compose.yaml)
# -----------------------------------------------------------------------------
# MODRISS_ALLOWED_ORIGINS: comma-separated CORS/WebSocket origins. When unset, Compose
# derives origins from BACKEND_PORT, FRONTEND_PORT, LANDING_PORT, ADMIN_PORT, and CADDY_HTTP_PORT.
# MODRISS_CONTAINER_UPLOAD_ROOT: upload directory inside the backend container (default /app/uploads).
MODRISS_ALLOWED_ORIGINS=
MODRISS_CONTAINER_UPLOAD_ROOT=

# Additional backend configuration
POSTGRES_HOST=localhost
FREELLMAPI_NETWORK=freellmapi_default
FREELLMAPI_NETWORK_EXTERNAL=false
MODRISS_STORAGE_ROOT=storage
MODRISS_SESSION_TTL=30d
MODRISS_AI_VALIDATION_REPAIR_ATTEMPTS=1
MODRISS_AI_LLM_CONTRACT_RERANK_ENABLED=false
