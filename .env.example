# Modless environment template
# Copy to .env for local overrides: cp .env.example .env
# Never commit .env — it may contain secrets.
#
# Docker Compose:
# - Run from the repository root: docker compose up --build
# - Backend loads this file via deploy/compose.yaml env_file (../.env)
# - After editing credentials, recreate the backend:
#     docker compose up --build --force-recreate backend
# - Shell exports (e.g. $env:OPENAI_COMPATIBLE_API_KEY) override compose ${VAR} substitution
#   when you run from the repo root; env_file avoids that for the backend container.

# -----------------------------------------------------------------------------
# Compose / infrastructure ports
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=8082
LANDING_PORT=8083
GLSP_PORT=8081
# GLSP server log level: debug | info | warn | error
MODLESS_GLSP_LOG_LEVEL=info
LOCALSTACK_GATEWAY_PORT=4566

# -----------------------------------------------------------------------------
# Diagram editor (canvas renderer)
# -----------------------------------------------------------------------------
# antv-g6 (packaged fallback) or glsp-sprotty (default in the Compose stack)
MODLESS_DIAGRAM_RENDERER=glsp-sprotty
# Browser-reachable WebSocket URL when using glsp-sprotty (published GLSP_PORT on the host)
MODLESS_GLSP_SERVER_URL=ws://127.0.0.1:8081/modless

# -----------------------------------------------------------------------------
# PostgreSQL (required)
# -----------------------------------------------------------------------------
POSTGRES_DB=modless
POSTGRES_USER=modless
POSTGRES_PASSWORD=modless

MODLESS_DB_URL=jdbc:postgresql://localhost:5432/modless
MODLESS_DB_USER=modless
MODLESS_DB_PASSWORD=modless
MODLESS_DB_MAX_POOL_SIZE=10
MODLESS_DB_MIN_IDLE=2

# Integration tests (Testcontainers overrides these automatically when enabled)
MODLESS_POSTGRES_TEST_URL=jdbc:postgresql://localhost:5432/modless
MODLESS_POSTGRES_TEST_USER=modless
MODLESS_POSTGRES_TEST_PASSWORD=modless

# -----------------------------------------------------------------------------
# Spring profiles
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# MDE execution limits
# -----------------------------------------------------------------------------
MODLESS_MDE_EXECUTION_TIMEOUT=5m
MODLESS_MDE_JOB_TIMEOUT=10m
MODLESS_MDE_MAX_CAPTURED_OUTPUT_BYTES=1048576
MODLESS_MDE_MAX_CONCURRENT_JOBS=2
MODLESS_MDE_QUEUE_CAPACITY=32
MODLESS_MDE_MAX_MODEL_UPLOAD_BYTES=20971520
MODLESS_MDE_MAX_GENERATED_FILES=2000
MODLESS_MDE_MAX_GENERATED_FILE_BYTES=5242880
MODLESS_MDE_MAX_GENERATED_ARTIFACT_BYTES=52428800
MODLESS_MDE_STAGED_IMPORT_TTL=2h
MODLESS_MDE_IMPORT_CLEANUP_INTERVAL=PT15M
MODLESS_UPLOAD_ROOT=uploads
MODLESS_UPLOAD_MAX_FILE_BYTES=1048576
MODLESS_UPLOAD_MAX_TEXT_CHARS=120000

# -----------------------------------------------------------------------------
# AI assistant (disabled by default unless explicitly enabled here or in the environment)
# -----------------------------------------------------------------------------
MODLESS_AI_ENABLED=false
MODLESS_AI_PROVIDER=openai
MODLESS_AI_REQUEST_TIMEOUT=5m
MODLESS_AI_TURN_TIMEOUT=5m
MODLESS_AI_MAX_REPAIR_ATTEMPTS=1
MODLESS_AI_MAX_TOOL_CALLS=24
MODLESS_AI_MAX_AGENT_STEPS=8
MODLESS_AI_MAX_TOOL_CALLS_PER_STEP=4
MODLESS_AI_TOKEN_BUDGET=16000
MODLESS_AI_MAX_PROMPT_TOKENS=24000
MODLESS_AI_MAX_SOURCE_CHUNK_TOKENS=4000
MODLESS_AI_MAX_SOURCE_CHUNKS_PER_TURN=24
MODLESS_AI_REQUIRE_IDEMPOTENCY_KEY=true
MODLESS_AI_MAX_CONTEXT_SNIPPETS=24
MODLESS_AI_RESERVED_SCHEMA_SNIPPETS=10
MODLESS_AI_MAX_SNIPPET_CHARS=2400
MODLESS_AI_MAX_SYSTEM_CHARS=14000
MODLESS_AI_RATE_LIMIT_REQUESTS=30
MODLESS_AI_RATE_LIMIT_WINDOW=1m
MODLESS_AI_CIRCUIT_FAILURE_THRESHOLD=3
MODLESS_AI_CIRCUIT_OPEN_DURATION=1m
MODLESS_AI_PROVIDER_RETRY_ATTEMPTS=2
MODLESS_AI_RETRY_BACKOFF=250ms
MODLESS_AI_RECENT_MESSAGE_WINDOW=24
MODLESS_AI_FALLBACK_PROVIDER=

# Optional eval and smoke toggles (off by default)
MODLESS_RUN_LIVE_ASSISTANT_EVAL=false
MODLESS_WRITE_EVAL_REPORT=false
MODLESS_RUN_COMPOSE_SMOKE=false
MODLESS_BACKEND_URL=http://127.0.0.1:8080

# Provider credentials — set in production via secret manager
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
OPENAI_COMPATIBLE_API_KEY=
GEMINI_API_KEY=
MODLESS_AI_PLANNER_MODEL=
MODLESS_AI_RESPONDER_MODEL=
MODLESS_AI_SUMMARIZER_MODEL=

# Embeddings
# ONNX is the production retrieval default; hash fallback is available for constrained local runs.
MODLESS_AI_EMBEDDINGS_PROVIDER=ONNX
MODLESS_AI_EMBEDDINGS_MODEL_RESOURCE=
MODLESS_AI_EMBEDDINGS_TOKENIZER_RESOURCE=
MODLESS_AI_EMBEDDINGS_MODEL_OUTPUT_NAME=
MODLESS_AI_EMBEDDINGS_CACHE_DIRECTORY=
MODLESS_AI_EMBEDDINGS_DISABLE_CACHING=false
MODLESS_AI_EMBEDDINGS_GPU_DEVICE_ID=-1
# When ONNX is configured, allow hash fallback if model initialization fails at runtime.
MODLESS_AI_EMBEDDINGS_FALLBACK_TO_HASH=true

# Optional outbound proxy for AI provider calls
MODLESS_AI_PROXY_ENABLED=false
MODLESS_AI_PROXY_TYPE=HTTP
MODLESS_AI_PROXY_HOST=127.0.0.1
MODLESS_AI_PROXY_PORT=2081
MODLESS_AI_PROXY_CONNECT_TIMEOUT=2s

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
MODLESS_METRICS_ENABLED=true
MODLESS_TRACING_ENABLED=false
MODLESS_TRACING_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=modless-backend

# -----------------------------------------------------------------------------
# LocalStack (optional full-stack deployment tests)
# -----------------------------------------------------------------------------
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_DEBUG=0
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_PERSISTENCE=0
LOCALSTACK_CFN_IGNORE_UNSUPPORTED_RESOURCE_TYPES=1
LOCALSTACK_HTTP_PROXY=
LOCALSTACK_HTTPS_PROXY=
LOCALSTACK_NO_PROXY=localhost,127.0.0.1,localstack

# -----------------------------------------------------------------------------
# Compose-only overrides (optional; see deploy/compose.yaml)
# -----------------------------------------------------------------------------
# MODLESS_ALLOWED_ORIGINS — comma-separated CORS/WebSocket origins. When unset, Compose
# derives origins from BACKEND_PORT, FRONTEND_PORT, and LANDING_PORT.
# MODLESS_CONTAINER_UPLOAD_ROOT — upload directory inside the backend container (default /app/uploads).
