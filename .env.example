# Varka environment template
# Copy to .env for local overrides: cp .env.example .env
# Never commit .env — it may contain secrets.
#
# Docker Compose:
# - Run from the repository root: docker compose up --build
# - Backend loads this file via deploy/compose.yaml env_file (../.env)
# - After editing credentials, recreate the backend:
#     docker compose up --build --force-recreate backend
# - Shell exports (e.g. $env:OPENAI_COMPATIBLE_API_KEY) override compose ${VAR} substitution
#   when you run from the repo root; env_file avoids that for the backend container.

# -----------------------------------------------------------------------------
# Compose / infrastructure ports
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
CADDY_HTTP_PORT=8088
BACKEND_PORT=8080
FRONTEND_PORT=8082
LANDING_PORT=8083
ADMIN_PORT=8084
LOCALSTACK_GATEWAY_PORT=4566
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# -----------------------------------------------------------------------------
# Diagram editor
# -----------------------------------------------------------------------------
# The modeling frontend uses the AntV G6 canvas renderer.
VARKA_DIAGRAM_RENDERER=antv-g6

# -----------------------------------------------------------------------------
# PostgreSQL (required)
# -----------------------------------------------------------------------------
POSTGRES_DB=varka
POSTGRES_USER=varka
POSTGRES_PASSWORD=varka

VARKA_DB_URL=jdbc:postgresql://localhost:5432/varka
VARKA_DB_USER=varka
VARKA_DB_PASSWORD=varka
VARKA_DB_MAX_POOL_SIZE=10
VARKA_DB_MIN_IDLE=2

# -----------------------------------------------------------------------------
# Spring profiles
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------------------------------
# MDE execution limits
# -----------------------------------------------------------------------------
VARKA_MDE_EXECUTION_TIMEOUT=5m
VARKA_MDE_JOB_TIMEOUT=10m
VARKA_MDE_MAX_CAPTURED_OUTPUT_BYTES=1048576
VARKA_MDE_MAX_CONCURRENT_JOBS=2
VARKA_MDE_QUEUE_CAPACITY=32
VARKA_MDE_MAX_MODEL_UPLOAD_BYTES=20971520
VARKA_MDE_MAX_GENERATED_FILES=2000
VARKA_MDE_MAX_GENERATED_FILE_BYTES=5242880
VARKA_MDE_MAX_GENERATED_ARTIFACT_BYTES=52428800
VARKA_MDE_STAGED_IMPORT_TTL=2h
VARKA_MDE_IMPORT_CLEANUP_INTERVAL=PT15M
VARKA_UPLOAD_ROOT=uploads
VARKA_UPLOAD_MAX_FILE_BYTES=1048576
VARKA_UPLOAD_MAX_TEXT_CHARS=120000

# -----------------------------------------------------------------------------
# Admin workspace
# -----------------------------------------------------------------------------
# One-time bootstrap is disabled by default. Temporarily set true only for first admin creation.
VARKA_ADMIN_BOOTSTRAP_ENABLED=false
# Comma-separated emails that receive the initial ADMIN role after login.
# Bootstrap requires this email, the setup token below, and an empty admin_roles table.
VARKA_ADMIN_BOOTSTRAP_EMAILS=
# One-time setup token used only for first admin creation. Keep blank unless bootstrapping.
VARKA_ADMIN_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# AI assistant (disabled by default unless explicitly enabled here or in the environment)
# -----------------------------------------------------------------------------
VARKA_AI_ENABLED=false
# Workflow Engine V2 is the only supported assistant execution path. Keep this true in every
# environment; the live evaluation gate records the deployed configuration before release.
VARKA_AI_WORKFLOW_ENGINE_V2=true
VARKA_AI_PROVIDER=openai
VARKA_AI_EMBEDDING_PROVIDER=none
VARKA_AI_REQUEST_TIMEOUT=60s
VARKA_AI_TURN_TIMEOUT=5m
VARKA_AI_SOURCE_TURN_TIMEOUT=2m
VARKA_AI_MAX_MODEL_DELTA_ELEMENTS_PER_PASS=40
VARKA_AI_MAX_CIM_MODELING_PASSES=4
VARKA_AI_MAX_AUTOMATIC_SLICES=12
VARKA_AI_PREFER_LLM_SOURCE_EXTRACTION=true
VARKA_AI_REQUIRE_IDEMPOTENCY_KEY=true
VARKA_AI_MAX_TOOL_CALLS=0
VARKA_AI_MAX_REPAIR_ATTEMPTS=2
VARKA_AI_MAX_AGENT_STEPS=8
VARKA_AI_MAX_TOOL_CALLS_PER_STEP=8
VARKA_AI_TOKEN_BUDGET=16000
VARKA_AI_MAX_PROMPT_TOKENS=24000
VARKA_GUEST_PROMPT_LIMIT=5
VARKA_AI_MAX_CONTEXT_SNIPPETS=16
VARKA_AI_RESERVED_SCHEMA_SNIPPETS=10
VARKA_AI_MAX_SNIPPET_CHARS=1600
VARKA_AI_MAX_SYSTEM_CHARS=14000
VARKA_AI_MAX_SOURCE_CHUNK_TOKENS=4000
VARKA_AI_MAX_SOURCE_CHUNKS_PER_TURN=24
VARKA_AI_MAX_PROVIDER_CALLS_PER_TURN=2
VARKA_AI_MAX_PROVIDER_CALLS_SOURCE_TURN=3
VARKA_AI_RATE_LIMIT_REQUESTS=30
VARKA_AI_RATE_LIMIT_WINDOW=1m
VARKA_AI_CIRCUIT_FAILURE_THRESHOLD=3
VARKA_AI_CIRCUIT_OPEN_DURATION=1m
VARKA_AI_PROVIDER_RETRY_ATTEMPTS=2
VARKA_AI_RETRY_BACKOFF=250ms
VARKA_AI_RECENT_MESSAGE_WINDOW=24
VARKA_AI_FALLBACK_PROVIDER=

# Optional eval and smoke toggles (off by default)

# Provider credentials — set in production via secret manager
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
OPENAI_COMPATIBLE_API_KEY=
GEMINI_API_KEY=
VARKA_AI_MODEL=
VARKA_AI_TEST_MODEL=

# Optional outbound proxy for AI provider calls
VARKA_AI_PROXY_ENABLED=false
VARKA_AI_PROXY_TYPE=HTTP
VARKA_AI_PROXY_HOST=127.0.0.1
VARKA_AI_PROXY_PORT=2081
VARKA_AI_PROXY_CONNECT_TIMEOUT=2s
VARKA_AI_PROVIDER_PROFILES_FILE=
VARKA_AI_OPENAI_PROTOCOL=auto
VARKA_AI_OPENAI_PROXY_ENABLED=false
VARKA_AI_OPENAI_PROXY_TYPE=HTTP
VARKA_AI_OPENAI_PROXY_HOST=127.0.0.1
VARKA_AI_OPENAI_PROXY_PORT=2081
VARKA_AI_OPENAI_PROXY_CONNECT_TIMEOUT=2s
VARKA_AI_GEMINI_PROXY_ENABLED=false
VARKA_AI_GEMINI_PROXY_TYPE=HTTP
VARKA_AI_GEMINI_PROXY_HOST=127.0.0.1
VARKA_AI_GEMINI_PROXY_PORT=2081
VARKA_AI_GEMINI_PROXY_CONNECT_TIMEOUT=2s
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
VARKA_METRICS_ENABLED=true
VARKA_TRACING_ENABLED=false
VARKA_TRACING_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=varka-backend
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# LocalStack (optional full-stack deployment tests)
# -----------------------------------------------------------------------------
AWS_DEFAULT_REGION=us-east-1
LOCALSTACK_DEBUG=0
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_PROXY_ENABLED=false
LOCALSTACK_PERSISTENCE=0
LOCALSTACK_CFN_IGNORE_UNSUPPORTED_RESOURCE_TYPES=1
LAMBDA_RUNTIME_ENVIRONMENT_TIMEOUT=120
LOCALSTACK_HTTP_PROXY=
LOCALSTACK_HTTPS_PROXY=
LOCALSTACK_NO_PROXY=localhost,127.0.0.1,localstack

# -----------------------------------------------------------------------------
# Compose-only overrides (optional; see deploy/compose.yaml)
# -----------------------------------------------------------------------------
# VARKA_ALLOWED_ORIGINS — comma-separated CORS/WebSocket origins. When unset, Compose
# derives origins from BACKEND_PORT, FRONTEND_PORT, LANDING_PORT, ADMIN_PORT, and CADDY_HTTP_PORT.
# VARKA_CONTAINER_UPLOAD_ROOT — upload directory inside the backend container (default /app/uploads).
VARKA_ALLOWED_ORIGINS=
VARKA_CONTAINER_UPLOAD_ROOT=

# Additional backend configuration
POSTGRES_HOST=localhost
FREELLMAPI_NETWORK=freellmapi_default
VARKA_STORAGE_ROOT=storage
VARKA_SESSION_TTL=30d
VARKA_AI_VALIDATION_REPAIR_ATTEMPTS=1
VARKA_AI_LLM_CONTRACT_RERANK_ENABLED=false
