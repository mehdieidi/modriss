{
  "name": "modless-formatting",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/js/glsp-client",
    "packages/js/glsp-server",
    "tools/notation-migrate"
  ],
  "prettier": "./config/prettier.config.json",
  "scripts": {
    "format": "python scripts/format.py",
    "format:check": "python scripts/format.py --check",
    "verify": "python scripts/verify.py",
    "verify:fast": "python scripts/verify.py --skip-tests",
    "verify:flyway": "python scripts/verify-flyway-migrations.py",
    "format:prettier": "prettier --write --ignore-unknown",
    "format:prettier:check": "prettier --check --ignore-unknown",
    "lint": "python scripts/lint.py",
    "lint:fast": "python scripts/lint.py --fast",
    "lint:eslint": "eslint --config config/eslint.config.js \"apps/**/*.js\"",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\" \"!**/target/**\" \"!**/vendor/**\" \"!mde/samples/**/generated-project/**\"",
    "lint:stylelint": "stylelint --config config/stylelintrc.json \"apps/**/*.css\"",
    "test:frontend": "node --test tests/frontend/*.test.mjs",
    "build:glsp": "npm run build -w @modless/glsp-client && npm run build -w @modless/glsp-server",
    "dev:glsp": "npm run dev -w @modless/glsp-server",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:up:deploy": "docker compose -f deploy/compose.yaml up --build",
    "docker:down:deploy": "docker compose -f deploy/compose.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "eslint": "9.27.0",
    "globals": "16.2.0",
    "markdownlint-cli2": "0.17.2",
    "prettier": "3.5.3",
    "stylelint": "16.19.1",
    "stylelint-config-standard": "38.0.0"
  }
}
