# Normalize text files
* text=auto

# Shell scripts must use LF
*.sh text eol=lf
mvnw text eol=lf

# Windows scripts must use CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw.cmd text eol=crlf

# Source files
*.css text eol=lf
*.html text eol=lf
*.java text eol=lf
