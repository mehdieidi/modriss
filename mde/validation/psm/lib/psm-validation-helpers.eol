/** Provides reusable psm validation helpers operations. */
/** Returns whether the receiver contains a non-empty textual value. */
operation Any hasText() : Boolean {
  if (self.isUndefined()) {
    return false;
  }
  return self.asString().trim().length() > 0;
}

/** Returns whether the receiver is true value. */
operation Any isTrueValue() : Boolean {
  return self.isDefined() and (self = true);
}

/** Returns whether the receiver is false value. */
operation Any isFalseValue() : Boolean {
  return self.isDefined() and (self = false);
}

@cached
/** Computes current psm model. */
operation currentPsmModel() : Any {
  if (AWSPSM!AwsPsmModel.all.isEmpty()) {
    return null;
  }
  return AWSPSM!AwsPsmModel.all.first();
}

@cached
/** Computes production stage exists. */
operation productionStageExists() : Boolean {
  return AWSPSM!AwsStage.all.exists(stageItem |
    stageItem.environmentClass = AWSPSMENUMS!AwsEnvironmentClass#PROD);
}


@cached
/** Collects nested AwsResource children for validation flattening. */
operation AWSPSM!AwsResource nestedAwsResources() : Sequence {
  var nested = Sequence{};
  if (self.isKindOf(AWSPSM!ApiGatewayApi)) {
    nested.addAll(self.routes);
    nested.addAll(self.stages);
    nested.addAll(self.authorizers);
  }
  if (self.isKindOf(AWSPSM!RestApi)) {
    nested.addAll(self.resources);
  }
  if (self.isKindOf(AWSPSM!AwsLambdaFunction)) {
    nested.addAll(self.permissions);
    nested.addAll(self.versions);
    nested.addAll(self.aliases);
    nested.addAll(self.eventInvokeConfigs);
    nested.addAll(self.eventSourceMappings);
    if (self.functionUrl.isDefined()) {
      nested.add(self.functionUrl);
    }
  }
  var flattened = Sequence{};
  for (child in nested) {
    flattened.add(child);
    flattened.addAll(child.nestedAwsResources());
  }
  return flattened;
}

@cached
/** Computes stack resource set. */
operation AWSPSM!AwsPsmModel stackResourceSet() : Set {
  var resourceSet : Set = Set{};
  for (stackItem in self.stacks) {
    for (resourceItem in stackItem.resources) {
      resourceSet.add(resourceItem);
      for (nestedItem in resourceItem.nestedAwsResources()) {
        resourceSet.add(nestedItem);
      }
    }
  }
  return resourceSet;
}

/** Computes resource label. */
operation AWSPSM!AwsResource resourceLabel() : String {
  if (self.logicalId.hasText()) {
    return self.logicalId;
  }
  if (self.name.hasText()) {
    return self.name;
  }
  return self.eClass().name;
}

@cached
/** Computes deployed to production stage. */
operation AWSPSM!AwsResource deployedToProductionStage() : Boolean {
  return self.stack.isDefined() and productionStackIds().includes(self.stack.`id`);
}

@cached
/** Computes production stack ids. */
operation productionStackIds() : Set {
  var ids : Set = Set{};
  for (stageItem in AWSPSM!AwsStage.all.select(s |
      s.environmentClass = AWSPSMENUMS!AwsEnvironmentClass#PROD)) {
    for (stackItem in stageItem.deploysStacks) {
      ids.add(stackItem.`id`);
    }
  }
  return ids;
}

@cached
/** Returns whether the receiver is production scoped. */
operation AWSPSM!AwsResource isProductionScoped() : Boolean {
  return (self.productionCritical = true) or self.deployedToProductionStage();
}

/** Returns whether the receiver has tag key. */
operation AWSPSM!AwsResource hasTagKey(keyText : String) : Boolean {
  return self.tags.exists(tagItem | tagItem.key = keyText);
}

@cached
/** Computes duplicate tag keys. */
operation AWSPSM!AwsResource duplicateTagKeys() : Set {
  var seen : Set = Set{};
  var duplicates : Set = Set{};
  for (tagItem in self.tags.select(t | t.key.hasText())) {
    if (seen.includes(tagItem.key)) {
      duplicates.add(tagItem.key);
    }
    else {
      seen.add(tagItem.key);
    }
  }
  return duplicates;
}

@cached
/** Computes active tagging policy. */
operation activeTaggingPolicy() : Any {
  var modelRoot = currentPsmModel();
  if (modelRoot.isUndefined()) {
    return null;
  }
  return modelRoot.taggingPolicy;
}

@cached
/** Computes required tag keys. */
operation requiredTagKeys() : Sequence {
  var policyItem = activeTaggingPolicy();
  var keys : Sequence = Sequence{};

  if (policyItem.isDefined()) {
    if (policyItem.requireOwnerTag = true) {
      keys.add('Owner');
    }
    if (policyItem.requireEnvironmentTag = true) {
      keys.add('Environment');
    }
    if (policyItem.requireCostCenterTag = true) {
      keys.add('CostCenter');
    }
    for (requiredTag in policyItem.requiredTags) {
      if (requiredTag.key.hasText()) {
        keys.add(requiredTag.key);
      }
    }
  }
  else {
    keys.add('Owner');
    keys.add('Environment');
  }

  return keys.asSet().asSequence();
}

@cached
/** Computes missing required tag keys. */
operation AWSPSM!AwsResource missingRequiredTagKeys() : Sequence {
  var missingKeys : Sequence = Sequence{};
  for (requiredKey in requiredTagKeys()) {
    if (not self.hasTagKey(requiredKey)) {
      missingKeys.add(requiredKey);
    }
  }
  return missingKeys;
}

/** Computes stack logical id key. */
operation AWSPSM!AwsResource stackLogicalIdKey() : String {
  if (self.stack.isUndefined()) {
    return "<no-stack>::" + self.logicalId;
  }
  return self.stack.`id` + "::" + self.logicalId;
}

@cached
/** Computes duplicate resource logical id keys. */
operation duplicateResourceLogicalIdKeys() : Set {
  var seen : Set = Set{};
  var duplicates : Set = Set{};
  for (resourceItem in AWSPSM!AwsResource.all.select(r | r.logicalId.hasText())) {
    var key = resourceItem.stackLogicalIdKey();
    if (seen.includes(key)) {
      duplicates.add(key);
    }
    else {
      seen.add(key);
    }
  }
  return duplicates;
}

@cached
/** Computes transitive dependency ids. */
operation AWSPSM!AwsResource transitiveDependencyIds() : Set {
  return self.transitiveDependencyIds(Set{});
}

/** Computes transitive dependency ids. */
operation AWSPSM!AwsResource transitiveDependencyIds(visitedResourceIds : Set) : Set {
  var ids : Set = Set{};
  if (visitedResourceIds.includes(self.`id`)) {
    ids.add(self.`id`);
    return ids;
  }
  visitedResourceIds.add(self.`id`);
  for (dependencyItem in self.dependsOn) {
    ids.add(dependencyItem.`id`);
    ids.addAll(dependencyItem.transitiveDependencyIds(visitedResourceIds));
  }
  return ids;
}

@cached
/** Computes resources with dependency cycles. */
operation resourcesWithDependencyCycles() : Set {
  var ids : Set = Set{};
  for (resourceItem in AWSPSM!AwsResource.all) {
    if (resourceItem.transitiveDependencyIds().includes(resourceItem.`id`)) {
      ids.add(resourceItem.`id`);
    }
  }
  return ids;
}

/** Returns whether the receiver uses secure source. */
operation AWSPSM!ValueExpression usesSecureSource() : Boolean {
  return (self.sourceKind = AWSPSMENUMS!ValueSourceKind#SECRETS_MANAGER_REFERENCE) or
    (self.sourceKind = AWSPSMENUMS!ValueSourceKind#SSM_SECURE_REFERENCE) or
    (self.sourceKind = AWSPSMENUMS!ValueSourceKind#DYNAMIC_REFERENCE);
}

/** Computes action is wildcard. */
operation AWSPSM!IamStatement actionIsWildcard() : Boolean {
  return (self.wildcardAction = true) or
    self.actions.exists(actionText | (actionText = '*') or actionText.endsWith(':*'));
}

/** Computes resource is wildcard. */
operation AWSPSM!IamStatement resourceIsWildcard() : Boolean {
  return (self.wildcardResource = true) or
    self.resources.exists(resourceText | resourceText = '*');
}

/** Returns whether the receiver has least privilege justification. */
operation AWSPSM!IamStatement hasLeastPrivilegeJustification() : Boolean {
  return self.wildcardJustification.hasText() or self.conditions.notEmpty();
}

/** Returns whether the receiver has action side. */
operation AWSPSM!IamStatement hasActionSide() : Boolean {
  return self.actions.notEmpty() or self.notActions.notEmpty();
}

/** Returns whether the receiver has resource side. */
operation AWSPSM!IamStatement hasResourceSide() : Boolean {
  return self.resources.notEmpty() or self.notResources.notEmpty();
}

@cached
/** Returns whether the receiver is trust policy statement. */
operation AWSPSM!IamStatement isTrustPolicyStatement() : Boolean {
  return self.principals.notEmpty();
}

@cached
/** Returns whether the receiver is generator managed code skeleton. */
operation AWSPSM!LambdaZipCodeConfig isGeneratorManagedCodeSkeleton() : Boolean {
  return self.generatedByTransformation = true;
}

@cached
/** Computes blocks all public access. */
operation AWSPSM!S3Bucket blocksAllPublicAccess() : Boolean {
  if (self.publicAccessMode = AWSPSMENUMS!S3BlockPublicAccessMode#STRICT_BLOCK_ALL) {
    return true;
  }
  if (self.publicAccessBlock.isUndefined()) {
    return false;
  }
  return (self.publicAccessBlock.blockPublicAcls = true) and
    (self.publicAccessBlock.blockPublicPolicy = true) and
    (self.publicAccessBlock.ignorePublicAcls = true) and
    (self.publicAccessBlock.restrictPublicBuckets = true);
}

@cached
/** Computes target count. */
operation AWSPSM!ApiGatewayIntegration targetCount() : Integer {
  var count : Integer = 0;
  if (self.lambdaTarget.isDefined()) {
    count = count + 1;
  }
  if (self.stateMachineTarget.isDefined()) {
    count = count + 1;
  }
  if (self.integrationUri.hasText() and self.lambdaTarget.isUndefined() and self.stateMachineTarget.isUndefined()) {
    count = count + 1;
  }
  return count;
}

/** Computes api route key prefix. */
operation AWSPSM!ApiGatewayRoute apiRouteKeyPrefix() : String {
  if (self.api.isUndefined()) {
    return "<no-api>";
  }
  return self.api.`id`;
}

/** Computes http api route key. */
operation AWSPSM!HttpApiRoute httpApiRouteKey() : String {
  return self.apiRouteKeyPrefix() + "::" + self.method.asString() + "::" + self.path;
}

/** Computes rest api route key. */
operation AWSPSM!RestApiRoute restApiRouteKey() : String {
  return self.apiRouteKeyPrefix() + "::" + self.method.asString() + "::" + self.path;
}

/** Computes web socket route key. */
operation AWSPSM!WebSocketRoute webSocketRouteKey() : String {
  return self.apiRouteKeyPrefix() + "::" + self.routeKey;
}

@cached
/** Computes duplicate http api route keys. */
operation duplicateHttpApiRouteKeys() : Set {
  var seen : Set = Set{};
  var duplicates : Set = Set{};
  for (routeItem in AWSPSM!HttpApiRoute.all) {
    var key = routeItem.httpApiRouteKey();
    if (seen.includes(key)) {
      duplicates.add(key);
    }
    else {
      seen.add(key);
    }
  }
  return duplicates;
}

@cached
/** Computes duplicate rest api route keys. */
operation duplicateRestApiRouteKeys() : Set {
  var seen : Set = Set{};
  var duplicates : Set = Set{};
  for (routeItem in AWSPSM!RestApiRoute.all) {
    var key = routeItem.restApiRouteKey();
    if (seen.includes(key)) {
      duplicates.add(key);
    }
    else {
      seen.add(key);
    }
  }
  return duplicates;
}

@cached
/** Computes duplicate web socket route keys. */
operation duplicateWebSocketRouteKeys() : Set {
  var seen : Set = Set{};
  var duplicates : Set = Set{};
  for (routeItem in AWSPSM!WebSocketRoute.all) {
    var key = routeItem.webSocketRouteKey();
    if (seen.includes(key)) {
      duplicates.add(key);
    }
    else {
      seen.add(key);
    }
  }
  return duplicates;
}

@cached
/** Resolves resolved access log group. */
operation AWSPSM!ApiGatewayStage resolvedAccessLogGroup() : Any {
  if (self.accessLogGroup.isDefined()) {
    return self.accessLogGroup;
  }
  if (self.api.isDefined() and self.api.accessLogGroup.isDefined()) {
    return self.api.accessLogGroup;
  }
  return null;
}

@cached
/** Computes definition count. */
operation AWSPSM!StepFunctionStateMachine definitionCount() : Integer {
  var count : Integer = 0;
  if (self.definitionUri.hasText()) {
    count = count + 1;
  }
  if (self.definitionString.hasText()) {
    count = count + 1;
  }
  if (self.aslDocument.isDefined()) {
    count = count + 1;
  }
  return count;
}

/** Returns whether the receiver has state named. */
operation AWSPSM!AslDocument hasStateNamed(stateNameText : String) : Boolean {
  return self.states.exists(stateItem | stateItem.stateName = stateNameText);
}

@cached
/** Computes duplicate state names. */
operation AWSPSM!AslDocument duplicateStateNames() : Set {
  var duplicates : Set = Set{};
  for (stateItem in self.states) {
    if (self.states.atLeastNMatch(otherState | otherState.stateName = stateItem.stateName, 2)) {
      duplicates.add(stateItem.stateName);
    }
  }
  return duplicates;
}
