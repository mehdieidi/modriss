/** Validates the semantic rules for events. */
import "../lib/psm-validation-helpers.eol";

/* EventBridge */

context AWSPSM!EventBridgeRule {
  /** Checks that rule has pattern or schedule. */
  constraint RuleHasPatternOrSchedule {
    check : self.eventPatternJson.hasText() or self.scheduleExpression.hasText() or self.eventPattern.isDefined()
    message : 'EventBridge rule ' + self.resourceLabel() + ' has neither an event pattern nor a schedule expression. Fix: define eventPattern/eventPatternJson for event-driven rules or scheduleExpression for scheduled rules.'
  }

  /** Checks that rule does not mix pattern and schedule. */
  constraint RuleDoesNotMixPatternAndSchedule {
    check : not ((self.eventPatternJson.hasText() or self.eventPattern.isDefined()) and self.scheduleExpression.hasText())
    message : 'EventBridge rule ' + self.resourceLabel() + ' defines both event pattern and schedule expression. Fix: split into two rules or keep only the intended trigger type.'
  }

  /** Checks that rule has targets. */
  constraint RuleHasTargets {
    check : self.targets.notEmpty()
    message : 'EventBridge rule ' + self.resourceLabel() + ' has no targets. Fix: add at least one EventBridgeTarget.'
  }

  /** Checks that target ids unique within rule. */
  constraint TargetIdsUniqueWithinRule {
    check : self.targets.forAll(targetItem |
      self.targets.one(otherTarget | otherTarget.targetId = targetItem.targetId))
    message : 'EventBridge rule ' + self.resourceLabel() + ' contains duplicate targetId values. Fix: make targetId unique within the rule.'
  }
}

/** Validates Event Bridge Target elements. */
context AWSPSM!EventBridgeTarget {
  /** Checks that target has resource or arn. */
  constraint TargetHasResourceOrArn {
    check : self.targetResource.isDefined() or self.arnExpression.hasText()
    message : 'EventBridge target ' + self.targetId + ' has neither targetResource nor arnExpression. Fix: reference a PSM resource or provide an ARN expression.'
  }

  /** Advises that critical event targets have retry or dlq. */
  critique CriticalEventTargetsHaveRetryOrDlq {
    guard : self.targetResource.isDefined() and self.targetResource.isProductionScoped()
    check : self.retryPolicy.isDefined() or self.deadLetterQueue.isDefined()
    message : 'Production-scoped EventBridge target ' + self.targetId + ' has no explicit retry policy or DLQ. Suggested fix: add AwsRetryPolicy and/or deadLetterQueue when default EventBridge retries are not sufficient.'
  }

  /** Checks that sqs fifo target has message group id. */
  constraint SqsFifoTargetHasMessageGroupId {
    guard : self.targetResource.isDefined() and self.targetResource.isKindOf(AWSPSM!SqsQueue) and self.targetResource.queueType = AWSPSMENUMS!SqsQueueType#FIFO
    check : self.parameters.isDefined() and self.parameters.isKindOf(AWSPSM!EventBridgeSqsTargetParameters) and self.parameters.messageGroupId.hasText()
    message : 'EventBridge target ' + self.targetId + ' sends to a FIFO SQS queue without messageGroupId. Fix: add EventBridgeSqsTargetParameters.messageGroupId.'
  }

  /** Checks that non lambda target has invoke role. */
  constraint NonLambdaTargetHasInvokeRole {
    guard : self.targetKind <> AWSPSMENUMS!EventBridgeTargetKind#LAMBDA and self.targetKind <> AWSPSMENUMS!EventBridgeTargetKind#OTHER_AWS_RESOURCE
    check : self.role.isDefined() or self.roleArn.hasText()
    message : 'EventBridge target ' + self.targetId + ' has no invoke role. Fix: attach a target-specific IAM role or roleArn for Step Functions, SQS, SNS, EventBridge bus, API destination, or log group targets.'
  }
}

/** Validates Aws Retry Policy elements. */
context AWSPSM!AwsRetryPolicy {
  /** Checks that retry policy ranges valid. */
  constraint RetryPolicyRangesValid {
    check : ((self.maximumRetryAttempts.isUndefined()) or ((self.maximumRetryAttempts >= 0) and (self.maximumRetryAttempts <= 185))) and
      ((self.maximumEventAgeInSeconds.isUndefined()) or ((self.maximumEventAgeInSeconds >= 60) and (self.maximumEventAgeInSeconds <= 86400)))
    message : 'EventBridge retry policy has invalid range values. Fix: set maximumRetryAttempts to 0..185 and maximumEventAgeInSeconds to 60..86400, or remove the fields to use defaults.'
  }
}

/** Validates Event Bridge Schedule elements. */
context AWSPSM!EventBridgeSchedule {
  /** Checks that schedule has expression and role. */
  constraint ScheduleHasExpressionAndRole {
    check : self.scheduleExpression.hasText() and self.role.isDefined()
    message : 'EventBridge schedule ' + self.resourceLabel() + ' lacks scheduleExpression or role. Fix: set scheduleExpression and attach the IAM role used by the scheduler.'
  }

  /** Checks that schedule has target. */
  constraint ScheduleHasTarget {
    check : self.target.isDefined() and (self.target.targetResource.isDefined() or self.target.arnExpression.hasText())
    message : 'EventBridge schedule ' + self.resourceLabel() + ' has no resolvable target. Fix: set EventBridgeSchedule.target with a targetResource or ARN expression.'
  }
}

/** Validates Event Bridge Pipe elements. */
context AWSPSM!EventBridgePipe {
  /** Checks that pipe has source target and role. */
  constraint PipeHasSourceTargetAndRole {
    check : (self.sourceArn.hasText() or self.sourceResource.isDefined()) and
      (self.targetArn.hasText() or self.targetResource.isDefined()) and
      self.role.isDefined()
    message : 'EventBridge pipe ' + self.resourceLabel() + ' must have source, target, and role. Fix: set sourceArn/sourceResource, targetArn/targetResource, and attach the IAM role.'
  }
}

/** Validates Event Bridge Api Destination elements. */
context AWSPSM!EventBridgeApiDestination {
  /** Checks that api destination has endpoint and connection. */
  constraint ApiDestinationHasEndpointAndConnection {
    check : self.invocationEndpoint.hasText() and self.connection.isDefined()
    message : 'EventBridge API destination ' + self.resourceLabel() + ' lacks invocationEndpoint or connection. Fix: set an HTTPS endpoint and attach EventBridgeConnection.'
  }
}

/** Validates Event Bridge Connection elements. */
context AWSPSM!EventBridgeConnection {
  /** Checks that connection auth parameters match authorization type. */
  constraint ConnectionAuthParametersMatchAuthorizationType {
    check :
      (self.authorizationType = AWSPSMENUMS!EventBridgeConnectionAuthorizationType#API_KEY and self.authParameters.isKindOf(AWSPSM!EventBridgeApiKeyAuthParameters)) or
      (self.authorizationType = AWSPSMENUMS!EventBridgeConnectionAuthorizationType#BASIC and self.authParameters.isKindOf(AWSPSM!EventBridgeBasicAuthParameters)) or
      (self.authorizationType = AWSPSMENUMS!EventBridgeConnectionAuthorizationType#OAUTH_CLIENT_CREDENTIALS and self.authParameters.isKindOf(AWSPSM!EventBridgeOAuthParameters))
    message : 'EventBridge connection ' + self.resourceLabel() + ' uses authParameters that do not match authorizationType. Fix: use the concrete auth parameter class for the selected authorization type.'
  }
}
