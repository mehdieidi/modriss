/** Provides reusable shared validation helpers operations. */
/** Returns whether the receiver contains a non-empty textual value. */
operation Any hasText() : Boolean {
  return self.isDefined() and self.asString().trim().length() > 0;
}

/** Computes first text. */
operation firstText(primary, fallback) : String {
  if (primary.hasText()) {
    return primary.asString();
  }
  if (fallback.hasText()) {
    return fallback.asString();
  }
  return "";
}

/** Computes label text. */
operation KERNEL!ModelElement labelText() : String {
  if (self.name.hasText()) {
    return self.name;
  }
  if (self.`id`.hasText()) {
    return self.`id`;
  }
  return "<unnamed " + self.eClass().getName() + ">";
}
