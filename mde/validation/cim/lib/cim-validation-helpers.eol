operation Any hasText() : Boolean {
  return self.isDefined() and self.asString().trim().size() > 0;
}

operation Collection hasItems() : Boolean {
  return self.isDefined() and self.size() > 0;
}

operation KERNEL!Multiplicity hasMultiplicityBounds() : Boolean {
  return self.isDefined() and self.lowerBound.isDefined() and
    (self.upperBound.isDefined() or self.unbounded = true);
}

operation KERNEL!Multiplicity isMany() : Boolean {
  return self.isDefined() and
    (self.unbounded = true or (self.upperBound.isDefined() and self.upperBound > 1));
}

operation Any hasExpressionBody() : Boolean {
  if (self.isUndefined() or self.eClass().getName() <> "Expression") {
    return false;
  }
  return self.language.isDefined() and self.body.hasText();
}

operation collectionHasUniqueNames(items) : Boolean {
  var seen : Set = Set{};
  for (item in items) {
    var key = firstText(item.businessName, item.name);
    if (seen.includes(key)) {
      return false;
    }
    seen.add(key);
  }
  return true;
}

operation CIM!InformationItem hasSubItemCycle() : Boolean {
  return self.hasSubItemCycle(Set{}, Set{});
}

operation CIM!InformationItem hasSubItemCycle(visited : Set, active : Set) : Boolean {
  if (active.includes(self)) {
    return true;
  }
  if (visited.includes(self)) {
    return false;
  }
  visited.add(self);
  active.add(self);
  for (child in self.subItems) {
    if (child.hasSubItemCycle(visited, active)) {
      return true;
    }
  }
  active.remove(self);
  return false;
}

@cached
operation cimOutgoingTransitionCountBySourceId() : Map {
  var index = new Map;
  for (transitionItem in CIM!ProcessTransition.all.select(t | t.source.isDefined())) {
    var key = transitionItem.source.`id`;
    var count = index.get(key);
    if (count.isUndefined()) {
      count = 0;
    }
    index.put(key, count + 1);
  }
  return index;
}

operation CIM!DecisionStep outgoingTransitionCount() : Integer {
  var count = cimOutgoingTransitionCountBySourceId().get(self.`id`);
  if (count.isUndefined()) {
    return 0;
  }
  return count;
}

@cached
operation providerTechnologyPattern() : String {
  return "(?i).*(lambda|dynamodb|sqs|sns|eventbridge|cloudwatch|xray|iam|cognito|s3|aws|arn|sam|cloudformation|azure|gcp|pubsub|kafka|kubernetes|terraform).*";
}

operation KERNEL!ModelElement labelText() : String {
  if (self.name.hasText()) {
    return self.name;
  }
  return "<unnamed " + self.eClass().getName() + ">";
}

@cached
operation KERNEL!ModelElement containsProviderTechnologyTerm() : Boolean {
  return
    ((self.name.hasText()) and (self.name.matches(providerTechnologyPattern()))) or
    ((self.summary.hasText()) and (self.summary.matches(providerTechnologyPattern()))) or
    ((self.description.hasText()) and (self.description.matches(providerTechnologyPattern()))) or
    ((self.documentation.hasText()) and (self.documentation.matches(providerTechnologyPattern())));
}

@cached
operation CIM!DataClassification isPersonalKind() : Boolean {
  return (self.kind = CIM!DataKind#PERSONAL) or (self.kind = CIM!DataKind#SENSITIVE_PERSONAL) or
    (self.kind = CIM!DataKind#FINANCIAL) or (self.kind = CIM!DataKind#HEALTH) or
    (self.kind = CIM!DataKind#REGULATED);
}

@cached
operation CIM!DataClassification requiresStrongProtection() : Boolean {
  return
    (self.kind = CIM!DataKind#SENSITIVE_PERSONAL) or
    (self.kind = CIM!DataKind#FINANCIAL) or
    (self.kind = CIM!DataKind#HEALTH) or
    (self.kind = CIM!DataKind#AUTHENTICATION_SECRET) or
    (self.kind = CIM!DataKind#REGULATED);
}

@cached
operation CIM!InformationItem hasPersonalClassification() : Boolean {
  return self.classification.isDefined() and self.classification.isPersonalKind();
}

@cached
operation CIM!InformationItem requiresPrivacyControls() : Boolean {
  return
    self.hasPersonalClassification() or
    ((self.classification.isDefined()) and
      ((self.classification.kind = CIM!DataKind#FINANCIAL) or
       (self.classification.kind = CIM!DataKind#HEALTH) or
       (self.classification.kind = CIM!DataKind#REGULATED)));
}

@cached
operation CIM!Command hasHumanIssuer() : Boolean {
  return self.issuedBy.exists(actorItem | actorItem.actorType = CIM!ActorType#HUMAN);
}

@cached
operation CIM!Command hasExternalOrUntrustedIssuer() : Boolean {
  return self.issuedBy.exists(actorItem |
    (actorItem.actorType = CIM!ActorType#EXTERNAL_SYSTEM) or
    (actorItem.actorType = CIM!ActorType#EXTERNAL_ORGANIZATION) or
    (actorItem.trustLevel = CIM!TrustLevel#UNTRUSTED_EXTERNAL) or
    (actorItem.trustLevel = CIM!TrustLevel#REGULATED_EXTERNAL)
  );
}

@cached
operation CIM!Command hasAuthorizationDecision() : Boolean {
  return (self.authorizationRequired = true) and self.authorizationRule.hasText();
}

@cached
operation CIM!Query outputsPersonalData() : Boolean {
  return self.output.exists(item | item.hasPersonalClassification());
}

@cached
operation CIM!CIMModel isProductionReadyIntent() : Boolean {
  return
    (self.lifecycleStatus = KERNEL!LifecycleStatus#PRODUCTION_READY) or
    ((self.readiness.isDefined()) and (self.readiness.productionReady = true));
}
