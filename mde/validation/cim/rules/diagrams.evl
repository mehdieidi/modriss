import "../lib/cim-validation-helpers.eol";

context CIM!DiagramModel {

  critique DiagramModelHasViews {
    check : self.views.size() > 0
    message :
      "Warning [CIM-DIAG-001] DiagramModel '" + self.labelText() + "' has no views. " +
      "Suggestion: add at least one DiagramView for stakeholder navigation or review."
  }
}

context CIM!DiagramView {

  critique PrimaryDiagramViewIsUniqueInDiagram {
    guard : self.primaryView = true
    check :
      self.eContainer().views.select(viewItem |
        (viewItem <> self) and (viewItem.primaryView = true) and (viewItem.viewType = self.viewType)
      ).size() = 0
    message :
      "Warning [CIM-DIAG-002] More than one primary DiagramView exists for the same viewType. " +
      "Suggestion: keep only one primary view per diagram view type."
  }

  critique DiagramViewHasContent {
    check : (self.nodes.size() > 0) or (self.edges.size() > 0)
    message :
      "Warning [CIM-DIAG-003] DiagramView '" + self.labelText() + "' has no nodes or edges. " +
      "Suggestion: add visual nodes/edges or remove the empty view."
  }
}

context CIM!DiagramNode {

  constraint DiagramNodeHasSemanticElement {
    check : self.semanticElement.isDefined()
    message :
      "Error [CIM-DIAG-004] DiagramNode '" + self.labelText() + "' has no semanticElement. " +
      "Suggestion: link the node to the CIM element it visualizes."
  }

  critique DiagramNodeHasUsableBounds {
    check :
      self.width.isDefined() and self.height.isDefined() and
      (self.width > 0.0) and (self.height > 0.0)
    message :
      "Warning [CIM-DIAG-005] DiagramNode '" + self.labelText() + "' has missing or non-positive width/height. " +
      "Suggestion: set positive dimensions so the frontend can render the node."
  }
}

context CIM!DiagramEdge {

  constraint DiagramEdgeHasSemanticEnds {
    check : self.semanticSource.isDefined() and self.semanticTarget.isDefined()
    message :
      "Error [CIM-DIAG-006] DiagramEdge '" + self.labelText() + "' lacks semanticSource or semanticTarget. " +
      "Suggestion: link the edge to the source and target semantic elements it connects."
  }

  critique DiagramEdgeRelationshipMatchesEnds {
    guard : self.relationshipElement.isDefined()
    check :
      (self.relationshipElement.source = self.semanticSource) and
      (self.relationshipElement.target = self.semanticTarget)
    message :
      "Warning [CIM-DIAG-007] DiagramEdge '" + self.labelText() + "' has a relationshipElement whose source/target do not match semanticSource/semanticTarget. " +
      "Suggestion: reconnect the edge or choose the relationship element that actually connects the displayed endpoints."
  }
}
