/** Validates the semantic rules for organization intent. */
import "../lib/cim-validation-helpers.eol";

/** Validates Requirement elements. */
context CIM!Requirement {

  /** Checks that requirement has fit criterion or acceptance criteria. */
  constraint RequirementHasFitCriterionOrAcceptanceCriteria {
    check : self.fitCriterion.hasText() or self.acceptanceCriteria.notEmpty()
    message :
      "Error [CIM-REQ-001] Requirement '" + self.labelText() + "' has neither a fitCriterion nor acceptanceCriteria. " +
      "Suggestion: add a measurable fit criterion or at least one Given/When/Then-style acceptance criterion describing how satisfaction will be judged."
  }

  /** Checks that production blocking requirement is mandatory. */
  constraint ProductionBlockingRequirementIsMandatory {
    guard : self.productionBlocking = true
    check : self.mandatory = true
    message :
      "Error [CIM-REQ-002] Requirement '" + self.labelText() + "' blocks production but is not marked mandatory. " +
      "Suggestion: set mandatory=true or downgrade productionBlocking=false if the requirement is not a release gate."
  }

  /** Checks that requirement does not depend on itself. */
  constraint RequirementDoesNotDependOnItself {
    check :
      (not self.dependsOn.includes(self)) and (not self.conflictsWith.includes(self))
    message :
      "Error [CIM-REQ-003] Requirement '" + self.labelText() + "' depends on or conflicts with itself. " +
      "Suggestion: remove the self-reference and model the actual dependency/conflict with another requirement."
  }

  /** Advises that requirement supports goal or constrains element. */
  critique RequirementSupportsGoalOrConstrainsElement {
    check : self.supportsGoals.notEmpty() or self.constrains.notEmpty()
    message :
      "Warning [CIM-REQ-004] Requirement '" + self.labelText() + "' is not connected to a business goal or constrained element. " +
      "Suggestion: link it to the goal it supports or the model element it constrains so transformation and readiness checks can assess impact."
  }
}

/** Validates Acceptance Criterion elements. */
context CIM!AcceptanceCriterion {

  /** Checks that acceptance criterion uses given when then. */
  constraint AcceptanceCriterionUsesGivenWhenThen {
    check :
      self.givenContext.hasText() and self.whenAction.hasText() and self.thenOutcome.hasText()
    message :
      "Error [CIM-REQ-005] AcceptanceCriterion '" + self.labelText() + "' is incomplete. " +
      "Suggestion: fill givenContext, whenAction, and thenOutcome so the condition, stimulus, and expected result are explicit."
  }

  /** Advises that automatable acceptance criterion has target. */
  critique AutomatableAcceptanceCriterionHasTarget {
    guard : self.automatableTestCandidate = true
    check : self.measurableTarget.hasText()
    message :
      "Warning [CIM-REQ-006] AcceptanceCriterion '" + self.labelText() + "' is marked automatable but has no measurableTarget. " +
      "Suggestion: add a concrete observable target such as a threshold, state change, emitted event, or response condition."
  }
}

/** Validates Business Goal elements. */
context CIM!BusinessGoal {

  /** Checks that business goal has success criterion. */
  constraint BusinessGoalHasSuccessCriterion {
    check : self.successCriterion.hasText()
    message :
      "Error [CIM-GOAL-001] BusinessGoal '" + self.labelText() + "' has no successCriterion. " +
      "Suggestion: state the business outcome that proves the goal has been achieved, preferably in measurable terms."
  }

  /** Advises that critical goal has owner and kpi. */
  critique CriticalGoalHasOwnerAndKpi {
    guard : self.priority = KERNEL!Priority#CRITICAL
    check : self.owners.notEmpty() and self.measuredBy.notEmpty()
    message :
      "Warning [CIM-GOAL-002] Critical BusinessGoal '" + self.labelText() + "' has no owner or KPI. " +
      "Suggestion: assign an accountable stakeholder and at least one KPI so the critical goal can be governed."
  }

  /** Advises that business goal explains value and risk. */
  critique BusinessGoalExplainsValueAndRisk {
    check : self.businessValue.hasText() and self.failureConsequence.hasText()
    message :
      "Warning [CIM-GOAL-003] BusinessGoal '" + self.labelText() + "' does not explain businessValue or failureConsequence. " +
      "Suggestion: describe why the goal matters and what happens if it is not met."
  }
}

/** Validates KPI elements. */
context CIM!KPI {

  /** Checks that kpi is measurable. */
  constraint KPIIsMeasurable {
    check :
      self.metricName.hasText() and self.targetValue.hasText() and self.unit.hasText()
    message :
      "Error [CIM-KPI-001] KPI '" + self.labelText() + "' is not measurable. " +
      "Suggestion: provide metricName, targetValue, and unit, for example 'approval latency', '<= 2', and 'business days'."
  }

  /** Advises that kpi has measurement method. */
  critique KPIHasMeasurementMethod {
    check :
      self.metricDefinition.hasText() and self.measurementFrequency.hasText() and self.dataSource.hasText()
    message :
      "Warning [CIM-KPI-002] KPI '" + self.labelText() + "' lacks a definition, measurementFrequency, or dataSource. " +
      "Suggestion: define how the metric is calculated, how often it is measured, and where the measurement comes from."
  }

  /** Advises that kpi has recognisable operator. */
  critique KPIHasRecognisableOperator {
    guard : self.operator.hasText()
    check : Sequence{"<", "<=", ">", ">=", "=", "==", "between", "increases", "decreases"}.includes(self.operator)
    message :
      "Warning [CIM-KPI-003] KPI '" + self.labelText() + "' uses a non-standard operator. " +
      "Suggestion: use one of <, <=, >, >=, =, ==, between, increases, or decreases, or document the operator in metricDefinition."
  }
}

/** Validates Stakeholder elements. */
context CIM!Stakeholder {

  /** Advises that stakeholder concern is declared. */
  critique StakeholderConcernIsDeclared {
    check : self.stakeholderType.hasText() and self.concern.hasText()
    message :
      "Warning [CIM-ORG-001] Stakeholder '" + self.labelText() + "' has no stakeholderType or concern. " +
      "Suggestion: capture the stakeholder category and the concern they represent, such as operations, compliance, customer support, or product ownership."
  }
}

/** Validates Actor elements. */
context CIM!Actor {

  /** Checks that actor has type and trust level. */
  constraint ActorHasTypeAndTrustLevel {
    check : self.actorType.isDefined() and self.trustLevel.isDefined()
    message :
      "Error [CIM-ACTOR-001] Actor '" + self.labelText() + "' must declare actorType and trustLevel. " +
      "Suggestion: classify who/what the actor is and how much the business trusts it; this drives authorization, privacy, and boundary validations."
  }

  /** Advises that human actor has role. */
  critique HumanActorHasRole {
    guard : self.actorType = CIM!ActorType#HUMAN
    check : self.playsRoles.notEmpty()
    message :
      "Warning [CIM-ACTOR-002] Human Actor '" + self.labelText() + "' has no assigned Role. " +
      "Suggestion: add at least one role describing the responsibility and business permissions used when issuing commands or queries."
  }

  /** Checks that external actor declares auth expectations. */
  constraint ExternalActorDeclaresAuthExpectations {
    guard :
      (self.actorType = CIM!ActorType#EXTERNAL_SYSTEM) or
      (self.actorType = CIM!ActorType#EXTERNAL_ORGANIZATION) or
      (self.trustLevel = CIM!TrustLevel#UNTRUSTED_EXTERNAL) or
      (self.trustLevel = CIM!TrustLevel#REGULATED_EXTERNAL)
    check : self.authenticationExpectation.hasText() and self.authorizationExpectation.hasText()
    message :
      "Error [CIM-ACTOR-003] External or untrusted Actor '" + self.labelText() + "' lacks authenticationExpectation or authorizationExpectation. " +
      "Suggestion: describe how identity is established and which business permissions or policies constrain the actor."
  }
}

/** Validates Role elements. */
context CIM!Role {

  /** Checks that privileged role has permission summary. */
  constraint PrivilegedRoleHasPermissionSummary {
    guard : self.privileged = true
    check : self.responsibility.hasText() and self.businessPermissionSummary.hasText()
    message :
      "Error [CIM-ROLE-001] Privileged Role '" + self.labelText() + "' lacks responsibility or businessPermissionSummary. " +
      "Suggestion: document the privileged responsibility and the business permissions that justify elevated access."
  }

  /** Advises that role assigned to actor. */
  critique RoleAssignedToActor {
    check : self.assignedTo.notEmpty()
    message :
      "Warning [CIM-ROLE-002] Role '" + self.labelText() + "' is not assigned to any Actor. " +
      "Suggestion: assign it to the actors who perform that responsibility, or remove the unused role."
  }
}

/** Validates External System elements. */
context CIM!ExternalSystem {

  /** Checks that actor type matches subclass. */
  constraint ActorTypeMatchesSubclass {
    check : self.actorType = CIM!ActorType#EXTERNAL_SYSTEM
    message :
      "Error [CIM-EXT-000] ExternalSystem '" + self.labelText() + "' must have actorType=EXTERNAL_SYSTEM. " +
      "Suggestion: align the actorType enum with the concrete ExternalSystem class."
  }

  /** Checks that external system declares purpose and trust. */
  constraint ExternalSystemDeclaresPurposeAndTrust {
    check :
      self.owningOrganization.hasText() and self.businessPurpose.hasText() and self.trustRationale.hasText()
    message :
      "Error [CIM-EXT-001] ExternalSystem '" + self.labelText() + "' lacks owningOrganization, businessPurpose, or trustRationale. " +
      "Suggestion: identify who owns the system, why the business integrates with it, and why its trust level is acceptable."
  }

  /** Checks that external system data exchange is explicit. */
  constraint ExternalSystemDataExchangeIsExplicit {
    guard :
      (self.storesBusinessData = true) or
      (self.sendsBusinessEvents = true) or
      (self.receivesBusinessEvents = true)
    check :
      self.exchangedInformation.notEmpty() or
      self.producedEvents.notEmpty() or
      self.consumedEvents.notEmpty()
    message :
      "Error [CIM-EXT-002] ExternalSystem '" + self.labelText() + "' is marked as exchanging/storing business data but no exchangedInformation or events are linked. " +
      "Suggestion: connect the information items and business events crossing the boundary."
  }
}

/** Validates Business Capability elements. */
context CIM!BusinessCapability {

  /** Checks that capability supports goal. */
  constraint CapabilitySupportsGoal {
    check : self.supports.notEmpty()
    message :
      "Error [CIM-CAP-001] BusinessCapability '" + self.labelText() + "' supports no BusinessGoal. " +
      "Suggestion: link the capability to at least one goal, or remove it if it is outside the CIM scope."
  }

  /** Checks that capability has owner or responsibility. */
  constraint CapabilityHasOwnerOrResponsibility {
    check :
      self.owner.isDefined() or self.ownerName.hasText() or self.responsibility.hasText()
    message :
      "Error [CIM-CAP-002] BusinessCapability '" + self.labelText() + "' lacks an owner or responsibility. " +
      "Suggestion: assign an Actor owner, provide ownerName, or describe the responsibility boundary."
  }

  /** Advises that capability has behavior or managed data. */
  critique CapabilityHasBehaviorOrManagedData {
    check :
      self.containsCommands.notEmpty() or self.containsQueries.notEmpty() or
      self.containsEvents.notEmpty() or self.managesEntities.notEmpty() or
      self.ownsProcesses.notEmpty()
    message :
      "Warning [CIM-CAP-003] BusinessCapability '" + self.labelText() + "' has no commands, queries, events, managed entities, or processes. " +
      "Suggestion: add the behavior/data it owns, or mark it as out of transformation scope using notes/rationale."
  }

  /** Advises that critical capability has requirements and nfrs. */
  critique CriticalCapabilityHasRequirementsAndNfrs {
    guard :
      (self.criticality = CIM!CapabilityCriticality#CORE) or
      (self.criticality = CIM!CapabilityCriticality#MISSION_CRITICAL)
    check : self.realizesRequirements.notEmpty() and self.constrainedBy.notEmpty()
    message :
      "Warning [CIM-CAP-004] Core or mission-critical BusinessCapability '" + self.labelText() + "' lacks realized requirements or non-functional constraints. " +
      "Suggestion: connect the capability to functional/business requirements and the relevant NFRs for performance, security, privacy, auditability, or reliability."
  }
}

/** Validates Capability Dependency elements. */
context CIM!CapabilityDependency {

  /** Checks that capability dependency is meaningful. */
  constraint CapabilityDependencyIsMeaningful {
    check :
      (self.source <> self.target) and self.dependencyReason.hasText()
    message :
      "Error [CIM-CAP-005] CapabilityDependency '" + self.labelText() + "' is self-referential or lacks dependencyReason. " +
      "Suggestion: connect two distinct capabilities and explain the business reason for the dependency."
  }

  /** Advises that critical dependency has rationale. */
  critique CriticalDependencyHasRationale {
    guard : self.criticalPath = true
    check : self.rationale.hasText() or self.dependencyReason.hasText()
    message :
      "Warning [CIM-CAP-006] Critical-path CapabilityDependency '" + self.labelText() + "' needs a stronger rationale. " +
      "Suggestion: document why this dependency is on the critical path and what transformation risk it introduces."
  }
}

/** Validates Bounded Context Candidate elements. */
context CIM!BoundedContextCandidate {

  /** Checks that bounded context has boundary definition. */
  constraint BoundedContextHasBoundaryDefinition {
    check : self.languageBoundary.hasText() and self.ownershipBoundary.hasText()
    message :
      "Error [CIM-BC-001] BoundedContextCandidate '" + self.labelText() + "' lacks languageBoundary or ownershipBoundary. " +
      "Suggestion: state the ubiquitous language boundary and the ownership/team/business boundary."
  }

  /** Advises that bounded context has scoped content. */
  critique BoundedContextHasScopedContent {
    check :
      self.capabilities.notEmpty() or self.entities.notEmpty() or
      self.commands.notEmpty() or self.queries.notEmpty() or
      self.events.notEmpty() or self.policies.notEmpty()
    message :
      "Warning [CIM-BC-002] BoundedContextCandidate '" + self.labelText() + "' has no scoped content. " +
      "Suggestion: add capabilities, entities, commands, queries, events, or policies that belong to this boundary."
  }

  /** Advises that commands target context owned aggregates. */
  critique CommandsTargetContextOwnedAggregates {
    check : self.commands.forAll(commandItem |
      commandItem.targetAggregate.isUndefined() or
      (self.entities.includes(commandItem.targetAggregate.root) and commandItem.targetAggregate.members.forAll(member | self.entities.includes(member))) or
      CIM!CapabilityDependency.all.exists(dep | self.capabilities.includes(dep.source) or self.capabilities.includes(dep.target))
    )
    message :
      "Warning [CIM-BC-003] BoundedContextCandidate '" + self.labelText() + "' contains commands that target aggregates/entities outside the context without an explicit dependency. " +
      "Suggestion: add a CapabilityDependency or integration event for cross-boundary writes."
  }
}

/** Validates Ubiquitous Language Term elements. */
context CIM!UbiquitousLanguageTerm {

  /** Checks that ubiquitous language term has definition. */
  constraint UbiquitousLanguageTermHasDefinition {
    check : self.term.hasText() and self.definition.hasText()
    message :
      "Error [CIM-UL-001] UbiquitousLanguageTerm '" + self.term + "' has no definition. " +
      "Suggestion: define the term in business language and add synonyms/forbiddenSynonyms where ambiguity is likely."
  }

  /** Advises that ubiquitous language term is unique in context. */
  critique UbiquitousLanguageTermIsUniqueInContext {
    guard : self.term.hasText()
    check :
      CIM!UbiquitousLanguageTerm.all.none(termItem |
        (termItem <> self) and
        (termItem.term.hasText()) and
        (termItem.term.toLowerCase() = self.term.toLowerCase()) and
        (termItem.`context` = self.`context`)
      )
    message :
      "Warning [CIM-UL-002] UbiquitousLanguageTerm '" + self.term + "' is duplicated in the same bounded context. " +
      "Suggestion: merge duplicate terms or clarify if the terms intentionally have different meanings."
  }
}
