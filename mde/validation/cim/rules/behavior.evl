/** Validates the semantic rules for behavior. */
import "../lib/cim-validation-helpers.eol";

/** Validates Command elements. */
context CIM!Command {

  /** Checks that command must cause business outcome. */
  constraint CommandMustCauseBusinessOutcome {
    check : self.expectedEvents.notEmpty() or self.rejectionEvents.notEmpty()
    message :
      "Error [CIM-CMD-001] Command '" + self.labelText() + "' has no expectedEvents or rejectionEvents. " +
      "Suggestion: link the business facts that occur when the command succeeds or is rejected."
  }

  /** Checks that command has behavioral owner. */
  constraint CommandHasBehavioralOwner {
    check : self.targetCapability.isDefined() or self.targetAggregate.isDefined()
    message :
      "Error [CIM-CMD-002] Command '" + self.labelText() + "' has no targetCapability or targetAggregate. " +
      "Suggestion: assign the capability or aggregate responsible for deciding and executing the command."
  }

  /** Checks that actor facing command has authorization decision. */
  constraint ActorFacingCommandHasAuthorizationDecision {
    guard : self.hasHumanIssuer()
    check : self.hasAuthorizationDecision()
    message :
      "Error [CIM-CMD-003] Human-issued Command '" + self.labelText() + "' lacks an explicit authorization decision. " +
      "Suggestion: set authorizationRequired=true and add an authorizationRule explaining who may issue it and under what business conditions."
  }

  /** Checks that external or untrusted command requires audit and authorization. */
  constraint ExternalOrUntrustedCommandRequiresAuditAndAuthorization {
    guard : self.hasExternalOrUntrustedIssuer()
    check : (self.auditRequired = true) and self.hasAuthorizationDecision()
    message :
      "Error [CIM-CMD-004] Command '" + self.labelText() + "' is issued by an external/untrusted actor but lacks auditRequired=true or an authorizationRule. " +
      "Suggestion: require authorization and auditing for commands crossing trust boundaries."
  }

  /** Advises that duplicate submission command has idempotency key. */
  critique DuplicateSubmissionCommandHasIdempotencyKey {
    guard : self.duplicateSubmissionPossible = true
    check : self.idempotencyBusinessKey.hasText()
    message :
      "Warning [CIM-CMD-005] Command '" + self.labelText() + "' may be submitted more than once but has no idempotencyBusinessKey. " +
      "Suggestion: define the business key that lets the system recognize duplicate intent."
  }

  /** Advises that command has preconditions or errors. */
  critique CommandHasPreconditionsOrErrors {
    check : self.preconditions.notEmpty() or self.possibleErrors.notEmpty()
    message :
      "Warning [CIM-CMD-006] Command '" + self.labelText() + "' has no preconditions or possibleErrors. " +
      "Suggestion: document business conditions and rejection/error cases so command semantics are complete."
  }

  /** Advises that command outcome links match direct collections. */
  critique CommandOutcomeLinksMatchDirectCollections {
    guard : self.outcomes.notEmpty()
    check {
      var successEvents : Set = Set{};
      var rejectionEvents : Set = Set{};
      var outcomeErrors : Set = Set{};

      // Flatten detailed outcomes before comparing both representations in both directions.
      for (outcome in self.outcomes) {
        for (eventItem in outcome.emittedEvents) {
          if (outcome.success = true) {
            successEvents.add(eventItem);
          }
          else {
            rejectionEvents.add(eventItem);
          }
        }
        outcomeErrors.addAll(outcome.errors);
      }

      return self.expectedEvents.forAll(eventItem | successEvents.includes(eventItem)) and
        self.rejectionEvents.forAll(eventItem | rejectionEvents.includes(eventItem)) and
        self.possibleErrors.forAll(errorItem | outcomeErrors.includes(errorItem)) and
        successEvents.forAll(eventItem | self.expectedEvents.includes(eventItem)) and
        rejectionEvents.forAll(eventItem | self.rejectionEvents.includes(eventItem)) and
        outcomeErrors.forAll(errorItem | self.possibleErrors.includes(errorItem));
    }
    message :
      "Warning [CIM-CMD-007] Command '" + self.labelText() + "' has CommandOutcome event/error links that are not reflected in expectedEvents, rejectionEvents, or possibleErrors. " +
      "Suggestion: keep direct command collections and detailed outcomes consistent until outcome-derived helpers fully replace direct links."
  }
}

/** Validates Query elements. */
context CIM!Query {

  /** Checks that personal query must declare authorization. */
  constraint PersonalQueryMustDeclareAuthorization {
    guard : (self.containsPersonalData = true) or self.outputsPersonalData()
    check : (self.authorizationRequired = true) and self.authorizationRule.hasText()
    message :
      "Error [CIM-QRY-002] Query '" + self.labelText() + "' returns or declares personal data but lacks authorizationRequired=true and authorizationRule. " +
      "Suggestion: specify who may read this data and under which business/legal conditions."
  }

  /** Advises that query personal flag matches output. */
  critique QueryPersonalFlagMatchesOutput {
    check :
      (self.containsPersonalData = self.outputsPersonalData()) or
      ((self.containsPersonalData = true) and self.output.isEmpty())
    message :
      "Warning [CIM-QRY-003] Query '" + self.labelText() + "' has containsPersonalData inconsistent with output classifications. " +
      "Suggestion: update containsPersonalData or classify the output InformationItems correctly."
  }

  /** Advises that list search query declares result handling. */
  critique ListSearchQueryDeclaresResultHandling {
    guard : (self.queryType = CIM!QueryType#LIST) or (self.queryType = CIM!QueryType#SEARCH)
    check : self.paginationExpectation.hasText() and self.filteringExpectation.hasText()
    message :
      "Warning [CIM-QRY-004] List/Search Query '" + self.labelText() + "' lacks paginationExpectation or filteringExpectation. " +
      "Suggestion: declare expected pagination and filtering behavior so frontends and read models can be generated safely."
  }

  /** Advises that query declares freshness. */
  critique QueryDeclaresFreshness {
    check : self.freshnessNeed.isDefined()
    message :
      "Warning [CIM-QRY-005] Query '" + self.labelText() + "' has no freshnessNeed. " +
      "Suggestion: choose REAL_TIME, NEAR_REAL_TIME, EVENTUALLY_CONSISTENT, PERIODIC, or HISTORICAL."
  }
}

/** Validates Business Event elements. */
context CIM!BusinessEvent {

  /** Checks that event name past tense. */
  constraint EventNamePastTense {
    check :
      (self.name.matches("(?i).*(ed|done|completed|created|updated|deleted|rejected|accepted|submitted|failed|cancelled)$")) or
      self.occurredInPastTenseName.hasText()
    message :
      "Error [CIM-EVT-001] BusinessEvent '" + self.labelText() + "' is not clearly named as a past-tense business fact. " +
      "Suggestion: rename it to a past-tense fact such as 'OrderSubmitted', 'PaymentRejected', or fill occurredInPastTenseName."
  }

  /** Checks that event is business fact not command. */
  constraint EventIsBusinessFactNotCommand {
    check :
      (not self.name.startsWith("Create")) and
      (not self.name.startsWith("Update")) and
      (not self.name.startsWith("Delete")) and
      (not self.name.startsWith("Submit")) and
      (not self.name.startsWith("Approve")) and
      (not self.name.startsWith("Cancel"))
    message :
      "Error [CIM-EVT-002] BusinessEvent '" + self.labelText() + "' is named like an imperative command. " +
      "Suggestion: model commands as Command elements and events as facts that already happened, e.g. 'CustomerApproved' instead of 'ApproveCustomer'."
  }

  /** Checks that event has business meaning. */
  constraint EventHasBusinessMeaning {
    check : self.businessMeaning.hasText() or self.semanticName.hasText()
    message :
      "Error [CIM-EVT-003] BusinessEvent '" + self.labelText() + "' lacks businessMeaning or semanticName. " +
      "Suggestion: explain the business fact and why it matters."
  }

  /** Advises that event has producer or consumer. */
  critique EventHasProducerOrConsumer {
    check :
      self.expectedByCommands.notEmpty() or self.rejectedByCommands.notEmpty() or
      self.causedByPolicies.notEmpty() or self.causedByExternalSystems.notEmpty() or
      self.consumedByPolicies.notEmpty() or self.consumedByProcesses.notEmpty() or
      self.consumedByExternalSystems.notEmpty()
    message :
      "Warning [CIM-EVT-004] BusinessEvent '" + self.labelText() + "' has no producer or consumer. " +
      "Suggestion: connect it to a command, policy, process, or external system that produces or consumes it."
  }

  /** Checks that production relevant event has versioning metadata. */
  constraint ProductionRelevantEventHasVersioningMetadata {
    guard : self.externallyVisible = true or self.auditRelevant = true or self.retentionRelevant = true
    check : self.semanticVersion.hasText() and self.versioningRationale.hasText()
    message :
      "Error [CIM-EVT-005] Production-relevant BusinessEvent '" + self.labelText() + "' lacks semanticVersion or versioningRationale. " +
      "Suggestion: set an explicit semantic version and describe how event meaning/payload changes will be managed."
  }

  /** Checks that event semantic version looks like sem ver. */
  constraint EventSemanticVersionLooksLikeSemVer {
    guard : self.semanticVersion.hasText()
    check : self.semanticVersion.matches("^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$")
    message :
      "Error [CIM-EVT-005A] BusinessEvent '" + self.labelText() + "' has semanticVersion '" + self.semanticVersion + "' that is not SemVer-like. " +
      "Suggestion: use MAJOR.MINOR.PATCH with optional prerelease/build metadata, for example 1.0.0."
  }

  /** Checks that event payload information is typed. */
  constraint EventPayloadInformationIsTyped {
    check : self.payload.forAll(item | item.type.isDefined())
    message :
      "Error [CIM-EVT-006] BusinessEvent '" + self.labelText() + "' has payload InformationItems without type. " +
      "Suggestion: type every payload item so event schemas and transformations are deterministic."
  }
}

/** Validates Business Error elements. */
context CIM!BusinessError {

  /** Checks that business error is user understandable. */
  constraint BusinessErrorIsUserUnderstandable {
    check :
      self.errorCode.hasText() and self.businessMeaning.hasText() and self.userVisibleMessage.hasText()
    message :
      "Error [CIM-ERR-001] BusinessError '" + self.labelText() + "' lacks errorCode, businessMeaning, or userVisibleMessage. " +
      "Suggestion: define a stable business error code and a user-facing explanation that does not expose implementation details."
  }

  /** Advises that retry meaningful implies recoverable. */
  critique RetryMeaningfulImpliesRecoverable {
    guard : self.retryMeaningful = true
    check : self.recoverable = true
    message :
      "Warning [CIM-ERR-002] BusinessError '" + self.labelText() + "' says retry is meaningful but recoverable is not true. " +
      "Suggestion: set recoverable=true or explain why retrying is meaningful despite non-recoverability."
  }
}

/** Validates Condition elements. */
context CIM!Condition {

  /** Checks that condition is specified. */
  constraint ConditionIsSpecified {
    check : self.naturalLanguage.hasText() or self.expression.hasText() or self.expressionModel.hasExpressionBody()
    message :
      "Error [CIM-COND-001] Condition '" + self.labelText() + "' has neither naturalLanguage, expression, nor expressionModel. " +
      "Suggestion: write the condition in business language and optionally add expressionModel.body for automation."
  }

  /** Checks that automatable condition has expression. */
  constraint AutomatableConditionHasExpression {
    guard : self.mustBeAutomatable = true
    check : self.expressionModel.hasExpressionBody() or (self.expressionLanguage.isDefined() and self.expression.hasText())
    message :
      "Error [CIM-COND-002] Condition '" + self.labelText() + "' must be automatable but lacks a typed expressionModel or expressionLanguage/expression pair. " +
      "Suggestion: provide a machine-evaluable kernel.Expression with language and body."
  }

  /** Advises that condition references information or concepts. */
  critique ConditionReferencesInformationOrConcepts {
    check : self.referencedInformation.notEmpty() or self.referencedConcepts.notEmpty()
    message :
      "Warning [CIM-COND-003] Condition '" + self.labelText() + "' is not linked to referencedInformation or referencedConcepts. " +
      "Suggestion: link the data or concepts used by the condition."
  }
}
