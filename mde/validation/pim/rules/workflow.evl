/** Validates the semantic rules for workflow. */
import "../lib/pim-validation-helpers.eol";

/** Validates Workflow elements. */
context PIM!Workflow {

  /** Checks that workflow has a start step. */
  constraint WorkflowHasStartStep {
    check : self.startSteps().notEmpty()
    message : "[PIM-WF-000A] Workflow '" + self.displayName() + "' must contain at least one StartStep."
  }

  /** Checks that end steps belong to workflow. */
  constraint WorkflowHasEndSteps {
    check : self.endSteps().notEmpty() and self.endSteps().forAll(stepItem | self.steps.includes(stepItem))
    message : "[PIM-WF-000B] Workflow '" + self.displayName() + "' must contain at least one SuccessEndStep or FailureEndStep."
  }

  /** Checks that reachable from start. */
  constraint ReachableFromStart {
    check : self.steps.forAll(stepItem |
      stepItem.isKindOf(PIM!StartStep) or stepItem.incomingTransitions().notEmpty() or stepItem.rationale.hasText())
    message : "[PIM-WF-000C] Workflow '" + self.displayName() + "' contains steps that are not reachable from the start step. Fix transitions or document intentionally detached steps."
  }

  /** Checks that workflow start and end steps are contained. */
  constraint WorkflowStartAndEndStepsAreContained {
    check : self.startSteps().forAll(stepItem | self.steps.includes(stepItem))
      and self.endSteps().forAll(stepItem | self.steps.includes(stepItem))
    message : "[PIM-WF-001] Workflow '" + self.displayName() + "' has start/end steps outside its contained steps. Fix: model StartStep and end steps as contained WorkflowStep elements."
  }

  /** Checks that workflow has at least one end step. */
  constraint WorkflowHasAtLeastOneEndStep {
    check : self.endSteps().notEmpty()
    message : "[PIM-WF-002] Workflow '" + self.displayName() + "' has no end steps. Fix: add one or more SuccessEndStep or FailureEndStep elements."
  }

  /** Advises that stateful workflow needs idempotency. */
  critique StatefulWorkflowNeedsIdempotency {
    guard : self.stateful.isTrue() or self.compensationRequired.isTrue()
    check : self.idempotency.isDefined()
    message : "[PIM-WF-004] Stateful or compensation-capable workflow '" + self.displayName() + "' lacks idempotency policy. Suggested fix: attach IdempotencyPolicy to prevent duplicate side effects in retries/restarts."
  }
}

/** Validates Workflow Step elements. */
context PIM!WorkflowStep {

  /** Advises that non start step should have incoming transition. */
  critique NonStartStepShouldHaveIncomingTransition {
    guard : self.workflow.isDefined() and not self.isKindOf(PIM!StartStep)
    check : self.incomingTransitions().exists(transitionItem | transitionItem.workflow = self.workflow)
    message : "[PIM-WF-008] Workflow step '" + self.displayName() + "' is not a start step and has no incoming transition. Suggested fix: connect it from another step or remove the unreachable step."
  }

  /** Advises that timed step should use timeout policy. */
  critique TimedStepShouldUseTimeoutPolicy {
    guard : self.timeoutSeconds.isDefined() and self.timeoutSeconds > 0
    check : self.retry.isDefined() or self.catchHandlers.notEmpty() or self.rationale.hasText()
    message : "[PIM-WF-009] Workflow step '" + self.displayName() + "' has timeoutSeconds but no retry/catch/rationale. Suggested fix: define retry/error handling or explain why timeout failure needs no handling."
  }
}

/** Validates Choice Step elements. */
context PIM!ChoiceStep {

  /** Checks that choice has at least two transitions. */
  constraint ChoiceHasAtLeastTwoTransitions {
    check : self.outgoingTransitions().atLeastNMatch(transitionItem | true, 2)
    message : "[PIM-WF-005] Choice step '" + self.displayName() + "' has fewer than two outgoing transitions. Fix: add at least two transitions with conditions/default handling."
  }
}

/** Validates success end step elements. */
context PIM!SuccessEndStep {

  /** Checks that end steps have no outgoing transitions. */
  constraint EndStepsHaveNoOutgoingTransitions {
    check : self.outgoingTransitions().isEmpty()
    message : "[PIM-WF-006] End workflow step '" + self.displayName() + "' has outgoing transitions. Fix: remove outgoing transitions from terminal end steps."
  }
}

/** Validates failure end step elements. */
context PIM!FailureEndStep {

  /** Checks that end steps have no outgoing transitions. */
  constraint EndStepsHaveNoOutgoingTransitions {
    check : self.outgoingTransitions().isEmpty()
    message : "[PIM-WF-006] End workflow step '" + self.displayName() + "' has outgoing transitions. Fix: remove outgoing transitions from terminal end steps."
  }
}

/** Validates Task Step elements. */
context PIM!TaskStep {

  /** Checks that task step invokes exactly one action. */
  constraint TaskStepInvokesExactlyOneAction {
    check : self.actionCount() = 1
    message : "[PIM-WF-007] Task step '" + self.displayName() + "' must invoke exactly one function, adapter or nested workflow. Fix: set one of invokesFunction, invokesAdapter or nestedWorkflow and clear the others."
  }
}

/** Validates Workflow Transition elements. */
context PIM!WorkflowTransition {

  /** Checks that same workflow. */
  constraint SameWorkflow {
    check : self.source.isDefined() and self.target.isDefined() and self.workflow.isDefined()
      and self.source.workflow = self.workflow and self.target.workflow = self.workflow
    message : "[PIM-WF-010A] Transition '" + self.displayName() + "' must connect steps in its owning workflow."
  }

  /** Checks that transition stays inside workflow. */
  constraint TransitionStaysInsideWorkflow {
    check : self.source.isDefined() and self.target.isDefined() and self.workflow.isDefined()
      and self.source.workflow = self.workflow and self.target.workflow = self.workflow
    message : "[PIM-WF-010] Transition '" + self.displayName() + "' connects steps outside its owning workflow. Fix: set workflow, source and target, and use source/target steps contained by the same workflow."
  }

  /** Advises that conditional transition should have condition unless default. */
  critique ConditionalTransitionShouldHaveConditionUnlessDefault {
    check : self.defaultTransition.isTrue() or self.conditionExpression.hasText()
    message : "[PIM-WF-011] Transition '" + self.displayName() + "' has no conditionExpression and is not marked defaultTransition. Suggested fix: add a condition or mark it as the default branch."
  }
}

/** Validates Error Handler elements. */
context PIM!ErrorHandler {

  /** Checks that next step in same workflow. */
  constraint NextStepInSameWorkflow {
    guard : self.nextStep.isDefined()
    check : self.step.isDefined() and self.step.workflow.isDefined() and self.nextStep.workflow = self.step.workflow
    message : "[PIM-WF-012A] ErrorHandler '" + self.displayName() + "' routes to a step outside the owning workflow. Fix: choose a nextStep in the same workflow."
  }

  /** Checks that error handler has recovery target. */
  constraint ErrorHandlerHasRecoveryTarget {
    check : self.nextStep.isDefined() or self.handlerFunction.isDefined()
    message : "[PIM-WF-012] ErrorHandler '" + self.displayName() + "' has neither nextStep nor handlerFunction. Fix: route recovery to a step or handler function."
  }

  /** Advises that error handler should select errors. */
  critique ErrorHandlerShouldSelectErrors {
    check : self.errorSelector.hasText() and self.recoveryAction.hasText()
    message : "[PIM-WF-013] ErrorHandler '" + self.displayName() + "' lacks errorSelector or recoveryAction. Suggested fix: state which errors it handles and how recovery proceeds."
  }
}

/** Validates Compensation Policy elements. */
context PIM!CompensationPolicy {

  /** Checks that compensation policy is root owned. */
  constraint CompensationPolicyIsRootOwned {
    check : rootPolicyIds().includes(self.`id`)
    message : "[PIM-WF-013A] CompensationPolicy '" + self.displayName() + "' must be owned by PIMModel.policies and referenced from StartStep.compensation or TaskStep.compensation."
  }

  /** Checks that compensation policy has action. */
  constraint CompensationPolicyHasAction {
    check : self.compensationFunctions.notEmpty() or self.compensationEvents.notEmpty() or self.compensationStrategy.hasText()
    message : "[PIM-WF-014] CompensationPolicy '" + self.displayName() + "' has no compensation action. Fix: add compensation functions, compensation events or a clear strategy."
  }
}
