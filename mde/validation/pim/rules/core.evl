/** Validates the semantic rules for core. */
import "../lib/pim-validation-helpers.eol";

/** Validates PIM Model elements. */
context PIM!PIMModel {

  /** Checks that domain name required. */
  constraint DomainNameRequired {
    check : self.domainName.hasText()
    message : "[PIM-ROOT-002] The PIM model is missing a domainName. Fix: provide a stable domain or bounded-context name so generated artifacts and reports can be named consistently."
  }

  /** Checks that implementation profile required for generation. */
  constraint ImplementationProfileRequiredForGeneration {
    check : self.implementationProfile.isDefined()
    message : "[PIM-ROOT-003] Artifact generation requires an ImplementationProfile. Fix: add one with primaryLanguage, packageManager, sourceLayout, test/build commands and contract-generation choices."
  }

  /** Checks that no provider specific names in model. */
  constraint NoProviderSpecificNamesInModel {
    check : KERNEL!ModelElement.all.forAll(elementItem |
      not elementItem.name.containsProviderToken()
      and not elementItem.summary.containsProviderToken()
      and not elementItem.description.containsProviderToken()
      and not elementItem.documentation.containsProviderToken()
    )
    message : "[PIM-ROOT-004] The model contains provider-specific wording in a name or description. Fix: replace cloud/vendor service names with provider-independent domain terms such as function, queue, topic, object store, identity provider, event bus, trace, metric or deployment unit."
  }

  critique DefaultCorrelationIdShouldBeNamed {
    check : self.defaultCorrelationIdName.hasText()
    message : "No defaultCorrelationIdName is defined. Suggested fix: set a portable name such as correlationId so APIs, events, workflows and logs can share the same correlation convention."
  }

  critique ArchitectureStyleShouldMatchContents {
    check :
      (not self.architectureStyle.enumIs("API_FIRST_SERVERLESS") or self.apis.notEmpty()) and
      (not self.architectureStyle.enumIs("EVENT_DRIVEN_SERVERLESS") or self.eventTypes.notEmpty() or self.channels.notEmpty()) and
      (not self.architectureStyle.enumIs("WORKFLOW_ORCHESTRATED_SERVERLESS") or self.workflows.notEmpty())
    message : "The selected architectureStyle does not match the model contents. Suggested fix: add the matching APIs/events/workflows or choose HYBRID_SERVERLESS if multiple styles are intentionally combined."
  }
}

/** Validates Model Element elements. */
context KERNEL!ModelElement {

  /** Checks that model element id required. */
  constraint ModelElementIdRequired {
    check : self.`id`.hasText()
    message : "[PIM-NAME-001] Element id is missing. Fix: generate an id for '" + self.displayName() + "'."
  }

  /** Advises that portable name recommended. */
  critique PortableNameRecommended {
    guard : not self.isKindOf(KERNEL!TraceLink)
      and not self.isKindOf(KERNEL!ManualDecision)
      and not self.isKindOf(KERNEL!ReadinessFinding)
      and not self.isKindOf(KERNEL!ReadinessCheck)
    check : self.name.hasText() and self.name.matches("^[A-Za-z][A-Za-z0-9 _\\-.]*$")
    message : "[PIM-NAME-002] The element name '" + self.displayName() + "' is hard to use in generated artifacts. Suggested fix: start with a letter and use only letters, numbers, spaces, underscores, hyphens or dots."
  }
}

/** Validates Traceable Element elements. */
context KERNEL!TraceableElement {

  /** Advises that generated element should be traceable. */
  critique GeneratedElementShouldBeTraceable {
    guard : self.generatedByTransformation.isTrue()
      and not self.isKindOf(KERNEL!TraceLink)
      and not self.isKindOf(KERNEL!TraceModel)
      and not self.isKindOf(KERNEL!ProductionReadinessAssessment)
      and not self.isKindOf(KERNEL!ReadinessFinding)
      and not self.isKindOf(KERNEL!ReadinessCheck)
      and not self.isKindOf(KERNEL!ManualDecision)
      and not self.isGeneratedTraceSupportElement()
    check : self.generatedFrom.hasText() or self.sourceReference.hasText() or self.sourceUri.hasText() or self.traceId.hasText()
    message : "[PIM-TRACE-001] Generated element '" + self.displayName() + "' has no trace back to its source. Suggested fix: fill generatedFrom, sourceReference, sourceUri or traceId so users can understand where the element came from."
  }

  /** Advises that rationale recommended for manually maintained elements. */
  critique RationaleRecommendedForManuallyMaintainedElements {
    guard : self.manuallyMaintained.isTrue()
    check : self.rationale.hasText() or self.reviewNotes.hasText()
    message : "[PIM-TRACE-002] Manually maintained element '" + self.displayName() + "' has no rationale/review notes. Suggested fix: explain why this element is manual and how it should be reviewed."
  }
}

/** Returns whether the receiver is generated trace support element. */
operation KERNEL!TraceableElement isGeneratedTraceSupportElement() : Boolean {
  return Sequence{
    "SchemaField",
    "SchemaEnumLiteral",
    "EventEnvelope",
    "ObservabilityConfig",
    "ResiliencePolicy"
  }.includes(self.eClass().getName());
}
