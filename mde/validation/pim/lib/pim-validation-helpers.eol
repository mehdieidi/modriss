/** Provides reusable pim validation helpers operations. */
/** Returns whether the receiver contains a non-empty textual value. */
operation Any hasText() : Boolean {
  return self.isDefined() and self.asString().trim().size() > 0;
}

/** Returns whether the receiver is true. */
operation Any isTrue() : Boolean {
  return self.isDefined() and self = true;
}

/** Computes enum is. */
operation Any enumIs(expectedLiteral : String) : Boolean {
  return self.isDefined() and self.asString() = expectedLiteral;
}

/** Computes enum in. */
operation Any enumIn(expectedLiterals : Sequence) : Boolean {
  return self.isDefined() and expectedLiterals.includes(self.asString());
}

/** Computes not empty. */
operation Collection notEmpty() : Boolean {
  return self.isDefined() and self.size() > 0;
}

/** Computes display name. */
operation KERNEL!ModelElement displayName() : String {
  if (self.name.hasText()) {
    return self.name;
  }
  if (self.`id`.hasText()) {
    return self.`id`;
  }
  return self.eClass().getName() + " instance";
}

@cached
/** Returns whether the receiver contains provider token. */
operation Any containsProviderToken() : Boolean {
  if (not self.hasText()) {
    return false;
  }
  var text = self.asString().toLowerCase();
  return text.contains("lambda")
    or text.contains("dynamodb")
    or text.contains("sqs")
    or text.contains("sns")
    or text.contains("eventbridge")
    or text.contains("cloudwatch")
    or text.contains("xray")
    or text.contains("iam")
    or text.contains("cognito")
    or text.contains("s3")
    or text.contains("aws")
    or text.contains("arn")
    or text.contains("sam")
    or text.contains("cloudformation")
    or text.contains("apigateway")
    or text.contains("azure")
    or text.contains("gcp")
    or text.contains("pubsub")
    or text.contains("cloudrun")
    or text.contains("cloudfunctions")
    or text.contains("servicebus")
    or text.contains("cosmosdb")
    or text.contains("bigquery");
}

@cached
/** Computes reachable function ids. */
operation reachableFunctionIds() : Set {
  var ids : Set = Set{};

  for (functionItem in PIM!Function.all.select(f | f.triggers.notEmpty())) {
    ids.add(functionItem.`id`);
  }
  for (triggerItem in PIM!Trigger.all.select(t | t.`function`.isDefined())) {
    ids.add(triggerItem.`function`.`id`);
  }
  for (routeItem in PIM!ApiRoute.all.select(r | r.functionIntegration.isDefined())) {
    ids.add(routeItem.functionIntegration.`id`);
  }
  for (stateItem in PIM!TaskStep.all.select(s | s.invokesFunction.isDefined())) {
    ids.add(stateItem.invokesFunction.`id`);
  }
  for (choiceItem in PIM!ChoiceStep.all.select(s | s.invokesFunction.isDefined())) {
    ids.add(choiceItem.invokesFunction.`id`);
  }
  for (channelItem in PIM!EventChannel.all) {
    for (functionItem in channelItem.producers) {
      ids.add(functionItem.`id`);
    }
    for (functionItem in channelItem.consumers) {
      ids.add(functionItem.`id`);
    }
  }
  for (eventItem in PIM!EventType.all) {
    for (functionItem in eventItem.producedBy) {
      ids.add(functionItem.`id`);
    }
    for (functionItem in eventItem.consumedBy) {
      ids.add(functionItem.`id`);
    }
  }

  return ids;
}

@cached
/** Returns whether the receiver has any incoming binding. */
operation PIM!Function hasAnyIncomingBinding() : Boolean {
  return reachableFunctionIds().includes(self.`id`);
}

@cached
/** Computes owned elements. */
operation PIM!ServerlessService ownedElements() : Sequence {
  var elements = Sequence{};
  elements.addAll(self.functions);
  elements.addAll(self.apis);
  elements.addAll(self.channels);
  elements.addAll(self.schedules);
  elements.addAll(self.stores);
  elements.addAll(self.workflows);
  elements.addAll(self.adapters);
  return elements;
}

@cached
/** Collects APIs contained by all services. */
operation PIM!PIMModel allServiceApis() : Sequence {
  var apis = Sequence{};
  for (serviceItem in self.services) {
    apis.addAll(serviceItem.apis);
  }
  return apis;
}

@cached
/** Collects channels contained by all services. */
operation PIM!PIMModel allServiceChannels() : Sequence {
  var channels = Sequence{};
  for (serviceItem in self.services) {
    channels.addAll(serviceItem.channels);
  }
  return channels;
}

@cached
/** Collects workflows contained by all services. */
operation PIM!PIMModel allServiceWorkflows() : Sequence {
  var workflows = Sequence{};
  for (serviceItem in self.services) {
    workflows.addAll(serviceItem.workflows);
  }
  return workflows;
}

@cached
/** Computes service memberships. */
operation PIM!ServerlessService serviceMemberships() : Sequence {
  var memberships = serviceMembershipsByServiceId().get(self.`id`);
  if (memberships.isUndefined()) {
    return Sequence{};
  }
  return memberships;
}

@cached
/** Computes service memberships by service id. */
operation serviceMembershipsByServiceId() : Map {
  var index = new Map;
  for (membershipItem in PIM!ServiceElementMembership.all.select(m | m.service.isDefined())) {
    var key = membershipItem.service.`id`;
    var memberships = index.get(key);
    if (memberships.isUndefined()) {
      memberships = Sequence{};
      index.put(key, memberships);
    }
    memberships.add(membershipItem);
  }
  return index;
}

@cached
/** Returns whether the receiver has membership for. */
operation PIM!ServerlessService hasMembershipFor(element) : Boolean {
  return self.serviceMemberships().exists(membershipItem | membershipItem.element = element);
}

@cached
/** Computes changes state or emits events. */
operation PIM!Function changesStateOrEmitsEvents() : Boolean {
  return self.writesState.isTrue()
    or self.publishesEvents.isTrue()
    or self.writes.notEmpty()
    or self.publishes.notEmpty();
}

@cached
/** Returns whether the receiver needs idempotency policy. */
operation PIM!Function needsIdempotencyPolicy() : Boolean {
  return self.requiresIdempotency.isTrue()
    or self.changesStateOrEmitsEvents()
    or self.triggers.exists(triggerItem |
      triggerItem.resilience.isDefined() and
      triggerItem.resilience.retry.isDefined() and
      triggerItem.resilience.retry.maxAttempts.isDefined() and
      triggerItem.resilience.retry.maxAttempts > 1)
    or idempotentConsumerFunctionIds().includes(self.`id`);
}

@cached
/** Computes idempotent consumer function ids. */
operation idempotentConsumerFunctionIds() : Set {
  var ids : Set = Set{};
  for (channelItem in PIM!EventChannel.all.select(channelItem |
      channelItem.deliverySemantics.enumIn(Sequence{"EFFECTIVELY_ONCE_WITH_IDEMPOTENCY", "EXACTLY_ONCE_REQUIRED"}))) {
    for (functionItem in channelItem.consumers) {
      ids.add(functionItem.`id`);
    }
  }
  return ids;
}

/** Returns whether the receiver has field named. */
operation PIM!Schema hasFieldNamed(fieldName : String) : Boolean {
  return fieldName.hasText() and self.fields.exists(fieldItem | fieldItem.name = fieldName);
}

@cached
/** Returns whether the receiver has classified sensitive fields. */
operation PIM!Schema hasClassifiedSensitiveFields() : Boolean {
  return self.fields.forAll(fieldItem |
    not (fieldItem.personalData.isTrue() or fieldItem.sensitiveData.isTrue() or fieldItem.secretValue.isTrue())
    or fieldItem.classification.hasText());
}

@cached
/** Computes carries personal data. */
operation PIM!EventType carriesPersonalData() : Boolean {
  return self.containsPersonalData.isTrue()
    or self.schema.fields.exists(fieldItem | fieldItem.personalData.isTrue());
}

@cached
/** Computes carries personal data. */
operation PIM!EventChannel carriesPersonalData() : Boolean {
  return self.eventTypes.exists(eventItem | eventItem.carriesPersonalData());
}

@cached
/** Computes outgoing transitions. */
operation PIM!WorkflowStep outgoingTransitions() : Collection {
  var transitions = workflowTransitionsBySourceId().get(self.`id`);
  if (transitions.isUndefined()) {
    return Sequence{};
  }
  return transitions;
}

@cached
/** Computes incoming transitions. */
operation PIM!WorkflowStep incomingTransitions() : Collection {
  var transitions = workflowTransitionsByTargetId().get(self.`id`);
  if (transitions.isUndefined()) {
    return Sequence{};
  }
  return transitions;
}

@cached
/** Computes workflow transitions by source id. */
operation workflowTransitionsBySourceId() : Map {
  var index = new Map;
  for (transitionItem in PIM!WorkflowTransition.all.select(t | t.source.isDefined())) {
    addWorkflowTransition(index, transitionItem.source.`id`, transitionItem);
  }
  return index;
}

@cached
/** Computes workflow transitions by target id. */
operation workflowTransitionsByTargetId() : Map {
  var index = new Map;
  for (transitionItem in PIM!WorkflowTransition.all.select(t | t.target.isDefined())) {
    addWorkflowTransition(index, transitionItem.target.`id`, transitionItem);
  }
  return index;
}

/** Adds or records add workflow transition. */
operation addWorkflowTransition(index : Map, key : String, transitionItem) {
  var transitions = index.get(key);
  if (transitions.isUndefined()) {
    transitions = Sequence{};
    index.put(key, transitions);
  }
  transitions.add(transitionItem);
}

@cached
/** Computes action count. */
operation PIM!TaskStep actionCount() : Integer {
  var total = 0;
  if (self.invokesFunction.isDefined()) { total = total + 1; }
  if (self.invokesAdapter.isDefined()) { total = total + 1; }
  if (self.nestedWorkflow.isDefined()) { total = total + 1; }
  return total;
}

@cached
/** Computes start steps. */
operation PIM!Workflow startSteps() : Collection {
  return self.steps.select(stepItem | stepItem.isKindOf(PIM!StartStep));
}

@cached
/** Computes end steps. */
operation PIM!Workflow endSteps() : Collection {
  return self.steps.select(stepItem | stepItem.isKindOf(PIM!SuccessEndStep) or stepItem.isKindOf(PIM!FailureEndStep));
}

@cached
/** Computes data store contains sensitive data. */
operation PIM!DataStore dataStoreContainsSensitiveData() : Boolean {
  return self.containsPersonalData.isTrue()
    or self.ownedDataModels.exists(modelItem |
      modelItem.storageFields.exists(fieldItem | fieldItem.personalData.isTrue() or fieldItem.sensitiveData.isTrue())
    );
}

@cached
/** Computes object store contains sensitive data. */
operation PIM!ObjectStore objectStoreContainsSensitiveData() : Boolean {
  return self.containsPersonalData.isTrue();
}

@cached
/** Computes storage contains sensitive data. */
operation PIM!StorageElement storageContainsSensitiveData() : Boolean {
  if (self.isKindOf(PIM!DataStore)) {
    return self.dataStoreContainsSensitiveData();
  }
  if (self.isKindOf(PIM!ObjectStore)) {
    return self.objectStoreContainsSensitiveData();
  }
  return self.containsPersonalData.isTrue();
}

@cached
/** Returns whether the receiver has query shape. */
operation PIM!AccessPattern hasQueryShape() : Boolean {
  return self.`operation`.hasText()
    or self.queryBy.hasText()
    or self.sortBy.hasText()
    or self.filterBy.hasText();
}

/** Computes route uniqueness key. */
operation PIM!ApiRoute routeUniquenessKey() : String {
  var apiId = "<no-api>";
  if (self.api.isDefined()) {
    apiId = self.api.`id`;
  }
  return apiId + "::" + self.method.asString() + "::" + self.pathTemplate;
}

@cached
/** Computes duplicate pim api route keys. */
operation duplicatePimApiRouteKeys() : Set {
  var seen : Set = Set{};
  var duplicates : Set = Set{};
  for (routeItem in PIM!ApiRoute.all) {
    var key = routeItem.routeUniquenessKey();
    if (seen.includes(key)) {
      duplicates.add(key);
    }
    else {
      seen.add(key);
    }
  }
  return duplicates;
}

/** Computes index support key. */
operation PIM!AccessPattern indexSupportKey() : String {
  var storeId = "<no-store>";
  if (self.dataStore.isDefined()) {
    storeId = self.dataStore.`id`;
  }
  return storeId + "::" + self.`id`;
}

@cached
/** Computes indexed access pattern keys. */
operation indexedAccessPatternKeys() : Set {
  var keys : Set = Set{};
  for (indexItem in PIM!IndexCandidate.all.select(i | i.dataStore.isDefined())) {
    for (pattern in indexItem.supportsAccessPatterns) {
      keys.add(indexItem.dataStore.`id` + "::" + pattern.`id`);
    }
  }
  return keys;
}

@cached
/** Computes event channel producer keys. */
operation eventChannelProducerKeys() : Set {
  var keys : Set = Set{};
  for (channelItem in PIM!EventChannel.all) {
    for (eventItem in channelItem.eventTypes) {
      for (producerItem in channelItem.producers) {
        keys.add(eventItem.`id` + "::" + producerItem.`id`);
      }
      for (producerItem in channelItem.externalProducers) {
        keys.add(eventItem.`id` + "::" + producerItem.`id`);
      }
    }
  }
  return keys;
}

@cached
/** Computes event channel consumer keys. */
operation eventChannelConsumerKeys() : Set {
  var keys : Set = Set{};
  for (channelItem in PIM!EventChannel.all) {
    for (eventItem in channelItem.eventTypes) {
      for (consumerItem in channelItem.consumers) {
        keys.add(eventItem.`id` + "::" + consumerItem.`id`);
      }
      for (consumerItem in channelItem.externalConsumers) {
        keys.add(eventItem.`id` + "::" + consumerItem.`id`);
      }
      for (consumerItem in channelItem.workflowConsumers) {
        keys.add(eventItem.`id` + "::" + consumerItem.`id`);
      }
    }
  }
  return keys;
}

/** Computes participant key. */
operation PIM!EventType participantKey(participant : Any) : String {
  return self.`id` + "::" + participant.`id`;
}

@cached
/** Computes event flow workflow consumer keys. */
operation eventFlowWorkflowConsumerKeys() : Set {
  var keys : Set = Set{};
  for (flowItem in PIM!EventFlow.all.select(f |
      f.channel.isDefined() and f.target.isDefined() and f.eventType.isDefined())) {
    if (flowItem.channel.eventTypes.includes(flowItem.eventType)) {
      keys.add(flowItem.channel.`id` + "::" + flowItem.target.`id`);
    }
  }
  return keys;
}

/** Computes workflow consumer key. */
operation PIM!EventChannel workflowConsumerKey(workflowItem : Any) : String {
  return self.`id` + "::" + workflowItem.`id`;
}

@cached
/** Returns root policy ids. */
operation rootPolicyIds() : Set {
  var ids : Set = Set{};
  for (root in PIM!PIMModel.all) {
    for (policyItem in root.policies) {
      ids.add(policyItem.`id`);
    }
  }
  return ids;
}

@cached
/** Computes package manager fits language. */
operation PIM!ImplementationProfile packageManagerFitsLanguage() : Boolean {
  if (self.primaryLanguage.enumIn(Sequence{"TYPESCRIPT", "JAVASCRIPT"})) {
    return self.packageManager.enumIn(Sequence{"NPM", "PNPM", "YARN"});
  }
  if (self.primaryLanguage.enumIs("PYTHON")) {
    return self.packageManager.enumIn(Sequence{"PIP", "POETRY"});
  }
  if (self.primaryLanguage.enumIs("JAVA")) {
    return self.packageManager.enumIn(Sequence{"MAVEN", "GRADLE"});
  }
  if (self.primaryLanguage.enumIs("CSHARP")) {
    return self.packageManager.enumIs("DOTNET");
  }
  if (self.primaryLanguage.enumIs("GO")) {
    return self.packageManager.enumIs("GO_MOD");
  }
  if (self.primaryLanguage.enumIs("RUST")) {
    return self.packageManager.enumIs("CARGO");
  }
  return true;
}

