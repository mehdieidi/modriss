operation Any isPresent() : Boolean {
  return self.isDefined() and not self.asString().trim().isEmpty();
}

operation Any textOrEmpty() : String {
  if (self.isUndefined()) {
    return "";
  }
  return self.asString();
}

operation Any orElseText(fallbackText : String) : String {
  if (self.isPresent()) {
    return self.asString();
  }
  return fallbackText;
}

operation Any modelFeatureValue(featureNameText : String) : Any {
  return self.eGet(self.eClass().getEStructuralFeature(featureNameText));
}

operation firstText(primaryValue, fallbackValue) : String {
  if (primaryValue.isPresent()) {
    return primaryValue.asString();
  }
  if (fallbackValue.isPresent()) {
    return fallbackValue.asString();
  }
  return "";
}

operation String normalizedToken() : String {
  var resultText = self.orElseText("unnamed").trim()
    .replaceAll("[^A-Za-z0-9]+", "-")
    .replaceAll("^-+|-+$", "");
  if (resultText.trim().isEmpty()) {
    return "unnamed";
  }
  return resultText;
}

@cached
operation Any toSlug() : String {
  return self.textOrEmpty().normalizedToken().toLowerCase();
}

@cached
operation Any toSnake() : String {
  return self.toSlug().replace("-", "_");
}

@cached
operation Any toCfnLogicalId() : String {
  var tokenSeq = self.textOrEmpty().normalizedToken().split("-");
  var resultText = "";
  for (tokenText in tokenSeq) {
    if (tokenText.length() > 0) {
      resultText = resultText + tokenText.substring(0, 1).toUpperCase() + tokenText.substring(1);
    }
  }
  if (resultText.isEmpty()) {
    resultText = "GeneratedResource";
  }
  if (not "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(resultText.substring(0, 1))) {
    resultText = "R" + resultText;
  }
  return resultText;
}

@cached
operation Any toCamel() : String {
  var pascalText = self.toCfnLogicalId();
  return pascalText.substring(0, 1).toLowerCase() + pascalText.substring(1);
}

@cached
operation Any safeFileStem() : String {
  return self.toSlug();
}

@cached
operation KERNEL!TraceableElement stableKey() : String {
  if (self.traceId.isPresent()) {
    return self.traceId;
  }
  if (self.externalId.isPresent()) {
    return self.externalId;
  }
  if (self.sourceQualifiedName.isPresent()) {
    return self.sourceQualifiedName;
  }
  if (self.name.isPresent()) {
    return self.name;
  }
  if (self.id.isPresent()) {
    return self.id;
  }
  return self.eClass().getName() + "-" + self.hashCode().asString();
}

@cached
operation AWSPSMCORE!AwsResource stableKey() : String {
  if (self.traceId.isPresent()) {
    return self.traceId;
  }
  if (self.externalId.isPresent()) {
    return self.externalId;
  }
  if (self.sourceQualifiedName.isPresent()) {
    return self.sourceQualifiedName;
  }
  if (self.logicalId.isPresent()) {
    return self.logicalId;
  }
  if (self.name.isPresent()) {
    return self.name;
  }
  return self.eClass().getName() + "-" + self.hashCode().asString();
}

@cached
operation AWSPSMCORE!AwsResource cfnLogicalId() : String {
  if (self.logicalId.isPresent()) {
    return self.logicalId.toCfnLogicalId();
  }
  if (self.physicalName.isPresent()) {
    return self.physicalName.toCfnLogicalId();
  }
  return self.stableKey().toCfnLogicalId();
}

@cached
operation AWSPSMCOMPUTE!AwsLambdaFunction functionSlug() : String {
  return firstText(self.functionName, firstText(self.logicalId, self.name)).toSlug();
}

@cached
operation AWSPSMAPI!ApiGatewayApi apiSlug() : String {
