@cached
/** Computes stack template path. */
operation AWSPSMCORE!SamStack stackTemplatePath() : String {
  if (self.templatePath.isPresent()) {
    return self.templatePath;
  }
  return "template.yaml";
}

/** Computes display name. */
operation Any displayName() : String {
  if (self.isUndefined()) {
    return "Unnamed";
  }
  if (self.name.isPresent()) {
    return self.name;
  }
  if (self.eClass().getName().isPresent()) {
    return self.eClass().getName();
  }
  return self.asString();
}
