/** Provides reusable values operations. */
import "naming.eol";

/** Computes spaces. */
operation spaces(indentCount : Integer) : String {
  if (indentCount <= 0) {
    return "";
  }
  return " ".repeat(indentCount);
}

/** Renders json escape. */
operation Any jsonEscape() : String {
  if (self.isUndefined()) {
    return "";
  }
  return self.asString()
    .replaceAll("\\\\", "\\\\\\\\")
    .replaceAll("\"", "\\\\\"")
    .replaceAll("\r", "\\\\r")
    .replaceAll("\n", "\\\\n");
}

/** Renders json string. */
operation Any jsonString() : String {
  return "\"" + self.jsonEscape() + "\"";
}

/** Renders yaml scalar. */
operation Any yamlScalar() : String {
  if (self.isUndefined()) {
    return "''";
  }
  var text = self.asString();
  if (text = "true" or text = "false") {
    return text;
  }
  if (text.isInteger() or text.isReal()) {
    return text;
  }
  if (text.startsWith("!Ref ") or text.startsWith("!GetAtt ") or text.startsWith("!Sub ") or text.startsWith("!ImportValue ")) {
    return text;
  }
  if (text.startsWith("{") or text.startsWith("[") or text.startsWith("'{{resolve:")) {
    return text;
  }
  return "'" + text.replace("'", "''") + "'";
}

/** Renders yaml plain scalar. */
operation Any yamlPlainScalar() : String {
  if (self.isUndefined()) {
    return "''";
  }
  return self.asString().yamlScalar();
}

/** Renders yaml block. */
operation yamlBlock(nameText : String, contentText : String, indentCount : Integer) : String {
  var lineIndent = spaces(indentCount);
  var contentIndent = spaces(indentCount + 2);
  var outText = lineIndent + nameText + ": |\n";
  for (lineText in contentText.split("\n")) {
    outText = outText + contentIndent + lineText + "\n";
  }
  return outText;
}

/** Renders emit yaml scalar property. */
operation emitYamlScalarProperty(nameText : String, valueObj, indentCount : Integer) : String {
  if (valueObj.isUndefined() or valueObj.asString().trim().isEmpty()) {
    return "";
  }
  return spaces(indentCount) + nameText + ": " + valueObj.yamlScalar() + "\n";
}

/** Renders emit yaml boolean property. */
operation emitYamlBooleanProperty(nameText : String, valueObj, indentCount : Integer) : String {
  if (valueObj.isUndefined()) {
    return "";
  }
  return spaces(indentCount) + nameText + ": " + valueObj.asString().toLowerCase() + "\n";
}

/** Renders emit yaml integer property. */
operation emitYamlIntegerProperty(nameText : String, valueObj, indentCount : Integer) : String {
  if (valueObj.isUndefined()) {
    return "";
  }
  return spaces(indentCount) + nameText + ": " + valueObj.asString() + "\n";
}

/** Renders emit yaml string list property. */
operation emitYamlStringListProperty(nameText : String, valueSeq, indentCount : Integer) : String {
  if (valueSeq.isUndefined() or valueSeq.isEmpty()) {
    return "";
  }
  var outText = spaces(indentCount) + nameText + ":\n";
  for (itemText in valueSeq) {
    outText = outText + spaces(indentCount + 2) + "- " + itemText.yamlScalar() + "\n";
  }
  return outText;
}

/** Computes cfn policy name. */
operation Any cfnPolicyName() : String {
  var text = self.orElseText("").asString();
  if (text = "RETAIN") {
    return "Retain";
  }
  if (text = "RETAIN_EXCEPT_ON_CREATE") {
    return "RetainExceptOnCreate";
  }
  if (text = "SNAPSHOT") {
    return "Snapshot";
  }
  if (text = "DELETE") {
    return "Delete";
  }
  return text;
}

/** Computes lambda architecture text. */
operation Any lambdaArchitectureText() : String {
  var text = self.orElseText("").asString();
  if (text = "X86_64") {
    return "x86_64";
  }
  if (text = "ARM64") {
    return "arm64";
  }
  return text.toLowerCase();
}

/** Computes lambda tracing mode text. */
operation Any lambdaTracingModeText() : String {
  var text = self.orElseText("").asString();
  if (text = "ACTIVE") {
    return "Active";
  }
  if (text = "PASS_THROUGH") {
    return "PassThrough";
  }
  return "";
}

/** Maps model enum literals to the exact CloudWatch comparison operator spelling. */
operation Any cloudWatchComparisonOperatorText() : String {
  var operatorText = self.asString();
  if (operatorText = "GREATER_THAN_OR_EQUAL_TO_THRESHOLD") return "GreaterThanOrEqualToThreshold";
  if (operatorText = "GREATER_THAN_THRESHOLD") return "GreaterThanThreshold";
  if (operatorText = "GREATER_THAN_UPPER_THRESHOLD") return "GreaterThanUpperThreshold";
  if (operatorText = "LESS_THAN_LOWER_OR_GREATER_THAN_UPPER_THRESHOLD") return "LessThanLowerOrGreaterThanUpperThreshold";
  if (operatorText = "LESS_THAN_LOWER_THRESHOLD") return "LessThanLowerThreshold";
  if (operatorText = "LESS_THAN_OR_EQUAL_TO_THRESHOLD") return "LessThanOrEqualToThreshold";
  if (operatorText = "LESS_THAN_THRESHOLD") return "LessThanThreshold";
  return operatorText;
}

/** Computes iam effect text. */
operation Any iamEffectText() : String {
  var text = self.orElseText("ALLOW").asString();
  if (text = "ALLOW") {
    return "Allow";
  }
  if (text = "DENY") {
    return "Deny";
  }
  return text;
}

/** Computes http method text. */
operation Any httpMethodText() : String {
  return self.orElseText("GET").asString().toLowerCase();
}

/** Computes sns protocol text. */
operation Any snsProtocolText() : String {
  return self.orElseText("").asString().toLowerCase();
}

/** Computes ref for resource. */
operation refForResource(resObj) : String {
  if (resObj.isUndefined()) {
    return "";
  }
  if (resObj.eClass().getName() = "SnsTopic") {
    return arnForResource(resObj);
  }
  if (resObj.eClass().getName() = "EventBridgeBus") {
    return firstText(resObj.busName, resObj.physicalName).yamlScalar();
  }
  return "!Ref " + resObj.cfnLogicalId();
}

/** Computes arn for resource. */
operation arnForResource(resObj) : String {
  if (resObj.isUndefined()) {
    return "";
  }
  var classText = resObj.eClass().getName();
  var physicalNameText = resObj.physicalName;
  if (classText = "AwsLambdaFunction") {
    physicalNameText = firstText(resObj.functionName, physicalNameText);
    if (physicalNameText.isPresent()) return "!Sub 'arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:" + physicalNameText + "'";
  }
  if (classText = "SqsQueue") {
    physicalNameText = firstText(resObj.queueName, physicalNameText);
    if (physicalNameText.isPresent()) return "!Sub 'arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:" + physicalNameText + "'";
  }
  if (classText = "SnsTopic") {
    physicalNameText = firstText(resObj.topicName, physicalNameText);
    if (physicalNameText.isPresent()) return "!Sub 'arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:" + physicalNameText + "'";
  }
  if (classText = "EventBridgeBus") {
    physicalNameText = firstText(resObj.busName, physicalNameText);
    if (physicalNameText.isPresent()) return "!Sub 'arn:${AWS::Partition}:events:${AWS::Region}:${AWS::AccountId}:event-bus/" + physicalNameText + "'";
  }
  if (classText = "EventBridgeRule") {
    physicalNameText = firstText(resObj.ruleName, physicalNameText);
    if (physicalNameText.isPresent() and resObj.bus.isDefined()) {
      return "!Sub 'arn:${AWS::Partition}:events:${AWS::Region}:${AWS::AccountId}:rule/" + firstText(resObj.bus.busName, resObj.bus.physicalName) + "/" + physicalNameText + "'";
    }
    if (physicalNameText.isPresent()) return "!Sub 'arn:${AWS::Partition}:events:${AWS::Region}:${AWS::AccountId}:rule/" + physicalNameText + "'";
  }
  if (classText = "DynamoDbTable") {
    physicalNameText = firstText(resObj.tableName, physicalNameText);
    if (physicalNameText.isPresent()) return "!Sub 'arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/" + physicalNameText + "'";
  }
  if (classText = "IamRole") {
    physicalNameText = firstText(resObj.roleName, physicalNameText);
    if (physicalNameText.isPresent()) return "!Sub 'arn:${AWS::Partition}:iam::${AWS::AccountId}:role" + resObj.path.orElseText("/") + physicalNameText + "'";
  }
  if (classText = "StepFunctionStateMachine") {
    physicalNameText = firstText(resObj.stateMachineName, physicalNameText);
    if (physicalNameText.isPresent()) return "!Sub 'arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:" + physicalNameText + "'";
  }
  if (classText = "SqsQueue" or classText = "DynamoDbTable" or classText = "AwsLambdaFunction" or
      classText = "KmsKey" or classText = "CloudWatchLogGroup" or
      classText = "StepFunctionStateMachine") {
    return "!GetAtt " + resObj.cfnLogicalId() + ".Arn";
  }
  return "!GetAtt " + resObj.cfnLogicalId() + ".Arn";
}

/** Replaces a modeled GetAtt-Arn expression with its deployable stable ARN form. */
operation Any normalizeCfnArnReference() : String {
  var expressionText = self.textOrEmpty();
  for (resourceObj in AWSPSMCORE!AwsResource.all) {
    if (expressionText = "!GetAtt " + resourceObj.cfnLogicalId() + ".Arn") {
      return arnForResource(resourceObj);
    }
  }
  return expressionText;
}

@cached
/** Computes cfn inline yaml. */
operation AWSPSMCORE!ValueExpression cfnInlineYaml() : String {
  var kindText = self.sourceKind.asString();
  if (kindText = "PLAINTEXT") {
    return self.literal.yamlScalar();
  }
  if (kindText = "CLOUDFORMATION_REF") {
    if (self.parameter.isDefined()) {
      return "!Ref " + self.parameter.parameterName;
    }
    if (self.resource.isDefined()) {
      return "!Ref " + self.resource.cfnLogicalId();
    }
    return "!Ref " + self.expression.orElseText(self.literal);
  }
  if (kindText = "CLOUDFORMATION_GETATT" or kindText = "RESOURCE_ATTRIBUTE") {
    if (self.resource.isDefined()) {
      return "!GetAtt " + self.resource.cfnLogicalId() + "." + self.attributeName.orElseText("Arn");
    }
    return "!GetAtt " + self.expression.orElseText(self.literal);
  }
  if (kindText = "CLOUDFORMATION_SUB") {
    return "!Sub " + self.expression.orElseText(self.literal).yamlScalar();
  }
  if (kindText = "IMPORT_VALUE") {
    return "!ImportValue " + self.expression.orElseText(self.literal).yamlScalar();
  }
  if (kindText = "SSM_PARAMETER_REFERENCE") {
    return "'{{resolve:ssm:" + self.expression.orElseText(self.literal) + "}}'";
  }
  if (kindText = "SSM_SECURE_REFERENCE") {
    return "'{{resolve:ssm-secure:" + self.expression.orElseText(self.literal) + "}}'";
  }
  if (kindText = "SECRETS_MANAGER_REFERENCE") {
    return "'{{resolve:secretsmanager:" + self.expression.orElseText(self.literal) + "}}'";
  }
  if (kindText = "DYNAMIC_REFERENCE") {
    return "'{{resolve:" + self.expression.orElseText(self.literal) + "}}'";
  }
  return firstText(self.expression, self.literal).yamlScalar();
}

/** Computes cfn value yaml. */
operation AWSPSMCORE!ValueExpression cfnValueYaml(indentCount : Integer) : String {
  var kindText = self.sourceKind.asString();
  if (kindText = "LIST") {
    var outText = "";
    for (itemVal in self.items) {
      if (itemVal.sourceKind.asString() = "LIST" or itemVal.sourceKind.asString() = "MAP") {
        outText = outText + spaces(indentCount) + "-\n" + itemVal.cfnValueYaml(indentCount + 2);
      }
      else {
        outText = outText + spaces(indentCount) + "- " + itemVal.cfnInlineYaml() + "\n";
      }
    }
    return outText;
  }
  if (kindText = "MAP") {
    var outText = "";
    for (entryVal in self.entries.sortBy(entryVal | entryVal.key)) {
      var valObj = entryVal.value;
      if (valObj.sourceKind.asString() = "LIST" or valObj.sourceKind.asString() = "MAP") {
        outText = outText + spaces(indentCount) + entryVal.key + ":\n" + valObj.cfnValueYaml(indentCount + 2);
      }
      else {
        outText = outText + spaces(indentCount) + entryVal.key + ": " + valObj.cfnInlineYaml() + "\n";
      }
    }
    return outText;
  }
  return self.cfnInlineYaml();
}

/** Renders emit cfn value property. */
operation AWSPSMCORE!ValueExpression emitCfnValueProperty(nameText : String, indentCount : Integer) : String {
  var kindText = self.sourceKind.asString();
  if (kindText = "LIST" or kindText = "MAP") {
    return spaces(indentCount) + nameText + ":\n" + self.cfnValueYaml(indentCount + 2);
  }
  return spaces(indentCount) + nameText + ": " + self.cfnInlineYaml() + "\n";
}

/** Computes event bridge auth yaml. */
operation AWSPSMEVENTS!EventBridgeApiKeyAuthParameters eventBridgeAuthYaml(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "ApiKeyAuthParameters:\n";
  outText = outText + emitYamlScalarProperty("ApiKeyName", self.apiKeyName, indentCount + 2);
  outText = outText + spaces(indentCount + 2) + "ApiKeyValue: " + self.apiKeyValue.cfnInlineYaml() + "\n";
  return outText;
}

/** Computes event bridge auth yaml. */
operation AWSPSMEVENTS!EventBridgeBasicAuthParameters eventBridgeAuthYaml(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "BasicAuthParameters:\n";
  outText = outText + spaces(indentCount + 2) + "Username: " + self.username.cfnInlineYaml() + "\n";
  outText = outText + spaces(indentCount + 2) + "Password: " + self.password.cfnInlineYaml() + "\n";
  return outText;
}

/** Computes event bridge auth yaml. */
operation AWSPSMEVENTS!EventBridgeOAuthParameters eventBridgeAuthYaml(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "OAuthParameters:\n";
  outText = outText + emitYamlScalarProperty("AuthorizationEndpoint", self.authorizationEndpoint, indentCount + 2);
  outText = outText + emitYamlScalarProperty("HttpMethod", self.httpMethod, indentCount + 2);
  outText = outText + spaces(indentCount + 2) + "ClientParameters:\n";
  outText = outText + spaces(indentCount + 4) + "ClientID: " + self.clientId.cfnInlineYaml() + "\n";
  outText = outText + spaces(indentCount + 4) + "ClientSecret: " + self.clientSecret.cfnInlineYaml() + "\n";
  return outText;
}

/** Renders emit native property yaml. */
operation AWSPSMCORE!NativeProperty emitNativePropertyYaml(indentCount : Integer) : String {
  if (self.value.isUndefined()) {
    return "";
  }
  if (self.format.asString() = "JSON" or self.format.asString() = "YAML" or self.format.asString() = "IAM_POLICY_JSON" or self.format.asString() = "ASL_JSON") {
    var rawText = firstText(self.value.expression, self.value.literal);
    if (rawText.isPresent()) {
      return yamlBlock(self.propertyName, rawText, indentCount);
    }
  }
  return self.value.emitCfnValueProperty(self.propertyName, indentCount);
}

/** Renders emit native properties yaml. */
operation Collection emitNativePropertiesYaml(indentCount : Integer) : String {
  var outText = "";
  for (propObj in self.sortBy(propObj | propObj.propertyName)) {
    outText = outText + propObj.emitNativePropertyYaml(indentCount);
  }
  return outText;
}

/** Renders emit tags yaml. */
operation Collection emitTagsYaml(indentCount : Integer) : String {
  if (self.isEmpty()) {
    return "";
  }
  var outText = spaces(indentCount) + "Tags:\n";
  for (tagObj in self.sortBy(tagObj | tagObj.key)) {
    outText = outText + spaces(indentCount + 2) + "- Key: " + tagObj.key.yamlScalar() + "\n";
    outText = outText + spaces(indentCount + 4) + "Value: " + tagObj.value.orElseText("").yamlScalar() + "\n";
  }
  return outText;
}

/** Renders JSON or YAML content as a structured YAML property instead of a block scalar string. */
operation structuredYamlProperty(nameText : String, contentText : String, indentCount : Integer) : String {
  var lineIndent = spaces(indentCount);
  var contentIndent = spaces(indentCount + 2);
  var outText = lineIndent + nameText + ":\n";
  for (lineText in contentText.split("\n")) {
    outText = outText + contentIndent + lineText + "\n";
  }
  return outText;
}

/** Renders the string-to-string tag map required by AWS SAM resources. */
operation Collection emitSamTagsYaml(indentCount : Integer) : String {
  return self.emitTagMapYaml("Tags", indentCount);
}

/** Renders a string-to-string tag map under the requested CloudFormation property name. */
operation Collection emitTagMapYaml(nameText : String, indentCount : Integer) : String {
  if (self.isEmpty()) {
    return "";
  }
  var outText = spaces(indentCount) + nameText + ":\n";
  for (tagObj in self.sortBy(tagObj | tagObj.key)) {
    outText = outText + spaces(indentCount + 2) + tagObj.key + ": " + tagObj.value.orElseText("").yamlScalar() + "\n";
  }
  return outText;
}

/** Renders emit cors yaml. */
operation AWSPSMCORE!CorsConfiguration emitCorsYaml(indentCount : Integer) : String {
  var outText = "";
  outText = outText + emitYamlStringListProperty("AllowOrigins", self.allowOrigins, indentCount);
  outText = outText + emitYamlStringListProperty("AllowMethods", self.allowMethods, indentCount);
  outText = outText + emitYamlStringListProperty("AllowHeaders", self.allowHeaders, indentCount);
  outText = outText + emitYamlStringListProperty("ExposeHeaders", self.exposeHeaders, indentCount);
  outText = outText + emitYamlIntegerProperty("MaxAge", self.maxAgeSeconds, indentCount);
  outText = outText + emitYamlBooleanProperty("AllowCredentials", self.allowCredentials, indentCount);
  return outText;
}
