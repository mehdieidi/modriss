/** Provides reusable validation operations. */
import "naming.eol";
import "trace.eol";

/** Adds or records collect blocking issues. */
operation AWSPSM!AwsPsmModel collectBlockingIssues(profileMap : Map) : Sequence {
  var issueSeq = new Sequence;

  if (self.stages.isEmpty()) {
    issueSeq.add(self.issueTuple("PSM_ROOT_NO_STAGES", "BLOCKER", "Root model has no AwsStage instances.", self, true));
  }
  if (self.stacks.isEmpty()) {
    issueSeq.add(self.issueTuple("PSM_ROOT_NO_STACKS", "BLOCKER", "Root model has no SamStack instances.", self, true));
  }
  if (self.readiness.isDefined()) {
    for (decisionObj in self.readiness.manualDecisions) {
      issueSeq.add(self.issueTuple(
        decisionObj.name.orElseText("PSM_MANUAL_DECISION"),
        decisionObj.severity.asString(),
        decisionObj.question,
        decisionObj,
        decisionObj.blocking));
    }
  }

  for (stackObj in self.stacks) {
    if (stackObj.resources.isEmpty()) {
      issueSeq.add(self.issueTuple("PSM_STACK_EMPTY", "BLOCKER", "Stack has no resources: " + stackObj.stackName.orElseText(stackObj.stableKey()), stackObj, true));
    }
  }

  for (resObj in self.allModeledResources()) {
    if (not resObj.logicalId.isPresent() and not resObj.physicalName.isPresent() and not resObj.name.isPresent() and not resObj.traceId.isPresent()) {
      issueSeq.add(self.issueTuple("AWS_RESOURCE_NO_STABLE_ID", "BLOCKER", "Resource cannot be deterministically named: " + resObj.eClass().getName(), resObj, true));
    }
    for (referenceObj in resObj.eClass().getEAllReferences().select(referenceObj | not referenceObj.isContainment())) {
      var referencedValue = resObj.eGet(referenceObj);
      if (referenceObj.isMany()) {
        for (targetObj in referencedValue.select(targetObj | targetObj.isKindOf(AWSPSMCORE!AwsResource) and targetObj.stack.isDefined() and targetObj.stack <> resObj.stack and not targetObj.supportsStableCrossStackReference())) {
          issueSeq.add(self.issueTuple("CROSS_STACK_RESOURCE_REFERENCE", "BLOCKER", "Resource reference crosses stack boundary without an export/import contract: " + resObj.stableKey() + "." + referenceObj.getName() + " -> " + targetObj.stableKey(), resObj, true));
        }
      }
      else if (referencedValue.isDefined() and referencedValue.isKindOf(AWSPSMCORE!AwsResource) and referencedValue.stack.isDefined() and referencedValue.stack <> resObj.stack and not referencedValue.supportsStableCrossStackReference()) {
        issueSeq.add(self.issueTuple("CROSS_STACK_RESOURCE_REFERENCE", "BLOCKER", "Resource reference crosses stack boundary without an export/import contract: " + resObj.stableKey() + "." + referenceObj.getName() + " -> " + referencedValue.stableKey(), resObj, true));
      }
    }
  }

  for (awsFn in AWSPSMCOMPUTE!AwsLambdaFunction.all.sortBy(awsFn | awsFn.cfnLogicalId())) {
    if (awsFn.role.isUndefined()) {
      issueSeq.add(self.issueTuple("LAMBDA_ROLE_MISSING", "BLOCKER", "Lambda function has no IAM role: " + awsFn.stableKey(), awsFn, true));
    }
    if (awsFn.logGroup.isUndefined()) {
      issueSeq.add(self.issueTuple("LAMBDA_LOG_GROUP_MISSING", "ERROR", "Lambda function has no CloudWatch log group: " + awsFn.stableKey(), awsFn, profileMap.get("productionMode") = true));
    }
    if (awsFn.code.isUndefined()) {
      issueSeq.add(self.issueTuple("LAMBDA_CODE_MISSING", "BLOCKER", "Lambda function has no code configuration: " + awsFn.stableKey(), awsFn, true));
    }
    if (profileMap.get("productionMode") = true and awsFn.codeSigningDecision.asString() = "UNDECIDED") {
      issueSeq.add(self.issueTuple("LAMBDA_CODE_SIGNING_UNDECIDED", "WARNING", "Production Lambda code signing decision is undecided: " + awsFn.stableKey(), awsFn, false));
    }
    if (profileMap.get("primaryLanguage") = "GO" and awsFn.snapStartApplyOn.isDefined() and awsFn.snapStartApplyOn.asString() <> "NONE") {
      issueSeq.add(self.issueTuple("LAMBDA_SNAPSTART_UNSUPPORTED_FOR_GO", "BLOCKER", "Lambda SnapStart is not supported by the generated Go runtime and has been omitted: " + awsFn.stableKey(), awsFn, true));
    }
  }

  for (routeObj in AWSPSMAPI!ApiGatewayRoute.all.sortBy(routeObj | routeObj.cfnLogicalId())) {
    if (routeObj.integration.isUndefined()) {
      issueSeq.add(self.issueTuple("API_ROUTE_INTEGRATION_MISSING", "BLOCKER", "API route has no integration: " + routeObj.stableKey(), routeObj, true));
    }
    if (routeObj.authorizationType.asString() <> "NONE" and routeObj.authorizer.isUndefined()) {
      issueSeq.add(self.issueTuple("API_ROUTE_AUTHORIZER_MISSING", "BLOCKER", "Protected API route has no authorizer: " + routeObj.stableKey(), routeObj, profileMap.get("productionMode") = true));
    }
    for (statusCodeText in routeObj.responseModels.collect(responseObj | responseObj.statusCode).asSet()) {
      if (routeObj.responseModels.select(responseObj | responseObj.statusCode = statusCodeText).size() > 1) {
        issueSeq.add(self.issueTuple("API_RESPONSE_STATUS_DUPLICATE", "BLOCKER", "Route defines more than one response for HTTP status " + statusCodeText + ": " + routeObj.stableKey(), routeObj, true));
      }
    }
  }

  for (ruleObj in AWSPSMEVENTS!EventBridgeRule.all.sortBy(ruleObj | ruleObj.cfnLogicalId())) {
    if (ruleObj.eventPattern.isUndefined() and not ruleObj.eventPatternJson.isPresent() and not ruleObj.scheduleExpression.isPresent()) {
      issueSeq.add(self.issueTuple("EVENTBRIDGE_RULE_TRIGGER_MISSING", "BLOCKER", "EventBridge rule has neither event pattern nor schedule: " + ruleObj.stableKey(), ruleObj, profileMap.get("productionMode") = true));
    }
    for (targetObj in ruleObj.targets.select(targetObj | targetObj.targetResource.isDefined() and targetObj.targetResource.isKindOf(AWSPSMCORE!AwsNativeResource))) {
      issueSeq.add(self.issueTuple("EVENTBRIDGE_TARGET_UNDEPLOYABLE", "BLOCKER", "EventBridge target is metadata-only and cannot be deployed as an AWS target: " + targetObj.stableKey(), targetObj, true));
    }
  }

  for (scheduleObj in AWSPSMEVENTS!EventBridgeSchedule.all.sortBy(scheduleObj | scheduleObj.cfnLogicalId())) {
    if (scheduleObj.target.isUndefined() or scheduleObj.target.targetResource.isUndefined()) {
      issueSeq.add(self.issueTuple("EVENTBRIDGE_SCHEDULE_TARGET_MISSING", "BLOCKER", "EventBridge Scheduler schedule has no deployable target resource: " + scheduleObj.stableKey(), scheduleObj, true));
    }
    if (not scheduleObj.scheduleExpression.startsWith("at(") and not scheduleObj.scheduleExpression.startsWith("rate(") and not scheduleObj.scheduleExpression.startsWith("cron(")) {
      issueSeq.add(self.issueTuple("EVENTBRIDGE_SCHEDULE_EXPRESSION_INVALID", "BLOCKER", "EventBridge Scheduler expression must use at(...), rate(...), or cron(...): " + scheduleObj.stableKey(), scheduleObj, true));
    }
  }

  for (stateMachineObj in AWSPSMWORKFLOW!StepFunctionStateMachine.all.sortBy(stateMachineObj | stateMachineObj.cfnLogicalId())) {
    if (stateMachineObj.role.isUndefined()) {
      issueSeq.add(self.issueTuple("STATE_MACHINE_ROLE_MISSING", "BLOCKER", "State machine has no IAM role: " + stateMachineObj.stableKey(), stateMachineObj, true));
    }
    if (stateMachineObj.aslDocument.isUndefined() and not stateMachineObj.definitionUri.isPresent() and not stateMachineObj.definitionString.isPresent()) {
      issueSeq.add(self.issueTuple("STATE_MACHINE_ASL_MISSING", "BLOCKER", "State machine has no ASL document or definition: " + stateMachineObj.stableKey(), stateMachineObj, profileMap.get("productionMode") = true));
    }
    if (stateMachineObj.aslDocument.isDefined() and stateMachineObj.aslDocument.states.none(stateObj | stateObj.stateName = stateMachineObj.aslDocument.startAt)) {
      issueSeq.add(self.issueTuple("STATE_MACHINE_START_AT_INVALID", "BLOCKER", "ASL StartAt does not reference a modeled state: " + stateMachineObj.stableKey(), stateMachineObj, true));
    }
    if (stateMachineObj.aslDocument.isDefined()) {
      for (stateObj in stateMachineObj.aslDocument.states) {
        var stateTypeText = stateObj.type.asString();
        if (stateTypeText = "CHOICE" and stateObj.choices.isEmpty()) {
          issueSeq.add(self.issueTuple("ASL_CHOICE_RULES_MISSING", "BLOCKER", "Choice state has no modeled choices: " + stateObj.stableKey(), stateObj, true));
        }
        if (stateTypeText = "PARALLEL" and stateObj.branches.isEmpty()) {
          issueSeq.add(self.issueTuple("ASL_PARALLEL_BRANCHES_MISSING", "BLOCKER", "Parallel state has no modeled branches: " + stateObj.stableKey(), stateObj, true));
        }
        if (stateTypeText = "MAP" and (stateObj.mapConfig.isUndefined() or stateObj.mapConfig.itemProcessor.isUndefined())) {
          issueSeq.add(self.issueTuple("ASL_MAP_PROCESSOR_MISSING", "BLOCKER", "Map state has no modeled item processor: " + stateObj.stableKey(), stateObj, true));
        }
      }
    }
  }

  for (tableObj in AWSPSMSTORAGE!DynamoDbTable.all.sortBy(tableObj | tableObj.cfnLogicalId())) {
    if (tableObj.keySchema.isEmpty()) {
      issueSeq.add(self.issueTuple("DDB_KEY_SCHEMA_MISSING", "BLOCKER", "DynamoDB table has no key schema: " + tableObj.stableKey(), tableObj, true));
    }
    if (profileMap.get("productionMode") = true and tableObj.pointInTimeRecoveryEnabled.isDefined() and not tableObj.pointInTimeRecoveryEnabled) {
      if (tableObj.backupPolicy.isUndefined() or tableObj.backupPolicy.pointInTimeRecoveryDecision.asString() <> "NOT_REQUIRED" or not tableObj.backupPolicy.backupRationale.isPresent()) {
        issueSeq.add(self.issueTuple("DDB_PITR_DISABLED_WITHOUT_RATIONALE", "ERROR", "Production DynamoDB table lacks PITR rationale: " + tableObj.stableKey(), tableObj, true));
      }
    }
  }

  for (bucketObj in AWSPSMSTORAGE!S3Bucket.all.sortBy(bucketObj | bucketObj.cfnLogicalId())) {
    if (profileMap.get("productionMode") = true and bucketObj.encryption.isUndefined()) {
      issueSeq.add(self.issueTuple("S3_ENCRYPTION_MISSING", "BLOCKER", "Production S3 bucket lacks encryption: " + bucketObj.stableKey(), bucketObj, true));
    }
    if (profileMap.get("productionMode") = true and bucketObj.publicAccessMode.asString() = "DISABLED_NOT_RECOMMENDED") {
      issueSeq.add(self.issueTuple("S3_PUBLIC_ACCESS_PROD", "BLOCKER", "Production S3 bucket has public access disabled-not-recommended mode: " + bucketObj.stableKey(), bucketObj, true));
    }
  }

  for (stmtObj in AWSPSMSECURITY!IamStatement.all) {
    if ((stmtObj.wildcardAction = true or stmtObj.actions.includes("*") or stmtObj.wildcardResource = true or stmtObj.resources.includes("*")) and not stmtObj.wildcardJustification.isPresent()) {
      issueSeq.add(self.issueTuple("IAM_WILDCARD_UNJUSTIFIED", "BLOCKER", "IAM wildcard lacks justification: " + stmtObj.stableKey(), stmtObj, profileMap.get("productionMode") = true));
    }
    if (stmtObj.sid.isPresent() and not stmtObj.sid.matches("^[A-Za-z0-9]+$")) {
      issueSeq.add(self.issueTuple("IAM_STATEMENT_SID_INVALID", "BLOCKER", "IAM statement Sid must contain only letters and digits: " + stmtObj.sid, stmtObj, true));
    }
    for (actionText in stmtObj.actions.select(actionText | not actionText.validIamActionText())) {
      issueSeq.add(self.issueTuple("IAM_ACTION_INVALID", "BLOCKER", "IAM action must be '*' or an AWS service:operation value: " + actionText, stmtObj, true));
    }
    for (resourceText in stmtObj.resources.select(resourceText | not resourceText.validIamResourceText())) {
      issueSeq.add(self.issueTuple("IAM_RESOURCE_INVALID", "BLOCKER", "IAM resource must be '*', an ARN, or a CloudFormation intrinsic: " + resourceText, stmtObj, true));
    }
  }

  for (roleObj in AWSPSMSECURITY!IamRole.all.sortBy(roleObj | roleObj.cfnLogicalId())) {
    var roleNameText = firstText(roleObj.roleName, roleObj.physicalName);
    if (roleNameText.isPresent() and AWSPSMSECURITY!IamRole.all.select(otherRole | firstText(otherRole.roleName, otherRole.physicalName) = roleNameText).size() > 1) {
      issueSeq.add(self.issueTuple("IAM_ROLE_NAME_DUPLICATE", "BLOCKER", "IAM RoleName must be unique within an account: " + roleNameText, roleObj, true));
    }
  }

  for (documentObj in AWSPSMSECURITY!IamPolicyDocument.all) {
    for (sidText in documentObj.statements.select(stmtObj | stmtObj.sid.isPresent()).collect(stmtObj | stmtObj.sid).asSet()) {
      if (documentObj.statements.select(stmtObj | stmtObj.sid = sidText).size() > 1) {
        issueSeq.add(self.issueTuple("IAM_STATEMENT_SID_DUPLICATE", "BLOCKER", "IAM policy document contains duplicate Sid: " + sidText, documentObj, true));
      }
    }
  }

  for (policyObj in AWSPSMMESSAGING!SqsQueuePolicy.all) {
    issueSeq.addAll(self.missingResourcePolicyPrincipalIssues(policyObj.policyDocument, policyObj));
  }
  for (policyObj in AWSPSMMESSAGING!SnsTopicPolicy.all) {
    issueSeq.addAll(self.missingResourcePolicyPrincipalIssues(policyObj.policyDocument, policyObj));
  }
  for (policyObj in AWSPSMSTORAGE!S3BucketPolicy.all) {
    issueSeq.addAll(self.missingResourcePolicyPrincipalIssues(policyObj.policyDocument, policyObj));
  }
  for (policyObj in AWSPSMSECURITY!SecretsManagerResourcePolicy.all) {
    issueSeq.addAll(self.missingResourcePolicyPrincipalIssues(policyObj.resourcePolicy, policyObj));
  }
  for (tableObj in AWSPSMSTORAGE!DynamoDbTable.all) {
    issueSeq.addAll(self.missingResourcePolicyPrincipalIssues(tableObj.resourcePolicy, tableObj));
  }
  for (keyObj in AWSPSMSECURITY!KmsKey.all) {
    issueSeq.addAll(self.missingResourcePolicyPrincipalIssues(keyObj.keyPolicy, keyObj));
  }

  for (valueObj in AWSPSMCORE!ValueExpression.all) {
    if (valueObj.secret = true and valueObj.sourceKind.asString() = "PLAINTEXT" and valueObj.literal.isPresent()) {
      issueSeq.add(self.issueTuple("PLAINTEXT_SECRET_VALUE", "BLOCKER", "Secret ValueExpression would emit plaintext: " + valueObj.stableKey(), valueObj, true));
    }
  }

  for (stageObj in self.stages) {
    if (stageObj.environmentClass.asString() = "PROD" and not (stageObj.requiresManualApproval.isDefined() and stageObj.requiresManualApproval)) {
      issueSeq.add(self.issueTuple("PROD_STAGE_APPROVAL_MISSING", "BLOCKER", "Production stage requires manual approval: " + stageObj.stageName, stageObj, true));
    }
  }

  return issueSeq;
}

/** Returns whether the target has a deterministic physical name from which the renderer builds a stable ARN or name. */
operation AWSPSMCORE!AwsResource supportsStableCrossStackReference() : Boolean {
  return self.physicalName.isPresent() and Sequence{
    "AwsLambdaFunction", "SqsQueue", "SnsTopic", "EventBridgeBus", "EventBridgeRule",
    "DynamoDbTable", "IamRole", "StepFunctionStateMachine"
  }.includes(self.eClass().getName());
}

/** Returns whether text is a valid deployable IAM action expression. */
operation Any validIamActionText() : Boolean {
  return self.isPresent() and (self.asString() = "*" or self.asString().matches("^[A-Za-z0-9-]+:[A-Za-z0-9*]+$"));
}

/** Returns whether text is a valid deployable IAM resource expression. */
operation Any validIamResourceText() : Boolean {
  return self.isPresent() and (self.asString() = "*" or self.asString().startsWith("arn:") or self.asString().startsWith("!"));
}

/** Returns blocker diagnostics for statements in a resource policy that omit Principal. */
operation AWSPSM!AwsPsmModel missingResourcePolicyPrincipalIssues(documentObj, sourceObj) : Sequence {
  var issueSeq = new Sequence;
  if (documentObj.isUndefined()) {
    return issueSeq;
  }
  for (stmtObj in documentObj.statements.select(stmtObj | stmtObj.principals.isEmpty())) {
    issueSeq.add(self.issueTuple("RESOURCE_POLICY_PRINCIPAL_MISSING", "BLOCKER", "Resource-based IAM policy statement must define Principal: " + stmtObj.stableKey(), sourceObj, true));
  }
  return issueSeq;
}

/** Returns whether the receiver is sue tuple. */
operation AWSPSM!AwsPsmModel issueTuple(codeText : String, severityText : String, messageText : String, sourceObj, blockingFlag : Boolean) : Map {
  var stableText = "";
  var sourceTypeText = "";
  if (sourceObj.isDefined()) {
    stableText = sourceObj.stableKey();
    sourceTypeText = sourceObj.eClass().getName();
  }
  var rowMap = new Map;
  rowMap.put("code", codeText);
  rowMap.put("severity", severityText);
  rowMap.put("message", messageText);
  rowMap.put("sourceStableId", stableText);
  rowMap.put("sourceType", sourceTypeText);
  rowMap.put("blocking", blockingFlag);
  return rowMap;
}
