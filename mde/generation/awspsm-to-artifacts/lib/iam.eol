/** Provides reusable iam operations. */
import "naming.eol";
import "values.eol";

/** Renders emit iam policy document yaml. */
operation AWSPSMSECURITY!IamPolicyDocument emitIamPolicyDocumentYaml(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "Version: " + self.version.orElseText("2012-10-17").yamlScalar() + "\n";
  outText = outText + spaces(indentCount) + "Statement:\n";
  for (stmtObj in self.uniqueIamStatements()) {
    outText = outText + stmtObj.emitIamStatementYaml(indentCount + 2);
  }
  return outText;
}

/** Returns the first statement for each Sid so emitted policy documents remain valid. */
operation AWSPSMSECURITY!IamPolicyDocument uniqueIamStatements() : Sequence {
  var statementSeq = new Sequence;
  var seenSidSet = new Set;
  for (stmtObj in self.statements) {
    if (not stmtObj.sid.isPresent() or not seenSidSet.includes(stmtObj.sid)) {
      statementSeq.add(stmtObj);
      if (stmtObj.sid.isPresent()) {
        seenSidSet.add(stmtObj.sid);
      }
    }
  }
  return statementSeq;
}

/** Renders emit iam statement yaml. */
operation AWSPSMSECURITY!IamStatement emitIamStatementYaml(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "- Effect: " + self.effect.iamEffectText() + "\n";
  if (self.sid.isPresent()) {
    outText = outText + spaces(indentCount + 2) + "Sid: " + self.sid.toCfnLogicalId().yamlScalar() + "\n";
  }
  outText = outText + self.actions.emitIamListYaml("Action", indentCount + 2);
  outText = outText + self.notActions.emitIamListYaml("NotAction", indentCount + 2);
  if (self.principals.isEmpty()) {
    outText = outText + self.resources.emitIamListYaml("Resource", indentCount + 2);
    outText = outText + self.notResources.emitIamListYaml("NotResource", indentCount + 2);
  }
  if (self.principals.notEmpty()) {
    outText = outText + spaces(indentCount + 2) + "Principal:\n";
    for (principalObj in self.principals) {
      outText = outText + spaces(indentCount + 4) + principalObj.principalType.orElseText("AWS") + ":\n";
      for (idText in principalObj.identifiers) {
        outText = outText + spaces(indentCount + 6) + "- " + idText.yamlScalar() + "\n";
      }
    }
  }
  if (self.conditions.notEmpty()) {
    outText = outText + spaces(indentCount + 2) + "Condition:\n";
    for (condObj in self.conditions) {
      outText = outText + spaces(indentCount + 4) + condObj.operator.orElseText("StringEquals") + ":\n";
      outText = outText + spaces(indentCount + 6) + condObj.key.orElseText("aws:PrincipalArn") + ":\n";
      for (valText in condObj.values) {
        outText = outText + spaces(indentCount + 8) + "- " + valText.yamlScalar() + "\n";
      }
    }
  }
  return outText;
}

/** Renders emit iam list yaml. */
operation Collection emitIamListYaml(nameText : String, indentCount : Integer) : String {
  if (self.isEmpty()) {
    return "";
  }
  if (self.size() = 1) {
    return spaces(indentCount) + nameText + ": " + self.first().normalizeIamResourceReference().yamlScalar() + "\n";
  }
  var outText = spaces(indentCount) + nameText + ":\n";
  for (itemText in self) {
    outText = outText + spaces(indentCount + 2) + "- " + itemText.normalizeIamResourceReference().yamlScalar() + "\n";
  }
  return outText;
}

/** Normalizes resource references whose CloudFormation return value is already the ARN. */
operation Any normalizeIamResourceReference() : String {
  var resourceText = self.asString();
  for (resourceObj in AWSPSMCORE!AwsResource.all) {
    if (resourceText = "!GetAtt " + resourceObj.cfnLogicalId() + ".Arn") {
      return arnForResource(resourceObj);
    }
  }
  for (topicObj in AWSPSMMESSAGING!SnsTopic.all) {
    if (resourceText = "!GetAtt " + topicObj.cfnLogicalId() + ".Arn") {
      return "!Ref " + topicObj.cfnLogicalId();
    }
    if (resourceText = "!Sub '${" + topicObj.cfnLogicalId() + ".Arn}/*'") {
      return "!Ref " + topicObj.cfnLogicalId();
    }
  }
  for (tableObj in AWSPSMSTORAGE!DynamoDbTable.all) {
    var tableNameText = firstText(tableObj.tableName, tableObj.physicalName);
    if (tableNameText.isPresent() and resourceText = "!GetAtt " + tableObj.cfnLogicalId() + ".Arn") {
      return "!Sub 'arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/" + tableNameText + "'";
    }
    if (tableNameText.isPresent() and resourceText = "!Sub '${" + tableObj.cfnLogicalId() + ".Arn}/*'") {
      return "!Sub 'arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/" + tableNameText + "/*'";
    }
    if (tableNameText.isPresent() and resourceText = "!Sub '${" + tableObj.cfnLogicalId() + ".Arn}/index/*'") {
      return "!Sub 'arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/" + tableNameText + "/index/*'";
    }
  }
  return resourceText;
}

/** Renders emit iam policy document json. */
operation AWSPSMSECURITY!IamPolicyDocument emitIamPolicyDocumentJson(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "{\n";
  outText = outText + spaces(indentCount + 2) + "\"Version\": " + self.version.orElseText("2012-10-17").jsonString() + ",\n";
  outText = outText + spaces(indentCount + 2) + "\"Statement\": [\n";
  var statementSeq = self.uniqueIamStatements();
  for (stmtObj in statementSeq) {
    outText = outText + stmtObj.emitIamStatementJson(indentCount + 4);
    if (stmtObj <> statementSeq.last()) {
      outText = outText + ",";
    }
    outText = outText + "\n";
  }
  outText = outText + spaces(indentCount + 2) + "]\n";
  outText = outText + spaces(indentCount) + "}";
  return outText;
}

/** Renders emit iam statement json. */
operation AWSPSMSECURITY!IamStatement emitIamStatementJson(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "{\n";
  outText = outText + spaces(indentCount + 2) + "\"Effect\": " + self.effect.iamEffectText().jsonString();
  if (self.sid.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Sid\": " + self.sid.toCfnLogicalId().jsonString();
  }
  if (self.actions.notEmpty()) {
    outText = outText + ",\n" + self.actions.emitJsonStringArray("Action", indentCount + 2);
  }
  if (self.principals.isEmpty() and self.resources.notEmpty()) {
    outText = outText + ",\n" + self.resources.emitJsonStringArray("Resource", indentCount + 2);
  }
  if (self.principals.notEmpty()) {
    outText = outText + ",\n" + self.emitIamPrincipalsJson(indentCount + 2);
  }
  outText = outText + "\n" + spaces(indentCount) + "}";
  return outText;
}

/** Renders IAM principals in JSON policy documents. */
operation AWSPSMSECURITY!IamStatement emitIamPrincipalsJson(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "\"Principal\": {";
  for (principalObj in self.principals) {
    outText = outText + "\n" + spaces(indentCount + 2) + principalObj.principalType.orElseText("AWS").jsonString() + ": ";
    outText = outText + principalObj.identifiers.emitJsonStringArrayValue();
    if (principalObj <> self.principals.last()) {
      outText = outText + ",";
    }
  }
  return outText + "\n" + spaces(indentCount) + "}";
}

/** Renders a collection as a JSON string or string array value. */
operation Collection emitJsonStringArrayValue() : String {
  if (self.size() = 1) {
    return self.first().jsonString();
  }
  var outText = "[";
  for (itemText in self) {
    outText = outText + itemText.jsonString();
    if (itemText <> self.last()) {
      outText = outText + ", ";
    }
  }
  return outText + "]";
}

/** Renders emit json string array. */
operation Collection emitJsonStringArray(nameText : String, indentCount : Integer) : String {
  var outText = spaces(indentCount) + "\"" + nameText + "\": ";
  if (self.size() = 1) {
    return outText + self.first().jsonString();
  }
  outText = outText + "[";
  for (itemText in self) {
    outText = outText + itemText.jsonString();
    if (itemText <> self.last()) {
      outText = outText + ", ";
    }
  }
  outText = outText + "]";
  return outText;
}
