operation AWSPSMSTORAGE!DynamoDbTable cfnTypeText(emitCtx : Map) : String {
  return "AWS::DynamoDB::Table";
}

operation AWSPSMSTORAGE!DynamoDbTable emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("TableName", firstText(self.tableName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("BillingMode", self.billingMode.asString(), 6);
  if (self.tableClass.isDefined()) {
    outText = outText + emitYamlScalarProperty("TableClass", self.tableClass.asString(), 6);
  }
  outText = outText + emitYamlBooleanProperty("DeletionProtectionEnabled", self.deletionProtectionEnabled, 6);
  if (self.attributeDefinitions.notEmpty()) {
    outText = outText + spaces(6) + "AttributeDefinitions:\n";
    for (attrObj in self.attributeDefinitions.sortBy(attrObj | attrObj.attributeName)) {
      outText = outText + spaces(8) + "- AttributeName: " + attrObj.attributeName.yamlScalar() + "\n";
      outText = outText + spaces(10) + "AttributeType: " + attrObj.attributeType.asString() + "\n";
    }
  }
  if (self.keySchema.notEmpty()) {
    outText = outText + spaces(6) + "KeySchema:\n";
    for (keyObj in self.keySchema) {
      outText = outText + spaces(8) + "- AttributeName: " + keyObj.attributeName.yamlScalar() + "\n";
      outText = outText + spaces(10) + "KeyType: " + keyObj.keyType.asString() + "\n";
    }
  }
  if (self.provisionedThroughput.isDefined()) {
    outText = outText + spaces(6) + "ProvisionedThroughput:\n";
    outText = outText + spaces(8) + "ReadCapacityUnits: " + self.provisionedThroughput.readCapacityUnits.asString() + "\n";
    outText = outText + spaces(8) + "WriteCapacityUnits: " + self.provisionedThroughput.writeCapacityUnits.asString() + "\n";
  }
  if (self.onDemandThroughput.isDefined()) {
    outText = outText + spaces(6) + "OnDemandThroughput:\n";
    outText = outText + emitYamlIntegerProperty("MaxReadRequestUnits", self.onDemandThroughput.maxReadRequestUnits, 8);
    outText = outText + emitYamlIntegerProperty("MaxWriteRequestUnits", self.onDemandThroughput.maxWriteRequestUnits, 8);
  }
  outText = outText + self.localSecondaryIndexes.emitDdbIndexesYaml("LocalSecondaryIndexes", 6);
  outText = outText + self.globalSecondaryIndexes.emitDdbIndexesYaml("GlobalSecondaryIndexes", 6);
  if (self.streamSpecification.isDefined()) {
    outText = outText + spaces(6) + "StreamSpecification:\n";
    outText = outText + spaces(8) + "StreamViewType: " + self.streamSpecification.streamViewType.asString() + "\n";
  }
  if (self.timeToLiveSpecification.isDefined()) {
    outText = outText + spaces(6) + "TimeToLiveSpecification:\n";
    outText = outText + emitYamlScalarProperty("AttributeName", self.timeToLiveSpecification.attributeName, 8);
    outText = outText + emitYamlBooleanProperty("Enabled", self.timeToLiveSpecification.enabled, 8);
  }
  if (self.sseSpecification.isDefined()) {
    outText = outText + spaces(6) + "SSESpecification:\n";
    outText = outText + emitYamlBooleanProperty("SSEEnabled", self.sseSpecification.enabled, 8);
    outText = outText + emitYamlScalarProperty("SSEType", self.sseSpecification.sseType, 8);
    if (self.sseSpecification.kmsKey.isDefined()) {
      outText = outText + spaces(8) + "KMSMasterKeyId: !Ref " + self.sseSpecification.kmsKey.cfnLogicalId() + "\n";
    }
  else if (self.kmsKey.isDefined()) {
    outText = outText + spaces(6) + "SSESpecification:\n";
    outText = outText + spaces(8) + "SSEEnabled: true\n";
    outText = outText + spaces(8) + "SSEType: KMS\n";
    outText = outText + spaces(8) + "KMSMasterKeyId: !Ref " + self.kmsKey.cfnLogicalId() + "\n";
  }
  }
  if (self.pointInTimeRecoveryEnabled.isDefined()) {
    outText = outText + spaces(6) + "PointInTimeRecoverySpecification:\n";
    outText = outText + spaces(8) + "PointInTimeRecoveryEnabled: " + self.pointInTimeRecoveryEnabled.asString().toLowerCase() + "\n";
  }
  if (self.contributorInsightsEnabled.isDefined()) {
    outText = outText + "      ContributorInsightsSpecification:\n";
    outText = outText + "        Enabled: " + self.contributorInsightsEnabled.asString().toLowerCase() + "\n";
  }
  if (self.resourcePolicyJson.isPresent()) {
    outText = outText + yamlBlock("ResourcePolicy", self.resourcePolicyJson, 6);
  }
  else if (self.resourcePolicy.isDefined()) {
    outText = outText + "      ResourcePolicy:\n";
    outText = outText + "        PolicyDocument:\n" + self.resourcePolicy.emitIamPolicyDocumentYaml(10);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation Collection emitDdbIndexesYaml(nameText : String, indentCount : Integer) : String {
  if (self.isEmpty()) {
    return "";
  }
  var outText = spaces(indentCount) + nameText + ":\n";
  for (indexObj in self.sortBy(indexObj | indexObj.indexName)) {
    outText = outText + spaces(indentCount + 2) + "- IndexName: " + indexObj.indexName.yamlScalar() + "\n";
    outText = outText + spaces(indentCount + 4) + "KeySchema:\n";
    for (keyObj in indexObj.keySchema) {
      outText = outText + spaces(indentCount + 6) + "- AttributeName: " + keyObj.attributeName.yamlScalar() + "\n";
      outText = outText + spaces(indentCount + 8) + "KeyType: " + keyObj.keyType.asString() + "\n";
    }
    outText = outText + spaces(indentCount + 4) + "Projection:\n";
    outText = outText + spaces(indentCount + 6) + "ProjectionType: " + indexObj.projection.projectionType.asString() + "\n";
    if (indexObj.projection.nonKeyAttributes.notEmpty()) {
      outText = outText + emitYamlStringListProperty("NonKeyAttributes", indexObj.projection.nonKeyAttributes, indentCount + 6);
    }
    if (indexObj.eClass().getName() = "DynamoDbGlobalSecondaryIndex" and indexObj.provisionedThroughput.isDefined()) {
      outText = outText + spaces(indentCount + 4) + "ProvisionedThroughput:\n";
      outText = outText + spaces(indentCount + 6) + "ReadCapacityUnits: " + indexObj.provisionedThroughput.readCapacityUnits.asString() + "\n";
      outText = outText + spaces(indentCount + 6) + "WriteCapacityUnits: " + indexObj.provisionedThroughput.writeCapacityUnits.asString() + "\n";
    }
  }
  return outText;
}

operation AWSPSMSTORAGE!S3Bucket cfnTypeText(emitCtx : Map) : String {
  return "AWS::S3::Bucket";
}

operation AWSPSMSTORAGE!S3Bucket emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("BucketName", firstText(self.bucketName, self.physicalName), 6);
  if (self.versioningStatus.isDefined()) {
    outText = outText + spaces(6) + "VersioningConfiguration:\n";
    if (self.versioningStatus.asString() = "ENABLED") {
      outText = outText + spaces(8) + "Status: Enabled\n";
    }
    else {
      outText = outText + spaces(8) + "Status: Suspended\n";
    }
  }
  outText = outText + emitYamlBooleanProperty("ObjectLockEnabled", self.objectLockEnabled, 6);
  if (self.transferAccelerationEnabled.isDefined()) {
    outText = outText + spaces(6) + "AccelerateConfiguration:\n";
    if (self.transferAccelerationEnabled) {
      outText = outText + spaces(8) + "AccelerationStatus: Enabled\n";
    }
    else {
      outText = outText + spaces(8) + "AccelerationStatus: Suspended\n";
    }
  }
  if (self.encryption.isDefined()) {
    outText = outText + spaces(6) + "BucketEncryption:\n";
    outText = outText + spaces(8) + "ServerSideEncryptionConfiguration:\n";
    outText = outText + spaces(10) + "- ServerSideEncryptionByDefault:\n";
    outText = outText + emitYamlScalarProperty("SSEAlgorithm", self.encryption.sseAlgorithm.orElseText("aws:kms"), 12);
    if (self.encryption.kmsKey.isDefined()) {
      outText = outText + spaces(12) + "KMSMasterKeyID: !Ref " + self.encryption.kmsKey.cfnLogicalId() + "\n";
    }
    outText = outText + emitYamlBooleanProperty("BucketKeyEnabled", firstText(self.encryption.bucketKeyEnabled, self.bucketKeyEnabled), 10);
  }
  if (self.publicAccessBlock.isDefined()) {
    outText = outText + spaces(6) + "PublicAccessBlockConfiguration:\n";
    outText = outText + emitYamlBooleanProperty("BlockPublicAcls", self.publicAccessBlock.blockPublicAcls, 8);
    outText = outText + emitYamlBooleanProperty("BlockPublicPolicy", self.publicAccessBlock.blockPublicPolicy, 8);
    outText = outText + emitYamlBooleanProperty("IgnorePublicAcls", self.publicAccessBlock.ignorePublicAcls, 8);
    outText = outText + emitYamlBooleanProperty("RestrictPublicBuckets", self.publicAccessBlock.restrictPublicBuckets, 8);
  }
  else if (self.publicAccessMode.asString() = "STRICT_BLOCK_ALL") {
    outText = outText + spaces(6) + "PublicAccessBlockConfiguration:\n";
    outText = outText + spaces(8) + "BlockPublicAcls: true\n";
    outText = outText + spaces(8) + "BlockPublicPolicy: true\n";
    outText = outText + spaces(8) + "IgnorePublicAcls: true\n";
    outText = outText + spaces(8) + "RestrictPublicBuckets: true\n";
  }
  if (self.ownershipControls.isDefined()) {
    outText = outText + spaces(6) + "OwnershipControls:\n";
    outText = outText + spaces(8) + "Rules:\n";
    for (ownObj in self.ownershipControls.rules) {
      outText = outText + spaces(10) + "- ObjectOwnership: " + ownObj.objectOwnership.yamlScalar() + "\n";
    }
  }
  if (self.cors.isDefined()) {
    outText = outText + spaces(6) + "CorsConfiguration:\n";
    outText = outText + spaces(8) + "CorsRules:\n";
    outText = outText + spaces(10) + "-\n" + self.cors.emitCorsYaml(12);
  }
  if (self.lifecycle.isDefined()) {
    outText = outText + spaces(6) + "LifecycleConfiguration:\n";
    outText = outText + spaces(8) + "Rules:\n";
    for (lifeObj in self.lifecycle.rules.sortBy(lifeObj | lifeObj.ruleId)) {
      outText = outText + spaces(10) + "- Id: " + lifeObj.ruleId.yamlScalar() + "\n";
      outText = outText + emitYamlScalarProperty("Status", lifeObj.status, 12);
      outText = outText + emitYamlScalarProperty("Prefix", lifeObj.prefix, 12);
      outText = outText + emitYamlIntegerProperty("ExpirationInDays", lifeObj.expirationInDays, 12);
      outText = outText + emitYamlIntegerProperty("NoncurrentVersionExpirationInDays", lifeObj.noncurrentVersionExpirationInDays, 12);
      if (lifeObj.transitions.notEmpty()) {
        outText = outText + spaces(12) + "Transitions:\n";
        for (trObj in lifeObj.transitions) {
          outText = outText + spaces(14) + "- StorageClass: " + trObj.storageClass.yamlScalar() + "\n";
          outText = outText + spaces(16) + "TransitionInDays: " + trObj.transitionInDays.asString() + "\n";
        }
      }
    }
  }
  if (self.notificationConfiguration.isDefined()) {
    outText = outText + spaces(6) + "NotificationConfiguration:\n";
    if (self.notificationConfiguration.eventBridgeEnabled = true) {
      outText = outText + spaces(8) + "EventBridgeConfiguration:\n";
      outText = outText + spaces(10) + "EventBridgeEnabled: true\n";
    }
    if (self.notificationConfiguration.rules.notEmpty()) {
      outText = outText + self.notificationConfiguration.rules.emitS3NotificationRulesYaml(8);
    }
  }
  if (self.eventBridgeNotificationEnabled = true) {
    outText = outText + spaces(6) + "NotificationConfiguration:\n";
    outText = outText + spaces(8) + "EventBridgeConfiguration:\n";
    outText = outText + spaces(10) + "EventBridgeEnabled: true\n";
  }
  if (self.websiteConfigurationJson.isPresent()) {
    outText = outText + yamlBlock("WebsiteConfiguration", self.websiteConfigurationJson, 6);
  }
  if (self.loggingConfigurationJson.isPresent()) {
    outText = outText + yamlBlock("LoggingConfiguration", self.loggingConfigurationJson, 6);
  }
  if (self.replicationConfiguration.isDefined() and self.replicationConfiguration.rulesJson.isPresent()) {
    outText = outText + yamlBlock("ReplicationConfiguration", self.replicationConfiguration.rulesJson, 6);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMSTORAGE!S3BucketPolicy cfnTypeText(emitCtx : Map) : String {
  return "AWS::S3::BucketPolicy";
}

operation AWSPSMSTORAGE!S3BucketPolicy emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = spaces(6) + "Bucket: !Ref " + self.bucket.cfnLogicalId() + "\n";
  if (self.policyDocumentJson.isPresent()) {
    outText = outText + yamlBlock("PolicyDocument", self.policyDocumentJson, 6);
  }
  else if (self.policyDocument.isDefined()) {
    outText = outText + "      PolicyDocument:\n" + self.policyDocument.emitIamPolicyDocumentYaml(8);
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation Collection emitS3NotificationRulesYaml(indentCount : Integer) : String {
  var lambdaText = "";
  var queueText = "";
  var topicText = "";
  for (notifObj in self) {
    if (notifObj.destination.isDefined()) {
      var destClassText = notifObj.destination.eClass().getName();
      if (destClassText = "AwsLambdaFunction") {
        lambdaText = lambdaText + notifObj.emitSingleS3NotificationYaml("Function", indentCount + 2);
      }
      else if (destClassText = "SqsQueue") {
        queueText = queueText + notifObj.emitSingleS3NotificationYaml("Queue", indentCount + 2);
      }
      else if (destClassText = "SnsTopic") {
        topicText = topicText + notifObj.emitSingleS3NotificationYaml("Topic", indentCount + 2);
      }
    }
  }
  var outText = "";
  if (not lambdaText.isEmpty()) {
    outText = outText + spaces(indentCount) + "LambdaConfigurations:\n" + lambdaText;
  }
  if (not queueText.isEmpty()) {
    outText = outText + spaces(indentCount) + "QueueConfigurations:\n" + queueText;
  }
  if (not topicText.isEmpty()) {
    outText = outText + spaces(indentCount) + "TopicConfigurations:\n" + topicText;
  }
  return outText;
}

operation AWSPSMSTORAGE!S3NotificationRule emitSingleS3NotificationYaml(destinationNameText : String, indentCount : Integer) : String {
  var eventText = "s3:ObjectCreated:*";
  if (self.eventTypes.notEmpty()) {
    eventText = self.eventTypes.first();
  }
  var outText = spaces(indentCount) + "- Event: " + eventText.yamlScalar() + "\n";
  outText = outText + spaces(indentCount + 2) + destinationNameText + ": " + arnForResource(self.destination) + "\n";
  if (self.filterPrefix.isPresent() or self.filterSuffix.isPresent()) {
    outText = outText + spaces(indentCount + 2) + "Filter:\n";
    outText = outText + spaces(indentCount + 4) + "S3Key:\n";
    outText = outText + spaces(indentCount + 6) + "Rules:\n";
    if (self.filterPrefix.isPresent()) {
      outText = outText + spaces(indentCount + 8) + "- Name: prefix\n";
      outText = outText + spaces(indentCount + 10) + "Value: " + self.filterPrefix.yamlScalar() + "\n";
    }
    if (self.filterSuffix.isPresent()) {
      outText = outText + spaces(indentCount + 8) + "- Name: suffix\n";
      outText = outText + spaces(indentCount + 10) + "Value: " + self.filterSuffix.yamlScalar() + "\n";
    }
  }
  return outText;
}

operation AWSPSMAPI!HttpApi cfnTypeText(emitCtx : Map) : String {
  return "AWS::Serverless::HttpApi";
}

operation AWSPSMAPI!RestApi cfnTypeText(emitCtx : Map) : String {
  return "AWS::Serverless::Api";
}

operation AWSPSMAPI!WebSocketApi cfnTypeText(emitCtx : Map) : String {
  return "AWS::ApiGatewayV2::Api";
}

operation AWSPSMAPI!ApiGatewayApi emitApiCommonPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("Name", firstText(self.apiName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("Description", self.descriptionText, 6);
  if (self.definitionUri.isPresent()) {
    outText = outText + emitYamlScalarProperty("DefinitionUri", self.definitionUri, 6);
  }
  else if (self.definitionBody.isPresent()) {
    outText = outText + yamlBlock("DefinitionBody", self.definitionBody, 6);
  }
  else if (self.routes.notEmpty() and (self.eClass().getName() = "HttpApi" or self.eClass().getName() = "RestApi")) {
    outText = outText + emitYamlScalarProperty("DefinitionUri", self.openApiPath(), 6);
  }
  if (self.corsEnabled = true and self.cors.isDefined()) {
    outText = outText + spaces(6) + "CorsConfiguration:\n" + self.cors.emitCorsYaml(8);
  }
  if (self.accessLogsEnabled = true and self.accessLogGroup.isDefined()) {
    outText = outText + spaces(6) + "AccessLogSettings:\n";
    outText = outText + spaces(8) + "DestinationArn: " + arnForResource(self.accessLogGroup) + "\n";
  }
  if (self.apiPolicyJson.isPresent()) {
    outText = outText + yamlBlock("Policy", self.apiPolicyJson, 6);
  }
  else if (self.apiPolicy.isDefined()) {
    outText = outText + "      Auth:\n";
    outText = outText + "        ResourcePolicy:\n" + self.apiPolicy.emitIamPolicyDocumentYaml(10);
  }
  return outText;
}

operation AWSPSMAPI!HttpApi emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = self.emitApiCommonPropertiesYaml(emitCtx);
  outText = outText + emitYamlBooleanProperty("DisableExecuteApiEndpoint", self.disableExecuteApiEndpoint, 6);
  outText = outText + emitYamlIntegerProperty("MinimumCompressionSize", self.minimumCompressionSize, 6);
  outText = outText + emitYamlBooleanProperty("FailOnWarnings", self.failOnWarnings, 6);
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMAPI!RestApi emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = self.emitApiCommonPropertiesYaml(emitCtx);
  if (self.endpointType.isDefined()) {
    outText = outText + spaces(6) + "EndpointConfiguration: " + self.endpointType.asString() + "\n";
  }
  outText = outText + emitYamlIntegerProperty("MinimumCompressionSize", self.minimumCompressionSize, 6);
  outText = outText + emitYamlBooleanProperty("FailOnWarnings", self.failOnWarnings, 6);
  if (self.stages.notEmpty()) {
    outText = outText + emitYamlScalarProperty("StageName", self.stages.first().stageName, 6);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMAPI!WebSocketApi emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("Name", firstText(self.apiName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("Description", self.descriptionText, 6);
  outText = outText + "      ProtocolType: WEBSOCKET\n";
  outText = outText + emitYamlScalarProperty("RouteSelectionExpression", self.routeSelectionExpression, 6);
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMAPI!ApiGatewayIntegration cfnTypeText(emitCtx : Map) : String {
  return "AWS::ApiGatewayV2::Integration";
}

operation AWSPSMAPI!ApiGatewayIntegration emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  if (AWSPSMAPI!ApiGatewayRoute.all.exists(routeObj | routeObj.integration = self)) {
    var routeObj = AWSPSMAPI!ApiGatewayRoute.all.selectOne(routeObj | routeObj.integration = self);
    outText = outText + spaces(6) + "ApiId: !Ref " + routeObj.api.cfnLogicalId() + "\n";
  }
  outText = outText + emitYamlScalarProperty("IntegrationType", self.integrationType.asString(), 6);
  outText = outText + emitYamlScalarProperty("IntegrationMethod", self.integrationMethod.orElseText("POST"), 6);
  if (self.lambdaTarget.isDefined()) {
    outText = outText + spaces(6) + "IntegrationUri: " + arnForResource(self.lambdaTarget) + "\n";
  }
  else if (self.stateMachineTarget.isDefined()) {
    outText = outText + spaces(6) + "IntegrationUri: " + arnForResource(self.stateMachineTarget) + "\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("IntegrationUri", self.integrationUri, 6);
  }
  outText = outText + emitYamlScalarProperty("PayloadFormatVersion", self.payloadFormatVersion.orElseText("2.0"), 6);
  outText = outText + emitYamlIntegerProperty("TimeoutInMillis", self.timeoutInMillis, 6);
  outText = outText + emitYamlScalarProperty("PassthroughBehavior", self.passthroughBehavior, 6);
  if (self.credentialsRole.isDefined()) {
    outText = outText + spaces(6) + "CredentialsArn: " + arnForResource(self.credentialsRole) + "\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("CredentialsArn", self.credentialsArn, 6);
  }
  if (self.requestTemplatesJson.isPresent()) {
    outText = outText + yamlBlock("RequestTemplates", self.requestTemplatesJson, 6);
  }
  if (self.responseParametersJson.isPresent()) {
    outText = outText + yamlBlock("ResponseParameters", self.responseParametersJson, 6);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMAPI!HttpApiRoute cfnTypeText(emitCtx : Map) : String {
  return "AWS::ApiGatewayV2::Route";
}

operation AWSPSMAPI!WebSocketRoute cfnTypeText(emitCtx : Map) : String {
  return "AWS::ApiGatewayV2::Route";
}

operation AWSPSMAPI!RestApiRoute cfnTypeText(emitCtx : Map) : String {
  return "AWS::ApiGateway::Method";
}

operation AWSPSMAPI!ApiGatewayRoute emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  outText = outText + spaces(6) + "ApiId: !Ref " + self.api.cfnLogicalId() + "\n";
  if (self.eClass().getName() = "HttpApiRoute") {
    outText = outText + emitYamlScalarProperty("RouteKey", self.method.asString() + " " + self.path, 6);
  }
  else if (self.eClass().getName() = "WebSocketRoute") {
    outText = outText + emitYamlScalarProperty("RouteKey", self.routeKey, 6);
  }
  if (self.integration.isDefined()) {
    outText = outText + spaces(6) + "Target: !Sub integrations/${" + self.integration.cfnLogicalId() + "}\n";
  }
  outText = outText + emitYamlScalarProperty("AuthorizationType", self.authorizationType.asString(), 6);
  if (self.authorizer.isDefined()) {
    outText = outText + spaces(6) + "AuthorizerId: !Ref " + self.authorizer.cfnLogicalId() + "\n";
  }
  outText = outText + emitYamlStringListProperty("AuthorizationScopes", self.authorizationScopes, 6);
  if (self.requestParametersJson.isPresent()) {
    outText = outText + yamlBlock("RequestParameters", self.requestParametersJson, 6);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMAPI!RestApiRoute emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = spaces(6) + "RestApiId: !Ref " + self.api.cfnLogicalId() + "\n";
  outText = outText + emitYamlScalarProperty("HttpMethod", self.method.asString(), 6);
  outText = outText + emitYamlScalarProperty("ResourceId", self.restApiResourcePath.orElseText(self.path), 6);
  outText = outText + emitYamlScalarProperty("AuthorizationType", self.authorizationType.asString(), 6);
  outText = outText + emitYamlBooleanProperty("ApiKeyRequired", self.apiKeyRequired, 6);
  if (self.integration.isDefined()) {
    outText = outText + spaces(6) + "Integration:\n";
    outText = outText + emitYamlScalarProperty("Type", self.integration.integrationType.asString(), 8);
    outText = outText + emitYamlScalarProperty("IntegrationHttpMethod", self.integration.integrationMethod.orElseText("POST"), 8);
    if (self.integration.lambdaTarget.isDefined()) {
      outText = outText + spaces(8) + "Uri: " + arnForResource(self.integration.lambdaTarget) + "\n";
    }
    else {
      outText = outText + emitYamlScalarProperty("Uri", self.integration.integrationUri, 8);
    }
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMAPI!ApiGatewayStage cfnTypeText(emitCtx : Map) : String {
  if (self.eClass().getName() = "RestApiStage") {
    return "AWS::ApiGateway::Stage";
  }
  return "AWS::ApiGatewayV2::Stage";
}

operation AWSPSMAPI!ApiGatewayStage emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  if (self.eClass().getName() = "RestApiStage") {
    outText = outText + spaces(6) + "RestApiId: !Ref " + self.api.cfnLogicalId() + "\n";
    if (self.deployment.isDefined()) {
      outText = outText + spaces(6) + "DeploymentId: !Ref " + self.deployment.cfnLogicalId() + "\n";
    }
  }
  else {
    outText = outText + spaces(6) + "ApiId: !Ref " + self.api.cfnLogicalId() + "\n";
    outText = outText + emitYamlBooleanProperty("AutoDeploy", self.autoDeploy, 6);
  }
  outText = outText + emitYamlScalarProperty("StageName", self.stageName, 6);
  if (self.accessLogEnabled = true and self.accessLogGroup.isDefined()) {
    outText = outText + spaces(6) + "AccessLogSettings:\n";
    outText = outText + spaces(8) + "DestinationArn: " + arnForResource(self.accessLogGroup) + "\n";
    outText = outText + emitYamlScalarProperty("Format", self.accessLogFormat, 8);
  }
  outText = outText + emitYamlScalarProperty("Variables", self.variablesJson, 6);
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMAPI!ApiGatewayAuthorizer cfnTypeText(emitCtx : Map) : String {
  if (self.api.eClass().getName() = "RestApi") {
    return "AWS::ApiGateway::Authorizer";
  }
  return "AWS::ApiGatewayV2::Authorizer";
}

operation AWSPSMAPI!ApiGatewayAuthorizer emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  if (self.api.eClass().getName() = "RestApi") {
    outText = outText + spaces(6) + "RestApiId: !Ref " + self.api.cfnLogicalId() + "\n";
  }
  else {
    outText = outText + spaces(6) + "ApiId: !Ref " + self.api.cfnLogicalId() + "\n";
  }
  outText = outText + emitYamlScalarProperty("Name", firstText(self.authorizerName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("AuthorizerType", self.authorizationType.asString(), 6);
  outText = outText + emitYamlScalarProperty("IdentitySource", self.identitySource, 6);
  outText = outText + emitYamlIntegerProperty("AuthorizerResultTtlInSeconds", self.authorizerResultTtlInSeconds, 6);
  if (self.eClass().getName() = "JwtAuthorizer") {
    outText = outText + spaces(6) + "JwtConfiguration:\n";
    outText = outText + emitYamlScalarProperty("Issuer", self.issuer, 8);
    outText = outText + emitYamlStringListProperty("Audience", self.audience, 8);
  }
  else if (self.eClass().getName() = "CognitoAuthorizer") {
    outText = outText + spaces(6) + "ProviderARNs:\n";
    outText = outText + spaces(8) + "- " + arnForResource(self.userPool) + "\n";
  }
  else if (self.eClass().getName() = "LambdaAuthorizer") {
    outText = outText + spaces(6) + "AuthorizerUri: " + arnForResource(self.modelFeatureValue("function")) + "\n";
    outText = outText + emitYamlScalarProperty("AuthorizerPayloadFormatVersion", self.authorizerPayloadFormatVersion, 6);
    outText = outText + emitYamlBooleanProperty("EnableSimpleResponses", self.enableSimpleResponses, 6);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

