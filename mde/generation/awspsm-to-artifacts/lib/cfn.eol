operation AWSPSMEVENTS!EventBridgeSchedule emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("Name", firstText(self.scheduleName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("Description", self.descriptionText, 6);
  outText = outText + emitYamlScalarProperty("ScheduleExpression", self.scheduleExpression, 6);
  outText = outText + emitYamlScalarProperty("ScheduleExpressionTimezone", self.scheduleExpressionTimezone, 6);
  outText = outText + emitYamlScalarProperty("State", self.state, 6);
  if (self.flexibleTimeWindowJson.isPresent()) {
    outText = outText + yamlBlock("FlexibleTimeWindow", self.flexibleTimeWindowJson, 6);
  }
  else {
    outText = outText + spaces(6) + "FlexibleTimeWindow:\n";
    outText = outText + spaces(8) + "Mode: 'OFF'\n";
  }
  outText = outText + spaces(6) + "Target:\n";
  outText = outText + spaces(8) + "Arn: " + arnForResource(self.target.targetResource) + "\n";
  outText = outText + spaces(8) + "RoleArn: " + arnForResource(self.role) + "\n";
  if (self.target.input.isDefined()) {
    outText = outText + self.target.input.emitCfnValueProperty("Input", 8);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

