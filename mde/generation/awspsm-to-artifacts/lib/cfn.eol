  outText = outText + emitYamlScalarProperty("VpcEndpointType", self.endpointType, 6);
  if (self.vpc.isDefined()) {
    outText = outText + spaces(6) + "VpcId: !Ref " + self.vpc.cfnLogicalId() + "\n";
  }
  if (self.subnets.notEmpty()) {
    outText = outText + spaces(6) + "SubnetIds:\n";
    for (subnetObj in self.subnets) {
      outText = outText + spaces(8) + "- !Ref " + subnetObj.cfnLogicalId() + "\n";
    }
  }
  if (self.securityGroups.notEmpty()) {
    outText = outText + spaces(6) + "SecurityGroupIds:\n";
    for (sgObj in self.securityGroups) {
      outText = outText + spaces(8) + "- !Ref " + sgObj.cfnLogicalId() + "\n";
    }
  }
  if (self.policyDocumentJson.isPresent()) {
    outText = outText + yamlBlock("PolicyDocument", self.policyDocumentJson, 6);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

