    outText = outText + spaces(6) + "Source: " + arnForResource(self.sourceResource) + "\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("Source", self.sourceArn, 6);
  }
  if (self.targetResource.isDefined()) {
    outText = outText + spaces(6) + "Target: " + arnForResource(self.targetResource) + "\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("Target", self.targetArn, 6);
  }
  if (self.role.isDefined()) {
    outText = outText + spaces(6) + "RoleArn: " + arnForResource(self.role) + "\n";
  }
  if (self.enrichmentFunction.isDefined()) {
    outText = outText + spaces(6) + "Enrichment: " + arnForResource(self.enrichmentFunction) + "\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("Enrichment", self.enrichmentArn, 6);
  }
  if (self.filterCriteriaJson.isPresent()) {
    outText = outText + yamlBlock("FilterCriteria", self.filterCriteriaJson, 6);
  }
  if (self.sourceParametersJson.isPresent()) {
    outText = outText + yamlBlock("SourceParameters", self.sourceParametersJson, 6);
  }
  if (self.targetParametersJson.isPresent()) {
    outText = outText + yamlBlock("TargetParameters", self.targetParametersJson, 6);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

