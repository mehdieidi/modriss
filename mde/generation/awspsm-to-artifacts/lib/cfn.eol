operation AWSPSMOBSERVABILITY!CloudWatchAlarm cfnTypeText(emitCtx : Map) : String {
  return "AWS::CloudWatch::Alarm";
}

operation AWSPSMOBSERVABILITY!CloudWatchAlarm emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("AlarmName", firstText(self.alarmName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("AlarmDescription", self.alarmDescription, 6);
  outText = outText + emitYamlScalarProperty("Namespace", self.namespace, 6);
  outText = outText + emitYamlScalarProperty("MetricName", self.metricName, 6);
  outText = outText + emitYamlScalarProperty("Statistic", self.statistic, 6);
  outText = outText + emitYamlScalarProperty("ExtendedStatistic", self.extendedStatistic, 6);
  outText = outText + emitYamlIntegerProperty("Period", self.period, 6);
  outText = outText + emitYamlIntegerProperty("EvaluationPeriods", self.evaluationPeriods, 6);
  outText = outText + emitYamlIntegerProperty("DatapointsToAlarm", self.datapointsToAlarm, 6);
  outText = outText + emitYamlIntegerProperty("Threshold", self.threshold, 6);
  if (self.comparisonOperator.isDefined()) {
    outText = outText + emitYamlScalarProperty("ComparisonOperator", self.comparisonOperator.asString(), 6);
  }
  outText = outText + emitYamlScalarProperty("TreatMissingData", self.treatMissingData, 6);
  if (self.dimensions.notEmpty()) {
    outText = outText + spaces(6) + "Dimensions:\n";
    for (dimObj in self.dimensions) {
      outText = outText + spaces(8) + "- Name: " + dimObj.dimensionName.yamlScalar() + "\n";
      outText = outText + spaces(10) + "Value: " + dimObj.value.cfnInlineYaml() + "\n";
    }
  }
  outText = outText + emitYamlStringListProperty("AlarmActions", self.alarmActionArns, 6);
  outText = outText + emitYamlStringListProperty("OKActions", self.okActionArns, 6);
  outText = outText + emitYamlStringListProperty("InsufficientDataActions", self.insufficientDataActionArns, 6);
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

