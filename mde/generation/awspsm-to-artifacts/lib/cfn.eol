}

operation AWSPSMSECURITY!KmsAlias emitCfnPropertiesYaml(emitCtx : Map) : String {
  var aliasText = self.aliasName;
  if (aliasText.isPresent() and not aliasText.startsWith("alias/")) {
    aliasText = "alias/" + aliasText;
  }
  var outText = emitYamlScalarProperty("AliasName", aliasText, 6);
  outText = outText + spaces(6) + "TargetKeyId: !Ref " + self.targetKey.cfnLogicalId() + "\n";
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMSECURITY!SecretsManagerSecret cfnTypeText(emitCtx : Map) : String {
  return "AWS::SecretsManager::Secret";
}

operation AWSPSMSECURITY!SecretsManagerSecret emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("Name", firstText(self.secretName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("Description", self.descriptionText, 6);
  if (self.kmsKey.isDefined()) {
    outText = outText + spaces(6) + "KmsKeyId: !Ref " + self.kmsKey.cfnLogicalId() + "\n";
  }
  if (self.generateSecretStringJson.isPresent()) {
    outText = outText + yamlBlock("GenerateSecretString", self.generateSecretStringJson, 6);
  }
  else if (self.secretValue.isDefined() and self.secretValue.sourceKind.asString() <> "PLAINTEXT") {
    outText = outText + self.secretValue.emitCfnValueProperty("SecretString", 6);
  }
  outText = outText + emitYamlScalarProperty("ReplicaRegions", self.replicaRegionsJson, 6);
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMSECURITY!SecretRotationSchedule cfnTypeText(emitCtx : Map) : String {
