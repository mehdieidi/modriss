  outText = outText + emitYamlStringListProperty("AliasAttributes", self.aliasAttributes, 6);
  outText = outText + emitYamlStringListProperty("AutoVerifiedAttributes", self.autoVerifiedAttributes, 6);
  if (self.accountRecoverySettingJson.isPresent()) {
