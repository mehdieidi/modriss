import "naming.eol";
import "values.eol";
import "iam.eol";
import "paths.eol";

operation AWSPSMCORE!SamStack orderedResources() : Sequence {
  var resSeq = new Sequence;
  var groupSeq = Sequence{
    "IamRole", "IamManagedPolicy", "IamPolicy", "KmsKey", "KmsAlias", "SecretsManagerSecret", "SsmParameter",
    "CognitoUserPool", "CognitoUserPoolClient", "CognitoUserPoolGroup", "CognitoUserPoolDomain", "CognitoIdentityPool",
    "Vpc", "Subnet", "VpcEndpoint", "SecurityGroup",
    "DynamoDbTable", "S3Bucket",
    "SqsQueue", "SnsTopic",
    "EventBridgeBus", "EventBridgeBusPolicy", "EventBridgeRule", "EventBridgeArchive", "EventBridgeSchedule", "EventBridgePipe", "EventBridgeConnection", "EventBridgeApiDestination",
    "CloudWatchLogGroup",
    "CodeSigningConfig", "LambdaLayerVersion", "LambdaLayerPermission", "AwsLambdaFunction", "LambdaVersion", "LambdaAlias", "LambdaFunctionUrl", "LambdaEventInvokeConfig", "LambdaEventSourceMapping",
    "HttpApi", "RestApi", "WebSocketApi", "ApiGatewayIntegration", "ApiGatewayRoute", "ApiGatewayStage", "ApiGatewayAuthorizer",
    "StepFunctionStateMachine",
    "CloudWatchMetricFilter", "CloudWatchLogSubscriptionFilter", "CloudWatchAlarm", "CloudWatchCompositeAlarm", "CloudWatchDashboard",
    "LambdaPermission", "SqsQueuePolicy", "SnsSubscription", "SnsTopicPolicy", "S3BucketPolicy", "SecretsManagerResourcePolicy", "SecretRotationSchedule", "WafWebAclAssociation",
    "AwsNativeResource"
  };
  for (groupText in groupSeq) {
    for (resObj in self.resources.select(resObj | resObj.eClass().getName() = groupText).sortBy(resObj | resObj.cfnLogicalId())) {
      resSeq.add(resObj);
    }
  }
  for (resObj in self.resources.reject(resObj | groupSeq.includes(resObj.eClass().getName())).sortBy(resObj | resObj.cfnLogicalId())) {
    resSeq.add(resObj);
  }
  return resSeq;
}

operation AWSPSMCORE!AwsResource emitCfnResourceYaml(emitCtx : Map) : String {
  var outText = "  " + self.cfnLogicalId() + ":\n";
  outText = outText + "    Type: " + self.cfnTypeText(emitCtx) + "\n";
  outText = outText + self.emitCommonCfnAttributesYaml();
  var propText = self.emitCfnPropertiesYaml(emitCtx);
  if (not propText.trim().isEmpty()) {
    outText = outText + "    Properties:\n" + propText;
  }
  return outText;
}

operation AWSPSMCORE!AwsResource emitCommonCfnAttributesYaml() : String {
  var outText = "";
  if (self.conditionName.isPresent()) {
    outText = outText + "    Condition: " + self.conditionName + "\n";
  }
  if (self.dependsOn.notEmpty()) {
    if (self.dependsOn.size() = 1) {
      outText = outText + "    DependsOn: " + self.dependsOn.first().cfnLogicalId() + "\n";
    }
    else {
      outText = outText + "    DependsOn:\n";
      for (depObj in self.dependsOn.sortBy(depObj | depObj.cfnLogicalId())) {
        outText = outText + "      - " + depObj.cfnLogicalId() + "\n";
      }
    }
  }
  if (self.deletionPolicy.isDefined()) {
    outText = outText + "    DeletionPolicy: " + self.deletionPolicy.cfnPolicyName() + "\n";
  }
  if (self.updateReplacePolicy.isDefined()) {
    outText = outText + "    UpdateReplacePolicy: " + self.updateReplacePolicy.cfnPolicyName() + "\n";
  }
  if (self.metadata.notEmpty()) {
    outText = outText + "    Metadata:\n" + self.metadata.emitNativePropertiesYaml(6);
  }
  return outText;
}

operation AWSPSMCORE!AwsResource cfnTypeText(emitCtx : Map) : String {
  if (self.awsResourceType.isPresent()) {
    return self.awsResourceType;
  }
  return "Custom::" + self.eClass().getName();
}

operation AWSPSMCORE!AwsNativeResource cfnTypeText(emitCtx : Map) : String {
  if (self.samType.isPresent()) {
    return self.samType;
  }
  return self.cloudFormationType;
}

operation AWSPSMCORE!AwsResource emitCfnPropertiesYaml(emitCtx : Map) : String {
  return self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMCORE!AwsNativeResource emitCfnPropertiesYaml(emitCtx : Map) : String {
  return self.properties.emitNativePropertiesYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMCOMPUTE!AwsLambdaFunction cfnTypeText(emitCtx : Map) : String {
  return "AWS::Serverless::Function";
}

operation AWSPSMCOMPUTE!AwsLambdaFunction emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  outText = outText + emitYamlScalarProperty("FunctionName", firstText(self.functionName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("Description", firstText(self.descriptionText, self.resourceDescription), 6);
  if (self.role.isDefined()) {
    outText = outText + spaces(6) + "Role: " + arnForResource(self.role) + "\n";
  }
  if (self.code.isDefined()) {
    if (self.code.eClass().getName() = "LambdaImageCodeConfig") {
      outText = outText + spaces(6) + "PackageType: Image\n";
      outText = outText + emitYamlScalarProperty("ImageUri", self.code.imageUri, 6);
      if (self.code.imageConfig.isDefined()) {
        outText = outText + spaces(6) + "ImageConfig:\n";
        outText = outText + emitYamlStringListProperty("Command", self.code.imageConfig.command, 8);
        outText = outText + emitYamlStringListProperty("EntryPoint", self.code.imageConfig.entryPoint, 8);
        outText = outText + emitYamlScalarProperty("WorkingDirectory", self.code.imageConfig.workingDirectory, 8);
      }
    }
    else {
      outText = outText + emitYamlScalarProperty("Runtime", emitCtx.get("primaryLanguage").defaultRuntimeIdentifier(), 6);
      outText = outText + emitYamlScalarProperty("Handler", self.generatedHandlerName(emitCtx), 6);
      if (self.code.codeUri.isPresent()) {
        outText = outText + emitYamlScalarProperty("CodeUri", self.code.codeUri, 6);
      }
      else if (self.code.s3Bucket.isPresent() and self.code.s3Key.isPresent()) {
        outText = outText + spaces(6) + "CodeUri:\n";
        outText = outText + emitYamlScalarProperty("Bucket", self.code.s3Bucket, 8);
        outText = outText + emitYamlScalarProperty("Key", self.code.s3Key, 8);
        outText = outText + emitYamlScalarProperty("Version", self.code.s3ObjectVersion, 8);
      }
      else {
        outText = outText + emitYamlScalarProperty("CodeUri", self.generatedCodeUri(emitCtx), 6);
      }
      if (self.code.inlineZipFile.isPresent()) {
        outText = outText + yamlBlock("InlineCode", self.code.inlineZipFile, 6);
      }
    }
  }
  outText = outText + emitYamlIntegerProperty("MemorySize", self.memorySizeMb, 6);
  outText = outText + emitYamlIntegerProperty("Timeout", self.timeoutSeconds, 6);
  if (self.architecture.isDefined()) {
    outText = outText + spaces(6) + "Architectures:\n";
    outText = outText + spaces(8) + "- " + self.architecture.lambdaArchitectureText() + "\n";
  }
  if (self.ephemeralStorageMb.isDefined()) {
    outText = outText + spaces(6) + "EphemeralStorage:\n";
    outText = outText + spaces(8) + "Size: " + self.ephemeralStorageMb.asString() + "\n";
  }
  outText = outText + emitYamlIntegerProperty("ReservedConcurrentExecutions", self.reservedConcurrentExecutions, 6);
  if (self.kmsKey.isDefined()) {
    outText = outText + spaces(6) + "KmsKeyArn: " + arnForResource(self.kmsKey) + "\n";
  }
  if (self.environment.notEmpty()) {
    outText = outText + spaces(6) + "Environment:\n";
    outText = outText + spaces(8) + "Variables:\n";
    for (envObj in self.environment.sortBy(envObj | envObj.variableName)) {
      outText = outText + spaces(10) + envObj.variableName + ": " + envObj.value.cfnInlineYaml() + "\n";
    }
  }
  if (self.deadLetterConfig.isDefined()) {
    outText = outText + spaces(6) + "DeadLetterQueue:\n";
    if (self.deadLetterConfig.targetQueue.isDefined()) {
      outText = outText + spaces(8) + "Type: SQS\n";
      outText = outText + spaces(8) + "TargetArn: " + arnForResource(self.deadLetterConfig.targetQueue) + "\n";
    }
    else if (self.deadLetterConfig.targetTopic.isDefined()) {
      outText = outText + spaces(8) + "Type: SNS\n";
      outText = outText + spaces(8) + "TargetArn: " + arnForResource(self.deadLetterConfig.targetTopic) + "\n";
    }
  }
  if (self.tracing.isDefined() and self.tracing.mode.lambdaTracingModeText().isPresent()) {
    outText = outText + spaces(6) + "Tracing: " + self.tracing.mode.lambdaTracingModeText() + "\n";
  }
  if (self.logging.isDefined()) {
    outText = outText + spaces(6) + "LoggingConfig:\n";
    outText = outText + emitYamlScalarProperty("ApplicationLogLevel", self.logging.applicationLogLevel, 8);
    outText = outText + emitYamlScalarProperty("SystemLogLevel", self.logging.systemLogLevel, 8);
    outText = outText + emitYamlScalarProperty("LogFormat", self.logging.logFormat, 8);
    outText = outText + emitYamlScalarProperty("LogGroup", self.logging.logGroupName, 8);
  }
  if (self.vpcConfig.isDefined()) {
    outText = outText + spaces(6) + "VpcConfig:\n";
    outText = outText + emitYamlStringListProperty("SubnetIds", self.vpcConfig.subnetIds, 8);
    if (self.vpcConfig.securityGroupIds.notEmpty()) {
      outText = outText + emitYamlStringListProperty("SecurityGroupIds", self.vpcConfig.securityGroupIds, 8);
    }
    else if (self.vpcConfig.securityGroups.notEmpty()) {
      outText = outText + spaces(8) + "SecurityGroupIds:\n";
      for (sgObj in self.vpcConfig.securityGroups.sortBy(sgObj | sgObj.cfnLogicalId())) {
        outText = outText + spaces(10) + "- !Ref " + sgObj.cfnLogicalId() + "\n";
      }
    }
    if (self.vpcConfig.ipv6AllowedForDualStack.isDefined()) {
      outText = outText + emitYamlBooleanProperty("Ipv6AllowedForDualStack", self.vpcConfig.ipv6AllowedForDualStack, 8);
    }
  }
  if (self.fileSystemConfigs.notEmpty()) {
    outText = outText + spaces(6) + "FileSystemConfigs:\n";
    for (fsObj in self.fileSystemConfigs) {
      outText = outText + spaces(8) + "- Arn: " + fsObj.arn.yamlScalar() + "\n";
      outText = outText + spaces(10) + "LocalMountPath: " + fsObj.localMountPath.yamlScalar() + "\n";
    }
  }
  if (self.layers.notEmpty()) {
    outText = outText + spaces(6) + "Layers:\n";
    for (layerObj in self.layers.sortBy(layerObj | layerObj.cfnLogicalId())) {
      outText = outText + spaces(8) + "- !Ref " + layerObj.cfnLogicalId() + "\n";
    }
  }
  if (self.samEvents.notEmpty()) {
    outText = outText + spaces(6) + "Events:\n";
    for (evtObj in self.samEvents.sortBy(evtObj | evtObj.eventName)) {
      outText = outText + spaces(8) + evtObj.eventName.toCfnLogicalId() + ":\n";
      outText = outText + emitYamlScalarProperty("Type", evtObj.eventType, 10);
      if (evtObj.properties.notEmpty()) {
        outText = outText + spaces(10) + "Properties:\n" + evtObj.properties.emitNativePropertiesYaml(12);
      }
    }
  }
  if (self.autoPublishAlias.isPresent()) {
    outText = outText + emitYamlScalarProperty("AutoPublishAlias", self.autoPublishAlias, 6);
  }
  if (self.snapStartApplyOn.isDefined() and self.snapStartApplyOn.asString() <> "NONE") {
    outText = outText + spaces(6) + "SnapStart:\n";
    outText = outText + spaces(8) + "ApplyOn: " + self.snapStartApplyOn.asString().replace("_", "").yamlScalar() + "\n";
  }
  outText = outText + self.tags.emitTagsYaml(6);
  outText = outText + self.overrides.emitNativePropertiesYaml(6);
  return outText;
}

operation Any defaultRuntimeIdentifier() : String {
  return "provided.al2023";
}

operation AWSPSMCOMPUTE!LambdaEventSourceMapping cfnTypeText(emitCtx : Map) : String {
  return "AWS::Lambda::EventSourceMapping";
}

operation AWSPSMCOMPUTE!LambdaEventSourceMapping emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  outText = outText + spaces(6) + "FunctionName: !Ref " + self.modelFeatureValue("function").cfnLogicalId() + "\n";
  outText = outText + emitYamlIntegerProperty("BatchSize", self.batchSize, 6);
  outText = outText + emitYamlIntegerProperty("MaximumBatchingWindowInSeconds", self.maximumBatchingWindowSeconds, 6);
  if (self.startingPosition.isDefined()) {
    outText = outText + emitYamlScalarProperty("StartingPosition", self.startingPosition.asString(), 6);
  }
  outText = outText + emitYamlScalarProperty("StartingPositionTimestamp", self.startingPositionTimestamp, 6);
  outText = outText + emitYamlBooleanProperty("BisectBatchOnFunctionError", self.bisectBatchOnFunctionError, 6);
  outText = outText + emitYamlIntegerProperty("MaximumRecordAgeInSeconds", self.maximumRecordAgeInSeconds, 6);
  outText = outText + emitYamlIntegerProperty("MaximumRetryAttempts", self.maximumRetryAttempts, 6);
  outText = outText + emitYamlIntegerProperty("ParallelizationFactor", self.parallelizationFactor, 6);
  outText = outText + emitYamlIntegerProperty("TumblingWindowInSeconds", self.tumblingWindowInSeconds, 6);
  outText = outText + emitYamlStringListProperty("FunctionResponseTypes", self.functionResponseTypes, 6);
  if (self.reportBatchItemFailures = true and self.functionResponseTypes.isEmpty()) {
    outText = outText + spaces(6) + "FunctionResponseTypes:\n";
    outText = outText + spaces(8) + "- ReportBatchItemFailures\n";
  }
  if (self.filterCriteriaJson.isPresent()) {
    outText = outText + yamlBlock("FilterCriteria", self.filterCriteriaJson, 6);
  }
  if (self.maximumConcurrency.isDefined()) {
    outText = outText + spaces(6) + "ScalingConfig:\n";
    outText = outText + spaces(8) + "MaximumConcurrency: " + self.maximumConcurrency.asString() + "\n";
  }
  outText = outText + self.emitEventSourceArnYaml();
  outText = outText + self.tags.emitTagsYaml(6);
  outText = outText + self.overrides.emitNativePropertiesYaml(6);
  return outText;
}

operation AWSPSMCOMPUTE!LambdaEventSourceMapping emitEventSourceArnYaml() : String {
  return "";
}

operation AWSPSMCOMPUTE!SqsLambdaEventSourceMapping emitEventSourceArnYaml() : String {
  return spaces(6) + "EventSourceArn: " + arnForResource(self.queue) + "\n";
}

operation AWSPSMCOMPUTE!DynamoDbStreamLambdaEventSourceMapping emitEventSourceArnYaml() : String {
  return spaces(6) + "EventSourceArn: !GetAtt " + self.table.cfnLogicalId() + ".StreamArn\n";
}

operation AWSPSMCOMPUTE!GenericLambdaEventSourceMapping emitEventSourceArnYaml() : String {
  if (self.eventSourceResource.isDefined()) {
    return spaces(6) + "EventSourceArn: " + arnForResource(self.eventSourceResource) + "\n";
  }
  return emitYamlScalarProperty("EventSourceArn", self.sourceArnExpression, 6);
}

operation AWSPSMCOMPUTE!LambdaPermission cfnTypeText(emitCtx : Map) : String {
  return "AWS::Lambda::Permission";
}

operation AWSPSMCOMPUTE!LambdaPermission emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  outText = outText + spaces(6) + "FunctionName: !Ref " + self.modelFeatureValue("function").cfnLogicalId() + "\n";
  outText = outText + emitYamlScalarProperty("Action", self.action, 6);
  outText = outText + emitYamlScalarProperty("Principal", self.principal, 6);
  outText = outText + emitYamlScalarProperty("SourceArn", self.sourceArn, 6);
  outText = outText + emitYamlScalarProperty("SourceAccount", self.sourceAccount, 6);
  outText = outText + emitYamlScalarProperty("FunctionUrlAuthType", self.functionUrlAuthType, 6);
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMCOMPUTE!LambdaLayerVersion cfnTypeText(emitCtx : Map) : String {
  return "AWS::Serverless::LayerVersion";
}

operation AWSPSMCOMPUTE!LambdaLayerVersion emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  outText = outText + emitYamlScalarProperty("LayerName", firstText(self.layerName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("ContentUri", self.contentUri, 6);
  outText = outText + emitYamlStringListProperty("CompatibleRuntimes", self.compatibleRuntimes, 6);
  if (self.compatibleArchitectures.notEmpty()) {
    outText = outText + spaces(6) + "CompatibleArchitectures:\n";
    for (archObj in self.compatibleArchitectures) {
      outText = outText + spaces(8) + "- " + archObj.lambdaArchitectureText() + "\n";
    }
  }
  outText = outText + emitYamlScalarProperty("LicenseInfo", self.licenseInfo, 6);
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMCOMPUTE!LambdaLayerPermission cfnTypeText(emitCtx : Map) : String {
  return "AWS::Lambda::LayerVersionPermission";
}

operation AWSPSMCOMPUTE!LambdaLayerPermission emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = spaces(6) + "LayerVersionArn: !Ref " + self.layerVersion.cfnLogicalId() + "\n";
  outText = outText + emitYamlScalarProperty("Action", self.action.orElseText("lambda:GetLayerVersion"), 6);
  outText = outText + emitYamlScalarProperty("Principal", self.principal, 6);
  outText = outText + emitYamlScalarProperty("OrganizationId", self.organizationId, 6);
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMCOMPUTE!LambdaFunctionUrl cfnTypeText(emitCtx : Map) : String {
  return "AWS::Lambda::Url";
}

operation AWSPSMCOMPUTE!LambdaFunctionUrl emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  outText = outText + spaces(6) + "TargetFunctionArn: " + arnForResource(self.modelFeatureValue("function")) + "\n";
  outText = outText + emitYamlScalarProperty("AuthType", self.authType.asString(), 6);
  if (self.invokeMode.isDefined()) {
    outText = outText + emitYamlScalarProperty("InvokeMode", self.invokeMode.asString(), 6);
  }
  if (self.cors.isDefined()) {
    outText = outText + spaces(6) + "Cors:\n" + self.cors.emitCorsYaml(8);
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMCOMPUTE!LambdaVersion cfnTypeText(emitCtx : Map) : String {
  return "AWS::Lambda::Version";
}

operation AWSPSMCOMPUTE!LambdaVersion emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = spaces(6) + "FunctionName: !Ref " + self.modelFeatureValue("function").cfnLogicalId() + "\n";
  outText = outText + emitYamlScalarProperty("Description", self.versionDescription, 6);
  if (self.provisionedConcurrencyConfig.isDefined()) {
    outText = outText + spaces(6) + "ProvisionedConcurrencyConfig:\n";
    outText = outText + spaces(8) + "ProvisionedConcurrentExecutions: " + self.provisionedConcurrencyConfig.provisionedConcurrentExecutions.asString() + "\n";
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMCOMPUTE!LambdaAlias cfnTypeText(emitCtx : Map) : String {
  return "AWS::Lambda::Alias";
}

operation AWSPSMCOMPUTE!LambdaAlias emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = spaces(6) + "FunctionName: !Ref " + self.modelFeatureValue("function").cfnLogicalId() + "\n";
  outText = outText + emitYamlScalarProperty("Name", self.aliasName, 6);
  if (self.version.isDefined()) {
    outText = outText + spaces(6) + "FunctionVersion: !GetAtt " + self.version.cfnLogicalId() + ".Version\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("FunctionVersion", self.functionVersion, 6);
  }
  if (self.routingConfig.isPresent()) {
    outText = outText + yamlBlock("RoutingConfig", self.routingConfig, 6);
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMCOMPUTE!LambdaEventInvokeConfig cfnTypeText(emitCtx : Map) : String {
  return "AWS::Lambda::EventInvokeConfig";
}

operation AWSPSMCOMPUTE!LambdaEventInvokeConfig emitCfnPropertiesYaml(emitCtx : Map) : String {
  var lambdaObj = self.modelFeatureValue("function");
  var outText = spaces(6) + "FunctionName: !Ref " + lambdaObj.cfnLogicalId() + "\n";
  if (self.qualifierAlias.isDefined()) {
    outText = outText + spaces(6) + "Qualifier: !Ref " + self.qualifierAlias.cfnLogicalId() + "\n";
  }
  else if (lambdaObj.autoPublishAlias.isPresent()) {
    outText = outText + emitYamlScalarProperty("Qualifier", lambdaObj.autoPublishAlias, 6);
  }
  else {
    outText = outText + spaces(6) + "Qualifier: $LATEST\n";
  }
  outText = outText + emitYamlIntegerProperty("MaximumRetryAttempts", self.maximumRetryAttempts, 6);
  outText = outText + emitYamlIntegerProperty("MaximumEventAgeInSeconds", self.maximumEventAgeInSeconds, 6);
  if (self.destinationConfig.isDefined()) {
    outText = outText + spaces(6) + "DestinationConfig:\n";
    if (self.destinationConfig.onSuccess.isDefined()) {
      outText = outText + spaces(8) + "OnSuccess:\n";
      outText = outText + spaces(10) + "Destination: " + arnForResource(self.destinationConfig.onSuccess) + "\n";
    }
    if (self.destinationConfig.onFailure.isDefined()) {
      outText = outText + spaces(8) + "OnFailure:\n";
      outText = outText + spaces(10) + "Destination: " + arnForResource(self.destinationConfig.onFailure) + "\n";
    }
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMSECURITY!IamRole cfnTypeText(emitCtx : Map) : String {
  return "AWS::IAM::Role";
}

operation AWSPSMSECURITY!IamRole emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  outText = outText + emitYamlScalarProperty("RoleName", firstText(self.roleName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("Path", self.path, 6);
  outText = outText + "      AssumeRolePolicyDocument:\n" + self.assumeRolePolicy.emitIamPolicyDocumentYaml(8);
  outText = outText + emitYamlScalarProperty("PermissionsBoundary", self.permissionsBoundaryArn, 6);
  outText = outText + emitYamlIntegerProperty("MaxSessionDuration", self.maxSessionDuration, 6);
  outText = outText + emitYamlScalarProperty("Description", self.descriptionText, 6);
  outText = outText + emitYamlStringListProperty("ManagedPolicyArns", self.managedPolicyArns, 6);
  if (self.managedPolicies.notEmpty()) {
    outText = outText + spaces(6) + "ManagedPolicyArns:\n";
    for (polObj in self.managedPolicies.sortBy(polObj | polObj.cfnLogicalId())) {
      outText = outText + spaces(8) + "- !Ref " + polObj.cfnLogicalId() + "\n";
    }
  }
  if (self.inlinePolicies.notEmpty()) {
    outText = outText + spaces(6) + "Policies:\n";
    for (policyObj in self.inlinePolicies.sortBy(policyObj | policyObj.policyName)) {
      outText = outText + spaces(8) + "- PolicyName: " + policyObj.policyName.yamlScalar() + "\n";
      outText = outText + spaces(10) + "PolicyDocument:\n" + policyObj.document.emitIamPolicyDocumentYaml(12);
    }
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMSECURITY!IamManagedPolicy cfnTypeText(emitCtx : Map) : String {
  return "AWS::IAM::ManagedPolicy";
}

operation AWSPSMSECURITY!IamManagedPolicy emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("ManagedPolicyName", firstText(self.managedPolicyName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("Path", self.path, 6);
  if (self.rawPolicyJson.isPresent()) {
    outText = outText + yamlBlock("PolicyDocument", self.rawPolicyJson, 6);
  }
  else {
    outText = outText + "      PolicyDocument:\n" + self.document.emitIamPolicyDocumentYaml(8);
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMSECURITY!IamPolicy cfnTypeText(emitCtx : Map) : String {
  return "AWS::IAM::Policy";
}

operation AWSPSMSECURITY!IamPolicy emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("PolicyName", self.policyName, 6);
  if (self.rawPolicyJson.isPresent()) {
    outText = outText + yamlBlock("PolicyDocument", self.rawPolicyJson, 6);
  }
  else {
    outText = outText + "      PolicyDocument:\n" + self.document.emitIamPolicyDocumentYaml(8);
  }
  if (self.roles.notEmpty()) {
    outText = outText + spaces(6) + "Roles:\n";
    for (roleObj in self.roles.sortBy(roleObj | roleObj.cfnLogicalId())) {
      outText = outText + spaces(8) + "- !Ref " + roleObj.cfnLogicalId() + "\n";
    }
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

