operation AWSPSMNETWORKING!SecurityGroup emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("GroupDescription", self.groupDescription, 6);
  if (self.vpc.isDefined()) {
    outText = outText + spaces(6) + "VpcId: !Ref " + self.vpc.cfnLogicalId() + "\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("VpcId", self.vpcId, 6);
  }
  outText = outText + self.ingressRules.emitSecurityGroupRulesYaml("SecurityGroupIngress", 6);
  outText = outText + self.egressRules.emitSecurityGroupRulesYaml("SecurityGroupEgress", 6);
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation Collection emitSecurityGroupRulesYaml(nameText : String, indentCount : Integer) : String {
  if (self.isEmpty()) {
    return "";
  }
  var outText = spaces(indentCount) + nameText + ":\n";
  for (sgRuleObj in self) {
    outText = outText + spaces(indentCount + 2) + "- IpProtocol: " + sgRuleObj.ipProtocol.orElseText("-1").yamlScalar() + "\n";
    outText = outText + emitYamlIntegerProperty("FromPort", sgRuleObj.fromPort, indentCount + 4);
    outText = outText + emitYamlIntegerProperty("ToPort", sgRuleObj.toPort, indentCount + 4);
    outText = outText + emitYamlScalarProperty("CidrIp", sgRuleObj.cidrIp, indentCount + 4);
    outText = outText + emitYamlScalarProperty("CidrIpv6", sgRuleObj.cidrIpv6, indentCount + 4);
    outText = outText + emitYamlScalarProperty("Description", sgRuleObj.ruleDescription, indentCount + 4);
    if (sgRuleObj.sourceSecurityGroup.isDefined()) {
      outText = outText + spaces(indentCount + 4) + "SourceSecurityGroupId: !Ref " + sgRuleObj.sourceSecurityGroup.cfnLogicalId() + "\n";
    }
  }
  return outText;
}

