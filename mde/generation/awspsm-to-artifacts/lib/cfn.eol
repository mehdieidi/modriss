  outText = outText + emitYamlScalarProperty("Description", self.descriptionText, 6);
  if (self.value.isPresent()) {
    outText = outText + "# API key value intentionally not emitted. Use Secrets Manager or a deployment-time parameter.\n";
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMAPI!ApiGatewayUsagePlan cfnTypeText(emitCtx : Map) : String {
  return "AWS::ApiGateway::UsagePlan";
}

operation AWSPSMAPI!ApiGatewayUsagePlan emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("UsagePlanName", firstText(self.usagePlanName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("Description", self.descriptionText, 6);
  if (self.apiStages.notEmpty()) {
    outText = outText + spaces(6) + "ApiStages:\n";
    for (stageObj in self.apiStages) {
      outText = outText + spaces(8) + "- ApiId: !Ref " + stageObj.api.cfnLogicalId() + "\n";
      outText = outText + spaces(10) + "Stage: " + stageObj.stageName.yamlScalar() + "\n";
    }
  }
  if (self.throttleBurstLimit.isDefined() or self.throttleRateLimit.isDefined()) {
    outText = outText + spaces(6) + "Throttle:\n";
    outText = outText + emitYamlIntegerProperty("BurstLimit", self.throttleBurstLimit, 8);
    outText = outText + emitYamlIntegerProperty("RateLimit", self.throttleRateLimit, 8);
  }
  if (self.quotaLimit.isDefined()) {
    outText = outText + spaces(6) + "Quota:\n";
    outText = outText + emitYamlIntegerProperty("Limit", self.quotaLimit, 8);
    outText = outText + emitYamlScalarProperty("Period", self.quotaPeriod, 8);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

