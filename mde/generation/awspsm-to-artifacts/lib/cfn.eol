operation AWSPSMSECURITY!SecretsManagerResourcePolicy emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = spaces(6) + "SecretId: !Ref " + self.secret.cfnLogicalId() + "\n";
  if (self.resourcePolicyJson.isPresent()) {
    outText = outText + yamlBlock("ResourcePolicy", self.resourcePolicyJson, 6);
  }
  else if (self.resourcePolicy.isDefined()) {
    outText = outText + "      ResourcePolicy:\n" + self.resourcePolicy.emitIamPolicyDocumentYaml(8);
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMSECURITY!SsmParameter cfnTypeText(emitCtx : Map) : String {
  return "AWS::SSM::Parameter";
}

operation AWSPSMSECURITY!SsmParameter emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("Name", self.parameterName, 6);
  outText = outText + emitYamlScalarProperty("Type", self.parameterType.asString().replace("_", ""), 6);
  if (self.value.isDefined()) {
    outText = outText + self.value.emitCfnValueProperty("Value", 6);
  }
  outText = outText + emitYamlScalarProperty("Description", self.descriptionText, 6);
  outText = outText + emitYamlScalarProperty("AllowedPattern", self.allowedPattern, 6);
  if (self.tier.isDefined()) {
    outText = outText + emitYamlScalarProperty("Tier", self.tier.asString().replace("_", "-"), 6);
  }
  outText = outText + emitYamlScalarProperty("DataType", self.dataType, 6);
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMMESSAGING!SqsQueue cfnTypeText(emitCtx : Map) : String {
  return "AWS::SQS::Queue";
}

operation AWSPSMMESSAGING!SqsQueue emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = "";
  outText = outText + emitYamlScalarProperty("QueueName", firstText(self.queueName, self.physicalName), 6);
  if (self.queueType.asString() = "FIFO") {
    outText = outText + "      FifoQueue: true\n";
  }
  outText = outText + emitYamlBooleanProperty("ContentBasedDeduplication", self.contentBasedDeduplication, 6);
  outText = outText + emitYamlScalarProperty("DeduplicationScope", self.deduplicationScope, 6);
  outText = outText + emitYamlScalarProperty("FifoThroughputLimit", self.fifoThroughputLimit, 6);
  outText = outText + emitYamlIntegerProperty("DelaySeconds", self.delaySeconds, 6);
  outText = outText + emitYamlIntegerProperty("MaximumMessageSize", self.maximumMessageSize, 6);
  outText = outText + emitYamlIntegerProperty("MessageRetentionPeriod", self.messageRetentionPeriodSeconds, 6);
  outText = outText + emitYamlIntegerProperty("ReceiveMessageWaitTimeSeconds", self.receiveMessageWaitTimeSeconds, 6);
  outText = outText + emitYamlIntegerProperty("VisibilityTimeout", self.visibilityTimeoutSeconds, 6);
  outText = outText + emitYamlIntegerProperty("KmsDataKeyReusePeriodSeconds", self.kmsDataKeyReusePeriodSeconds, 6);
  outText = outText + emitYamlBooleanProperty("SqsManagedSseEnabled", self.sqsManagedSseEnabled, 6);
  if (self.kmsKey.isDefined()) {
    outText = outText + spaces(6) + "KmsMasterKeyId: !Ref " + self.kmsKey.cfnLogicalId() + "\n";
  }
  if (self.redrivePolicy.isDefined()) {
    outText = outText + spaces(6) + "RedrivePolicy:\n";
    outText = outText + spaces(8) + "deadLetterTargetArn: " + arnForResource(self.redrivePolicy.deadLetterQueue) + "\n";
    outText = outText + spaces(8) + "maxReceiveCount: " + self.redrivePolicy.maxReceiveCount.asString() + "\n";
  }
  if (self.redriveAllowPolicy.isDefined()) {
    outText = outText + spaces(6) + "RedriveAllowPolicy:\n";
    outText = outText + emitYamlScalarProperty("redrivePermission", self.redriveAllowPolicy.redrivePermission, 8);
    if (self.redriveAllowPolicy.sourceQueues.notEmpty()) {
      outText = outText + spaces(8) + "sourceQueueArns:\n";
      for (qObj in self.redriveAllowPolicy.sourceQueues) {
        outText = outText + spaces(10) + "- " + arnForResource(qObj) + "\n";
      }
    }
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMMESSAGING!SqsQueuePolicy cfnTypeText(emitCtx : Map) : String {
  return "AWS::SQS::QueuePolicy";
}

operation AWSPSMMESSAGING!SqsQueuePolicy emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = spaces(6) + "Queues:\n";
  for (queueObj in self.queues.sortBy(queueObj | queueObj.cfnLogicalId())) {
    outText = outText + spaces(8) + "- !Ref " + queueObj.cfnLogicalId() + "\n";
  }
  if (self.policyDocumentJson.isPresent()) {
    outText = outText + yamlBlock("PolicyDocument", self.policyDocumentJson, 6);
  }
  else if (self.policyDocument.isDefined()) {
    outText = outText + "      PolicyDocument:\n" + self.policyDocument.emitIamPolicyDocumentYaml(8);
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMMESSAGING!SnsTopic cfnTypeText(emitCtx : Map) : String {
  return "AWS::SNS::Topic";
}

operation AWSPSMMESSAGING!SnsTopic emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("TopicName", firstText(self.topicName, self.physicalName), 6);
  outText = outText + emitYamlBooleanProperty("FifoTopic", self.fifoTopic, 6);
  outText = outText + emitYamlBooleanProperty("ContentBasedDeduplication", self.contentBasedDeduplication, 6);
  outText = outText + emitYamlScalarProperty("DisplayName", self.displayName, 6);
  if (self.kmsKey.isDefined()) {
    outText = outText + spaces(6) + "KmsMasterKeyId: !Ref " + self.kmsKey.cfnLogicalId() + "\n";
  }
  if (self.dataProtectionPolicyJson.isPresent()) {
    outText = outText + yamlBlock("DataProtectionPolicy", self.dataProtectionPolicyJson, 6);
  }
  if (self.deliveryStatusLoggingJson.isPresent()) {
    outText = outText + yamlBlock("DeliveryStatusLogging", self.deliveryStatusLoggingJson, 6);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMMESSAGING!SnsSubscription cfnTypeText(emitCtx : Map) : String {
  return "AWS::SNS::Subscription";
}

operation AWSPSMMESSAGING!SnsSubscription emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = spaces(6) + "TopicArn: !Ref " + self.topic.cfnLogicalId() + "\n";
  outText = outText + emitYamlScalarProperty("Protocol", self.protocol.snsProtocolText(), 6);
  if (self.endpointResource.isDefined()) {
    outText = outText + spaces(6) + "Endpoint: " + arnForResource(self.endpointResource) + "\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("Endpoint", self.endpoint, 6);
  }
  outText = outText + emitYamlBooleanProperty("RawMessageDelivery", self.rawMessageDelivery, 6);
  if (self.filterRules.notEmpty()) {
    outText = outText + spaces(6) + "FilterPolicy:\n";
    for (filterObj in self.filterRules.sortBy(filterObj | filterObj.fieldPath)) {
      outText = outText + spaces(8) + filterObj.fieldPath + ":\n";
      for (valText in filterObj.values) {
        outText = outText + spaces(10) + "- " + valText.yamlScalar() + "\n";
      }
    }
  }
  if (self.filterPolicyScope.isDefined()) {
    outText = outText + emitYamlScalarProperty("FilterPolicyScope", self.filterPolicyScope.asString().replace("_", ""), 6);
  }
  if (self.deliveryPolicyJson.isPresent()) {
    outText = outText + yamlBlock("DeliveryPolicy", self.deliveryPolicyJson, 6);
  }
  if (self.replayPolicyJson.isPresent()) {
    outText = outText + yamlBlock("ReplayPolicy", self.replayPolicyJson, 6);
  }
  if (self.deadLetterQueue.isDefined()) {
    outText = outText + spaces(6) + "RedrivePolicy:\n";
    outText = outText + spaces(8) + "deadLetterTargetArn: " + arnForResource(self.deadLetterQueue) + "\n";
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMMESSAGING!SnsTopicPolicy cfnTypeText(emitCtx : Map) : String {
  return "AWS::SNS::TopicPolicy";
}

operation AWSPSMMESSAGING!SnsTopicPolicy emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = spaces(6) + "Topics:\n";
  for (topicObj in self.topics.sortBy(topicObj | topicObj.cfnLogicalId())) {
    outText = outText + spaces(8) + "- !Ref " + topicObj.cfnLogicalId() + "\n";
  }
  if (self.policyDocumentJson.isPresent()) {
    outText = outText + yamlBlock("PolicyDocument", self.policyDocumentJson, 6);
  }
  else if (self.policyDocument.isDefined()) {
    outText = outText + "      PolicyDocument:\n" + self.policyDocument.emitIamPolicyDocumentYaml(8);
