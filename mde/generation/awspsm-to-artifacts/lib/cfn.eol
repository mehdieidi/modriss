  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMEVENTS!EventBridgeBusPolicy cfnTypeText(emitCtx : Map) : String {
  return "AWS::Events::EventBusPolicy";
}

operation AWSPSMEVENTS!EventBridgeBusPolicy emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("StatementId", self.statementId, 6);
  outText = outText + spaces(6) + "EventBusName: !Ref " + self.bus.cfnLogicalId() + "\n";
  if (self.policyJson.isPresent()) {
    outText = outText + yamlBlock("Statement", self.policyJson, 6);
  }
  else if (self.policyDocument.isDefined() and self.policyDocument.statements.notEmpty()) {
    outText = outText + spaces(6) + "Statement:\n" + self.policyDocument.statements.first().emitIamStatementYaml(8);
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMEVENTS!EventBridgeRule cfnTypeText(emitCtx : Map) : String {
  return "AWS::Events::Rule";
}

operation AWSPSMEVENTS!EventBridgeRule emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("Name", firstText(self.ruleName, self.physicalName), 6);
  outText = outText + emitYamlScalarProperty("Description", self.descriptionText, 6);
  if (self.bus.isDefined()) {
    outText = outText + spaces(6) + "EventBusName: !Ref " + self.bus.cfnLogicalId() + "\n";
  }
  outText = outText + emitYamlScalarProperty("ScheduleExpression", self.scheduleExpression, 6);
  outText = outText + emitYamlScalarProperty("State", self.state, 6);
  if (self.eventPatternJson.isPresent()) {
    outText = outText + yamlBlock("EventPattern", self.eventPatternJson, 6);
  }
  else if (self.eventPattern.isDefined()) {
    outText = outText + spaces(6) + "EventPattern:\n" + self.eventPattern.emitEventPatternYaml(8);
  }
  if (self.targets.notEmpty()) {
    outText = outText + spaces(6) + "Targets:\n";
    for (targetObj in self.targets.sortBy(targetObj | targetObj.targetId)) {
      outText = outText + targetObj.emitEventBridgeTargetYaml(8);
    }
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMEVENTS!EventPattern emitEventPatternYaml(indentCount : Integer) : String {
  var outText = "";
  outText = outText + emitYamlStringListProperty("source", self.sources, indentCount);
  outText = outText + emitYamlStringListProperty("detail-type", self.detailTypes, indentCount);
  outText = outText + emitYamlScalarProperty("account", self.account, indentCount);
  outText = outText + emitYamlScalarProperty("region", self.region, indentCount);
  if (self.detailJson.isPresent()) {
    outText = outText + yamlBlock("detail", self.detailJson, indentCount);
  }
  return outText;
}

operation AWSPSMEVENTS!EventBridgeTarget emitEventBridgeTargetYaml(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "- Id: " + self.targetId.yamlScalar() + "\n";
  if (self.targetResource.isDefined()) {
    outText = outText + spaces(indentCount + 2) + "Arn: " + arnForResource(self.targetResource) + "\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("Arn", self.arnExpression, indentCount + 2);
  }
  if (self.role.isDefined()) {
    outText = outText + spaces(indentCount + 2) + "RoleArn: " + arnForResource(self.role) + "\n";
  }
  else {
    outText = outText + emitYamlScalarProperty("RoleArn", self.roleArn, indentCount + 2);
  }
  if (self.input.isDefined()) {
    outText = outText + self.input.emitCfnValueProperty("Input", indentCount + 2);
  }
  outText = outText + emitYamlScalarProperty("InputPath", self.inputPath, indentCount + 2);
  if (self.retryPolicy.isDefined()) {
    outText = outText + spaces(indentCount + 2) + "RetryPolicy:\n";
    outText = outText + emitYamlIntegerProperty("MaximumRetryAttempts", self.retryPolicy.maximumRetryAttempts, indentCount + 4);
    outText = outText + emitYamlIntegerProperty("MaximumEventAgeInSeconds", self.retryPolicy.maximumEventAgeInSeconds, indentCount + 4);
  }
  if (self.deadLetterQueue.isDefined()) {
    outText = outText + spaces(indentCount + 2) + "DeadLetterConfig:\n";
    outText = outText + spaces(indentCount + 4) + "Arn: " + arnForResource(self.deadLetterQueue) + "\n";
  }
  if (self.inputTransformer.isDefined()) {
    outText = outText + spaces(indentCount + 2) + "InputTransformer:\n";
    if (self.inputTransformer.inputPathsMapJson.isPresent()) {
      outText = outText + yamlBlock("InputPathsMap", self.inputTransformer.inputPathsMapJson, indentCount + 4);
    }
    outText = outText + emitYamlScalarProperty("InputTemplate", self.inputTransformer.inputTemplate, indentCount + 4);
  }
  if (self.parameters.isDefined() and self.parameters.eClass().getName() = "EventBridgeSqsTargetParameters") {
    outText = outText + spaces(indentCount + 2) + "SqsParameters:\n";
    outText = outText + emitYamlScalarProperty("MessageGroupId", self.parameters.messageGroupId, indentCount + 4);
  }
  return outText;
}

