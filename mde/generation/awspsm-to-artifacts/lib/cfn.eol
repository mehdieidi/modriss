  outText = outText + emitYamlIntegerProperty("InvocationRateLimitPerSecond", self.invocationRateLimitPerSecond, 6);
  outText = outText + spaces(6) + "ConnectionArn: " + arnForResource(self.connection) + "\n";
  return outText + self.overrides.emitNativePropertiesYaml(6);
