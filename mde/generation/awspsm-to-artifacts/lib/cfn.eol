  if (self.rotationLambda.isDefined()) {
    outText = outText + spaces(6) + "RotationLambdaARN: " + arnForResource(self.rotationLambda) + "\n";
  }
  if (self.rotationRulesJson.isPresent()) {
    outText = outText + yamlBlock("RotationRules", self.rotationRulesJson, 6);
  }
  return outText + self.overrides.emitNativePropertiesYaml(6);
