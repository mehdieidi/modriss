operation AWSPSMWORKFLOW!StepFunctionStateMachine cfnTypeText(emitCtx : Map) : String {
  return "AWS::Serverless::StateMachine";
}

operation AWSPSMWORKFLOW!StepFunctionStateMachine emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("Name", firstText(self.stateMachineName, self.physicalName), 6);
  outText = outText + spaces(6) + "Role: " + arnForResource(self.role) + "\n";
  if (self.definitionUri.isPresent()) {
    outText = outText + emitYamlScalarProperty("DefinitionUri", self.definitionUri, 6);
  }
  else if (self.aslDocument.isDefined()) {
    outText = outText + emitYamlScalarProperty("DefinitionUri", self.aslPath(), 6);
  }
  else if (self.definitionString.isPresent()) {
    outText = outText + yamlBlock("Definition", self.definitionString, 6);
  }
  if (self.definitionSubstitutionsJson.isPresent()) {
    outText = outText + yamlBlock("DefinitionSubstitutions", self.definitionSubstitutionsJson, 6);
  }
  if (self.stateMachineType.isDefined()) {
    outText = outText + emitYamlScalarProperty("Type", self.stateMachineType.asString(), 6);
  }
  if (self.publishAlias = true and self.aliasName.isPresent()) {
    outText = outText + spaces(6) + "AutoPublishAlias: " + self.aliasName.yamlScalar() + "\n";
  }
  if (self.logging.isDefined()) {
    outText = outText + spaces(6) + "Logging:\n";
    outText = outText + emitYamlBooleanProperty("IncludeExecutionData", self.logging.includeExecutionData, 8);
    outText = outText + emitYamlScalarProperty("Level", self.logging.level, 8);
    outText = outText + spaces(8) + "Destinations:\n";
    outText = outText + spaces(10) + "- CloudWatchLogsLogGroup:\n";
    outText = outText + spaces(12) + "LogGroupArn: " + arnForResource(self.logging.logGroup) + "\n";
  }
  if (self.tracing.isDefined()) {
    outText = outText + spaces(6) + "Tracing:\n";
    outText = outText + emitYamlBooleanProperty("Enabled", self.tracing.enabled, 8);
  }
  if (self.samEvents.notEmpty()) {
    outText = outText + spaces(6) + "Events:\n";
    for (evtObj in self.samEvents.sortBy(evtObj | evtObj.eventName)) {
      outText = outText + spaces(8) + evtObj.eventName.toCfnLogicalId() + ":\n";
      outText = outText + emitYamlScalarProperty("Type", evtObj.eventType, 10);
      if (evtObj.properties.notEmpty()) {
        outText = outText + spaces(10) + "Properties:\n" + evtObj.properties.emitNativePropertiesYaml(12);
      }
    }
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}

operation AWSPSMCOMPUTE!CodeSigningConfig cfnTypeText(emitCtx : Map) : String {
  return "AWS::Lambda::CodeSigningConfig";
}

operation AWSPSMCOMPUTE!CodeSigningConfig emitCfnPropertiesYaml(emitCtx : Map) : String {
  var outText = emitYamlScalarProperty("Description", self.descriptionText, 6);
  if (self.allowedPublishers.isPresent()) {
    outText = outText + yamlBlock("AllowedPublishers", self.allowedPublishers, 6);
  }
  if (self.codeSigningPolicies.isPresent()) {
    outText = outText + yamlBlock("CodeSigningPolicies", self.codeSigningPolicies, 6);
  }
  return outText + self.tags.emitTagsYaml(6) + self.overrides.emitNativePropertiesYaml(6);
}
