/** Provides reusable contracts operations. */
import "naming.eol";
import "values.eol";
import "paths.eol";

/** Computes route path. */
operation AWSPSMAPI!ApiGatewayRoute routePath() : String {
  if (self.eClass().getName() = "HttpApiRoute" or self.eClass().getName() = "RestApiRoute") {
    return self.path.orElseText("/" + self.stableKey().toSlug());
  }
  return "/" + self.stableKey().toSlug();
}

/** Computes route method. */
operation AWSPSMAPI!ApiGatewayRoute routeMethod() : String {
  if (self.eClass().getName() = "HttpApiRoute" or self.eClass().getName() = "RestApiRoute") {
    return self.method.httpMethodText();
  }
  return "get";
}

/** Computes operation id text. */
operation AWSPSMAPI!ApiGatewayRoute operationIdText() : String {
  return self.operationName.orElseText(self.stableKey()).toCamel();
}

/** Renders emit open api document. */
operation AWSPSMAPI!ApiGatewayApi emitOpenApiDocument(routeSeq : Collection) : String {
  var outText = "openapi: 3.0.3\n";
  outText = outText + "info:\n";
  outText = outText + "  title: " + self.apiName.orElseText(self.cfnLogicalId()).yamlScalar() + "\n";
  outText = outText + "  version: '1.0.0'\n";
  outText = outText + "  description: " + self.descriptionText.orElseText("Generated from AWS PSM API model.").yamlScalar() + "\n";
  outText = outText + "paths:\n";
  for (pathText in routeSeq.collect(routeObj | routeObj.routePath()).asSet().asSequence().sortBy(pathText | pathText)) {
    outText = outText + "  " + pathText + ":\n";
    for (routeObj in routeSeq.select(routeObj | routeObj.routePath() = pathText).sortBy(routeObj | routeObj.routeMethod())) {
      outText = outText + routeObj.openApiOperation(4);
    }
  }
  outText = outText + "components:\n";
  outText = outText + "  responses:\n";
  outText = outText + "    BadRequest:\n";
  outText = outText + "      description: Invalid request\n";
  outText = outText + "    InternalError:\n";
  outText = outText + "      description: Internal error\n";
  outText = outText + self.openApiSchemasYaml(routeSeq, 2);
  outText = outText + self.openApiSecuritySchemesYaml(routeSeq, 2);
  return outText;
}

/** Computes open api schemas yaml. */
operation AWSPSMAPI!ApiGatewayApi openApiSchemasYaml(routeSeq : Collection, indentCount : Integer) : String {
  var schemaModels = self.collectOpenApiSchemaModels(routeSeq);
  var outText = spaces(indentCount) + "schemas:\n";
  if (schemaModels.isEmpty()) {
    return outText + spaces(indentCount + 2) + "{}\n";
  }
  for (schemaModel in schemaModels.sortBy(schemaModel | schemaModel.openapiModelName())) {
    outText = outText + spaces(indentCount + 2) + schemaModel.openapiModelName() + ": " + schemaModel.schemaJson + "\n";
  }
  return outText;
}

/** Adds or records collect open api schema models. */
operation AWSPSMAPI!ApiGatewayApi collectOpenApiSchemaModels(routeSeq : Collection) : Sequence {
  var schemaModels = Sequence{};
  var seenNames = Set{};
  for (routeObj in routeSeq) {
    for (requestModel in routeObj.requestModels) {
      if (not seenNames.includes(requestModel.modelName)) {
        schemaModels.add(requestModel);
        seenNames.add(requestModel.modelName);
      }
    }
    for (responseModel in routeObj.responseModels) {
      var responseModelName = responseModel.openapiSchemaName();
      if (not seenNames.includes(responseModelName)) {
        schemaModels.add(responseModel);
        seenNames.add(responseModelName);
      }
    }
  }
  return schemaModels;
}

/** Computes open api security schemes yaml. */
operation AWSPSMAPI!ApiGatewayApi openApiSecuritySchemesYaml(routeSeq : Collection, indentCount : Integer) : String {
  var schemeNames = routeSeq.collect(routeObj | routeObj.openApiSecuritySchemeName())
    .select(schemeName | schemeName.isPresent()).asSet().asSequence().sortBy(schemeName | schemeName);
  var outText = spaces(indentCount) + "securitySchemes:\n";
  if (schemeNames.isEmpty()) {
    return outText + spaces(indentCount + 2) + "{}\n";
  }
  for (schemeName in schemeNames) {
    outText = outText + spaces(indentCount + 2) + schemeName + ":\n";
    if (schemeName = "aws_iam") {
      outText = outText + spaces(indentCount + 4) + "type: apiKey\n";
      outText = outText + spaces(indentCount + 4) + "name: Authorization\n";
      outText = outText + spaces(indentCount + 4) + "in: header\n";
      outText = outText + spaces(indentCount + 4) + "x-amazon-apigateway-authtype: awsSigv4\n";
    }
    else if (schemeName = "api_key") {
      outText = outText + spaces(indentCount + 4) + "type: apiKey\n";
      outText = outText + spaces(indentCount + 4) + "name: x-api-key\n";
      outText = outText + spaces(indentCount + 4) + "in: header\n";
    }
    else if (schemeName = "jwt") {
      outText = outText + spaces(indentCount + 4) + "type: http\n";
      outText = outText + spaces(indentCount + 4) + "scheme: bearer\n";
      outText = outText + spaces(indentCount + 4) + "bearerFormat: JWT\n";
    }
    else if (schemeName = "cognito_user_pools") {
      outText = outText + spaces(indentCount + 4) + "type: openIdConnect\n";
      outText = outText + spaces(indentCount + 4) + "openIdConnectUrl: " + "REVIEW_REQUIRED_OIDC_DISCOVERY_URL".yamlScalar() + "\n";
    }
    else {
      outText = outText + spaces(indentCount + 4) + "type: apiKey\n";
      outText = outText + spaces(indentCount + 4) + "name: Authorization\n";
      outText = outText + spaces(indentCount + 4) + "in: header\n";
    }
  }
  return outText;
}

/** Computes open api operation. */
operation AWSPSMAPI!ApiGatewayRoute openApiOperation(indentCount : Integer) : String {
  var outText = spaces(indentCount) + self.routeMethod() + ":\n";
  outText = outText + spaces(indentCount + 2) + "operationId: " + self.operationIdText().yamlScalar() + "\n";
  outText = outText + spaces(indentCount + 2) + "tags:\n";
  outText = outText + spaces(indentCount + 4) + "- " + self.api.apiName.orElseText("api").yamlScalar() + "\n";
  if (self.openApiSecuritySchemeName().isPresent()) {
    outText = outText + spaces(indentCount + 2) + "security:\n";
    outText = outText + spaces(indentCount + 4) + "- " + self.openApiSecuritySchemeName() + ": []\n";
  }
  if (self.requestModels.notEmpty()) {
    var requestModel = self.requestModels.first();
    outText = outText + spaces(indentCount + 2) + "requestBody:\n";
    outText = outText + spaces(indentCount + 4) + "required: true\n";
    outText = outText + spaces(indentCount + 4) + "content:\n";
    outText = outText + spaces(indentCount + 6) + requestModel.contentType.orElseText("application/json") + ":\n";
    outText = outText + spaces(indentCount + 8) + "schema:\n";
    outText = outText + spaces(indentCount + 10) + "$ref: " + ("#/components/schemas/" + requestModel.modelName).yamlScalar() + "\n";
  }
  outText = outText + spaces(indentCount + 2) + "responses:\n";
  for (responseModel in self.sortedOpenApiResponseModels()) {
    outText = outText + spaces(indentCount + 4) + "'" + responseModel.statusCode + "':\n";
    outText = outText + spaces(indentCount + 6) + "description: " + self.openApiResponseDescription(responseModel.statusCode).yamlScalar() + "\n";
    outText = outText + spaces(indentCount + 6) + "content:\n";
    outText = outText + spaces(indentCount + 8) + responseModel.contentType.orElseText("application/json") + ":\n";
    outText = outText + spaces(indentCount + 10) + "schema:\n";
    outText = outText + spaces(indentCount + 12) + "$ref: " + ("#/components/schemas/" + responseModel.openapiSchemaName()).yamlScalar() + "\n";
  }
  if (self.sortedOpenApiResponseModels().isEmpty()) {
    outText = outText + spaces(indentCount + 4) + "'200':\n";
    outText = outText + spaces(indentCount + 6) + "description: Successful response\n";
  }
  if (not self.responseModels.exists(responseModel | responseModel.statusCode = "400")) {
    outText = outText + spaces(indentCount + 4) + "'400':\n";
    outText = outText + spaces(indentCount + 6) + "$ref: '#/components/responses/BadRequest'\n";
  }
  if (not self.responseModels.exists(responseModel | responseModel.statusCode = "500")) {
    outText = outText + spaces(indentCount + 4) + "'500':\n";
    outText = outText + spaces(indentCount + 6) + "$ref: '#/components/responses/InternalError'\n";
  }
  if (self.integration.isDefined()) {
    outText = outText + spaces(indentCount + 2) + "x-amazon-apigateway-integration:\n";
    outText = outText + spaces(indentCount + 4) + "type: " + self.integration.integrationType.asString().toLowerCase().yamlScalar() + "\n";
    if (self.integration.lambdaTarget.isDefined()) {
      // Represent the Lambda attribute as an intrinsic node.  !Sub leaves
      // dotted GetAtt expressions literal in an OpenAPI DefinitionBody on
      // Floci, so Fn::Join/Fn::GetAtt is portable across AWS and emulators.
      outText = outText + spaces(indentCount + 4) + "uri: !Join ['', ['arn:', !Ref AWS::Partition, ':apigateway:', !Ref AWS::Region, ':lambda:path/2015-03-31/functions/', !GetAtt " +
        self.integration.lambdaTarget.cfnLogicalId() + ".Arn, '/invocations']]\n";
    }
    else if (self.integration.integrationUri.isPresent()) {
      outText = outText + spaces(indentCount + 4) + "uri: " + self.integration.integrationUri.yamlScalar() + "\n";
    }
    outText = outText + spaces(indentCount + 4) + "httpMethod: " + self.integration.integrationMethod.orElseText("POST").yamlScalar() + "\n";
    if (self.api.eClass().getName() = "HttpApi") {
      outText = outText + spaces(indentCount + 4) + "payloadFormatVersion: " + self.integration.payloadFormatVersion.orElseText("2.0").jsonString() + "\n";
    }
  }
  return outText;
}

/** Derives sorted open api response models. */
operation AWSPSMAPI!ApiGatewayRoute sortedOpenApiResponseModels() : Sequence {
  var uniqueModels = new Sequence;
  var seenStatusCodes = new Set;
  for (responseModel in self.responseModels.asSequence().sortBy(responseModel | responseModel.statusCode + responseModel.stableKey())) {
    if (not seenStatusCodes.includes(responseModel.statusCode)) {
      uniqueModels.add(responseModel);
      seenStatusCodes.add(responseModel.statusCode);
    }
  }
  return uniqueModels;
}

/** Computes open api response description. */
operation AWSPSMAPI!ApiGatewayRoute openApiResponseDescription(statusCode : String) : String {
  if (statusCode.startsWith("2")) {
    return "Successful response";
  }
  if (statusCode.startsWith("4")) {
    return "Client error";
  }
  if (statusCode.startsWith("5")) {
    return "Server error";
  }
  return "Response";
}

/** Computes open api security scheme name. */
operation AWSPSMAPI!ApiGatewayRoute openApiSecuritySchemeName() : String {
  var raw = self.authorizationType.asString().toLowerCase().replace(" ", "_");
  if (raw = "none") {
    return "";
  }
  return raw;
}

/** Computes openapi schema name. */
operation AWSPSMAPI!ApiGatewayResponseModel openapiSchemaName() : String {
  return firstText(self.name, self.id).toCfnLogicalId();
}

/** Computes openapi model name. */
operation AWSPSMAPI!ApiGatewayRequestModel openapiModelName() : String {
  return self.modelName;
}

/** Computes openapi model name. */
operation AWSPSMAPI!ApiGatewayResponseModel openapiModelName() : String {
  return self.openapiSchemaName();
}

/** Renders a complete ASL document. Keeping the document assembly here prevents EGL
 * control-block whitespace from corrupting JSON object member boundaries. */
operation AWSPSMWORKFLOW!AslDocument emitAslDocumentJson(stateMachineObj : AWSPSMWORKFLOW!StepFunctionStateMachine) : String {
  var outText = "{\n";
  outText = outText + "  \"Comment\": " + self.comment.orElseText(stateMachineObj.stateMachineName.orElseText("Generated workflow")).jsonString() + ",\n";
  if (self.queryLanguage.isPresent()) {
    outText = outText + "  \"QueryLanguage\": " + self.queryLanguage.jsonString() + ",\n";
  }
  outText = outText + "  \"StartAt\": " + self.startAt.jsonString() + ",\n  \"States\": {\n";
  var stateSeq = self.states.sortBy(stateObj | stateObj.stateName);
  for (stateObj in stateSeq) {
    outText = outText + stateObj.emitAslStateJson(4);
    if (stateObj <> stateSeq.last()) {
      outText = outText + ",";
    }
    outText = outText + "\n";
  }
  return outText + "  }\n}\n";
}

/** Renders a modeled ASL state as a valid, indented JSON member. */
operation AWSPSMWORKFLOW!AslState emitAslStateJson(indentCount : Integer) : String {
  var stateTypeText = self.aslStateTypeName();
  var outText = spaces(indentCount) + self.stateName.jsonString() + ": {\n";
  outText = outText + spaces(indentCount + 2) + "\"Type\": " + stateTypeText.toLowerCase().firstToUpperCase().jsonString();
  if (self.queryLanguage.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"QueryLanguage\": " + self.queryLanguage.jsonString();
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslTaskState) and self.invokedResource.isDefined()
      and self.resource <> "arn:aws:states:::states:startExecution.sync") {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Resource\": " + ("${" + self.invokedResource.cfnLogicalId() + "Arn}").jsonString();
  }
  else if (self.resource.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Resource\": " + self.resource.jsonString();
  }
  if (stateTypeText <> "SUCCEED" and stateTypeText <> "FAIL"
      and self.queryLanguage.orElseText("JSONPath") <> "JSONata" and self.inputPath.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"InputPath\": " + self.inputPath.jsonString();
  }
  if (stateTypeText <> "SUCCEED" and stateTypeText <> "FAIL"
      and self.queryLanguage.orElseText("JSONPath") <> "JSONata" and self.outputPath.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"OutputPath\": " + self.outputPath.jsonString();
  }
  if (stateTypeText <> "SUCCEED" and stateTypeText <> "FAIL"
      and self.queryLanguage.orElseText("JSONPath") <> "JSONata" and self.resultPath.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"ResultPath\": " + self.resultPath.jsonString();
  }
  if (stateTypeText <> "SUCCEED" and stateTypeText <> "FAIL" and self.parametersJson.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Parameters\": " + self.parametersJson;
  }
  if (stateTypeText <> "SUCCEED" and stateTypeText <> "FAIL" and self.argumentsJson.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Arguments\": " + self.argumentsJson;
  }
  if (stateTypeText <> "SUCCEED" and stateTypeText <> "FAIL" and self.assignJson.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Assign\": " + self.assignJson;
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslTaskState) and self.timeoutSeconds.isDefined() and self.timeoutSeconds > 0) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"TimeoutSeconds\": " + self.timeoutSeconds.asString();
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslTaskState) and self.heartbeatSeconds.isDefined() and self.heartbeatSeconds > 0) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"HeartbeatSeconds\": " + self.heartbeatSeconds.asString();
  }
  if ((stateTypeText = "TASK" or stateTypeText = "PARALLEL" or stateTypeText = "MAP") and self.retry.notEmpty()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Retry\": [\n";
    for (retryObj in self.retry) {
      outText = outText + retryObj.emitAslRetryJson(indentCount + 4);
      if (retryObj <> self.retry.last()) {
        outText = outText + ",";
      }
      outText = outText + "\n";
    }
    outText = outText + spaces(indentCount + 2) + "]";
  }
  if ((stateTypeText = "TASK" or stateTypeText = "PARALLEL" or stateTypeText = "MAP") and self.`catch`.notEmpty()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Catch\": [\n";
    for (catchObj in self.`catch`) {
      outText = outText + catchObj.emitAslCatchJson(indentCount + 4);
      if (catchObj <> self.`catch`.last()) {
        outText = outText + ",";
      }
      outText = outText + "\n";
    }
    outText = outText + spaces(indentCount + 2) + "]";
  }
  if (stateTypeText = "CHOICE" and self.choices.notEmpty()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Choices\": [\n";
    for (choiceObj in self.choices) {
      outText = outText + choiceObj.emitAslChoiceJson(indentCount + 4);
      if (choiceObj <> self.choices.last()) {
        outText = outText + ",";
      }
      outText = outText + "\n";
    }
    outText = outText + spaces(indentCount + 2) + "]";
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslWaitState)) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Seconds\": " + self.timeoutSeconds.orElseText("0");
  }
  if (stateTypeText = "PARALLEL" and self.branches.notEmpty()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Branches\": [\n";
    for (branchObj in self.branches) {
      outText = outText + branchObj.emitAslBranchJson(indentCount + 4);
      if (branchObj <> self.branches.last()) {
        outText = outText + ",";
      }
      outText = outText + "\n";
    }
    outText = outText + spaces(indentCount + 2) + "]";
  }
  if (stateTypeText = "MAP" and self.mapConfig.isDefined() and self.mapConfig.itemProcessor.isDefined()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"ItemsPath\": " + self.mapConfig.itemsPath.orElseText("$").jsonString();
    if (self.mapConfig.maxConcurrency.isDefined() and self.mapConfig.maxConcurrency > 0) {
      outText = outText + ",\n" + spaces(indentCount + 2) + "\"MaxConcurrency\": " + self.mapConfig.maxConcurrency.asString();
    }
    if (self.mapConfig.itemSelectorJson.isPresent()) {
      outText = outText + ",\n" + spaces(indentCount + 2) + "\"ItemSelector\": " + self.mapConfig.itemSelectorJson;
    }
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"ItemProcessor\": " + self.mapConfig.itemProcessor.emitAslBranchJson(indentCount + 2);
  }
  if (stateTypeText = "CHOICE" and self.nextState.isDefined()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Default\": " + self.nextState.stateName.jsonString();
  }
  else if (stateTypeText <> "CHOICE" and self.nextState.isDefined()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Next\": " + self.nextState.stateName.jsonString();
  }
  else if (stateTypeText <> "CHOICE" and self.nextStateName.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"Next\": " + self.nextStateName.jsonString();
  }
  else if (self.end = true and stateTypeText <> "SUCCEED" and stateTypeText <> "FAIL" and stateTypeText <> "CHOICE") {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"End\": true";
  }
  outText = outText + "\n" + spaces(indentCount) + "}";
  return outText;
}

/** Returns the Amazon States Language Type represented by a concrete state classifier. */
operation AWSPSMWORKFLOW!AslState aslStateTypeName() : String {
  if (self.isKindOf(AWSPSMWORKFLOW!AslPassState)) {
    return "PASS";
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslTaskState)) {
    return "TASK";
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslChoiceState)) {
    return "CHOICE";
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslWaitState)) {
    return "WAIT";
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslSucceedState)) {
    return "SUCCEED";
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslFailState)) {
    return "FAIL";
  }
  if (self.isKindOf(AWSPSMWORKFLOW!AslParallelState)) {
    return "PARALLEL";
  }
  return "MAP";
}

/** Renders an ASL branch or a Map item processor. */
operation AWSPSMWORKFLOW!AslBranch emitAslBranchJson(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "{\n" + spaces(indentCount + 2) + "\"StartAt\": " + self.startAt.jsonString() + ",\n" + spaces(indentCount + 2) + "\"States\": {\n";
  var stateSeq = self.states.sortBy(stateObj | stateObj.stateName);
  for (stateObj in stateSeq) {
    outText = outText + stateObj.emitAslStateJson(indentCount + 4);
    if (stateObj <> stateSeq.last()) {
      outText = outText + ",";
    }
    outText = outText + "\n";
  }
  return outText + spaces(indentCount + 2) + "}\n" + spaces(indentCount) + "}";
}

/** Renders emit asl retry json. */
operation AWSPSMWORKFLOW!AslRetryRule emitAslRetryJson(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "{\n";
  outText = outText + self.errorEquals.emitAslStringArray("ErrorEquals", indentCount + 2);
  if (self.intervalSeconds.isDefined()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"IntervalSeconds\": " + self.intervalSeconds.asString();
  }
  if (self.maxAttempts.isDefined()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"MaxAttempts\": " + self.maxAttempts.asString();
  }
  if (self.backoffRate.isDefined()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"BackoffRate\": " + self.backoffRate.asString();
  }
  if (self.maxDelaySeconds.isDefined()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"MaxDelaySeconds\": " + self.maxDelaySeconds.asString();
  }
  if (self.jitterStrategy.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"JitterStrategy\": " + self.jitterStrategy.jsonString();
  }
  return outText + "\n" + spaces(indentCount) + "}";
}

/** Renders emit asl catch json. */
operation AWSPSMWORKFLOW!AslCatchRule emitAslCatchJson(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "{\n";
  outText = outText + self.errorEquals.emitAslStringArray("ErrorEquals", indentCount + 2);
  if (self.resultPath.isPresent()) {
    outText = outText + ",\n" + spaces(indentCount + 2) + "\"ResultPath\": " + self.resultPath.jsonString();
  }
  outText = outText + ",\n" + spaces(indentCount + 2) + "\"Next\": " + self.nextState.stateName.jsonString();
  return outText + "\n" + spaces(indentCount) + "}";
}

/** Renders emit asl choice json. */
operation AWSPSMWORKFLOW!AslChoiceRule emitAslChoiceJson(indentCount : Integer) : String {
  var outText = spaces(indentCount) + "{\n";
  if (self.conditionExpression.isPresent() and self.conditionExpression.startsWith("{%")) {
    outText = outText + spaces(indentCount + 2) + "\"Condition\": " + self.conditionExpression.jsonString() + ",\n";
  }
  else if (self.conditionExpression.isPresent()) {
    outText = outText + spaces(indentCount + 2) + "\"Variable\": " + self.variable.orElseText("$.condition").jsonString() + ",\n";
    outText = outText + spaces(indentCount + 2) + "\"StringEquals\": " + self.conditionExpression.jsonString() + ",\n";
  }
  else {
    outText = outText + spaces(indentCount + 2) + "\"Variable\": " + self.variable.orElseText("$").jsonString() + ",\n";
    outText = outText + spaces(indentCount + 2) + "\"IsPresent\": true,\n";
  }
  outText = outText + spaces(indentCount + 2) + "\"Next\": " + self.nextState.stateName.jsonString() + "\n";
  return outText + spaces(indentCount) + "}";
}

/** Renders an ASL string-array field, including when it contains exactly one item. */
operation Collection emitAslStringArray(nameText : String, indentCount : Integer) : String {
  var outText = spaces(indentCount) + nameText.jsonString() + ": [";
  for (itemText in self) {
    if (itemText <> self.first()) {
      outText = outText + ", ";
    }
    outText = outText + itemText.jsonString();
  }
  return outText + "]";
}

/** Computes schema title. */
operation KERNEL!TraceableElement schemaTitle(schemaKindText : String) : String {
  return self.name.orElseText(self.eClass().getName()) + " " + schemaKindText;
}

/** Computes indent json block. */
operation indentJsonBlock(text : String, indentCount : Integer) : String {
  var outText = "";
  for (lineText in text.split("\n")) {
    if (outText.isPresent()) {
      outText = outText + "\n";
    }
    outText = outText + spaces(indentCount) + lineText;
  }
  return outText;
}

/** Computes local input schema json. */
operation AWSPSMCOMPUTE!AwsLambdaFunction localInputSchemaJson(profileMap : Map) : String {
  var variants = Sequence{};
  if (self.hasApiGatewayInvocation()) {
    variants.add(self.apiGatewayProxyEventSchemaJson());
  }
  if (self.eventSourceMappings.exists(mappingObj | mappingObj.eClass().getName() = "SqsLambdaEventSourceMapping")) {
    variants.add(self.sqsEventSchemaJson());
  }
  if (self.eventSourceMappings.exists(mappingObj | mappingObj.eClass().getName() = "DynamoDbStreamLambdaEventSourceMapping")) {
    variants.add(self.dynamoStreamEventSchemaJson());
  }
  if (self.permissions.exists(permissionObj | permissionObj.principal = "events.amazonaws.com" or permissionObj.principal = "scheduler.amazonaws.com")) {
    variants.add(self.eventBridgeEventSchemaJson());
  }

  if (variants.isEmpty()) {
    variants.add(self.genericJsonEventSchemaJson());
  }
  if (variants.size() = 1) {
    return self.wrapLocalSchemaDocument(profileMap, variants.first());
  }

  var oneOfText = "";
  for (variantText in variants) {
    if (oneOfText.isPresent()) {
      oneOfText = oneOfText + ",\n";
    }
    oneOfText = oneOfText + indentJsonBlock(variantText, 4);
  }
  return "{\n" +
    "  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n" +
    "  \"$id\": \"urn:modriss:" + firstText(profileMap.get("projectSlug"), "modriss") + ":" + self.stableKey().toSlug() + ":lambda-input\",\n" +
    "  \"title\": " + self.schemaTitle("lambda-input").jsonString() + ",\n" +
    "  \"description\": " + firstText(self.summary, "Generated Lambda input event schema.").jsonString() + ",\n" +
    "  \"oneOf\": [\n" + oneOfText + "\n  ],\n" +
    "  \"x-psm-trace\": { \"sourceStableId\": " + self.stableKey().jsonString() + ", \"generatorRule\": \"AWSPSM2ART_Contract_To_JsonSchema\" }\n" +
    "}\n";
}

/** Computes wrap local schema document. */
operation AWSPSMCOMPUTE!AwsLambdaFunction wrapLocalSchemaDocument(profileMap : Map, bodyText : String) : String {
  return "{\n" +
    "  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n" +
    "  \"$id\": \"urn:modriss:" + firstText(profileMap.get("projectSlug"), "modriss") + ":" + self.stableKey().toSlug() + ":lambda-input\",\n" +
    "  \"title\": " + self.schemaTitle("lambda-input").jsonString() + ",\n" +
    "  \"description\": " + firstText(self.summary, "Generated Lambda input event schema.").jsonString() + ",\n" +
    "  \"allOf\": [\n" + indentJsonBlock(bodyText, 4) + "\n  ],\n" +
    "  \"x-psm-trace\": { \"sourceStableId\": " + self.stableKey().jsonString() + ", \"generatorRule\": \"AWSPSM2ART_Contract_To_JsonSchema\" }\n" +
    "}\n";
}

/** Returns whether the receiver has api gateway invocation. */
operation AWSPSMCOMPUTE!AwsLambdaFunction hasApiGatewayInvocation() : Boolean {
  return AWSPSMAPI!ApiGatewayIntegration.all.exists(integrationObj | integrationObj.lambdaTarget = self);
}

/** Computes api gateway proxy event schema json. */
operation AWSPSMCOMPUTE!AwsLambdaFunction apiGatewayProxyEventSchemaJson() : String {
  return "{\n" +
    "  \"title\": \"API Gateway proxy event\",\n" +
    "  \"type\": \"object\",\n" +
    "  \"additionalProperties\": false,\n" +
    "  \"required\": [ \"requestContext\" ],\n" +
    "  \"properties\": {\n" +
    "    \"version\": { \"type\": \"string\" },\n" +
    "    \"routeKey\": { \"type\": \"string\" },\n" +
    "    \"rawPath\": { \"type\": \"string\" },\n" +
    "    \"headers\": { \"type\": \"object\", \"additionalProperties\": { \"type\": \"string\" } },\n" +
    "    \"queryStringParameters\": { \"type\": [ \"object\", \"null\" ], \"additionalProperties\": { \"type\": \"string\" } },\n" +
    "    \"pathParameters\": { \"type\": [ \"object\", \"null\" ], \"additionalProperties\": { \"type\": \"string\" } },\n" +
    "    \"body\": { \"type\": [ \"string\", \"null\" ] },\n" +
    "    \"isBase64Encoded\": { \"type\": \"boolean\" },\n" +
    "    \"requestContext\": { \"type\": \"object\" }\n" +
    "  }\n" +
    "}";
}

/** Computes sqs event schema json. */
operation AWSPSMCOMPUTE!AwsLambdaFunction sqsEventSchemaJson() : String {
  return "{\n" +
    "  \"title\": \"SQS event\",\n" +
    "  \"type\": \"object\",\n" +
    "  \"additionalProperties\": false,\n" +
    "  \"required\": [ \"Records\" ],\n" +
    "  \"properties\": {\n" +
    "    \"Records\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"required\": [ \"messageId\", \"body\" ], \"properties\": { \"messageId\": { \"type\": \"string\" }, \"receiptHandle\": { \"type\": \"string\" }, \"body\": { \"type\": \"string\" }, \"attributes\": { \"type\": \"object\" }, \"messageAttributes\": { \"type\": \"object\" }, \"eventSource\": { \"const\": \"aws:sqs\" }, \"awsRegion\": { \"type\": \"string\" } }, \"additionalProperties\": true } }\n" +
    "  }\n" +
    "}";
}

/** Computes dynamo stream event schema json. */
operation AWSPSMCOMPUTE!AwsLambdaFunction dynamoStreamEventSchemaJson() : String {
  return "{\n" +
    "  \"title\": \"DynamoDB stream event\",\n" +
    "  \"type\": \"object\",\n" +
    "  \"additionalProperties\": false,\n" +
    "  \"required\": [ \"Records\" ],\n" +
    "  \"properties\": {\n" +
    "    \"Records\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"required\": [ \"eventID\", \"eventName\", \"dynamodb\" ], \"properties\": { \"eventID\": { \"type\": \"string\" }, \"eventName\": { \"type\": \"string\" }, \"eventSource\": { \"const\": \"aws:dynamodb\" }, \"awsRegion\": { \"type\": \"string\" }, \"dynamodb\": { \"type\": \"object\" } }, \"additionalProperties\": true } }\n" +
    "  }\n" +
    "}";
}

/** Computes event bridge event schema json. */
operation AWSPSMCOMPUTE!AwsLambdaFunction eventBridgeEventSchemaJson() : String {
  return "{\n" +
    "  \"title\": \"EventBridge event\",\n" +
    "  \"type\": \"object\",\n" +
    "  \"additionalProperties\": true,\n" +
    "  \"required\": [ \"id\", \"source\", \"detail-type\", \"detail\" ],\n" +
    "  \"properties\": {\n" +
    "    \"version\": { \"type\": \"string\" },\n" +
    "    \"id\": { \"type\": \"string\" },\n" +
    "    \"source\": { \"type\": \"string\" },\n" +
    "    \"detail-type\": { \"type\": \"string\" },\n" +
    "    \"time\": { \"type\": \"string\", \"format\": \"date-time\" },\n" +
    "    \"detail\": { \"type\": \"object\" }\n" +
    "  }\n" +
    "}";
}

/** Computes generic json event schema json. */
operation AWSPSMCOMPUTE!AwsLambdaFunction genericJsonEventSchemaJson() : String {
  return "{\n" +
    "  \"title\": \"Generic JSON event\",\n" +
    "  \"type\": \"object\",\n" +
    "  \"additionalProperties\": true\n" +
    "}";
}

/** Returns whether the receiver requires idempotency. */
operation AWSPSMCOMPUTE!AwsLambdaFunction requiresIdempotency() : Boolean {
  if (self.eventSourceMappings.notEmpty()) {
    return true;
  }
  if (AWSPSMAPI!ApiGatewayIntegration.all.exists(integObj |
    integObj.lambdaTarget = self and
    AWSPSMAPI!ApiGatewayRoute.all.exists(routeObj |
      routeObj.integration = integObj and
      (routeObj.eClass().getName() = "HttpApiRoute" or routeObj.eClass().getName() = "RestApiRoute") and
      Sequence{"POST", "PUT", "PATCH", "DELETE"}.includes(routeObj.method.asString())))) {
    return true;
  }
  var docText = firstText(self.documentation, firstText(self.descriptionText, self.summary)).toLowerCase();
  return docText.contains("idempotency") or docText.contains("dedupe") or docText.contains("command");
}
