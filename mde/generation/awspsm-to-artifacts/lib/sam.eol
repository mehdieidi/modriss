import "naming.eol";

operation AWSPSMCORE!SamStack uniqueParameters() : Sequence {
  var seenNames : Set = Set{};
  var uniqueSeq : Sequence = Sequence{};
  for (paramObj in self.parameters.sortBy(paramObj | paramObj.parameterName)) {
    var logicalName = paramObj.parameterName.toCfnLogicalId();
    if (not seenNames.includes(logicalName)) {
      seenNames.add(logicalName);
      uniqueSeq.add(paramObj);
    }
  }
  return uniqueSeq;
}

operation AWSPSMCORE!SamStack capabilitiesText() : String {
  if (self.capabilities.isEmpty()) {
    return "CAPABILITY_IAM";
  }
  return self.capabilities.collect(capObj | capObj.asString()).concat(" ");
}

operation AWSPSMCORE!AwsStage stackDeployName(stackObj : AWSPSMCORE!SamStack) : String {
  var prefixText = self.stackNamePrefix.orElseText("");
  if (prefixText.isPresent()) {
    return prefixText + "-" + stackObj.stackName;
  }
  return stackObj.stackName;
}

operation AWSPSMCORE!AwsStage parameterOverrideText() : String {
  return self.parameterOverrides
    .sortBy(kvObj | kvObj.key)
    .collect(kvObj | kvObj.key + "=" + kvObj.value.orElseText(""))
    .concat(" ");
}
