#!/usr/bin/env bash
set -euo pipefail

stage_text="${1:-[%= emitCtx.get("defaultStageName") %]}"
bash scripts/build.sh
bash scripts/validate-template.sh
sam deploy --config-env "$stage_text"

[%=out.startPreserve("#", "", awsRoot.manualRegionId("deploy-customizations"), true)%]
# Add deployment notifications or approvals here.
[%=out.stopPreserve()%]
