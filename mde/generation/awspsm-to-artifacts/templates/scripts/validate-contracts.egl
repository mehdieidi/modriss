#!/usr/bin/env bash
set -euo pipefail

go test ./tests/contract

if [[ -d tests/events ]]; then
  go test ./tests/events
fi

if [[ -d tests/workflows ]]; then
  go test ./tests/workflows
fi

if [[ -d openapi ]]; then
  for openapi_path in openapi/*.openapi.yaml; do
    [[ -f "$openapi_path" ]] || continue
    grep -q '^openapi:' "$openapi_path"
    grep -q '^info:' "$openapi_path"
    grep -q '^paths:' "$openapi_path"
  done
fi

[%=out.startPreserve("#", "", awsRoot.manualRegionId("validate-contracts-customizations"), true)%]
# Add OpenAPI schema validation or spectral checks here.
[%=out.stopPreserve()%]
