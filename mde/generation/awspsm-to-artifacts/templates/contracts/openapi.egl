[% if (apiObj.definitionBody.isPresent()) { %]
[%= apiObj.definitionBody %]
[% } else { %]
[%= apiObj.emitOpenApiDocument(routeSeq) %]
[%= out.startPreserve("#", "", apiObj.manualRegionId("openapi-extension"), true) %]
# Add vendor extensions that cannot yet be represented in the PSM here.
[%= out.stopPreserve() %]
[% } %]
