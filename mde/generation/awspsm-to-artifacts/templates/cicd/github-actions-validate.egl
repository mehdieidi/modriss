name: Validate

on:
  pull_request:
  push:
    branches:
      - main

jobs:
  validate:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
[% if (emitCtx.primaryLanguage() = "PYTHON") { %]
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -e '.[dev]'
[% } else { %]
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
      - run: npm ci
[% } %]
      - uses: aws-actions/setup-sam@v2
      - run: bash scripts/validate-models.sh
      - run: bash scripts/validate-contracts.sh
      - run: bash scripts/build.sh
      - run: bash scripts/test.sh
      - run: bash scripts/validate-template.sh
[%=out.startPreserve("#", "", awsRoot.manualRegionId("ci-validate-customizations"), true)%]
      # Add organization validation steps here.
[%=out.stopPreserve()%]
