[% /* Generates the github actions validate artifact. */ %]name: Validate

on:
  pull_request:
  push:
    branches:
      - main

jobs:
  validate:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'
          cache: true
      - uses: aws-actions/setup-sam@v2
      - name: Install project dependencies
        run: bash scripts/build.sh --install-only
      - run: bash scripts/validate-contracts.sh
      - run: bash scripts/validate-template.sh
      - run: bash scripts/build.sh
      - run: bash scripts/test.sh
      - name: Security checks
        run: bash scripts/validate-models.sh --security
[%=out.startPreserve("#", "", awsRoot.manualRegionId("ci-validate-customizations"), true)%]
      # Add organization validation steps here.
[%=out.stopPreserve()%]
