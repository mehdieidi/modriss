[% /* Generates the samconfig artifact. Multi-stack commands pass stack-specific settings explicitly. */ %]version = 0.1

[default.global.parameters]
region = "[%= awsRoot.defaultRegion.orElseText("us-east-1") %]"

[%= out.startPreserve("#", "", awsRoot.manualRegionId("samconfig-local-overrides"), true) %]
# Local deploy overrides may be added here. Do not commit account secrets.
[%= out.stopPreserve() %]
