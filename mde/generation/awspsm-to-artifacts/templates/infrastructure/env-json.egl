[% /* Generates the env json artifact. */ %]{
  "stage": "[%= stageObj.stageName.jsonEscape() %]",
  "environmentClass": "[%= stageObj.environmentClass.asString().jsonEscape() %]",
  "accountId": "[%= stageObj.accountId.orElseText("").jsonEscape() %]",
  "region": "[%= stageObj.region.orElseText("").jsonEscape() %]",
  "parameters": {
[% var paramSeq = stageObj.parameterOverrides.sortBy(kvObj | kvObj.key); %]
[% for (kvObj in paramSeq) { %]
    "[%= kvObj.key.jsonEscape() %]": "[%= kvObj.value.orElseText("").jsonEscape() %]"[% if (kvObj <> paramSeq.last()) { %],[% } %]
[% } %]
  }
}
