[% /* Generates the event test artifact. */ %]package events

import (
	"encoding/json"
	"os"
	"path/filepath"
	"testing"
)

func TestGeneratedEventSamplesParse(t *testing.T) {
	rootText := "../../events/samples"
	if _, err := os.Stat(rootText); err != nil {
		return
	}
	err := filepath.WalkDir(rootText, func(pathText string, entryObj os.DirEntry, walkErr error) error {
		if walkErr != nil || entryObj.IsDir() || filepath.Ext(pathText) != ".json" {
			return walkErr
		}
		encodedBytes, err := os.ReadFile(pathText)
		if err != nil {
			return err
		}
		var eventObj map[string]any
		if err := json.Unmarshal(encodedBytes, &eventObj); err != nil {
			return err
		}
		if _, ok := eventObj["detail"]; !ok {
			t.Fatalf("%s should include detail", pathText)
		}
		return nil
	})
	if err != nil {
		t.Fatalf("event sample validation failed: %v", err)
	}
[%=out.startPreserve("/*", "*/", awsRoot.manualRegionId("event-custom-assertions"), true)%]
	if false {
		t.Fatal("unreachable custom assertion guard")
	}
[%=out.stopPreserve()%]
}
