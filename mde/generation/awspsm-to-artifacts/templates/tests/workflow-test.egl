package workflows

import (
	"encoding/json"
	"os"
	"testing"
)

func Test[%= stateMachineObj.cfnLogicalId() %]ASLIsValidJSON(t *testing.T) {
	encodedBytes, err := os.ReadFile("../../[%= stateMachineObj.aslPath() %]")
	if err != nil {
		t.Fatalf("ASL file should be readable: %v", err)
	}
	var aslObj map[string]any
	if err := json.Unmarshal(encodedBytes, &aslObj); err != nil {
		t.Fatalf("ASL file should be valid JSON: %v", err)
	}
	if aslObj["StartAt"] == "" {
		t.Fatal("ASL StartAt is required")
	}
[%=out.startPreserve("/*", "*/", stateMachineObj.manualRegionId("workflow-assertions"), true)%]
	if aslObj["States"] == nil {
		t.Fatal("ASL States are required")
	}
[%=out.stopPreserve()%]
}
