[% /* Generates the security test artifact. */ %]package e2e

import (
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestTemplateHasNoPlaintextSecretMarker(t *testing.T) {
	templatePaths, err := filepath.Glob("../../template*.yaml")
	if err != nil {
		t.Fatalf("generated template lookup failed: %v", err)
	}
	if len(templatePaths) == 0 {
		t.Fatal("expected at least one generated SAM template")
	}
	for _, templatePath := range templatePaths {
		templateBytes, err := os.ReadFile(templatePath)
		if err != nil {
			t.Fatalf("%s should be readable: %v", templatePath, err)
		}
		if strings.Contains(string(templateBytes), "PLAINTEXT_SECRET") {
			t.Fatalf("%s contains plaintext secret marker", templatePath)
		}
	}
[%=out.startPreserve("/*", "*/", awsRoot.manualRegionId("security-custom-assertions"), true)%]
	if false {
		t.Fatal("unreachable custom assertion guard")
	}
[%=out.stopPreserve()%]
}
