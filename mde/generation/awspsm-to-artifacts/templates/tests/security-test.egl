[% /* Generates the security test artifact. */ %]package e2e

import (
	"os"
	"strings"
	"testing"
)

func TestTemplateHasNoPlaintextSecretMarker(t *testing.T) {
	templateBytes, err := os.ReadFile("../../template.yaml")
	if err != nil {
		t.Fatalf("template.yaml should be readable: %v", err)
	}
	templateText := string(templateBytes)
	if strings.Contains(templateText, "PLAINTEXT_SECRET") {
		t.Fatal("template.yaml contains plaintext secret marker")
	}
[%=out.startPreserve("/*", "*/", awsRoot.manualRegionId("security-custom-assertions"), true)%]
	if false {
		t.Fatal("unreachable custom assertion guard")
	}
[%=out.stopPreserve()%]
}
