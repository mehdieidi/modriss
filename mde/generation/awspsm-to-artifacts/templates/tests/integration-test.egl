[% /* Generates the integration test artifact. */ %]package integration

import (
	"os"
	"testing"
)

func Test[%= awsFn.cfnLogicalId() %]IntegrationContract(t *testing.T) {
[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("integration-external-setup"), true)%]
	if os.Getenv("AWS_REGION") == "" {
		t.Skip("AWS_REGION is required for deployed integration tests")
	}
[%=out.stopPreserve()%]
[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("integration-assertions"), true)%]
	if os.Getenv("AWS_REGION") == "" {
		t.Fatal("AWS_REGION should be set after setup")
	}
[%=out.stopPreserve()%]
[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("integration-cleanup"), true)%]
	// Add cleanup for external resources here.
[%=out.stopPreserve()%]
}
