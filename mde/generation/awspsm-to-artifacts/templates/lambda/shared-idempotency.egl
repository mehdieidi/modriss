[% /* Generates the shared idempotency artifact. */ %]package shared

import (
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"sync"
)

type IdempotencyStore struct {
	mutexObj sync.RWMutex
	values   map[string]any
}

func NewIdempotencyStore(configObj GeneratedConfig) *IdempotencyStore {
	return &IdempotencyStore{values: map[string]any{}}
}

func (storeObj *IdempotencyStore) Get(keyText string) (any, bool) {
	storeObj.mutexObj.RLock()
	defer storeObj.mutexObj.RUnlock()
	valueObj, ok := storeObj.values[keyText]
	return valueObj, ok
}

func (storeObj *IdempotencyStore) Put(keyText string, valueObj any) {
	storeObj.mutexObj.Lock()
	defer storeObj.mutexObj.Unlock()
	storeObj.values[keyText] = valueObj
}

func DeriveIdempotencyKey(payloadObj any) string {
[%=out.startPreserve("/*", "*/", awsRoot.manualRegionId("idempotency-key-derivation"), true)%]
	encodedBytes, _ := json.Marshal(payloadObj)
	hashBytes := sha256.Sum256(encodedBytes)
	return hex.EncodeToString(hashBytes[:])
[%=out.stopPreserve()%]
}
