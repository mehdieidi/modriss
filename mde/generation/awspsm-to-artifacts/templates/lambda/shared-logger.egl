[% /* Generates the shared logger artifact. */ %]package shared

import (
	"encoding/json"
	"log"
)

type Logger struct {
	CorrelationID string
	FunctionName  string
	Stage         string
}

func NewLogger(correlationID string, functionName string, stage string) Logger {
	return Logger{CorrelationID: correlationID, FunctionName: functionName, Stage: stage}
}

func (loggerObj Logger) Info(messageText string, fieldsObj map[string]any) {
	loggerObj.write("INFO", messageText, fieldsObj)
}

func (loggerObj Logger) Error(messageText string, err error) {
	loggerObj.write("ERROR", messageText, map[string]any{"error": err.Error()})
}

func (loggerObj Logger) write(levelText string, messageText string, fieldsObj map[string]any) {
	recordObj := map[string]any{
		"level":         levelText,
		"message":       messageText,
		"correlationId": loggerObj.CorrelationID,
		"functionName":  loggerObj.FunctionName,
		"stage":         loggerObj.Stage,
		"fields":        fieldsObj,
	}
	encodedBytes, _ := json.Marshal(recordObj)
	log.Println(string(encodedBytes))
}
