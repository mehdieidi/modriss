package shared

import "context"

type EventPublisher struct {
	Config GeneratedConfig
	Logger Logger
}

func NewEventPublisher(configObj GeneratedConfig, loggerObj Logger) EventPublisher {
	return EventPublisher{Config: configObj, Logger: loggerObj}
}

func (publisherObj EventPublisher) PublishModeledEvents(ctx context.Context, sourceStableID string, payloadObj any) error {
	publisherObj.Logger.Info("modeled event publication hook", map[string]any{"sourceStableId": sourceStableID})
	return nil
}
