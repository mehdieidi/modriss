[% /* Generates the shared errors artifact. */ %]package shared

import "encoding/json"

type GeneratedHandlerError struct {
	Code    string
	Message string
}

func NewGeneratedHandlerError(codeText string, messageText string) GeneratedHandlerError {
	return GeneratedHandlerError{Code: codeText, Message: messageText}
}

func (errObj GeneratedHandlerError) Error() string {
	return errObj.Code + ": " + errObj.Message
}

type GeneratedErrorResponse struct {
	StatusCode int               `json:"statusCode"`
	Headers    map[string]string `json:"headers"`
	Body       string            `json:"body"`
}

func JSONBody(value any) string {
	bodyBytes, err := json.Marshal(value)
	if err != nil {
		return `{"code":"INTERNAL_ERROR","message":"Response serialization failed"}`
	}
	return string(bodyBytes)
}

func MapKnownError(err error, correlationID string) GeneratedErrorResponse {
	statusCode := 500
	codeText := "INTERNAL_ERROR"
	messageText := "Internal server error"
	if generatedErr, ok := err.(GeneratedHandlerError); ok {
		codeText = generatedErr.Code
		messageText = generatedErr.Message
		switch generatedErr.Code {
		case "VALIDATION_ERROR":
			statusCode = 400
		case "NOT_FOUND":
			statusCode = 404
		case "CONFLICT":
			statusCode = 409
		}
	}
	return GeneratedErrorResponse{
		StatusCode: statusCode,
		Headers: map[string]string{
			"content-type":     "application/json",
			"x-correlation-id": correlationID,
		},
		Body: JSONBody(map[string]any{"code": codeText, "message": messageText, "correlationId": correlationID}),
	}
}
