[% /* Generates the go handler artifact. */ %]package main

import (
	"context"
	"net"
	"os"
	"strings"
	"time"

	"github.com/aws/aws-lambda-go/lambda"

	"[%= emitCtx.goModulePath() %]/src/shared"

[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("custom-imports"), true)%]
// TODO: add developer-owned imports here.
[%=out.stopPreserve()%]
)

type GeneratedInput struct {
	Payload any `json:"payload,omitempty"`
}

type GeneratedResult struct {
	StatusCode int               `json:"statusCode,omitempty"`
	Headers    map[string]string `json:"headers,omitempty"`
	Body       string            `json:"body,omitempty"`
	BatchItemFailures []map[string]string `json:"batchItemFailures,omitempty"`
}

[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("custom-types"), true)%]
// TODO: add developer-owned types here.
[%=out.stopPreserve()%]

func Handler(ctx context.Context, lambdaEvt map[string]any) (GeneratedResult, error) {
	correlationID := shared.ExtractCorrelationID(lambdaEvt)
	configObj := shared.LoadConfig()
	logObj := shared.NewLogger(correlationID, "[%= awsFn.functionName.orElseText(awsFn.cfnLogicalId()) %]", configObj.Stage)
	traceObj := shared.NewTracer(correlationID, "[%= awsFn.stableKey() %]")
	metricObj := shared.NewMetrics("[%= emitCtx.get("projectSlug") %]")
[% if (awsFn.requiresIdempotency()) { %]
	idemStoreObj := shared.NewIdempotencyStore(configObj)
[% } %]
	eventPublisherObj := shared.NewEventPublisher(configObj, logObj)
	metricObj.AddMetric("Invocation", 1)

	var validatedInput GeneratedInput
	if err := shared.ValidatePayload(lambdaEvt, &validatedInput); err != nil {
		metricObj.AddMetric("ValidationError", 1)
		logObj.Error("validation failed", err)
		return mapKnownError(err, correlationID), nil
	}

[% if (awsFn.requiresIdempotency()) { %]
	idemKeyText := shared.DeriveIdempotencyKey(validatedInput)
	if previousResult, ok := idemStoreObj.Get(idemKeyText); ok {
		metricObj.AddMetric("IdempotencyHit", 1)
		if typedResult, ok := previousResult.(GeneratedResult); ok {
			return typedResult, nil
		}
	}
[% } %]

[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("custom-validation"), true)%]
	// TODO: add developer-owned validation that cannot be derived from JSON Schema.
[%=out.stopPreserve()%]

[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("business-logic"), true)%]
	return mapKnownError(
		shared.NewGeneratedHandlerError("NOT_IMPLEMENTED", "Business logic has not been implemented yet."),
		correlationID,
	), nil
[%=out.stopPreserve()%]

	generatedResult := GeneratedResult{
		StatusCode: 200,
		Headers: map[string]string{
			"content-type":     "application/json",
			"x-correlation-id": correlationID,
		},
		Body: shared.JSONBody(map[string]any{"ok": true, "correlationId": correlationID}),
	}

	if err := eventPublisherObj.PublishModeledEvents(ctx, "[%= awsFn.stableKey() %]", generatedResult); err != nil {
		metricObj.AddMetric("Error", 1)
		logObj.Error("event publishing failed", err)
		return mapKnownError(err, correlationID), nil
	}
[% if (awsFn.requiresIdempotency()) { %]
	idemStoreObj.Put(idemKeyText, generatedResult)
[% } %]
	metricObj.AddMetric("Success", 1)
	traceObj.Flush()
	metricObj.Flush()
	return generatedResult, nil
}

func mapKnownError(err error, correlationID string) GeneratedResult {
	mappedResult := shared.MapKnownError(err, correlationID)
	return GeneratedResult{
		StatusCode: mappedResult.StatusCode,
		Headers:    mappedResult.Headers,
		Body:       mappedResult.Body,
	}
}

func main() {
	waitForLambdaRuntimeAPI()
	lambda.Start(Handler)
}

func waitForLambdaRuntimeAPI() {
	runtimeAPI := os.Getenv("AWS_LAMBDA_RUNTIME_API")
	if runtimeAPI == "" {
		return
	}
	if !strings.HasPrefix(runtimeAPI, "127.0.0.1:") && !strings.HasPrefix(runtimeAPI, "localhost:") {
		return
	}

	deadline := time.Now().Add(30 * time.Second)
	for time.Now().Before(deadline) {
		conn, err := net.DialTimeout("tcp", runtimeAPI, 250*time.Millisecond)
		if err == nil {
			_ = conn.Close()
			return
		}
		time.Sleep(250 * time.Millisecond)
	}
}
