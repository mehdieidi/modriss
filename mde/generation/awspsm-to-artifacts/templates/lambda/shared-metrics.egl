[% /* Generates the shared metrics artifact. */ %]package shared

type Metrics struct {
	Namespace string
	Values    map[string]float64
}

func NewMetrics(namespace string) Metrics {
	return Metrics{Namespace: namespace, Values: map[string]float64{}}
}

func (metricObj Metrics) AddMetric(nameText string, valueNumber float64) {
	metricObj.Values[nameText] += valueNumber
}

func (metricObj Metrics) Flush() {
}
