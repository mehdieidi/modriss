import type { Context } from 'aws-lambda';
import { createLogger } from '../../shared/logger';
import { createTracer } from '../../shared/tracer';
import { createMetrics } from '../../shared/metrics';
import { validatePayload } from '../../shared/validation';
import { loadConfig } from '../../shared/config';
import { mapKnownError, GeneratedHandlerError } from '../../shared/errors';
import { createIdempotencyStore, deriveIdempotencyKey } from '../../shared/idempotency';
import { createEventPublisher } from '../../shared/event-publisher';
import schemaDoc from './schema.json';

[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("custom-imports"), true)%]
// TODO: add developer-owned imports here.
[%=out.stopPreserve()%]

export interface GeneratedInput {
  readonly payload?: unknown;
}

export interface GeneratedResult {
  readonly statusCode?: number;
  readonly headers?: Record<string, string>;
  readonly body?: unknown;
}

[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("custom-types"), true)%]
// TODO: add developer-owned types here.
[%=out.stopPreserve()%]

export async function handler(lambdaEvt: unknown, lambdaCtx: Context): Promise<GeneratedResult> {
  const correlationIdText = extractCorrelationId(lambdaEvt, lambdaCtx);
  const configObj = loadConfig(process.env);
  const logObj = createLogger({ correlationId: correlationIdText, functionName: '[%= awsFn.functionName.orElseText(awsFn.cfnLogicalId()) %]', stage: configObj.stage });
  const traceObj = createTracer({ correlationId: correlationIdText, sourceStableId: '[%= awsFn.stableKey() %]' });
  const metricObj = createMetrics({ namespace: '[%= emitCtx.get("projectSlug") %]' });
  const idemStoreObj = createIdempotencyStore(configObj);
  const eventPublisherObj = createEventPublisher(configObj, logObj);
  metricObj.addMetric('Invocation', 1);

  try {
    const validatedInput = validatePayload<GeneratedInput>(lambdaEvt, schemaDoc);

[% if (awsFn.requiresIdempotency()) { %]
    const idemKeyText = deriveIdempotencyKey(validatedInput);
    const previousResult = await idemStoreObj.get(idemKeyText);
    if (previousResult) {
      metricObj.addMetric('IdempotencyHit', 1);
      return previousResult as GeneratedResult;
    }
[% } %]

[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("custom-validation"), true)%]
    // TODO: add developer-owned validation that cannot be derived from JSON Schema.
[%=out.stopPreserve()%]

[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("business-logic"), true)%]
    throw new GeneratedHandlerError('NOT_IMPLEMENTED', 'Business logic has not been implemented yet.');
[%=out.stopPreserve()%]

    const generatedResult: GeneratedResult = {
      statusCode: 200,
      headers: { 'content-type': 'application/json', 'x-correlation-id': correlationIdText },
      body: { ok: true, correlationId: correlationIdText }
    };

    await eventPublisherObj.publishModeledEvents('[%= awsFn.stableKey() %]', generatedResult);
[% if (awsFn.requiresIdempotency()) { %]
    await idemStoreObj.put(idemKeyText, generatedResult);
[% } %]
    metricObj.addMetric('Success', 1);
    return generatedResult;
  }
  catch (errorObj) {
[%=out.startPreserve("/*", "*/", awsFn.manualRegionId("custom-error-mapping"), true)%]
    // TODO: map domain-specific errors here before generated mapping runs.
[%=out.stopPreserve()%]
    metricObj.addMetric(errorObj instanceof GeneratedHandlerError && errorObj.code === 'VALIDATION_ERROR' ? 'ValidationError' : 'Error', 1);
    logObj.error('Handler failed', { errorObj });
    return mapKnownError(errorObj, correlationIdText);
  }
  finally {
    await traceObj.flush();
    await metricObj.flush();
  }
}

function extractCorrelationId(lambdaEvt: unknown, lambdaCtx: Context): string {
  const evtObj = lambdaEvt as { headers?: Record<string, string>; requestContext?: { requestId?: string } };
  return evtObj?.headers?.['x-correlation-id'] ??
    evtObj?.headers?.['X-Correlation-Id'] ??
    evtObj?.requestContext?.requestId ??
    lambdaCtx.awsRequestId;
}
