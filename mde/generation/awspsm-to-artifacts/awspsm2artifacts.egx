rule EventBridgeRuleToFixture transform bridgeRuleObj : AWSPSMEVENTS!EventBridgeRule {
  guard : bridgeRuleObj.eventPattern.isDefined() or bridgeRuleObj.eventPatternJson.isPresent() or bridgeRuleObj.scheduleExpression.isPresent()
  template : "contracts/sample-event.egl"
  target : bridgeRuleObj.eventFixturePath()
  merge : false
  overwrite : true
  parameters : Map {
    "eventOwnerObj" = bridgeRuleObj,
    "eventKindText" = "eventbridge",
    "emitCtx" = emitCtx()
  }
  post {
    emitCtx().recordArtifact(bridgeRuleObj.eventFixturePath(), "EVENT_FIXTURE", "AWSPSM2ART_EventBridgeRule_To_Fixture", Sequence{bridgeRuleObj.stableKey()}, "OVERWRITE_GENERATED", Sequence{});
  }
}

