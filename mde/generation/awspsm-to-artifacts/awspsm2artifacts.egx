import "lib/naming.eol";
import "lib/paths.eol";
import "lib/values.eol";
import "lib/cfn.eol";
import "lib/sam.eol";
import "lib/iam.eol";
import "lib/contracts.eol";
import "lib/protected-regions.eol";
import "lib/trace.eol";
import "lib/validation.eol";

var cachedAwsRoot;
var cachedEmitCtx;

pre {
  if (AWSPSM!AwsPsmModel.all.size() <> 1) {
    throw "AWS PSM artifact generation requires exactly one AWSPSM!AwsPsmModel root; found " + AWSPSM!AwsPsmModel.all.size().asString() + ".";
  }

  cachedAwsRoot = AWSPSM!AwsPsmModel.all.first();
  cachedEmitCtx = cachedAwsRoot.defaultEmitContext();
  var issueSeq = cachedAwsRoot.collectBlockingIssues(cachedEmitCtx);
  for (issueInfo in issueSeq) {
    cachedEmitCtx.get("manualIssueList").add(issueInfo);
  }
}

operation awsRoot() {
  return cachedAwsRoot;
}

operation emitCtx() {
  return cachedEmitCtx;
}

rule ProjectScaffold {
  template : "docs/project-scaffold.egl"
  target : "generated/reports/project-scaffold.txt"
  merge : false
  overwrite : true
  parameters : Map {
    "awsRoot" = awsRoot(),
    "emitCtx" = emitCtx()
  }
  post {
    emitCtx().recordArtifact("generated/reports/project-scaffold.txt", "PROJECT_SCAFFOLD", "AWSPSM2ART_ProjectScaffold", Sequence{awsRoot().stableKey()}, "OVERWRITE_GENERATED", Sequence{});
  }
}

rule PackageManifest {
  template : "infrastructure/go-mod.egl"
  target : "go.mod"
  merge : false
  overwrite : true
  parameters : Map {
    "awsRoot" = awsRoot(),
    "emitCtx" = emitCtx()
  }
  post {
    emitCtx().recordArtifact("go.mod", "PACKAGE_MANIFEST", "AWSPSM2ART_PackageManifest", Sequence{awsRoot().stableKey()}, "OVERWRITE_GENERATED", Sequence{});
  }
}

rule Gitignore {
  template : "infrastructure/gitignore.egl"
  target : ".gitignore"
  merge : false
  overwrite : true
  parameters : Map {"awsRoot" = awsRoot(), "emitCtx" = emitCtx()}
  post {
    emitCtx().recordArtifact(".gitignore", "GITIGNORE", "AWSPSM2ART_Gitignore", Sequence{awsRoot().stableKey()}, "PRESERVE_PROTECTED_REGIONS", Sequence{awsRoot().manualRegionId("gitignore")});
  }
}

rule Makefile {
  template : "scripts/makefile.egl"
  target : "Makefile"
  merge : true
  overwrite : true
  parameters : Map {"awsRoot" = awsRoot(), "emitCtx" = emitCtx()}
  post {
    emitCtx().recordArtifact("Makefile", "MAKEFILE", "AWSPSM2ART_Makefile", Sequence{awsRoot().stableKey()}, "PRESERVE_PROTECTED_REGIONS", Sequence{awsRoot().manualRegionId("makefile-customizations")});
  }
}

rule StackToSamTemplate transform stackObj : AWSPSMCORE!SamStack {
  guard : stackObj.resources.notEmpty()
  pre {
    var stackPathText = stackObj.stackTemplatePath();
  }
  template : "infrastructure/sam-template.egl"
  target : stackPathText
  merge : true
  overwrite : true
  parameters : Map {
    "awsRoot" = awsRoot(),
    "stackObj" = stackObj,
    "emitCtx" = emitCtx()
  }
  post {
    emitCtx().recordArtifact(stackPathText, "SAM_TEMPLATE", "AWSPSM2ART_Stack_To_SamTemplate", Sequence{stackObj.stableKey()}, "PRESERVE_PROTECTED_REGIONS", Sequence{stackObj.manualRegionId("yaml-extension")});
  }
}

rule SamConfig {
  template : "infrastructure/samconfig.egl"
  target : "samconfig.toml"
  merge : true
  overwrite : true
  parameters : Map {
    "awsRoot" = awsRoot(),
    "emitCtx" = emitCtx()
  }
  post {
    emitCtx().recordArtifact("samconfig.toml", "SAM_CONFIG", "AWSPSM2ART_SamConfig", Sequence{awsRoot().stableKey()}, "PRESERVE_PROTECTED_REGIONS", Sequence{awsRoot().manualRegionId("samconfig-local-overrides")});
  }
}

rule StageEnvironment transform stageObj : AWSPSMCORE!AwsStage {
  template : "infrastructure/env-json.egl"
  target : stageObj.envPath()
  merge : false
  overwrite : true
  parameters : Map {
    "stageObj" = stageObj,
    "emitCtx" = emitCtx()
  }
  post {
    emitCtx().recordArtifact(stageObj.envPath(), "ENVIRONMENT_CONFIG", "AWSPSM2ART_Stage_Environment", Sequence{stageObj.stableKey()}, "OVERWRITE_GENERATED", Sequence{});
  }
}

rule LocalEnvironmentFile {
  guard : not AWSPSMCORE!AwsStage.all.exists(stageObj | stageObj.envPath() = "env/local.json")
  template : "infrastructure/default-env-json.egl"
  target : "env/local.json"
  merge : false
  overwrite : true
  parameters : Map {"stageNameText" = "local", "environmentClassText" = "LOCAL", "emitCtx" = emitCtx()}
  post {
    emitCtx().recordArtifact("env/local.json", "ENVIRONMENT_CONFIG", "AWSPSM2ART_Default_Local_Environment", Sequence{awsRoot().stableKey()}, "OVERWRITE_GENERATED", Sequence{});
  }
}

