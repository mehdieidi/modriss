@greedy
rule ApiToOpenApi transform apiObj : AWSPSMAPI!ApiGatewayApi {
  guard : emitCtx().get("enableOpenApi") = true and apiObj.routes.notEmpty()
  template : "contracts/openapi.egl"
  target : apiObj.openApiPath()
  merge : true
  overwrite : true
  parameters : Map {
    "apiObj" = apiObj,
    "routeSeq" = apiObj.routes,
    "emitCtx" = emitCtx()
  }
  post {
    emitCtx().recordArtifact(apiObj.openApiPath(), "OPENAPI", "AWSPSM2ART_Api_To_OpenApi", Sequence{apiObj.stableKey()}, "PRESERVE_PROTECTED_REGIONS", Sequence{apiObj.manualRegionId("openapi-extension")});
  }
}

rule WorkflowToAsl transform stateMachineObj : AWSPSMWORKFLOW!StepFunctionStateMachine {
  guard : emitCtx().get("enableAsl") = true and stateMachineObj.aslDocument.isDefined()
  template : "contracts/asl.egl"
  target : stateMachineObj.aslPath()
  merge : false
  overwrite : true
  parameters : Map {
    "stateMachineObj" = stateMachineObj,
    "aslDocObj" = stateMachineObj.aslDocument,
    "emitCtx" = emitCtx()
  }
  post {
    emitCtx().recordArtifact(stateMachineObj.aslPath(), "ASL_JSON", "AWSPSM2ART_Workflow_To_Asl", Sequence{stateMachineObj.stableKey()}, "OVERWRITE_GENERATED", Sequence{});
  }
}

rule LambdaToHandler transform awsFn : AWSPSMCOMPUTE!AwsLambdaFunction {
  guard : awsFn.code.isDefined()
  template : "lambda/go-handler.egl"
  target : awsFn.handlerPath(emitCtx())
  merge : true
  overwrite : true
  parameters : Map {
    "awsFn" = awsFn,
    "emitCtx" = emitCtx()
  }
  post {
    var regionSeq = Sequence{
      awsFn.manualRegionId("custom-imports"),
      awsFn.manualRegionId("custom-types"),
      awsFn.manualRegionId("custom-validation"),
      awsFn.manualRegionId("business-logic"),
      awsFn.manualRegionId("custom-error-mapping")
    };
    emitCtx().recordArtifact(awsFn.handlerPath(emitCtx()), "LAMBDA_HANDLER", "AWSPSM2ART_Lambda_To_Handler", Sequence{awsFn.stableKey()}, "PRESERVE_PROTECTED_REGIONS", regionSeq);
  }
}

rule LambdaToLocalSchema transform awsFn : AWSPSMCOMPUTE!AwsLambdaFunction {
  template : "contracts/json-schema.egl"
  target : awsFn.localSchemaPath(emitCtx())
  merge : false
  overwrite : true
  parameters : Map {
    "schemaOwnerObj" = awsFn,
    "schemaKindText" = "lambda-input",
    "emitCtx" = emitCtx()
  }
  post {
    emitCtx().recordArtifact(awsFn.localSchemaPath(emitCtx()), "JSON_SCHEMA", "AWSPSM2ART_Contract_To_JsonSchema", Sequence{awsFn.stableKey()}, "OVERWRITE_GENERATED", Sequence{});
  }
}

