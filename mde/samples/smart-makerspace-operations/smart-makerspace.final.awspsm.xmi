    <resources xsi:type="awspsmapi:RestApi" id="c6c49c6e-a51b-4af7-ac9b-79d5d7341295" name="Equipment Operations Context Service API" incomingTraces="655ecfd5-777b-45aa-a62a-4fd262c7d2cd" sourceQualifiedName="Api/Equipment Operations Context Service API" traceId="TR-070:d39ef661-968c-4fc4-8d77-026b7a78dbe8-&gt;api_d39ef661-968c-4fc4-8d77-026b7a78dbe8" generatedFrom="api_d39ef661-968c-4fc4-8d77-026b7a78dbe8" generatedByTransformation="true" manuallyMaintained="true" logicalId="Equipmentoperationscontextserviceapirestapi" physicalName="dev-community-makerspace-safety-and-equipment-operations-equipme" awsResourceType="AWS::Serverless::Api" resourceDescription="" retainInProduction="true" productionCritical="true" importedResource="false" deletionPolicy="RETAIN" updateReplacePolicy="RETAIN" apiName="Equipment Operations Context Service" accessLogsEnabled="true" tracingEnabled="true" metricsEnabled="true" corsEnabled="false" definitionBody="{ &quot;openapi&quot;: &quot;3.0.3&quot;, &quot;info&quot;: { &quot;title&quot;: &quot;Equipment Operations Context Service&quot;, &quot;version&quot;: &quot;1.0.0&quot; }, &quot;paths&quot;: { &quot;/equipments/reserveequipment&quot;: { &quot;post&quot;: { &quot;operationId&quot;: &quot;reserveequipment&quot;, &quot;description&quot;: &quot;Reserve available certified equipment for a member interval.&quot;, &quot;requestBody&quot;: { &quot;required&quot;: true, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/ReserveequipmentRequest&quot; } } } }, &quot;responses&quot;: { &quot;200&quot;: { &quot;description&quot;: &quot;Success&quot;, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/ReserveequipmentResponse&quot; } } } }, &quot;400&quot;: { &quot;description&quot;: &quot;Current safety certification is required for this equipment.&quot; } }, &quot;security&quot;: [ { &quot;DefaultAuthorizer&quot;: [ &quot;Member may reserve for self and must hold current equipment-class certification.&quot; ] } ] } },&quot;/equipments/authorizemachinestart&quot;: { &quot;post&quot;: { &quot;operationId&quot;: &quot;authorizemachinestart&quot;, &quot;description&quot;: &quot;Decide whether a controller may enable equipment for the presented member and reservation.&quot;, &quot;requestBody&quot;: { &quot;required&quot;: true, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/AuthorizemachinestartRequest&quot; } } } }, &quot;responses&quot;: { &quot;200&quot;: { &quot;description&quot;: &quot;Success&quot;, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/AuthorizemachinestartResponse&quot; } } } }, &quot;400&quot;: { &quot;description&quot;: &quot;Current safety certification is required for this equipment.&quot; } }, &quot;security&quot;: [ { &quot;DefaultAuthorizer&quot;: [ &quot;Member identity, reservation, certification, and equipment state must satisfy access policy.&quot; ] } ] } },&quot;/equipments/endmachinesession&quot;: { &quot;post&quot;: { &quot;operationId&quot;: &quot;endmachinesession&quot;, &quot;description&quot;: &quot;Close a machine session and release equipment.&quot;, &quot;requestBody&quot;: { &quot;required&quot;: true, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/EndmachinesessionRequest&quot; } } } }, &quot;responses&quot;: { &quot;200&quot;: { &quot;description&quot;: &quot;Success&quot;, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/EndmachinesessionResponse&quot; } } } }, &quot;400&quot;: { &quot;description&quot;: &quot;Equipment is not available for the requested operation.&quot; } }, &quot;security&quot;: [ { &quot;DefaultAuthorizer&quot;: [ &quot;Member or registered controller may end the active session for the machine.&quot; ] } ] } },&quot;/equipments&quot;: { &quot;get&quot;: { &quot;operationId&quot;: &quot;findequipmentavailability&quot;, &quot;description&quot;: &quot;Show available equipment intervals by class.&quot;, &quot;requestBody&quot;: { &quot;required&quot;: true, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/FindequipmentavailabilityQueryParameters&quot; } } } }, &quot;responses&quot;: { &quot;200&quot;: { &quot;description&quot;: &quot;Success&quot;, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/FindequipmentavailabilityResponse&quot; } } } } }, &quot;security&quot;: [ { &quot;DefaultAuthorizer&quot;: [ &quot;Authenticated members may view public equipment availability.&quot; ] } ] } },&quot;/reservations&quot;: { &quot;get&quot;: { &quot;operationId&quot;: &quot;listmemberreservations&quot;, &quot;description&quot;: &quot;List the authenticated member's reservations and session status.&quot;, &quot;requestBody&quot;: { &quot;required&quot;: true, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/ListmemberreservationsQueryParameters&quot; } } } }, &quot;responses&quot;: { &quot;200&quot;: { &quot;description&quot;: &quot;Success&quot;, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/ListmemberreservationsResponse&quot; } } } } }, &quot;security&quot;: [ { &quot;DefaultAuthorizer&quot;: [ &quot;Member may read only own reservations.&quot; ] } ] } } }, &quot;components&quot;: { &quot;schemas&quot;: { &quot;ReserveequipmentRequest&quot;: { &quot;title&quot;: &quot;ReserveEquipment Request&quot;, &quot;type&quot;: &quot;object&quot;, &quot;additionalProperties&quot;: false, &quot;properties&quot;: