    <resources xsi:type="awspsmapi:RestApi" id="be1cc148-0ed7-446a-b00e-96bb2142f1f4" name="Equipment Operations Context Service API" incomingTraces="e5ccbe75-199b-42e7-a991-3a99a2dcf36f" sourceQualifiedName="Api/Equipment Operations Context Service API" traceId="TR-070:c2c6d6ff-b45f-408b-8a27-c700cd48c09c->api_c2c6d6ff-b45f-408b-8a27-c700cd48c09c" generatedFrom="api_c2c6d6ff-b45f-408b-8a27-c700cd48c09c" generatedByTransformation="true" manuallyMaintained="false" logicalId="Equipmentoperationscontextserviceapirestapi" physicalName="dev-community-makerspace-safety-and-equipment-operations-equip-2" awsResourceType="AWS::Serverless::Api" resourceDescription="" retainInProduction="true" productionCritical="true" importedResource="false" deletionPolicy="RETAIN" updateReplacePolicy="RETAIN" apiName="Equipment Operations Context Service" accessLogsEnabled="true" tracingEnabled="true" metricsEnabled="true" corsEnabled="false" definitionBody="{ &quot;openapi&quot;: &quot;3.0.3&quot;, &quot;info&quot;: { &quot;title&quot;: &quot;Equipment Operations Context Service&quot;, &quot;version&quot;: &quot;1.0.0&quot; }, &quot;paths&quot;: { &quot;/equipments/reserveequipment&quot;: { &quot;post&quot;: { &quot;operationId&quot;: &quot;reserveequipment&quot;, &quot;description&quot;: &quot;Reserve available certified equipment for a member interval.&quot;, &quot;requestBody&quot;: { &quot;required&quot;: true, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/ReserveequipmentRequest&quot; } } } }, &quot;responses&quot;: { &quot;200&quot;: { &quot;description&quot;: &quot;Success&quot;, &quot;content&quot;: { &quot;application/json&quot;: { &quot;schema&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/ReserveequipmentResponse&quot; } } } }, &quot;400&quot;: { &quot;description&quot;: &quot;Current safety certification is required for this equipment.&quot; } }, &quot;security&quot;: [ { &quot;DefaultAuthorizer&