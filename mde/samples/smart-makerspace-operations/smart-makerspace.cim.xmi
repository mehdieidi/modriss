" name="Member Activity Export" source="member" stimulus="requests an activity data export" environment="normal operations" artifact="member activity records" response="returns authorized portable records without other members' data" responseMeasure="100 percent scoped to requesting member" qualityType="PRIVACY" summary="Privacy rights scenario." rationale="Privacy control."/></requirements>
