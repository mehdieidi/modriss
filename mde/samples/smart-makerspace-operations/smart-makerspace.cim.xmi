  <informationItems xmi:id="info-reservation-id" id="info-reservation-id" name="ReservationId" businessName="Reservation identifier" type="IDENTIFIER" required="true" example="res-4401" sourceOfTruth="equipment operations register" auditRelevant="true" searchRelevant="true" classification="class-safety" summary="Stable equipment booking identity." rationale="Reservation semantics."/>
