  <informationItems xmi:id="info-equipment-class" id="info-equipment-class" name="EquipmentClass" businessName="Equipment safety class" type="ENUMERATION" required="true" allowedValues="LASER_CUTTER CNC_ROUTER METAL_LATHE" sourceOfTruth="equipment register" searchRelevant="true" classification="class-public" summary="Groups equipment by required training." rationale="Certification matching."/>
