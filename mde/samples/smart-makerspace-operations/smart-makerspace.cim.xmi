  <events xmi:id="evt-access-authorized" id="evt-access-authorized" name="MachineAccessAuthorized" semanticName="machine.access-authorized" occurredInPastTenseName="MachineAccessAuthorized" businessMeaning="Access policy allowed a controller to enable a machine." businessTimestampItemName="authorizedAt" correlationBusinessKey="sessionId" causationBusinessKey="controllerRequestId" orderingKeyCandidate="equipmentId" externallyVisible="true" auditRelevant="true" retentionRelevant="true" semanticVersion="1.0.0" versioningRationale="Initial contract." eventTimeSemantics="RECORDING_TIME" consumedByExternalSystems="ext-controller" payload="info-session-id info-member-id info-equipment-id info-access-decision" affects="entity-session entity-equipment" summary="Auditable physical-access decision." rationale="Access authorization outcome."/>
