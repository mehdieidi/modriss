  <aggregates xmi:id="agg-qualification" id="agg-qualification" name="MemberQualificationAggregate" glossaryDefinition="Consistent record of one member and the certifications that authorize equipment use." consistencyBoundaryRationale="Certification issuance and member qualification history change atomically." conflictResolutionPolicy="Newest reviewed certification decision wins; revocation always wins." idempotencyBusinessKey="memberId-equipmentClass-assessmentId" strongConsistencyRequired="true" consistencyExpectation="SINGLE_ENTITY" root="entity-member" members="entity-member entity-certification" context="bc-qualification" handledCommands="cmd-certify" summary="Qualification consistency boundary." rationale="Safety authorization source of truth."/>
  <aggregates xmi:id="agg-operations" id="agg-operations" name="EquipmentOperationsAggregate" glossaryDefinition="Consistent operational record for a machine, its reservations, and its active sessions." consistencyBoundaryRationale="Reservation overlap, equipment availability, and session authorization require a consistent decision." conflictResolutionPolicy="Lockout overrides reservation and session state." idempotencyBusinessKey="equipmentId-operationId" strongConsistencyRequired="true" consistencyExpectation="MULTI_ENTITY_STRONG_CONSISTENCY" root="entity-equipment" members="entity-equipment entity-reservation entity-session" context="bc-operations" handledCommands="cmd-reserve cmd-start cmd-end" emittedEvents="evt-reservation-confirmed evt-access-authorized evt-session-started evt-session-ended" summary="Equipment scheduling and access boundary." rationale="Prevents double booking and unsafe start."/>
  <aggregates xmi:id="agg-incident" id="agg-incident" name="IncidentRecoveryAggregate" glossaryDefinition="Consistent safety case connecting an incident to machine lockout and restoration evidence." consistencyBoundaryRationale="Incident state and equipment lockout must remain aligned." conflictResolutionPolicy="Any unresolved critical incident keeps equipment locked." idempotencyBusinessKey="equipmentId-signalId" strongConsistencyRequired="true" consistencyExpectation="MULTI_ENTITY_STRONG_CONSISTENCY" root="entity-incident" members="entity-incident entity-equipment" context="bc-maintenance" handledCommands="cmd-resolve-incident" emittedEvents="evt-machine-locked evt-equipment-restored" summary="Incident containment consistency boundary." rationale="Safety recovery source of truth."/>
  <conditions xmi:id="cond-certified" id="cond-certified" name="MemberCertificationIsCurrent" naturalLanguage="Member has an unexpired, non-revoked certification for the equipment class." expression="certification.active and certification.expiry &gt; now" mustBeAutomatable="true" expressionLanguage="FEEL" referencedInformation="info-member-id info-equipment-class info-cert-expiry" referencedConcepts="entity-member entity-certification" summary="Qualification precondition." rationale="Safety policy."/>
  <conditions xmi:id="cond-slot" id="cond-slot" name="EquipmentSlotIsAvailable" naturalLanguage="Equipment is available and the requested interval does not overlap another confirmed reservation." expression="equipment.available and not overlaps(requestedInterval)" mustBeAutomatable="true" expressionLanguage="FEEL" referencedInformation="info-equipment-id info-start-time info-end-time" referencedConcepts="entity-equipment entity-reservation" summary="Booking precondition." rationale="Fair scheduling."/>
  <conditions xmi:id="cond-access" id="cond-access" name="SessionAccessIsAllowed" naturalLanguage="Reservation is current, certification is current, member matches, and equipment is not locked." expression="reservation.current and certification.current and member.matches and not equipment.locked" mustBeAutomatable="true" expressionLanguage="FEEL" referencedInformation="info-member-id info-equipment-id info-reservation-id" referencedConcepts="entity-certification entity-reservation entity-equipment" summary="Machine enablement decision." rationale="Access policy."/>
  <conditions xmi:id="cond-repaired" id="cond-repaired" name="ReturnToServiceChecklistComplete" naturalLanguage="Diagnosis, repair, inspection, and independent safety check are complete." expression="diagnosis.complete and repair.complete and inspection.passed" mustBeAutomatable="false" expressionLanguage="FEEL" referencedInformation="info-resolution" referencedConcepts="entity-incident entity-equipment" summary="Maintenance completion gate." rationale="Recovery policy."/>
  <businessErrors xmi:id="err-not-certified" id="err-not-certified" name="CertificationRequired" errorCode="SAFETY_CERT_REQUIRED" businessMeaning="Member lacks current certification for the equipment class." userVisibleMessage="Current safety certification is required for this equipment." recoverable="true" retryMeaningful="false" auditRequired="true" summary="Safety authorization rejection." rationale="Member guidance."/>
  <businessErrors xmi:id="err-unavailable" id="err-unavailable" name="EquipmentUnavailable" errorCode="EQUIPMENT_UNAVAILABLE" businessMeaning="Equipment is booked, in use, locked, or under maintenance." userVisibleMessage="Equipment is not available for the requested operation." recoverable="true" retryMeaningful="true" auditRequired="false" summary="Availability conflict." rationale="Scheduling behavior."/>
  <commands xmi:id="cmd-certify" id="cmd-certify" name="RecordEquipmentCertification" intent="Record a reviewed member competency decision." userInitiated="true" duplicateSubmissionPossible="true" idempotencyBusinessKey="assessmentId" auditRequired="true" authorizationRequired="true" authorizationRule="Actor must hold Certification Assessor role for the equipment class." commandType="USER_INTENT" interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" priority="HIGH" issuedBy="actor-instructor" targetCapability="cap-membership" targetAggregate="agg-qualification" input="info-member-id info-equipment-class info-cert-expiry" preconditions="cond-certified" expectedEvents="evt-certified" summary="Issues time-bounded qualification." rationale="Training completion action."><outcomes xmi:id="out-cert" id="out-cert" name="Certification Recorded" success="true" resultDescription="Certification is active and auditable." emittedEvents="evt-certified" output="info-cert-id info-cert-expiry" summary="Successful certification." rationale="Command result."/></commands>
  <commands xmi:id="cmd-reserve" id="cmd-reserve" name="ReserveEquipment" intent="Reserve available certified equipment for a member interval." userInitiated="true" duplicateSubmissionPossible="true" idempotencyBusinessKey="memberId-equipmentId-startTime" auditRequired="true" authorizationRequired="true" authorizationRule="Member may reserve for self and must hold current equipment-class certification." commandType="USER_INTENT" interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" priority="HIGH" issuedBy="actor-member" targetCapability="cap-reservation" targetAggregate="agg-operations" input="info-member-id info-equipment-id info-start-time info-end-time" preconditions="cond-certified cond-slot" expectedEvents="evt-reservation-confirmed" possibleErrors="err-not-certified err-unavailable" summary="Creates a conflict-free equipment booking." rationale="Member booking journey."><outcomes xmi:id="out-reserve" id="out-reserve" name="Reservation Confirmed" success="true" resultDescription="A reservation is confirmed." emittedEvents="evt-reservation-confirmed" output="info-reservation-id" summary="Successful reservation." rationale="Command result."/><outcomes xmi:id="out-reserve-error" id="out-reserve-error" name="Reservation Rejected" success="false" resultDescription="Certification or availability rule was not satisfied." errors="err-not-certified err-unavailable" summary="Rejected reservation." rationale="Command error result."/></commands>
  <commands xmi:id="cmd-start" id="cmd-start" name="AuthorizeMachineStart" intent="Decide whether a controller may enable equipment for the presented member and reservation." userInitiated="true" duplicateSubmissionPossible="true" idempotencyBusinessKey="reservationId-controllerRequestId" auditRequired="true" authorizationRequired="true" authorizationRule="Member identity, reservation, certification, and equipment state must satisfy access policy." commandType="EXTERNAL_SYSTEM_INTENT" interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" priority="CRITICAL" issuedBy="actor-member ext-controller" targetCapability="cap-reservation" targetAggregate="agg-operations" input="info-member-id info-equipment-id info-reservation-id" preconditions="cond-access" expectedEvents="evt-access-authorized evt-session-started" possibleErrors="err-not-certified err-unavailable" summary="Produces the physical machine-access decision." rationale="Safety-critical controller request."><outcomes xmi:id="out-start" id="out-start" name="Machine Start Authorized" success="true" resultDescription="Controller may enable the machine for this session." emittedEvents="evt-access-authorized evt-session-started" output="info-session-id info-access-decision" summary="Successful access decision." rationale="Command result."/><outcomes xmi:id="out-start-error" id="out-start-error" name="Machine Start Denied" success="false" resultDescription="Certification, reservation, identity, or equipment-state rule failed." errors="err-not-certified err-unavailable" summary="Rejected machine start." rationale="Command error result."/></commands>
  <commands xmi:id="cmd-end" id="cmd-end" name="EndMachineSession" intent="Close a machine session and release equipment." userInitiated="true" duplicateSubmissionPossible="true" idempotencyBusinessKey="sessionId" auditRequired="true" authorizationRequired="true" authorizationRule="Member or registered controller may end the active session for the machine." commandType="USER_INTENT" interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" priority="HIGH" issuedBy="actor-member ext-controller" targetCapability="cap-reservation" targetAggregate="agg-operations" input="info-session-id info-equipment-id" possibleErrors="err-unavailable" expectedEvents="evt-session-ended" summary="Completes actual machine use." rationale="Session lifecycle."><outcomes xmi:id="out-end" id="out-end" name="Session Ended" success="true" resultDescription="Session is closed and equipment can become available." emittedEvents="evt-session-ended" output="info-session-id" summary="Successful session closure." rationale="Command result."/><outcomes xmi:id="out-end-error" id="out-end-error" name="Session End Rejected" success="false" resultDescription="No matching active session exists." errors="err-unavailable" summary="Rejected session closure." rationale="Command error result."/></commands>
  <commands xmi:id="cmd-resolve-incident" id="cmd-resolve-incident" name="ResolveSafetyIncident" intent="Record maintenance evidence and return safe equipment to service." userInitiated="true" duplicateSubmissionPossible="true" idempotencyBusinessKey="incidentId-resolutionRevision" auditRequired="true" authorizationRequired="true" authorizationRule="Equipment Maintainer must complete the checklist and independent safety verification." commandType="CORRECTION" interactionExpectation="HUMAN_REVIEW_REQUIRED" priority="CRITICAL" issuedBy="actor-technician" targetCapability="cap-maintenance" targetAggregate="agg-incident" input="info-incident-id info-resolution" preconditions="cond-repaired" expectedEvents="evt-equipment-restored" summary="Closes recovery after verified repair." rationale="Maintenance workflow."><outcomes xmi:id="out-resolve" id="out-resolve" name="Equipment Restored" success="true" resultDescription="Incident is resolved and equipment returns to available state." emittedEvents="evt-equipment-restored" output="info-incident-id info-equipment-id" summary="Successful recovery." rationale="Command result."/></commands>
