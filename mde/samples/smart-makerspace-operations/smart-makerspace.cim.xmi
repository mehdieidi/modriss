<?xml version="1.0" encoding="utf-8"?>
<cim:CIMModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cim="https://varka.org/cim/1.0" xmlns:cimorg="https://varka.org/cim/organization/1.0" xmlns:cimdomain="https://varka.org/cim/domain-data/1.0" xmlns:cimbehavior="https://varka.org/cim/behavior/1.0" xmlns:cimprocess="https://varka.org/cim/process-policy/1.0" xmlns:cimgov="https://varka.org/cim/governance/1.0" xmlns:cimtransform="https://varka.org/cim/transformation/1.0" xmlns:kernel="https://varka.org/kernel/1.0" xmi:id="makerspace-root" id="makerspace-root" name="SmartMakerspaceOperations" domainName="Community Makerspace Safety and Equipment Operations" businessScope="Member certification, equipment reservation, safe access authorization, machine session monitoring, incident lockout, and maintenance recovery." organizationName="Northstar Community Makerspace" modelingDate="2026-06-19T00:00:00.000Z" language="en" lifecycleStatus="APPROVED" summary="Provider-neutral business model for safe shared fabrication equipment operations." rationale="Supports an interactive workshop demo spanning member APIs, IoT events, scheduling, safety workflows, and operations governance.">
  <goals xmi:id="goal-safe" id="goal-safe" name="Prevent Unsafe Equipment Use" successCriterion="Every machine session starts only for a currently certified member and an available machine." businessValue="Protects members, equipment, and the makerspace license to operate." failureConsequence="Injury, equipment damage, or forced closure." priority="CRITICAL" measuredBy="kpi-unsafe" owners="stakeholder-safety" summary="Make authorization verifiable before physical equipment use." rationale="Safety charter objective."/>
  <goals xmi:id="goal-utilization" id="goal-utilization" name="Increase Fair Equipment Utilization" successCriterion="At least 75 percent of bookable hours are used while no-show time stays below 10 percent." businessValue="Expands member access without purchasing unnecessary equipment." failureConsequence="Long waits, idle machines, and poor member value." priority="HIGH" measuredBy="kpi-utilization" owners="stakeholder-ops" summary="Balance access, capacity, and fairness." rationale="Annual operating plan."/>
  <goals xmi:id="goal-recovery" id="goal-recovery" name="Restore Equipment Predictably" successCriterion="Critical incidents create an immediate lockout and an owned maintenance case within one minute." businessValue="Limits secondary damage and shortens downtime." failureConsequence="Unsafe reuse and extended outages." priority="CRITICAL" measuredBy="kpi-lockout" owners="stakeholder-technician" summary="Turn incidents into controlled recovery work." rationale="Maintenance review."/>
  <kpis xmi:id="kpi-unsafe" id="kpi-unsafe" name="Unauthorized Session Rate" metricName="unauthorized session starts" metricDefinition="Count of sessions begun without valid certification and reservation authorization." operator="=" targetValue="0" unit="sessions per month" measurementFrequency="monthly" dataSource="access decision and session event log" acceptanceThreshold="zero" measures="goal-safe" summary="Primary safety outcome measure." rationale="Safety committee metric."/>
  <kpis xmi:id="kpi-utilization" id="kpi-utilization" name="Bookable Equipment Utilization" metricName="utilized bookable time" metricDefinition="Completed session minutes divided by available bookable minutes." operator=">=" targetValue="75" unit="percent" measurementFrequency="weekly" dataSource="reservation and session records" acceptanceThreshold="75 percent" measures="goal-utilization" summary="Measures productive access to shared equipment." rationale="Operations metric."/>
  <kpis xmi:id="kpi-lockout" id="kpi-lockout" name="Incident Lockout Latency" metricName="incident-to-lockout latency" metricDefinition="Elapsed time between critical incident receipt and machine lockout confirmation." operator="&lt;=" targetValue="60" unit="seconds" measurementFrequency="per incident" dataSource="incident and lockout events" acceptanceThreshold="60 seconds" measures="goal-recovery" summary="Measures safety response speed." rationale="Incident response target."/>
  <stakeholders xmi:id="stakeholder-safety" id="stakeholder-safety" name="Safety Program Lead" stakeholderType="safety governance" concern="Only trained members operate hazardous equipment." influenceLevel="high" contactRole="Safety Lead" ownsGoals="goal-safe" summary="Owns training and safe-use policy." rationale="Operating charter."/>
  <stakeholders xmi:id="stakeholder-ops" id="stakeholder-ops" name="Workshop Operations Manager" stakeholderType="operations" concern="Fair access and high equipment availability." influenceLevel="high" contactRole="Operations Manager" ownsGoals="goal-utilization" summary="Owns daily workshop capacity." rationale="Operating model."/>
  <stakeholders xmi:id="stakeholder-technician" id="stakeholder-technician" name="Equipment Maintenance Lead" stakeholderType="maintenance" concern="Actionable incidents and controlled return to service." influenceLevel="high" contactRole="Maintenance Lead" ownsGoals="goal-recovery" summary="Owns maintenance recovery." rationale="Maintenance handbook."/>
  <actors xmi:id="actor-member" id="actor-member" name="Makerspace Member" actorType="HUMAN" trustLevel="PARTIALLY_TRUSTED" organizationBoundary="community member" authenticationExpectation="Verified member identity with step-up verification for machine access." authorizationExpectation="May reserve and start only equipment covered by active certification." interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" playsRoles="role-member" issuesCommands="cmd-reserve cmd-start cmd-end" issuesQueries="qry-availability qry-my-reservations" summary="Person using shared equipment." rationale="Member journey workshop."/>
  <actors xmi:id="actor-instructor" id="actor-instructor" name="Safety Instructor" actorType="HUMAN" trustLevel="TRUSTED_INTERNAL" organizationBoundary="makerspace staff" authenticationExpectation="Workforce identity with strong authentication." authorizationExpectation="May record certification only for assigned equipment classes." interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" playsRoles="role-instructor" issuesCommands="cmd-certify" summary="Assesses member competence." rationale="Training process."/>
  <actors xmi:id="actor-technician" id="actor-technician" name="Maintenance Technician" actorType="HUMAN" trustLevel="TRUSTED_INTERNAL" organizationBoundary="makerspace staff" authenticationExpectation="Workforce identity with strong authentication." authorizationExpectation="May diagnose lockouts and return equipment to service after checklist completion." interactionExpectation="HUMAN_REVIEW_REQUIRED" playsRoles="role-technician" issuesCommands="cmd-resolve-incident" issuesQueries="qry-maintenance" summary="Restores equipment after incidents." rationale="Maintenance process."/>
  <actors xsi:type="cimorg:ExternalSystem" xmi:id="ext-controller" id="ext-controller" name="Equipment Access Controller Network" actorType="EXTERNAL_SYSTEM" trustLevel="PARTIALLY_TRUSTED" organizationBoundary="on-premises device network" authenticationExpectation="Each controller presents a managed device credential." authorizationExpectation="Controllers may request access decisions and publish events only for their registered machine." interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" owningOrganization="Northstar Community Makerspace" businessPurpose="Controls machine enablement and reports session and safety signals." trustRationale="Managed devices are authenticated but physically exposed." contractualSla="Local controller requests receive a decision within five seconds." storesBusinessData="false" sendsBusinessEvents="true" receivesBusinessEvents="true" exchangedInformation="info-equipment-id info-member-id info-session-id info-signal" producedEvents="evt-session-started evt-incident" consumedEvents="evt-access-authorized evt-machine-locked" summary="Boundary to physical equipment controllers." rationale="Device integration workshop."/>
  <actors xsi:type="cimorg:ExternalSystem" xmi:id="ext-notification" id="ext-notification" name="Member Notification Service" actorType="EXTERNAL_SYSTEM" trustLevel="REGULATED_EXTERNAL" organizationBoundary="external communications provider" authenticationExpectation="Organization-managed machine credential." authorizationExpectation="Receives only approved notification destination and template data." interactionExpectation="RESPONSE_CAN_BE_DELAYED" owningOrganization="Communications Partner" businessPurpose="Delivers reservation reminders and operational notices." trustRationale="Contracted processor with restricted information scope." contractualSla="Notifications accepted within thirty seconds." storesBusinessData="true" sendsBusinessEvents="false" receivesBusinessEvents="true" exchangedInformation="info-contact info-reservation-id" consumedEvents="evt-reservation-confirmed evt-machine-locked" summary="Boundary for member notifications." rationale="Member communications need."/>
  <roles xmi:id="role-member" id="role-member" name="Equipment User" responsibility="Reserve and safely operate certified equipment." businessPermissionSummary="Manage own reservations and sessions for certified equipment." privileged="false" assignedTo="actor-member" summary="Member operating role." rationale="Access policy."/>
  <roles xmi:id="role-instructor" id="role-instructor" name="Certification Assessor" responsibility="Assess training evidence and grant time-limited certifications." businessPermissionSummary="Record certification decisions for assigned equipment classes." privileged="true" assignedTo="actor-instructor" summary="Training decision role." rationale="Safety policy."/>
  <roles xmi:id="role-technician" id="role-technician" name="Equipment Maintainer" responsibility="Investigate incidents and authorize return to service." businessPermissionSummary="Read incident evidence, maintain equipment state, and complete recovery." privileged="true" assignedTo="actor-technician" summary="Maintenance role." rationale="Maintenance policy."/>
  <capabilities xmi:id="cap-membership" id="cap-membership" name="Member Safety Qualification" responsibility="Maintain member equipment certifications." owner="actor-instructor" maturity="managed" criticality="CORE" supports="goal-safe" realizesRequirements="sec-machine-access comp-safety-evidence" constrainedBy="sec-machine-access comp-safety-evidence" containsCommands="cmd-certify" managesEntities="entity-member entity-certification" summary="Owns competence evidence and certification state." rationale="Safety bounded context."/>
  <capabilities xmi:id="cap-reservation" id="cap-reservation" name="Equipment Reservation and Access" responsibility="Offer fair reservation and authorize valid machine sessions." ownerName="Workshop Operations" maturity="managed" criticality="MISSION_CRITICAL" supports="goal-safe goal-utilization" realizesRequirements="req-reservation nfr-access-latency sec-machine-access priv-member" constrainedBy="nfr-access-latency sec-machine-access priv-member" containsCommands="cmd-reserve cmd-start cmd-end" containsQueries="qry-availability qry-my-reservations" containsEvents="evt-reservation-confirmed evt-access-authorized evt-session-started evt-session-ended" managesEntities="entity-equipment entity-reservation entity-session" ownsProcesses="proc-session" summary="Owns bookable access and session lifecycle." rationale="Core member experience."/>
  <capabilities xmi:id="cap-maintenance" id="cap-maintenance" name="Incident and Maintenance Recovery" responsibility="Lock unsafe equipment, investigate incidents, and control return to service." owner="actor-technician" maturity="managed" criticality="MISSION_CRITICAL" supports="goal-recovery goal-safe" realizesRequirements="req-lockout comp-safety-evidence" constrainedBy="comp-safety-evidence" containsCommands="cmd-resolve-incident" containsQueries="qry-maintenance" containsEvents="evt-incident evt-machine-locked evt-equipment-restored" managesEntities="entity-incident" ownsProcesses="proc-recovery" summary="Owns incident containment and repair." rationale="Safety recovery boundary."/>
  <capabilityDependencies xmi:id="capdep-access-cert" id="capdep-access-cert" name="Access depends on qualification" dependencyReason="An access decision requires current certification." criticalPath="true" source="cap-reservation" target="cap-membership" summary="Safety-critical capability dependency." rationale="Access policy."/>
  <capabilityDependencies xmi:id="capdep-access-maint" id="capdep-access-maint" name="Access depends on machine health" dependencyReason="Locked or maintenance equipment cannot be reserved or started." criticalPath="true" source="cap-reservation" target="cap-maintenance" summary="Availability dependency." rationale="Machine-state policy."/>
  <boundedContexts xmi:id="bc-qualification" id="bc-qualification" name="Safety Qualification Context" languageBoundary="training, assessment, certification, expiry" ownershipBoundary="Safety Program" externalIntegrationBoundary="false" capabilities="cap-membership" entities="entity-member entity-certification" commands="cmd-certify" summary="Boundary for qualification decisions." rationale="Distinct safety language and ownership.">
    <glossaryTerms xmi:id="term-cert" id="term-cert" name="Certification Term" term="Certification" definition="Time-bounded evidence that a member may operate an equipment class." forbiddenSynonyms="permission" exampleUsage="The laser-cutter certification expires next month."  summary="Shared qualification term." rationale="Domain workshop." />
  </boundedContexts>
  <boundedContexts xmi:id="bc-operations" id="bc-operations" name="Equipment Operations Context" languageBoundary="equipment, reservation, session, access decision" ownershipBoundary="Workshop Operations" externalIntegrationBoundary="true" capabilities="cap-reservation" entities="entity-equipment entity-reservation entity-session" commands="cmd-reserve cmd-start cmd-end" queries="qry-availability qry-my-reservations" events="evt-reservation-confirmed evt-access-authorized evt-session-started evt-session-ended" summary="Boundary for member equipment use." rationale="Operational transaction boundary.">
    <glossaryTerms xmi:id="term-session" id="term-session" name="Machine Session Term" term="Machine Session" definition="Authorized interval during which one member controls one machine." forbiddenSynonyms="login" exampleUsage="The machine session ended normally."  summary="Shared operations term." rationale="Domain workshop." />
  </boundedContexts>
  <boundedContexts xmi:id="bc-maintenance" id="bc-maintenance" name="Maintenance Recovery Context" languageBoundary="incident, lockout, diagnosis, restoration" ownershipBoundary="Maintenance Team" externalIntegrationBoundary="true" capabilities="cap-maintenance" entities="entity-incident" commands="cmd-resolve-incident" queries="qry-maintenance" events="evt-incident evt-machine-locked evt-equipment-restored" summary="Boundary for safety recovery." rationale="Independent maintenance responsibility.">
    <glossaryTerms xmi:id="term-lockout" id="term-lockout" name="Lockout Term" term="Lockout" definition="Business state that prohibits new sessions until maintenance restoration." forbiddenSynonyms="disable flag" exampleUsage="The incident placed the machine in lockout."  summary="Shared safety term." rationale="Safety handbook." />
  </boundedContexts>
