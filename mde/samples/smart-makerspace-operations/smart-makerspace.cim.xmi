  <events xmi:id="evt-incident" id="evt-incident" name="CriticalSafetyIncidentDetected" semanticName="safety.incident-detected" occurredInPastTenseName="CriticalSafetyIncidentDetected" businessMeaning="A controller reported a safety signal requiring immediate containment." businessTimestampItemName="detectedAt" correlationBusinessKey="incidentId" causationBusinessKey="signalId" orderingKeyCandidate="equipmentId" externallyVisible="false" auditRelevant="true" retentionRelevant="true" semanticVersion="1.0.0" versioningRationale="Initial contract." eventTimeSemantics="OBSERVATION_TIME" causedByExternalSystems="ext-controller" consumedByProcesses="proc-recovery" payload="info-incident-id info-equipment-id info-session-id info-signal" affects="entity-incident entity-equipment entity-session" summary="Starts safety recovery." rationale="Critical controller signal."/>
  <events xmi:id="evt-machine-locked" id="evt-machine-locked" name="MachineLocked" semanticName="machine.locked" occurredInPastTenseName="MachineLocked" businessMeaning="Equipment entered lockout and cannot start sessions." businessTimestampItemName="lockedAt" correlationBusinessKey="incidentId" causationBusinessKey="incidentEventId" orderingKeyCandidate="equipmentId" externallyVisible="true" auditRelevant="true" retentionRelevant="true" semanticVersion="1.0.0" versioningRationale="Initial contract." eventTimeSemantics="RECORDING_TIME" consumedByExternalSystems="ext-controller ext-notification" payload="info-incident-id info-equipment-id" affects="entity-incident entity-equipment" summary="Confirms immediate containment." rationale="Incident policy outcome."/>
  <events xmi:id="evt-equipment-restored" id="evt-equipment-restored" name="EquipmentRestoredToService" semanticName="equipment.restored" occurredInPastTenseName="EquipmentRestoredToService" businessMeaning="Maintenance verification allowed equipment to accept reservations and sessions again." businessTimestampItemName="restoredAt" correlationBusinessKey="incidentId" causationBusinessKey="resolutionId" orderingKeyCandidate="equipmentId" externallyVisible="true" auditRelevant="true" retentionRelevant="true" semanticVersion="1.0.0" versioningRationale="Initial contract." eventTimeSemantics="BUSINESS_TIME" payload="info-incident-id info-equipment-id info-resolution" affects="entity-incident entity-equipment" summary="Closes maintenance recovery." rationale="Resolution outcome."/>
  <policies xmi:id="pol-access" id="pol-access" name="Certified Access Policy" naturalLanguageRule="Machine access is authorized only for the matching member, current reservation, current equipment-class certification, and non-locked equipment." expression="memberMatches and reservationCurrent and certificationCurrent and equipmentAvailable" auditRequired="true" policyType="AUTHORIZATION" expressionLanguage="FEEL" enforcementStrength="BLOCKING" violationSeverity="CRITICAL" guards="cmd-reserve cmd-start" emitsEvents="evt-access-authorized" summary="Central machine access rule." rationale="Safety charter."/>
  <policies xmi:id="pol-lockout" id="pol-lockout" name="Critical Incident Lockout Policy" naturalLanguageRule="A critical safety incident immediately locks equipment and cancels any active authorization." expression="incident.critical implies equipment.locked" auditRequired="true" policyType="REACTION" expressionLanguage="FEEL" enforcementStrength="BLOCKING" violationSeverity="CRITICAL" triggeredBy="evt-incident" emitsEvents="evt-machine-locked" summary="Automated incident containment rule." rationale="Incident response handbook."/>
  <policies xmi:id="pol-no-show" id="pol-no-show" name="Reservation No Show Policy" naturalLanguageRule="A reservation not started within fifteen minutes releases the equipment interval." expression="not session.started and now &gt; reservation.start + duration('PT15M')" auditRequired="false" policyType="REACTION" expressionLanguage="FEEL" enforcementStrength="MANDATORY" violationSeverity="WARNING" triggeredBy="evt-reservation-confirmed" emitsEvents="evt-session-ended" summary="Fair-use capacity release rule." rationale="Member booking policy."/>
  <processes xmi:id="proc-session" id="proc-session" name="Reserve and Operate Equipment" businessTriggerDescription="A member searches for equipment and requests a time slot." longRunning="true" humanApprovalPossible="false" compensationExpected="true" completionCriterion="Session ends or reservation is released without machine use." processKind="LONG_RUNNING" criticality="MISSION_CRITICAL" owningCapability="cap-reservation" triggeringActor="actor-member" triggeringCommand="cmd-reserve" trigger="cmd-reserve" summary="Member journey from booking through machine release." rationale="Primary demo workflow.">
    <steps xsi:type="cimprocess:StartStep" xmi:id="sess-start" id="sess-start" name="Reservation Journey Starts" orderIndex="1" optional="false" repeatable="false" responsibility="Accept member booking intent." stepKind="START" summary="Process start." rationale="Workflow entry."/>
    <steps xsi:type="cimprocess:QueryStep" xmi:id="sess-find" id="sess-find" name="Find Available Equipment" orderIndex="2" optional="false" repeatable="true" responsibility="Present bookable slots." stepKind="QUERY" query="qry-availability" responsibleRoles="role-member" summary="Availability lookup." rationale="Member choice."/>
    <steps xsi:type="cimprocess:CommandStep" xmi:id="sess-reserve" id="sess-reserve" name="Confirm Reservation" orderIndex="3" optional="false" repeatable="false" responsibility="Create conflict-free booking." stepKind="COMMAND" command="cmd-reserve" responsibleRoles="role-member" summary="Reservation command." rationale="Booking state change."/>
    <steps xsi:type="cimprocess:WaitStep" xmi:id="sess-wait" id="sess-wait" name="Wait for Reserved Start" orderIndex="4" optional="false" repeatable="false" responsibility="Wait until access window." stepKind="WAIT" waitReason="Reservation has not started." durationExpression="until reservedStartTime" summary="Long-running wait." rationale="Reservation timing."/>
    <steps xsi:type="cimprocess:CommandStep" xmi:id="sess-authorize" id="sess-authorize" name="Authorize Machine Access" orderIndex="5" optional="false" repeatable="false" responsibility="Evaluate certification, booking, identity, and machine state." stepKind="COMMAND" command="cmd-start" responsibleRoles="role-member" summary="Safety access decision." rationale="Physical enablement."/>
    <steps xsi:type="cimprocess:EventStep" xmi:id="sess-observe" id="sess-observe" name="Observe Session Completion" orderIndex="6" optional="false" repeatable="false" responsibility="Record machine-use completion." stepKind="EVENT" event="evt-session-ended" summary="Controller completion event." rationale="Session closure."/>
    <steps xsi:type="cimprocess:EndStep" xmi:id="sess-end" id="sess-end" name="Equipment Use Completed" orderIndex="7" optional="false" repeatable="false" responsibility="Release equipment and close journey." stepKind="END" summary="Process end." rationale="Workflow completion."/>
    <transitions xmi:id="st-1" id="st-1" name="Start to search" orderIndex="1" source="sess-start" target="sess-find" summary="Process transition." rationale="Workflow order."/><transitions xmi:id="st-2" id="st-2" name="Search to reserve" orderIndex="2" source="sess-find" target="sess-reserve" summary="Process transition." rationale="Workflow order."/><transitions xmi:id="st-3" id="st-3" name="Reserve to wait" orderIndex="3" source="sess-reserve" target="sess-wait" summary="Process transition." rationale="Workflow order."/><transitions xmi:id="st-4" id="st-4" name="Wait to authorize" orderIndex="4" source="sess-wait" target="sess-authorize" summary="Process transition." rationale="Workflow order."/><transitions xmi:id="st-5" id="st-5" name="Authorize to completion" orderIndex="5" source="sess-authorize" target="sess-observe" summary="Process transition." rationale="Workflow order."/><transitions xmi:id="st-6" id="st-6" name="Completion to end" orderIndex="6" source="sess-observe" target="sess-end" summary="Process transition." rationale="Workflow order."/>
    <exceptions xmi:id="exc-no-show" id="exc-no-show" name="Reservation No Show" scenario="Member does not begin a session within the grace period." businessImpact="Equipment remains unnecessarily unavailable." expected="true" recoverable="true" recoveryAction="Release the reservation and notify the member." compensationRequired="true" resultingEvents="evt-session-ended" summary="Expected booking exception." rationale="Fair-use policy."/>
    <temporalConstraints xmi:id="time-access" id="time-access" name="Controller Access Decision Deadline" deadlineExpression="PT5S from access request" durationExpression="PT5S" orderingExpression="Authorization before machine enablement" violationSeverity="CRITICAL" constrainedElements="cmd-start evt-access-authorized proc-session" summary="Physical access response target." rationale="Controller SLA."/>
  </processes>
  <processes xmi:id="proc-recovery" id="proc-recovery" name="Contain and Recover Equipment" businessTriggerDescription="A controller reports a critical safety incident." longRunning="true" humanApprovalPossible="true" compensationExpected="true" completionCriterion="Equipment is verified safe and restored, or remains locked with an owned case." processKind="HUMAN_INVOLVED" criticality="MISSION_CRITICAL" owningCapability="cap-maintenance" triggeringEvent="evt-incident" trigger="evt-incident" summary="Immediate containment followed by human repair verification." rationale="Safety recovery demo workflow.">
    <steps xsi:type="cimprocess:StartStep" xmi:id="rec-start" id="rec-start" name="Incident Received" orderIndex="1" optional="false" repeatable="false" responsibility="Accept critical signal." stepKind="START" summary="Recovery start." rationale="Incident trigger."/>
    <steps xsi:type="cimprocess:PolicyStep" xmi:id="rec-lock" id="rec-lock" name="Apply Immediate Lockout" orderIndex="2" optional="false" repeatable="false" responsibility="Prevent further machine use." stepKind="POLICY" policy="pol-lockout" summary="Automated containment." rationale="Safety priority."/>
    <steps xsi:type="cimprocess:ExternalInteractionStep" xmi:id="rec-controller" id="rec-controller" name="Confirm Controller Lockout" orderIndex="3" optional="false" repeatable="false" responsibility="Obtain physical lockout confirmation." stepKind="EXTERNAL_INTERACTION" externalSystem="ext-controller" exchangedInformation="info-equipment-id info-incident-id" interactionPurpose="Confirm machine disablement." summary="Physical containment confirmation." rationale="Device boundary."/>
    <steps xsi:type="cimprocess:HumanTaskStep" xmi:id="rec-diagnose" id="rec-diagnose" name="Diagnose and Repair Equipment" orderIndex="4" optional="false" repeatable="true" responsibility="Investigate and repair the machine." stepKind="HUMAN_TASK" responsibleRoles="role-technician" taskDescription="Inspect signal evidence, diagnose fault, repair, and complete checklist." completionEvidence="MaintenanceResolution document." summary="Technician work." rationale="Human expertise required."/>
    <steps xsi:type="cimprocess:CommandStep" xmi:id="rec-restore" id="rec-restore" name="Approve Return to Service" orderIndex="5" optional="false" repeatable="false" responsibility="Record verified recovery." stepKind="COMMAND" command="cmd-resolve-incident" responsibleRoles="role-technician" summary="Recovery command." rationale="Controlled restoration."/>
    <steps xsi:type="cimprocess:EndStep" xmi:id="rec-end" id="rec-end" name="Recovery Completed" orderIndex="6" optional="false" repeatable="false" responsibility="Close incident and restore availability." stepKind="END" summary="Recovery end." rationale="Workflow completion."/>
    <transitions xmi:id="rt-1" id="rt-1" name="Receive to lock" orderIndex="1" source="rec-start" target="rec-lock" summary="Process transition." rationale="Workflow order."/><transitions xmi:id="rt-2" id="rt-2" name="Lock to confirm" orderIndex="2" source="rec-lock" target="rec-controller" summary="Process transition." rationale="Workflow order."/><transitions xmi:id="rt-3" id="rt-3" name="Confirm to diagnose" orderIndex="3" source="rec-controller" target="rec-diagnose" summary="Process transition." rationale="Workflow order."/><transitions xmi:id="rt-4" id="rt-4" name="Diagnose to restore" orderIndex="4" source="rec-diagnose" target="rec-restore" conditionExpression="checklist complete" conditionRef="cond-repaired" summary="Process transition." rationale="Recovery gate."/><transitions xmi:id="rt-5" id="rt-5" name="Restore to end" orderIndex="5" source="rec-restore" target="rec-end" summary="Process transition." rationale="Workflow order."/>
    <exceptions xmi:id="exc-lockout-fail" id="exc-lockout-fail" name="Controller Lockout Not Confirmed" scenario="Physical controller does not confirm lockout." businessImpact="Machine may remain physically operable after critical incident." expected="false" recoverable="true" recoveryAction="Escalate to on-site emergency isolation and keep all digital access denied." compensationRequired="true" resultingEvents="evt-machine-locked" summary="Critical containment exception." rationale="Fail-safe behavior."/>
    <temporalConstraints xmi:id="time-lockout" id="time-lockout" name="Critical Lockout Deadline" deadlineExpression="PT60S from incident detection" durationExpression="PT60S" orderingExpression="Lockout before diagnosis or further access" violationSeverity="CRITICAL" constrainedElements="evt-incident pol-lockout evt-machine-locked proc-recovery" summary="Incident containment target." rationale="Safety KPI."/>
  </processes>
  <requirements xmi:id="req-reservation" id="req-reservation" name="Certified Member Equipment Reservation" mandatory="true" productionBlocking="true" fitCriterion="A member can reserve only non-overlapping available equipment covered by current certification." requirementType="FUNCTIONAL" sourceType="WORKSHOP" priority="CRITICAL" supportsGoals="goal-safe goal-utilization" constrains="cmd-reserve proc-session" summary="Core member booking requirement." rationale="Member and safety workshop."><acceptanceCriteria xmi:id="ac-reserve" id="ac-reserve" name="Certified reservation succeeds" givenContext="A certified member and available equipment interval" whenAction="the member requests the interval" thenOutcome="one confirmed reservation is created and its event emitted" measurableTarget="Exactly one reservation for an idempotent request" automatableTestCandidate="true" summary="Reservation acceptance scenario." rationale="Functional requirement."/></requirements>
  <requirements xmi:id="req-lockout" id="req-lockout" name="Immediate Critical Incident Lockout" mandatory="true" productionBlocking="true" fitCriterion="Every critical incident denies new access and records lockout within sixty seconds." requirementType="SECURITY" sourceType="POLICY_DOCUMENT" priority="CRITICAL" supportsGoals="goal-recovery goal-safe" constrains="pol-lockout proc-recovery" summary="Core safety containment requirement." rationale="Incident response handbook."/>
