  <informationItems xmi:id="info-end-time" id="info-end-time" name="ReservedEndTime" businessName="Reserved end time" type="DATETIME" required="true" example="2026-07-01T15:00:00Z" businessValidationRule="Must be after reserved start time." sourceOfTruth="equipment operations register" auditRelevant="true" searchRelevant="true" classification="class-safety" summary="End of reserved interval." rationale="Scheduling semantics."/>
  <informationItems xmi:id="info-session-id" id="info-session-id" name="SessionId" businessName="Machine session identifier" type="IDENTIFIER" required="true" example="ses-933" auditRelevant="true" classification="class-safety" summary="Stable machine-use identity." rationale="Access evidence."/>
