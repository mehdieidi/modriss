  <informationItems xmi:id="info-signal" id="info-signal" name="SafetySignal" businessName="Machine safety signal" type="OBJECT" required="true" externallyShared="true" auditRelevant="true" retentionRelevant="true" classification="class-safety" summary="Controller-reported reason and measured safety values." rationale="Incident diagnosis."/>
