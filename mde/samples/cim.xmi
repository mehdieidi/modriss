  <events semanticVersion="1.0.0" versioningRationale="Initial stable business event contract for the sample transformation pipeline." xmi:id="evt-identity-verified" id="evt-identity-verified" name="IdentityVerified" semanticName="Identity verified" occurredInPastTenseName="IdentityVerified" eventTimeSemantics="OBSERVATION_TIME" businessMeaning="The civil identity registry confirmed the resident identity for the case" businessTimestampItemName="SubmissionTime" correlationBusinessKey="residentIdentityReference" causationBusinessKey="identityVerificationExchange" orderingKeyCandidate="residentIdentityReference" externallyVisible="false" auditRelevant="true" retentionRelevant="true" payload="info-resident-id info-address" affects="entity-application" sourceReference="Identity integration event mapping" rationale="Supports external verification before case progression." lifecycleStatus="APPROVED" summary="IdentityVerified business element in the climate relief grants evaluation model." />
