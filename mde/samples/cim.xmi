<?xml version="1.0" encoding="utf-8"?>
<cim:CIMModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:cim="https://modless.org/cim/1.0" xmlns:cimorg="https://modless.org/cim/organization/1.0" xmlns:cimdomain="https://modless.org/cim/domain-data/1.0" xmlns:cimbehavior="https://modless.org/cim/behavior/1.0" xmlns:cimprocess="https://modless.org/cim/process-policy/1.0" xmlns:cimgov="https://modless.org/cim/governance/1.0" xmlns:cimtransform="https://modless.org/cim/transformation/1.0" xmlns:kernel="https://modless.org/kernel/1.0" xmi:id="cim-root" id="cim-root" name="ClimateReliefGrantsBusinessModel" domainName="Climate Relief Grants and Reimbursements" businessScope="Emergency household microgrants, supplier reimbursements, appeals, and compliance oversight for a regional public agency." organizationName="Regional Climate Assistance Agency" modelingDate="2026-05-24T00:00:00.000Z" language="en" summary="Research-grade business-domain fixture for a climate relief grants platform." description="This model captures intake, eligibility, disbursement, appeal, compliance, and transformation-readiness concerns for a public-sector emergency assistance domain." documentation="Designed as a broad-coverage business-domain fixture for conformance, validation, and downstream transformation evaluation." modelTags="research-grade,serverless-suited,event-driven,public-sector,compliance-heavy" lifecycleStatus="APPROVED" rationale="Chosen to exercise real-world low-code and serverless modeling concerns without leaking provider-specific implementation terms." reviewStatus="reviewed" reviewNotes="Broad concept coverage fixture for business-model evaluation." manuallyMaintained="true">
  <annotations xmi:id="ann-root-1" key="samplePurpose" value="Metamodel coverage and evaluation fixture" source="mde.samples" />
  <annotations xmi:id="ann-root-2" key="researchUse" value="Transformation, validation, and usability evaluation" source="mde.samples" />

  <requirements xmi:id="req-func-apply" id="req-func-apply" name="Support Emergency Grant Application Submission" requirementType="FUNCTIONAL" sourceType="WORKSHOP" priority="CRITICAL" mandatory="true" productionBlocking="true" fitCriterion="Residents can submit a complete application and receive a case reference during high-demand periods." supportsGoals="goal-rapid goal-trust" constrains="cap-intake cmd-submit-app proc-case-lifecycle" sourceReference="Relief program discovery workshop" rationale="Submission is the business entry point to all downstream work." lifecycleStatus="APPROVED" summary="Support Emergency Grant Application Submission business element in the climate relief grants evaluation model.">
    <acceptanceCriteria xmi:id="ac-apply-1" id="ac-apply-1" name="Application intake confirmation" givenContext="A resident has a verified identity and the minimum required information" whenAction="the resident submits a grant application" thenOutcome="the agency records the application and returns a case reference" measurableTarget="Confirmation is issued for 99 percent of valid submissions" automatableTestCandidate="true" summary="Application intake confirmation business element in the climate relief grants evaluation model." rationale="Included to provide semantically complete coverage for the climate relief grants evaluation model." />
    <acceptanceCriteria xmi:id="ac-apply-2" id="ac-apply-2" name="Incomplete submission handling" givenContext="A resident omits required information" whenAction="the resident attempts to submit the application" thenOutcome="the submission is rejected with clear missing-field guidance" measurableTarget="All missing mandatory fields are identified in the response" automatableTestCandidate="true" summary="Incomplete submission handling business element in the climate relief grants evaluation model." rationale="Included to provide semantically complete coverage for the climate relief grants evaluation model." />
  </requirements>
  <requirements xmi:id="req-func-appeal" id="req-func-appeal" name="Support Appeal Filing and Resolution" requirementType="FUNCTIONAL" sourceType="STAKEHOLDER" priority="HIGH" mandatory="true" productionBlocking="false" fitCriterion="Residents can file appeals and reviewers can reach and record a resolution with complete audit evidence." supportsGoals="goal-oversight" constrains="cap-appeals cmd-file-appeal proc-appeal-lifecycle" dependsOn="req-func-apply" sourceReference="Ombuds and service-design interview" rationale="Appeals are needed for fairness and defensibility." lifecycleStatus="APPROVED" summary="Support Appeal Filing and Resolution business element in the climate relief grants evaluation model.">
    <acceptanceCriteria xmi:id="ac-appeal-1" id="ac-appeal-1" name="Appeal evidence capture" givenContext="A resident disputes a rejection or payment problem" whenAction="the resident files an appeal" thenOutcome="the case records the appeal reason, evidence, and receipt time" measurableTarget="Every appeal stores the rationale and evidence reference" automatableTestCandidate="true" summary="Appeal evidence capture business element in the climate relief grants evaluation model." rationale="Included to provide semantically complete coverage for the climate relief grants evaluation model." />
    <acceptanceCriteria xmi:id="ac-appeal-2" id="ac-appeal-2" name="Appeal resolution outcome" givenContext="An appeal has been reviewed" whenAction="the reviewer closes the appeal" thenOutcome="the case records the resolution and next action" measurableTarget="A decision and evidence summary exist for every resolved appeal" automatableTestCandidate="true" summary="Appeal resolution outcome business element in the climate relief grants evaluation model." rationale="Included to provide semantically complete coverage for the climate relief grants evaluation model." />
  </requirements>
  <requirements xsi:type="cimgov:NonFunctionalRequirement" xmi:id="nfr-latency" id="nfr-latency" name="Decision Latency Target" requirementType="QUALITY" sourceType="POLICY_DOCUMENT" priority="CRITICAL" mandatory="true" productionBlocking="true" fitCriterion="Initial eligibility decisions should be available quickly enough to support emergency response." qualityType="LATENCY" metric="Initial decision lead time" target="95 percent within 2 business days" measurementMethod="Median and percentile case-timeline analysis" environmentAssumption="Normal surge management procedures are active" supportsGoals="goal-rapid" constrains="cap-intake cmd-submit-app qry-status proc-case-lifecycle" constrainedElements="cap-intake cmd-submit-app qry-status proc-case-lifecycle" sourceReference="Program operations charter" rationale="Timeliness is central to public-service value." lifecycleStatus="APPROVED" summary="Decision Latency Target business element in the climate relief grants evaluation model.">
    <scenarios xmi:id="qs-latency-1" id="qs-latency-1" name="Surge-time decision scenario" qualityType="LATENCY" source="Affected resident" stimulus="Submits a complete application during a disaster surge" environment="High-volume period with normal staff escalation rules" artifact="Eligibility decision workflow" response="The platform routes the case for decision without manual data re-entry" responseMeasure="95 percent of complete cases receive an initial decision within 2 business days" summary="Surge-time decision scenario business element in the climate relief grants evaluation model." rationale="Included to provide semantically complete coverage for the climate relief grants evaluation model." />
  </requirements>
  <requirements xsi:type="cimgov:NonFunctionalRequirement" xmi:id="nfr-audit" id="nfr-audit" name="Auditability of Grant Decisions" requirementType="AUDIT" sourceType="REGULATION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Every material decision is traceable to evidence, rules, and responsible actors." qualityType="AUDITABILITY" metric="Trace completeness" target="100 percent of audited cases contain rule, evidence, and actor trace" measurementMethod="Quarterly audit sampling" environmentAssumption="Case metadata and evidence references are retained" supportsGoals="goal-oversight" constrains="cap-appeals evt-approved evt-rejected proc-appeal-lifecycle" constrainedElements="cap-appeals evt-approved evt-rejected proc-appeal-lifecycle" sourceReference="Public audit framework" rationale="Auditable decisions are essential for contested public-service outcomes." lifecycleStatus="APPROVED" summary="Auditability of Grant Decisions business element in the climate relief grants evaluation model.">
    <scenarios xmi:id="qs-audit-1" id="qs-audit-1" name="Audit reconstruction scenario" qualityType="AUDITABILITY" source="External auditor" stimulus="Requests a sample of approved and rejected cases" environment="Post-event compliance review" artifact="Decision evidence chain" response="The platform reconstructs the decision path, evidence, and accountable roles" responseMeasure="Auditors can inspect complete evidence for every sampled case" summary="Audit reconstruction scenario business element in the climate relief grants evaluation model." rationale="Included to provide semantically complete coverage for the climate relief grants evaluation model." />
  </requirements>
  <requirements xsi:type="cimgov:SecurityConstraint" xmi:id="sec-auth-submit" id="sec-auth-submit" name="Verified Identity for Citizen Submission" requirementType="SECURITY" sourceType="REGULATION" priority="CRITICAL" mandatory="true" productionBlocking="true" fitCriterion="Only identity-verified residents can submit or amend applications for themselves." qualityType="SECURITY" metric="Verified-submission rate" target="100 percent verified applicant identity" measurementMethod="Submission audit review" environmentAssumption="Identity provider is reachable" authenticationNeed="Strong resident identity proofing" authorizationRule="A resident may submit only for their own household case" segregationOfDutiesRequired="false" nonRepudiationRequired="true" auditAccessRequired="true" threatRationale="Prevents fraudulent claim origination and identity misuse" supportsGoals="goal-trust" constrains="cmd-submit-app cmd-file-appeal info-resident-id info-household-id" constrainedElements="actor-resident cmd-submit-app cmd-file-appeal info-resident-id info-household-id" constrainedActors="actor-resident" constrainedCommands="cmd-submit-app cmd-file-appeal" constrainedInformation="info-resident-id info-household-id" sourceReference="Security architecture review" rationale="Identity assurance is a business prerequisite for fair assistance." lifecycleStatus="APPROVED" summary="Verified Identity for Citizen Submission business element in the climate relief grants evaluation model."><scenarios id="qs-sec-auth-1" name="Verified submission security scenario" summary="Verified submission security scenario quality scenario in the climate relief grants evaluation model." rationale="Included to make the production-blocking governance requirement operationally testable." qualityType="SECURITY" source="Affected resident" stimulus="Attempts to submit an application" environment="Public digital intake under normal or surge conditions" artifact="Application submission authorization control" response="The platform permits only verified self-service submission and records the authorization decision" responseMeasure="All successful submissions show verified identity and authorization evidence" xmlns="https://modless.org/cim/1.0" /></requirements>
  <requirements xsi:type="cimgov:SecurityConstraint" xmi:id="sec-finance" id="sec-finance" name="Dual Control for Disbursement Scheduling" requirementType="SECURITY" sourceType="POLICY_DOCUMENT" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="No single privileged role can both approve and schedule high-value disbursements without review evidence." qualityType="SECURITY" metric="Dual-control compliance rate" target="100 percent for high-value disbursements" measurementMethod="Disbursement audit sampling" environmentAssumption="Privilege assignments are maintained" authenticationNeed="Privileged staff authentication" authorizationRule="Finance scheduling requires reviewer-approved grant and finance role authority" segregationOfDutiesRequired="true" nonRepudiationRequired="true" auditAccessRequired="true" threatRationale="Reduces insider fraud and authorization bypass risk" supportsGoals="goal-trust goal-oversight" constrains="cmd-approve cmd-schedule rolesenior-review role-finance" constrainedElements="actor-finance-lead actor-senior-reviewer cmd-approve cmd-schedule role-finance rolesenior-review" constrainedActors="actor-finance-lead actor-senior-reviewer" constrainedCommands="cmd-approve cmd-schedule" sourceReference="Internal control policy" rationale="Disbursement control must remain accountable under surge conditions." lifecycleStatus="APPROVED" summary="Dual Control for Disbursement Scheduling business element in the climate relief grants evaluation model."><scenarios id="qs-sec-fin-1" name="Dual-control payment scenario" summary="Dual-control payment scenario quality scenario in the climate relief grants evaluation model." rationale="Included to make the production-blocking governance requirement operationally testable." qualityType="SECURITY" source="Finance operations lead" stimulus="Schedules a high-value disbursement" environment="Privileged internal payment operations" artifact="Disbursement scheduling control" response="The platform requires reviewer evidence and finance authorization before scheduling" responseMeasure="No high-value disbursement is scheduled without dual-control evidence" xmlns="https://modless.org/cim/1.0" /></requirements>
  <requirements xsi:type="cimgov:PrivacyConstraint" xmi:id="priv-resident" id="priv-resident" name="Resident Personal Data Processing Rule" requirementType="PRIVACY" sourceType="REGULATION" priority="CRITICAL" mandatory="true" productionBlocking="true" fitCriterion="Resident personal data is processed only for relief-case handling with explicit retention and minimization rules." qualityType="PRIVACY" metric="Purpose-limited processing compliance" target="100 percent of personal data linked to declared purpose" measurementMethod="Privacy office review" environmentAssumption="Case purpose taxonomy remains stable" law="Regional Data Protection Act" jurisdiction="Regional Union" dataSubjectType="Resident applicant" purpose="Emergency assistance eligibility, disbursement, and appeals" legalBasis="PUBLIC_TASK" retentionPeriod="7 years after case closure" consentRequired="false" deletionRequired="false" portabilityRequired="true" rectificationRequired="true" dataResidencyRequired="true" allowedResidencyArea="Regional Union" crossBorderTransferAllowed="false" minimizationRule="Only fields needed for eligibility, payment integrity, and audit may be collected" supportsGoals="goal-trust goal-oversight" constrains="info-resident-id info-resident-name info-address info-bank-account" constrainedElements="info-resident-id info-resident-name info-address info-bank-account" dataItems="info-resident-id info-resident-name info-address info-bank-account" dataSubjects="actor-resident" sourceReference="Privacy impact assessment" rationale="Resident data needs strong purpose limitation and residency control." lifecycleStatus="APPROVED" summary="Resident Personal Data Processing Rule business element in the climate relief grants evaluation model."><scenarios id="qs-priv-res-1" name="Resident data minimization scenario" summary="Resident data minimization scenario quality scenario in the climate relief grants evaluation model." rationale="Included to make the production-blocking governance requirement operationally testable." qualityType="PRIVACY" source="Privacy officer" stimulus="A resident case is created and processed" environment="Operational relief-case handling" artifact="Resident data handling boundary" response="Only the minimum resident data needed for eligibility, payment, and appeals is retained within the allowed residency area" responseMeasure="Sampled cases show only declared-purpose data items and compliant residency handling" xmlns="https://modless.org/cim/1.0" /></requirements>
  <requirements xsi:type="cimgov:PrivacyConstraint" xmi:id="priv-sensitive" id="priv-sensitive" name="Sensitive Evidence and Vulnerability Data Rule" requirementType="PRIVACY" sourceType="REGULATION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Sensitive case evidence is tightly limited, retained with justification, and accessed only by authorized roles." qualityType="PRIVACY" metric="Sensitive-access compliance" target="100 percent authorized access" measurementMethod="Access review and sample case audit" environmentAssumption="Role mappings remain current" law="Regional Data Protection Act" jurisdiction="Regional Union" dataSubjectType="Affected household" purpose="Exceptional-case review and legally required appeals handling" legalBasis="LEGAL_OBLIGATION" retentionPeriod="7 years after case closure" consentRequired="false" deletionRequired="false" portabilityRequired="false" rectificationRequired="true" dataResidencyRequired="true" allowedResidencyArea="Regional Union" crossBorderTransferAllowed="false" minimizationRule="Store only the minimum evidence necessary to justify a decision or appeal outcome" supportsGoals="goal-oversight" constrains="info-vulnerability-note info-supporting-document" constrainedElements="info-vulnerability-note info-supporting-document" dataItems="info-vulnerability-note info-supporting-document" dataSubjects="actor-resident" sourceReference="Sensitive-data handling workshop" rationale="Appeals and exceptional review require stronger minimization and access control." lifecycleStatus="APPROVED" summary="Sensitive Evidence and Vulnerability Data Rule business element in the climate relief grants evaluation model."><scenarios id="qs-priv-sens-1" name="Sensitive evidence handling scenario" summary="Sensitive evidence handling scenario quality scenario in the climate relief grants evaluation model." rationale="Included to make the production-blocking governance requirement operationally testable." qualityType="PRIVACY" source="Senior reviewer" stimulus="An appeal or exceptional case includes sensitive evidence" environment="Restricted review and oversight workflow" artifact="Sensitive evidence access path" response="Sensitive evidence is accessed only by authorized roles and retained only with justification" responseMeasure="All sampled sensitive-evidence accesses are authorized and auditable" xmlns="https://modless.org/cim/1.0" /></requirements>
  <requirements xsi:type="cimgov:ComplianceConstraint" xmi:id="comp-public-funds" id="comp-public-funds" name="Public Funds Evidence Control" requirementType="COMPLIANCE" sourceType="REGULATION" priority="CRITICAL" mandatory="true" productionBlocking="true" fitCriterion="Every disbursement is backed by decision evidence, authorization evidence, and payment confirmation." qualityType="COMPLIANCE" metric="Evidence completeness" target="100 percent of sampled disbursements" measurementMethod="External audit" environmentAssumption="Payment confirmations are retained and linked" regulation="Public Emergency Assistance Control Standard" controlId="PEA-12" controlObjective="Demonstrate lawful and authorized use of public funds" evidenceRequired="Decision evidence, payment schedule, payment confirmation, actor trace" auditFrequency="Quarterly" externalAuditRequired="true" supportsGoals="goal-trust goal-oversight" constrains="cmd-schedule evt-funds-disbursed entity-disbursement" constrainedElements="cmd-schedule evt-funds-disbursed entity-disbursement" scopedElements="cmd-schedule evt-funds-disbursed entity-disbursement" sourceReference="Emergency finance regulation" rationale="Public-funds usage must be provable and reconstructable." lifecycleStatus="APPROVED" summary="Public Funds Evidence Control business element in the climate relief grants evaluation model."><scenarios id="qs-comp-funds-1" name="Public-funds evidence scenario" summary="Public-funds evidence scenario quality scenario in the climate relief grants evaluation model." rationale="Included to make the production-blocking governance requirement operationally testable." qualityType="COMPLIANCE" source="External auditor" stimulus="Requests evidence for a sampled disbursement" environment="Quarterly public-funds audit" artifact="Disbursement evidence chain" response="The platform reconstructs approval, authorization, scheduling, and settlement evidence for the sampled payment" responseMeasure="Auditors can retrieve complete evidence for every sampled disbursement" xmlns="https://modless.org/cim/1.0" /></requirements>
  <requirements xsi:type="cimgov:ComplianceConstraint" xmi:id="comp-appeals" id="comp-appeals" name="Appeals Timeliness Control" requirementType="COMPLIANCE" sourceType="POLICY_DOCUMENT" priority="HIGH" mandatory="true" productionBlocking="false" fitCriterion="Appeals are acknowledged and resolved within policy-defined time windows." qualityType="COMPLIANCE" metric="Appeal SLA compliance" target="95 percent resolved within 15 business days" measurementMethod="Monthly operations review" environmentAssumption="Required evidence is available to reviewers" regulation="Administrative Fairness Code" controlId="AFC-07" controlObjective="Ensure timely and fair review of contested decisions" evidenceRequired="Appeal receipt, reviewer assignment, decision date, rationale" auditFrequency="Monthly" externalAuditRequired="false" supportsGoals="goal-oversight" constrains="proc-appeal-lifecycle qry-audit-report" constrainedElements="proc-appeal-lifecycle qry-audit-report" scopedElements="proc-appeal-lifecycle qry-audit-report" sourceReference="Appeals operating procedure" rationale="Timely resolution is part of procedural fairness." lifecycleStatus="APPROVED" summary="Appeals Timeliness Control business element in the climate relief grants evaluation model." />

  <goals xmi:id="goal-rapid" id="goal-rapid" name="Rapid Eligibility Determination" priority="CRITICAL" successCriterion="Most complete applications receive an initial decision within two business days" timeHorizon="During each declared relief program wave" businessValue="Households receive timely support while crisis impact is still acute" failureConsequence="Delayed decisions reduce relief effectiveness and public trust" measuredBy="kpi-decision-time" refinedBy="cap-intake" sourceReference="Program strategy review" rationale="The platform exists to shorten time-to-help under surge conditions." lifecycleStatus="APPROVED" summary="Rapid Eligibility Determination business element in the climate relief grants evaluation model." />
  <goals xmi:id="goal-trust" id="goal-trust" name="Trustworthy Disbursement" priority="CRITICAL" successCriterion="Approved assistance is disbursed accurately with strong fraud and duplication controls" timeHorizon="For every release and surge period" businessValue="Protects public funds while preserving resident confidence" failureConsequence="Fraud, duplicate payments, or payment failures damage the program and block scale-up" measuredBy="kpi-disbursement-integrity" refinedBy="cap-disbursement" sourceReference="Finance and fraud workshop" rationale="Integrity is as important as speed in public assistance." lifecycleStatus="APPROVED" summary="Trustworthy Disbursement business element in the climate relief grants evaluation model." />
  <goals xmi:id="goal-oversight" id="goal-oversight" name="Auditable Appeals and Oversight" priority="HIGH" successCriterion="Every contested or audited case can be reconstructed from business evidence and decisions" timeHorizon="Across the full case lifecycle and audit period" businessValue="Supports fairness, compliance, and institutional learning" failureConsequence="Unclear decisions create legal, reputational, and operational risk" measuredBy="kpi-audit-completeness" refinedBy="cap-appeals" sourceReference="Audit and ombuds working session" rationale="The agency must defend its decisions and improve them." lifecycleStatus="APPROVED" summary="Auditable Appeals and Oversight business element in the climate relief grants evaluation model." />

  <kpis xmi:id="kpi-decision-time" id="kpi-decision-time" name="Initial Decision Lead Time" metricName="Initial decision lead time" metricDefinition="Elapsed business time between application submission and first recorded decision" operator="&lt;=" targetValue="2" unit="business days" measurementFrequency="daily" dataSource="Case timeline register" acceptanceThreshold="95 percent of complete cases" measures="goal-rapid" sourceReference="Operations dashboard definition" rationale="Measures urgency of resident-facing service." lifecycleStatus="APPROVED" summary="Initial Decision Lead Time business element in the climate relief grants evaluation model." />
  <kpis xmi:id="kpi-disbursement-integrity" id="kpi-disbursement-integrity" name="Disbursement Accuracy Rate" metricName="Disbursement accuracy" metricDefinition="Percentage of approved payments completed without duplicate, destination, or authorization error" operator="&gt;=" targetValue="99.5" unit="percent" measurementFrequency="weekly" dataSource="Disbursement operations register" acceptanceThreshold="99.5 percent" measures="goal-trust" sourceReference="Finance quality framework" rationale="Measures whether public-funds distribution remains trustworthy." lifecycleStatus="APPROVED" summary="Disbursement Accuracy Rate business element in the climate relief grants evaluation model." />
  <kpis xmi:id="kpi-audit-completeness" id="kpi-audit-completeness" name="Audit Evidence Completeness" metricName="Audit evidence completeness" metricDefinition="Percentage of sampled cases with complete decision, actor, evidence, and event trace" operator="=" targetValue="100" unit="percent" measurementFrequency="monthly" dataSource="Audit sample review" acceptanceThreshold="100 percent" measures="goal-oversight" sourceReference="Audit program specification" rationale="Ensures decisions remain explainable and defensible." lifecycleStatus="APPROVED" summary="Audit Evidence Completeness business element in the climate relief grants evaluation model." />

  <events semanticVersion="1.0.0" xmi:id="evt-submitted" id="evt-submitted" name="ApplicationSubmitted" semanticName="Application submitted" occurredInPastTenseName="ApplicationSubmitted" eventTimeSemantics="BUSINESS_TIME" businessMeaning="A household application was accepted into the case register" businessTimestampItemName="SubmissionTime" correlationBusinessKey="applicationReference" causationBusinessKey="submissionIntent" orderingKeyCandidate="applicationReference" externallyVisible="true" auditRelevant="true" retentionRelevant="true" versioningRationale="Resident-facing event contract may evolve with milestone detail" payload="info-application-id info-household-id info-submission-time" affects="entity-application" sourceReference="Event storming session" rationale="First durable business fact in the case lifecycle." lifecycleStatus="APPROVED" summary="ApplicationSubmitted business element in the climate relief grants evaluation model." />
  <events semanticVersion="1.0.0" xmi:id="evt-docs-requested" id="evt-docs-requested" name="AdditionalDocumentsRequested" semanticName="Additional documents requested" occurredInPastTenseName="AdditionalDocumentsRequested" eventTimeSemantics="BUSINESS_TIME" businessMeaning="The agency requested additional evidence before a decision could be reached" businessTimestampItemName="SubmissionTime" correlationBusinessKey="reviewCaseReference" causationBusinessKey="reviewAction" orderingKeyCandidate="reviewCaseReference" externallyVisible="true" auditRelevant="true" retentionRelevant="true" versioningRationale="Resident and partner channels may consume the notification event differently" payload="info-review-case-id info-supporting-document" affects="entity-reviewcase" sourceReference="Review workflow event mapping" rationale="Captures a common non-terminal case outcome." lifecycleStatus="APPROVED" summary="AdditionalDocumentsRequested business element in the climate relief grants evaluation model." />
  <events semanticVersion="1.0.0" xmi:id="evt-approved" id="evt-approved" name="GrantApproved" semanticName="Grant approved" occurredInPastTenseName="GrantApproved" eventTimeSemantics="BUSINESS_TIME" businessMeaning="A reviewed case received an approval decision" businessTimestampItemName="ApprovalTime" correlationBusinessKey="applicationReference" causationBusinessKey="decisionReference" orderingKeyCandidate="applicationReference" externallyVisible="true" auditRelevant="true" retentionRelevant="true" versioningRationale="Approval payload may evolve as additional evidence fields are standardized" payload="info-application-id info-award-id info-approval-time info-disbursement-amount" affects="entity-application entity-award" sourceReference="Decision event mapping" rationale="Drives downstream disbursement work." lifecycleStatus="APPROVED" summary="GrantApproved business element in the climate relief grants evaluation model." />
  <events semanticVersion="1.0.0" xmi:id="evt-rejected" id="evt-rejected" name="GrantRejected" semanticName="Grant rejected" occurredInPastTenseName="GrantRejected" eventTimeSemantics="BUSINESS_TIME" businessMeaning="A reviewed case received a rejection decision" businessTimestampItemName="ApprovalTime" correlationBusinessKey="applicationReference" causationBusinessKey="decisionReference" orderingKeyCandidate="applicationReference" externallyVisible="true" auditRelevant="true" retentionRelevant="true" versioningRationale="Reason codes may be expanded as policy evolves" payload="info-application-id info-decision-rationale" affects="entity-application" sourceReference="Decision event mapping" rationale="Represents a terminal negative outcome unless appealed." lifecycleStatus="APPROVED" summary="GrantRejected business element in the climate relief grants evaluation model." />
  <events semanticVersion="1.0.0" xmi:id="evt-disbursement-scheduled" id="evt-disbursement-scheduled" name="DisbursementScheduled" semanticName="Disbursement scheduled" occurredInPastTenseName="DisbursementScheduled" eventTimeSemantics="OBSERVATION_TIME" businessMeaning="An approved award was scheduled for payment execution" businessTimestampItemName="ScheduledTime" correlationBusinessKey="paymentReference" causationBusinessKey="scheduleCommandReference" orderingKeyCandidate="disbursementReference" externallyVisible="true" auditRelevant="true" retentionRelevant="true" versioningRationale="Partner coordination payload may evolve as payment control rules mature" payload="info-disbursement-id info-disbursement-amount info-scheduled-time" affects="entity-disbursement" sourceReference="Finance event mapping" rationale="Creates the handoff to settlement confirmation." lifecycleStatus="APPROVED" summary="DisbursementScheduled business element in the climate relief grants evaluation model." />
  <events semanticVersion="1.0.0" xmi:id="evt-funds-disbursed" id="evt-funds-disbursed" name="FundsDisbursed" semanticName="Funds disbursed" occurredInPastTenseName="FundsDisbursed" eventTimeSemantics="RECORDING_TIME" businessMeaning="The payment partner confirmed settlement of a scheduled disbursement" businessTimestampItemName="SettlementTime" correlationBusinessKey="paymentReference" causationBusinessKey="partnerSettlementReference" orderingKeyCandidate="disbursementReference" externallyVisible="true" auditRelevant="true" retentionRelevant="true" versioningRationale="Partner confirmation semantics may expand with reconciliation detail" payload="info-disbursement-id info-payment-reference info-settlement-time" affects="entity-disbursement entity-award entity-invoice" sourceReference="Finance event mapping" rationale="Turns scheduled intent into settled business fact." lifecycleStatus="APPROVED" summary="FundsDisbursed business element in the climate relief grants evaluation model." />
  <events semanticVersion="1.0.0" xmi:id="evt-appeal-filed" id="evt-appeal-filed" name="AppealFiled" semanticName="Appeal filed" occurredInPastTenseName="AppealFiled" eventTimeSemantics="BUSINESS_TIME" businessMeaning="A resident formally contested an earlier decision or payment outcome" businessTimestampItemName="AppealSubmissionTime" correlationBusinessKey="appealReference" causationBusinessKey="appealIntent" orderingKeyCandidate="appealReference" externallyVisible="true" auditRelevant="true" retentionRelevant="true" versioningRationale="Appeal receipt semantics may evolve with evidence categories" payload="info-appeal-id info-appeal-reason info-appeal-submission-time" affects="entity-appeal entity-application" sourceReference="Appeals event mapping" rationale="Starts contested-case governance." lifecycleStatus="APPROVED" summary="AppealFiled business element in the climate relief grants evaluation model." />
