perties&quot;: false, &quot;properties&quot;: { &quot;appealReference&quot;: { &quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;Appeal identifier&quot;, &quot;description&quot;: &quot;AppealId business element in the climate relief grants evaluation model.&quot; }, &quot;appealReason&quot;: { &quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;Resident or reviewer narrative&quot;, &quot;minLength&quot;: 10, &quot;maxLength&quot;: 1000, &quot;description&quot;: &quot;AppealReason business element in the climate relief grants evaluation model.&quot; }, &quot;appealSubmissionTime&quot;: { &quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;ISO timestamp&quot;, &quot;description&quot;: &quot;AppealSubmissionTime business element in the climate relief grants evaluation model.&quot; }, &quot;reviewNotes&quot;: { &quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;Reviewer narrative&quot;, &quot;minLength&quot;: 5, &quot;maxLength&quot;: 2000, &quot;description&quot;: &quot;ReviewNotes business element in the climate relief grants evaluation model.&quot;, &quot;nullable&quot;: true }, &quot;decisionRationale&quot;: { &quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;Business rationale&quot;, &quot;minLength&quot;: 10, &quot;maxLength&quot;: 2000, &quot;description&quot;: &quot;DecisionRationale business element in the climate relief grants evaluation model.&quot; }, &quot;evidenceReference&quot;: { &quot;type&quot;: &quot;array&quot;, &quot;items&quot;: { &quot;type&quot;: &quot;string&quot; }, &quot;format&quot;: &quot;Evidence register reference&quot;, &quot;minLength&quot;: 5, &quot;maxLength&quot;: 30, &quot;description&quot;: &quot;EvidenceReference business element in the climate relief grants evaluation model.&quot; }, &quot;contestedapplication&quot;: { &quot;$ref&quot;: &quot;#/components/schemas/GrantapplicationSchema&quot; } }, &quot;required&quot;: [ &quot;appealReference&quot;, &quot;appealReason