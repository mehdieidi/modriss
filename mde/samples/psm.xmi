nt in the climate relief grants evaluation model.&quot; }, &quot;householdAddress&quot;: { &quot;title&quot;: &quot;PostalAddressText Object Schema&quot;, &quot;type&quot;: &quot;object&quot;, &quot;additionalProperties&quot;: false, &quot;properties&quot;: { &quot;postalCode&quot;: { &quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;Regional postal code&quot;, &quot;minLength&quot;: 4, &quot;maxLength&quot;: 10, &quot;description&quot;: &quot;Postcode business element in the climate relief grants evaluation model.&quot; }, &quot;declaredDisasterLocationReference&quot;: { &quot;type&quot;: &quot;string&quot;, &quot;format&quot;: &quot;Declared area code&quot;, &quot;minLength&quot;: 4, &quot;maxLength&quot;: 40, &quot;description&quot;: &quot;LocationReferenceCode business element in the climate relief grants evaluation model.&quot; } }, &quot;required&quot;: [ &quot;postalCode&quot;, &quot;declaredDisasterLocationReference&quot; ] }, &quot;claimedDamageType&quot;: { &quot;type&quot;: &quot;string&quot;, &quot;enum&quot;: [ &quot;Flood displacement&quot;, &quot;Wildfire evacuation&quot;, &quot;Heat emergency&quot;, &quot;Infrastructure failure&quot; ], &quot;format&quot;: &quot;Controlled vocabulary&quot;, &quot;description&quot;: &quot;DamageType business element in the climate relief grants evaluation model.&quot; }, &quot;householdMemberCount&quot;: { &quot;type&quot;: &quot;integer&quot;, &quot;minimum&quot;: 1, &quot;maximum&quot;: 20, &quot;description&quot;: &quot;HouseholdSize business element in the climate relief grants evaluation model.&quot; }, &quot;incomeBand&quot;: { &quot;type&quot;: &quot;string&quot;, &quot;enum&quot;: [ &quot;Below threshold&quot;, &quot;Threshold plus vulnerability&quot;, &quot;Above threshold with exceptional approval&quot; ], &quot;format&quot;: &quot;Eligibility band&quot;, &quot;description&quot;: &quot;IncomeBand business element in the climate relief grants evaluation model.&quot; }, &quot;requestedAssistanceA