  <businessRules xsi:type="policy:BusinessRule" id="436243f3-79bc-5972-b068-284295da73ca" name="Idempotent consumer and retry rule 1" naturalLanguageRule="Persist event key, payload hash and result with the effect; in-memory generated helpers do not meet this requirement." enforcedBy="af886b3d-5721-5db4-9674-22de048a0aba ab453762-7e53-5b70-b7f0-15d7546fe1be de6a60b6-3b10-511e-a2cd-63680fb6d338 ae87bdc7-1f8b-5b6b-a513-c44e4f808a14" />
  <businessRules xsi:type="policy:BusinessRule" id="21455ebd-5113-5061-8cbe-7732ef3b73ed" name="Idempotent consumer and retry rule 2" naturalLanguageRule="Accept only after job and recoverable dispatch intent persist together; replay returns one job." enforcedBy="af886b3d-5721-5db4-9674-22de048a0aba ab453762-7e53-5b70-b7f0-15d7546fe1be de6a60b6-3b10-511e-a2cd-63680fb6d338 ae87bdc7-1f8b-5b6b-a513-c44e4f808a14" />
  <businessRules xsi:type="policy:BusinessRule" id="0d1941ba-f1b7-57db-b853-2dc14a83be65" name="Idempotent consumer and retry rule 3" naturalLanguageRule="Select at most 1000 rows from the immutable 10000-row snapshot; publish one correct private CSV per job." enforcedBy="af886b3d-5721-5db4-9674-22de048a0aba ab453762-7e53-5b70-b7f0-15d7546fe1be de6a60b6-3b10-511e-a2cd-63680fb6d338 ae87bdc7-1f8b-5b6b-a513-c44e4f808a14" />
  <businessRules xsi:type="policy:BusinessRule" id="29f5163c-3b12-586c-bb76-9cc8e238ee5c" name="Idempotent consumer and retry rule 4" naturalLanguageRule="Cancellation commits only in QUEUED/RUNNING; if it wins workers cannot publish success, and if success wins cancellation conflicts." enforcedBy="af886b3d-5721-5db4-9674-22de048a0aba ab453762-7e53-5b70-b7f0-15d7546fe1be de6a60b6-3b10-511e-a2cd-63680fb6d338 ae87bdc7-1f8b-5b6b-a513-c44e4f808a14" />
  <businessRules xsi:type="policy:BusinessRule" id="6e695cdb-bc48-5921-87b9-e216f5cd8a71" name="Idempotent consumer and retry rule 5" naturalLanguageRule="Only owners see status/cancel/download; CANCELLED jobs have no result. Configure five concurrent workers and recover partial batches." enforcedBy="af886b3d-5721-5db4-9674-22de048a0aba ab453762-7e53-5b70-b7f0-15d7546fe1be de6a60b6-3b10-511e-a2cd-63680fb6d338 ae87bdc7-1f8b-5b6b-a513-c44e4f808a14" />
