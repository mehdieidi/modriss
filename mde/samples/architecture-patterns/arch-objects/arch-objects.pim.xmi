  <businessRules xsi:type="policy:BusinessRule" id="71edaa05-831e-543e-b2f5-f534976dc2e2" name="Object-storage event processing rule 2" naturalLanguageRule="Inputs are private CSV v1 with sku,title,priceCents; limit 1 MiB and 1000 rows." enforcedBy="08f06354-d796-5002-97be-48c5638d2a89 34a88cea-5ed1-5c78-ad64-1025871a6473 cf245cc6-8e76-529d-9d21-590be191b505 e7cc0afa-f0c7-536b-8c00-a9e10ecd713b" />
