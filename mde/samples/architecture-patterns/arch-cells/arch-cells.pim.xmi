  <businessRules xsi:type="policy:BusinessRule" id="8225ab0c-cf9e-5d68-93d6-88fe28e4f804" name="Tenant-sharded SaaS / cell-based architecture rule 1" naturalLanguageRule="Resolve verified tenant identity through a cell-routing catalogue; quotas, movement and isolation need code." enforcedBy="6338d504-b51c-506e-9a7b-0f7442d3c9c9 c62eeebf-00b2-5d88-bcc2-d5982a908531 e7ab3ac4-db29-58d4-93cf-b43790040d45 dd7a466f-0ab9-5dfe-867d-2ba1482d8795 f5251cc7-16c0-5fc7-ac7b-8d5e472a9eb4 c066a868-7f30-5537-86b3-a80bf8389e68" />
  <businessRules xsi:type="policy:BusinessRule" id="ad0022c3-4329-5537-a831-d4467c9f1fa3" name="Tenant-sharded SaaS / cell-based architecture rule 2" naturalLanguageRule="Resolve requested organization scope against verified active membership; never trust a body orgId or role." enforcedBy="6338d504-b51c-506e-9a7b-0f7442d3c9c9 c62eeebf-00b2-5d88-bcc2-d5982a908531 e7ab3ac4-db29-58d4-93cf-b43790040d45 dd7a466f-0ab9-5dfe-867d-2ba1482d8795 f5251cc7-16c0-5fc7-ac7b-8d5e472a9eb4 c066a868-7f30-5537-86b3-a80bf8389e68" />
  <businessRules xsi:type="policy:BusinessRule" id="6a015262-5397-5b70-b569-c3b807ca81ca" name="Tenant-sharded SaaS / cell-based architecture rule 3" naturalLanguageRule="Expected-version mutations and attributable history apply within the organization; only admins manage membership/settings." enforcedBy="6338d504-b51c-506e-9a7b-0f7442d3c9c9 c62eeebf-00b2-5d88-bcc2-d5982a908531 e7ab3ac4-db29-58d4-93cf-b43790040d45 dd7a466f-0ab9-5dfe-867d-2ba1482d8795 f5251cc7-16c0-5fc7-ac7b-8d5e472a9eb4 c066a868-7f30-5537-86b3-a80bf8389e68" />
  <businessRules xsi:type="policy:BusinessRule" id="c1d8297b-18f4-5e4e-99de-e238b0207ec5" name="Tenant-sharded SaaS / cell-based architecture rule 4" naturalLanguageRule="Include orgId in data/index/idempotency/background/cache scope, allowing colliding local IDs in two organizations." enforcedBy="6338d504-b51c-506e-9a7b-0f7442d3c9c9 c62eeebf-00b2-5d88-bcc2-d5982a908531 e7ab3ac4-db29-58d4-93cf-b43790040d45 dd7a466f-0ab9-5dfe-867d-2ba1482d8795 f5251cc7-16c0-5fc7-ac7b-8d5e472a9eb4 c066a868-7f30-5537-86b3-a80bf8389e68" />
  <businessRules xsi:type="policy:BusinessRule" id="4dc31301-ec5f-5b2d-9115-daf071dc1363" name="Tenant-sharded SaaS / cell-based architecture rule 5" naturalLanguageRule="SUSPENDED organizations deny all member business operations; platform operators have health-only access." enforcedBy="6338d504-b51c-506e-9a7b-0f7442d3c9c9 c62eeebf-00b2-5d88-bcc2-d5982a908531 e7ab3ac4-db29-58d4-93cf-b43790040d45 dd7a466f-0ab9-5dfe-867d-2ba1482d8795 f5251cc7-16c0-5fc7-ac7b-8d5e472a9eb4 c066a868-7f30-5537-86b3-a80bf8389e68" />
  <policies xsi:type="policy:IdempotencyPolicy" id="4e2820b3-35cc-5389-a743-1a21ad961096" name="Durable scoped request/event keys" storeRequired="true" appliesToRetries="true" appliesToDuplicateRequests="true" productionRequired="false" keySource="orgId/subjectId/requestKey or stable event identity" scope="Tenant-sharded SaaS / cell-based architecture" attachedTo="6338d504-b51c-506e-9a7b-0f7442d3c9c9 c62eeebf-00b2-5d88-bcc2-d5982a908531 e7ab3ac4-db29-58d4-93cf-b43790040d45 dd7a466f-0ab9-5dfe-867d-2ba1482d8795 f5251cc7-16c0-5fc7-ac7b-8d5e472a9eb4 c066a868-7f30-5537-86b3-a80bf8389e68" />
