  <businessRules xsi:type="policy:BusinessRule" id="1c9faac5-8bfd-5ecf-aba1-6921378a3e34" name="Scatter-gather rule 1" naturalLanguageRule="Gather inventory and storefront results with a bounded timeout and explicit partial-result policy." enforcedBy="7647cc1f-a161-510d-afe7-96559fa120d4 052b50a6-1279-57a1-bad5-8efb2eaa787b d8c5eaff-671e-5f62-8ce0-29157a9ebf92" />
  <businessRules xsi:type="policy:BusinessRule" id="475f0b99-dd41-5dc1-8006-76327b685220" name="Scatter-gather rule 2" naturalLanguageRule="Map itemCode/availableQty/itemVersion deterministically to sku/stockAvailable/sourceVersion; quantities are nonnegative integers." enforcedBy="7647cc1f-a161-510d-afe7-96559fa120d4 052b50a6-1279-57a1-bad5-8efb2eaa787b d8c5eaff-671e-5f62-8ce0-29157a9ebf92" />
  <businessRules xsi:type="policy:BusinessRule" id="31c479e8-c1f5-5b71-aeee-594bbec5bbb9" name="Scatter-gather rule 3" naturalLanguageRule="Newest full snapshot wins per SKU; older snapshots never revert destination stock." enforcedBy="7647cc1f-a161-510d-afe7-96559fa120d4 052b50a6-1279-57a1-bad5-8efb2eaa787b d8c5eaff-671e-5f62-8ce0-29157a9ebf92" />
  <businessRules xsi:type="policy:BusinessRule" id="d13b63c5-40c9-5e5f-84a1-feeb827ee7a8" name="Scatter-gather rule 4" naturalLanguageRule="Stable exchange ID and payload hash resolve timeout-after-commit; provider 429 is retriable, malformed contracts fail permanently." enforcedBy="7647cc1f-a161-510d-afe7-96559fa120d4 052b50a6-1279-57a1-bad5-8efb2eaa787b d8c5eaff-671e-5f62-8ce0-29157a9ebf92" />
