  <businessRules xsi:type="policy:BusinessRule" id="48db0682-ab2e-5142-bd94-ada332351cbf" name="Exactly-once business outcome across service boundaries rule 1" naturalLanguageRule="A universal exactly-once effect is required across independent consumers; retries alone cannot establish it." enforcedBy="3273cddc-b74c-5c35-a77b-cb39836081f2 3ca8f843-2d33-5619-b7a8-8b89c92044ab 9f534bc9-e517-56fc-b863-8439f32499bf 9d5bac3a-9c2b-566b-b633-1e2373be2914 f11ba06a-b9ba-59e1-9e51-d3fda59db2a8" />
  <businessRules xsi:type="policy:BusinessRule" id="55c47c93-7f20-54e8-88d0-d70181ead10c" name="Exactly-once business outcome across service boundaries rule 2" naturalLanguageRule="Publish stable-ID closure/reopening events to two independent consumers." enforcedBy="3273cddc-b74c-5c35-a77b-cb39836081f2 3ca8f843-2d33-5619-b7a8-8b89c92044ab 9f534bc9-e517-56fc-b863-8439f32499bf 9d5bac3a-9c2b-566b-b633-1e2373be2914 f11ba06a-b9ba-59e1-9e51-d3fda59db2a8" />
  <businessRules xsi:type="policy:BusinessRule" id="c80850a7-0fb7-53f8-85c8-47a1ec6892d0" name="Exactly-once business outcome across service boundaries rule 3" naturalLanguageRule="Recheck enabled building preferences immediately before sending; later opt-out cannot retract an accepted send." enforcedBy="3273cddc-b74c-5c35-a77b-cb39836081f2 3ca8f843-2d33-5619-b7a8-8b89c92044ab 9f534bc9-e517-56fc-b863-8439f32499bf 9d5bac3a-9c2b-566b-b633-1e2373be2914 f11ba06a-b9ba-59e1-9e51-d3fda59db2a8" />
  <businessRules xsi:type="policy:BusinessRule" id="bf3f8a67-5cb8-5d28-b0ed-f25399478f98" name="Exactly-once business outcome across service boundaries rule 4" naturalLanguageRule="A delivery key is eventId/subjectId/channel; matching simulator replay returns one provider reference." enforcedBy="3273cddc-b74c-5c35-a77b-cb39836081f2 3ca8f843-2d33-5619-b7a8-8b89c92044ab 9f534bc9-e517-56fc-b863-8439f32499bf 9d5bac3a-9c2b-566b-b633-1e2373be2914 f11ba06a-b9ba-59e1-9e51-d3fda59db2a8" />
  <businessRules xsi:type="policy:BusinessRule" id="46fbaca9-a8d9-5ac7-8741-3d19cc04a1be" name="Exactly-once business outcome across service boundaries rule 5" naturalLanguageRule="Retain failed/skipped/accepted delivery outcomes for authorized replay; no real email or SMS." enforcedBy="3273cddc-b74c-5c35-a77b-cb39836081f2 3ca8f843-2d33-5619-b7a8-8b89c92044ab 9f534bc9-e517-56fc-b863-8439f32499bf 9d5bac3a-9c2b-566b-b633-1e2373be2914 f11ba06a-b9ba-59e1-9e51-d3fda59db2a8" />
