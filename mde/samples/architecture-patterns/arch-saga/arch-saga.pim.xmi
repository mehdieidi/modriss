  <businessRules xsi:type="policy:BusinessRule" id="a5c93e32-5d10-5abb-9fc6-e502ef830546" name="Saga orchestration and compensation rule 3" naturalLanguageRule="ValidateRequest -&gt; ALLOW/DENY -&gt; AllocateWorkspace -&gt; CreateManifest -&gt; five-second wait -&gt; VerifyWorkspace -&gt; READY/FAILED." enforcedBy="e4647e87-3ef7-5809-9b41-5e3d9002ed7d d2f434c4-90f6-5741-8ed4-ae88ab892634 2195b839-ea0b-5e6f-b276-9dc97c95d54d 7b054899-aac3-5c93-b51f-45d6477b9c17 6edfb946-4747-59ad-8158-a1677f9c8329 991c977b-d7ed-5ca6-bc59-db39e9fbbd39" />
  <businessRules xsi:type="policy:BusinessRule" id="7b6abeca-1e31-523d-b9b9-ed1a784d9912" name="Saga orchestration and compensation rule 4" naturalLanguageRule="Task results retain request identity at $.stepResults; evaluator tasks return explicit outcome envelopes and unknown values fail." enforcedBy="e4647e87-3ef7-5809-9b41-5e3d9002ed7d d2f434c4-90f6-5741-8ed4-ae88ab892634 2195b839-ea0b-5e6f-b276-9dc97c95d54d 7b054899-aac3-5c93-b51f-45d6477b9c17 6edfb946-4747-59ad-8158-a1677f9c8329 991c977b-d7ed-5ca6-bc59-db39e9fbbd39" />
