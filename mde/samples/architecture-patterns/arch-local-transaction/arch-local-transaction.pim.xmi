  <businessRules xsi:type="policy:BusinessRule" id="bfdaf182-edeb-58ae-8a00-25828122cb62" name="Multi-item transaction inside one DynamoDB service boundary rule 1" naturalLanguageRule="Slot allocation and reservation commit as one local transaction; confirm/expire races need tests." enforcedBy="5c395a60-84f3-5cf4-907d-dfce591d7abc eb158166-d05f-5ef7-bcf0-e7c454055385 70f6d9df-1db7-549e-9a65-9a5d27be4d9d 7f6c8489-33a5-5125-ae1f-a2cf75536851 8e1fa167-3948-5477-a7c0-3e6b98ede91f" />
  <businessRules xsi:type="policy:BusinessRule" id="b36e5bbd-d920-52cc-8734-8a6fe751f6ef" name="Multi-item transaction inside one DynamoDB service boundary rule 2" naturalLanguageRule="Slots are fixed 30-minute UTC units; slot allocation and reservation commit atomically." enforcedBy="5c395a60-84f3-5cf4-907d-dfce591d7abc eb158166-d05f-5ef7-bcf0-e7c454055385 70f6d9df-1db7-549e-9a65-9a5d27be4d9d 7f6c8489-33a5-5125-ae1f-a2cf75536851 8e1fa167-3948-5477-a7c0-3e6b98ede91f" />
  <businessRules xsi:type="policy:BusinessRule" id="86fc5b7f-1391-5e2e-91a1-78979c975a86" name="Multi-item transaction inside one DynamoDB service boundary rule 3" naturalLanguageRule="A hold lasts five minutes; confirmation requires now &lt; expiresAt, and expiry wins at equality." enforcedBy="5c395a60-84f3-5cf4-907d-dfce591d7abc eb158166-d05f-5ef7-bcf0-e7c454055385 70f6d9df-1db7-549e-9a65-9a5d27be4d9d 7f6c8489-33a5-5125-ae1f-a2cf75536851 8e1fa167-3948-5477-a7c0-3e6b98ede91f" />
  <businessRules xsi:type="policy:BusinessRule" id="3c4d5d83-14a6-570a-9f79-754e6a453a74" name="Multi-item transaction inside one DynamoDB service boundary rule 4" naturalLanguageRule="Availability is advisory; allocation commands reread authoritative state. Staff close only unallocated slots." enforcedBy="5c395a60-84f3-5cf4-907d-dfce591d7abc eb158166-d05f-5ef7-bcf0-e7c454055385 70f6d9df-1db7-549e-9a65-9a5d27be4d9d 7f6c8489-33a5-5125-ae1f-a2cf75536851 8e1fa167-3948-5477-a7c0-3e6b98ede91f" />
