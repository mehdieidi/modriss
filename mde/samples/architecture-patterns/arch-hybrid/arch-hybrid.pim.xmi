  <businessRules xsi:type="policy:BusinessRule" id="861c69cc-b20f-5242-8577-3c935ea0603e" name="Hybrid integration with external systems rule 1" naturalLanguageRule="Keep simulator contracts, credentials, timeouts and reconciliation owned by explicit adapters." enforcedBy="c591cb84-c510-53f6-85d7-3b99b2c08e70 ed83dc44-0e26-5088-a269-b54805baaf91 97a09541-e1e7-5f5f-afa6-7e560d1c2b9f" />
  <businessRules xsi:type="policy:BusinessRule" id="d79652c4-9777-5262-aae5-810073916485" name="Hybrid integration with external systems rule 2" naturalLanguageRule="Map itemCode/availableQty/itemVersion deterministically to sku/stockAvailable/sourceVersion; quantities are nonnegative integers." enforcedBy="c591cb84-c510-53f6-85d7-3b99b2c08e70 ed83dc44-0e26-5088-a269-b54805baaf91 97a09541-e1e7-5f5f-afa6-7e560d1c2b9f" />
  <businessRules xsi:type="policy:BusinessRule" id="b3df9778-a72e-5a81-a94f-3db60b3d0779" name="Hybrid integration with external systems rule 3" naturalLanguageRule="Newest full snapshot wins per SKU; older snapshots never revert destination stock." enforcedBy="c591cb84-c510-53f6-85d7-3b99b2c08e70 ed83dc44-0e26-5088-a269-b54805baaf91 97a09541-e1e7-5f5f-afa6-7e560d1c2b9f" />
  <businessRules xsi:type="policy:BusinessRule" id="bc482bf6-8be1-5cdd-a55a-508629d35c5f" name="Hybrid integration with external systems rule 4" naturalLanguageRule="Stable exchange ID and payload hash resolve timeout-after-commit; provider 429 is retriable, malformed contracts fail permanently." enforcedBy="c591cb84-c510-53f6-85d7-3b99b2c08e70 ed83dc44-0e26-5088-a269-b54805baaf91 97a09541-e1e7-5f5f-afa6-7e560d1c2b9f" />
