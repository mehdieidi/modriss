  <businessRules xsi:type="policy:BusinessRule" id="26615376-409d-5079-9065-c43dcf0fd635" name="Command/query separation and CQRS rule 2" naturalLanguageRule="Source events are complete snapshots; apply only a greater aggregate version." enforcedBy="e4e555d3-1bb0-5704-8394-db8aeb61711d 2c9903a2-6051-51b1-9ae1-f702ea7b173f 7b0a6190-d602-5435-b62a-49c8bf80726d af559f47-3add-581d-91b9-6fed2223b19d" />
  <businessRules xsi:type="policy:BusinessRule" id="00a3280c-b913-52f1-abd0-0280a62c8563" name="Command/query separation and CQRS rule 3" naturalLanguageRule="Commit ticket membership and queue/status counts consistently; all queries/cursors bind to one active generation." enforcedBy="e4e555d3-1bb0-5704-8394-db8aeb61711d 2c9903a2-6051-51b1-9ae1-f702ea7b173f 7b0a6190-d602-5435-b62a-49c8bf80726d af559f47-3add-581d-91b9-6fed2223b19d" />
  <businessRules xsi:type="policy:BusinessRule" id="6e0c5e2c-db22-5c90-b6f5-9f8697283019" name="Command/query separation and CQRS rule 4" naturalLanguageRule="Expose checkpoint/freshness explicitly, rebuild from snapshot K plus retained events after K, and switch generations only after convergence." enforcedBy="e4e555d3-1bb0-5704-8394-db8aeb61711d 2c9903a2-6051-51b1-9ae1-f702ea7b173f 7b0a6190-d602-5435-b62a-49c8bf80726d af559f47-3add-581d-91b9-6fed2223b19d" />
