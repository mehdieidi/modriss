  <businessRules xsi:type="policy:BusinessRule" id="dafb8b38-37fa-5f34-9716-0981706df446" name="Queue-based asynchronous worker rule 1" naturalLanguageRule="Accept bounded export jobs and expose status/result separately from queued execution." enforcedBy="dbb27f9e-9079-5acc-b01a-5fcf4fc4dcd0 e16361be-694c-5de9-8a58-8d161ce6bffa 5125b7b2-3bfc-536f-b2d1-9af215bb8a99 828be81f-7b02-5043-9033-45c467336464" />
  <businessRules xsi:type="policy:BusinessRule" id="66203858-d3af-53ce-a476-d1d398c730a3" name="Queue-based asynchronous worker rule 2" naturalLanguageRule="Accept only after job and recoverable dispatch intent persist together; replay returns one job." enforcedBy="dbb27f9e-9079-5acc-b01a-5fcf4fc4dcd0 e16361be-694c-5de9-8a58-8d161ce6bffa 5125b7b2-3bfc-536f-b2d1-9af215bb8a99 828be81f-7b02-5043-9033-45c467336464" />
  <businessRules xsi:type="policy:BusinessRule" id="c646dbb2-50c2-5f36-95ca-8ee227ca8a86" name="Queue-based asynchronous worker rule 3" naturalLanguageRule="Select at most 1000 rows from the immutable 10000-row snapshot; publish one correct private CSV per job." enforcedBy="dbb27f9e-9079-5acc-b01a-5fcf4fc4dcd0 e16361be-694c-5de9-8a58-8d161ce6bffa 5125b7b2-3bfc-536f-b2d1-9af215bb8a99 828be81f-7b02-5043-9033-45c467336464" />
  <businessRules xsi:type="policy:BusinessRule" id="3047efce-46cb-5513-91ab-e5c1df5a1467" name="Queue-based asynchronous worker rule 4" naturalLanguageRule="Cancellation commits only in QUEUED/RUNNING; if it wins workers cannot publish success, and if success wins cancellation conflicts." enforcedBy="dbb27f9e-9079-5acc-b01a-5fcf4fc4dcd0 e16361be-694c-5de9-8a58-8d161ce6bffa 5125b7b2-3bfc-536f-b2d1-9af215bb8a99 828be81f-7b02-5043-9033-45c467336464" />
  <businessRules xsi:type="policy:BusinessRule" id="95a4ce26-89e9-5a0e-b873-151ed7e85a0c" name="Queue-based asynchronous worker rule 5" naturalLanguageRule="Only owners see status/cancel/download; CANCELLED jobs have no result. Configure five concurrent workers and recover partial batches." enforcedBy="dbb27f9e-9079-5acc-b01a-5fcf4fc4dcd0 e16361be-694c-5de9-8a58-8d161ce6bffa 5125b7b2-3bfc-536f-b2d1-9af215bb8a99 828be81f-7b02-5043-9033-45c467336464" />
