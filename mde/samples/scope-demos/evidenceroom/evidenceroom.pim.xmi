  <businessRules xsi:type="policy:BusinessRule" id="450870ea-bd67-5a95-bd82-629965bb1d4c" name="EvidenceRoom rule 1" naturalLanguageRule="Bind evidence and review to exact object version/hash; contributors cannot review their own evidence." enforcedBy="7bb9adfb-1c72-5118-84d2-f5afe32d10be e7f51d13-3f43-5af7-9210-5cc877cb7ca2 bf768638-56ad-575f-b070-2e5e0bab2eaf 221f2f30-9265-5594-8b30-305f946b0e5d 95fe2b55-c47f-521f-8850-72c9eb2715ac f0b66a87-2239-54ca-bce6-772dd0b0a84f" />
  <businessRules xsi:type="policy:BusinessRule" id="c5babccc-fa64-5790-b2e3-ffefc1e75bcb" name="EvidenceRoom rule 2" naturalLanguageRule="Only authorized roles access provenance/content or change holds; distinguish denied attempts from accepted actions." enforcedBy="7bb9adfb-1c72-5118-84d2-f5afe32d10be e7f51d13-3f43-5af7-9210-5cc877cb7ca2 bf768638-56ad-575f-b070-2e5e0bab2eaf 221f2f30-9265-5594-8b30-305f946b0e5d 95fe2b55-c47f-521f-8850-72c9eb2715ac f0b66a87-2239-54ca-bce6-772dd0b0a84f" />
  <businessRules xsi:type="policy:BusinessRule" id="f69e6204-d380-5427-9173-e7ea4500fcea" name="EvidenceRoom rule 3" naturalLanguageRule="Study retention is 30 days; serialize holds and deletion authorization on one evidence state, and reject new holds after DELETE_AUTHORIZED." enforcedBy="7bb9adfb-1c72-5118-84d2-f5afe32d10be e7f51d13-3f43-5af7-9210-5cc877cb7ca2 bf768638-56ad-575f-b070-2e5e0bab2eaf 221f2f30-9265-5594-8b30-305f946b0e5d 95fe2b55-c47f-521f-8850-72c9eb2715ac f0b66a87-2239-54ca-bce6-772dd0b0a84f" />
  <businessRules xsi:type="policy:BusinessRule" id="140f91d2-9349-57fe-8d13-54a38fdf8105" name="EvidenceRoom rule 4" naturalLanguageRule="Confirm physical deletion before success; retain content-free disposition/custody tombstones for 90 study days. No regulatory certification or WORM claim." enforcedBy="7bb9adfb-1c72-5118-84d2-f5afe32d10be e7f51d13-3f43-5af7-9210-5cc877cb7ca2 bf768638-56ad-575f-b070-2e5e0bab2eaf 221f2f30-9265-5594-8b30-305f946b0e5d 95fe2b55-c47f-521f-8850-72c9eb2715ac f0b66a87-2239-54ca-bce6-772dd0b0a84f" />
