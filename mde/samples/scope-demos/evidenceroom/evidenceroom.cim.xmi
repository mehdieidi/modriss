  </requirements>
  <requirements xsi:type="cimorg:Requirement" id="e6325300-64a8-5fa4-a456-4a2a4c459bf6" name="ER-R2" mandatory="true" productionBlocking="false" externalId="ER-R2" description="A contributor cannot review their own evidence; accept/reject records identify the exact reviewed version and reason." fitCriterion="A contributor cannot review their own evidence; accept/reject records identify the exact reviewed version and reason." requirementType="FUNCTIONAL" constrains="bf52c422-6308-5bd8-ba33-05466c05b13f" supportsGoals="92c17203-abc1-5070-ac07-b2243e4bd994">
