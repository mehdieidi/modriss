  </requirements>
  <requirements xsi:type="cimorg:Requirement" id="14f185aa-15b1-5522-9ec4-63ddbef47dad" name="ER-R3" mandatory="true" productionBlocking="false" externalId="ER-R3" description="Only authorized roles retrieve content/provenance and place/release holds; access attempts and accepted actions are distinguishable in audit records." fitCriterion="Only authorized roles retrieve content/provenance and place/release holds; access attempts and accepted actions are distinguishable in audit records." requirementType="FUNCTIONAL" constrains="bf52c422-6308-5bd8-ba33-05466c05b13f" supportsGoals="92c17203-abc1-5070-ac07-b2243e4bd994">
