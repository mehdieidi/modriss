  </requirements>
  <requirements xsi:type="cimorg:Requirement" id="60576891-2f43-5ba5-b51c-2f32b9c08560" name="ER-R4" mandatory="true" productionBlocking="false" externalId="ER-R4" description="Delete study content only after retentionUntil and with no active hold; hold acceptance and deletion authorization serialize against the same evidence state." fitCriterion="Delete study content only after retentionUntil and with no active hold; hold acceptance and deletion authorization serialize against the same evidence state." requirementType="FUNCTIONAL" constrains="bf52c422-6308-5bd8-ba33-05466c05b13f" supportsGoals="92c17203-abc1-5070-ac07-b2243e4bd994">
