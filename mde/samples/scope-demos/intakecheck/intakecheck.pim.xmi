  <businessRules xsi:type="policy:BusinessRule" id="510d6c27-7fa1-5b8a-af91-e23438a9d9b1" name="IntakeCheck rule 1" naturalLanguageRule="Inputs are private CSV v1 with sku,title,priceCents; limit 1 MiB and 1000 rows." enforcedBy="77945ae7-f35d-56ec-826c-e9ffd676b075 a2acaace-d502-5c72-b19b-ba800e79848f 1445aa69-27de-510d-8f5a-01d7008bda31 913e2db0-098d-530a-ae5c-0075e3309006" />
  <businessRules xsi:type="policy:BusinessRule" id="e0fc9fbd-017f-5eff-a5ed-95301d7de76a" name="IntakeCheck rule 2" naturalLanguageRule="Validate required headers, unique SKU, nonblank title and positive integer price; reject the whole invalid catalogue with line-specific errors." enforcedBy="77945ae7-f35d-56ec-826c-e9ffd676b075 a2acaace-d502-5c72-b19b-ba800e79848f 1445aa69-27de-510d-8f5a-01d7008bda31 913e2db0-098d-530a-ae5c-0075e3309006" />
