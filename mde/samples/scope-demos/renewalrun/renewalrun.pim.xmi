  <businessRules xsi:type="policy:BusinessRule" id="291405d2-11fa-51a0-982a-458492c27eac" name="RenewalRun rule 4" naturalLanguageRule="Checkpoint bounded pages and resume with one reminder per member/period/kind; corrections are new snapshot revisions." enforcedBy="2aa2f25a-9152-53f1-9aef-a04297fcbbe0 450fb613-4637-5ba8-9ab6-cf95662228ab d78b55eb-b8ad-5fd3-aea6-0ca8b375425a c0ca0c78-2141-581d-a7f2-6f84cfd01354" />
