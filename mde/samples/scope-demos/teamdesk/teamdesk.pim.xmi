  <businessRules xsi:type="policy:BusinessRule" id="aa26bc54-3ed4-5a7a-963f-e0ed049f8b3a" name="TeamDesk rule 1" naturalLanguageRule="Resolve requested organization scope against verified active membership; never trust a body orgId or role." enforcedBy="aa7ef334-2442-5ece-aa5d-03ae9cc28c2f 3d89d224-a190-5baa-bc66-3534786462d5 24c14f66-a78c-57c2-b177-4510a6ca4edb 1fb92805-f87e-5c6b-b608-fc6275005016 5f5f28ba-05de-5f9b-94fe-b499b4bdbe28 1bb15d3e-ba2d-5029-a497-d6089846017e" />
  <businessRules xsi:type="policy:BusinessRule" id="b1b757b5-91c0-58a8-ba29-12d5c085d56d" name="TeamDesk rule 2" naturalLanguageRule="Expected-version mutations and attributable history apply within the organization; only admins manage membership/settings." enforcedBy="aa7ef334-2442-5ece-aa5d-03ae9cc28c2f 3d89d224-a190-5baa-bc66-3534786462d5 24c14f66-a78c-57c2-b177-4510a6ca4edb 1fb92805-f87e-5c6b-b608-fc6275005016 5f5f28ba-05de-5f9b-94fe-b499b4bdbe28 1bb15d3e-ba2d-5029-a497-d6089846017e" />
  <businessRules xsi:type="policy:BusinessRule" id="1a1aa6e3-9f21-5adc-8213-730f936b763d" name="TeamDesk rule 3" naturalLanguageRule="Include orgId in data/index/idempotency/background/cache scope, allowing colliding local IDs in two organizations." enforcedBy="aa7ef334-2442-5ece-aa5d-03ae9cc28c2f 3d89d224-a190-5baa-bc66-3534786462d5 24c14f66-a78c-57c2-b177-4510a6ca4edb 1fb92805-f87e-5c6b-b608-fc6275005016 5f5f28ba-05de-5f9b-94fe-b499b4bdbe28 1bb15d3e-ba2d-5029-a497-d6089846017e" />
  <businessRules xsi:type="policy:BusinessRule" id="fb7dc65e-3fab-5a9b-9686-3e98af476d48" name="TeamDesk rule 4" naturalLanguageRule="SUSPENDED organizations deny all member business operations; platform operators have health-only access." enforcedBy="aa7ef334-2442-5ece-aa5d-03ae9cc28c2f 3d89d224-a190-5baa-bc66-3534786462d5 24c14f66-a78c-57c2-b177-4510a6ca4edb 1fb92805-f87e-5c6b-b608-fc6275005016 5f5f28ba-05de-5f9b-94fe-b499b4bdbe28 1bb15d3e-ba2d-5029-a497-d6089846017e" />
  <policies xsi:type="policy:IdempotencyPolicy" id="efcddd9d-7088-501e-b84a-f81f2ad59966" name="Durable scoped request/event keys" storeRequired="true" appliesToRetries="true" appliesToDuplicateRequests="true" productionRequired="false" keySource="orgId/subjectId/requestKey or stable event identity" scope="TeamDesk" attachedTo="aa7ef334-2442-5ece-aa5d-03ae9cc28c2f 3d89d224-a190-5baa-bc66-3534786462d5 24c14f66-a78c-57c2-b177-4510a6ca4edb 1fb92805-f87e-5c6b-b608-fc6275005016 5f5f28ba-05de-5f9b-94fe-b499b4bdbe28 1bb15d3e-ba2d-5029-a497-d6089846017e" />
