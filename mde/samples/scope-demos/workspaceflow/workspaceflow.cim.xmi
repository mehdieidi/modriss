  </requirements>
  <requirements xsi:type="cimorg:Requirement" id="0248c9c9-0c72-5213-8464-c93f7ba769f1" name="WF-R4" mandatory="true" productionBlocking="false" externalId="WF-R4" description="Retain the original request and each required task result; terminal success requires successful readiness verification." fitCriterion="Retain the original request and each required task result; terminal success requires successful readiness verification." requirementType="FUNCTIONAL" constrains="159919d9-cc51-5dc9-a0a2-cac179c16ec0" supportsGoals="6af5059d-640a-5a29-9c02-4fdd60a90c9c">
