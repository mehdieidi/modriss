  </requirements>
  <requirements xsi:type="cimorg:Requirement" id="c443c8a4-48e8-5331-8053-b2d8b96caf65" name="WF-R2" mandatory="true" productionBlocking="false" externalId="WF-R2" description="Allocation and manifest tasks execute in order with stable per-request identities; task retry cannot create a second workspace/manifest." fitCriterion="Allocation and manifest tasks execute in order with stable per-request identities; task retry cannot create a second workspace/manifest." requirementType="FUNCTIONAL" constrains="159919d9-cc51-5dc9-a0a2-cac179c16ec0" supportsGoals="6af5059d-640a-5a29-9c02-4fdd60a90c9c">
