  <policies xsi:type="cimprocess:Policy" id="61c3af37-9214-5a0e-b57b-cb6c03ee1866" name="WorkspaceFlow rule 2" auditRequired="false" naturalLanguageRule="ValidateRequest -&gt; ALLOW/DENY -&gt; AllocateWorkspace -&gt; CreateManifest -&gt; five-second wait -&gt; VerifyWorkspace -&gt; READY/FAILED." policyType="GUARD" guards="ddde0277-a101-545c-aebb-8499899fb4ff bbb32c7e-3308-59bf-97ab-6b8aec724142" />
