  </requirements>
  <requirements xsi:type="cimorg:Requirement" id="7bfdb6c1-df9b-5f05-95f1-be9a6d1aca0f" name="WF-R3" mandatory="true" productionBlocking="false" externalId="WF-R3" description="Explicit evaluator outcomes select accepted branches; unknown outcomes use a reviewed failure default rather than accidental success." fitCriterion="Explicit evaluator outcomes select accepted branches; unknown outcomes use a reviewed failure default rather than accidental success." requirementType="FUNCTIONAL" constrains="159919d9-cc51-5dc9-a0a2-cac179c16ec0" supportsGoals="6af5059d-640a-5a29-9c02-4fdd60a90c9c">
