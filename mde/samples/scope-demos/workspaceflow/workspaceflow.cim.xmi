  </requirements>
  <requirements xsi:type="cimorg:Requirement" id="b84807b9-1c58-5ae0-a071-e21d22f70280" name="WF-R5" mandatory="true" productionBlocking="false" externalId="WF-R5" description="A failed execution is visible with its last completed task and can be resumed/retried through an authorized, idempotent recovery design." fitCriterion="A failed execution is visible with its last completed task and can be resumed/retried through an authorized, idempotent recovery design." requirementType="FUNCTIONAL" constrains="159919d9-cc51-5dc9-a0a2-cac179c16ec0" supportsGoals="6af5059d-640a-5a29-9c02-4fdd60a90c9c">
