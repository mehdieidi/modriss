  <requirements xsi:type="cimorg:Requirement" id="f39f7a14-23bd-522d-b5b6-0b2b4f8b82fc" name="WF-R1" mandatory="true" productionBlocking="false" externalId="WF-R1" description="A request for 1–30 seats and a nonblank course code is accepted once per business key; the instructor sees only their requests." fitCriterion="A request for 1–30 seats and a nonblank course code is accepted once per business key; the instructor sees only their requests." requirementType="FUNCTIONAL" constrains="159919d9-cc51-5dc9-a0a2-cac179c16ec0" supportsGoals="6af5059d-640a-5a29-9c02-4fdd60a90c9c">
