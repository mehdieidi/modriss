  <policies xsi:type="cimprocess:Policy" id="544c695c-68e1-5b36-9b59-f61833569a3a" name="RoomSlot rule 2" auditRequired="false" naturalLanguageRule="A hold lasts five minutes; confirmation requires now &lt; expiresAt, and expiry wins at equality." policyType="GUARD" guards="cba40a2d-974e-52b0-92f4-d21d8fece827 947bc452-9c24-5587-95ed-88e131894f9e 80c65cc1-5ef2-573c-89bf-4d710f4070d5 7bd63404-cef4-5928-92ba-3126baeab72a" />
