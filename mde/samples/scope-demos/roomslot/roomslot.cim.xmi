  <requirements xsi:type="cimorg:Requirement" id="0cfcc07a-0611-5ff7-be13-1122f5da9e68" name="RS-R3" mandatory="true" productionBlocking="false" externalId="RS-R3" description="Cancellation or expiry releases a slot at most once and cannot release a newer reservation's allocation." fitCriterion="Cancellation or expiry releases a slot at most once and cannot release a newer reservation's allocation." requirementType="FUNCTIONAL" constrains="a7cafbf3-5458-5c9c-98ab-1d3d8ba11579" supportsGoals="53bc4499-8834-5cc5-930d-e4238b44b8b1">
