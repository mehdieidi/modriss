  <requirements xsi:type="cimorg:Requirement" id="e0ad09ff-f68b-52e7-b4e6-d32105cf5493" name="RS-R1" mandatory="true" productionBlocking="false" externalId="RS-R1" description="At most one HELD or CONFIRMED reservation owns a slot; competing requests receive one success and explicit conflicts." fitCriterion="At most one HELD or CONFIRMED reservation owns a slot; competing requests receive one success and explicit conflicts." requirementType="FUNCTIONAL" constrains="a7cafbf3-5458-5c9c-98ab-1d3d8ba11579" supportsGoals="53bc4499-8834-5cc5-930d-e4238b44b8b1">
    <acceptanceCriteria xsi:type="cimorg:AcceptanceCriterion" id="b71d86d6-b135-567f-b14b-d813a0de96d5" name="RS-AT1" automatableTestCandidate="true" thenOutcome="Release 20 concurrent hold requests for the same slot: exactly one live reservation/allocation pair." givenContext="Synthetic study fixtures from the source brief" whenAction="RS-AT1 action in the source brief" />
  </requirements>
  <requirements xsi:type="cimorg:Requirement" id="c7f518e3-abd0-5a9a-b0a7-1a1daaffd639" name="RS-R2" mandatory="true" productionBlocking="false" externalId="RS-R2" description="A hold lasts five minutes and can be confirmed only before expiry; a replay returns the original reservation." fitCriterion="A hold lasts five minutes and can be confirmed only before expiry; a replay returns the original reservation." requirementType="FUNCTIONAL" constrains="a7cafbf3-5458-5c9c-98ab-1d3d8ba11579" supportsGoals="53bc4499-8834-5cc5-930d-e4238b44b8b1">
    <acceptanceCriteria xsi:type="cimorg:AcceptanceCriterion" id="82a22918-34a7-5657-a4c8-06aca160520b" name="RS-AT2" automatableTestCandidate="true" thenOutcome="Confirm at 08:04:59, then in an isolated reset at 08:05:00; accept only the first. Replayed confirmation has no extra effect." givenContext="Synthetic study fixtures from the source brief" whenAction="RS-AT2 action in the source brief" />
