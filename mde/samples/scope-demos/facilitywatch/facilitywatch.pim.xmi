  <businessRules xsi:type="policy:BusinessRule" id="a2cf8e98-68fc-5274-8d61-3bae7a6e9e10" name="FacilityWatch rule 1" naturalLanguageRule="Accept finite numeric temperature from a registered source, retaining occurredAt and receivedAt separately." enforcedBy="592ba1ea-2e7d-59d1-a638-b1d1cd4ec6b7 a0136176-5101-5b64-b4fe-8ae1818ab0ea d3b2838c-08c3-5ee0-8508-6f759de62bf4 69e5d995-e6fa-5ea6-b3ab-d8043794d8ca 4b6bbd4c-97b0-5f03-b653-0c785d4d736e 9e76b2fb-e5d4-5ef0-9040-f5d1c676696b" />
  <businessRules xsi:type="policy:BusinessRule" id="b22c3362-519b-5648-b458-5e053aa68f41" name="FacilityWatch rule 2" naturalLanguageRule="Three consecutive accepted samples above 28 C open at most one unresolved incident; duplicates/older sequences do not update state and gaps reset the run." enforcedBy="592ba1ea-2e7d-59d1-a638-b1d1cd4ec6b7 a0136176-5101-5b64-b4fe-8ae1818ab0ea d3b2838c-08c3-5ee0-8508-6f759de62bf4 69e5d995-e6fa-5ea6-b3ab-d8043794d8ca 4b6bbd4c-97b0-5f03-b653-0c785d4d736e 9e76b2fb-e5d4-5ef0-9040-f5d1c676696b" />
  <businessRules xsi:type="policy:BusinessRule" id="0d45182a-8eb3-5e33-b5bc-d3ca515f0fd9" name="FacilityWatch rule 3" naturalLanguageRule="After five minutes without an accepted sample mark data STALE; only assigned technicians/supervisors resolve with a nonblank note." enforcedBy="592ba1ea-2e7d-59d1-a638-b1d1cd4ec6b7 a0136176-5101-5b64-b4fe-8ae1818ab0ea d3b2838c-08c3-5ee0-8508-6f759de62bf4 69e5d995-e6fa-5ea6-b3ab-d8043794d8ca 4b6bbd4c-97b0-5f03-b653-0c785d4d736e 9e76b2fb-e5d4-5ef0-9040-f5d1c676696b" />
  <businessRules xsi:type="policy:BusinessRule" id="4fa37304-90ae-58db-9c2f-f2a84595d01e" name="FacilityWatch rule 4" naturalLanguageRule="This is supervisory comfort information; there is no physical actuation or safety guarantee." enforcedBy="592ba1ea-2e7d-59d1-a638-b1d1cd4ec6b7 a0136176-5101-5b64-b4fe-8ae1818ab0ea d3b2838c-08c3-5ee0-8508-6f759de62bf4 69e5d995-e6fa-5ea6-b3ab-d8043794d8ca 4b6bbd4c-97b0-5f03-b653-0c785d4d736e 9e76b2fb-e5d4-5ef0-9040-f5d1c676696b" />
