  <businessRules xsi:type="policy:BusinessRule" id="882d1365-923c-562c-a963-4fae93e6eeaa" name="ExportQueue rule 1" naturalLanguageRule="Accept only after job and recoverable dispatch intent persist together; replay returns one job." enforcedBy="eeaa9e86-2fae-5475-bcc0-16d833364616 9cac1b08-ad33-58a1-bb69-77fc58e5f965 5fbe4d29-add5-5592-a94d-ae9b4609543c 77b297cf-338d-5b0f-8257-55da91e1b6da" />
  <businessRules xsi:type="policy:BusinessRule" id="30a056ad-398b-5ef6-8f31-630e1edc7841" name="ExportQueue rule 2" naturalLanguageRule="Select at most 1000 rows from the immutable 10000-row snapshot; publish one correct private CSV per job." enforcedBy="eeaa9e86-2fae-5475-bcc0-16d833364616 9cac1b08-ad33-58a1-bb69-77fc58e5f965 5fbe4d29-add5-5592-a94d-ae9b4609543c 77b297cf-338d-5b0f-8257-55da91e1b6da" />
  <businessRules xsi:type="policy:BusinessRule" id="64ca6734-03ae-5d1e-a740-aa0b61a805c8" name="ExportQueue rule 3" naturalLanguageRule="Cancellation commits only in QUEUED/RUNNING; if it wins workers cannot publish success, and if success wins cancellation conflicts." enforcedBy="eeaa9e86-2fae-5475-bcc0-16d833364616 9cac1b08-ad33-58a1-bb69-77fc58e5f965 5fbe4d29-add5-5592-a94d-ae9b4609543c 77b297cf-338d-5b0f-8257-55da91e1b6da" />
  <businessRules xsi:type="policy:BusinessRule" id="fffb6cb8-29f0-5f0c-8407-545aa2619683" name="ExportQueue rule 4" naturalLanguageRule="Only owners see status/cancel/download; CANCELLED jobs have no result. Configure five concurrent workers and recover partial batches." enforcedBy="eeaa9e86-2fae-5475-bcc0-16d833364616 9cac1b08-ad33-58a1-bb69-77fc58e5f965 5fbe4d29-add5-5592-a94d-ae9b4609543c 77b297cf-338d-5b0f-8257-55da91e1b6da" />
