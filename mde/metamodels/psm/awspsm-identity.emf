/** Defines the awspsm identity metamodel package. */
@namespace(uri="https://modless.org/awspsm/identity/1.0", prefix="awspsmidentity")
package awspsmidentity;

import "../shared/kernel.ecore";
import "awspsm-enums.ecore";
import "awspsm-core.ecore";
import "awspsm-security.ecore";

/** Represents the Cognito User Pool concept in this model. */
class CognitoUserPool extends awspsmcore.AwsResource {
  attr String userPoolName;
  attr awspsmenums.CognitoMfaConfiguration mfaConfiguration;
  attr awspsmenums.Decision[1] mfaDecision;
  attr String mfaRationale;
  attr String[*] usernameAttributes;
  attr String[*] aliasAttributes;
  attr String[*] autoVerifiedAttributes;
  val CognitoAccountRecoverySetting[?] accountRecoverySetting;
  attr String accountRecoverySettingJson;
  attr String adminCreateUserConfigJson;
  val CognitoEmailConfiguration[?] emailConfiguration;
  attr String emailConfigurationJson;
  attr String smsConfigurationJson;
  val CognitoLambdaConfig[?] lambdaConfig;
  attr String lambdaConfigJson;
  val CognitoPasswordPolicy[?] passwordPolicy;
  attr String policiesJson;
  val CognitoSchemaAttribute[*] schemaAttributes;
  attr String schemaJson;
  attr Boolean deletionProtection;
  ref CognitoUserPoolClient[*]#userPool clients;
  ref CognitoUserPoolGroup[*]#userPool groups;
  ref CognitoUserPoolDomain[?]#userPool domain;
}

/** Represents the Cognito Password Policy concept in this model. */
class CognitoPasswordPolicy extends kernel.TraceableElement {
  attr Integer minimumLength;
  attr Boolean requireUppercase;
  attr Boolean requireLowercase;
  attr Boolean requireNumbers;
  attr Boolean requireSymbols;
  attr Integer temporaryPasswordValidityDays;
}

/** Represents the Cognito Schema Attribute concept in this model. */
class CognitoSchemaAttribute extends kernel.TraceableElement {
  attr String[1] attributeName;
  attr String[1] attributeDataType;
  attr Boolean required;
  attr Boolean mutable;
  attr String developerOnlyAttribute;
  attr String minLength;
  attr String maxLength;
  attr String minimum;
  attr String maximum;
}

/** Represents the Cognito Email Configuration concept in this model. */
class CognitoEmailConfiguration extends kernel.TraceableElement {
  attr String emailSendingAccount;
  attr String from;
  attr String replyToEmailAddress;
  attr String sourceArn;
  attr String configurationSet;
}

/** Represents the Cognito Account Recovery Setting concept in this model. */
class CognitoAccountRecoverySetting extends kernel.TraceableElement {
  val CognitoRecoveryMechanism[*] recoveryMechanisms;
}

/** Represents the Cognito Recovery Mechanism concept in this model. */
class CognitoRecoveryMechanism extends kernel.TraceableElement {
  attr String[1] name;
  attr Integer[1] priority;
}

/** Represents the Cognito Lambda Config concept in this model. */
class CognitoLambdaConfig extends kernel.TraceableElement {
  ref awspsmcore.AwsResource[?] preSignUp;
  ref awspsmcore.AwsResource[?] postConfirmation;
  ref awspsmcore.AwsResource[?] preAuthentication;
  ref awspsmcore.AwsResource[?] postAuthentication;
  ref awspsmcore.AwsResource[?] customMessage;
  ref awspsmcore.AwsResource[?] defineAuthChallenge;
  ref awspsmcore.AwsResource[?] createAuthChallenge;
  ref awspsmcore.AwsResource[?] verifyAuthChallengeResponse;
  ref awspsmcore.AwsResource[?] preTokenGeneration;
  ref awspsmcore.AwsResource[?] userMigration;
}

/** Represents the Cognito User Pool Client concept in this model. */
class CognitoUserPoolClient extends awspsmcore.AwsResource {
  attr String clientName;
  attr Boolean generateSecret;
  attr String[*] explicitAuthFlows;
  attr String[*] supportedIdentityProviders;
  attr String[*] callbackUrls;
  attr String[*] logoutUrls;
  attr String[*] allowedOAuthFlows;
  attr String[*] allowedOAuthScopes;
  attr Boolean allowedOAuthFlowsUserPoolClient;
  attr Integer accessTokenValidity;
  attr Integer idTokenValidity;
  attr Integer refreshTokenValidity;
  attr String tokenValidityUnitsJson;
  attr String preventUserExistenceErrors;
  val CognitoOAuthConfiguration[?] oauthConfiguration;
  ref CognitoUserPool[1]#clients userPool;
}

/** Represents the Cognito O Auth Configuration concept in this model. */
class CognitoOAuthConfiguration extends kernel.TraceableElement {
  attr String[*] callbackUrls;
  attr String[*] logoutUrls;
  attr String[*] allowedOAuthFlows;
  attr String[*] allowedOAuthScopes;
  attr Boolean allowedOAuthFlowsUserPoolClient;
  attr String[*] supportedIdentityProviders;
}

/** Represents the Cognito User Pool Group concept in this model. */
class CognitoUserPoolGroup extends awspsmcore.AwsResource {
  attr String groupName;
  attr String descriptionText;
  attr Integer precedence;
  ref CognitoUserPool[1]#groups userPool;
  ref awspsmsecurity.IamRole[?] role;
}

/** Represents the Cognito User Pool Domain concept in this model. */
class CognitoUserPoolDomain extends awspsmcore.AwsResource {
  attr String[1] domain;
  attr String certificateArn;
  ref CognitoUserPool[1]#domain userPool;
}

/** Represents the Cognito Identity Pool concept in this model. */
class CognitoIdentityPool extends awspsmcore.AwsResource {
  attr String identityPoolName;
  attr Boolean allowUnauthenticatedIdentities;
  attr String cognitoIdentityProvidersJson;
}
