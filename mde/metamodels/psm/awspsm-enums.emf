/** Defines the awspsm enums metamodel package. */
@namespace(uri="https://modless.org/awspsm/enums/1.0", prefix="awspsmenums")
package awspsmenums;

/** Defines the supported Aws Environment Class values. */
enum AwsEnvironmentClass {
