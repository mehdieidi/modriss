@namespace(uri="https://modless.org/awspsm/1.0", prefix="awspsm")
package awspsm;

import "../shared/kernel.ecore";
import "awspsm-enums.ecore";
import "awspsm-core.ecore";
import "awspsm-security.ecore";
import "awspsm-observability.ecore";
import "awspsm-networking.ecore";
import "awspsm-messaging.ecore";
import "awspsm-storage.ecore";
import "awspsm-identity.ecore";
import "awspsm-workflow.ecore";
import "awspsm-compute.ecore";
import "awspsm-api.ecore";
import "awspsm-events.ecore";
import "awspsm-integrations.ecore";

class AwsPsmModel extends kernel.TraceableElement {
  attr awspsmenums.AwsPartition[1] partition;
  attr String accountStrategy;
  attr String regionStrategy;
  attr String defaultRegion;
  attr String namingConvention;
  attr String taggingStrategy;
  attr Boolean productionMode;

  val awspsmcore.AwsStage[+] stages;
  val awspsmcore.SamStack[+] stacks;
  readonly transient volatile derived ref awspsmcore.AwsResource[*] allResources;
  val awspsmcore.SamGlobals[?] samGlobals;
  val awspsmcore.AwsNamingPolicy[?] namingPolicy;
  val awspsmcore.AwsTaggingPolicy[?] taggingPolicy;
  val awspsmcore.AwsSecurityBaseline[?] securityBaseline;
  val kernel.TraceModel[?] traceModel;
  val kernel.ProductionReadinessAssessment[?] readiness;
  val kernel.StructuredDocument[*] documents;
  val awspsmintegrations.AwsRelationshipView[*] relationshipViews;
}
