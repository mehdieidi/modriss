@namespace(uri="https://modless.org/awspsm/integrations/1.0", prefix="awspsmintegrations")
package awspsmintegrations;

import "../shared/kernel.ecore";
import "awspsm-core.ecore";
import "awspsm-compute.ecore";
import "awspsm-api.ecore";
