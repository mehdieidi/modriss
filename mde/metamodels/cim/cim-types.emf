/** Defines the cim types metamodel package. */
@namespace(uri="https://modless.org/cim/types/1.0", prefix="cimtypes")
package cimtypes;

/** Defines the supported Requirement Type values. */
enum RequirementType {
  FUNCTIONAL;
  BUSINESS_RULE;
  QUALITY;
  SECURITY;
  PRIVACY;
  COMPLIANCE;
  AUDIT;
  REPORTING;
  DATA_GOVERNANCE;
}

/** Defines the supported Requirement Source Type values. */
enum RequirementSourceType {
  STAKEHOLDER;
  REGULATION;
  POLICY_DOCUMENT;
  WORKSHOP;
  EXISTING_SYSTEM;
  ASSUMPTION;
  AI_ASSISTANT;
}

/** Defines the supported Requirement Relationship Kind values. */
enum RequirementRelationshipKind {
  DEPENDS_ON;
  CONFLICTS_WITH;
  REFINES;
  DUPLICATES;
  DERIVES_FROM;
}

/** Defines the supported Actor Type values. */
enum ActorType {
  HUMAN;
  ORGANIZATION;
  DEPARTMENT;
  EXTERNAL_ORGANIZATION;
  EXTERNAL_SYSTEM;
  TIME;
  REGULATOR;
}

/** Defines the supported Trust Level values. */
enum TrustLevel {
  TRUSTED_INTERNAL;
  PARTIALLY_TRUSTED;
  UNTRUSTED_EXTERNAL;
  REGULATED_EXTERNAL;
}

/** Defines the supported Capability Criticality values. */
enum CapabilityCriticality {
  SUPPORTING;
  IMPORTANT;
  CORE;
  MISSION_CRITICAL;
}

/** Defines the supported Domain Relationship Type values. */
enum DomainRelationshipType {
  ASSOCIATION;
  COMPOSITION;
  AGGREGATION;
  GENERALIZATION;
  DEPENDENCY;
  OWNERSHIP;
}

/** Defines the supported Primitive Business Type values. */
enum PrimitiveBusinessType {
  TEXT;
  NUMBER;
  INTEGER;
  DECIMAL;
  BOOLEAN;
  DATE;
  TIME;
  DATETIME;
  MONEY;
  EMAIL;
  PHONE;
  ADDRESS;
  IDENTIFIER;
  ENUMERATION;
  OBJECT;
  LIST;
  DOCUMENT;
  BINARY;
}

/** Defines the supported Identity Strategy values. */
enum IdentityStrategy {
  NATURAL_KEY;
  COMPOSITE_NATURAL_KEY;
  SURROGATE_KEY;
  EXTERNAL_REFERENCE;
  UNKNOWN;
}

/** Defines the supported Data Kind values. */
enum DataKind {
  PUBLIC;
  INTERNAL;
  CONFIDENTIAL;
  PERSONAL;
  SENSITIVE_PERSONAL;
  FINANCIAL;
  HEALTH;
  AUTHENTICATION_SECRET;
  REGULATED;
}

/** Defines the supported Identifiability values. */
enum Identifiability {
  NON_PERSONAL;
  PSEUDONYMOUS;
  DIRECTLY_IDENTIFYING;
  INDIRECTLY_IDENTIFYING;
  ANONYMOUS;
}

/** Defines the supported Command Type values. */
enum CommandType {
  USER_INTENT;
  BUSINESS_SYSTEM_INTENT;
  EXTERNAL_SYSTEM_INTENT;
  POLICY_TRIGGERED_INTENT;
  CORRECTION;
  CANCELLATION;
}

/** Defines the supported Query Type values. */
enum QueryType {
  LOOKUP;
  LIST;
  SEARCH;
  REPORT;
  STATUS;
  ANALYTICS;
}

/** Defines the supported Freshness Need values. */
enum FreshnessNeed {
  REAL_TIME;
  NEAR_REAL_TIME;
  EVENTUALLY_CONSISTENT;
  PERIODIC;
  HISTORICAL;
}

/** Defines the supported Event Time Semantics values. */
enum EventTimeSemantics {
  BUSINESS_TIME;
  OBSERVATION_TIME;
  RECORDING_TIME;
}

/** Defines the supported Policy Type values. */
enum PolicyType {
  REACTION;
  GUARD;
  DERIVATION;
  AUTHORIZATION;
  VALIDATION;
  COMPLIANCE;
  ESCALATION;
  COMPENSATION;
}

/** Defines the supported Process Kind values. */
enum ProcessKind {
  STRAIGHT_THROUGH;
  HUMAN_INVOLVED;
  LONG_RUNNING;
  CASE_MANAGEMENT;
  SAGA_LIKE_BUSINESS_PROCESS;
  REPORTING_PROCESS;
}

/** Defines the supported Step Kind values. */
enum StepKind {
  COMMAND;
  QUERY;
  EVENT;
  DECISION;
  POLICY;
  HUMAN_TASK;
  EXTERNAL_INTERACTION;
  WAIT;
  START;
  END;
}

/** Defines the supported Quality Type values. */
enum QualityType {
  PERFORMANCE;
  LATENCY;
  AVAILABILITY;
  RELIABILITY;
  SCALABILITY;
  SECURITY;
  PRIVACY;
  AUDITABILITY;
  MAINTAINABILITY;
  OPERABILITY;
  COST;
  DATA_QUALITY;
  COMPLIANCE;
  USABILITY;
}

/** Defines the supported Legal Basis values. */
enum LegalBasis {
  CONSENT;
  CONTRACT;
  LEGAL_OBLIGATION;
  VITAL_INTERESTS;
  PUBLIC_TASK;
  LEGITIMATE_INTEREST;
  NOT_APPLICABLE;
  UNKNOWN;
}

/** Defines the supported Interaction Expectation values. */
enum InteractionExpectation {
  IMMEDIATE_RESPONSE_EXPECTED;
  RESPONSE_CAN_BE_DELAYED;
  NOTIFICATION_EXPECTED;
  BACK_OFFICE_PROCESSING;
  HUMAN_REVIEW_REQUIRED;
}

/** Defines the supported Consistency Expectation values. */
enum ConsistencyExpectation {
  SINGLE_ENTITY;
  MULTI_ENTITY_STRONG_CONSISTENCY;
  EVENTUAL_CONSISTENCY_ACCEPTABLE;
  MANUAL_RECONCILIATION_ACCEPTABLE;
}
