          eType="#/2/InformationItem"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="equalityAttributes" upperBound="-1"
          eType="#/2/InformationItem"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="DomainRelationship" eSuperTypes="#/8/SemanticRelationship">
