      <eStructuralFeatures xsi:type="ecore:EReference" name="invariants" upperBound="-1"
          eType="#/2/BusinessInvariant" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="identityAttributes" lowerBound="1"
