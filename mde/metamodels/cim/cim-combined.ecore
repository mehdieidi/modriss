      <eStructuralFeatures xsi:type="ecore:EAttribute" name="businessOwner" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="outgoingRelationships"
          upperBound="-1" eType="#/2/DomainRelationship" eOpposite="#/2/DomainRelationship/source"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="incomingRelationships"
          upperBound="-1" eType="#/2/DomainRelationship" eOpposite="#/2/DomainRelationship/target"/>
    </eClassifiers>
