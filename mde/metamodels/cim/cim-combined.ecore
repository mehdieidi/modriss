  <ecore:EPackage name="cimdomain" nsURI="https://modless.org/cim/domain-data/1.0"
      nsPrefix="cimdomain">
    <eClassifiers xsi:type="ecore:EClass" name="DomainConcept" abstract="true" eSuperTypes="#/8/TraceableElement">
