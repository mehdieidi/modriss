@namespace(uri="https://modless.org/pim/external/1.0", prefix="external")
package external;

import "../shared/kernel.ecore";
import "pim-types.ecore";
import "pim-policy.ecore";
import "pim-config.ecore";

class ExternalEndpoint extends kernel.TraceableElement, kernel.ExternalCallTarget, kernel.PolicyTarget, kernel.ProtectedResource {
  attr String externalSystemName;
  attr String protocolFamily;
  attr String endpointDescription;
  attr Boolean privateNetworkRequired;
  attr Boolean credentialsRequired;
  attr Boolean rateLimitedByProvider;
  attr String expectedSla;
  attr String endpointUri;
  attr String authorizationEndpoint;
}

class ExternalAdapter extends kernel.TraceableElement, kernel.DeployableElement, kernel.FlowEndpoint, kernel.InvocationTarget, kernel.FunctionTarget, kernel.SubscriptionTarget, kernel.RoutingTarget, kernel.ExternalCallTarget, kernel.ProtectedResource, kernel.PolicyTarget, kernel.ConfigurableElement {
  attr String responsibility;

  val config.CredentialRequirement[*] credentials;

  ref ExternalEndpoint[1] endpoint;
  ref kernel.FunctionTarget[*] adapterFunctions;
  ref policy.ResiliencePolicy[?] resilience;
  ref policy.ObservabilityConfig[?] observability;
  ref policy.IdempotencyPolicy[?] idempotency;
}
