@namespace(uri="https://modless.org/pim/workflow/1.0", prefix="workflow")
package workflow;

import "../shared/kernel.ecore";
import "pim-types.ecore";
import "pim-compute.ecore";
import "pim-external.ecore";
import "pim-policy.ecore";
import "pim-contracts.ecore";
import "pim-security.ecore";

class Workflow extends kernel.TraceableElement, kernel.DeployableElement, kernel.InvocationTarget, kernel.WorkflowTarget, kernel.SubscriptionTarget, kernel.RoutingTarget, kernel.FlowEndpoint, kernel.PolicyTarget, kernel.ProtectedResource, kernel.ConfigurableElement {
  attr String executionSemantics;
  attr Boolean longRunning;
  attr Boolean stateful;
  attr Boolean compensationRequired;
  attr Boolean humanApprovalRequired;
  attr Integer expectedMaxDurationSeconds;
  attr Boolean expressLowLatencyRequired;
  attr pimtypes.WorkflowKind[1] workflowKind;

  val WorkflowStep[+]#workflow steps;
  val WorkflowTransition[*]#workflow transitions;

  ref policy.ObservabilityConfig[?] observability;
  ref policy.ResiliencePolicy[?] resilience;
  ref policy.IdempotencyPolicy[?] idempotency;
}

abstract class WorkflowStep extends kernel.TraceableElement, kernel.FlowEndpoint, kernel.PolicyTarget, kernel.ProtectedResource {
  attr Integer orderIndex;
  attr Integer timeoutSeconds;
  attr String inputMapping;
  attr String outputMapping;

  val policy.RetryPolicy[?] retry;
  val ErrorHandler[*]#step catchHandlers;

  readonly transient ref Workflow[1]#steps workflow;
}

class StartStep extends WorkflowStep {
  ref CompensationPolicy[?] compensation;
}

class SuccessEndStep extends WorkflowStep {
}

class FailureEndStep extends WorkflowStep {
}

class TaskStep extends WorkflowStep {
  ref compute.Function[?] invokesFunction;
  ref external.ExternalAdapter[?] invokesAdapter;
  ref Workflow[?] nestedWorkflow;
  ref HumanTask[?] humanTask;
  ref CompensationPolicy[?] compensation;

  val CallbackTaskConfig[?] callbackConfig;
}

class ChoiceStep extends WorkflowStep {
  attr String conditionExpression;

  val kernel.Expression[?] condition;

  ref compute.Function[?] invokesFunction;
}

class ParallelStep extends WorkflowStep {
  val ParallelBranch[*]#ownerStep branches;
}

class MapStep extends WorkflowStep {
  val MapStateConfig[?] mapConfig;
}

class WaitStep extends WorkflowStep {
  attr String conditionExpression;
  attr String waitReason;

  val kernel.Expression[?] condition;
}

class PassStep extends WorkflowStep {
}

class WorkflowTransition extends kernel.TraceableElement {
  attr String conditionExpression;
  attr Boolean defaultTransition;

  val kernel.Expression[?] condition;

  readonly transient ref Workflow[1]#transitions workflow;

  ref WorkflowStep[1] source;
  ref WorkflowStep[1] target;
}

class ErrorHandler extends kernel.TraceableElement {
  attr String errorSelector;
  attr String recoveryAction;
  attr Boolean continueWorkflow;

  readonly transient ref WorkflowStep[1]#catchHandlers step;

  ref WorkflowStep[?] nextStep;
  ref compute.Function[?] handlerFunction;
}

class ParallelBranch extends kernel.TraceableElement {
  readonly transient ref ParallelStep[1]#branches ownerStep;

  val WorkflowStep[+] steps;
  val WorkflowTransition[*] transitions;
}

class MapStateConfig extends kernel.TraceableElement {
  attr String itemsPath;
  attr String itemSelectorJson;
  attr Integer maxConcurrency;
  attr Boolean distributed;
  attr String resultWriterJson;

  val ParallelBranch[1] itemProcessor;
}

class CallbackTaskConfig extends kernel.TraceableElement {
  attr String taskTokenPath;

  ref kernel.RouteEndpoint[?] callbackRoute;
  ref contracts.EventType[*] completionEvents;
  ref policy.TimeoutPolicy[?] timeout;
}

class EscalationPolicy extends kernel.TraceableElement {
  attr String escalationRule;
  attr Integer afterSeconds;

  ref security.Principal[*] escalateTo;
}

class HumanTask extends kernel.TraceableElement, kernel.PolicyTarget {
  attr String taskDescription;
  attr String completionEvidence;

  ref security.Principal[*] assignees;
  ref policy.TimeoutPolicy[?] timeout;
  ref EscalationPolicy[?] escalation;
  ref contracts.EventType[*] completionEvents;
}

class ApprovalTask extends HumanTask {
  attr Boolean explicitApprovalRequired;
  attr String approvalOutcomeField;
}

class CompensationPolicy extends policy.ArchitecturePolicy {
  attr String compensationStrategy;
  attr Boolean automatic;

  ref compute.Function[*] compensationFunctions;
  ref contracts.EventType[*] compensationEvents;
}
