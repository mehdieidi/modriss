@namespace(uri="https://modless.org/pim/workflow/1.0", prefix="workflow")
package workflow;

import "../shared/kernel.ecore";
import "pim-types.ecore";
import "pim-compute.ecore";
import "pim-external.ecore";
import "pim-policy.ecore";
import "pim-contracts.ecore";

class Workflow extends kernel.TraceableElement, kernel.DeployableElement, kernel.InvocationTarget, kernel.WorkflowTarget, kernel.SubscriptionTarget, kernel.RoutingTarget, kernel.FlowEndpoint, kernel.PolicyTarget, kernel.ProtectedResource {
  attr types.WorkflowKind[1] workflowKind;
  attr String executionSemantics;
  attr Boolean longRunning;
  attr Boolean stateful;
  attr Boolean compensationRequired;
  attr Boolean humanApprovalRequired;
  attr Integer expectedMaxDurationSeconds;
  attr Boolean expressLowLatencyRequired;
  val WorkflowState[+]#workflow states;
  ref WorkflowState[1] startState;
  ref WorkflowState[+] endStates;
  val WorkflowTransition[*]#workflow transitions;
  ref policy.ObservabilityConfig[?] observability;
  ref policy.ResiliencePolicy[?] resilience;
  ref policy.IdempotencyPolicy[?] idempotency;
}

class WorkflowState extends kernel.TraceableElement, kernel.FlowEndpoint, kernel.PolicyTarget, kernel.ProtectedResource {
  attr types.WorkflowStateKind[1] stateKind;
  attr Integer orderIndex;
  attr Integer timeoutSeconds;
  attr String inputMapping;
  attr String outputMapping;
  attr String conditionExpression;
  attr Boolean terminal;
  readonly transient ref Workflow[1]#states workflow;
  ref compute.Function[?] invokesFunction;
  ref external.ExternalAdapter[?] invokesAdapter;
  ref Workflow[?] nestedWorkflow;
  val policy.RetryPolicy[?] retry;
  val ErrorHandler[*]#state catchHandlers;
  val CompensationPolicy[?] compensation;
}

class WorkflowTransition extends kernel.TraceableElement {
  attr String conditionExpression;
  attr Boolean defaultTransition;
  readonly transient ref Workflow[1]#transitions workflow;
  ref WorkflowState[1] source;
  ref WorkflowState[1] target;
}

class ErrorHandler extends kernel.TraceableElement {
  attr String errorSelector;
  attr String recoveryAction;
  attr Boolean continueWorkflow;
  readonly transient ref WorkflowState[1]#catchHandlers state;
  ref WorkflowState[?] nextState;
  ref compute.Function[?] handlerFunction;
}

class CompensationPolicy extends policy.ArchitecturePolicy {
  attr String compensationStrategy;
  attr Boolean automatic;
  ref compute.Function[*] compensationFunctions;
  ref contracts.EventType[*] compensationEvents;
}
