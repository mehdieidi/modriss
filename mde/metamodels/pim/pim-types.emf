/** Defines the pim types metamodel package. */
@namespace(uri="https://modless.org/pim/types/1.0", prefix="pimtypes")
package pimtypes;

/** Defines the supported Architecture Style values. */
enum ArchitectureStyle {
  EVENT_DRIVEN_SERVERLESS;
  API_FIRST_SERVERLESS;
  WORKFLOW_ORCHESTRATED_SERVERLESS;
  HYBRID_SERVERLESS;
}

/** Defines the supported Boundary Type values. */
enum BoundaryType {
  CAPABILITY_BASED;
  BOUNDED_CONTEXT_BASED;
  PROCESS_BASED;
  DATA_OWNERSHIP_BASED;
  TEAM_OWNERSHIP_BASED;
}

/** Defines the supported Deployment Unit Type values. */
enum DeploymentUnitType {
  APPLICATION;
  SERVICE;
  SHARED_INFRASTRUCTURE;
  LIBRARY;
  EDGE_INTERFACE;
  OBSERVABILITY;
}

/** Defines the supported Ownership Kind values. */
enum OwnershipKind {
  OWNS;
  USES_SHARED;
  DEPENDS_ON;
  EXPOSES;
}

/** Defines the supported Function Kind values. */
enum FunctionKind {
  COMMAND_HANDLER;
  QUERY_HANDLER;
  EVENT_HANDLER;
  POLICY_HANDLER;
  ORCHESTRATION_TASK;
  EXTERNAL_ADAPTER;
  SCHEDULED_TASK;
  STREAM_PROCESSOR;
  MAINTENANCE_TASK;
}

/** Defines the supported Compute Profile values. */
enum ComputeProfile {
  IO_BOUND;
  CPU_BOUND;
  MEMORY_INTENSIVE;
  LATENCY_SENSITIVE;
  BATCH_ORIENTED;
  LIGHTWEIGHT;
  UNKNOWN;
}

/** Defines the supported Execution Model values. */
enum ExecutionModel {
  REQUEST_RESPONSE;
  ASYNC_EVENT;
  BATCH_EVENT;
  STREAM_EVENT;
  SCHEDULED;
  WORKFLOW_TASK;
}

/** Defines the supported Api Style values. */
enum ApiStyle {
  RESOURCE_ORIENTED_HTTP;
  RPC_HTTP;
  GRAPHQL;
  EVENT_API;
  WEBHOOK;
}

/** Defines the supported Http Method values. */
enum HttpMethod {
  GET;
  POST;
  PUT;
  PATCH;
  DELETE;
  OPTIONS;
  HEAD;
  ANY;
}

/** Defines the supported Invocation Mode values. */
enum InvocationMode {
  SYNCHRONOUS;
  ASYNCHRONOUS;
  POLLED;
  SCHEDULED;
  ORCHESTRATED;
}

/** Defines the supported Channel Kind values. */
enum ChannelKind {
  QUEUE;
  TOPIC;
  EVENT_BUS;
  STREAM;
  WEBHOOK;
}

/** Defines the supported Delivery Semantics values. */
enum DeliverySemantics {
  AT_MOST_ONCE;
  AT_LEAST_ONCE;
  EFFECTIVELY_ONCE_WITH_IDEMPOTENCY;
  EXACTLY_ONCE_REQUIRED;
}

/** Defines the supported Ordering Requirement values. */
enum OrderingRequirement {
  NONE;
  PER_KEY;
  GLOBAL;
}

/** Defines the supported Store Kind values. */
enum StoreKind {
  KEY_VALUE;
  DOCUMENT;
  RELATIONAL;
  GRAPH;
  SEARCH;
  TIME_SERIES;
  CACHE;
  OBJECT;
}

/** Defines the supported Consistency Need values. */
enum ConsistencyNeed {
  EVENTUAL;
  STRONG;
  TRANSACTIONAL;
  READ_YOUR_WRITES;
}

/** Defines the supported Workflow Kind values. */
enum WorkflowKind {
  ORCHESTRATION;
  LONG_RUNNING_PROCESS;
  SAGA;
  HUMAN_APPROVAL;
  BATCH_COORDINATION;
  EVENT_ROUTING_PROCESS;
}

/** Defines the supported Workflow State Kind values. */
enum WorkflowStateKind {
  TASK;
  CHOICE;
  PARALLEL;
  MAP;
  WAIT;
  PASS;
  SUCCESS;
  FAILURE;
}

/** Defines the supported Identity Kind values. */
enum IdentityKind {
  USER_DIRECTORY;
  FEDERATED_IDENTITY;
  MACHINE_CLIENT;
  API_KEY_CLIENT;
  SERVICE_PRINCIPAL;
  EXTERNAL_IDENTITY_PROVIDER;
}

/** Defines the supported Principal Kind values. */
enum PrincipalKind {
  HUMAN_USER;
  GROUP;
  ROLE;
  SERVICE;
  EXTERNAL_SYSTEM;
  ANONYMOUS;
}

/** Defines the supported Permission Effect values. */
enum PermissionEffect {
  ALLOW;
  DENY;
}

/** Defines the supported Permission Action Kind values. */
enum PermissionActionKind {
  INVOKE;
  READ;
  WRITE;
  DELETE;
  LIST;
  PUBLISH;
  SUBSCRIBE;
  CONSUME;
  ENCRYPT;
  DECRYPT;
  READ_SECRET;
  MANAGE;
}

/** Defines the supported Least Privilege Status values. */
enum LeastPrivilegeStatus {
  UNREVIEWED;
  GENERATED_BROAD;
  REVIEW_REQUIRED;
  CONFIRMED_LEAST_PRIVILEGE;
}

/** Defines the supported Secret Kind values. */
enum SecretKind {
  API_KEY;
  PASSWORD;
  TOKEN;
  CERTIFICATE;
  CONNECTION_STRING;
  PRIVATE_KEY;
  OTHER;
}

/** Defines the supported Config Scope values. */
enum ConfigScope {
  APPLICATION;
  SERVICE;
  FUNCTION;
  ENVIRONMENT;
  DEPLOYMENT_UNIT;
}

/** Defines the supported Schema Kind values. */
enum SchemaKind {
  REQUEST;
  RESPONSE;
  ERROR;
  EVENT;
  MESSAGE;
  ENTITY;
  VALUE_OBJECT;
  READ_MODEL;
  CONFIGURATION;
}

/** Defines the supported Schema Compatibility values. */
enum SchemaCompatibility {
  NONE;
  BACKWARD;
  FORWARD;
  FULL;
}

/** Defines the supported Field Type values. */
enum FieldType {
  STRING;
  INTEGER;
  NUMBER;
  BOOLEAN;
  DATE;
  TIME;
  DATETIME;
  OBJECT;
  ARRAY;
  ENUM;
  BINARY;
  MONEY;
  UUID;
  EMAIL;
  URI;
  MAP;
  UNION;
}

/** Defines the supported Environment Class values. */
enum EnvironmentClass {
  LOCAL;
  DEV;
  TEST;
  STAGING;
  PROD;
  SANDBOX;
}

/** Defines the supported Runtime Language values. */
enum RuntimeLanguage {
  TYPESCRIPT;
  JAVASCRIPT;
  PYTHON;
  JAVA;
  CSHARP;
  GO;
  RUST;
  CUSTOM;
}

/** Defines the supported Package Manager values. */
enum PackageManager {
  NPM;
  PNPM;
  YARN;
  PIP;
  POETRY;
  MAVEN;
  GRADLE;
  DOTNET;
  GO_MOD;
  CARGO;
  NONE;
}

/** Defines the supported Decision values. */
enum Decision {
  UNDECIDED;
  REQUIRED;
  NOT_REQUIRED;
}

/** Defines the supported Data Access Mode values. */
enum DataAccessMode {
  READ;
  WRITE;
  READ_WRITE;
  APPEND;
  DELETE;
}

/** Defines the supported Access Pattern Kind values. */
enum AccessPatternKind {
  GET_BY_ID;
  QUERY_BY_KEY;
  SCAN_FILTERED;
  SEARCH_TEXT;
  AGGREGATE_REPORT;
  WRITE_COMMAND;
  APPEND_EVENT;
}

/** Defines the supported Support Level values. */
enum SupportLevel {
  SUPPORTED_FIRST_CLASS;
  SUPPORTED_WITH_ASSUMPTIONS;
  REQUIRES_MANUAL_DECISION;
  METADATA_ONLY;
  UNSUPPORTED;
}

/** Defines the supported Validation Profile values. */
enum ValidationProfile {
  DRAFT_EDITING;
  TRANSFORMATION_INPUT;
  TRANSFORMATION_OUTPUT_REVIEW;
  DEPLOYMENT_READY;
  PRODUCTION_READY;
}
