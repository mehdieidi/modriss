@namespace(uri="https://varka.org/pim/api/1.0", prefix="api")
package api;

import "../shared/kernel.ecore";
import "pim-types.ecore";
import "pim-contracts.ecore";
import "pim-compute.ecore";
import "pim-workflow.ecore";
import "pim-policy.ecore";
import "pim-security.ecore";
import "pim-deployment.ecore";

class Api extends kernel.TraceableElement, kernel.DeployableElement, kernel.FlowEndpoint, kernel.PolicyTarget, kernel.ProtectedResource, kernel.ConfigurableElement {
  attr String publicName;
  attr String version;
  attr Boolean authRequired;
  attr Boolean corsRequired;
  attr Boolean externalConsumerFacing;
  attr Boolean generatedOpenApiRequired;
  attr String basePath;
  attr pimtypes.ApiStyle[1] apiStyle;

  val ApiRoute[*]#api routes;
  val contracts.ApiContract[?] contract;

  readonly transient ref deployment.ServerlessService[1]#apis service;

  ref security.AuthPolicy[?] auth;
  ref policy.CorsPolicy[?] cors;
  ref policy.RateLimitPolicy[?] rateLimit;
  ref policy.ObservabilityConfig[?] observability;
}

class ApiRoute extends kernel.TraceableElement, kernel.InvocationSource, kernel.FlowEndpoint, kernel.RouteEndpoint, kernel.PolicyTarget, kernel.ProtectedResource, kernel.ConfigurableElement {
  attr String[1] pathTemplate;
  attr String operationId;
  attr Boolean publicRoute;
  attr Boolean authRequired;
  attr String descriptionForConsumers;
  attr Integer expectedSuccessStatus;
  attr String paginationStyle;
  attr Boolean requestValidationRequired;
  attr Boolean responseValidationRequired;
  attr pimtypes.HttpMethod[1] method;

  val ErrorMapping[*]#apiRoute errorMappings;

  readonly transient ref Api[1]#routes api;

  ref contracts.Schema[?] requestSchema;
  ref contracts.Schema[?] responseSchema;
  ref compute.Function[?] functionIntegration;
  ref workflow.Workflow[?] workflowIntegration;
  ref security.AuthorizationPolicy[?] authorization;
  ref policy.TimeoutPolicy[?] timeout;
}

class ErrorMapping extends kernel.TraceableElement {
  attr String domainErrorCode;
  attr String abstractStatusClass;
  attr String responseMessage;

  readonly transient ref ApiRoute[1]#errorMappings apiRoute;

  ref contracts.Schema[?] errorSchema;
}
