@startuml
title MODRISS Full Lifecycle — SPEM 2.0 Logical Activity View

skinparam backgroundColor white
skinparam shadowing false
skinparam activity {
  BackgroundColor #F7F9FC
  BorderColor #334155
  FontColor #172033
  DiamondBackgroundColor #FFF7D6
  DiamondBorderColor #9A6700
}
skinparam note {
  BackgroundColor #FFFDF2
  BorderColor #A16207
}

start

partition "Phase 0 — Initiate, Tailor & Organize\n«Activity, Phase»" {
  :Define opportunity, outcomes and feasibility\n«TaskUse»;
  :Assess serverless suitability, cost, risk\nand provider options «TaskUse»;
  :Tailor method; establish team, quality,\nsecurity, operations and release baseline «TaskUse»;
  if (Product and method authorized?) then (G0/G1 yes)
  else (redirect / stop)
    :Record stop, redirect or bounded experiment\n«WorkProductUse»;
    stop
  endif
}

repeat
  :Open the next release cycle and set\nits outcome hypothesis and scope;

  repeat
    repeat
      partition "Phase 1 — Iterative Model-Driven Delivery\n«Activity, Iteration»" {
        :Frame one thin vertical increment\n«TaskUse»;
        :CIM child process and G2 acceptance\n«ProcessComponentUse»;
        :CIM → PIM ETL, reconcile, refine PIM\nand obtain G3 «TaskUse»;
        :PIM → AWS PSM ETL, reconcile, refine PSM\nand obtain G4 «TaskUse»;
        :EGL/EGX generation, completion, integration,\ntesting and G5 acceptance «TaskUse»;
      }
    repeat while (Another increment needed for this candidate?) is (yes)
    -> no;

    partition "Phase 2a — Assemble & Qualify\n«Activity, Release Candidate»" {
      :Assemble immutable candidate, compatibility,\nverification and recovery evidence «TaskUse»;
      :Review exact candidate at G6\n«Milestone»;
    }
  repeat while (G6 release candidate rejected?) is (yes — route findings to Phase 1)
  -> no — authorized;

  partition "Phase 2b — Promote & Transition\n«Activity, Phase»" {
    :Promote progressively and observe\npredefined stop thresholds «TaskUse»;
    if (Promotion and operational acceptance succeed?) then (G7 yes)
      :Hand over the new operating baseline\n«Milestone G7»;
    else (no)
      :Stop or roll back; retain the last accepted\nbaseline and create corrective work «TaskUse»;
    endif
  }

  partition "Phase 3 — Operate, Evolve & Learn\n«Activity, Continuous Phase»" {
    :Operate the accepted baseline; observe outcomes,\nSLOs, security, cost and provider health «TaskUse»;
    :Respond to incidents, problems and risks\n«TaskUse»;
    if (Change or new value required?) then (yes)
      :Classify impact and route it to CIM, PIM, PSM,\ngenerator, code, release control or method profile «TaskUse»;
      :Prioritize a bounded increment or release hypothesis;
    else (no)
      :Continue service review and evidence collection;
    endif
    note right
      The accepted release remains in operation while
      a later release is engineered. Phase 3 is not a
      one-time terminal step after deployment.
    end note
  }

repeat while (Retirement authorized?) is (no — begin another release cycle)
-> yes;

partition "Phase 4 — Retire, Migrate & Close\n«Activity, Phase»" {
  :Plan migration, retention and decommission\n«TaskUse»;
  :Migrate consumers and data; remove resources,\naccess, integrations and continuing cost «TaskUse»;
  :Verify closure and retain organizational learning\n«Milestone G8»;
}

stop

legend bottom
  Nested cadence: one product/service lifecycle contains many release cycles;
  one release cycle contains one or more accepted vertical increments.

  Continuous across all phases: product/project management; risk and opportunity;
  quality assurance; security/privacy; configuration/change/traceability;
  FinOps; documentation/knowledge; measurement and method improvement.

  Assistant boundary: assistant apply/repair/commit paths use structural
  Ecore/EMF conformance only. EVL belongs to explicit model-validation workflows.
endlegend
@enduml
