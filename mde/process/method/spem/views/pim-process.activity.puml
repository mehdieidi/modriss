@startuml pim-process
title PIM Modeling Process, SPEM-mapped Iteration (6 Phases per Service Slice)
start
repeat
  partition "Stage 1, Architecture & Slice Framing (engine)" {
    :Stage, Service Slice Planning;
    :Stage, Architecture Posture;
    :Stage, Service Boundaries;
  }
  partition "Stage 2, Contracts & Data (engine)" {
    :Stage, Contracts & Schemas;
    :Stage, Data Architecture;
  }
  partition "Stage 3, Compute & Exposure (engine)" {
    :Stage, Compute Units;
    :Stage, API Surface;
  }
  partition "Stage 4, Integration & Orchestration (engine)" {
    :Stage, Integration Topology;
    :Stage, Workflow Orchestration;
  }
  partition "Stage 5, Assurance & Configuration (engine)" {
    :Stage, Security & Identity;
    :Stage, Architecture Policies;
    :Stage, External & Config;
  }
  partition "Stage 6, Platform Readiness (engine)" {
    :Stage, Platform Mapping Assessment;
    :Stage, Trace & Readiness Gate;
    :Stage, Increment Review & Adapt;
  }
  if (PIM EVL pass?) then (yes)
    :PIM -> PSM ETL gate;
  else (no)
    :Rework PIM model to satisfy EVL;
  endif
repeat while (PIM EVL failed or more service slices remain?) is (yes)
stop
@enduml
