@startuml end-to-end-process
title End-to-End Modeling, SPEM Engine (8 Stages per Increment)
start
partition "e2e.ph1, Increment Lifecycle" {
  :e2e.p0, Increment Planning;
  :e2e.p1, CIM engine\n(modriss.cim.modeling · 5 phases);
  if (cim-semantic-validation?) then (pass)
  else (fail)
    backward :e2e.p1;
  endif
  :e2e.p2, CIM→PIM ETL;
  :e2e.p3, PIM engine\n(modriss.pim.modeling · 6 phases);
  if (pim-semantic-validation?) then (pass)
  else (fail)
    backward :e2e.p3;
  endif
  :e2e.p4, PIM→PSM ETL;
  :e2e.p5, PSM engine\n(modriss.psm.modeling · 6 phases);
  if (psm-semantic-validation?) then (pass)
  else (fail)
    backward :e2e.p5;
  endif
  :e2e.p6, M2T generation;
  :e2e.p7, Artifact review;
}
if (More capability slices?) then (yes)
  backward :e2e.p0;
else (no)
  stop
endif
@enduml
