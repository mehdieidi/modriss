@startuml psm-process
title AWS PSM Modeling Process — SPEM (6 Phases, Stages, Tasks)
start
partition "Phase 1 — Deployment Foundation (once)" {
  :Stage — Account & Stage Strategy;
  :Stage — Stack Scaffolding;
  :Stage — Security Baseline;
}
partition "Phase 2 — Network & Identity (once)" {
  :Stage — Networking;
  :Stage — Identity;
}
partition "Phase 3 — Storage & Messaging (engine)" {
  :Stage — Durable Storage;
  :Stage — Messaging;
}
partition "Phase 4 — Event Fabric & Compute (engine)" {
  :Stage — Event Fabric;
  :Stage — Compute;
}
partition "Phase 5 — API & Orchestration (engine)" {
  :Stage — API Gateway;
  :Stage — Workflow & Observability;
}
partition "Phase 6 — Integration Views & Readiness (gate)" {
  :Stage — Integration Views;
  :Stage — Trace & Readiness Gate;
}
if (PSM EVL pass?) then (yes)
  :M2T artifact generation;
  stop
else (no)
  backward :Trace & Readiness;
endif
@enduml
