@startuml cim-process
title CIM Modeling Process, SPEM-mapped Iteration (5 Phases per Capability Slice)
start
partition "Program Initiation (engine)" {
  :Stage, Program Charter;
  :Stage, Strategic Framing;
}
repeat
  partition "Phase 1, Increment Framing (engine)" {
    :Stage, Capability Slice Planning;
  }
  partition "Phase 2, Context Discovery (engine)" {
    :Stage, Participation Model;
    :Stage, Capability Landscape;
    :Stage, Ubiquitous Language;
  }
  partition "Phase 3, Domain Exploration (engine, iterative)" {
    repeat
      :Revisit Ubiquitous Language;
      :Stage, Information Architecture;
      :Stage, Structural Model;
      :Stage, Behavior Surface;
    repeat while (Naming conflicts, missing taxonomy/structure, or incoherent CQRS?) is (yes)
  }
  partition "Phase 4, Domain Synthesis (engine)" {
    repeat
      :Stage, Aggregate Boundaries;
      :Stage, Process & Decisions;
      :Stage, Bounded Contexts;
      :Review ownership and revise Behavior Surface if needed;
    repeat while (Ownership conflicts?) is (yes)
  }
  partition "Phase 5, Convergence & Readiness (engine)" {
    repeat
      :Stage, Requirements (Twin Peaks);
      :Review requirements trace and refine Structural Model if needed;
      :Stage, Governance;
      :Stage, EVL Readiness Gate;
    repeat while (Untraceable requirements?) is (yes)
    :Stage, Increment Review & Adapt;
  }
  if (CIM EVL pass?) then (yes)
    :CIM -> PIM ETL gate;
  else (no)
    :Rework CIM model to satisfy EVL;
  endif
repeat while (CIM EVL failed or more capability slices remain?) is (yes)
stop
@enduml
