import "root-scaffolding.etl";
import "boundaries-security.etl";
import "domain-data.etl";
import "behavior-contracts.etl";
import "process-policy.etl";
import "integration-deployment.etl";

pre ValidateInput {
  if (CIM!CIMModel.all.size() <> 1) {
    throw "CIM to PIM requires exactly one CIMModel root; found " + CIM!CIMModel.all.size().asString() + ".";
  }
  initialiseCimToPimCaches();
}
