import "common.eol";

operation pimRoot() {
  if (PIM!PIMModel.all.isEmpty()) {
    return null;
  }
  return PIM!PIMModel.all.first();
}

operation readinessRoot() {
  var root = pimRoot();
  if (root.isDefined() and root.readiness.isDefined()) {
    return root.readiness;
  }
  return null;
}

operation traceRoot() {
  var root = pimRoot();
  if (root.isDefined() and root.traceModel.isDefined()) {
    return root.traceModel;
  }
  return null;
}

operation copyCommonTrace(source, target, ruleId : String, confidence : String) {
  target.sourceReference = source.sourceReference;
  target.sourceExcerpt = source.sourceExcerpt;
  target.sourceQualifiedName = source.sourceQualifiedName;
  target.sourceUri = source.sourceUri;
  target.sourceLine = source.sourceLine;
  target.generatedFrom = source.id;
  target.generatedByTransformation = true;
  target.manuallyMaintained = false;
  target.traceId = ruleId + ":" + source.id + "->" + target.id;
  target.rationale = firstText(target.rationale, "") + "Generated by " + ruleId + " from " + source.eClass().name + ".";
  if (confidence = "HIGH") {
    target.reviewStatus = "reviewable";
    target.lifecycleStatus = KERNEL!LifecycleStatus#REVIEW_READY;
  }
  else {
    target.reviewStatus = "review-required";
    target.lifecycleStatus = KERNEL!LifecycleStatus#REVIEW_REQUIRED;
  }
}

operation addTrace(source, target, ruleId : String, linkType, confidence : String) {
  var trace = traceRoot();
  if (trace.isUndefined()) {
    return;
  }
  var link = new KERNEL!TraceLink;
  link.id = newId("trace", ruleId + "_" + source.id + "_" + target.id);
  link.name = ruleId + " " + source.name + " -> " + target.name;
  link.linkType = linkType;
  link.transformationRule = ruleId;
  link.confidence = confidence;
  link.target = target;
  link.sourceElementId = source.id;
  link.targetElementId = target.id;
  link.generatedByTransformation = true;
  trace.links.add(link);
}

operation traceGenerated(source, target, ruleId : String, confidence : String) {
  copyCommonTrace(source, target, ruleId, confidence);
  addTrace(source, target, ruleId, KERNEL!TraceLinkType#TRANSFORMS_TO, confidence);
}

operation manualDecision(ruleId : String, question : String, severity, blocking : Boolean, affected) {
  var readiness = readinessRoot();
  if (readiness.isUndefined()) {
    return null;
  }
  var d = new KERNEL!ManualDecision;
  d.id = newId("decision", ruleId + "_" + question);
  var shortQuestion = question;
  if (shortQuestion.length() > 80) {
    shortQuestion = shortQuestion.substring(0, 80);
  }
  d.name = "Manual decision - " + shortQuestion;
  d.question = question;
  d.blocking = blocking;
  d.severity = severity;
  if (blocking) {
    d.lifecycleStatus = KERNEL!LifecycleStatus#REVIEW_REQUIRED;
  }
  else {
    d.lifecycleStatus = KERNEL!LifecycleStatus#REVIEW_READY;
  }
  d.generatedByTransformation = true;
  d.manuallyMaintained = false;
  d.reviewStatus = "review-required";
  if (affected.isDefined()) {
    d.affectedElements.addAll(affected);
  }
  readiness.manualDecisions.add(d);
  return d;
}

operation readinessFinding(ruleId : String, findingType, severity, message : String, recommendation : String, blocking : Boolean, affected) {
  var readiness = readinessRoot();
  if (readiness.isUndefined()) {
    return null;
  }
  var f = new KERNEL!ReadinessFinding;
  f.id = newId("finding", ruleId + "_" + message);
  f.name = "Finding - " + ruleId;
  f.findingType = findingType;
  f.severity = severity;
  f.ruleId = ruleId;
  f.message = message;
  f.recommendation = recommendation;
  f.blocking = blocking;
  f.generatedByTransformation = true;
  f.manuallyMaintained = false;
  if (affected.isDefined()) {
    f.affectedElements.addAll(affected);
  }
  readiness.findings.add(f);
  return f;
}

operation readinessCheck(checkId : String, severity, passed : Boolean, message : String, remediation : String, affected) {
  var readiness = readinessRoot();
  if (readiness.isUndefined()) {
    return null;
  }
  var c = new KERNEL!ReadinessCheck;
  c.id = newId("check", checkId);
  c.name = checkId;
  c.checkId = checkId;
  c.severity = severity;
  c.passed = passed;
  c.message = message;
  c.remediation = remediation;
  c.generatedByTransformation = true;
  if (affected.isDefined()) {
    c.affectedElements.addAll(affected);
  }
  readiness.checks.add(c);
  return c;
}
