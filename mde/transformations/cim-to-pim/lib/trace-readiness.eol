/** Provides reusable trace readiness operations. */
import "common.eol";

/** Returns pim root. */
operation pimRoot() {
  if (cachedPimRoot.isUndefined()) {
    if (PIM!PIMModel.all.isEmpty()) {
      return null;
    }
    cachedPimRoot = PIM!PIMModel.all.first();
  }
  return cachedPimRoot;
}

/** Computes readiness root. */
operation readinessRoot() {
  var root = pimRoot();
  if (root.isDefined() and root.readiness.isDefined()) {
    return root.readiness;
  }
  return null;
}

/** Adds or records trace root. */
operation traceRoot() {
  var root = pimRoot();
  if (root.isDefined() and root.traceModel.isDefined()) {
    return root.traceModel;
  }
  return null;
}

/** Computes mark generated helper with source id. */
operation markGeneratedHelperWithSourceId(target, ruleId : String, sourceId : String) {
  if (target.isUndefined()) {
    return target;
  }
  target.generatedByTransformation = true;
  target.manuallyMaintained = false;
  if (hasText(sourceId) and target.generatedFrom.isUndefined()) {
    target.generatedFrom = sourceId;
  }
  target.rationale = firstText(target.rationale, "") + "Generated by " + ruleId + " as a helper artifact.";
  cachePimTarget(target);
  return target;
}

/** Computes mark generated helper. */
operation markGeneratedHelper(target, ruleId : String, seed) {
  return markGeneratedHelperWithSourceId(target, ruleId, cacheKeyFor(seed));
}

/** Computes copy common trace. */
operation copyCommonTrace(source, target, ruleId : String, confidence : String) {
  target.sourceReference = source.sourceReference;
  target.sourceExcerpt = source.sourceExcerpt;
  target.sourceQualifiedName = source.sourceQualifiedName;
  target.sourceUri = source.sourceUri;
  target.sourceLine = source.sourceLine;
  target.generatedFrom = source.id;
  target.generatedByTransformation = true;
  target.manuallyMaintained = false;
  target.traceId = ruleId + ":" + source.id + "->" + target.id;
  target.rationale = firstText(target.rationale, "") + "Generated by " + ruleId + " from " + source.eClass().name + ".";
  cachePimTarget(target);
  if (confidence = "HIGH") {
    target.reviewStatus = "reviewable";
    target.lifecycleStatus = KERNEL!LifecycleStatus#REVIEW_REQUIRED;
  }
  else {
    target.reviewStatus = "review-required";
    target.lifecycleStatus = KERNEL!LifecycleStatus#REVIEW_REQUIRED;
  }
}

/** Adds or records add trace. */
operation addTrace(source, target, ruleId : String, linkType, confidence : String) {
  var trace = traceRoot();
  if (trace.isUndefined()) {
    return;
  }
  var link = new KERNEL!TraceLink;
  link.id = newId("trace", ruleId + "_" + source.id + "_" + target.id);
  link.name = ruleId + " " + source.name + " -> " + target.name;
  link.linkType = linkType;
  link.transformationRule = ruleId;
  link.confidence = mapTraceConfidence(confidence);
  link.target = target;
  link.sourceElementId = source.id;
  link.targetElementId = target.id;
  link.generatedByTransformation = true;
  link.rationale = "Generated by " + ruleId + " to record transformation traceability.";
  trace.links.add(link);
}

/** Computes map trace confidence. */
operation mapTraceConfidence(confidence : String) {
  if (confidence = "VERIFIED") {
    return KERNEL!TraceConfidence#VERIFIED;
  }
  if (confidence = "MANUAL") {
    return KERNEL!TraceConfidence#MANUAL;
  }
  if (confidence = "HIGH") {
    return KERNEL!TraceConfidence#HIGH;
  }
  if (confidence = "LOW") {
    return KERNEL!TraceConfidence#LOW;
  }
  return KERNEL!TraceConfidence#MEDIUM;
}

/** Adds or records trace generated. */
operation traceGenerated(source, target, ruleId : String, confidence : String) {
  copyCommonTrace(source, target, ruleId, confidence);
  addTrace(source, target, ruleId, KERNEL!TraceLinkType#TRANSFORMS_TO, confidence);
}

/** Returns whether the receiver is target model reference. */
operation isTargetModelReference(element) {
  if (element.isUndefined()) {
    return false;
  }
  if (element.eClass().isUndefined()) {
    return false;
  }
  if (element.eClass().ePackage.isUndefined()) {
    return false;
  }
  if (element.eClass().ePackage.nsURI.isUndefined()) {
    return false;
  }
  var nsUri = element.eClass().ePackage.nsURI.asString();
  if (nsUri = "https://varka.org/kernel/1.0") {
    return true;
  }
  return nsUri.startsWith("https://varka.org/pim/");
}

/** Adds or records append target affected elements. */
operation appendTargetAffectedElements(owner, affected) {
  if (owner.isUndefined() or affected.isUndefined()) {
    return;
  }
  for (element in affected) {
    if (isTargetModelReference(element) and not owner.affectedElements.includes(element)) {
      owner.affectedElements.add(element);
    }
  }
}

/** Computes affected stable key. */
operation affectedStableKey(affected) {
  if (affected.isUndefined()) {
    return "";
  }
  var key = "";
  for (element in affected) {
    if (element.isDefined()) {
      var part = cacheKeyFor(element);
      if (not hasText(part)) {
        part = element.eClass().getName();
      }
      if (hasText(key)) {
        key = key + "_";
      }
      key = key + part;
    }
  }
  return key;
}

/** Computes manual decision. */
operation manualDecision(ruleId : String, question : String, severity, blocking : Boolean, affected) {
  var readiness = readinessRoot();
  if (readiness.isUndefined()) {
    return null;
  }
  var id = newId("decision", ruleId + "_" + affectedStableKey(affected) + "_" + question);
  if (cachedReadinessManualDecisionsById.containsKey(id)) {
    var existing = cachedReadinessManualDecisionsById.get(id);
    appendTargetAffectedElements(existing, affected);
    return existing;
  }
  var d = new KERNEL!ManualDecision;
  d.id = id;
  var shortQuestion = question;
  if (shortQuestion.length() > 80) {
    shortQuestion = shortQuestion.substring(0, 80);
  }
  d.name = "Manual decision - " + shortQuestion;
  d.question = question;
  d.blocking = blocking;
  d.severity = severity;
  if (blocking) {
    d.lifecycleStatus = KERNEL!LifecycleStatus#REVIEW_REQUIRED;
  }
  else {
    d.lifecycleStatus = KERNEL!LifecycleStatus#REVIEW_REQUIRED;
  }
  d.generatedByTransformation = true;
  d.manuallyMaintained = false;
  d.rationale = "Generated by " + ruleId + " to capture manual review required by the transformation.";
  d.reviewStatus = "review-required";
  appendTargetAffectedElements(d, affected);
  readiness.manualDecisions.add(d);
  cachedReadinessManualDecisionsById.put(id, d);
  return d;
}

/** Computes readiness finding. */
operation readinessFinding(ruleId : String, findingType, severity, message : String, recommendation : String, blocking : Boolean, affected) {
  var readiness = readinessRoot();
  if (readiness.isUndefined()) {
    return null;
  }
  var id = newId("finding", ruleId + "_" + affectedStableKey(affected) + "_" + message);
  if (cachedReadinessFindingsById.containsKey(id)) {
    var existing = cachedReadinessFindingsById.get(id);
    appendTargetAffectedElements(existing, affected);
    return existing;
  }
  var f = new KERNEL!ReadinessFinding;
  f.id = id;
  f.name = "Finding - " + ruleId;
  f.findingType = findingType;
  f.severity = severity;
  f.ruleId = ruleId;
  f.message = message;
  f.recommendation = recommendation;
  f.blocking = blocking;
  f.generatedByTransformation = true;
  f.manuallyMaintained = false;
  f.rationale = "Generated by " + ruleId + " to capture transformation readiness evidence.";
  appendTargetAffectedElements(f, affected);
  readiness.findings.add(f);
  cachedReadinessFindingsById.put(id, f);
  return f;
}

/** Computes readiness check. */
operation readinessCheck(checkId : String, severity, passed : Boolean, message : String, remediation : String, affected) {
  var readiness = readinessRoot();
  if (readiness.isUndefined()) {
    return null;
  }
  var id = newId("check", checkId + "_" + affectedStableKey(affected));
  if (cachedReadinessChecksById.containsKey(id)) {
    var existing = cachedReadinessChecksById.get(id);
    appendTargetAffectedElements(existing, affected);
    return existing;
  }
  var c = new KERNEL!ReadinessCheck;
  c.id = id;
  c.name = checkId;
  c.checkId = checkId;
  c.severity = severity;
  c.passed = passed;
  c.message = message;
  c.remediation = remediation;
  c.generatedByTransformation = true;
  c.rationale = "Generated by readiness check " + checkId + ".";
  appendTargetAffectedElements(c, affected);
  readiness.checks.add(c);
  cachedReadinessChecksById.put(id, c);
  return c;
}
