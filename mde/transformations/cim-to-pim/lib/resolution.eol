import "common.eol";
import "trace-readiness.eol";
import "pim-builders.eol";

operation serviceFor(source) {
  if (DEPLOY!ServerlessService.all.isEmpty() and PIM!PIMModel.all.notEmpty()) {
    var c = CIM!CIMModel.all.first();
    var s = new DEPLOY!ServerlessService;
    s.id = "svc_default_review_required";
    s.name = c.domainName + " Service";
    s.boundaryType = PIMTYPES!BoundaryType#CAPABILITY_BASED;
    s.responsibility = "Placeholder service boundary because CIM has no bounded context or capability.";
    s.externallyExposed = true;
    s.ownsData = c.entities.notEmpty();
    s.lifecycleStatus = KERNEL!LifecycleStatus#INCOMPLETE;
    pimRoot().services.add(s);
    addTrace(c, s, "TR-010", KERNEL!TraceLinkType#DERIVES_FROM, "LOW");
    manualDecision("TR-010", "Define service boundaries using bounded contexts or business capabilities.", KERNEL!Severity#BLOCKER, true, Sequence{c, s});
  }
  if (DEPLOY!ServerlessService.all.notEmpty()) {
    if (source.isKindOf(CIMORG!BoundedContextCandidate)) {
      var svc = source.equivalents("BoundedContext2Service").first();
      if (svc.isDefined()) return svc;
    }
    if (source.isKindOf(CIMORG!BusinessCapability)) {
      var capSvc = source.equivalents("Capability2Service").first();
      if (capSvc.isDefined()) return capSvc;
      var context = CIMORG!BoundedContextCandidate.all.select(bc | bc.capabilities.includes(source)).first();
      if (context.isDefined()) return serviceFor(context);
    }
    if (source.isKindOf(CIMBEHAVIOR!Command) and source.targetCapability.isDefined()) {
      return serviceFor(source.targetCapability);
    }
    if (source.isKindOf(CIMBEHAVIOR!Query) and source.targetCapability.isDefined()) {
      return serviceFor(source.targetCapability);
    }
    if (source.isKindOf(CIMBEHAVIOR!BusinessEvent) and source.expectedByCommands.notEmpty()) {
      return serviceFor(source.expectedByCommands.first());
    }
    if (source.isKindOf(CIMBEHAVIOR!BusinessEvent) and source.affects.notEmpty() and source.affects.first().owningCapability.isDefined()) {
      return serviceFor(source.affects.first().owningCapability);
    }
    if (source.isKindOf(CIMPROCESS!Policy) and source.guards.notEmpty() and source.guards.first().targetCapability.isDefined()) {
      return serviceFor(source.guards.first().targetCapability);
    }
    if (source.isKindOf(CIMDOMAIN!DomainEntity) and source.owningCapability.isDefined()) {
      return serviceFor(source.owningCapability);
    }
    if (source.isKindOf(CIMDOMAIN!AggregateCandidate) and source.root.owningCapability.isDefined()) {
      return serviceFor(source.root.owningCapability);
    }
    if (source.isKindOf(CIMPROCESS!BusinessProcess) and source.owningCapability.isDefined()) {
      return serviceFor(source.owningCapability);
    }
    for (bc in CIMORG!BoundedContextCandidate.all) {
      if (bc.commands.includes(source) or bc.queries.includes(source) or bc.events.includes(source) or bc.entities.includes(source) or bc.policies.includes(source)) {
        return serviceFor(bc);
      }
    }
    return DEPLOY!ServerlessService.all.first();
  }
  return null;
}

operation commandFunction(cmd : CIMBEHAVIOR!Command) {
  return cmd.equivalents("Command2Function").first();
}

operation queryFunction(q : CIMBEHAVIOR!Query) {
  return q.equivalents("Query2Function").first();
}

operation policyFunction(p : CIMPROCESS!Policy) {
  return p.equivalents("Policy2PolicyHandlerFunction").first();
}

operation eventTypeFor(e : CIMBEHAVIOR!BusinessEvent) {
  return e.equivalents("BusinessEvent2EventType").select(x | x.isKindOf(CONTRACTS!EventType)).first();
}

operation schemaForEntity(e : CIMDOMAIN!DomainEntity) {
  return e.equivalents("Entity2Schema").first();
}

operation schemaForDomainConcept(concept : CIMDOMAIN!DomainConcept) {
  if (concept.isKindOf(CIMDOMAIN!DomainEntity)) {
    return concept.equivalents("Entity2Schema").first();
  }
  if (concept.isKindOf(CIMDOMAIN!ValueObject)) {
    return concept.equivalents("ValueObject2Schema").first();
  }
  return null;
}

operation storeForAggregate(ag : CIMDOMAIN!AggregateCandidate) {
  return ag.equivalents("Aggregate2DataStore").select(x | x.isKindOf(DATA!DataStore)).first();
}

operation storeForEntity(entity : CIMDOMAIN!DomainEntity) {
  for (ag in CIMDOMAIN!AggregateCandidate.all) {
    if (ag.root = entity or ag.members.includes(entity)) {
      return storeForAggregate(ag);
    }
  }
  return null;
}

operation adapterFor(es : CIMORG!ExternalSystem) {
  return es.equivalents("ExternalSystem2Adapter").first();
}

operation workflowFor(bp : CIMPROCESS!BusinessProcess) {
  return bp.equivalents("BusinessProcess2Workflow").first();
}

operation policyTargetsFor(source) {
  var targets = Sequence{};
  if (source.isUndefined()) {
    return targets;
  }
  if (source.isKindOf(CIMBEHAVIOR!Command)) {
    if (commandFunction(source).isDefined()) targets.add(commandFunction(source));
    var route = source.equivalents("UserInitiatedCommand2ApiRoute").first();
    if (route.isDefined()) targets.add(route);
  }
  else if (source.isKindOf(CIMBEHAVIOR!Query)) {
    if (queryFunction(source).isDefined()) targets.add(queryFunction(source));
    var qRoute = source.equivalents("Query2ApiRoute").first();
    if (qRoute.isDefined()) targets.add(qRoute);
  }
  else if (source.isKindOf(CIMPROCESS!Policy)) {
    if (policyFunction(source).isDefined()) targets.add(policyFunction(source));
  }
  else if (source.isKindOf(CIMPROCESS!BusinessProcess)) {
    if (workflowFor(source).isDefined()) targets.add(workflowFor(source));
  }
  else if (source.isKindOf(CIMPROCESS!ProcessStep)) {
    var state = source.equivalents("ProcessStep2WorkflowState").first();
    if (state.isDefined()) targets.add(state);
  }
  else if (source.isKindOf(CIMDOMAIN!AggregateCandidate)) {
    if (storeForAggregate(source).isDefined()) targets.add(storeForAggregate(source));
  }
  else if (source.isKindOf(CIMDOMAIN!DomainEntity)) {
    if (storeForEntity(source).isDefined()) targets.add(storeForEntity(source));
    if (schemaForEntity(source).isDefined()) targets.add(schemaForEntity(source));
  }
  else if (source.isKindOf(CIMORG!ExternalSystem)) {
    if (adapterFor(source).isDefined()) targets.add(adapterFor(source));
  }
  else if (source.isKindOf(CIMORG!BusinessCapability) or source.isKindOf(CIMORG!BoundedContextCandidate)) {
    if (serviceFor(source).isDefined()) targets.add(serviceFor(source));
  }
  else if (source.isKindOf(CIMBEHAVIOR!BusinessEvent)) {
    if (eventTypeFor(source).isDefined()) targets.add(eventTypeFor(source));
  }
  return targets;
}

operation policyTargetsForAll(sources) {
  var targets = Sequence{};
  for (source in sources) {
    for (target in policyTargetsFor(source)) {
      if (not targets.includes(target)) targets.add(target);
    }
  }
  return targets;
}

operation ensureApiForService(service : DEPLOY!ServerlessService) {
  if (service.ownsApis.notEmpty()) {
    return service.ownsApis.first();
  }
  var api = new API!Api;
  api.id = "api_" + service.id;
  api.name = service.name + " API";
  api.apiStyle = PIMTYPES!ApiStyle#RESOURCE_ORIENTED_HTTP;
  api.publicName = service.name;
  api.version = "1.0.0";
  api.basePath = "/" + kebab(removeSuffix(service.name, " Service"));
  api.authRequired = false;
  api.corsRequired = false;
  api.externalConsumerFacing = service.externallyExposed;
  api.generatedOpenApiRequired = true;
  api.observability = createDefaultObservability(api, "TR-070", true, false);
  api.generatedByTransformation = true;
  api.manuallyMaintained = false;
  service.ownsApis.add(api);
  pimRoot().apis.add(api);
  addTrace(service, api, "TR-070", KERNEL!TraceLinkType#DERIVES_FROM, "MEDIUM");
  return api;
}

operation ensureEventBusForService(service : DEPLOY!ServerlessService) {
  var existing = service.ownsChannels.select(c | c.isKindOf(INTEGRATION!EventBus)).first();
  if (existing.isDefined()) {
    return existing;
  }
  var ch = new INTEGRATION!EventBus;
  ch.id = "eventbus_" + service.id;
  ch.name = service.name + " Event Bus";
  ch.channelKind = PIMTYPES!ChannelKind#EVENT_BUS;
  ch.orderingRequirement = PIMTYPES!OrderingRequirement#NONE;
  ch.deliverySemantics = PIMTYPES!DeliverySemantics#AT_LEAST_ONCE;
  ch.encrypted = false;
  ch.replayRequired = false;
  ch.deadLetterRequired = true;
  ch.routingExpressionLanguage = "eventType";
  ch.integrationPurpose = "Service event publication and routing.";
  ch.observability = createDefaultObservability(ch, "TR-090", true, true);
  ch.resilience = createDefaultResilience(ch, "TR-090", true);
  ch.generatedByTransformation = true;
  ch.manuallyMaintained = false;
  service.ownsChannels.add(ch);
  pimRoot().channels.add(ch);
  addTrace(service, ch, "TR-090", KERNEL!TraceLinkType#DERIVES_FROM, "MEDIUM");
  return ch;
}
