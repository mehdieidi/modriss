operation initialiseCimToPimCaches() {
  cachedCimRoot = CIM!CIMModel.all.first();
  cachedPimRoot = null;
  cachedCimAggregateByEntityId = new Map;
  cachedCimContextByCapabilityId = new Map;
  cachedCimOwnerContextByElementId = new Map;
  cachedCimServiceBySourceId = new Map;
  cachedCimEquivalentByRule = new Map;
  cachedCimPolicyTargetsBySourceId = new Map;
  cachedPimObservabilityById = new Map;
  cachedPimResilienceById = new Map;
  cachedPimIdempotencyById = new Map;
  cachedPimSchemaById = new Map;
  cachedPimDataAccessIds = Set{};
  cachedPimExternalFlowIds = Set{};
  cachedPimQueueById = new Map;
  cachedReadinessManualDecisionsById = new Map;
  cachedReadinessFindingsById = new Map;
  cachedReadinessChecksById = new Map;

  for (ag in cachedCimRoot.aggregates) {
    cacheAggregateEntity(ag.root, ag);
    for (member in ag.members) {
      cacheAggregateEntity(member, ag);
    }
  }
  for (context in cachedCimRoot.boundedContexts) {
    for (capability in context.capabilities) {
      cacheContextByCapability(capability, context);
    }
    cacheContextElements(context.commands, context);
    cacheContextElements(context.queries, context);
    cacheContextElements(context.events, context);
    cacheContextElements(context.entities, context);
    cacheContextElements(context.policies, context);
  }
}

operation cimRoot() {
  return cachedCimRoot;
}

operation cacheKeyFor(element) {
  if (element.isUndefined()) {
    return "";
  }
  if (hasText(element.id)) {
    return element.id;
  }
  if (hasText(element.name)) {
    return element.eClass().getName() + "_" + slug(element.name);
  }
  return element.eClass().getName() + "_" + slug(element.asString());
}

operation cacheAggregateEntity(entity, aggregate) {
  var key = cacheKeyFor(entity);
  if (hasText(key)) {
    cachedCimAggregateByEntityId.put(key, aggregate);
  }
}

operation cacheContextByCapability(capability, context) {
  var key = cacheKeyFor(capability);
  if (hasText(key)) {
    cachedCimContextByCapabilityId.put(key, context);
  }
}

operation cacheContextElements(elements, context) {
  for (element in elements) {
    var key = cacheKeyFor(element);
    if (hasText(key)) {
      cachedCimOwnerContextByElementId.put(key, context);
    }
  }
}

operation cachedAggregateForEntity(entity) {
  return cachedCimAggregateByEntityId.get(cacheKeyFor(entity));
}

operation cachedContextForCapability(capability) {
  return cachedCimContextByCapabilityId.get(cacheKeyFor(capability));
}

operation cachedOwnerContextFor(element) {
  return cachedCimOwnerContextByElementId.get(cacheKeyFor(element));
}

operation cachedEquivalent(source, ruleName : String) {
  var key = ruleName + "::" + cacheKeyFor(source);
  if (cachedCimEquivalentByRule.containsKey(key)) {
    return cachedCimEquivalentByRule.get(key);
  }
  var target = source.equivalents(ruleName).first();
  if (target.isDefined()) {
    cachedCimEquivalentByRule.put(key, target);
  }
  return target;
}

operation cachedEquivalentOfClass(source, ruleName : String, className : String) {
  var key = ruleName + "::" + cacheKeyFor(source) + "::" + className;
  if (cachedCimEquivalentByRule.containsKey(key)) {
    return cachedCimEquivalentByRule.get(key);
  }
  var target = source.equivalents(ruleName).selectOne(x | x.eClass().getName() = className);
  if (target.isDefined()) {
    cachedCimEquivalentByRule.put(key, target);
  }
  return target;
}

operation asText(value) {
  if (value.isUndefined()) {
    return "";
  }
  return value.asString();
}

operation Any orDefault(defaultValue : String) {
  if (self.isUndefined() or self.trim().isEmpty()) {
    return defaultValue;
  }
  return self;
}

operation hasText(value) {
  return value.isDefined() and not value.asString().trim().isEmpty();
}

operation firstText(primary, fallback) {
  if (hasText(primary)) {
    return primary.asString();
  }
  if (hasText(fallback)) {
    return fallback.asString();
  }
  return "";
}

operation slug(value) {
  var s = asText(value).toLowerCase().trim().replaceAll("[^a-z0-9]+", "_").replaceAll("^_+|_+$", "");
  if (s.isEmpty()) {
    return "unnamed";
  }
  return s;
}

operation kebab(value) {
  return slug(value).replace("_", "-");
}

operation camelCase(value) {
  var parts = slug(value).split("_");
  if (parts.isEmpty()) {
    return "unnamed";
  }
  var result = parts.first();
  for (part in parts.excluding(parts.first())) {
    if (part.length() > 0) {
      result = result + part.substring(0, 1).toUpperCase() + part.substring(1);
    }
  }
  return result;
}

operation pascalCase(value) {
  var cc = camelCase(value);
  return cc.substring(0, 1).toUpperCase() + cc.substring(1);
}

operation removeSuffix(value : String, suffix : String) {
  if (value.isDefined() and value.endsWith(suffix)) {
    return value.substring(0, value.length() - suffix.length());
  }
  return value;
}

operation pluralize(value) {
  var text = asText(value);
  if (text.isEmpty()) {
    return "resources";
  }
  if (text.toLowerCase().endsWith("s")) {
    return text;
  }
  if (text.toLowerCase().endsWith("y") and text.length() > 1) {
    return text.substring(0, text.length() - 1) + "ies";
  }
  return text + "s";
}

operation idFor(prefix : String, source) {
  var seed = source.id;
  if (not hasText(seed)) {
    seed = source.name;
  }
  return prefix + "_" + slug(seed);
}

operation nameFor(source, suffix : String) {
  var baseName = source.name;
  if (not hasText(baseName)) {
    baseName = source.id;
  }
  return baseName.orDefault("Unnamed") + suffix;
}

operation newId(prefix : String, seed) {
  return prefix + "_" + slug(seed);
}

operation collectionText(items) {
  return joinText(items.collect(i | i.name), ", ");
}

operation joinText(items, separator : String) {
  var result = "";
  for (item in items) {
    if (hasText(item)) {
      if (hasText(result)) {
        result = result + separator;
      }
      result = result + item.asString();
    }
  }
  return result;
}

operation hasAny(items) {
  return items.isDefined() and not items.isEmpty();
}

operation isTrue(value) {
  return value.isDefined() and value;
}

operation isPublicActor(actor) {
  return actor.isDefined() and actor.actorType.isDefined() and
    actor.actorType.asString() <> "TIME";
}

operation setFeature(element, featureName : String, value) {
  var feature = element.eClass().getEStructuralFeature(featureName);
  if (feature.isUndefined()) {
    throw "Feature " + featureName + " does not exist on " + element.eClass().getName() + ".";
  }
  element.eSet(feature, value);
}

operation featureValue(element, featureName : String) {
  if (element.isUndefined()) {
    return null;
  }
  var feature = element.eClass().getEStructuralFeature(featureName);
  if (feature.isUndefined()) {
    return null;
  }
  return element.eGet(feature);
}

operation expressionText(element) : String {
  if (element.isUndefined()) {
    return "";
  }
  if (element.eClass().getName() = "Expression") {
    return element.body;
  }
  var expressionModel = featureValue(element, "expressionModel");
  if (expressionModel.isDefined()) {
    return expressionText(expressionModel);
  }
  var expressionValue = featureValue(element, "expression");
  if (hasText(expressionValue)) {
    return expressionValue.asString();
  }
  var naturalLanguageValue = featureValue(element, "naturalLanguage");
  if (hasText(naturalLanguageValue)) {
    return naturalLanguageValue.asString();
  }
  var naturalLanguageStatement = featureValue(element, "naturalLanguageStatement");
  if (hasText(naturalLanguageStatement)) {
    return naturalLanguageStatement.asString();
  }
  return "";
}

operation expressionLanguageText(element) : String {
  if (element.isUndefined()) {
    return "NATURAL_LANGUAGE";
  }
  if (element.eClass().getName() = "Expression" and element.language.isDefined()) {
    return element.language.asString();
  }
  var expressionModel = featureValue(element, "expressionModel");
  if (expressionModel.isDefined() and expressionModel.language.isDefined()) {
    return expressionModel.language.asString();
  }
  var languageValue = featureValue(element, "expressionLanguage");
  if (languageValue.isDefined()) {
    return languageValue.asString();
  }
  return "NATURAL_LANGUAGE";
}

operation KERNEL!Multiplicity hasMultiplicityBounds() : Boolean {
  return self.isDefined() and self.lowerBound.isDefined() and
    (self.upperBound.isDefined() or self.unbounded = true);
}

operation KERNEL!Multiplicity isMany() : Boolean {
  return self.isDefined() and
    (self.unbounded = true or (self.upperBound.isDefined() and self.upperBound > 1));
}
