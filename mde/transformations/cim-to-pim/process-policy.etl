import "lib/common.eol";
import "lib/mapping.eol";
import "lib/trace-readiness.eol";
import "lib/pim-builders.eol";
import "lib/resolution.eol";

operation shouldGenerateWorkflow(bp : CIMPROCESS!BusinessProcess) {
  return bp.longRunning or bp.humanApprovalPossible or bp.compensationExpected or
    bp.processKind.asString() = "LONG_RUNNING" or bp.processKind.asString() = "HUMAN_INVOLVED" or
    bp.processKind.asString() = "CASE_MANAGEMENT" or bp.processKind.asString() = "SAGA_LIKE_BUSINESS_PROCESS" or
    bp.steps.size() > 2 or
    (cimRoot().transformationProfile.isDefined() and cimRoot().transformationProfile.preferProcessAsWorkflowCandidate);
}

operation workflowStateFor(step : CIMPROCESS!ProcessStep) {
  return cachedEquivalent(step, "ProcessStep2WorkflowState");
}

operation firstIntegerText(value) {
  var text = asText(value);
  var digits = "";
  var collecting = false;
  for (i in Sequence{1..text.length()}) {
    var ch = text.substring(i - 1, i);
    if ("0123456789".contains(ch)) {
      digits = digits + ch;
      collecting = true;
    }
    else {
      if (collecting) {
        return digits;
      }
    }
  }
  return digits;
}

operation secondsFromDurationExpression(value) {
  if (not hasText(value)) {
    return 0;
  }
  var digits = firstIntegerText(value);
  if (not hasText(digits)) {
    return 0;
  }
  var amount = digits.asInteger();
  var text = value.toLowerCase();
  if (text.contains("day")) return amount * 86400;
  if (text.contains("hour") or text.contains("hr")) return amount * 3600;
  if (text.contains("minute") or text.contains("min")) return amount * 60;
  return amount;
}

operation cloneKernelExpression(expr, prefix : String, seed) {
  if (expr.isUndefined()) {
    return null;
  }
  var cloned = new KERNEL!Expression;
  cloned.id = newId(prefix, firstText(expr.id, seed.id));
  cloned.name = firstText(expr.name, firstText(seed.name, seed.id) + " Expression");
  cloned.language = expr.language;
  cloned.body = expr.body;
  cloned.phase = expr.phase;
  cloned.sideEffectFree = expr.sideEffectFree;
  traceGenerated(expr, cloned, "TR-130", "HIGH");
  return cloned;
}

operation cloneConditionExpression(condition : CIMBEHAVIOR!Condition, prefix : String, seed) {
  if (condition.isUndefined() or condition.expressionModel.isUndefined()) {
    return null;
  }
  return cloneKernelExpression(condition.expressionModel, prefix, seed);
}

operation createPolicyContextSchema(pol : CIMPROCESS!Policy) {
  var schema = new CONTRACTS!Schema;
  schema.id = newId("schema_policy_context", pol.id);
  schema.name = pol.name + " Policy Context";
  schema.schemaKind = PIMTYPES!SchemaKind#REQUEST;
  schema.semanticVersion = "1.0.0";
  schema.compatibility = PIMTYPES!SchemaCompatibility#NONE;
  schema.additionalPropertiesAllowed = true;
  schema.generatedFromCimInformation = false;
  schema.fields.add(fieldFor(schema.id, "sourceElementId", PIMTYPES!FieldType#STRING, false));
  schema.fields.add(fieldFor(schema.id, "evaluationReason", PIMTYPES!FieldType#STRING, false));
  schema.fields.add(fieldFor(schema.id, "effectiveAt", PIMTYPES!FieldType#DATETIME, false));
  pimRoot().schemas.add(schema);
  traceGenerated(pol, schema, "TR-100", "LOW");
  return schema;
}

operation createHumanTaskInputSchema(step : CIMPROCESS!HumanTaskStep) {
  var schema = new CONTRACTS!Schema;
  schema.id = newId("schema_human_task_req", step.id);
  schema.name = step.name + " Human Task Input";
  schema.schemaKind = PIMTYPES!SchemaKind#REQUEST;
  schema.semanticVersion = "1.0.0";
  schema.compatibility = PIMTYPES!SchemaCompatibility#NONE;
  schema.additionalPropertiesAllowed = false;
  schema.generatedFromCimInformation = false;
  schema.fields.add(fieldFor(schema.id, "correlationId", PIMTYPES!FieldType#STRING, true));
  schema.fields.add(fieldFor(schema.id, "workflowExecutionId", PIMTYPES!FieldType#STRING, true));
  schema.fields.add(fieldFor(schema.id, "stateName", PIMTYPES!FieldType#STRING, true));
  schema.fields.add(fieldFor(schema.id, "assignedRole", PIMTYPES!FieldType#STRING, false));
  pimRoot().schemas.add(schema);
  traceGenerated(step, schema, "TR-120", "LOW");
  return schema;
}

operation createHumanTaskOutputSchema(step : CIMPROCESS!HumanTaskStep) {
  var schema = new CONTRACTS!Schema;
  schema.id = newId("schema_human_task_res", step.id);
  schema.name = step.name + " Human Task Output";
  schema.schemaKind = PIMTYPES!SchemaKind#RESPONSE;
  schema.semanticVersion = "1.0.0";
  schema.compatibility = PIMTYPES!SchemaCompatibility#NONE;
  schema.additionalPropertiesAllowed = false;
  schema.generatedFromCimInformation = false;
  schema.fields.add(fieldFor(schema.id, "correlationId", PIMTYPES!FieldType#STRING, true));
  schema.fields.add(fieldFor(schema.id, "taskOutcome", PIMTYPES!FieldType#STRING, true));
  schema.fields.add(fieldFor(schema.id, "evidenceReference", PIMTYPES!FieldType#STRING, false));
  schema.fields.add(fieldFor(schema.id, "completedBy", PIMTYPES!FieldType#STRING, false));
  pimRoot().schemas.add(schema);
  traceGenerated(step, schema, "TR-120", "LOW");
  return schema;
}

rule Policy2PolicyHandlerFunction
  transform pol : CIMPROCESS!Policy
  to fn : COMPUTE!Function {

  guard : pol.policyType.asString() = "REACTION" or pol.policyType.asString() = "DERIVATION" or pol.policyType.asString() = "ESCALATION" or pol.policyType.asString() = "VALIDATION" or pol.triggeredBy.notEmpty() or pol.emitsCommands.notEmpty() or pol.emitsEvents.notEmpty()

  fn.id = idFor("fn_policy", pol);
  fn.name = nameFor(pol, " Policy Handler");
  fn.functionKind = PIMTYPES!FunctionKind#POLICY_HANDLER;
  fn.responsibility = pol.naturalLanguageRule.orDefault("Evaluate policy " + pol.name);
  fn.handlerResponsibility = fn.responsibility;
  fn.sourceNameSuggestion = pascalCase(pol.name) + "PolicyHandler";
  fn.publicEntryPoint = false;
  fn.writesState = false;
  fn.readsState = pol.guards.notEmpty() or pol.constrainsQueries.notEmpty();
  fn.publishesEvents = pol.emitsEvents.notEmpty();
  if (pol.triggeredBy.notEmpty()) {
    fn.executionModel = PIMTYPES!ExecutionModel#ASYNC_EVENT;
  }
  else {
    fn.executionModel = PIMTYPES!ExecutionModel#REQUEST_RESPONSE;
  }
  fn.computeProfile = PIMTYPES!ComputeProfile#LIGHTWEIGHT;
  fn.stateless = true;

  var contract = new CONTRACTS!FunctionContract;
  contract.id = idFor("contract_policy", pol);
  contract.name = pol.name + " Policy Contract";
  contract.contractVersion = "1.0.0";
  contract.validatesInput = true;
  contract.validatesOutput = false;
  contract.correlationIdField = "correlationId";
  var inputSchema = new CONTRACTS!Schema;
  inputSchema.id = idFor("schema_policy_req", pol);
  inputSchema.name = pol.name + " Policy Input";
  inputSchema.schemaKind = PIMTYPES!SchemaKind#REQUEST;
  inputSchema.semanticVersion = "1.0.0";
  inputSchema.compatibility = PIMTYPES!SchemaCompatibility#NONE;
  inputSchema.additionalPropertiesAllowed = false;
  inputSchema.generatedFromCimInformation = true;
  inputSchema.fields.add(fieldFor(inputSchema.id, "correlationId", PIMTYPES!FieldType#STRING, true));
  var policyContext = fieldFor(inputSchema.id, "policyContext", PIMTYPES!FieldType#OBJECT, false);
  policyContext.objectSchema = createPolicyContextSchema(pol);
  inputSchema.fields.add(policyContext);
  if (hasText(expressionText(pol)) or hasText(pol.naturalLanguageRule)) {
    var constraint = new CONTRACTS!SchemaConstraint;
    constraint.id = idFor("constraint_policy", pol);
    constraint.name = pol.name + " Policy Constraint";
    constraint.expressionLanguage = expressionLanguageText(pol);
    constraint.expression = firstText(expressionText(pol), pol.naturalLanguageRule);
    constraint.message = firstText(pol.naturalLanguageRule, expressionText(pol));
    constraint.severity = mapSeverity(pol.violationSeverity);
    inputSchema.constraints.add(constraint);
    traceGenerated(pol, constraint, "TR-100", "MEDIUM");
  }
  pimRoot().schemas.add(inputSchema);
  traceGenerated(pol, inputSchema, "TR-100", "MEDIUM");
  contract.inputSchema = inputSchema;
  for (ev in pol.emitsEvents) {
    contract.emittedEvents.add(eventTypeFor(ev));
    fn.publishes.add(eventTypeFor(ev));
  }
  fn.contract = contract;
  fn.observability = createDefaultObservability(fn, "TR-100", pol.auditRequired, pol.auditRequired);
  if (fn.publishesEvents or pol.triggeredBy.notEmpty()) {
    fn.requiresIdempotency = true;
    fn.idempotency = createIdempotencyPolicyForTarget(fn, pol, "TR-100", "eventId");
  }

  pimRoot().functions.add(fn);
  traceGenerated(pol, fn, "TR-100", "MEDIUM");
}

rule Policy2ArchitecturePolicy
  transform pol : CIMPROCESS!Policy
  to p : POLICY!CompliancePolicy {

  guard : pol.policyType.asString() = "COMPLIANCE" or pol.policyType.asString() = "GUARD" or pol.policyType.asString() = "AUTHORIZATION" or pol.policyType.asString() = "COMPENSATION"

  p.id = idFor("arch_policy", pol);
  p.name = nameFor(pol, " Architecture Policy");
  p.policyScope = pol.naturalLanguageRule;
  p.productionRequired = pol.enforcementStrength.asString() = "MANDATORY" or pol.enforcementStrength.asString() = "BLOCKING";

  pimRoot().policies.add(p);
  traceGenerated(pol, p, "TR-100", "MEDIUM");
}

rule DecisionTable2ChoiceLogic
  transform dt : CIMPROCESS!DecisionTable
  to fn : COMPUTE!Function {

  fn.id = idFor("fn_decision", dt);
  fn.name = nameFor(dt, " Decision Evaluator");
  fn.functionKind = PIMTYPES!FunctionKind#POLICY_HANDLER;
  fn.responsibility = "Evaluate decision table " + dt.name;
  fn.handlerResponsibility = "Evaluate hit policy " + dt.hitPolicy + " and produce an outcome.";
  fn.writesState = false;
  fn.readsState = false;
  fn.executionModel = PIMTYPES!ExecutionModel#REQUEST_RESPONSE;
  fn.computeProfile = PIMTYPES!ComputeProfile#LIGHTWEIGHT;
  fn.stateless = true;
  var contract = new CONTRACTS!FunctionContract;
  contract.id = idFor("contract_decision", dt);
  contract.name = dt.name + " Decision Contract";
  contract.contractVersion = "1.0.0";
  contract.validatesInput = true;
  contract.validatesOutput = true;
  contract.correlationIdField = "correlationId";
  var inputSchema = new CONTRACTS!Schema;
  inputSchema.id = idFor("schema_decision_req", dt);
  inputSchema.name = dt.name + " Decision Input";
  inputSchema.schemaKind = PIMTYPES!SchemaKind#REQUEST;
  inputSchema.semanticVersion = "1.0.0";
  inputSchema.compatibility = PIMTYPES!SchemaCompatibility#NONE;
  inputSchema.additionalPropertiesAllowed = false;
  inputSchema.generatedFromCimInformation = true;
  for (item in dt.inputs) {
    inputSchema.fields.add(createSchemaField(item, inputSchema.id));
  }
  if (inputSchema.fields.isEmpty()) {
    inputSchema.fields.add(fieldFor(inputSchema.id, "decisionContext", PIMTYPES!FieldType#OBJECT, true));
  }
  pimRoot().schemas.add(inputSchema);
  contract.inputSchema = inputSchema;
  fn.contract = contract;
  fn.observability = createDefaultObservability(fn, "TR-100", false, false);

  pimRoot().functions.add(fn);
  traceGenerated(dt, fn, "TR-100", "MEDIUM");
  traceGenerated(dt, inputSchema, "TR-100", "MEDIUM");

  for (decisionRule in dt.rules) {
    var outcomeSchema = new CONTRACTS!Schema;
    outcomeSchema.id = idFor("schema_decision_rule", decisionRule);
    outcomeSchema.name = decisionRule.name + " Decision Outcome";
    outcomeSchema.schemaKind = PIMTYPES!SchemaKind#RESPONSE;
    outcomeSchema.semanticVersion = "1.0.0";
    outcomeSchema.compatibility = PIMTYPES!SchemaCompatibility#NONE;
    outcomeSchema.additionalPropertiesAllowed = false;
    outcomeSchema.fields.add(fieldForWithDefault(outcomeSchema.id, "condition", PIMTYPES!FieldType#STRING, true, decisionRule.condition));
    outcomeSchema.fields.add(fieldForWithDefault(outcomeSchema.id, "outcome", PIMTYPES!FieldType#STRING, true, decisionRule.outcome));
    pimRoot().schemas.add(outcomeSchema);
    if (fn.contract.outputSchema.isUndefined()) {
      fn.contract.outputSchema = outcomeSchema;
      fn.contract.validatesOutput = true;
    }
    traceGenerated(decisionRule, outcomeSchema, "TR-100", "MEDIUM");

    if (decisionRule.resultingCommands.notEmpty() or decisionRule.resultingEvents.notEmpty()) {
      manualDecision("TR-100", "Confirm routing semantics for decision rule '" + decisionRule.name + "' outcomes.", KERNEL!Severity#WARNING, false, Sequence{decisionRule, fn});
    }
  }

  if (not dt.complete) {
    manualDecision("TR-100", "Decision table '" + dt.name + "' is incomplete; define missing rules or default outcome.", KERNEL!Severity#ERROR, true, Sequence{dt, fn});
  }
}

rule DecisionTable2DecisionModel
  transform dt : CIMPROCESS!DecisionTable
  to dm : POLICY!DecisionModel {

  dm.id = idFor("decision_model", dt);
  dm.name = nameFor(dt, " Decision Model");
  dm.hitPolicy = firstText(dt.hitPolicy, "UNSPECIFIED");

  for (item in dt.inputs) {
    var inputSchema = item.equivalent("InformationItem2Schema");
    if (inputSchema.isDefined()) {
      dm.inputs.add(inputSchema);
    }
  }
  for (item in dt.outputs) {
    var outputSchema = item.equivalent("InformationItem2Schema");
    if (outputSchema.isDefined()) {
      dm.outputs.add(outputSchema);
    }
  }

  for (sourceRule in dt.rules) {
    var decisionRuleTarget = new POLICY!DecisionRule;
    decisionRuleTarget.id = idFor("decision_rule", sourceRule);
    decisionRuleTarget.name = nameFor(sourceRule, " Decision Rule");

    var condition = new KERNEL!Expression;
    condition.id = idFor("expr_decision_condition", sourceRule);
    condition.name = sourceRule.name + " Condition";
    condition.language = KERNEL!ExpressionLanguage#NATURAL_LANGUAGE;
    condition.body = firstText(sourceRule.condition, "REVIEW_REQUIRED_CONDITION");
    condition.phase = KERNEL!ExpressionPhase#DESIGN_TIME;
    condition.sideEffectFree = true;
    decisionRuleTarget.condition = condition;

    var outcome = new KERNEL!Expression;
    outcome.id = idFor("expr_decision_outcome", sourceRule);
    outcome.name = sourceRule.name + " Outcome";
    outcome.language = KERNEL!ExpressionLanguage#NATURAL_LANGUAGE;
    outcome.body = firstText(sourceRule.outcome, firstText(dt.defaultOutcome, "REVIEW_REQUIRED_OUTCOME"));
    outcome.phase = KERNEL!ExpressionPhase#DESIGN_TIME;
    outcome.sideEffectFree = true;
    decisionRuleTarget.outcome = outcome;

    dm.rules.add(decisionRuleTarget);
    traceGenerated(sourceRule, decisionRuleTarget, "TR-100", "MEDIUM");
  }

  pimRoot().decisionModels.add(dm);
  traceGenerated(dt, dm, "TR-100", "MEDIUM");

  if (not dt.complete and not hasText(dt.defaultOutcome)) {
    manualDecision("TR-100",
      "Confirm default outcome for incomplete decision table '" + dt.name + "'.",
      KERNEL!Severity#WARNING, false, Sequence{dt, dm});
  }
}

rule BusinessProcess2Workflow
  transform bp : CIMPROCESS!BusinessProcess
  to wf : WORKFLOW!Workflow {

  guard : shouldGenerateWorkflow(bp)

  wf.id = idFor("workflow", bp);
  wf.name = nameFor(bp, " Workflow");
  wf.workflowKind = mapWorkflowKind(bp);
  wf.executionSemantics = bp.businessTriggerDescription;
  wf.longRunning = bp.longRunning;
  wf.stateful = bp.longRunning or bp.steps.size() > 2;
  wf.compensationRequired = bp.compensationExpected or bp.exceptions.exists(e | e.compensationRequired);
  wf.humanApprovalRequired = bp.humanApprovalPossible or bp.steps.exists(s | s.isKindOf(CIMPROCESS!HumanTaskStep));
  wf.expectedMaxDurationSeconds = 0;
  wf.expressLowLatencyRequired = not wf.longRunning and (bp.criticality.asString() = "CORE" or bp.criticality.asString() = "MISSION_CRITICAL");
  wf.observability = createDefaultObservability(wf, "TR-110", true, wf.expressLowLatencyRequired);
  if (wf.compensationRequired or bp.exceptions.notEmpty()) {
    wf.resilience = createDefaultResilience(wf, "TR-110", false);
  }

  pimRoot().workflows.add(wf);
  traceGenerated(bp, wf, "TR-110", "HIGH");
}

@greedy
rule ProcessStep2WorkflowState
  transform s : CIMPROCESS!ProcessStep
  to ws : WORKFLOW!WorkflowState {

  ws.id = idFor("state", s);
  ws.name = s.name;
  ws.stateKind = mapStateKind(s);
  ws.orderIndex = s.orderIndex;
  ws.terminal = s.isKindOf(CIMPROCESS!EndStep);
  ws.inputMapping = "TBD";
  ws.outputMapping = "TBD";
  ws.timeoutSeconds = 0;

  if (s.isKindOf(CIMPROCESS!CommandStep)) {
    ws.invokesFunction = commandFunction(s.command);
  }
  if (s.isKindOf(CIMPROCESS!QueryStep)) {
    ws.invokesFunction = queryFunction(s.query);
  }
  if (s.isKindOf(CIMPROCESS!PolicyStep)) {
    ws.invokesFunction = policyFunction(s.policy);
  }
  if (s.isKindOf(CIMPROCESS!ExternalInteractionStep)) {
    ws.invokesAdapter = adapterFor(s.externalSystem);
  }
  if (s.isKindOf(CIMPROCESS!DecisionStep) and s.condition.isDefined()) {
    ws.condition = cloneConditionExpression(s.condition, "state_condition", s);
    ws.conditionExpression = expressionText(s.condition);
  }
  if (s.isKindOf(CIMPROCESS!DecisionStep) and s.decisionTable.isDefined()) {
    var decisionFn = cachedEquivalent(s.decisionTable, "DecisionTable2ChoiceLogic");
    if (decisionFn.isDefined()) {
      ws.invokesFunction = decisionFn;
      traceGenerated(s, decisionFn, "TR-120", "MEDIUM");
    }
  }
  if (s.isKindOf(CIMPROCESS!HumanTaskStep)) {
    var taskFn = new COMPUTE!Function;
    taskFn.id = newId("fn_human_task", s.id);
    taskFn.name = s.name + " Human Task Handler";
    taskFn.functionKind = PIMTYPES!FunctionKind#ORCHESTRATION_TASK;
    taskFn.responsibility = "Coordinate human task '" + s.name + "' and capture evidence for workflow continuation.";
    taskFn.handlerResponsibility = taskFn.responsibility;
    taskFn.sourceNameSuggestion = pascalCase(s.name) + "HumanTaskHandler";
    taskFn.publicEntryPoint = false;
    taskFn.writesState = false;
    taskFn.readsState = false;
    taskFn.publishesEvents = false;
    taskFn.requiresIdempotency = true;
    taskFn.executionModel = PIMTYPES!ExecutionModel#REQUEST_RESPONSE;
    taskFn.computeProfile = PIMTYPES!ComputeProfile#LIGHTWEIGHT;
    taskFn.stateless = true;
    var taskContract = new CONTRACTS!FunctionContract;
    taskContract.id = newId("contract_human_task", s.id);
    taskContract.name = s.name + " Human Task Contract";
    taskContract.contractVersion = "1.0.0";
    taskContract.validatesInput = true;
    taskContract.validatesOutput = true;
    taskContract.correlationIdField = "correlationId";
    taskContract.inputSchema = createHumanTaskInputSchema(s);
    taskContract.outputSchema = createHumanTaskOutputSchema(s);
    taskFn.contract = taskContract;
    taskFn.idempotency = createIdempotencyPolicyForTarget(taskFn, s, "TR-120", "workflowExecutionAndState");
    taskFn.observability = createDefaultObservability(taskFn, "TR-120", true, true);
    pimRoot().functions.add(taskFn);
    traceGenerated(s, taskFn, "TR-120", "LOW");
    ws.invokesFunction = taskFn;
    ws.manuallyMaintained = true;
    manualDecision("TR-120", "Define assignment, UI, SLA, evidence, and escalation for human task '" + s.name + "'.", KERNEL!Severity#WARNING, false, Sequence{s, ws});
  }

  traceGenerated(s, ws, "TR-120", "HIGH");
}

rule ProcessTransition2WorkflowTransition
  transform t : CIMPROCESS!ProcessTransition
  to wt : WORKFLOW!WorkflowTransition {

  wt.id = idFor("wf_transition", t);
  wt.name = t.name.orDefault(t.source.name + " -> " + t.target.name);
  wt.source = workflowStateFor(t.source);
  wt.target = workflowStateFor(t.target);
  if (t.condition.isDefined()) {
    wt.condition = cloneKernelExpression(t.condition, "wf_transition_condition", t);
  }
  if (hasText(t.conditionExpression)) {
    wt.conditionExpression = t.conditionExpression;
  }
  else {
    if (t.condition.isDefined()) {
      wt.conditionExpression = expressionText(t.condition);
    }
    else {
      wt.conditionExpression = "";
    }
  }
  wt.defaultTransition = not hasText(t.conditionExpression) and t.condition.isUndefined();
  traceGenerated(t, wt, "TR-130", "HIGH");
}

post AttachWorkflowDetails {
  etlProfiler.mark("cim.workflowDetails.start");
  for (bp in CIMPROCESS!BusinessProcess.all) {
    var wf = workflowFor(bp);
    if (wf.isUndefined()) {
      continue;
    }
    for (step in bp.steps) {
      var state = workflowStateFor(step);
      if (state.isDefined() and not wf.states.includes(state)) {
        wf.states.add(state);
      }
    }
    if (wf.states.notEmpty()) {
      var starts = wf.states.select(s | s.stateKind = PIMTYPES!WorkflowStateKind#PASS);
      if (starts.notEmpty()) {
        wf.startState = starts.first();
      }
      else {
        wf.startState = wf.states.sortBy(s | s.orderIndex).first();
      }
      wf.endStates.addAll(wf.states.select(s | s.terminal));
      if (wf.endStates.isEmpty()) {
        wf.endStates.add(wf.states.sortBy(s | s.orderIndex).last());
      }
    }
    for (t in bp.transitions) {
      var transition = cachedEquivalent(t, "ProcessTransition2WorkflowTransition");
      if (transition.isDefined() and not wf.transitions.includes(transition)) {
        wf.transitions.add(transition);
      }
    }
    if (wf.states.notEmpty()) {
      for (ex in bp.exceptions) {
        var handler = cachedEquivalent(ex, "ExceptionScenario2ErrorHandler");
        if (handler.isDefined()) {
          var recoveryTarget = wf.states.sortBy(s | s.orderIndex).selectOne(s | not s.terminal and s <> wf.startState);
          if (recoveryTarget.isUndefined() and wf.endStates.notEmpty()) {
            recoveryTarget = wf.endStates.first();
          }
          if (recoveryTarget.isDefined()) {
            handler.nextState = recoveryTarget;
          }
          wf.startState.catchHandlers.add(handler);
        }
        if (ex.compensationRequired) {
          var comp = new WORKFLOW!CompensationPolicy;
          comp.id = idFor("compensation", ex);
          comp.name = ex.name + " Compensation";
          comp.policyScope = "workflow compensation";
          comp.productionRequired = true;
          comp.compensationStrategy = ex.recoveryAction.orDefault("TBD");
          comp.automatic = hasText(ex.recoveryAction);
          comp.compensationEvents.addAll(ex.resultingEvents.collect(e | eventTypeFor(e)).select(e | e.isDefined()));
          wf.startState.compensation = comp;
          pimRoot().policies.add(comp);
          traceGenerated(ex, comp, "TR-130", "MEDIUM");
          if (not hasText(ex.recoveryAction)) {
            manualDecision("TR-130", "Define compensation strategy for exception scenario '" + ex.name + "'.", KERNEL!Severity#WARNING, false, Sequence{ex, comp});
          }
        }
      }
    }
    for (state in wf.states.select(s | s.invokesAdapter.isDefined())) {
      var flowId = newId("flow_external", state.id + "_" + state.invokesAdapter.id);
      if (not cachedPimExternalFlowIds.includes(flowId)) {
        cachedPimExternalFlowIds.add(flowId);
        var flow = new INTEGRATION!ExternalIntegrationFlow;
        flow.id = flowId;
        flow.name = state.name + " calls " + state.invokesAdapter.name;
        flow.flowPurpose = "External adapter invocation from workflow state.";
        flow.criticalPath = true;
        flow.containsPersonalData = false;
        flow.source = state;
        flow.target = state.invokesAdapter;
        flow.adapter = state.invokesAdapter;
        flow.observability = createDefaultObservability(flow, "TR-140", true, true);
        flow.resilience = createDefaultResilience(flow, "TR-140", false);
        pimRoot().flows.add(flow);
        traceGenerated(state, flow, "TR-140", "MEDIUM");
      }
    }
  }
  etlProfiler.mark("cim.workflowDetails.end");
}

rule ExceptionScenario2ErrorHandler
  transform ex : CIMPROCESS!ExceptionScenario
  to eh : WORKFLOW!ErrorHandler {

  eh.id = idFor("errorhandler", ex);
  eh.name = nameFor(ex, " Error Handler");
  eh.errorSelector = joinText(ex.errors.collect(e | e.errorCode), ",");
  eh.recoveryAction = ex.recoveryAction;
  eh.continueWorkflow = ex.recoverable;

  if (ex.expected and not hasText(ex.recoveryAction)) {
    manualDecision("TR-130", "Define recovery action for expected exception scenario '" + ex.name + "'.", KERNEL!Severity#WARNING, false, Sequence{ex, eh});
  }
  traceGenerated(ex, eh, "TR-130", "MEDIUM");
}

rule SecurityConstraint2SecurityPolicies
  transform sc : CIMGOV!SecurityConstraint
  to sec : SECURITY!SecurityPolicy,
     auth : SECURITY!AuthPolicy,
     authz : SECURITY!AuthorizationPolicy {

  sec.id = idFor("security", sc);
  sec.name = nameFor(sc, " Security Policy");
  sec.policyScope = "security";
  sec.authenticationRequired = hasText(sc.authenticationNeed);
  sec.authorizationRequired = hasText(sc.authorizationRule);
  sec.authStrength = sc.authenticationNeed;
  sec.auditRequired = sc.auditAccessRequired or sc.nonRepudiationRequired;
  sec.encryptionInTransitRequired = true;
  sec.encryptionAtRestRequired = sc.constrainedInformation.exists(i | isSensitive(i));
  sec.secretsRequired = false;
  sec.threatModelNotes = sc.threatRationale;

  auth.id = idFor("auth", sc);
  auth.name = nameFor(sc, " Auth Policy");
  auth.policyScope = "authentication";
  auth.authenticationRequired = sec.authenticationRequired;
  auth.authScheme = sc.authenticationNeed.orDefault("TBD");
  auth.mfaRequired = sc.segregationOfDutiesRequired or sc.nonRepudiationRequired;
  if (sc.constrainedActors.notEmpty()) {
    var idp = cachedEquivalent(sc.constrainedActors.first(), "Actor2Principal");
    var actorIdp = SECURITY!IdentityProvider.all.selectOne(provider | provider.principals.includes(idp));
    if (actorIdp.isDefined()) {
      auth.identityProvider = actorIdp;
    }
  }

  authz.id = idFor("authz", sc);
  authz.name = nameFor(sc, " Authorization Policy");
  authz.policyScope = "authorization";
  authz.authorizationRequired = sec.authorizationRequired;
  authz.ruleExpression = sc.authorizationRule;
  authz.resourceLevelAuthorization = sc.constrainedInformation.notEmpty();
  authz.roleOrScopeRequired = sc.authorizationRule;

  var protectedTargets = policyTargetsForAll(sc.constrainedCommands);
  protectedTargets.addAll(policyTargetsForAll(sc.constrainedQueries));
  protectedTargets.addAll(policyTargetsForAll(sc.constrainedElements));
  var uniqueProtectedTargets = Sequence{};
  for (target in protectedTargets) {
    if (not uniqueProtectedTargets.includes(target)) {
      uniqueProtectedTargets.add(target);
    }
  }
  protectedTargets = uniqueProtectedTargets;
  sec.attachedTo.addAll(protectedTargets);
  auth.attachedTo.addAll(protectedTargets);
  authz.attachedTo.addAll(protectedTargets);

  for (actor in sc.constrainedActors) {
    var principal = cachedEquivalent(actor, "Actor2Principal");
    if (principal.isDefined()) {
      authz.allowedPrincipals.add(principal);
    }
  }
  if (authz.allowedPrincipals.notEmpty() and protectedTargets.notEmpty()) {
    manualDecision("TR-060",
      "Translate security constraint '" + sc.name + "' into explicit provider-independent Permission action/resource entries.",
      KERNEL!Severity#WARNING, true, Sequence{sc, authz});
  }

  pimRoot().policies.add(sec);
  pimRoot().policies.add(auth);
  pimRoot().policies.add(authz);
  traceGenerated(sc, sec, "TR-060", "HIGH");
  traceGenerated(sc, auth, "TR-060", "HIGH");
  traceGenerated(sc, authz, "TR-060", "HIGH");

  if (not hasText(sc.authorizationRule) and (sc.constrainedCommands.notEmpty() or sc.constrainedQueries.notEmpty())) {
    manualDecision("TR-060", "Confirm authorization rules for security constraint '" + sc.name + "'.", KERNEL!Severity#ERROR, true, Sequence{sc, authz});
  }
}

rule TemporalConstraint2TimeoutPolicy
  transform tc : CIMPROCESS!TemporalConstraint
  to timeout : POLICY!TimeoutPolicy,
     ordering : POLICY!OrderingPolicy {

  timeout.id = idFor("timeout", tc);
  timeout.name = nameFor(tc, " Timeout");
  timeout.policyScope = firstText(tc.deadlineExpression, firstText(tc.durationExpression, tc.orderingExpression));
  timeout.productionRequired = tc.violationSeverity.asString() = "ERROR" or tc.violationSeverity.asString() = "CRITICAL" or tc.violationSeverity.asString() = "BLOCKER";
  timeout.timeoutSeconds = secondsFromDurationExpression(firstText(tc.durationExpression, tc.deadlineExpression));
  timeout.clientTimeoutSeconds = timeout.timeoutSeconds;
  timeout.attachedTo.addAll(policyTargetsForAll(tc.constrainedElements));
  pimRoot().policies.add(timeout);
  traceGenerated(tc, timeout, "TR-130", "MEDIUM");

  ordering.id = idFor("ordering", tc);
  ordering.name = nameFor(tc, " Ordering");
  ordering.policyScope = tc.orderingExpression;
  ordering.productionRequired = timeout.productionRequired;
  if (hasText(tc.orderingExpression)) {
    ordering.orderingRequirement = PIMTYPES!OrderingRequirement#PER_KEY;
    ordering.orderingKey = tc.orderingExpression;
    ordering.strictOrderingRequired = tc.violationSeverity.asString() = "ERROR" or tc.violationSeverity.asString() = "CRITICAL" or tc.violationSeverity.asString() = "BLOCKER";
  }
  else {
    ordering.orderingRequirement = PIMTYPES!OrderingRequirement#NONE;
    ordering.orderingKey = "";
    ordering.strictOrderingRequired = false;
  }
  ordering.attachedTo.addAll(policyTargetsForAll(tc.constrainedElements));
  if (hasText(tc.orderingExpression)) {
    pimRoot().policies.add(ordering);
    traceGenerated(tc, ordering, "TR-130", "MEDIUM");
  }

  for (target in policyTargetsForAll(tc.constrainedElements)) {
    if (target.isKindOf(WORKFLOW!Workflow) and timeout.timeoutSeconds > 0) {
      target.expectedMaxDurationSeconds = timeout.timeoutSeconds;
      if (target.resilience.isUndefined()) {
        target.resilience = createDefaultResilience(target, "TR-130", false);
      }
    }
    if (target.isKindOf(WORKFLOW!WorkflowState) and timeout.timeoutSeconds > 0) {
      target.timeoutSeconds = timeout.timeoutSeconds;
    }
  }

  if (hasText(tc.deadlineExpression)) {
    var schedule = new INTEGRATION!Schedule;
    schedule.id = idFor("schedule", tc);
    schedule.name = tc.name + " Schedule";
    schedule.integrationPurpose = "Temporal trigger/review marker generated from deadline expression.";
    schedule.scheduleExpression = tc.deadlineExpression;
    schedule.enabled = true;
    schedule.timeZone = "UTC";
    var routingTarget = preferredTemporalRoutingTarget(policyTargetsForAll(tc.constrainedElements));
    if (routingTarget.isDefined()) {
      schedule.targets.add(routingTarget);
    }
    else {
      schedule.enabled = false;
      manualDecision("TR-130",
        "Choose exactly one Function, Workflow, adapter, channel, or other RoutingTarget for temporal constraint '" + tc.name + "'.",
        KERNEL!Severity#ERROR, timeout.productionRequired, Sequence{tc, schedule});
    }
    pimRoot().schedules.add(schedule);
    traceGenerated(tc, schedule, "TR-130", "MEDIUM");
  }

  if ((hasText(tc.deadlineExpression) or hasText(tc.durationExpression)) and timeout.timeoutSeconds = 0) {
    manualDecision("TR-130", "Translate temporal constraint '" + tc.name + "' into concrete provider-independent timeout and schedule semantics.", KERNEL!Severity#WARNING, timeout.productionRequired, Sequence{tc, timeout});
    readinessFinding("TR-130", KERNEL!FindingType#VALIDATION_WARNING, mapSeverity(tc.violationSeverity), "Temporal constraint '" + tc.name + "' could not be converted to seconds.", "Provide duration/deadline as a parseable provider-independent duration.", timeout.productionRequired, Sequence{tc, timeout});
  }
  if (hasText(tc.orderingExpression)) {
    manualDecision("TR-130", "Confirm ordering semantics and idempotency strategy for temporal constraint '" + tc.name + "'.", KERNEL!Severity#WARNING, ordering.strictOrderingRequired, Sequence{tc, ordering});
  }
}

operation preferredTemporalRoutingTarget(targets) {
  var routingTargets = Sequence{};
  for (target in targets.select(t | t.isKindOf(KERNEL!RoutingTarget))) {
    if (not routingTargets.includes(target)) {
      routingTargets.add(target);
    }
  }
  var workflows = routingTargets.select(t | t.isKindOf(WORKFLOW!Workflow));
  if (workflows.size() = 1) {
    return workflows.first();
  }
  var functions = routingTargets.select(t | t.isKindOf(COMPUTE!Function));
  if (functions.size() = 1) {
    return functions.first();
  }
  if (routingTargets.size() = 1) {
    return routingTargets.first();
  }
  return null;
}

rule AvailabilityReliabilityNfr2ResiliencePolicy
  transform nfr : CIMGOV!NonFunctionalRequirement
  to pol : POLICY!ResiliencePolicy,
     backup : POLICY!BackupPolicy {

  guard : nfr.qualityType.asString() = "AVAILABILITY" or nfr.qualityType.asString() = "RELIABILITY"

  pol.id = idFor("resilience_nfr", nfr);
  pol.name = nameFor(nfr, " Resilience Policy");
  pol.policyScope = firstText(nfr.metric, nfr.target);
  pol.productionRequired = nfr.mandatory or nfr.productionBlocking;
  pol.retryEnabled = true;
  pol.deadLetterRequired = true;
  pol.fallbackRequired = false;
  pol.circuitBreakerRequired = true;
  pol.timeoutRequired = true;
  var retry = new POLICY!RetryPolicy;
  retry.id = idFor("retry_nfr", nfr);
  retry.name = nfr.name + " Retry";
  retry.maxAttempts = 3;
  retry.initialDelaySeconds = 1;
  retry.backoffRate = 2.0d;
  retry.maxDelaySeconds = 60;
  pol.retry = retry;
  pol.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  pimRoot().policies.add(pol);
  traceGenerated(nfr, pol, "TR-060", "MEDIUM");

  backup.id = idFor("backup_nfr", nfr);
  backup.name = nameFor(nfr, " Backup Policy");
  backup.policyScope = firstText(nfr.metric, nfr.target);
  backup.productionRequired = nfr.mandatory or nfr.productionBlocking;
  backup.backupRequired = true;
  backup.backupFrequency = "TBD";
  backup.recoveryPointObjective = nfr.target;
  backup.recoveryTimeObjective = nfr.fitCriterion;
  backup.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  pimRoot().policies.add(backup);
  traceGenerated(nfr, backup, "TR-060", "MEDIUM");
}

rule PerformanceNfr2TimeoutPolicy
  transform nfr : CIMGOV!NonFunctionalRequirement
  to pol : POLICY!TimeoutPolicy,
     concurrency : POLICY!ConcurrencyPolicy,
     cache : POLICY!CachePolicy,
     rateLimit : POLICY!RateLimitPolicy {

  guard : nfr.qualityType.asString() = "PERFORMANCE" or nfr.qualityType.asString() = "LATENCY" or nfr.qualityType.asString() = "SCALABILITY"

  pol.id = idFor("timeout_nfr", nfr);
  pol.name = nameFor(nfr, " Timeout Policy");
  pol.policyScope = firstText(nfr.metric, nfr.target);
  pol.productionRequired = nfr.mandatory or nfr.productionBlocking;
  pol.timeoutSeconds = secondsFromDurationExpression(nfr.target);
  pol.clientTimeoutSeconds = pol.timeoutSeconds;
  pol.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  pimRoot().policies.add(pol);
  traceGenerated(nfr, pol, "TR-060", "MEDIUM");

  concurrency.id = idFor("concurrency_nfr", nfr);
  concurrency.name = nameFor(nfr, " Concurrency Policy");
  concurrency.policyScope = firstText(nfr.metric, nfr.target);
  concurrency.productionRequired = nfr.mandatory or nfr.productionBlocking;
  concurrency.maxConcurrency = 0;
  concurrency.reservedConcurrencyHint = 0;
  concurrency.burstAssumption = 0;
  concurrency.perSourceLimitRequired = nfr.qualityType.asString() = "SCALABILITY";
  concurrency.scalingRationale = nfr.fitCriterion;
  concurrency.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  pimRoot().policies.add(concurrency);
  traceGenerated(nfr, concurrency, "TR-060", "MEDIUM");

  cache.id = idFor("cache_nfr", nfr);
  cache.name = nameFor(nfr, " Cache Policy");
  cache.policyScope = firstText(nfr.metric, nfr.target);
  cache.productionRequired = nfr.mandatory or nfr.productionBlocking;
  cache.cacheRequired = nfr.qualityType.asString() = "PERFORMANCE" or nfr.qualityType.asString() = "LATENCY";
  cache.ttlSeconds = 0;
  cache.cacheKey = "TBD";
  cache.privateCache = true;
  cache.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  pimRoot().policies.add(cache);
  traceGenerated(nfr, cache, "TR-060", "MEDIUM");

  rateLimit.id = idFor("ratelimit_nfr", nfr);
  rateLimit.name = nameFor(nfr, " Rate Limit Policy");
  rateLimit.policyScope = firstText(nfr.metric, nfr.target);
  rateLimit.productionRequired = nfr.mandatory or nfr.productionBlocking;
  rateLimit.requestsPerSecond = 1;
  rateLimit.burstLimit = 10;
  rateLimit.keyBy = "client";
  rateLimit.clientSpecific = true;
  rateLimit.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  pimRoot().policies.add(rateLimit);
  traceGenerated(nfr, rateLimit, "TR-060", "MEDIUM");

  manualDecision("TR-060", "Translate performance/scalability NFR '" + nfr.name + "' into concrete timeout, concurrency, cache, and rate-limit values.", KERNEL!Severity#WARNING, nfr.productionBlocking, Sequence{nfr, pol, concurrency, cache, rateLimit});
}

rule AuditOperabilityNfr2Observability
  transform nfr : CIMGOV!NonFunctionalRequirement
  to pol : POLICY!ObservabilityConfig {

  guard : nfr.qualityType.asString() = "AUDITABILITY" or nfr.qualityType.asString() = "OPERABILITY" or nfr.qualityType.asString() = "MAINTAINABILITY"

  pol.id = idFor("observability_nfr", nfr);
  pol.name = nameFor(nfr, " Observability");
  pol.policyScope = firstText(nfr.metric, nfr.target);
  pol.productionRequired = nfr.mandatory or nfr.productionBlocking;
  pol.loggingEnabled = true;
  pol.metricsEnabled = true;
  pol.tracingEnabled = true;
  pol.alarmsEnabled = nfr.productionBlocking;
  pol.dashboardRequired = nfr.productionBlocking;
  pol.correlationIdRequired = true;
  pol.correlationIdField = "correlationId";
  pol.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  var logging = new POLICY!LoggingPolicy;
  logging.id = idFor("logging_nfr", nfr);
  logging.name = nameFor(nfr, " Logging");
  logging.logFormat = "structured-json";
  logging.logLevel = "INFO";
  logging.structuredLogging = true;
  logging.includeCorrelationId = true;
  logging.maskSensitiveData = true;
  logging.retentionPeriod = "TBD";
  pol.logging = logging;
  traceGenerated(nfr, logging, "TR-060", "MEDIUM");

  var tracing = new POLICY!TracingPolicy;
  tracing.id = idFor("tracing_nfr", nfr);
  tracing.name = nameFor(nfr, " Tracing");
  tracing.tracingRequired = true;
  tracing.samplingPolicy = "TBD";
  tracing.propagateTraceContext = true;
  pol.tracing = tracing;
  traceGenerated(nfr, tracing, "TR-060", "MEDIUM");

  var metric = new POLICY!MetricPolicy;
  metric.id = idFor("metric_nfr", nfr);
  metric.name = nameFor(nfr, " Metric");
  metric.metricName = firstText(nfr.metric, nfr.name);
  metric.unit = "Count";
  metric.statistic = "Sum";
  metric.businessMetric = nfr.qualityType.asString() = "AUDITABILITY";
  pol.metrics.add(metric);
  traceGenerated(nfr, metric, "TR-060", "MEDIUM");

  var slo = new POLICY!Slo;
  slo.id = idFor("slo_nfr", nfr);
  slo.name = nameFor(nfr, " SLO");
  slo.objectiveName = nfr.name;
  slo.metric = nfr.metric;
  slo.target = nfr.target;
  slo.measurementWindow = nfr.measurementMethod;
  slo.errorBudgetPolicy = "TBD";
  pol.slos.add(slo);
  traceGenerated(nfr, slo, "TR-060", "MEDIUM");

  pimRoot().policies.add(pol);
  traceGenerated(nfr, pol, "TR-060", "MEDIUM");
}

rule CostNfr2CostPolicy
  transform nfr : CIMGOV!NonFunctionalRequirement
  to pol : POLICY!CostPolicy {

  guard : nfr.qualityType.asString() = "COST"

  pol.id = idFor("cost_nfr", nfr);
  pol.name = nameFor(nfr, " Cost Policy");
  pol.policyScope = firstText(nfr.metric, nfr.target);
  pol.productionRequired = nfr.productionBlocking;
  pol.budget = nfr.target;
  pol.costDriver = nfr.metric;
  pol.optimizationIntent = nfr.fitCriterion;
  pol.alarmsRequired = nfr.productionBlocking;
  pol.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  pimRoot().policies.add(pol);
  traceGenerated(nfr, pol, "TR-060", "MEDIUM");
}

rule DataQualityNfr2SchemaConstraintAndReadiness
  transform nfr : CIMGOV!NonFunctionalRequirement
  to pol : POLICY!DataQualityPolicy {

  guard : nfr.qualityType.asString() = "DATA_QUALITY"

  pol.id = idFor("dataquality_nfr", nfr);
  pol.name = nameFor(nfr, " Data Quality Policy");
  pol.policyScope = firstText(nfr.metric, nfr.target);
  pol.productionRequired = nfr.mandatory or nfr.productionBlocking;
  pol.validationRequired = true;
  pol.completenessCheckRequired = firstText(nfr.metric, nfr.name).toLowerCase().contains("complete");
  pol.freshnessCheckRequired = firstText(nfr.metric, nfr.name).toLowerCase().contains("fresh");
  pol.duplicateDetectionRequired = firstText(nfr.metric, nfr.name).toLowerCase().contains("duplicate");
  pol.qualityDimensions = firstText(nfr.metric, firstText(nfr.qualityType, nfr.name));
  pol.measurementRule = firstText(nfr.fitCriterion, nfr.description);
  pol.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  pimRoot().policies.add(pol);
  traceGenerated(nfr, pol, "TR-060", "MEDIUM");
  readinessCheck("DATA_QUALITY_NFR_" + nfr.id, KERNEL!Severity#WARNING, hasText(nfr.fitCriterion),
    "Data quality NFR has a measurable fit criterion.", "Define validation rules or measurable data quality thresholds.", Sequence{nfr, pol});
}

rule GenericComplianceNfr2CompliancePolicy
  transform nfr : CIMGOV!NonFunctionalRequirement
  to pol : POLICY!CompliancePolicy {

  guard : nfr.qualityType.asString() = "COMPLIANCE" and not nfr.isKindOf(CIMGOV!ComplianceConstraint)

  pol.id = idFor("compliance_nfr", nfr);
  pol.name = nameFor(nfr, " Compliance Policy");
  pol.policyScope = firstText(nfr.metric, nfr.target);
  pol.productionRequired = nfr.mandatory or nfr.productionBlocking;
  pol.regulation = nfr.sourceType.asString();
  pol.controlId = nfr.id;
  pol.evidenceType = nfr.fitCriterion;
  pol.auditReportRequired = nfr.productionBlocking;
  pol.attachedTo.addAll(policyTargetsForAll(nfr.constrainedElements));
  pimRoot().policies.add(pol);
  traceGenerated(nfr, pol, "TR-060", "MEDIUM");
}
