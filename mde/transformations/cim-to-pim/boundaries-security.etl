/** Maps boundaries security model elements and supporting relationships. */
import "lib/common.eol";
import "lib/mapping.eol";
import "lib/trace-readiness.eol";
import "lib/pim-builders.eol";

/** Computes capability in bounded context. */
operation capabilityInBoundedContext(cap : CIMORG!BusinessCapability) {
  if (cachedContextForCapability(cap).isDefined()) {
    return true;
  }
  return CIMORG!BoundedContextCandidate.all.exists(bc | bc.capabilities.includes(cap));
}

/** Derives infer external protocol family. */
operation inferExternalProtocolFamily(es : CIMORG!ExternalSystem) : String {
  var evidence = firstText(es.businessPurpose, firstText(es.contractualSla, firstText(es.authenticationExpectation, es.summary))).toLowerCase();
  if (evidence.contains("http") or evidence.contains("https") or evidence.contains("rest") or evidence.contains("api") or evidence.contains("webhook")) {
    return "HTTP";
  }
  if (evidence.contains("event") or evidence.contains("stream") or evidence.contains("message") or evidence.contains("queue")) {
    return "EVENT";
  }
  if (evidence.contains("file") or evidence.contains("sftp") or evidence.contains("ftp")) {
    return "FILE";
  }
  return "REVIEW_REQUIRED_PROTOCOL";
}

/** Creates ensure privileged principal permission. */
operation ensurePrivilegedPrincipalPermission(p : SECURITY!Principal, seed, permissionSummary : String) {
  if (not isTrue(p.privileged) or p.permissions.notEmpty()) {
    return;
  }

  var permission = new SECURITY!Permission;
  permission.id = newId("permission", p.id + "_privileged_access");
  permission.name = p.name + " Privileged Access Permission";
  permission.effect = PIMTYPES!PermissionEffect#ALLOW;
  permission.actionKind = PIMTYPES!PermissionActionKind#MANAGE;
  permission.action = "manage privileged business operations";
  permission.resource = firstText(permissionSummary, p.name + " governed business resources");
  permission.targetResource = p;
  permission.leastPrivilegeStatus = PIMTYPES!LeastPrivilegeStatus#CONFIRMED_LEAST_PRIVILEGE;
  permission.leastPrivilegeConfirmed = true;
  permission.leastPrivilegeRationale = "Derived from privileged CIM actor or role responsibility and kept provider-independent for downstream binding.";

  p.permissions.add(permission);
  traceGenerated(seed, permission, "TR-020", "MEDIUM");
}

rule BoundedContext2Service
  transform bc : CIMORG!BoundedContextCandidate
  to s : DEPLOY!ServerlessService {

  s.id = idFor("svc_ctx", bc);
  s.name = nameFor(bc, " Service");
  s.boundaryType = PIMTYPES!BoundaryType#BOUNDED_CONTEXT_BASED;
  s.responsibility = firstText(bc.languageBoundary, firstText(bc.summary, "Service boundary for " + bc.name));
  s.ownerTeam = bc.ownershipBoundary;
  s.businessCapabilityRef = collectionText(bc.capabilities);
  s.externallyExposed = bc.externalIntegrationBoundary;
  s.ownsData = bc.entities.notEmpty();

  pimRoot().services.add(s);
  traceGenerated(bc, s, "TR-010", "HIGH");
}

rule Capability2Service
  transform cap : CIMORG!BusinessCapability
  to s : DEPLOY!ServerlessService {

  guard : not capabilityInBoundedContext(cap)

  s.id = idFor("svc_cap", cap);
  s.name = nameFor(cap, " Service");
  s.boundaryType = PIMTYPES!BoundaryType#CAPABILITY_BASED;
  s.responsibility = cap.responsibility.orDefault("Realizes business capability " + cap.name);
  s.ownerTeam = cap.ownerName;
  s.businessCapabilityRef = cap.id;
  s.externallyExposed = cap.containsCommands.exists(c | c.userInitiated) or cap.containsQueries.exists(q | q.issuedBy.exists(a | isPublicActor(a)));
  s.ownsData = cap.managesEntities.notEmpty();

  pimRoot().services.add(s);
  traceGenerated(cap, s, "TR-010", "MEDIUM");
}

/** Transforms Ac elements into r2 Principal elements. */
rule Actor2Principal
  transform a : CIMORG!Actor
  to p : SECURITY!Principal {

  p.id = idFor("principal", a);
  p.name = a.name;
  p.principalKind = mapPrincipalKind(a.actorType);
  p.externalRef = a.externalId;
  p.privileged = a.playsRoles.exists(r | r.privileged);

  pimRoot().principals.add(p);
  traceGenerated(a, p, "TR-020", "MEDIUM");
  ensurePrivilegedPrincipalPermission(p, a, joinText(a.playsRoles.collect(r | r.businessPermissionSummary), ", "));

  if (hasText(a.authenticationExpectation)) {
    var idp = new SECURITY!IdentityProvider;
    idp.id = idFor("idp", a);
    idp.name = a.name + " Identity Provider";
    if (a.actorType.asString() = "EXTERNAL_SYSTEM") {
      idp.identityKind = PIMTYPES!IdentityKind#MACHINE_CLIENT;
    }
    else {
      idp.identityKind = PIMTYPES!IdentityKind#USER_DIRECTORY;
    }
    idp.federationRequired = a.trustLevel.asString().contains("EXTERNAL");
    idp.mfaRequired = a.authenticationExpectation.toLowerCase().contains("mfa");
    idp.tokenType = "TBD";
    idp.userAttributeRequirements = a.authorizationExpectation;
    idp.principals.add(p);
    pimRoot().identityProviders.add(idp);
    traceGenerated(a, idp, "TR-020", "MEDIUM");
  }
  else {
    if (a.actorType.asString() = "HUMAN" or a.actorType.asString() = "EXTERNAL_SYSTEM" or a.actorType.asString() = "EXTERNAL_ORGANIZATION") {
      manualDecision("TR-020", "Confirm authentication mechanism for actor '" + a.name + "'.", KERNEL!Severity#WARNING,
        a.issuesCommands.exists(c | c.authorizationRequired) or a.issuesQueries.exists(q | q.authorizationRequired), Sequence{a, p});
    }
  }
}

/** Transforms Role elements into Principal elements. */
rule Role2Principal
  transform r : CIMORG!Role
  to p : SECURITY!Principal {

  p.id = idFor("role_principal", r);
  p.name = r.name;
  p.principalKind = PIMTYPES!PrincipalKind#ROLE;
  p.privileged = r.privileged;
  p.externalRef = r.externalId;

  pimRoot().principals.add(p);
  traceGenerated(r, p, "TR-020", "HIGH");
  ensurePrivilegedPrincipalPermission(p, r, r.businessPermissionSummary);

  if (hasText(r.businessPermissionSummary)) {
    var authz = new SECURITY!AuthorizationPolicy;
    authz.id = idFor("authz_role", r);
    authz.name = nameFor(r, " Authorization Policy");
    authz.policyScope = "role business permission summary";
    authz.productionRequired = isTrue(r.privileged);
    authz.authorizationRequired = true;
    authz.ruleExpression = r.businessPermissionSummary;
    authz.roleOrScopeRequired = firstText(r.name, r.id);
    authz.resourceLevelAuthorization = false;
    authz.allowedPrincipals.add(p);
    pimRoot().policies.add(authz);
    traceGenerated(r, authz, "TR-020", "MEDIUM");
    manualDecision("TR-020", "Translate business permissions for role '" + r.name + "' into explicit provider-independent Permission actions/resources only where action and target resource semantics are known.", KERNEL!Severity#WARNING, true, Sequence{r, p, authz});
  }
}

/** Transforms External System elements into Adapter elements. */
rule ExternalSystem2Adapter
  transform es : CIMORG!ExternalSystem
  to a : EXTERNAL!ExternalAdapter {

  a.id = idFor("adapter", es);
  a.name = nameFor(es, " Adapter");
  a.responsibility = es.businessPurpose.orDefault("Adapter for external system " + es.name);

  var ep = new EXTERNAL!ExternalEndpoint;
  ep.id = idFor("external_endpoint", es);
  ep.name = nameFor(es, " Endpoint");
  ep.externalSystemName = firstText(es.name, es.owningOrganization);
  ep.protocolFamily = inferExternalProtocolFamily(es);
  ep.endpointDescription = firstText(es.summary, es.description);
  ep.expectedSla = es.contractualSla;
  ep.credentialsRequired = es.trustLevel.asString() <> "TRUSTED_INTERNAL";
  ep.rateLimitedByProvider = false;
  ep.privateNetworkRequired = false;
  a.endpoint = ep;
  a.resilience = createDefaultResilience(a, "TR-030", false);
  a.observability = createDefaultObservability(a, "TR-030", true, true);

  if (ep.credentialsRequired) {
    var cred = new CONFIG!CredentialRequirement;
    cred.id = idFor("credential", es);
    cred.name = es.name + " Credential Requirement";
    cred.secretKind = PIMTYPES!SecretKind#OTHER;
    cred.purpose = "Credentials for " + es.name;
    cred.rotationRequired = true;
    cred.rotationFrequency = "every-90-days";
    cred.sharedAcrossEnvironments = false;
    a.credentials.add(cred);
  }

  pimRoot().externalEndpoints.add(ep);
  pimRoot().externalAdapters.add(a);
  traceGenerated(es, ep, "TR-030", "MEDIUM");
  traceGenerated(es, a, "TR-030", "MEDIUM");

  if (not hasText(es.contractualSla)) {
    manualDecision("TR-030", "Confirm SLA and failure handling for external system '" + es.name + "'.", KERNEL!Severity#WARNING, false, Sequence{es, a});
  }
  if ((ep.protocolFamily = "REVIEW_REQUIRED_PROTOCOL") or (ep.credentialsRequired and not hasText(es.authenticationExpectation))) {
    manualDecision("TR-030", "Confirm protocol, ExternalAdapter.endpoint, and credential type for external system '" + es.name + "'.", KERNEL!Severity#WARNING, true, Sequence{es, a, ep});
  }
}

post EnsureServiceExists {
  etlProfiler.mark("cim.ensureService.start");
  if (pimRoot().services.isEmpty()) {
    var c = cimRoot();
    var s = new DEPLOY!ServerlessService;
    s.id = "svc_default_review_required";
    s.name = c.domainName + " Service";
    s.boundaryType = PIMTYPES!BoundaryType#CAPABILITY_BASED;
    s.responsibility = "Placeholder service boundary because CIM has no bounded context or capability.";
    s.externallyExposed = true;
    s.ownsData = c.entities.notEmpty();
    s.lifecycleStatus = KERNEL!LifecycleStatus#INCOMPLETE;
    pimRoot().services.add(s);
    addTrace(c, s, "TR-010", KERNEL!TraceLinkType#DERIVES_FROM, "LOW");
    manualDecision("TR-010", "Define service boundaries using bounded contexts or business capabilities.", KERNEL!Severity#BLOCKER, true, Sequence{c, s});
  }
  etlProfiler.mark("cim.ensureService.end");
}
