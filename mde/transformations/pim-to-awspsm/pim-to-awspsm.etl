import "root-stage-stack.etl";
import "compute-api.etl";
import "data-messaging-events.etl";
import "workflow-security-config.etl";
import "contracts-external-policy.etl";

pre ValidatePimInput {
  if (PIM!PIMModel.all.isEmpty()) {
    throw "PIM to AWS PSM requires one PIMModel root.";
  }
}

post ResolveAndValidate {
  placeUncontainedAwsResources();
  resolveAwsRelationships();
  generateIamStatements();
  generateRelationshipViews();
  generateReadinessChecks();
  validatePsmConstraints();
}
