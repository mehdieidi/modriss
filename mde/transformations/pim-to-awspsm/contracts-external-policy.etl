rule Schema2StructuredDocument
  transform s : CONTRACTS!Schema
  to d : KERNEL!StructuredDocument {

  copyTraceable(s, d);
  d.id = idFor("schema_doc", s);
  d.name = firstText(s.name, "Schema") + "SchemaDocument";
  d.format = KERNEL!StructuredFormat#JSON;
  d.content = renderJsonSchema(s);
  d.externalUri = s.externalSchemaUri;
  createTrace(s, d, "Schema2StructuredDocument", "MEDIUM", KERNEL!TraceLinkType#MAPS_TO);
}

rule EventType2StructuredDocument
  transform e : CONTRACTS!EventType
  to d : KERNEL!StructuredDocument {

  copyTraceable(e, d);
  d.id = idFor("event_contract", e);
  d.name = firstText(e.semanticName, e.name) + "EventContract";
  d.format = KERNEL!StructuredFormat#JSON;
  d.content = eventContractJson(e);
  createTrace(e, d, "EventType2StructuredDocument", "MEDIUM", KERNEL!TraceLinkType#MAPS_TO);
}

rule ExternalAdapter2PsmMetadata
  transform a : EXTERNAL!ExternalAdapter
  to n : AWSPSMCORE!AwsNativeResource {

  copyAwsResource(a, n, "ExternalAdapter", "AWS::CloudFormation::CustomResource");
  n.id = idFor("external_adapter", a);
  n.cloudFormationType = "Custom::ExternalAdapterMetadata";
  n.properties.add(nativeText("ServiceToken", "REVIEW_REQUIRED_SERVICE_TOKEN", KERNEL!StructuredFormat#TEXT, true, false));
  var ep = endpointOf(a);
  if (ep.isDefined()) {
    n.properties.add(nativeText("ExternalSystemName", ep.externalSystemName, KERNEL!StructuredFormat#TEXT, false, false));
    n.properties.add(nativeText("ProtocolFamily", ep.protocolFamily, KERNEL!StructuredFormat#TEXT, false, false));
    n.properties.add(nativeText("EndpointDescription", ep.endpointDescription, KERNEL!StructuredFormat#TEXT, false, false));
  }
  else {
    manualDecision("EXTERNAL_ADAPTER_ENDPOINT_REQUIRED",
      "Model ExternalAdapter.endpoint for " + a.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{a, n},
      "Create an ExternalEndpoint and set ExternalAdapter.endpoint before AWS PSM generation.");
  }
  if (ep.isDefined() and isTrue(ep.credentialsRequired) and a.credentials.isEmpty()) {
    manualDecision("EXTERNAL_ADAPTER_CREDENTIALS_REQUIRED",
      "Model credentials for external adapter " + a.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{a, n},
      "Add CredentialRequirement/Secret entries or mark ExternalAdapter.endpoint.credentialsRequired=false.");
  }
  if (ep.isDefined() and isTrue(ep.privateNetworkRequired)) {
    manualDecision("EXTERNAL_ADAPTER_NETWORK_REQUIRED",
      "Define private networking for external adapter " + a.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{a, n},
      "Provide VPC/subnet/security group/private endpoint details for ExternalAdapter.endpoint.privateNetworkRequired.");
  }
  if (isHttpAdapter(a)) {
    createEventBridgeConnectionAndApiDestination(a);
  }
  createTrace(a, n, "ExternalAdapter2PsmMetadata", "MEDIUM", KERNEL!TraceLinkType#MAPS_TO);
}

rule AlertPolicy2CloudWatchAlarm
  transform a : POLICY!AlertPolicy
  to alarm : AWSPSMOBSERVABILITY!CloudWatchAlarm {

  copyAwsResource(a, alarm, "Alarm", "AWS::CloudWatch::Alarm");
  alarm.id = idFor("alarm", a);
  alarm.alarmName = alarm.physicalName;
  alarm.alarmDescription = firstText(a.summary, a.condition);
  alarm.namespace = inferMetricNamespace(a);
  alarm.metricName = firstText(a.metricName, "Errors");
  alarm.statistic = "Sum";
  alarm.period = 60;
  alarm.evaluationPeriods = positiveOr(a.evaluationPeriods, 1);
  alarm.datapointsToAlarm = alarm.evaluationPeriods;
  alarm.threshold = parseThreshold(a.threshold);
  alarm.comparisonOperator = parseComparison(a.condition);
  alarm.treatMissingData = "notBreaching";
  if (not hasText(a.threshold)) {
    manualDecision("ALARM_THRESHOLD_REQUIRED",
      "Provide threshold for alert policy " + a.name + ".",
      KERNEL!Severity#WARNING, false, Sequence{a, alarm},
      "Set AlertPolicy.threshold to a numeric CloudWatch threshold.");
  }
  createTrace(a, alarm, "AlertPolicy2CloudWatchAlarm", "MEDIUM", KERNEL!TraceLinkType#OBSERVES);
}

operation renderJsonSchema(s) {
  return schemaToJsonSchema(s);
}

operation eventContractJson(e) {
  return "{ \"semanticName\": \"" + escapeJson(e.semanticName) +
    "\", \"version\": \"" + escapeJson(e.version) +
    "\", \"sourceDomain\": \"" + escapeJson(e.sourceDomain) +
    "\", \"subjectExpression\": \"" + escapeJson(e.subjectExpression) +
    "\", \"orderingKey\": \"" + escapeJson(e.orderingKey) +
    "\", \"schema\": \"" + escapeJson(e.schema.name) + "\" }";
}

operation applyFunctionPolicies(f, l) {
  applyObservability(f, l);
  applySecurityPolicies(f, l);
  if (f.observability.isDefined() and isTrue(f.observability.alarmsEnabled)) {
    createLambdaAlarm(f, l, "Errors", "Errors", 1.0d);
  }
  if (f.resilience.isDefined() and isTrue(f.resilience.deadLetterRequired)) {
    manualDecision("LAMBDA_DLQ_TARGET_REQUIRED",
      "Choose Lambda dead-letter target for " + f.name + ".",
      KERNEL!Severity#WARNING, isProductionRoot(), Sequence{f, l},
      "Connect a PIM dead-letter channel or EventInvokeConfig destination.");
  }
}

operation applyIdempotency(f, l) {
  if (isTrue(f.requiresIdempotency) or isTrue(f.writesState)) {
    if (f.idempotency.isUndefined() or not hasText(f.idempotency.keySource)) {
      manualDecision("IDEMPOTENCY_KEY_REQUIRED",
        "Choose idempotency key source for state-changing function " + f.name + ".",
        KERNEL!Severity#ERROR, isProductionRoot(), Sequence{f, l},
        "Set Function.idempotency.keySource or FunctionContract.idempotencyKeyField.");
    }
    else {
      l.metadata.add(nativeText("Idempotency", "{ \"keySource\": \"" + escapeJson(f.idempotency.keySource) + "\" }", KERNEL!StructuredFormat#JSON, false, false));
    }
  }
}

operation applyDataProtectionPolicies(source, resource) {
  for (p in source.dataProtectionPolicies) {
    if (isTrue(p.maskingRequired) or isTrue(p.tokenizationRequired)) {
      manualDecision("DATA_PROTECTION_RUNTIME_DESIGN",
        "Define masking/tokenization implementation for " + source.name + ".",
        KERNEL!Severity#ERROR, isProductionRoot(), Sequence{source, resource},
        "AWS resource encryption is generated, but application-level protection needs implementation.");
    }
    if (hasText(p.residencyRequirement)) {
      manualDecision("AWS_REGION_REQUIRED",
        "Confirm region/account controls for residency requirement " + p.residencyRequirement + " on " + source.name + ".",
        KERNEL!Severity#ERROR, isProductionRoot(), Sequence{source, resource},
        "Select AWS region/account strategy that satisfies the residency requirement.");
    }
  }
}

operation applyObservability(source, resource) {
  var obs = null;
  if (source.eClass().getEStructuralFeature("observability").isDefined()) {
    obs = source.eGet(source.eClass().getEStructuralFeature("observability"));
  }
  if (obs.isUndefined()) {
    return;
  }
  if (isTrue(obs.dashboardRequired)) {
    var dash = new AWSPSMOBSERVABILITY!CloudWatchDashboard;
    copyAwsResource(source, dash, "Dashboard", "AWS::CloudWatch::Dashboard");
    dash.id = generatedId("dashboard", source, "observability");
    dash.dashboardName = physicalName(source, "dashboard", defaultStage());
    dash.dashboardBodyJson = "{ \"widgets\": [ { \"type\": \"metric\", \"properties\": { \"title\": \"" + escapeJson(source.name) + "\", \"metrics\": [] } } ] }";
  }
  for (metric in obs.metrics) {
    if (resource.eClass().getName() = "CloudWatchLogGroup") {
      var mf = new AWSPSMOBSERVABILITY!CloudWatchMetricFilter;
      copyAwsResource(metric, mf, "MetricFilter", "AWS::Logs::MetricFilter");
      mf.id = generatedId("metric_filter", metric, source.name);
      mf.filterPattern = "{$.metric = \"" + escapeJson(metric.metricName) + "\"}";
      mf.metricTransformationsJson = "{ \"MetricName\": \"" + escapeJson(metric.metricName) + "\", \"MetricNamespace\": \"Modless/" + escapeJson(rootName()) + "\", \"MetricValue\": \"1\" }";
      mf.logGroup = resource;
    }
    else {
      resource.metadata.add(nativeText("Metric:" + metric.metricName, metric.unit + "/" + metric.statistic, KERNEL!StructuredFormat#TEXT, false, false));
    }
  }
  for (alert in obs.alerts) {
    createPolicyAlarm(source, resource, alert);
  }
  for (slo in obs.slos) {
    resource.metadata.add(nativeText("SLO:" + slo.objectiveName, slo.metric + "=" + slo.target + " over " + slo.measurementWindow, KERNEL!StructuredFormat#TEXT, false, false));
  }
}

operation createPolicyAlarm(source, resource, alert) {
  var alarm = new AWSPSMOBSERVABILITY!CloudWatchAlarm;
  copyAwsResource(alert, alarm, "Alarm", "AWS::CloudWatch::Alarm");
  alarm.id = generatedId("alarm", alert, source.name);
  alarm.alarmName = physicalName(alert, "alarm", defaultStage());
  alarm.alarmDescription = firstText(alert.summary, alert.condition);
  alarm.namespace = inferMetricNamespace(alert);
  alarm.metricName = firstText(alert.metricName, "Errors");
  alarm.statistic = "Sum";
  alarm.period = 60;
  alarm.evaluationPeriods = positiveOr(alert.evaluationPeriods, 1);
  alarm.datapointsToAlarm = alarm.evaluationPeriods;
  alarm.threshold = parseThreshold(alert.threshold);
  alarm.comparisonOperator = parseComparison(alert.condition);
  alarm.treatMissingData = "notBreaching";
  alarm.monitoredResource = resource;
}

operation applySecurityPolicies(source, resource) {
  for (p in source.securityPolicies) {
    if (isTrue(p.encryptionAtRestRequired)) {
      resource.metadata.add(nativeText("EncryptionAtRestRequired", "true", KERNEL!StructuredFormat#TEXT, true, false));
    }
    if (isTrue(p.auditRequired)) {
      resource.metadata.add(nativeText("AuditRequired", "true", KERNEL!StructuredFormat#TEXT, true, false));
    }
    if (isTrue(p.authenticationRequired) and resource.eClass().getName() = "AwsLambdaFunction" and not isTrue(source.publicEntryPoint)) {
      resource.metadata.add(nativeText("AuthenticationRequired", "true", KERNEL!StructuredFormat#TEXT, true, false));
    }
  }
}

operation createLambdaAlarm(f, l, suffix : String, metric : String, threshold : Real) {
  var a = new AWSPSMOBSERVABILITY!CloudWatchAlarm;
  copyAwsResource(f, a, "Alarm" + suffix, "AWS::CloudWatch::Alarm");
  a.id = generatedId("alarm", f, suffix);
  a.alarmName = l.functionName + "-" + suffix;
  a.alarmDescription = "Generated alarm for " + f.name + " " + metric;
  a.namespace = "AWS/Lambda";
  a.metricName = metric;
  a.statistic = "Sum";
  a.period = 60;
  a.evaluationPeriods = 1;
  a.datapointsToAlarm = 1;
  a.threshold = threshold;
  a.comparisonOperator = AWSPSMENUMS!CloudWatchComparisonOperator#GREATER_THAN_OR_EQUAL_TO_THRESHOLD;
  a.treatMissingData = "notBreaching";
  a.monitoredResource = l;
  return a;
}

operation isHttpAdapter(a) {
  var ep = endpointOf(a);
  if (ep.isUndefined()) {
    return false;
  }
  return asText(ep.protocolFamily).toLowerCase().contains("http") or asText(ep.protocolFamily).toLowerCase().contains("rest") or
    asText(ep.endpointUri).toLowerCase().startsWith("http") or asText(ep.endpointDescription).toLowerCase().startsWith("http");
}

operation createEventBridgeConnectionAndApiDestination(a) {
  var conn = new AWSPSMEVENTS!EventBridgeConnection;
  copyAwsResource(a, conn, "Connection", "AWS::Events::Connection");
  conn.id = generatedId("eventbridge_connection", a, "connection");
  conn.connectionName = physicalName(a, "connection", defaultStage());
  conn.authorizationType = inferConnectionAuthType(a);
  conn.authParameters = createConnectionAuthParameters(a, conn.authorizationType);

  var dest = new AWSPSMEVENTS!EventBridgeApiDestination;
  copyAwsResource(a, dest, "ApiDestination", "AWS::Events::ApiDestination");
  dest.id = generatedId("eventbridge_api_destination", a, "destination");
  dest.destinationName = physicalName(a, "api-destination", defaultStage());
  var ep = endpointOf(a);
  dest.invocationEndpoint = firstText(ep.endpointUri, endpointFromDescription(ep.endpointDescription));
  dest.httpMethod = AWSPSMENUMS!EventBridgeHttpMethod#POST;
  if (ep.isDefined() and isTrue(ep.rateLimitedByProvider)) {
    dest.invocationRateLimitPerSecond = 10;
  }
  else {
    dest.invocationRateLimitPerSecond = 300;
  }
  dest.connection = conn;
  if (not hasText(dest.invocationEndpoint)) {
    manualDecision("API_DESTINATION_ENDPOINT_REQUIRED",
      "Provide HTTPS endpoint for external adapter " + a.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{a, dest},
      "Set ExternalAdapter.endpoint.endpointUri to an HTTPS endpoint or model an adapter Lambda.");
  }
}

operation endpointOf(a) {
  if (a.isUndefined() or a.endpoint.isUndefined()) {
    return null;
  }
  return a.endpoint;
}

operation createConnectionAuthParameters(a, authType) {
  if (authType = AWSPSMENUMS!EventBridgeConnectionAuthorizationType#BASIC) {
    var b = new AWSPSMEVENTS!EventBridgeBasicAuthParameters;
    b.id = generatedId("eventbridge_auth", a, "basic");
    b.name = a.name + " basic auth";
    b.username = credentialSecretValue(a, "username");
    b.password = credentialSecretValue(a, "password");
    return b;
  }
  if (authType = AWSPSMENUMS!EventBridgeConnectionAuthorizationType#OAUTH_CLIENT_CREDENTIALS) {
    var o = new AWSPSMEVENTS!EventBridgeOAuthParameters;
    o.id = generatedId("eventbridge_auth", a, "oauth");
    o.name = a.name + " OAuth auth";
    var ep = endpointOf(a);
    var authorizationEndpointText = "";
    if (ep.isDefined()) {
      authorizationEndpointText = firstText(ep.authorizationEndpoint, ep.endpointUri);
    }
    o.authorizationEndpoint = authorizationEndpointText;
    if (not hasText(o.authorizationEndpoint)) {
      o.authorizationEndpoint = "REVIEW_REQUIRED_AUTHORIZATION_ENDPOINT";
      manualDecision("EVENTBRIDGE_CONNECTION_AUTH_ENDPOINT_REQUIRED",
        "Provide OAuth authorization endpoint for EventBridge connection generated from adapter " + a.name + ".",
        KERNEL!Severity#ERROR, isProductionRoot(), Sequence{a},
        "Set ExternalAdapter.endpoint.authorizationEndpoint for OAuth client credentials.");
    }
    o.httpMethod = AWSPSMENUMS!EventBridgeHttpMethod#POST;
    o.clientId = credentialSecretValue(a, "client_id");
    o.clientSecret = credentialSecretValue(a, "client_secret");
    return o;
  }
  var k = new AWSPSMEVENTS!EventBridgeApiKeyAuthParameters;
  k.id = generatedId("eventbridge_auth", a, "api_key");
  k.name = a.name + " API key auth";
  k.apiKeyName = firstCredentialName(a);
  k.apiKeyValue = credentialSecretValue(a, "api_key");
  return k;
}

operation credentialSecretValue(a, purpose : String) {
  return secretReferenceValue(credentialReferenceName(a, purpose));
}

operation credentialReferenceName(a, purpose : String) {
  var credential = a.credentials.selectOne(c |
    asText(c.purpose).toLowerCase().contains(purpose.replace("_", " ")) or
    asText(c.name).toLowerCase().contains(purpose.replace("_", " ")) or
    asText(c.name).toLowerCase().contains(purpose));
  if (credential.isUndefined() and a.credentials.notEmpty()) {
    credential = a.credentials.first();
  }
  if (credential.isDefined()) {
    return firstText(credential.externalId, "/" + kebab(rootName()) + "/external/" + kebab(a.name) + "/" + kebab(purpose));
  }
  manualDecision("EVENTBRIDGE_CONNECTION_CREDENTIAL_REQUIRED",
    "Provide " + purpose + " credential reference for EventBridge connection generated from adapter " + a.name + ".",
    KERNEL!Severity#ERROR, isProductionRoot(), Sequence{a},
    "Add ExternalAdapter.credentials entries whose externalId points to a Secrets Manager secret name/ARN, or mark ExternalAdapter.endpoint.credentialsRequired=false.");
  return "REVIEW_REQUIRED_" + slug(firstText(a.name, a.id) + "_" + purpose).toUpperCase();
}

operation firstCredentialName(a) {
  if (a.credentials.notEmpty()) {
    return firstText(a.credentials.first().name, a.credentials.first().purpose);
  }
  return "REVIEW_REQUIRED_CREDENTIAL_NAME";
}

operation firstCredentialValue(a) {
  if (a.credentials.notEmpty()) {
    return firstText(a.credentials.first().externalId, a.credentials.first().name);
  }
  manualDecision("EVENTBRIDGE_CONNECTION_CREDENTIAL_REQUIRED",
    "Provide credentials for EventBridge connection generated from adapter " + a.name + ".",
    KERNEL!Severity#ERROR, isProductionRoot(), Sequence{a},
    "Add ExternalAdapter.credentials entries or mark ExternalAdapter.endpoint.credentialsRequired=false.");
  return "REVIEW_REQUIRED_SECRET_VALUE";
}

operation inferConnectionAuthType(a) {
  if (a.credentials.exists(c | c.secretKind = PIMTYPES!SecretKind#PASSWORD)) {
    return AWSPSMENUMS!EventBridgeConnectionAuthorizationType#BASIC;
  }
  if (a.credentials.exists(c | c.secretKind = PIMTYPES!SecretKind#TOKEN)) {
    return AWSPSMENUMS!EventBridgeConnectionAuthorizationType#OAUTH_CLIENT_CREDENTIALS;
  }
  return AWSPSMENUMS!EventBridgeConnectionAuthorizationType#API_KEY;
}

operation endpointFromDescription(text) {
  if (not hasText(text)) {
    return "";
  }
  var trimmed = text.trim();
  if (trimmed.toLowerCase().startsWith("http")) {
    return trimmed;
  }
  return "";
}

operation inferMetricNamespace(a) {
  if (asText(a.metricName).toLowerCase().contains("latency") or asText(a.metricName).toLowerCase().contains("4xx") or asText(a.metricName).toLowerCase().contains("5xx")) {
    return "AWS/ApiGateway";
  }
  return "AWS/Lambda";
}

operation parseComparison(condition) {
  var c = asText(condition).toLowerCase();
  if (c.contains("<=")) {
    return AWSPSMENUMS!CloudWatchComparisonOperator#LESS_THAN_OR_EQUAL_TO_THRESHOLD;
  }
  if (c.contains("<")) {
    return AWSPSMENUMS!CloudWatchComparisonOperator#LESS_THAN_THRESHOLD;
  }
  if (c.contains(">=")) {
    return AWSPSMENUMS!CloudWatchComparisonOperator#GREATER_THAN_OR_EQUAL_TO_THRESHOLD;
  }
  return AWSPSMENUMS!CloudWatchComparisonOperator#GREATER_THAN_THRESHOLD;
}

operation parseThreshold(text) {
  if (hasText(text) and text.matches("^-?[0-9]+(\\.[0-9]+)?$")) {
    return text.asDouble();
  }
  if (hasText(text)) {
    manualDecision("ALARM_THRESHOLD_NUMERIC_REQUIRED",
      "Provide a numeric CloudWatch alarm threshold instead of '" + text + "'.",
      KERNEL!Severity#WARNING, false, Sequence{},
      "Set AlertPolicy.threshold to a plain number such as 5 or 200.5.");
  }
  return 1.0d;
}
