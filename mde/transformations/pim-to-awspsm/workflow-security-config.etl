/** Maps workflow security config model elements and supporting relationships. */
rule Workflow2StepFunctionStateMachine
  transform w : WORKFLOW!Workflow
  to sm : AWSPSMWORKFLOW!StepFunctionStateMachine {

  guard : w.steps.notEmpty()

  copyAwsResource(w, sm, "StateMachine", "AWS::Serverless::StateMachine");
  sm.id = idFor("state_machine", w);
  sm.stateMachineName = sm.physicalName;
  if (isTrue(w.expressLowLatencyRequired)) {
    sm.stateMachineType = AWSPSMENUMS!StepFunctionType#EXPRESS;
  }
  else {
    sm.stateMachineType = AWSPSMENUMS!StepFunctionType#STANDARD;
  }
  sm.publishAlias = isProductionRoot();
  if (isProductionRoot()) {
    sm.aliasName = "live";
  }
  else {
    sm.aliasName = "";
  }
  sm.role = createStateMachineRole(w);
  sm.aslDocument = createAslDocument(w);
  sm.logging = createStepFunctionLogging(w, sm);
  sm.tracing = createStepFunctionTracing(w);
  if (isTrue(w.humanApprovalRequired)) {
    manualDecision("WORKFLOW_HUMAN_APPROVAL_DESIGN",
      "Design human approval callback/tasks for workflow " + w.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{w, sm},
      "Model callback task tokens, approval UI, and escalation policy.");
  }
  if (isTrue(w.compensationRequired)) {
    sm.metadata.add(nativeText("CompensationRequired", "true", KERNEL!StructuredFormat#TEXT, true, false));
  }
  createTrace(w, sm, "Workflow2StepFunctionStateMachine", "HIGH", KERNEL!TraceLinkType#REALIZES);
}

/** Resolves workflow task references after all PIM resources have been transformed. */
operation resolveWorkflowTaskTargets() {
  for (w in WORKFLOW!Workflow.all) {
    var sm = awsEquivalent(w);
    if (sm.isUndefined() or sm.aslDocument.isUndefined()) {
      continue;
    }
    for (ws in w.steps) {
      var targetStateName = ws.name;
      if (ws.isKindOf(PIM!ChoiceStep) and ws.invokesFunction.isDefined()) {
        targetStateName = ws.name + " Evaluator";
      }
      var outState = sm.aslDocument.states.selectOne(s | s.name = targetStateName);
      if (outState.isUndefined() or not outState.isKindOf(AWSPSMWORKFLOW!AslTaskState)) {
        continue;
      }
      if (ws.invokesFunction.isDefined()) {
        var functionResource = awsEquivalent(ws.invokesFunction);
        if (functionResource.isDefined()) {
          outState.invokedResource = functionResource;
          outState.resource = "";
        }
        else {
          manualDecision("WORKFLOW_TASK_TARGET_REQUIRED",
            "Resolve the AWS Lambda target for workflow task " + ws.name + ".",
            KERNEL!Severity#BLOCKER, true, Sequence{w, ws},
            "Ensure TaskStep.invokesFunction resolves to a generated AwsLambdaFunction before artifact generation.");
        }
      }
      else if (ws.nestedWorkflow.isDefined()) {
        var nestedResource = awsEquivalent(ws.nestedWorkflow);
        if (nestedResource.isDefined()) {
          outState.resource = "arn:aws:states:::states:startExecution.sync";
          outState.invokedResource = nestedResource;
          outState.argumentsJson = "{ \"StateMachineArn\": \"${" + nestedResource.logicalId + "Arn}\" }";
        }
        else {
          manualDecision("WORKFLOW_NESTED_TARGET_REQUIRED",
            "Resolve the nested state machine target for workflow task " + ws.name + ".",
            KERNEL!Severity#BLOCKER, true, Sequence{w, ws, ws.nestedWorkflow},
            "Ensure TaskStep.nestedWorkflow resolves to a generated StepFunctionStateMachine before artifact generation.");
        }
      }
      else if (ws.invokesAdapter.isDefined()) {
        manualDecision("WORKFLOW_EXTERNAL_ADAPTER_IMPLEMENTATION_REQUIRED",
          "Choose an executable AWS integration for external workflow task " + ws.name + ".",
          KERNEL!Severity#BLOCKER, true, Sequence{w, ws, ws.invokesAdapter},
          "Implement the adapter as a Lambda task, an AWS service integration, or a callback-token design; do not deploy the generated placeholder Pass state as the business operation.");
      }
    }
    sm.aslDocument.content = renderAsl(sm.aslDocument);
  }
}

/** Transforms Identity Provider elements into Cognito User Pool elements. */
rule IdentityProvider2CognitoUserPool
  transform idp : SECURITY!IdentityProvider
  to pool : AWSPSMIDENTITY!CognitoUserPool {

  copyAwsResource(idp, pool, "UserPool", "AWS::Cognito::UserPool");
  pool.id = idFor("cognito_pool", idp);
  pool.userPoolName = pool.physicalName;
  if (isTrue(idp.mfaRequired)) {
    pool.mfaConfiguration = AWSPSMENUMS!CognitoMfaConfiguration#ON;
    pool.mfaDecision = AWSPSMENUMS!Decision#REQUIRED;
  }
  else {
    pool.mfaConfiguration = AWSPSMENUMS!CognitoMfaConfiguration#OPTIONAL;
    pool.mfaDecision = AWSPSMENUMS!Decision#NEEDS_REVIEW;
  }
  pool.mfaRationale = "Derived from PIM IdentityProvider.mfaRequired.";
  pool.usernameAttributes.add("email");
  pool.autoVerifiedAttributes.add("email");
  pool.policiesJson = "{ \"PasswordPolicy\": { \"MinimumLength\": 12, \"RequireUppercase\": true, \"RequireLowercase\": true, \"RequireNumbers\": true, \"RequireSymbols\": false } }";
  pool.deletionProtection = isProductionRoot();
  if (isTrue(idp.federationRequired) and not hasText(idp.tokenValidationRules)) {
    manualDecision("COGNITO_FEDERATION_DETAILS_REQUIRED",
      "Provide federation details for identity provider " + idp.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{idp, pool},
      "Add issuer, client IDs, attribute mapping, callback/logout URLs, and supported IdPs.");
  }
  createTrace(idp, pool, "IdentityProvider2CognitoUserPool", "MEDIUM", KERNEL!TraceLinkType#REALIZES);
}

/** Transforms Principal elements into Iam Role elements. */
rule Principal2IamRole
  transform p : SECURITY!Principal
  to role : AWSPSMSECURITY!IamRole {

  guard : p.principalKind = PIMTYPES!PrincipalKind#SERVICE or p.principalKind = PIMTYPES!PrincipalKind#ROLE

  copyAwsResource(p, role, "PrincipalRole", "AWS::IAM::Role");
  role.id = idFor("principal_role", p);
  role.roleName = physicalName(p, "role", defaultStage());
  role.path = "/";
  role.maxSessionDuration = 3600;
  role.descriptionText = firstText(p.summary, "IAM role generated from PIM principal.");
  role.assumeRolePolicy = serviceAssumeRolePolicy(firstText(p.externalRef, "lambda.amazonaws.com"), p.id);
  if (p.permissions.notEmpty()) {
    var pol = new AWSPSMSECURITY!IamInlinePolicy;
    pol.id = generatedId("inline_policy", p, "permissions");
    pol.name = p.name + " permissions";
    pol.policyName = pascalCase(p.name) + "Policy";
    pol.document = policyDocument(p.id + "::permissions");
    for (perm in p.permissions) {
      var statementObj = permissionStatement(perm);
      if (statementObj.isDefined()) {
        pol.document.statements.add(statementObj);
      }
    }
    if (pol.document.statements.notEmpty()) {
      role.inlinePolicies.add(pol);
    }
    else {
      delete pol;
    }
  }
  createTrace(p, role, "Principal2IamRole", "MEDIUM", KERNEL!TraceLinkType#REALIZES);
}

/** Transforms Secret elements into Secrets Manager Secret elements. */
rule Secret2SecretsManagerSecret
  transform s : CONFIG!Secret
  to sec : AWSPSMSECURITY!SecretsManagerSecret {

  copyAwsResource(s, sec, "Secret", "AWS::SecretsManager::Secret");
  sec.id = idFor("secret", s);
  sec.secretName = sec.physicalName;
  sec.descriptionText = firstText(s.summary, "Secret reference generated from PIM.");
  if (isTrue(s.generatedReferenceOnly)) {
    sec.generateSecretStringJson = "{ \"GenerateStringKey\": \"value\", \"PasswordLength\": 32 }";
    manualDecision("EXTERNAL_SECRET_VALUE_REQUIRED",
      "Replace the generated placeholder value for external secret " + s.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{s, sec},
      "Set the deployed Secrets Manager secret value to the credential issued by the external system.");
  }
  else {
    sec.generateSecretStringJson = "{ \"GenerateStringKey\": \"value\", \"PasswordLength\": 32 }";
  }
  sec.rotationRequired = isTrue(s.rotationRequired);
  if (sec.rotationRequired) {
    var rot = new AWSPSMSECURITY!SecretRotationSchedule;
    copyAwsResource(s, rot, "SecretRotation", "AWS::SecretsManager::RotationSchedule");
    rot.id = generatedId("secret_rotation", s, "schedule");
    rot.rotationRulesJson = "{ \"AutomaticallyAfterDays\": " + rotationDays(s.rotationFrequency).asString() + " }";
    rot.secret = sec;
    sec.rotationSchedule = rot;
    manualDecision("SECRET_ROTATION_LAMBDA_REQUIRED",
      "Provide rotation Lambda for secret " + s.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{s, sec},
      "Model or select a Lambda that implements Secrets Manager rotation.");
  }
  createTrace(s, sec, "Secret2SecretsManagerSecret", "HIGH", KERNEL!TraceLinkType#REALIZES);
}

/** Transforms Configuration Set elements into Cfn Parameter Carrier elements. */
rule ConfigurationSet2CfnParameterCarrier
  transform c : CONFIG!ConfigurationSet
  to doc : KERNEL!StructuredDocument {

  copyTraceable(c, doc);
  doc.id = idFor("configuration_doc", c);
  doc.name = c.name + " Configuration Metadata";
  doc.format = KERNEL!StructuredFormat#JSON;
  doc.content = configurationJson(c);
  createTrace(c, doc, "ConfigurationSet2CfnParameterCarrier", "MEDIUM", KERNEL!TraceLinkType#MAPS_TO);
}

/** Transforms Config Parameter elements into Cfn Parameter elements. */
rule ConfigParameter2CfnParameter
  transform p : CONFIG!ConfigParameter
  to c : AWSPSMCORE!CfnParameter {

  guard : not isTrue(p.secret)

  copyTraceable(p, c);
  c.id = idFor("cfn_parameter", p);
  c.name = firstText(p.name, "Parameter");
  c.parameterName = pascalCase(firstText(p.name, p.id));
  c.type = firstText(p.valueKind, "String");
  if (hasText(p.defaultValue)) {
    c.defaultValue = literalValue(p.defaultValue, false);
  }
  c.allowedPattern = p.validationPattern;
  c.parameterDescription = firstText(p.summary, p.description);
  c.noEcho = false;
  createTrace(p, c, "ConfigParameter2CfnParameter", "HIGH", KERNEL!TraceLinkType#MAPS_TO);
}

/** Transforms Secret Config Parameter elements into Ssm Parameter elements. */
rule SecretConfigParameter2SsmParameter
  transform p : CONFIG!ConfigParameter
  to s : AWSPSMSECURITY!SsmParameter {

  guard : isTrue(p.secret)

  copyAwsResource(p, s, "Parameter", "AWS::SSM::Parameter");
  s.id = idFor("ssm_parameter", p);
  s.parameterName = "/" + kebab(rootName()) + "/" + kebab(firstText(p.name, p.id));
  s.parameterType = AWSPSMENUMS!ParameterType#SECURE_STRING;
  s.tier = AWSPSMENUMS!SsmParameterTier#STANDARD;
  s.dataType = "text";
  s.allowedPattern = p.validationPattern;
  s.descriptionText = firstText(p.summary, p.description);
  s.value = ssmSecureReferenceValue(firstText(p.defaultValue, ""));
  if (not hasText(p.defaultValue)) {
    manualDecision("SECRET_PARAMETER_VALUE_REQUIRED",
      "Provide secure value source for secret configuration parameter " + p.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{p, s},
      "Set ConfigParameter.defaultValue to an SSM secure parameter path/version or wire the value from a Secrets Manager/SSM deployment secret.");
  }
  createTrace(p, s, "SecretConfigParameter2SsmParameter", "HIGH", KERNEL!TraceLinkType#MAPS_TO);
}

/** Creates create asl document. */
operation createAslDocument(w) {
  var d = new AWSPSMWORKFLOW!AslDocument;
  d.id = generatedId("asl", w, "document");
  d.name = w.name + " ASL";
  d.format = KERNEL!StructuredFormat#ASL_JSON;
  d.content = "{}";
  d.comment = firstText(w.summary, "Generated from PIM workflow " + w.name);
  // Keep JSONPath as the document default because the generated input/output
  // path fields are JSONPath fields. Choice states opt into JSONata below.
  d.queryLanguage = "JSONPath";
  if (w.steps.isEmpty()) {
    manualDecision("WORKFLOW_STEPS_REQUIRED",
      "Workflow " + w.name + " has no steps.",
      KERNEL!Severity#BLOCKER, true, Sequence{w},
      "Add at least one StartStep, workflow steps, and SuccessEndStep or FailureEndStep before AWS PSM generation.");
    d.startAt = "Start";
    return d;
  }
  var startStep = w.steps.select(s | s.isKindOf(PIM!StartStep)).sortBy(s | s.orderIndex).first();
  if (startStep.isDefined()) {
    d.startAt = startStep.name;
  }
  else {
    d.startAt = firstText(w.steps.first().name, "Start");
  }
  var stateByPimId = new Map;
  var entryByPimId = new Map;
  for (ws in w.steps) {
    var aslState = createAslState(w, ws);
    d.states.add(aslState);
    stateByPimId.put(cacheKeyFor(ws), aslState);
    var entryState = aslState;
    if (ws.isKindOf(PIM!ChoiceStep) and ws.invokesFunction.isDefined()) {
      var evaluator = createChoiceEvaluatorState(w, ws);
      evaluator.nextState = aslState;
      evaluator.nextStateName = aslState.stateName;
      d.states.add(evaluator);
      entryState = evaluator;
      manualDecision("WORKFLOW_CHOICE_OUTCOME_MAPPING_REQUIRED",
        "Define how decision evaluator outcomes select branches for workflow choice " + ws.name + ".",
        KERNEL!Severity#BLOCKER, true, Sequence{w, ws, ws.invokesFunction},
        "Add an explicit mapping from the evaluator output outcome to each WorkflowTransition, or explicitly remove the evaluator and make the reviewed input predicate authoritative before deployment.");
    }
    entryByPimId.put(cacheKeyFor(ws), entryState);
  }
  if (startStep.isDefined()) {
    var startEntry = entryByPimId.get(cacheKeyFor(startStep));
    if (startEntry.isDefined()) {
      d.startAt = startEntry.stateName;
    }
  }
  completeAslStateTransitions(w, stateByPimId, entryByPimId);
  d.content = renderAsl(d);
  return d;
}

/** Creates the Lambda evaluator task that supplies input to a function-backed choice. */
operation createChoiceEvaluatorState(w, ws) {
  var st = new AWSPSMWORKFLOW!AslTaskState;
  st.id = generatedId("asl_choice_evaluator", ws, "state");
  st.name = ws.name + " Evaluator";
  st.stateName = ws.name + " Evaluator";
  st.resource = "";
  // The evaluator result must not replace the business input consumed by the
  // following Choice. This is valid because evaluator Tasks use JSONPath,
  // inherited from the state-machine default.
  st.resultPath = "$.decisionEvaluation";
  st.timeoutSeconds = ws.timeoutSeconds;
  st.inputPath = aslJsonPathOrRoot(ws.inputMapping);
  // A ChoiceStep output mapping belongs to the workflow-level decision, not
  // to the evaluator invocation. Filtering here could remove `outcome` before
  // ResultPath stores the evaluator result.
  st.outputPath = "$";
  st.end = false;
  return st;
}

/** Creates create asl state. */
operation createAslState(w, ws) {
  var st = newAslStateForStep(ws);
  st.id = generatedId("asl_state", ws, "state");
  st.name = ws.name;
  st.stateName = firstText(ws.name, "State");
  st.timeoutSeconds = ws.timeoutSeconds;
  st.inputPath = aslJsonPathOrRoot(ws.inputMapping);
  st.outputPath = aslJsonPathOrRoot(ws.outputMapping);
  if (ws.isKindOf(PIM!TaskStep)
      and (ws.invokesFunction.isDefined() or ws.nestedWorkflow.isDefined())) {
    if (hasExplicitWorkflowOutputMapping(ws.outputMapping)) {
      st.resultPath = ws.outputMapping;
    }
    else {
      // AWS defaults ResultPath to "$", which would replace the incoming workflow
      // context with the step result. Preserve the context until a concrete PIM
      // output mapping is supplied by the reviewer.
      st.resultPath = defaultWorkflowResultPath(ws);
      manualDecision("WORKFLOW_STEP_RESULT_MAPPING_REQUIRED",
        "Define how the output of workflow task " + ws.name + " is merged into workflow context.",
        KERNEL!Severity#BLOCKER, true, Sequence{w, ws},
        "Set WorkflowStep.outputMapping to an explicit JSONPath and verify downstream steps; the draft stores the unmodeled result under " + st.resultPath + ".");
    }
  }
  if (st.isKindOf(AWSPSMWORKFLOW!AslChoiceState)) {
    st.queryLanguage = "JSONata";
    // InputPath/OutputPath are JSONPath-only and must not be emitted on a
    // JSONata Choice state.
    st.inputPath = "";
    st.outputPath = "";
  }
  st.end = ws.isKindOf(PIM!SuccessEndStep) or ws.isKindOf(PIM!FailureEndStep);
  if (st.isKindOf(AWSPSMWORKFLOW!AslWaitState)) {
    st.timeoutSeconds = waitSeconds(ws.conditionExpression);
    if (not isSupportedWaitDuration(ws.conditionExpression, st.timeoutSeconds)) {
      manualDecision("WORKFLOW_WAIT_SEMANTICS_REQUIRED",
        "Define wait duration or callback semantics for workflow wait " + ws.name + ".",
        KERNEL!Severity#BLOCKER, true, Sequence{w, ws},
        "Set WaitStep.conditionExpression to a supported ISO-8601 duration from 0 to 99999999 seconds, or model an explicit callback/event completion design.");
    }
  }
    if (st.isKindOf(AWSPSMWORKFLOW!AslTaskState) and ws.invokesFunction.isDefined()) {
      st.resource = "";
    }
    else {
      if (st.isKindOf(AWSPSMWORKFLOW!AslTaskState) and ws.nestedWorkflow.isDefined()) {
        st.resource = "arn:aws:states:::states:startExecution.sync";
      }
      else {
        if (st.isKindOf(AWSPSMWORKFLOW!AslTaskState)) {
          var passState = new AWSPSMWORKFLOW!AslPassState;
          passState.id = st.id;
          passState.name = st.name;
          passState.stateName = st.stateName;
          passState.timeoutSeconds = st.timeoutSeconds;
          passState.inputPath = st.inputPath;
          passState.outputPath = st.outputPath;
          passState.end = st.end;
          delete st;
          st = passState;
          if (ws.invokesAdapter.isDefined()) {
            manualDecision("WORKFLOW_EXTERNAL_ADAPTER_IMPLEMENTATION_REQUIRED",
              "Choose an executable AWS integration for external workflow task " + ws.name + ".",
              KERNEL!Severity#BLOCKER, true, Sequence{w, ws, ws.invokesAdapter},
              "Implement the adapter as a Lambda task, an AWS service integration, or a callback-token design; do not deploy the generated placeholder Pass state as the business operation.");
          }
          else {
            manualDecision("WORKFLOW_TASK_TARGET_REQUIRED",
              "Provide an executable target for workflow task " + ws.name + ".",
              KERNEL!Severity#ERROR, isProductionRoot(), Sequence{w, ws},
              "Set TaskStep.invokesFunction or nestedWorkflow. The generated ASL uses a deployable Pass state until a target is modeled.");
          }
        }
      }
    }
  if (ws.retry.isDefined()) {
    st.retry.add(createAslRetry(ws.retry));
  }
  if (ws.isKindOf(PIM!ParallelStep)) {
    manualDecision("WORKFLOW_PARALLEL_BRANCH_DESIGN",
      "Define ASL branch details for parallel step " + ws.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{w, ws},
      "The PIM identifies a parallel step but does not carry full ASL branch structure.");
  }
  if (ws.isKindOf(PIM!MapStep)) {
    manualDecision("WORKFLOW_MAP_PROCESSOR_DESIGN",
      "Define ASL item processor details for map step " + ws.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{w, ws},
      "The PIM identifies a map step but does not carry full ASL item processor structure.");
  }
  return st;
}

/** Creates the concrete ASL state classifier corresponding to a PIM workflow step. */
operation newAslStateForStep(ws) {
  if (ws.isKindOf(PIM!TaskStep)) {
    return new AWSPSMWORKFLOW!AslTaskState;
  }
  if (ws.isKindOf(PIM!ChoiceStep)) {
    return new AWSPSMWORKFLOW!AslChoiceState;
  }
  if (ws.isKindOf(PIM!ParallelStep)) {
    return new AWSPSMWORKFLOW!AslParallelState;
  }
  if (ws.isKindOf(PIM!MapStep)) {
    return new AWSPSMWORKFLOW!AslMapState;
  }
  if (ws.isKindOf(PIM!WaitStep)) {
    return new AWSPSMWORKFLOW!AslWaitState;
  }
  if (ws.isKindOf(PIM!SuccessEndStep)) {
    return new AWSPSMWORKFLOW!AslSucceedState;
  }
  if (ws.isKindOf(PIM!FailureEndStep)) {
    return new AWSPSMWORKFLOW!AslFailState;
  }
  return new AWSPSMWORKFLOW!AslPassState;
}

/** Returns a valid JSONPath root when an upstream mapping is absent or still a placeholder. */
operation aslJsonPathOrRoot(mapping) {
  if (not hasText(mapping) or mapping = "TBD" or not mapping.startsWith("$")) {
    return "$";
  }
  return mapping;
}

/** Returns a stable per-step path for an output mapping that is still TBD. */
operation defaultWorkflowResultPath(ws) {
  return "$.stepResults.s" + asText(ws.id).replaceAll("[^A-Za-z0-9]", "");
}

/** Checks whether a workflow output mapping is explicit enough to honor directly. */
operation hasExplicitWorkflowOutputMapping(mapping) {
  return hasText(mapping) and mapping <> "TBD" and mapping.startsWith("$");
}

/** Computes complete asl state transitions. */
operation nextOrderedWorkflowStep(w, current) {
  var ordered = w.steps.sortBy(s | s.orderIndex);
  var found = false;
  for (candidate in ordered) {
    if (found) {
      return candidate;
    }
    if (candidate = current) {
      found = true;
    }
  }
  return null;
}

operation completeAslStateTransitions(w, stateByPimId, entryByPimId) {
  for (ws in w.steps) {
    var st = stateByPimId.get(cacheKeyFor(ws));
    var out = w.transitions.select(x | x.source = ws);
    if (st.isDefined() and st.isKindOf(AWSPSMWORKFLOW!AslChoiceState)) {
      var defaultTransitions = out.select(tr | isTrue(tr.defaultTransition));
      if (defaultTransitions.size() > 1) {
        manualDecision("WORKFLOW_CHOICE_DEFAULT_AMBIGUOUS",
          "Choose exactly one default path for workflow choice " + ws.name + ".",
          KERNEL!Severity#BLOCKER, true, Sequence{w, ws},
          "Mark exactly one outgoing WorkflowTransition as defaultTransition; AWS Step Functions supports one Choice Default target.");
      }
      else if (defaultTransitions.size() = 1) {
        var defaultTransition = defaultTransitions.first();
        var defaultState = entryByPimId.get(cacheKeyFor(defaultTransition.target));
        if (defaultState.isDefined()) {
          st.nextState = defaultState;
          st.nextStateName = defaultState.stateName;
        }
        else {
          manualDecision("WORKFLOW_TRANSITION_AMBIGUOUS",
            "Resolve target state for default choice transition " + firstText(defaultTransition.name, defaultTransition.id) + ".",
            KERNEL!Severity#BLOCKER, true, Sequence{w, ws, defaultTransition},
            "Ensure the default WorkflowTransition.target references a state in the same transformed workflow.");
        }
      }
      for (tr in out.select(candidate | not isTrue(candidate.defaultTransition))) {
        var choiceRule = createAslChoice(tr, entryByPimId, ws.invokesFunction.isDefined());
        if (choiceRule.isDefined()) {
          st.choices.add(choiceRule);
        }
      }
      if (defaultTransitions.isEmpty()) {
        manualDecision("WORKFLOW_CHOICE_DEFAULT_REQUIRED",
          "Define a default path for workflow choice " + ws.name + ".",
          KERNEL!Severity#BLOCKER, true, Sequence{w, ws},
          "Mark one outgoing WorkflowTransition as defaultTransition so unmatched input cannot terminate with a States.NoChoiceMatched error.");
      }
    }
    else if (st.isDefined() and out.size() = 1 and not st.end) {
      var resolvedNextState = entryByPimId.get(cacheKeyFor(out.first().target));
      if (resolvedNextState.isDefined()) {
        st.nextState = resolvedNextState;
        st.nextStateName = resolvedNextState.stateName;
      }
      else {
        manualDecision("WORKFLOW_TRANSITION_AMBIGUOUS",
          "Resolve target state for workflow transition " + firstText(out.first().name, out.first().id) + ".",
          KERNEL!Severity#ERROR, true, Sequence{w, out.first()},
          "Ensure WorkflowTransition.target references a state in the same transformed workflow.");
      }
    }
    else if (st.isDefined() and out.isEmpty() and not st.end and not st.isKindOf(AWSPSMWORKFLOW!AslChoiceState)) {
      var inferredNext = nextOrderedWorkflowStep(w, ws);
      var resolvedInferredNext = null;
      if (inferredNext.isDefined()) {
        resolvedInferredNext = entryByPimId.get(cacheKeyFor(inferredNext));
      }
      if (resolvedInferredNext.isDefined()) {
        st.nextState = resolvedInferredNext;
        st.nextStateName = resolvedInferredNext.stateName;
      }
      else {
        manualDecision("WORKFLOW_TRANSITION_AMBIGUOUS",
          "Resolve the next ordered state for workflow state " + ws.name + ".",
          KERNEL!Severity#ERROR, true, Sequence{w, ws},
          "Add an explicit workflow transition or ensure ordered workflow steps form a complete path.");
      }
    }
    else {
      if (st.isDefined() and out.size() <> 1 and not st.end and not st.isKindOf(AWSPSMWORKFLOW!AslChoiceState)) {
        manualDecision("WORKFLOW_TRANSITION_AMBIGUOUS",
          "Resolve outgoing transition for workflow state " + ws.name + ".",
          KERNEL!Severity#ERROR, true, Sequence{w, ws},
          "Non-choice states need exactly one outgoing transition unless terminal.");
      }
    }
    if (st.isDefined()) {
      for (h in ws.catchHandlers) {
        if (h.nextStep.isDefined()) {
          var catchRule = createAslCatch(h, entryByPimId);
          if (catchRule.isDefined()) {
            st.catch.add(catchRule);
          }
        }
      }
    }
  }
}

/** Creates create asl choice. */
operation createAslChoice(tr, entryByPimId, evaluatorBacked) {
  var resolvedNextState = entryByPimId.get(cacheKeyFor(tr.target));
  if (resolvedNextState.isUndefined()) {
    manualDecision("WORKFLOW_TRANSITION_AMBIGUOUS",
      "Resolve target state for choice transition " + firstText(tr.name, tr.id) + ".",
      KERNEL!Severity#ERROR, true, Sequence{tr},
      "Ensure WorkflowTransition.target references a state in the same transformed workflow.");
    return null;
  }
  var c = new AWSPSMWORKFLOW!AslChoiceRule;
  c.id = generatedId("asl_choice", tr, "choice");
  c.name = firstText(tr.name, "Choice");
  if (hasText(tr.decisionOutcome)) {
    c.conditionExpression = jsonataDecisionOutcomeCondition(tr.decisionOutcome);
  }
  else if (evaluatorBacked) {
    // Do not silently route on input predicates when a decision evaluator is
    // present. The missing outcome mapping must remain visibly incomplete.
    c.conditionExpression = "";
  }
  else {
    c.conditionExpression = jsonataCondition(tr.conditionExpression);
  }
  c.variable = "";
  c.nextState = resolvedNextState;
  if (not hasText(c.conditionExpression) and not isTrue(tr.defaultTransition)) {
    manualDecision("WORKFLOW_TRANSITION_AMBIGUOUS",
      "Provide condition expression for choice transition " + tr.name + ".",
      KERNEL!Severity#ERROR, true, Sequence{tr},
      "Set WorkflowTransition.conditionExpression or mark it as defaultTransition.");
    delete c;
    return null;
  }
  return c;
}

/** Creates create asl retry. */
operation createAslRetry(p) {
  var r = new AWSPSMWORKFLOW!AslRetryRule;
  r.id = uniqueId("asl_retry_" + slug(p.name));
  r.name = firstText(p.name, "Retry");
  r.errorEquals.addAll(p.retryableErrors);
  if (r.errorEquals.isEmpty()) {
    r.errorEquals.add("States.ALL");
  }
  r.intervalSeconds = positiveOr(p.initialDelaySeconds, 1);
  r.maxAttempts = positiveOr(p.maxAttempts, 3);
  if (p.backoffRate.isDefined()) {
    r.backoffRate = p.backoffRate;
  }
  else {
    r.backoffRate = 2.0d;
  }
  r.maxDelaySeconds = positiveOr(p.maxDelaySeconds, 60);
  r.jitterStrategy = "FULL";
  return r;
}

/** Creates create asl catch. */
operation createAslCatch(h, entryByPimId) {
  var resolvedNextState = entryByPimId.get(cacheKeyFor(h.nextStep));
  if (resolvedNextState.isUndefined()) {
    manualDecision("WORKFLOW_TRANSITION_AMBIGUOUS",
      "Resolve catch target step for " + firstText(h.name, h.id) + ".",
      KERNEL!Severity#ERROR, true, Sequence{h},
      "Ensure ErrorHandler.nextStep references a step in the same transformed workflow.");
    return null;
  }
  var c = new AWSPSMWORKFLOW!AslCatchRule;
  c.id = uniqueId("asl_catch_" + slug(h.name));
  c.name = firstText(h.name, "Catch");
  c.errorEquals.add(firstText(h.errorSelector, "States.ALL"));
  c.resultPath = "$.error";
  c.nextState = resolvedNextState;
  return c;
}

/** Creates create state machine role. */
operation createStateMachineRole(w) {
  var role = new AWSPSMSECURITY!IamRole;
  copyAwsResource(w, role, "StateMachineRole", "AWS::IAM::Role");
  role.id = generatedId("iam_role", w, "states");
  role.roleName = physicalName(w, "states-role", defaultStage());
  role.path = "/";
  role.assumeRolePolicy = serviceAssumeRolePolicy("states.amazonaws.com", w.id);
  return role;
}

/** Creates create step function logging. */
operation createStepFunctionLogging(w, sm) {
  var cfg = new AWSPSMWORKFLOW!StepFunctionLoggingConfig;
  cfg.id = generatedId("sfn_logging", w, "logging");
  cfg.name = w.name + " logging";
  cfg.includeExecutionData = not isProductionRoot();
  cfg.level = "ALL";
  cfg.logGroup = createLogGroupFor(w, sm.logicalId, "/aws/vendedlogs/states/" + sm.stateMachineName);
  return cfg;
}

/** Creates create step function tracing. */
operation createStepFunctionTracing(w) {
  var t = new AWSPSMWORKFLOW!StepFunctionTracingConfig;
  t.id = generatedId("sfn_tracing", w, "xray");
  t.name = w.name + " tracing";
  t.enabled = true;
  return t;
}

/** Renders asl summary json. */
operation aslSummaryJson(w, doc) {
  return renderAsl(doc);
}

/** Renders render asl. */
operation renderAsl(doc) {
  var states = "";
  for (s in doc.states) {
    if (hasText(states)) {
      states = states + ", ";
    }
    states = states + "\"" + escapeJson(s.stateName) + "\": " + renderAslState(s);
  }
  return "{ \"Comment\": \"" + escapeJson(doc.comment) + "\", \"QueryLanguage\": \"" + escapeJson(doc.queryLanguage) + "\", \"StartAt\": \"" + escapeJson(doc.startAt) + "\", \"States\": { " + states + " } }";
}

/** Renders render asl state. */
operation renderAslState(s) {
  var body = "{ \"Type\": \"" + aslTypeName(s) + "\"";
  if (hasText(s.queryLanguage)) {
    body = body + ", \"QueryLanguage\": \"" + escapeJson(s.queryLanguage) + "\"";
  }
  if (s.isKindOf(AWSPSMWORKFLOW!AslTaskState) and s.invokedResource.isDefined() and s.resource <> "arn:aws:states:::states:startExecution.sync") {
    body = body + ", \"Resource\": \"${" + escapeJson(s.invokedResource.logicalId) + "Arn}\"";
  }
  else if (hasText(s.resource)) {
    body = body + ", \"Resource\": \"" + escapeJson(s.resource) + "\"";
  }
  if (hasText(s.argumentsJson)) {
    body = body + ", \"Arguments\": " + s.argumentsJson;
  }
  if (hasText(s.inputPath) and s.queryLanguage <> "JSONata") {
    body = body + ", \"InputPath\": \"" + escapeJson(s.inputPath) + "\"";
  }
  if (hasText(s.outputPath) and s.queryLanguage <> "JSONata") {
    body = body + ", \"OutputPath\": \"" + escapeJson(s.outputPath) + "\"";
  }
  if (hasText(s.resultPath) and s.queryLanguage <> "JSONata") {
    body = body + ", \"ResultPath\": \"" + escapeJson(s.resultPath) + "\"";
  }
  if (s.timeoutSeconds.isDefined() and s.timeoutSeconds > 0) {
    if (s.isKindOf(AWSPSMWORKFLOW!AslWaitState)) {
      body = body + ", \"Seconds\": " + s.timeoutSeconds.asString();
    }
    else {
      body = body + ", \"TimeoutSeconds\": " + s.timeoutSeconds.asString();
    }
  }
  else if (s.isKindOf(AWSPSMWORKFLOW!AslWaitState)) {
    body = body + ", \"Seconds\": 0";
  }
  if (s.retry.notEmpty()) {
    body = body + ", \"Retry\": " + retryJson(s.retry);
  }
  if (s.catch.notEmpty()) {
    body = body + ", \"Catch\": " + catchJson(s.catch);
  }
  if (s.choices.notEmpty()) {
    body = body + ", \"Choices\": " + choiceJson(s.choices);
  }
  if (s.isKindOf(AWSPSMWORKFLOW!AslChoiceState) and s.nextState.isDefined()) {
    body = body + ", \"Default\": \"" + escapeJson(s.nextState.stateName) + "\"";
  }
  if (s.end) {
    body = body + ", \"End\": true";
  }
  else {
    if (hasText(s.nextStateName)) {
      body = body + ", \"Next\": \"" + escapeJson(s.nextStateName) + "\"";
    }
  }
  return body + " }";
}

/** Renders asl type name. */
operation aslTypeName(s) {
  if (s.isKindOf(AWSPSMWORKFLOW!AslPassState)) {
    return "Pass";
  }
  if (s.isKindOf(AWSPSMWORKFLOW!AslTaskState)) {
    return "Task";
  }
  if (s.isKindOf(AWSPSMWORKFLOW!AslChoiceState)) {
    return "Choice";
  }
  if (s.isKindOf(AWSPSMWORKFLOW!AslWaitState)) {
    return "Wait";
  }
  if (s.isKindOf(AWSPSMWORKFLOW!AslSucceedState)) {
    return "Succeed";
  }
  if (s.isKindOf(AWSPSMWORKFLOW!AslFailState)) {
    return "Fail";
  }
  if (s.isKindOf(AWSPSMWORKFLOW!AslParallelState)) {
    return "Parallel";
  }
  return "Map";
}

/** Computes retry json. */
operation retryJson(items) {
  var out = "";
  for (r in items) {
    if (hasText(out)) {
      out = out + ", ";
    }
    out = out + "{ \"ErrorEquals\": " + stringArrayJson(r.errorEquals) + ", \"IntervalSeconds\": " + r.intervalSeconds.asString() +
      ", \"MaxAttempts\": " + r.maxAttempts.asString() + ", \"BackoffRate\": " + r.backoffRate.asString() + " }";
  }
  return "[ " + out + " ]";
}

/** Computes catch json. */
operation catchJson(items) {
  var out = "";
  for (c in items) {
    if (hasText(out)) {
      out = out + ", ";
    }
    out = out + "{ \"ErrorEquals\": " + stringArrayJson(c.errorEquals) + ", \"ResultPath\": \"" + escapeJson(c.resultPath) +
      "\", \"Next\": \"" + escapeJson(c.nextState.stateName) + "\" }";
  }
  return "[ " + out + " ]";
}

/** Computes choice json. */
operation choiceJson(items) {
  var out = "";
  for (c in items) {
    if (hasText(out)) {
      out = out + ", ";
    }
    out = out + "{ \"Condition\": \"" + escapeJson(c.conditionExpression) + "\", \"Next\": \"" + escapeJson(c.nextState.stateName) + "\" }";
  }
  return "[ " + out + " ]";
}

/** Computes string array json. */
operation stringArrayJson(items) {
  var out = "";
  for (item in items) {
    if (hasText(out)) {
      out = out + ", ";
    }
    out = out + "\"" + escapeJson(item) + "\"";
  }
  return "[ " + out + " ]";
}

/** Converts the supported provider-independent boolean subset into a JSONata condition. */
operation jsonataCondition(expression) {
  if (not hasText(expression)) {
    return "";
  }
  var text = expression.trim();
  if (text.startsWith("{%")) {
    return text;
  }
  if (not text.matches("^(\\$\\.)?[A-Za-z_][A-Za-z0-9_]*(\\s+(and|or)\\s+(\\$\\.)?[A-Za-z_][A-Za-z0-9_]*|\\s*(>=|<=|!=|==|=|>|<)\\s*(true|false|null|[0-9]+))+$")) {
    return "";
  }
  // Source conditions are FEEL-like expressions. Prefix bare input fields while
  // preserving boolean/null literals; unsupported prose remains a blocking review item.
  var converted = text.replaceAll("\\$\\.", "VARKA_PATH_");
  converted = converted.replaceAll("\\b(and|or|not)\\b", "VARKA_OPERATOR_$1");
  converted = converted.replaceAll("\\b(true|false|null)\\b", "VARKA_LITERAL_$1");
  converted = converted.replaceAll("\\b([A-Za-z_][A-Za-z0-9_]*)\\b", "VARKA_INPUT_$1");
  converted = converted.replace("VARKA_INPUT_VARKA_OPERATOR_", "VARKA_OPERATOR_");
  converted = converted.replace("VARKA_INPUT_VARKA_LITERAL_", "VARKA_LITERAL_");
  converted = converted.replace("VARKA_OPERATOR_and", "and");
  converted = converted.replace("VARKA_OPERATOR_or", "or");
  converted = converted.replace("VARKA_OPERATOR_not", "not");
  converted = converted.replace("VARKA_LITERAL_true", "true");
  converted = converted.replace("VARKA_LITERAL_false", "false");
  converted = converted.replace("VARKA_LITERAL_null", "null");
  converted = converted.replace("VARKA_INPUT_VARKA_PATH_", "\\$states.input.");
  converted = converted.replace("VARKA_INPUT_", "\\$states.input.");
  converted = converted.replaceAll("==", "=");
  return "{% " + converted + " %}";
}

/** Builds the JSONata predicate for an explicit evaluator outcome mapping. */
operation jsonataDecisionOutcomeCondition(outcome) {
  return "{% $states.input.decisionEvaluation.outcome = \"" + escapeJson(outcome) + "\" %}";
}

/** Converts supported ISO-8601 day/hour/minute durations to ASL seconds. */
operation waitSeconds(value) {
  if (not hasText(value)) {
    return 0;
  }
  var text = value.trim().toUpperCase();
  if (not (text.matches("^P[0-9]+D$") or text.matches("^PT[0-9]+[HMS]$"))) {
    return 0;
  }
  var digits = "";
  var collecting = false;
  for (i in Sequence{1..text.length()}) {
    var ch = text.substring(i - 1, i);
    if ("0123456789".contains(ch)) {
      digits = digits + ch;
      collecting = true;
    }
    else if (collecting) {
      break;
    }
  }
  if (not hasText(digits)) {
    return 0;
  }
  var amount = digits.asInteger();
  if (text.contains("D")) return amount * 86400;
  if (text.contains("H")) return amount * 3600;
  if (text.contains("M")) return amount * 60;
  return amount;
}

/** Returns whether a wait expression was parsed to an AWS-supported duration. */
operation isSupportedWaitDuration(value, seconds) {
  if (not hasText(value)) {
    return false;
  }
  var text = value.trim().toUpperCase();
  return (text.matches("^P[0-9]+D$") or text.matches("^PT[0-9]+[HMS]$")) and
    seconds >= 0 and seconds <= 99999999;
}

/** Computes rotation days. */
operation rotationDays(text) {
  if (not hasText(text)) {
    return 30;
  }
  if (text.toLowerCase().contains("year")) {
    return 365;
  }
  if (text.toLowerCase().contains("week")) {
    return 7;
  }
  return 30;
}

/** Computes configuration json. */
operation configurationJson(c) {
  var entries = "";
  for (p in c.parameters) {
    if (hasText(entries)) {
      entries = entries + ", ";
    }
    entries = entries + "\"" + escapeJson(p.name) + "\": { \"required\": " + isTrue(p.required).asString() + ", \"secret\": " + isTrue(p.secret).asString() + " }";
  }
  return "{ " + entries + " }";
}
