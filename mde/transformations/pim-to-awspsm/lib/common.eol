/** Provides reusable common operations. */
/** Initializes shared roots, lookup maps, and deduplication sets for the PIM-to-AWS-PSM run. */
operation initialisePimToAwsPsmCaches() {
  usedAwsLogicalIds = Set{};
  usedAwsPhysicalNames = Set{};
  cachedPimRoot = PIM!PIMModel.all.first();
  cachedAwsRoot = null;
  cachedDefaultStack = null;
  cachedDefaultStage = null;
  cachedIsProductionRoot = isProductionPim(cachedPimRoot);
  cachedAwsExistingTargetByKey = new Map;
  cachedPimServiceNameByElementId = new Map;
  cachedPimOwnerTeamByElementId = new Map;
  cachedPimDeploymentAssignedIds = Set{};
  cachedPimDeploymentUnitByElementId = new Map;
  cachedAwsEquivalentBySourceId = new Map;
  cachedAwsGeneratedResources = Sequence{};
  cachedAwsGeneratedResourceObjects = Set{};
  cachedGeneratedIdByKey = new Map;
  cachedNextLogicalIdIndexBySeed = new Map;
  cachedNextPhysicalNameIndexBySeed = new Map;
  cachedDataAccessesByFunctionId = new Map;
  cachedStageStackLinks = Set{};
  cachedApiGatewayRoutesWithLambdaIntegration = Sequence{};
  cachedSqsLambdaMappings = Sequence{};
  cachedSnsLambdaSubscriptions = Sequence{};
  cachedEventBridgeRules = Sequence{};
  cachedAwsResolvingRelationships = true;
  cachedAwsAuthorizerByApiId = new Map;
  cachedLambdaPermissionByKey = new Map;
  cachedSqsLambdaMappingByKey = new Map;
  cachedSnsSubscriptionByKey = new Map;
  cachedTopicsByEventTypeId = new Map;
  cachedEventBusesByEventTypeId = new Map;
  cachedQueuesByEventTypeId = new Map;
  cachedJsonSchemaById = new Map;
  cachedOpenApiSchemaById = new Map;
  cachedPimRootName = firstText(firstText(cachedPimRoot.domainName, cachedPimRoot.name), "Application");
  cachedAwsReadinessDecisionIds = Set{};
  cachedAwsReadinessFindingIds = Set{};
  cachedAwsReadinessCheckIds = Set{};
  cachedAwsTargetHadPreloadedContent =
    AWSPSM!AwsPsmModel.all.notEmpty() or AWSPSMCORE!AwsResource.all.notEmpty() or KERNEL!TraceableElement.all.notEmpty();

  for (resource in AWSPSMCORE!AwsResource.all.select(r | hasText(r.logicalId))) {
    usedAwsLogicalIds.add(resource.logicalId);
  }
  for (resource in AWSPSMCORE!AwsResource.all.select(r | hasText(r.physicalName))) {
    usedAwsPhysicalNames.add(resource.physicalName);
  }
  if (cachedAwsTargetHadPreloadedContent) {
    for (resource in AWSPSMCORE!AwsResource.all.select(r | hasText(r.generatedFrom))) {
      cacheExistingTarget(resource);
    }
    for (element in KERNEL!TraceableElement.all.select(e | hasText(e.generatedFrom))) {
      cacheExistingTarget(element);
    }
  }
  cachePimOwnership();
  cachePimEventChannels();
  cachePimDataAccesses();
}

/** Computes cache key for. */
operation cacheKeyFor(element) {
  if (element.isUndefined()) {
    return "";
  }
  if (hasText(element.id)) {
    return element.id;
  }
  if (hasText(element.name)) {
    return element.eClass().getName() + "_" + slug(element.name);
  }
  return element.eClass().getName() + "_" + slug(element.asString());
}

/** Computes cache existing target. */
operation cacheExistingTarget(target) {
  cachedAwsExistingTargetByKey.put(target.generatedFrom + "::" + target.eClass().getName(), target);
}

/** Computes cache pim ownership. */
operation cachePimOwnership() {
  for (service in cachedPimRoot.services) {
    cachePimServiceOwner(service, service);
    for (fn in service.functions) {
      cachePimServiceOwner(fn, service);
    }
    for (api in service.apis) {
      cachePimServiceOwner(api, service);
      for (route in api.routes) {
        cachePimServiceOwner(route, service);
      }
    }
    for (channel in service.channels) {
      cachePimServiceOwner(channel, service);
    }
    for (store in service.stores) {
      cachePimServiceOwner(store, service);
    }
    for (workflow in service.workflows) {
      cachePimServiceOwner(workflow, service);
      for (step in workflow.steps) {
        cachePimServiceOwner(step, service);
      }
    }
    for (adapter in service.adapters) {
      cachePimServiceOwner(adapter, service);
    }
    for (schedule in service.schedules) {
      cachePimServiceOwner(schedule, service);
    }
  }
  for (unit in cachedPimRoot.deploymentUnits) {
    for (service in unit.services) {
      cacheDeploymentAssignment(service, unit);
      for (fn in service.functions) {
        cacheDeploymentAssignment(fn, unit);
      }
      for (api in service.apis) {
        cacheDeploymentAssignment(api, unit);
      }
      for (channel in service.channels) {
        cacheDeploymentAssignment(channel, unit);
      }
      for (store in service.stores) {
        cacheDeploymentAssignment(store, unit);
      }
      for (workflow in service.workflows) {
        cacheDeploymentAssignment(workflow, unit);
      }
      for (adapter in service.adapters) {
        cacheDeploymentAssignment(adapter, unit);
      }
      for (schedule in service.schedules) {
        cacheDeploymentAssignment(schedule, unit);
      }
    }
    for (element in unit.contains) {
      cacheDeploymentAssignment(element, unit);
    }
  }
}

/** Computes cache pim service owner. */
operation cachePimServiceOwner(element, service) {
  var key = cacheKeyFor(element);
  if (hasText(key)) {
    cachedPimServiceNameByElementId.put(key, firstText(service.name, "Application"));
    cachedPimOwnerTeamByElementId.put(key, firstText(service.ownerTeam, "REVIEW_REQUIRED_OWNER"));
  }
}

/** Computes cache deployment assignment. */
operation cacheDeploymentAssignment(element, unit) {
  var key = cacheKeyFor(element);
  if (hasText(key)) {
    cachedPimDeploymentAssignedIds.add(key);
    cachedPimDeploymentUnitByElementId.put(key, unit);
  }
}

/** Adds or records add indexed. */
operation addIndexed(index, key, value) {
  if (not hasText(key) or value.isUndefined()) {
    return;
  }
  var values = index.get(key);
  if (values.isUndefined()) {
    values = Sequence{};
    index.put(key, values);
  }
  if (not values.includes(value)) {
    values.add(value);
  }
}

/** Computes indexed values. */
operation indexedValues(index, key) {
  var values = index.get(key);
  if (values.isDefined()) {
    return values;
  }
  return Sequence{};
}

/** Computes cache pim event channels. */
operation cachePimEventChannels() {
  for (topic in INTEGRATION!Topic.all) {
    for (eventType in topic.eventTypes) {
      addIndexed(cachedTopicsByEventTypeId, cacheKeyFor(eventType), topic);
    }
  }
  for (bus in INTEGRATION!EventBus.all) {
    for (eventType in bus.eventTypes) {
      addIndexed(cachedEventBusesByEventTypeId, cacheKeyFor(eventType), bus);
    }
  }
  for (queue in INTEGRATION!Queue.all) {
    for (eventType in queue.eventTypes) {
      addIndexed(cachedQueuesByEventTypeId, cacheKeyFor(eventType), queue);
    }
  }
}

/** Computes cache pim data accesses. */
operation cachePimDataAccesses() {
  for (access in DATA!DataAccess.all.select(a | a.`function`.isDefined())) {
    addIndexed(cachedDataAccessesByFunctionId, cacheKeyFor(access.`function`), access);
  }
}

/** Computes aws equivalent. */
operation awsEquivalent(source) {
  if (source.isUndefined()) {
    return null;
  }
  var key = cacheKeyFor(source);
  if (not hasText(key)) {
    return source.equivalent();
  }
  if (cachedAwsEquivalentBySourceId.containsKey(key)) {
    var cached = cachedAwsEquivalentBySourceId.get(key);
    if (cached = "__NONE__") return null;
    return cached;
  }
  var target = source.equivalent();
  if (target.isDefined()) {
    if (not cachedAwsResolvingRelationships) {
      cachedAwsEquivalentBySourceId.put(key, target);
    }
    return target;
  }
  if (not cachedAwsResolvingRelationships) {
    cachedAwsEquivalentBySourceId.put(key, "__NONE__");
  }
  return null;
}

/** Converts the receiver to text. */
operation asText(value) {
  return etlTextChecks.asText(value);
}

/** Returns whether the receiver has text. */
operation hasText(value) {
  return etlTextChecks.hasText(value);
}

/** Computes first text. */
operation firstText(primary, fallback) {
  return etlTextChecks.firstText(primary, fallback);
}

/** Converts the receiver to slug. */
operation slug(value) {
  return etlTextChecks.slug(value);
}

/** Converts the receiver to kebab. */
operation kebab(value) {
  return etlTextChecks.kebab(value);
}

/** Converts the receiver to camel case. */
operation camelCase(value) {
  return etlTextChecks.camelCase(value);
}

/** Converts the receiver to pascal case. */
operation pascalCase(value) {
  return etlTextChecks.pascalCase(value);
}

/** Computes id for. */
operation idFor(prefix : String, source) {
  var seed = source.id;
  if (not hasText(seed)) {
    seed = source.name;
  }
  if (not hasText(seed)) {
    seed = prefix;
  }
  return generatedStableId(prefix, source, "");
}

/** Computes generated id. */
operation generatedId(prefix : String, source, suffix : String) {
  return generatedStableId(prefix, source, suffix);
}

/** Computes generated stable id. */
operation generatedStableId(prefix : String, source, suffix : String) {
  var key = prefix + "::" + cacheKeyFor(source) + "::" + suffix;
  if (cachedGeneratedIdByKey.containsKey(key)) {
    return cachedGeneratedIdByKey.get(key);
  }
  var id = modelElementIdGenerator.deterministicId("pim-to-awspsm", key);
  cachedGeneratedIdByKey.put(key, id);
  return id;
}

/** Computes unique id. */
operation uniqueId(base : String) {
  return modelElementIdGenerator.deterministicOccurrenceId("pim-to-awspsm-helper", base);
}

/** Returns whether the receiver is true. */
operation isTrue(value) {
  return value.isDefined() and value;
}

/** Computes positive or. */
operation positiveOr(value, fallback : Integer) {
  if (value.isDefined() and value > 0) {
    return value;
  }
  return fallback;
}

/** Derives clamp. */
operation clamp(value : Integer, minimum : Integer, maximum : Integer) {
  if (value < minimum) {
    return minimum;
  }
  if (value > maximum) {
    return maximum;
  }
  return value;
}

/** Computes qualified name. */
operation qualifiedName(element) {
  if (element.isUndefined()) {
    return "";
  }
  if (hasText(element.sourceQualifiedName)) {
    return element.sourceQualifiedName;
  }
  return element.eClass().getName() + "/" + firstText(element.name, element.id);
}

/** Computes escape json. */
operation escapeJson(value) {
  return etlTextChecks.escapeJson(value);
}

/** Converts the receiver to safe json text. */
operation safeJsonText(value) {
  return escapeJson(firstText(value, ""));
}

/** Returns root name. */
operation rootName() {
  return cachedPimRootName;
}

/** Returns pim root. */
operation pimRoot() {
  return cachedPimRoot;
}

/** Returns aws root. */
operation awsRoot() {
  if (cachedAwsRoot.isUndefined()) {
    cachedAwsRoot = AWSPSM!AwsPsmModel.all.first();
  }
  return cachedAwsRoot;
}

/** Computes copy traceable. */
operation copyTraceable(source, target) {
  var preserved = existingTargetFor(source, target.eClass().getName());
  if (preserved.isDefined() and isTrue(preserved.manuallyMaintained)) {
    target.reviewStatus = "SKIPPED_MANUALLY_MAINTAINED_EXISTING_TARGET";
    target.reviewNotes = "An existing manually maintained target with generatedFrom=" + source.id + " was detected. Review before replacing generated output.";
  }
  target.name = firstText(source.name, source.id);
  target.summary = source.summary;
  target.description = source.description;
  target.documentation = source.documentation;
  target.sourceReference = source.sourceReference;
  target.sourceQualifiedName = qualifiedName(source);
  target.traceId = firstText(source.traceId, source.id);
  target.generatedFrom = source.id;
  target.generatedByTransformation = true;
  target.manuallyMaintained = false;
  if (hasText(source.id) and not cachedAwsEquivalentBySourceId.containsKey(source.id)) {
    cachedAwsEquivalentBySourceId.put(source.id, target);
  }
}

/** Computes existing target for. */
operation existingTargetFor(source, className : String) {
  if (not cachedAwsTargetHadPreloadedContent or not hasText(source.id)) {
    return null;
  }
  return cachedAwsExistingTargetByKey.get(source.id + "::" + className);
}

/** Computes copy aws resource. */
operation copyAwsResource(source, target, kind : String, awsType : String) {
  copyTraceable(source, target);
  registerAwsGeneratedResource(target);
  target.logicalId = logicalId(source, kind);
  target.physicalName = physicalName(source, kind.toLowerCase(), defaultStage());
  target.awsResourceType = awsType;
  target.resourceDescription = firstText(source.summary, source.description);
  if (isProductionRoot()) {
    target.deletionPolicy = AWSPSMENUMS!CloudFormationDeletionPolicy#RETAIN;
    target.updateReplacePolicy = AWSPSMENUMS!CloudFormationUpdateReplacePolicy#RETAIN;
  }
  else {
    target.deletionPolicy = AWSPSMENUMS!CloudFormationDeletionPolicy#DELETE;
    target.updateReplacePolicy = AWSPSMENUMS!CloudFormationUpdateReplacePolicy#DELETE;
  }
  target.retainInProduction = isProductionRoot();
  target.productionCritical = isProductionRoot();
  target.importedResource = false;
  target.tags.add(tag("GeneratedFromPIM", firstText(source.name, source.id)));
  target.tags.add(tag("Service", owningServiceName(source)));
  target.tags.add(tag("Owner", owningOwnerTeam(source)));
  target.tags.add(tag("Environment", defaultStageName()));
  applyProductionDefaults(target);
  cacheAwsEquivalentMapping(source, target);
}

/** Records the PIM source to AWS target mapping for later rule guards. */
operation cacheAwsEquivalentMapping(source, target) {
  if (source.isUndefined() or target.isUndefined()) {
    return;
  }
  var key = cacheKeyFor(source);
  if (hasText(key) and not cachedAwsEquivalentBySourceId.containsKey(key)) {
    cachedAwsEquivalentBySourceId.put(key, target);
  }
}

/** Adds or records register aws generated resource. */
operation registerAwsGeneratedResource(resource) {
  if (resource.isUndefined() or cachedAwsGeneratedResourceObjects.includes(resource)) {
    return;
  }
  cachedAwsGeneratedResourceObjects.add(resource);
  cachedAwsGeneratedResources.add(resource);
  var className = resource.eClass().getName();
  if (resource.isKindOf(AWSPSMAPI!ApiGatewayRoute)) cachedApiGatewayRoutesWithLambdaIntegration.add(resource);
  if (className = "SqsLambdaEventSourceMapping") cachedSqsLambdaMappings.add(resource);
  if (className = "SnsSubscription") cachedSnsLambdaSubscriptions.add(resource);
  if (className = "EventBridgeRule") cachedEventBridgeRules.add(resource);
}

/** Returns whether a generated resource is val-contained under another AWS resource. */
operation isNestedAwsResource(resource) {
  var container = resource.eContainer();
  return container.isDefined() and container.isKindOf(AWSPSMCORE!AwsResource);
}

/** Collects nested AwsResource children for stack propagation and flattening. */
operation AWSPSMCORE!AwsResource nestedAwsResources() : Sequence {
  var nested = Sequence{};
  if (self.isKindOf(AWSPSMAPI!ApiGatewayApi)) {
    nested.addAll(self.routes);
    nested.addAll(self.stages);
    nested.addAll(self.authorizers);
  }
  if (self.isKindOf(AWSPSMAPI!RestApi)) {
    nested.addAll(self.resources);
  }
  if (self.isKindOf(AWSPSMCOMPUTE!AwsLambdaFunction)) {
    nested.addAll(self.permissions);
    nested.addAll(self.versions);
    nested.addAll(self.aliases);
    nested.addAll(self.eventInvokeConfigs);
    nested.addAll(self.eventSourceMappings);
    if (self.functionUrl.isDefined()) {
      nested.add(self.functionUrl);
    }
  }
  var flattened = Sequence{};
  for (child in nested) {
    flattened.add(child);
    flattened.addAll(child.nestedAwsResources());
  }
  return flattened;
}

/** Computes apply production defaults. */
operation applyProductionDefaults(resource) {
  if (not isProductionRoot()) {
    return;
  }
  if (resource.eClass().getEStructuralFeature("kmsKey").isDefined()
      and resource.eGet(resource.eClass().getEStructuralFeature("kmsKey")).isUndefined()) {
    resource.eSet(resource.eClass().getEStructuralFeature("kmsKey"), defaultKmsKey());
  }
  // An unknown permissions boundary must remain absent. A review marker is not a valid ARN and
  // makes otherwise deployable CloudFormation fail before reviewers can supply their boundary.
}

/** Creates default kms key. */
operation defaultKmsKey() {
  var cacheKey = "__platform_default_kms_key__";
  if (cachedAwsEquivalentBySourceId.containsKey(cacheKey)) {
    return cachedAwsEquivalentBySourceId.get(cacheKey);
  }
  var key = new AWSPSMSECURITY!KmsKey;
  cachedAwsEquivalentBySourceId.put(cacheKey, key);
  registerAwsGeneratedResource(key);
  key.id = uniqueId("kms_key_platform_default");
  key.name = "Platform default KMS key";
  key.generatedFrom = firstText(pimRoot().id, pimRoot().name);
  key.generatedByTransformation = true;
  key.manuallyMaintained = false;
  key.logicalId = uniqueLogicalId("PlatformDefaultKmsKey");
  key.physicalName = physicalName(pimRoot(), "kms-key", defaultStage());
  key.awsResourceType = "AWS::KMS::Key";
  key.resourceDescription = "Generated customer-managed key for production encryption defaults.";
  key.deletionPolicy = AWSPSMENUMS!CloudFormationDeletionPolicy#RETAIN;
  key.updateReplacePolicy = AWSPSMENUMS!CloudFormationUpdateReplacePolicy#RETAIN;
  key.retainInProduction = true;
  key.productionCritical = true;
  key.importedResource = false;
  key.descriptionText = "Default generated CMK for logs, topics, secrets, and Lambda encryption.";
  key.keyUsage = "ENCRYPT_DECRYPT";
  key.keySpec = "SYMMETRIC_DEFAULT";
  key.enabled = true;
  key.enableKeyRotation = true;
  key.multiRegion = false;
  key.pendingWindowInDays = 30;
  key.tags.add(tag("GeneratedFromPIM", firstText(pimRoot().name, pimRoot().id)));
  key.tags.add(tag("Service", "Application"));
  key.tags.add(tag("Owner", "REVIEW_REQUIRED_OWNER"));
  key.tags.add(tag("Environment", defaultStageName()));
  return key;
}

/** Ensures each independently deployable stack owns the generated default CMK it references. */
operation alignDefaultKmsKeysWithStacks() {
  var provisionalKey = cachedAwsEquivalentBySourceId.get("__platform_default_kms_key__");
  if (provisionalKey.isUndefined()) {
    return;
  }
  for (stackObj in AWSPSMCORE!SamStack.all) {
    var encryptedResources = stackObj.resources.select(resourceObj |
      resourceObj.eClass().getEStructuralFeature("kmsKey").isDefined()
      and resourceObj.eGet(resourceObj.eClass().getEStructuralFeature("kmsKey")) = provisionalKey);
    if (encryptedResources.isEmpty()) {
      continue;
    }
    var stackKey = provisionalKey;
    if (provisionalKey.stack <> stackObj) {
      stackKey = createStackDefaultKmsKey(stackObj);
    }
    for (resourceObj in encryptedResources) {
      resourceObj.eSet(resourceObj.eClass().getEStructuralFeature("kmsKey"), stackKey);
    }
  }
}

/** Creates a generated default CMK owned by one stack. */
operation createStackDefaultKmsKey(stackObj) {
  var key = new AWSPSMSECURITY!KmsKey;
  registerAwsGeneratedResource(key);
  key.id = uniqueId("kms_key_platform_default_" + slug(stackObj.stackName));
  key.name = "Platform default KMS key for " + stackObj.name;
  key.generatedFrom = firstText(stackObj.generatedFrom, stackObj.id);
  key.generatedByTransformation = true;
  key.manuallyMaintained = false;
  key.logicalId = uniqueLogicalId("PlatformDefaultKmsKey" + pascalCase(stackObj.name));
  key.physicalName = physicalName(pimRoot(), "kms-key-" + kebab(stackObj.name), defaultStage());
  key.awsResourceType = "AWS::KMS::Key";
  key.resourceDescription = "Generated customer-managed key scoped to " + stackObj.name + ".";
  key.deletionPolicy = AWSPSMENUMS!CloudFormationDeletionPolicy#RETAIN;
  key.updateReplacePolicy = AWSPSMENUMS!CloudFormationUpdateReplacePolicy#RETAIN;
  key.retainInProduction = true;
  key.productionCritical = true;
  key.importedResource = false;
  key.descriptionText = "Default generated CMK for resources in " + stackObj.name + ".";
  key.keyUsage = "ENCRYPT_DECRYPT";
  key.keySpec = "SYMMETRIC_DEFAULT";
  key.enabled = true;
  key.enableKeyRotation = true;
  key.multiRegion = false;
  key.pendingWindowInDays = 30;
  key.tags.add(tag("GeneratedFromPIM", firstText(pimRoot().name, pimRoot().id)));
  key.tags.add(tag("Service", firstText(stackObj.name, "Application")));
  key.tags.add(tag("Owner", "REVIEW_REQUIRED_OWNER"));
  key.tags.add(tag("Environment", defaultStageName()));
  stackObj.resources.add(key);
  return key;
}

/** Creates default alarm topic. */
operation defaultAlarmTopic() {
  var cacheKey = "__platform_alarm_topic__";
  if (cachedAwsEquivalentBySourceId.containsKey(cacheKey)) {
    return cachedAwsEquivalentBySourceId.get(cacheKey);
  }
  var topic = new AWSPSMMESSAGING!SnsTopic;
  cachedAwsEquivalentBySourceId.put(cacheKey, topic);
  registerAwsGeneratedResource(topic);
  topic.id = uniqueId("sns_topic_platform_alarm_notifications");
  topic.name = "Platform Alarm Notifications Topic";
  topic.generatedFrom = firstText(pimRoot().id, pimRoot().name);
  topic.generatedByTransformation = true;
  topic.manuallyMaintained = false;
  topic.logicalId = uniqueLogicalId("PlatformAlarmNotificationsTopic");
  topic.physicalName = physicalName(pimRoot(), "alarm-topic", defaultStage());
  topic.awsResourceType = "AWS::SNS::Topic";
  topic.resourceDescription = "Generated notification topic for production CloudWatch alarm actions.";
  topic.deletionPolicy = AWSPSMENUMS!CloudFormationDeletionPolicy#RETAIN;
  topic.updateReplacePolicy = AWSPSMENUMS!CloudFormationUpdateReplacePolicy#RETAIN;
  topic.retainInProduction = true;
  topic.productionCritical = true;
  topic.importedResource = false;
  topic.topicName = topic.physicalName;
  topic.fifoTopic = false;
  topic.contentBasedDeduplication = false;
  topic.displayName = "Platform alarm notifications";
  topic.kmsKey = defaultKmsKey();
  topic.tags.add(tag("GeneratedFromPIM", firstText(pimRoot().name, pimRoot().id)));
  topic.tags.add(tag("Service", "Application"));
  topic.tags.add(tag("Owner", "REVIEW_REQUIRED_OWNER"));
  topic.tags.add(tag("Environment", defaultStageName()));
  return topic;
}

/** Computes logical id. */
operation logicalId(source, awsKind : String) {
  return uniqueLogicalId(pascalCase(firstText(firstText(source.name, source.externalId), source.id)) + awsKind);
}

/** Computes unique logical id. */
operation uniqueLogicalId(base : String) {
  var seed = pascalCase(base);
  var candidate = seed;
  var index = cachedNextLogicalIdIndexBySeed.get(seed);
  if (index.isUndefined()) index = 2;
  while (usedAwsLogicalIds.includes(candidate)) {
    candidate = seed + index.asString();
    index = index + 1;
  }
  cachedNextLogicalIdIndexBySeed.put(seed, index);
  usedAwsLogicalIds.add(candidate);
  return candidate;
}

/** Computes physical name. */
operation physicalName(source, awsKind : String, stage) {
  var prefix = "default";
  if (stage.isDefined()) {
    prefix = stage.stageName;
  }
  var name = kebab(prefix + "-" + rootName() + "-" + firstText(source.name, source.id) + "-" + awsKind);
  var seed = name;
  if (seed.length() > 64) {
    seed = seed.substring(0, 64);
  }
  var candidate = seed;
  var index = cachedNextPhysicalNameIndexBySeed.get(seed);
  if (index.isUndefined()) index = 2;
  while (usedAwsPhysicalNames.includes(candidate)) {
    var suffix = "-" + index.asString();
    var baseLength = 64 - suffix.length();
    if (baseLength > seed.length()) {
      baseLength = seed.length();
    }
    candidate = seed.substring(0, baseLength) + suffix;
    index = index + 1;
  }
  cachedNextPhysicalNameIndexBySeed.put(seed, index);
  usedAwsPhysicalNames.add(candidate);
  return candidate;
}

/** Computes owning service name. */
operation owningServiceName(element) {
  var name = cachedPimServiceNameByElementId.get(cacheKeyFor(element));
  if (hasText(name)) {
    return name;
  }
  return "Application";
}

/** Computes owning owner team. */
operation owningOwnerTeam(element) {
  var owner = cachedPimOwnerTeamByElementId.get(cacheKeyFor(element));
  if (hasText(owner)) {
    return owner;
  }
  return "REVIEW_REQUIRED_OWNER";
}

/** Returns whether the receiver is production root. */
operation isProductionRoot() {
  return cachedIsProductionRoot;
}

/** Returns whether the receiver is production pim. */
operation isProductionPim(p) {
  return p.environments.exists(e | e.environmentClass = PIMTYPES!EnvironmentClass#PROD or isTrue(e.productionLike));
}

/** Creates default stage. */
operation defaultStage() {
  if (cachedDefaultStage.isUndefined() and AWSPSMCORE!AwsStage.all.notEmpty()) {
    cachedDefaultStage = AWSPSMCORE!AwsStage.all.first();
  }
  return cachedDefaultStage;
}

/** Creates default stage name. */
operation defaultStageName() {
  var stage = defaultStage();
  if (stage.isDefined() and hasText(stage.stageName)) {
    return stage.stageName;
  }
  return "dev";
}

/** Computes env boolean. */
operation envBoolean(value) {
  if (value.isUndefined()) {
    return false;
  }
  return value;
}

/** Computes set feature. */
operation setFeature(element, featureName : String, value) {
  var feature = element.eClass().getEStructuralFeature(featureName);
  if (feature.isUndefined()) {
    throw "Feature " + featureName + " does not exist on " + element.eClass().getName() + ".";
  }
  element.eSet(feature, value);
}

/** Computes feature value. */
operation featureValue(element, featureName : String) {
  if (element.isUndefined()) {
    return null;
  }
  var feature = element.eClass().getEStructuralFeature(featureName);
  if (feature.isUndefined()) {
    return null;
  }
  return element.eGet(feature);
}

/** Renders json string array. */
operation jsonStringArray(items) {
  var out = "";
  for (item in items) {
    if (hasText(item)) {
      if (hasText(out)) {
        out = out + ", ";
      }
      out = out + "\"" + escapeJson(item) + "\"";
    }
  }
  return "[ " + out + " ]";
}

/** Computes schema to json schema. */
operation schemaToJsonSchema(schema) {
  var key = cacheKeyFor(schema);
  if (hasText(key) and cachedJsonSchemaById.containsKey(key)) {
    return cachedJsonSchemaById.get(key);
  }
  var json = schemaToObjectSchemaVisited(schema, true, Set{});
  if (hasText(key)) {
    cachedJsonSchemaById.put(key, json);
  }
  return json;
}

/** Computes schema to open api schema. */
operation schemaToOpenApiSchema(schema) {
  var key = cacheKeyFor(schema);
  if (hasText(key) and cachedOpenApiSchemaById.containsKey(key)) {
    return cachedOpenApiSchemaById.get(key);
  }
  var json = schemaToObjectSchemaVisited(schema, false, Set{});
  if (hasText(key)) {
    cachedOpenApiSchemaById.put(key, json);
  }
  return json;
}

/** Computes schema to object schema. */
operation schemaToObjectSchema(schema, includeDialect : Boolean) {
  return schemaToObjectSchemaVisited(schema, includeDialect, Set{});
}

/** Computes schema to object schema visited. */
operation schemaToObjectSchemaVisited(schema, includeDialect : Boolean, visited) {
  var schemaKey = cacheKeyFor(schema);
  if (hasText(schemaKey) and visited.includes(schemaKey)) {
    return "{ \"$ref\": \"" + schemaReferenceFor(schema) + "\" }";
  }
  var nestedVisited = Set{};
  nestedVisited.addAll(visited);
  if (hasText(schemaKey)) {
    nestedVisited.add(schemaKey);
  }
  var required = "";
  var properties = "";
  var emittedFieldNames = new Set;
  for (field in schema.fields) {
    var normalizedFieldName = field.name.toLowerCase();
    if (not emittedFieldNames.includes(normalizedFieldName)) {
      emittedFieldNames.add(normalizedFieldName);
      if (hasText(properties)) {
        properties = properties + ", ";
      }
      properties = properties + "\"" + escapeJson(field.name) + "\": " + schemaFieldToJsonVisited(field, nestedVisited);
      if (isTrue(field.required)) {
        if (hasText(required)) {
          required = required + ", ";
        }
        required = required + "\"" + escapeJson(field.name) + "\"";
      }
    }
  }
  var prefix = "";
  if (includeDialect) {
    prefix = "\"$schema\": \"https://json-schema.org/draft/2020-12/schema\", ";
  }
  return "{ " + prefix + "\"title\": \"" + escapeJson(schema.name) +
    "\", \"type\": \"object\", \"additionalProperties\": " + isTrue(schema.additionalPropertiesAllowed).asString() +
    ", \"properties\": { " + properties + " }, \"required\": [ " + required + " ] }";
}

/** Computes schema field to json. */
operation schemaFieldToJson(field) {
  return schemaFieldToJsonVisited(field, Set{});
}

/** Computes schema field to json visited. */
operation schemaFieldToJsonVisited(field, visited) {
  if (isTrue(field.array) or field.fieldType = PIMTYPES!FieldType#ARRAY) {
    var itemJson = "{ \"type\": \"string\" }";
    if (field.arrayItem.isDefined()) {
      itemJson = schemaFieldToJsonVisited(field.arrayItem, visited);
    }
    else {
      if (field.objectSchema.isDefined()) {
        itemJson = schemaToObjectSchemaVisited(field.objectSchema, false, visited);
      }
    }
    return "{ \"type\": \"array\", \"items\": " + itemJson + schemaFieldConstraintJson(field) + " }";
  }
  if (field.objectSchema.isDefined()) {
    return schemaToObjectSchemaVisited(field.objectSchema, false, visited);
  }
  return "{ \"type\": \"" + jsonSchemaTypeForField(field) + "\"" + schemaFieldConstraintJson(field) + " }";
}

/** Computes schema reference for. */
operation schemaReferenceFor(schema) {
  return "#/components/schemas/" + escapeJson(pascalCase(firstText(schema.name, schema.id)));
}

/** Computes schema field constraint json. */
operation schemaFieldConstraintJson(field) {
  var out = "";
  if (field.enumValues.notEmpty()) {
    out = out + ", \"enum\": " + jsonStringArray(field.enumValues.collect(v | v.literal));
  }
  if (hasText(field.format)) {
    out = out + ", \"format\": \"" + escapeJson(field.format) + "\"";
  }
  if (field.minLength.isDefined()) {
    out = out + ", \"minLength\": " + field.minLength.asString();
  }
  if (field.maxLength.isDefined()) {
    out = out + ", \"maxLength\": " + field.maxLength.asString();
  }
  if (hasText(field.pattern)) {
    out = out + ", \"pattern\": \"" + escapeJson(field.pattern) + "\"";
  }
  if (hasText(field.minimum)) {
    if (field.minimum.matches("^-?[0-9]+(\\.[0-9]+)?$")) {
      out = out + ", \"minimum\": " + field.minimum;
    }
    else {
      out = out + ", \"x-minimumText\": \"" + escapeJson(field.minimum) + "\"";
    }
  }
  if (hasText(field.maximum)) {
    if (field.maximum.matches("^-?[0-9]+(\\.[0-9]+)?$")) {
      out = out + ", \"maximum\": " + field.maximum;
    }
    else {
      out = out + ", \"x-maximumText\": \"" + escapeJson(field.maximum) + "\"";
    }
  }
  if (hasText(field.defaultValue)) {
    out = out + ", \"default\": \"" + escapeJson(field.defaultValue) + "\"";
  }
  if (hasText(field.descriptionForConsumers)) {
    out = out + ", \"description\": \"" + escapeJson(field.descriptionForConsumers) + "\"";
  }
  if (isTrue(field.nullable)) {
    out = out + ", \"nullable\": true";
  }
  return out;
}

/** Renders json schema type for field. */
operation jsonSchemaTypeForField(field) {
  if (field.fieldType = PIMTYPES!FieldType#INTEGER) {
    return "integer";
  }
  if (field.fieldType = PIMTYPES!FieldType#NUMBER or field.fieldType = PIMTYPES!FieldType#MONEY) {
    return "number";
  }
  if (field.fieldType = PIMTYPES!FieldType#BOOLEAN) {
    return "boolean";
  }
  if (field.fieldType = PIMTYPES!FieldType#OBJECT) {
    return "object";
  }
  return "string";
}
