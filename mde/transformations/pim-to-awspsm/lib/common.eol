operation initialisePimToAwsPsmCaches() {
  usedModelElementIds = Set{};
  usedAwsLogicalIds = Set{};
  cachedPimRoot = PIM!PIMModel.all.first();
  cachedAwsRoot = null;
  cachedDefaultStack = null;
  cachedDefaultStage = null;
  cachedIsProductionRoot = isProductionPim(cachedPimRoot);
  cachedAwsExistingTargetByKey = new Map;
  cachedPimServiceNameByElementId = new Map;
  cachedPimOwnerTeamByElementId = new Map;
  cachedPimDeploymentAssignedIds = Set{};
  cachedPimDeploymentUnitByElementId = new Map;
  cachedAwsEquivalentBySourceId = new Map;
  cachedAwsGeneratedResources = Sequence{};
  cachedAwsResolvingRelationships = true;
  cachedAwsAuthorizerByApiId = new Map;
  cachedLambdaPermissionByKey = new Map;
  cachedSqsLambdaMappingByKey = new Map;
  cachedSnsSubscriptionByKey = new Map;
  cachedTopicsByEventTypeId = new Map;
  cachedEventBusesByEventTypeId = new Map;
  cachedQueuesByEventTypeId = new Map;
  cachedAwsReadinessDecisionIds = Set{};
  cachedAwsReadinessFindingIds = Set{};
  cachedAwsReadinessCheckIds = Set{};
  cachedAwsTargetHadPreloadedContent =
    AWSPSM!AwsPsmModel.all.notEmpty() or AWSPSMCORE!AwsResource.all.notEmpty() or KERNEL!TraceableElement.all.notEmpty();

  for (element in KERNEL!ModelElement.all.select(e | hasText(e.id))) {
    usedModelElementIds.add(element.id);
  }
  for (resource in AWSPSMCORE!AwsResource.all.select(r | hasText(r.logicalId))) {
    usedAwsLogicalIds.add(resource.logicalId);
  }
  if (cachedAwsTargetHadPreloadedContent) {
    for (resource in AWSPSMCORE!AwsResource.all.select(r | hasText(r.generatedFrom))) {
      cacheExistingTarget(resource);
    }
    for (element in KERNEL!TraceableElement.all.select(e | hasText(e.generatedFrom))) {
      cacheExistingTarget(element);
    }
  }
  cachePimOwnership();
  cachePimEventChannels();
}

operation cacheKeyFor(element) {
  if (element.isUndefined()) {
    return "";
  }
  if (hasText(element.id)) {
    return element.id;
  }
  if (hasText(element.name)) {
    return element.eClass().getName() + "_" + slug(element.name);
  }
  return element.eClass().getName() + "_" + slug(element.asString());
}

operation cacheExistingTarget(target) {
  cachedAwsExistingTargetByKey.put(target.generatedFrom + "::" + target.eClass().getName(), target);
}

operation cachePimOwnership() {
  for (service in cachedPimRoot.services) {
    cachePimServiceOwner(service, service);
    for (fn in service.ownsFunctions) {
      cachePimServiceOwner(fn, service);
    }
    for (api in service.ownsApis) {
      cachePimServiceOwner(api, service);
      for (route in api.routes) {
        cachePimServiceOwner(route, service);
      }
    }
    for (channel in service.ownsChannels) {
      cachePimServiceOwner(channel, service);
    }
    for (store in service.ownsStores) {
      cachePimServiceOwner(store, service);
    }
    for (workflow in service.ownsWorkflows) {
      cachePimServiceOwner(workflow, service);
      for (state in workflow.states) {
        cachePimServiceOwner(state, service);
      }
    }
    for (adapter in service.ownsAdapters) {
      cachePimServiceOwner(adapter, service);
    }
  }
  for (unit in cachedPimRoot.deploymentUnits) {
    for (service in unit.services) {
      cacheDeploymentAssignment(service, unit);
    }
    for (element in unit.contains) {
      cacheDeploymentAssignment(element, unit);
    }
  }
}

operation cachePimServiceOwner(element, service) {
  var key = cacheKeyFor(element);
  if (hasText(key)) {
    cachedPimServiceNameByElementId.put(key, firstText(service.name, "Application"));
    cachedPimOwnerTeamByElementId.put(key, firstText(service.ownerTeam, "REVIEW_REQUIRED_OWNER"));
  }
}

operation cacheDeploymentAssignment(element, unit) {
  var key = cacheKeyFor(element);
  if (hasText(key)) {
    cachedPimDeploymentAssignedIds.add(key);
    cachedPimDeploymentUnitByElementId.put(key, unit);
  }
}

operation addIndexed(index, key, value) {
  if (not hasText(key) or value.isUndefined()) {
    return;
  }
  var values = index.get(key);
  if (values.isUndefined()) {
    values = Sequence{};
    index.put(key, values);
  }
  if (not values.includes(value)) {
    values.add(value);
  }
}

operation indexedValues(index, key) {
  var values = index.get(key);
  if (values.isDefined()) {
    return values;
  }
  return Sequence{};
}

operation cachePimEventChannels() {
  for (topic in INTEGRATION!Topic.all) {
    for (eventType in topic.eventTypes) {
      addIndexed(cachedTopicsByEventTypeId, cacheKeyFor(eventType), topic);
    }
  }
  for (bus in INTEGRATION!EventBus.all) {
    for (eventType in bus.eventTypes) {
      addIndexed(cachedEventBusesByEventTypeId, cacheKeyFor(eventType), bus);
    }
  }
  for (queue in INTEGRATION!Queue.all) {
    for (eventType in queue.eventTypes) {
      addIndexed(cachedQueuesByEventTypeId, cacheKeyFor(eventType), queue);
    }
  }
}

operation awsEquivalent(source) {
  if (source.isUndefined()) {
    return null;
  }
  var key = cacheKeyFor(source);
  if (not hasText(key)) {
    return source.equivalent();
  }
  if (cachedAwsEquivalentBySourceId.containsKey(key)) {
    return cachedAwsEquivalentBySourceId.get(key);
  }
  if (not cachedAwsResolvingRelationships) {
    var target = source.equivalent();
    if (target.isDefined()) {
      cachedAwsEquivalentBySourceId.put(key, target);
    }
    return target;
  }
  return null;
}

operation asText(value) {
  if (value.isUndefined()) {
    return "";
  }
  return value.asString();
}

operation hasText(value) {
  return value.isDefined() and not value.asString().trim().isEmpty();
}

operation firstText(primary, fallback) {
  if (hasText(primary)) {
    return primary.asString();
  }
  if (hasText(fallback)) {
    return fallback.asString();
  }
  return "";
}

operation slug(value) {
  var s = asText(value).toLowerCase().trim().replaceAll("[^a-z0-9]+", "_").replaceAll("^_+|_+$", "");
  if (s.isEmpty()) {
    return "unnamed";
  }
  return s;
}

operation kebab(value) {
  return slug(value).replace("_", "-");
}

operation camelCase(value) {
  var parts = slug(value).split("_");
  if (parts.isEmpty()) {
    return "unnamed";
  }
  var out = parts.first();
  for (part in parts.excluding(parts.first())) {
    if (part.length() > 0) {
      out = out + part.substring(0, 1).toUpperCase() + part.substring(1);
    }
  }
  return out;
}

operation pascalCase(value) {
  var cc = camelCase(value);
  if (cc.isEmpty()) {
    return "Unnamed";
  }
  return cc.substring(0, 1).toUpperCase() + cc.substring(1);
}

operation idFor(prefix : String, source) {
  var seed = source.id;
  if (not hasText(seed)) {
    seed = source.name;
  }
  if (not hasText(seed)) {
    seed = prefix;
  }
  return uniqueId(prefix + "_" + slug(seed));
}

operation generatedId(prefix : String, source, suffix : String) {
  return uniqueId(prefix + "_" + slug(firstText(source.id, source.name) + "_" + suffix));
}

operation uniqueId(base : String) {
  var seed = slug(base);
  var candidate = seed;
  var index = 2;
  while (usedModelElementIds.includes(candidate)) {
    candidate = seed + "_" + index.asString();
    index = index + 1;
  }
  usedModelElementIds.add(candidate);
  return candidate;
}

operation isTrue(value) {
  return value.isDefined() and value;
}

operation positiveOr(value, fallback : Integer) {
  if (value.isDefined() and value > 0) {
    return value;
  }
  return fallback;
}

operation clamp(value : Integer, minimum : Integer, maximum : Integer) {
  if (value < minimum) {
    return minimum;
  }
  if (value > maximum) {
    return maximum;
  }
  return value;
}

operation qualifiedName(element) {
  if (element.isUndefined()) {
    return "";
  }
  if (hasText(element.sourceQualifiedName)) {
    return element.sourceQualifiedName;
  }
  return element.eClass().getName() + "/" + firstText(element.name, element.id);
}

operation escapeJson(value) {
  return asText(value).replace("\"", "\\\"");
}

operation safeJsonText(value) {
  return escapeJson(firstText(value, ""));
}

operation rootName() {
  return firstText(firstText(pimRoot().domainName, pimRoot().name), "Application");
}

operation pimRoot() {
  return cachedPimRoot;
}

operation awsRoot() {
  if (cachedAwsRoot.isUndefined()) {
    cachedAwsRoot = AWSPSM!AwsPsmModel.all.first();
  }
  return cachedAwsRoot;
}

operation copyTraceable(source, target) {
  var preserved = existingTargetFor(source, target.eClass().getName());
  if (preserved.isDefined() and isTrue(preserved.manuallyMaintained)) {
    target.reviewStatus = "SKIPPED_MANUALLY_MAINTAINED_EXISTING_TARGET";
    target.reviewNotes = "An existing manually maintained target with generatedFrom=" + source.id + " was detected. Review before replacing generated output.";
  }
  target.name = firstText(source.name, source.id);
  target.summary = source.summary;
  target.description = source.description;
  target.documentation = source.documentation;
  target.sourceReference = source.sourceReference;
  target.sourceQualifiedName = qualifiedName(source);
  target.traceId = firstText(source.traceId, source.id);
  target.generatedFrom = source.id;
  target.generatedByTransformation = true;
  target.manuallyMaintained = false;
  if (hasText(source.id) and not cachedAwsEquivalentBySourceId.containsKey(source.id)) {
    cachedAwsEquivalentBySourceId.put(source.id, target);
  }
}

operation existingTargetFor(source, className : String) {
  if (not cachedAwsTargetHadPreloadedContent or not hasText(source.id)) {
    return null;
  }
  return cachedAwsExistingTargetByKey.get(source.id + "::" + className);
}

operation copyAwsResource(source, target, kind : String, awsType : String) {
  copyTraceable(source, target);
  if (not cachedAwsGeneratedResources.includes(target)) {
    cachedAwsGeneratedResources.add(target);
  }
  target.logicalId = logicalId(source, kind);
  target.physicalName = physicalName(source, kind.toLowerCase(), defaultStage());
  target.awsResourceType = awsType;
  target.resourceDescription = firstText(source.summary, source.description);
  if (isProductionRoot()) {
    target.deletionPolicy = AWSPSMENUMS!CloudFormationDeletionPolicy#RETAIN;
    target.updateReplacePolicy = AWSPSMENUMS!CloudFormationUpdateReplacePolicy#RETAIN;
  }
  else {
    target.deletionPolicy = AWSPSMENUMS!CloudFormationDeletionPolicy#DELETE;
    target.updateReplacePolicy = AWSPSMENUMS!CloudFormationUpdateReplacePolicy#DELETE;
  }
  target.retainInProduction = isProductionRoot();
  target.productionCritical = isProductionRoot();
  target.importedResource = false;
  target.tags.add(tag("GeneratedFromPIM", firstText(source.name, source.id)));
  target.tags.add(tag("Service", owningServiceName(source)));
  target.tags.add(tag("Owner", owningOwnerTeam(source)));
  target.tags.add(tag("Environment", defaultStageName()));
}

operation logicalId(source, awsKind : String) {
  return uniqueLogicalId(pascalCase(firstText(firstText(source.name, source.externalId), source.id)) + awsKind);
}

operation uniqueLogicalId(base : String) {
  var seed = pascalCase(base);
  var candidate = seed;
  var index = 2;
  while (usedAwsLogicalIds.includes(candidate)) {
    candidate = seed + index.asString();
    index = index + 1;
  }
  usedAwsLogicalIds.add(candidate);
  return candidate;
}

operation physicalName(source, awsKind : String, stage) {
  var prefix = "default";
  if (stage.isDefined()) {
    prefix = stage.stageName;
  }
  var name = kebab(prefix + "-" + rootName() + "-" + firstText(source.name, source.id) + "-" + awsKind);
  if (name.length() > 64) {
    return name.substring(0, 64);
  }
  return name;
}

operation owningServiceName(element) {
  var name = cachedPimServiceNameByElementId.get(cacheKeyFor(element));
  if (hasText(name)) {
    return name;
  }
  return "Application";
}

operation owningOwnerTeam(element) {
  var owner = cachedPimOwnerTeamByElementId.get(cacheKeyFor(element));
  if (hasText(owner)) {
    return owner;
  }
  return "REVIEW_REQUIRED_OWNER";
}

operation isProductionRoot() {
  return cachedIsProductionRoot;
}

operation isProductionPim(p) {
  return p.environments.exists(e | e.environmentClass = PIMTYPES!EnvironmentClass#PROD or isTrue(e.productionLike));
}

operation defaultStage() {
  if (cachedDefaultStage.isUndefined() and AWSPSMCORE!AwsStage.all.notEmpty()) {
    cachedDefaultStage = AWSPSMCORE!AwsStage.all.first();
  }
  return cachedDefaultStage;
}

operation defaultStageName() {
  var stage = defaultStage();
  if (stage.isDefined() and hasText(stage.stageName)) {
    return stage.stageName;
  }
  return "dev";
}

operation envBoolean(value) {
  if (value.isUndefined()) {
    return false;
  }
  return value;
}

operation setFeature(element, featureName : String, value) {
  var feature = element.eClass().getEStructuralFeature(featureName);
  if (feature.isUndefined()) {
    throw "Feature " + featureName + " does not exist on " + element.eClass().getName() + ".";
  }
  element.eSet(feature, value);
}

operation featureValue(element, featureName : String) {
  if (element.isUndefined()) {
    return null;
  }
  var feature = element.eClass().getEStructuralFeature(featureName);
  if (feature.isUndefined()) {
    return null;
  }
  return element.eGet(feature);
}

operation jsonStringArray(items) {
  var out = "";
  for (item in items) {
    if (hasText(item)) {
      if (hasText(out)) {
        out = out + ", ";
      }
      out = out + "\"" + escapeJson(item) + "\"";
    }
  }
  return "[ " + out + " ]";
}

operation schemaToJsonSchema(schema) {
  return schemaToObjectSchemaVisited(schema, true, Set{});
}

operation schemaToOpenApiSchema(schema) {
  return schemaToObjectSchemaVisited(schema, false, Set{});
}

operation schemaToObjectSchema(schema, includeDialect : Boolean) {
  return schemaToObjectSchemaVisited(schema, includeDialect, Set{});
}

operation schemaToObjectSchemaVisited(schema, includeDialect : Boolean, visited) {
  var schemaKey = cacheKeyFor(schema);
  if (hasText(schemaKey) and visited.includes(schemaKey)) {
    return "{ \"$ref\": \"" + schemaReferenceFor(schema) + "\" }";
  }
  var nestedVisited = Set{};
  nestedVisited.addAll(visited);
  if (hasText(schemaKey)) {
    nestedVisited.add(schemaKey);
  }
  var required = "";
  var properties = "";
  for (field in schema.fields) {
    if (hasText(properties)) {
      properties = properties + ", ";
    }
    properties = properties + "\"" + escapeJson(field.name) + "\": " + schemaFieldToJsonVisited(field, nestedVisited);
    if (isTrue(field.required)) {
      if (hasText(required)) {
        required = required + ", ";
      }
      required = required + "\"" + escapeJson(field.name) + "\"";
    }
  }
  var prefix = "";
  if (includeDialect) {
    prefix = "\"$schema\": \"https://json-schema.org/draft/2020-12/schema\", ";
  }
  return "{ " + prefix + "\"title\": \"" + escapeJson(schema.name) +
    "\", \"type\": \"object\", \"additionalProperties\": " + isTrue(schema.additionalPropertiesAllowed).asString() +
    ", \"properties\": { " + properties + " }, \"required\": [ " + required + " ] }";
}

operation schemaFieldToJson(field) {
  return schemaFieldToJsonVisited(field, Set{});
}

operation schemaFieldToJsonVisited(field, visited) {
  if (isTrue(field.array) or field.fieldType = PIMTYPES!FieldType#ARRAY) {
    var itemJson = "{ \"type\": \"string\" }";
    if (field.arrayItem.isDefined()) {
      itemJson = schemaFieldToJsonVisited(field.arrayItem, visited);
    }
    else {
      if (field.objectSchema.isDefined()) {
        itemJson = schemaToObjectSchemaVisited(field.objectSchema, false, visited);
      }
    }
    return "{ \"type\": \"array\", \"items\": " + itemJson + schemaFieldConstraintJson(field) + " }";
  }
  if (field.objectSchema.isDefined()) {
    return schemaToObjectSchemaVisited(field.objectSchema, false, visited);
  }
  return "{ \"type\": \"" + jsonSchemaTypeForField(field) + "\"" + schemaFieldConstraintJson(field) + " }";
}

operation schemaReferenceFor(schema) {
  return "#/components/schemas/" + escapeJson(pascalCase(firstText(schema.name, schema.id)));
}

operation schemaFieldConstraintJson(field) {
  var out = "";
  if (field.enumValues.notEmpty()) {
    out = out + ", \"enum\": " + jsonStringArray(field.enumValues.collect(v | v.literal));
  }
  if (hasText(field.format)) {
    out = out + ", \"format\": \"" + escapeJson(field.format) + "\"";
  }
  if (field.minLength.isDefined()) {
    out = out + ", \"minLength\": " + field.minLength.asString();
  }
  if (field.maxLength.isDefined()) {
    out = out + ", \"maxLength\": " + field.maxLength.asString();
  }
  if (hasText(field.pattern)) {
    out = out + ", \"pattern\": \"" + escapeJson(field.pattern) + "\"";
  }
  if (hasText(field.minimum)) {
    if (field.minimum.matches("^-?[0-9]+(\\.[0-9]+)?$")) {
      out = out + ", \"minimum\": " + field.minimum;
    }
    else {
      out = out + ", \"x-minimumText\": \"" + escapeJson(field.minimum) + "\"";
    }
  }
  if (hasText(field.maximum)) {
    if (field.maximum.matches("^-?[0-9]+(\\.[0-9]+)?$")) {
      out = out + ", \"maximum\": " + field.maximum;
    }
    else {
      out = out + ", \"x-maximumText\": \"" + escapeJson(field.maximum) + "\"";
    }
  }
  if (hasText(field.defaultValue)) {
    out = out + ", \"default\": \"" + escapeJson(field.defaultValue) + "\"";
  }
  if (hasText(field.descriptionForConsumers)) {
    out = out + ", \"description\": \"" + escapeJson(field.descriptionForConsumers) + "\"";
  }
  if (isTrue(field.nullable)) {
    out = out + ", \"nullable\": true";
  }
  return out;
}

operation jsonSchemaTypeForField(field) {
  if (field.fieldType = PIMTYPES!FieldType#INTEGER) {
    return "integer";
  }
  if (field.fieldType = PIMTYPES!FieldType#NUMBER or field.fieldType = PIMTYPES!FieldType#MONEY) {
    return "number";
  }
  if (field.fieldType = PIMTYPES!FieldType#BOOLEAN) {
    return "boolean";
  }
  if (field.fieldType = PIMTYPES!FieldType#OBJECT) {
    return "object";
  }
  return "string";
}
