/** Provides reusable aws builders operations. */
import "common.eol";
import "readiness-trace.eol";

/** Computes map environment class. */
operation mapEnvironmentClass(c) {
  if (c = PIMTYPES!EnvironmentClass#PROD) {
    return AWSPSMENUMS!AwsEnvironmentClass#PROD;
  }
  if (c = PIMTYPES!EnvironmentClass#STAGING) {
    return AWSPSMENUMS!AwsEnvironmentClass#STAGING;
  }
  if (c = PIMTYPES!EnvironmentClass#TEST) {
    return AWSPSMENUMS!AwsEnvironmentClass#TEST;
  }
  if (c = PIMTYPES!EnvironmentClass#SANDBOX) {
    return AWSPSMENUMS!AwsEnvironmentClass#SANDBOX;
  }
  return AWSPSMENUMS!AwsEnvironmentClass#DEV;
}

/** Derives infer region. */
operation inferRegion(environment) {
  if (environment.isUndefined()) {
    return "";
  }
  var p = environment.parameters.selectOne(x | x.name.toLowerCase() = "region" or x.name.toLowerCase() = "awsregion" or x.name.toLowerCase() = "aws_region");
  if (p.isDefined() and hasText(p.defaultValue)) {
    return p.defaultValue;
  }
  return "";
}

/** Derives infer default region. */
operation inferDefaultRegion(p) {
  var e = p.environments.selectOne(x | hasText(inferRegion(x)));
  if (e.isDefined()) {
    return inferRegion(e);
  }
  return "us-east-1";
}

/** Computes tag. */
operation tag(key : String, value : String) {
  var t = new AWSPSMCORE!AwsTag;
  t.id = uniqueId("tag_" + slug(key + "_" + value));
  t.name = key;
  t.key = key;
  t.value = value;
  t.propagated = true;
  t.generatedByTransformation = true;
  t.manuallyMaintained = false;
  return t;
}

/** Computes literal value. */
operation literalValue(value : String, secret : Boolean) {
  var v = new AWSPSMCORE!ValueExpression;
  v.id = uniqueId("value_" + slug(value));
  v.name = "Literal value";
  v.sourceKind = AWSPSMENUMS!ValueSourceKind#PLAINTEXT;
  v.literal = value;
  v.secret = secret;
  return v;
}

/** Computes secret reference value. */
operation secretReferenceValue(referenceText : String) {
  var resolvedReference = firstText(referenceText, "REVIEW_REQUIRED_SECRET_REFERENCE");
  var v = new AWSPSMCORE!ValueExpression;
  v.id = uniqueId("secret_ref_" + slug(resolvedReference));
  v.name = "Secrets Manager reference";
  v.sourceKind = AWSPSMENUMS!ValueSourceKind#SECRETS_MANAGER_REFERENCE;
  v.expression = resolvedReference;
  v.secret = true;
  return v;
}

/** Computes ssm secure reference value. */
operation ssmSecureReferenceValue(referenceText : String) {
  var resolvedReference = firstText(referenceText, "REVIEW_REQUIRED_SSM_SECURE_REFERENCE");
  var v = new AWSPSMCORE!ValueExpression;
  v.id = uniqueId("ssm_secure_ref_" + slug(resolvedReference));
  v.name = "SSM secure reference";
  v.sourceKind = AWSPSMENUMS!ValueSourceKind#SSM_SECURE_REFERENCE;
  v.expression = resolvedReference;
  v.secret = true;
  return v;
}

/** Computes ref value. */
operation refValue(resource) {
  if (resource.isUndefined()) {
    return literalValue("REVIEW_REQUIRED_RESOURCE_REF", false);
  }
  var v = new AWSPSMCORE!ValueExpression;
  v.id = uniqueId("ref_" + slug(resource.id));
  v.name = "Ref " + resource.logicalId;
  v.sourceKind = AWSPSMENUMS!ValueSourceKind#CLOUDFORMATION_REF;
  v.resource = resource;
  return v;
}

/** Returns get att. */
operation getAtt(resource, attributeName : String) {
  if (resource.isUndefined()) {
    return literalValue("REVIEW_REQUIRED_RESOURCE_GETATT_" + attributeName, false);
  }
  var v = new AWSPSMCORE!ValueExpression;
  v.id = uniqueId("getatt_" + slug(resource.id + "_" + attributeName));
  v.name = "GetAtt " + resource.logicalId + "." + attributeName;
  v.sourceKind = AWSPSMENUMS!ValueSourceKind#CLOUDFORMATION_GETATT;
  v.resource = resource;
  v.attributeName = attributeName;
  return v;
}

/** Computes native text. */
operation nativeText(name : String, value : String, fmt, required : Boolean, secret : Boolean) {
  var p = new AWSPSMCORE!NativeProperty;
  p.id = uniqueId("native_" + slug(name + "_" + value));
  p.name = name;
  p.propertyName = name;
  p.format = fmt;
  p.value = literalValue(value, secret);
  p.required = required;
  p.secret = secret;
  p.validationState = AWSPSMENUMS!Decision#GENERATOR_OWNED;
  return p;
}

/** Creates create naming policy. */
operation createNamingPolicy(source) {
  var p = new AWSPSMCORE!AwsNamingPolicy;
  p.id = generatedId("naming", source, "aws");
  p.name = "AWS Naming Policy";
  p.logicalIdPattern = "PascalCase(source name + AWS kind)";
  p.physicalNamePattern = "stage-domain-source-kind";
  p.includeStageInPhysicalNames = true;
  p.includeServiceInPhysicalNames = true;
  p.allowGeneratedPhysicalNames = true;
  p.generatedByTransformation = true;
  return p;
}

/** Creates create tagging policy. */
operation createTaggingPolicy(source) {
  var p = new AWSPSMCORE!AwsTaggingPolicy;
  p.id = generatedId("tagging", source, "aws");
  p.name = "AWS Tagging Policy";
  p.requireOwnerTag = true;
  p.requireEnvironmentTag = true;
  p.requireCostCenterTag = false;
  p.propagateStackTags = true;
  p.requiredTags.add(tag("GeneratedFromPIM", source.name));
  p.requiredTags.add(tag("Service", "Application"));
  p.generatedByTransformation = true;
  return p;
}

/** Creates create security baseline. */
operation createSecurityBaseline(source) {
  var b = new AWSPSMCORE!AwsSecurityBaseline;
  b.id = generatedId("security_baseline", source, "aws");
  b.name = "AWS Security Baseline";
  b.encryptionAtRestDefault = true;
  b.publicAccessBlockedDefault = true;
  b.xrayDefault = true;
  b.structuredLogsDefault = true;
  b.leastPrivilegeRequired = true;
  b.productionDeletionProtectionDefault = isProductionPim(source);
  b.generatedByTransformation = true;
  return b;
}

/** Creates create sam globals. */
operation createSamGlobals(source) {
  var g = new AWSPSMCORE!SamGlobals;
  g.id = generatedId("sam_globals", source, "aws");
  g.name = "SAM Globals";
  g.functionGlobals.add(nativeText("RuntimeManagementConfig", "Auto", KERNEL!StructuredFormat#TEXT, false, false));
  g.functionGlobals.add(nativeText("Tracing", "Active", KERNEL!StructuredFormat#TEXT, false, false));
  g.apiGlobals.add(nativeText("EndpointConfiguration", "REGIONAL", KERNEL!StructuredFormat#TEXT, false, false));
  g.generatedByTransformation = true;
  return g;
}

/** Creates create default stage. */
operation createDefaultStage(source) {
  var s = new AWSPSMCORE!AwsStage;
  s.id = generatedId("stage", source, "default");
  s.name = "dev";
  s.stageName = "dev";
  s.environmentClass = AWSPSMENUMS!AwsEnvironmentClass#DEV;
  s.region = inferDefaultRegion(source);
  s.requiresManualApproval = false;
  s.confirmChangeset = false;
  s.failOnEmptyChangeset = false;
  s.stackNamePrefix = kebab(rootName()) + "-dev";
  s.stageTags.add(tag("Environment", "dev"));
  s.stageTags.add(tag("GeneratedFromPIM", source.name));
  s.generatedByTransformation = true;
  return s;
}

/** Creates create default stack. */
operation createDefaultStack(source) {
  var s = new AWSPSMCORE!SamStack;
  s.id = generatedId("stack", source, "default");
  s.name = "Default Application Stack";
  s.stackName = kebab(rootName()) + "-application-stack";
  s.templatePath = "template-application.yaml";
  s.templateDescription = "Generated AWS SAM stack for unassigned PIM deployables.";
  s.useSamTransform = true;
  s.packageIndividually = false;
  s.validateWithSam = true;
  s.validateWithCfnLint = true;
  s.capabilities.add(AWSPSMENUMS!SamCapability#CAPABILITY_IAM);
  s.generatedByTransformation = true;
  return s;
}

/** Creates default runtime. */
operation defaultRuntime(profile) {
  if (profile.isUndefined()) {
    return "";
  }
  if (profile.primaryLanguage = PIMTYPES!RuntimeLanguage#PYTHON) {
    return "python" + firstText(profile.languageVersion, "3.12");
  }
  if (profile.primaryLanguage = PIMTYPES!RuntimeLanguage#JAVA) {
    return "java" + firstText(profile.languageVersion, "21");
  }
  if (profile.primaryLanguage = PIMTYPES!RuntimeLanguage#JAVASCRIPT) {
    return "nodejs" + firstText(profile.languageVersion, "22.x");
  }
  if (profile.primaryLanguage = PIMTYPES!RuntimeLanguage#TYPESCRIPT) {
    return "nodejs" + firstText(profile.languageVersion, "22.x");
  }
  if (profile.primaryLanguage = PIMTYPES!RuntimeLanguage#CSHARP) {
    return "dotnet8";
  }
  if (profile.primaryLanguage = PIMTYPES!RuntimeLanguage#GO) {
    return "provided.al2023";
  }
  if (profile.primaryLanguage = PIMTYPES!RuntimeLanguage#RUST) {
    return "provided.al2023";
  }
  return "nodejs22.x";
}

/** Derives infer handler. */
operation inferHandler(f) {
  if (hasText(f.sourceNameSuggestion)) {
    return f.sourceNameSuggestion;
  }
  return camelCase(firstText(f.name, f.id)) + ".handler";
}

/** Creates create lambda code config. */
operation createLambdaCodeConfig(f, profile) {
  if (usesImagePackage(f)) {
    var img = new AWSPSMCOMPUTE!LambdaImageCodeConfig;
    img.id = generatedId("lambda_code", f, "image");
    img.name = firstText(f.name, "Function") + " Image Code";
    img.imageUri = modelTagValue(f, "lambda.imageUri");
    if (not hasText(img.imageUri)) {
      img.imageUri = "REVIEW_REQUIRED_IMAGE_URI";
      manualDecision("LAMBDA_IMAGE_URI_MISSING",
        "Provide container image URI for Lambda " + f.name + ".",
        KERNEL!Severity#ERROR, true, Sequence{f},
        "Set lambda.imageUri metadata or use ZIP packaging.");
    }
    img.generatedByTransformation = true;
    return img;
  }
  var zip = new AWSPSMCOMPUTE!LambdaZipCodeConfig;
  zip.id = generatedId("lambda_code", f, "zip");
  zip.name = firstText(f.name, "Function") + " Code";
  if (profile.isDefined()) {
    zip.codeUri = firstText(profile.sourceLayout, "src/functions/" + kebab(f.name));
  }
  else {
    zip.codeUri = "src/functions/" + kebab(f.name);
  }
  zip.runtimeIdentifier = defaultRuntime(profile);
  zip.handler = inferHandler(f);
  zip.generatedByTransformation = true;
  if (not hasText(zip.runtimeIdentifier)) {
    manualDecision("LAMBDA_RUNTIME_MISSING",
      "Choose a Lambda runtime for " + f.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{f},
      "Set PIM implementationProfile.primaryLanguage/languageVersion or provide an AWS runtime override.");
  }
  if (not hasText(zip.handler)) {
    manualDecision("LAMBDA_HANDLER_MISSING",
      "Choose a Lambda handler for " + f.name + ".",
      KERNEL!Severity#ERROR, true, Sequence{f},
      "Set Function.sourceNameSuggestion or implementation artifact metadata.");
  }
  return zip;
}

/** Returns whether the receiver uses image package. */
operation usesImagePackage(f) {
  var tags = asText(f.modelTags).toLowerCase();
  return tags.contains("lambda.packagetype=image") or tags.contains("package=image");
}

/** Computes annotation value. */
operation annotationValue(text, key : String) {
  if (not hasText(text)) {
    return "";
  }
  var parts = text.split(";");
  for (part in parts) {
    var kv = part.split("=");
    if (kv.size() >= 2 and kv.first().trim().toLowerCase() = key.toLowerCase()) {
      return kv.at(1).trim();
    }
  }
  return "";
}

/** Returns a semicolon-delimited metadata value from the receiver's multi-valued model tags. */
operation modelTagValue(element, key : String) {
  if (element.isUndefined() or element.eClass().getEStructuralFeature("modelTags").isUndefined()) {
    return "";
  }
  for (tagText in element.modelTags) {
    var value = annotationValue(tagText, key);
    if (hasText(value)) {
      return value;
    }
  }
  return "";
}

/** Creates create log group for. */
operation createLogGroupFor(source, logicalSeed : String, logName : String) {
  var g = new AWSPSMOBSERVABILITY!CloudWatchLogGroup;
  registerAwsGeneratedResource(g);
  g.id = generatedId("log_group", source, source.id);
  g.name = firstText(source.name, logicalSeed) + " Log Group";
  g.generatedFrom = source.id;
  g.generatedByTransformation = true;
  g.manuallyMaintained = false;
  g.logicalId = uniqueLogicalId(pascalCase(logicalSeed) + "LogGroup");
  g.physicalName = logName;
  g.awsResourceType = "AWS::Logs::LogGroup";
  g.logGroupName = logName;
  g.deletionPolicy = AWSPSMENUMS!CloudFormationDeletionPolicy#RETAIN;
  g.updateReplacePolicy = AWSPSMENUMS!CloudFormationUpdateReplacePolicy#RETAIN;
  g.retainInProduction = isProductionRoot();
  g.productionCritical = isProductionRoot();
  g.importedResource = false;
  g.tags.add(tag("GeneratedFromPIM", firstText(source.name, source.id)));
  g.tags.add(tag("Service", owningServiceName(source)));
  g.tags.add(tag("Owner", owningOwnerTeam(source)));
  g.tags.add(tag("Environment", defaultStageName()));
  applyProductionDefaults(g);
  if (isProductionRoot()) {
    g.retentionDays = 90;
  }
  else {
    g.retentionDays = 30;
  }
  g.logGroupClass = AWSPSMENUMS!LogGroupClass#STANDARD;
  g.generatedByTransformation = true;
  return g;
}

/** Computes policy document. */
operation policyDocument() {
  var doc = new AWSPSMSECURITY!IamPolicyDocument;
  doc.id = uniqueId("policy_doc_generated");
  doc.name = "Policy document";
  doc.version = "2012-10-17";
  return doc;
}

/** Computes service assume role policy. */
operation serviceAssumeRolePolicy(service : String) {
  var doc = policyDocument();
  var st = allowStatement("AssumeRole");
  st.actions.add("sts:AssumeRole");
  var p = new AWSPSMSECURITY!IamPrincipal;
  p.id = uniqueId("principal_" + slug(service));
  p.name = service;
  p.principalType = "Service";
  p.identifiers.add(service);
  st.principals.add(p);
  doc.statements.add(st);
  return doc;
}

/** Returns allow statement. */
operation allowStatement(sid : String) {
  var st = new AWSPSMSECURITY!IamStatement;
  st.id = uniqueId("stmt_" + slug(sid));
  st.name = sid;
  st.sid = sid;
  st.effect = AWSPSMENUMS!IamEffect#ALLOW;
  st.wildcardAction = false;
  st.wildcardResource = false;
  return st;
}

/** Computes permission statement. */
operation permissionStatement(perm) {
  var actionText = firstText(perm.action, "*");
  var resourceText = firstText(perm.resource, "*");
  if (not actionText.validAwsIamActionText() or not resourceText.validAwsIamResourceText()) {
    manualDecision("IAM_PERMISSION_AWS_BINDING_REQUIRED",
      "Permission " + firstText(perm.name, perm.id) + " is provider-independent and cannot be emitted as an AWS IAM statement.",
      KERNEL!Severity#ERROR, true, Sequence{perm},
      "Bind the permission to an AWS service:operation action and an ARN, CloudFormation intrinsic, or justified wildcard resource.");
    return null;
  }
  var st = allowStatement(firstText(perm.name, "Permission"));
  if (perm.effect = PIMTYPES!PermissionEffect#DENY) {
    st.effect = AWSPSMENUMS!IamEffect#DENY;
  }
  st.actions.add(actionText);
  st.resources.add(resourceText);
  st.wildcardAction = st.actions.includes("*") or st.actions.exists(a | a.endsWith(":*"));
  st.wildcardResource = st.resources.includes("*");
  if (st.wildcardAction or st.wildcardResource or not isTrue(perm.leastPrivilegeConfirmed)) {
    manualDecision("IAM_WILDCARD_REVIEW",
      "Review IAM permission " + firstText(perm.name, perm.action) + " for least privilege.",
      KERNEL!Severity#WARNING, isProductionRoot(), Sequence{perm},
      "Replace wildcard action/resource with AWS-specific actions and generated resource ARNs.");
  }
  return st;
}

/** Returns whether text can be emitted as an AWS IAM action. */
operation Any validAwsIamActionText() {
  return hasText(self) and (self.asString() = "*" or self.asString().matches("^[A-Za-z0-9-]+:[A-Za-z0-9*]+$"));
}

/** Returns whether text can be emitted as an AWS IAM resource. */
operation Any validAwsIamResourceText() {
  return hasText(self) and (self.asString() = "*" or self.asString().startsWith("arn:") or self.asString().startsWith("!"));
}

/** Creates create lambda permission for. */
operation createLambdaPermissionFor(prefix : String, origin, fn, principal : String) {
  return createLambdaPermissionFor(prefix, origin, fn, principal, sourceArnFor(origin));
}

/** Creates create lambda permission for. */
operation createLambdaPermissionFor(prefix : String, origin, fn, principal : String, sourceArnExpression : String) {
  if (fn.isUndefined()) {
    return null;
  }
  var key = prefix + "::" + principal + "::" + fn.logicalId + "::" + firstText(sourceArnExpression, "");
  if (cachedLambdaPermissionByKey.containsKey(key)) {
    return cachedLambdaPermissionByKey.get(key);
  }
  var p = new AWSPSMCOMPUTE!LambdaPermission;
  copyAwsResource(origin, p, prefix + "Permission", "AWS::Lambda::Permission");
  // Logical IDs are name-derived and may change when a PIM function is renamed. Keep generated
  // object identity tied to immutable model IDs so synchronization matches the existing object.
  p.id = generatedId("lambda_permission", origin, prefix + "_" + fn.id);
  p.action = "lambda:InvokeFunction";
  p.principal = principal;
  p.sourceArn = sourceArnExpression;
  if (not hasText(sourceArnExpression)) {
    manualDecision("LAMBDA_PERMISSION_SOURCE_ARN_REQUIRED",
      "Provide source ARN for " + principal + " invoking Lambda " + fn.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{origin, fn},
      "Set the invoking API, EventBridge rule/schedule, SNS topic, S3 bucket, or other source so Lambda permission can be least-privilege scoped.");
  }
  fn.permissions.add(p);
  cachedLambdaPermissionByKey.put(key, p);
  if (not cachedLambdaPermissionByKey.containsKey(prefix + "::" + principal + "::" + fn.logicalId)) {
    cachedLambdaPermissionByKey.put(prefix + "::" + principal + "::" + fn.logicalId, p);
  }
  return p;
}

/** Computes source arn for. */
operation sourceArnFor(origin) {
  if (origin.isUndefined()) {
    return "";
  }
  if (isApiGatewayRoute(origin)) {
    return apiGatewayRouteSourceArn(origin);
  }
  var apiRoute = featureValue(origin, "apiRoute");
  if (apiRoute.isDefined()) {
    return apiGatewayRouteSourceArn(apiRoute);
  }
  var source = featureValue(origin, "source");
  if (source.isDefined()) {
    return sourceArnFor(source);
  }
  var channel = featureValue(origin, "channel");
  if (channel.isDefined()) {
    return sourceArnFor(channel);
  }
  var equivalent = awsEquivalent(origin);
  if (equivalent.isDefined() and equivalent.eClass().getEStructuralFeature("logicalId").isDefined()) {
    return cfnArnExpression(equivalent);
  }
  if (origin.eClass().getEStructuralFeature("logicalId").isDefined() and hasText(origin.logicalId)) {
    return cfnArnExpression(origin);
  }
  return "";
}

/** Computes cfn arn expression. */
operation cfnArnExpression(resource) : String {
  if (resource.isUndefined() or resource.eClass().getEStructuralFeature("logicalId").isUndefined() or not hasText(resource.logicalId)) {
    return "";
  }
  return "!GetAtt " + resource.logicalId + ".Arn";
}

/** Computes cfn arn sub expression. */
operation cfnArnSubExpression(resource, suffix : String) : String {
  if (resource.isUndefined() or resource.eClass().getEStructuralFeature("logicalId").isUndefined() or not hasText(resource.logicalId)) {
    return "";
  }
  return "!Sub '${" + resource.logicalId + ".Arn}" + suffix + "'";
}

/** Returns whether the receiver is api gateway route. */
operation isApiGatewayRoute(element) : Boolean {
  if (element.isUndefined()) {
    return false;
  }
  var className = element.eClass().getName();
  return className = "ApiRoute" or className = "HttpApiRoute" or className = "RestApiRoute" or className = "RestApiMethod" or className = "WebSocketRoute";
}

/** Computes api gateway route source arn. */
operation apiGatewayRouteSourceArn(route) : String {
  if (route.isUndefined()) {
    return "";
  }
  var routeResource = awsEquivalent(route);
  if (routeResource.isUndefined()) {
    routeResource = route;
  }
  var apiResource = featureValue(routeResource, "api");
  if (apiResource.isUndefined()) {
    var sourceApi = featureValue(route, "api");
    if (sourceApi.isDefined()) {
      apiResource = awsEquivalent(sourceApi);
    }
  }
  if (apiResource.isUndefined() or apiResource.eClass().getEStructuralFeature("logicalId").isUndefined() or not hasText(apiResource.logicalId)) {
    return "";
  }
  var methodText = "*";
  var methodValue = featureValue(routeResource, "method");
  if (methodValue.isUndefined()) {
    methodValue = featureValue(route, "method");
  }
  if (hasText(methodValue) and methodValue.asString() <> "ANY") {
    methodText = methodValue.asString();
  }
  var pathValue = featureValue(routeResource, "path");
  if (pathValue.isUndefined()) {
    var resourceValue = featureValue(routeResource, "resource");
    if (resourceValue.isDefined()) {
      pathValue = featureValue(resourceValue, "fullPath");
    }
  }
  if (pathValue.isUndefined()) {
    pathValue = featureValue(route, "pathTemplate");
  }
  var pathText = normalizeExecuteApiPath(pathValue);
  return "!Sub 'arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${" + apiResource.logicalId + "}/*/" + methodText + "/" + pathText + "'";
}

/** Converts the receiver to normalize execute api path. */
operation normalizeExecuteApiPath(pathValue) : String {
  var pathText = asText(pathValue).trim();
  if (pathText.isEmpty()) {
    return "*";
  }
  if (pathText.startsWith("/")) {
    pathText = pathText.substring(1);
  }
  if (pathText.isEmpty()) {
    return "*";
  }
  return pathText.replaceAll("\\{[^/]+\\}", "*");
}

// Inlined AWS relationship resolution helpers.
operation defaultStack() {
  if (cachedDefaultStack.isUndefined() and AWSPSMCORE!SamStack.all.notEmpty()) {
    cachedDefaultStack = AWSPSMCORE!SamStack.all.first();
  }
  return cachedDefaultStack;
}

/** Computes place uncontained aws resources. */
operation placeUncontainedAwsResources() {
  flagUnassignedDeployables();
  var st = defaultStack();

  // Place resources with explicit PIM deployment-unit ownership first.
  for (r in cachedAwsGeneratedResources) {
    if (r.stack.isUndefined() and not isNestedAwsResource(r)) {
      var targetStack = stackForGeneratedResource(r);
      if (targetStack.isDefined()) {
        targetStack.resources.add(r);
      }
    }
  }

  // Supporting resources inherit ownership from the resources they reference.
  // Iterate because routes, integrations, permissions, policies, and DLQs form
  // short dependency chains whose owner may only become known in a prior pass.
  var madeProgress = true;
  while (madeProgress) {
    madeProgress = false;
    for (r in cachedAwsGeneratedResources.select(r | r.stack.isUndefined() and not isNestedAwsResource(r))) {
      var inferredStack = inferredStackForGeneratedResource(r);
      if (inferredStack.isDefined()) {
        inferredStack.resources.add(r);
        madeProgress = true;
      }
    }
  }

  // Truly unowned resources remain reviewable in the default stack.
  for (r in cachedAwsGeneratedResources.select(r | r.stack.isUndefined() and not isNestedAwsResource(r))) {
    if (st.isDefined()) {
      st.resources.add(r);
    }
  }

  if (st.isDefined()) {
    for (p in AWSPSMCORE!CfnParameter.all) {
      if (p.eContainer().isUndefined()) {
        st.parameters.add(p);
      }
    }
  }
  for (doc in KERNEL!StructuredDocument.all) {
    if (doc.eContainer().isUndefined() and not awsRoot().documents.includes(doc)) {
      awsRoot().documents.add(doc);
    }
  }
  for (stage in AWSPSMCORE!AwsStage.all) {
    for (stack in AWSPSMCORE!SamStack.all) {
      addStageStackOnce(stage, stack);
    }
  }
}

/** Infers one unambiguous owner stack from already placed referenced resources. */
operation inferredStackForGeneratedResource(resource) {
  var candidateStacks = new Set;
  for (referenceObj in resource.eClass().getEAllReferences().select(referenceObj | not referenceObj.isContainment())) {
    var referencedValue = resource.eGet(referenceObj);
    if (referenceObj.isMany()) {
      for (targetObj in referencedValue.select(targetObj | targetObj.isKindOf(AWSPSMCORE!AwsResource) and targetObj.stack.isDefined())) {
        candidateStacks.add(targetObj.stack);
      }
    }
    else if (referencedValue.isDefined() and referencedValue.isKindOf(AWSPSMCORE!AwsResource) and referencedValue.stack.isDefined()) {
      candidateStacks.add(referencedValue.stack);
    }
  }
  if (candidateStacks.size() = 1) {
    return candidateStacks.first();
  }
  return null;
}

/** Adds or records add stage stack once. */
operation addStageStackOnce(stage, stack) {
  if (stage.isUndefined() or stack.isUndefined()) {
    return;
  }
  var key = cacheKeyFor(stage) + "::" + cacheKeyFor(stack);
  if (cachedStageStackLinks.includes(key)) {
    return;
  }
  cachedStageStackLinks.add(key);
  stage.deploysStacks.add(stack);
}

/** Returns stack for generated resource. */
operation stackForGeneratedResource(resource) {
  if (not hasText(resource.generatedFrom)) {
    return null;
  }
  var unit = cachedPimDeploymentUnitByElementId.get(resource.generatedFrom);
  if (unit.isDefined()) {
    return awsEquivalent(unit);
  }
  return null;
}

/** Resolves resolve aws relationships. */
operation resolveAwsRelationships() {
  resolveTriggers();
  resolveFlows();
  resolveEventTargets();
  resolveTopicSubscriptions();
  applyCostPolicies();
}

/** Computes generate iam statements. */
operation generateIamStatements() {
  for (f in COMPUTE!Function.all) {
    var l = awsEquivalent(f);
    if (l.isDefined() and l.role.isDefined()) {
      var pol = new AWSPSMSECURITY!IamInlinePolicy;
      pol.id = generatedId("inline_policy", f, "generated_access");
      pol.name = f.name + " generated access";
      pol.policyName = pascalCase(f.name) + "GeneratedAccess";
      pol.document = policyDocument();
      for (s in f.reads) {
        addResourceStatement(pol.document, s, true, false);
      }
      for (s in f.writes) {
        addResourceStatement(pol.document, s, false, true);
      }
      for (access in indexedValues(cachedDataAccessesByFunctionId, cacheKeyFor(f))) {
        if (access.mode = PIMTYPES!DataAccessMode#READ or access.mode = PIMTYPES!DataAccessMode#READ_WRITE) {
          addResourceStatement(pol.document, access.store, true, false);
        }
        if (access.mode = PIMTYPES!DataAccessMode#WRITE or access.mode = PIMTYPES!DataAccessMode#READ_WRITE or access.mode = PIMTYPES!DataAccessMode#APPEND or access.mode = PIMTYPES!DataAccessMode#DELETE) {
          addResourceStatement(pol.document, access.store, false, true);
        }
      }
      for (evt in f.publishes) {
        addPublishStatement(pol.document, evt);
      }
      for (evt2 in f.subscribesTo) {
        addSubscribeStatement(pol.document, evt2);
      }
      for (sec in f.usesSecrets) {
        addSecretStatement(pol.document, sec);
      }
      if (pol.document.statements.isEmpty()) {
        pol.document.statements.add(unresolvedAccessStatement(f));
      }
      if (pol.document.statements.notEmpty()) {
        l.role.inlinePolicies.add(pol);
      }
    }
  }
}

/** Computes generate relationship views. */
operation generateRelationshipViews() {
  for (route in cachedApiGatewayRoutesWithLambdaIntegration) {
    if (route.integration.isDefined() and route.integration.lambdaTarget.isDefined()) {
      var v = new AWSPSMINTEGRATIONS!ApiGatewayLambdaIntegrationView;
      v.id = uniqueId("view_api_lambda_" + slug(route.id + "_" + route.integration.lambdaTarget.id));
      v.name = route.name + " to " + route.integration.lambdaTarget.name;
      v.generated = true;
      v.source = route;
      v.target = route.integration.lambdaTarget;
      v.route = route;
      setFeature(v, "function", route.integration.lambdaTarget);
      v.integration = route.integration;
      v.permission = cachedLambdaPermissionByKey.get("ApiGatewayInvoke::apigateway.amazonaws.com::" + route.integration.lambdaTarget.logicalId);
      awsRoot().relationshipViews.add(v);
    }
  }
  for (m in cachedSqsLambdaMappings) {
    var mappedFunction = m.`function`;
    if (mappedFunction.isUndefined()) {
      continue;
    }
    var sqsView = new AWSPSMINTEGRATIONS!SqsLambdaEventSourceView;
    sqsView.id = uniqueId("view_sqs_lambda_" + slug(m.queue.id + "_" + mappedFunction.id));
    sqsView.name = m.queue.name + " to " + mappedFunction.name;
    sqsView.generated = true;
    sqsView.source = m.queue;
    sqsView.target = mappedFunction;
    sqsView.queue = m.queue;
    setFeature(sqsView, "function", mappedFunction);
    sqsView.mapping = m;
    awsRoot().relationshipViews.add(sqsView);
  }
  for (sub in cachedSnsLambdaSubscriptions) {
    if (sub.protocol = AWSPSMENUMS!SnsProtocol#LAMBDA and sub.endpointResource.isDefined()) {
      var snsView = new AWSPSMINTEGRATIONS!SnsLambdaSubscriptionView;
      snsView.id = uniqueId("view_sns_lambda_" + slug(sub.topic.id + "_" + sub.endpointResource.id));
      snsView.name = sub.topic.name + " to " + sub.endpointResource.name;
      snsView.generated = true;
      snsView.source = sub.topic;
      snsView.target = sub.endpointResource;
      snsView.topic = sub.topic;
      setFeature(snsView, "function", sub.endpointResource);
      snsView.subscription = sub;
      snsView.permission = cachedLambdaPermissionByKey.get("SnsInvoke::sns.amazonaws.com::" + sub.endpointResource.logicalId);
      awsRoot().relationshipViews.add(snsView);
    }
  }
  for (er in cachedEventBridgeRules) {
    for (targetRow in er.targets) {
      if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#LAMBDA and targetRow.targetResource.isDefined()) {
        var ebView = new AWSPSMINTEGRATIONS!EventBridgeLambdaTargetView;
        ebView.id = uniqueId("view_event_lambda_" + slug(er.id + "_" + targetRow.targetResource.id));
        ebView.name = er.name + " to " + targetRow.targetResource.name;
        ebView.generated = true;
        ebView.source = er;
        ebView.target = targetRow.targetResource;
        ebView.rule = er;
        ebView.targetRow = targetRow;
        setFeature(ebView, "function", targetRow.targetResource);
        ebView.permission = cachedLambdaPermissionByKey.get("EventBridgeInvoke::events.amazonaws.com::" + targetRow.targetResource.logicalId);
        awsRoot().relationshipViews.add(ebView);
      }
      if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#STEP_FUNCTIONS and targetRow.targetResource.isDefined()) {
        var sfView = new AWSPSMINTEGRATIONS!StepFunctionEventBridgeTargetView;
        sfView.id = uniqueId("view_event_sfn_" + slug(er.id + "_" + targetRow.targetResource.id));
        sfView.name = er.name + " to " + targetRow.targetResource.name;
        sfView.generated = true;
        sfView.source = er;
        sfView.target = targetRow.targetResource;
        sfView.rule = er;
        sfView.targetRow = targetRow;
        sfView.stateMachine = targetRow.targetResource;
        awsRoot().relationshipViews.add(sfView);
      }
    }
  }
}

/** Computes generate readiness checks. */
operation generateReadinessChecks() {
  var r = readinessContainer();
  if (r.isUndefined()) {
    return;
  }
  check("AWS_PSM_RESOURCES_GENERATED", cachedAwsGeneratedResources.notEmpty(),
    "AWS PSM generation produced deployable resources.",
    KERNEL!Severity#INFO, Sequence{awsRoot()},
    "Review the generated stacks and resources before deployment.");
  check("AWS_PSM_MANUAL_DECISIONS_RECORDED", r.manualDecisions.notEmpty(),
    "AWS PSM generation recorded deployment/design decisions for review.",
    KERNEL!Severity#INFO, Sequence{awsRoot()},
    "Resolve blocking manual decisions before production deployment.");
  r.transformationReady = r.findings.none(f | f.blocking and f.findingType = KERNEL!FindingType#VALIDATION_ERROR);
  r.deploymentReady = r.manualDecisions.none(d | d.blocking);
  r.productionReady = isProductionRoot() and r.findings.none(f | f.severity = KERNEL!Severity#ERROR or f.severity = KERNEL!Severity#CRITICAL or f.severity = KERNEL!Severity#BLOCKER);
  if (not r.transformationReady) {
    r.readinessStatus = KERNEL!LifecycleStatus#BLOCKED;
  }
  else {
    if (not r.deploymentReady) {
      r.readinessStatus = KERNEL!LifecycleStatus#REVIEW_REQUIRED;
    }
    else {
      r.readinessStatus = KERNEL!LifecycleStatus#TRANSFORMATION_READY;
    }
  }
}

/** Validates validate psm constraints. */
operation validatePsmConstraints() {
  // PSM EVL is the canonical source for structural and semantic PSM validation.
  // Transformation-time checks stay in mapping helpers only when a generation
  // decision is needed to continue producing a reviewable PSM model.
}

/** Computes flag unassigned deployables. */
operation flagUnassignedDeployables() {
  var unassigned = Sequence{};
  for (f in COMPUTE!Function.all) {
    collectIfUnassigned(f, unassigned);
  }
  for (a in API!Api.all) {
    collectIfUnassigned(a, unassigned);
  }
  for (d in DATA!DataStore.all) {
    collectIfUnassigned(d, unassigned);
  }
  for (o in DATA!ObjectStore.all) {
    collectIfUnassigned(o, unassigned);
  }
  for (q in INTEGRATION!Queue.all) {
    collectIfUnassigned(q, unassigned);
  }
  for (t in INTEGRATION!Topic.all) {
    collectIfUnassigned(t, unassigned);
  }
  for (b in INTEGRATION!EventBus.all) {
    collectIfUnassigned(b, unassigned);
  }
  for (w in WORKFLOW!Workflow.all) {
    collectIfUnassigned(w, unassigned);
  }
  for (e in EXTERNAL!ExternalAdapter.all) {
    collectIfUnassigned(e, unassigned);
  }
  if (unassigned.notEmpty()) {
    manualDecision("PACKAGING_UNASSIGNED",
      "Review default stack placement for " + unassigned.size() + " PIM deployables that are not assigned to deployment units.",
      KERNEL!Severity#WARNING, false, Sequence{},
      "Add the deployables to PIM DeploymentUnit.contains when they require explicit stack boundaries, or accept placement in the default stack.");
  }
}

/** Adds or records collect if unassigned. */
operation collectIfUnassigned(element, unassigned) {
  if (not cachedPimDeploymentAssignedIds.includes(cacheKeyFor(element))) {
    unassigned.add(element);
  }
}

/** Computes apply cost policies. */
operation applyCostPolicies() {
  for (p in POLICY!CostPolicy.all) {
    for (target in p.attachedTo) {
      var res = awsEquivalent(target);
      if (res.isDefined()) {
        if (hasText(p.costDriver)) {
          res.tags.add(tag("CostDriver", p.costDriver));
        }
        res.costAllocationTagValue = firstText(p.budget, p.optimizationIntent);
        if (isTrue(p.alarmsRequired)) {
          manualDecision("COST_ALARM_ACCOUNT_SCOPE",
            "Create account-level AWS budget/alarm for " + res.name + ".",
            KERNEL!Severity#WARNING, false, Sequence{res},
            "AWS Budgets is account-scoped and not represented as a first-class PSM resource.");
        }
      }
    }
  }
}

/** Resolves resolve triggers. */
operation resolveTriggers() {
  for (t in COMPUTE!Trigger.all) {
    if (t.`function`.isDefined() and t.source.isDefined()) {
      var fn = awsEquivalent(t.`function`);
      if (t.source.eClass().getName() = "Queue") {
        createSqsLambdaMapping(t, awsEquivalent(t.source), fn, t.batchPolicy, t.resilience);
      }
      else {
        if (t.source.eClass().getName() = "Topic") {
          createSnsLambdaSubscription(t, awsEquivalent(t.source), fn);
        }
        else {
          if (t.source.eClass().getName() = "EventBus" or t.source.eClass().getName() = "EventRoutingRule" or t.source.eClass().getName() = "Schedule") {
            var triggerPrincipal = "events.amazonaws.com";
            if (t.source.eClass().getName() = "Schedule") {
              triggerPrincipal = "scheduler.amazonaws.com";
            }
            createLambdaPermissionFor("EventBridgeInvoke", t, fn, triggerPrincipal);
          }
          else {
            if (t.source.eClass().getName() = "ObjectStore") {
              addS3LambdaNotification(t, awsEquivalent(t.source), fn);
            }
            else {
              if (t.source.eClass().getName() = "DataStore" or t.source.eClass().getName() = "DataChangeStream") {
                var dataSource = t.source;
                if (t.source.eClass().getName() = "DataChangeStream") {
                  dataSource = t.source.dataStore;
                }
                createDynamoLambdaMapping(t, awsEquivalent(dataSource), fn, t.batchPolicy, t.resilience);
              }
              else {
              if (t.source.eClass().getName() = "ApiRoute") {
                  createLambdaPermissionFor("ApiGatewayInvoke", t, fn, "apigateway.amazonaws.com", apiGatewayRouteSourceArn(t.source));
                }
                else {
                  manualDecision("TRIGGER_SOURCE_UNSUPPORTED",
                    "Review trigger source " + qualifiedName(t.source) + " for " + t.name + ".",
                    KERNEL!Severity#WARNING, false, Sequence{t},
                    "Add source-specific PSM support or model it as EventBridge.");
                }
              }
            }
          }
        }
      }
    }
  }
}

/** Resolves resolve flows. */
operation resolveFlows() {
  for (flow in INTEGRATION!RequestResponseFlow.all) {
    if (flow.apiRoute.isDefined() and flow.target.isDefined() and flow.target.eClass().getName() = "Function") {
      createLambdaPermissionFor("ApiGatewayInvoke", flow, awsEquivalent(flow.target), "apigateway.amazonaws.com", apiGatewayRouteSourceArn(flow.apiRoute));
    }
  }
  for (flow in INTEGRATION!MessageFlow.all) {
    if (flow.queue.isDefined() and flow.target.isDefined() and flow.target.eClass().getName() = "Function") {
      createSqsLambdaMapping(flow, awsEquivalent(flow.queue), awsEquivalent(flow.target), flow.queue.batchPolicy, flow.resilience);
    }
  }
  for (flow in INTEGRATION!EventFlow.all) {
    if (flow.channel.isDefined() and flow.channel.eClass().getName() = "EventBus" and flow.target.isDefined()) {
      var er = new AWSPSMEVENTS!EventBridgeRule;
      copyAwsResource(flow, er, "EventRule", "AWS::Events::Rule");
      er.id = generatedId("eventbridge_rule", flow, "flow");
      er.ruleName = er.physicalName;
      er.eventPatternJson = eventTypesPatternJson(Sequence{flow.eventType});
      er.state = "ENABLED";
      er.bus = awsEquivalent(flow.channel);
      er.targets.add(createEventBridgeTarget(flow, flow.target));
    }
    if (flow.channel.isDefined() and flow.channel.eClass().getName() = "Topic" and flow.target.isDefined() and flow.target.eClass().getName() = "Function") {
      createSnsLambdaSubscription(flow, awsEquivalent(flow.channel), awsEquivalent(flow.target));
    }
    if (flow.channel.isDefined() and flow.channel.eClass().getName() = "Queue" and flow.target.isDefined() and flow.target.eClass().getName() = "Function") {
      createSqsLambdaMapping(flow, awsEquivalent(flow.channel), awsEquivalent(flow.target), flow.channel.batchPolicy, flow.resilience);
    }
  }
}

/** Resolves resolve event targets. */
operation resolveEventTargets() {
  for (er in AWSPSMEVENTS!EventBridgeRule.all) {
    for (targetRow in er.targets) {
      configureEventBridgeTargetInvoke(er, targetRow);
    }
  }
  for (schedule in AWSPSMEVENTS!EventBridgeSchedule.all) {
    configureEventBridgeTargetInvoke(schedule, schedule.target);
  }
}

/** Computes configure event bridge target invoke. */
operation configureEventBridgeTargetInvoke(origin, targetRow) {
  if (targetRow.isUndefined()) {
    return;
  }
  if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#OTHER_AWS_RESOURCE or targetRow.targetResource.isUndefined()) {
    manualDecision("EVENTBRIDGE_TARGET_INVOKE_ROLE_REQUIRED",
      "Choose invoke permissions for EventBridge target " + firstText(targetRow.name, targetRow.targetId) + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{origin, targetRow},
      "Set targetKind to a supported target or attach a target-specific IAM role and least-privilege action.");
    return;
  }
  if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#LAMBDA) {
    var lambdaPrincipal = "events.amazonaws.com";
    if (origin.isDefined() and origin.eClass().getName() = "EventBridgeSchedule") {
      lambdaPrincipal = "scheduler.amazonaws.com";
    }
    createLambdaPermissionFor("EventBridgeInvoke", origin, targetRow.targetResource, lambdaPrincipal);
  }
  if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#STEP_FUNCTIONS) {
    targetRow.role = createEventInvokeRole(origin, targetRow.targetResource, "states:StartExecution");
  }
  if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#SQS) {
    targetRow.role = createEventInvokeRole(origin, targetRow.targetResource, "sqs:SendMessage");
  }
  if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#SNS) {
    targetRow.role = createEventInvokeRole(origin, targetRow.targetResource, "sns:Publish");
  }
  if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#EVENT_BUS) {
    targetRow.role = createEventInvokeRole(origin, targetRow.targetResource, "events:PutEvents");
  }
  if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#API_DESTINATION) {
    targetRow.role = createEventInvokeRole(origin, targetRow.targetResource, "events:InvokeApiDestination");
  }
  if (targetRow.targetKind = AWSPSMENUMS!EventBridgeTargetKind#LOG_GROUP) {
    targetRow.role = createEventInvokeRole(origin, targetRow.targetResource, "logs:PutLogEvents");
  }
}

/** Resolves resolve topic subscriptions. */
operation resolveTopicSubscriptions() {
  for (topic in INTEGRATION!Topic.all) {
    var sns = awsEquivalent(topic);
    if (sns.isDefined()) {
      for (fn in topic.consumers) {
        createSnsLambdaSubscription(topic, sns, awsEquivalent(fn));
      }
    }
  }
}

/** Creates create sqs lambda mapping. */
operation createSqsLambdaMapping(origin, queue, fn, batchPolicy, resilience) {
  if (queue.isUndefined() or fn.isUndefined()) {
    return null;
  }
  var key = queue.logicalId + "::" + fn.logicalId;
  if (cachedSqsLambdaMappingByKey.containsKey(key)) {
    return cachedSqsLambdaMappingByKey.get(key);
  }
  var m = new AWSPSMCOMPUTE!SqsLambdaEventSourceMapping;
  copyAwsResource(origin, m, "SqsLambdaMapping", "AWS::Lambda::EventSourceMapping");
  m.id = generatedId("sqs_lambda_mapping", origin, queue.id + "_" + fn.id);
  m.batchSize = ifDefinedInt(batchPolicy, "batchSize", 10);
  m.maximumBatchingWindowSeconds = ifDefinedInt(batchPolicy, "maxBatchingWindowSeconds", 0);
  m.maximumRetryAttempts = retryAttempts(resilience, 3);
  m.bisectBatchOnFunctionError = batchPolicy.isDefined() and batchPolicy.bisectOnError = PIMTYPES!Decision#REQUIRED;
  m.reportBatchItemFailures = batchPolicy.isUndefined() or batchPolicy.partialFailureHandling = PIMTYPES!Decision#REQUIRED;
  if (m.reportBatchItemFailures) {
    m.partialBatchFailureHandlingDecision = AWSPSMENUMS!Decision#REQUIRED;
  }
  else {
    m.partialBatchFailureHandlingDecision = AWSPSMENUMS!Decision#NEEDS_REVIEW;
  }
  m.partialBatchFailureHandlingRationale = "Derived from PIM batch policy/resilience.";
  m.queue = queue;
  fn.eventSourceMappings.add(m);
  cachedSqsLambdaMappingByKey.put(key, m);
  return m;
}

/** Creates create dynamo lambda mapping. */
operation createDynamoLambdaMapping(origin, table, fn, batchPolicy, resilience) {
  if (table.isUndefined() or fn.isUndefined()) {
    return null;
  }
  var key = "dynamo::" + table.logicalId + "::" + fn.logicalId;
  if (cachedSqsLambdaMappingByKey.containsKey(key)) {
    return cachedSqsLambdaMappingByKey.get(key);
  }
  if (table.streamSpecification.isUndefined()) {
    manualDecision("DYNAMO_STREAM_REQUIRED",
      "Enable DynamoDB stream for " + table.name + " before using it as a Lambda event source.",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{table},
      "Set DataStore.changeStreamRequired or remove the stream trigger.");
  }
  var m = new AWSPSMCOMPUTE!DynamoDbStreamLambdaEventSourceMapping;
  copyAwsResource(origin, m, "DynamoStreamMapping", "AWS::Lambda::EventSourceMapping");
  m.id = generatedId("dynamodb_lambda_mapping", origin, table.id + "_" + fn.id);
  m.batchSize = ifDefinedInt(batchPolicy, "batchSize", 100);
  m.maximumBatchingWindowSeconds = ifDefinedInt(batchPolicy, "maxBatchingWindowSeconds", 1);
  m.startingPosition = AWSPSMENUMS!StartingPosition#LATEST;
  m.maximumRetryAttempts = retryAttempts(resilience, 3);
  m.bisectBatchOnFunctionError = true;
  m.reportBatchItemFailures = true;
  m.table = table;
  fn.eventSourceMappings.add(m);
  cachedSqsLambdaMappingByKey.put(key, m);
  return m;
}

/** Creates create sns lambda subscription. */
operation createSnsLambdaSubscription(origin, topic, fn) {
  if (topic.isUndefined() or fn.isUndefined()) {
    return null;
  }
  var key = topic.logicalId + "::lambda::" + fn.logicalId;
  if (cachedSnsSubscriptionByKey.containsKey(key)) {
    return cachedSnsSubscriptionByKey.get(key);
  }
  var sub = new AWSPSMMESSAGING!SnsSubscription;
  copyAwsResource(origin, sub, "Subscription", "AWS::SNS::Subscription");
  sub.id = generatedId("sns_subscription", origin, topic.id + "_" + fn.id);
  sub.topic = topic;
  sub.protocol = AWSPSMENUMS!SnsProtocol#LAMBDA;
  sub.endpointResource = fn;
  sub.endpoint = cfnArnExpression(fn);
  sub.filterPolicyScope = AWSPSMENUMS!SnsFilterPolicyScope#MESSAGE_BODY;
  sub.rawMessageDelivery = false;
  createLambdaPermissionFor("SnsInvoke", origin, fn, "sns.amazonaws.com", cfnArnExpression(topic));
  cachedSnsSubscriptionByKey.put(key, sub);
  return sub;
}

/** Creates create sns queue subscription. */
operation createSnsQueueSubscription(origin, topic, queue) {
  if (topic.isUndefined() or queue.isUndefined()) {
    return null;
  }
  var key = topic.logicalId + "::sqs::" + queue.logicalId;
  if (cachedSnsSubscriptionByKey.containsKey(key)) {
    return cachedSnsSubscriptionByKey.get(key);
  }
  var sub = new AWSPSMMESSAGING!SnsSubscription;
  copyAwsResource(origin, sub, "QueueSubscription", "AWS::SNS::Subscription");
  sub.id = generatedId("sns_queue_subscription", origin, topic.id + "_" + queue.id);
  sub.topic = topic;
  sub.protocol = AWSPSMENUMS!SnsProtocol#SQS;
  sub.endpointResource = queue;
  sub.endpoint = cfnArnExpression(queue);
  sub.filterPolicyScope = AWSPSMENUMS!SnsFilterPolicyScope#MESSAGE_BODY;
  sub.rawMessageDelivery = true;
  cachedSnsSubscriptionByKey.put(key, sub);
  return sub;
}

/** Adds or records add s3 lambda notification. */
operation addS3LambdaNotification(origin, bucket, fn) {
  if (bucket.isUndefined() or fn.isUndefined()) {
    return;
  }
  if (bucket.notificationConfiguration.isUndefined()) {
    var cfg = new AWSPSMSTORAGE!S3NotificationConfiguration;
    cfg.id = generatedId("s3_notification", origin, "lambda");
    cfg.name = bucket.name + " notifications";
    cfg.eventBridgeEnabled = false;
    bucket.notificationConfiguration = cfg;
  }
  var rule = new AWSPSMSTORAGE!S3NotificationRule;
  rule.id = generatedId("s3_notification_rule", origin, fn.id);
  rule.name = bucket.name + " to " + fn.name;
  rule.eventTypes.add("s3:ObjectCreated:*");
  rule.destination = fn;
  bucket.notificationConfiguration.rules.add(rule);
  createLambdaPermissionFor("S3Invoke", origin, fn, "s3.amazonaws.com", cfnArnExpression(bucket));
}

/** Creates create event invoke role. */
operation createEventInvokeRole(origin, targetResource, action : String) {
  var role = new AWSPSMSECURITY!IamRole;
  copyAwsResource(origin, role, "EventInvokeRole", "AWS::IAM::Role");
  var targetSeed = "unresolved";
  if (targetResource.isDefined()) {
    targetSeed = firstText(targetResource.logicalId, firstText(targetResource.name, targetResource.id));
  }
  var roleSeed = "event_invoke_" + targetSeed + "_" + action;
  role.id = generatedId("iam_role", origin, roleSeed);
  role.roleName = physicalName(origin, "event-invoke-" + targetSeed, defaultStage());
  role.path = "/";
  var servicePrincipal = "events.amazonaws.com";
  if (origin.isDefined() and origin.eClass().getName() = "EventBridgeSchedule") {
    servicePrincipal = "scheduler.amazonaws.com";
  }
  role.assumeRolePolicy = serviceAssumeRolePolicy(servicePrincipal);
  var pol = new AWSPSMSECURITY!IamInlinePolicy;
  pol.id = generatedId("inline_policy", origin, roleSeed);
  pol.name = "Event invoke";
  pol.policyName = pascalCase("EventInvoke " + targetSeed);
  pol.document = policyDocument();
  var st = allowStatement("InvokeTarget");
  st.actions.add(action);
  if (targetResource.isDefined()) {
    st.resources.add(cfnArnExpression(targetResource));
  }
  else {
    st.resources.add("*");
    st.wildcardResource = true;
    st.wildcardJustification = "Target ARN is unresolved; replace with a concrete target ARN before production.";
  }
  pol.document.statements.add(st);
  role.inlinePolicies.add(pol);
  return role;
}

/** Adds or records add resource statement. */
operation addResourceStatement(doc, storage, read : Boolean, write : Boolean) {
  var res = awsEquivalent(storage);
  if (res.isUndefined()) {
    return;
  }
  if (res.eClass().getName() = "DynamoDbTable") {
    var st = allowStatement("Access" + res.logicalId);
    if (read) {
      st.actions.add("dynamodb:GetItem"); st.actions.add("dynamodb:BatchGetItem"); st.actions.add("dynamodb:Query"); st.actions.add("dynamodb:Scan");
    }
    if (write) {
      st.actions.add("dynamodb:PutItem"); st.actions.add("dynamodb:UpdateItem"); st.actions.add("dynamodb:DeleteItem"); st.actions.add("dynamodb:BatchWriteItem");
    }
    st.resources.add(cfnArnExpression(res));
    st.resources.add(cfnArnSubExpression(res, "/index/*"));
    if (st.actions.notEmpty()) {
      addIamStatementMergedBySid(doc, st);
    }
    return;
  }
  if (res.eClass().getName() = "S3Bucket") {
    var s3st = allowStatement("Access" + res.logicalId);
    if (read) {
      s3st.actions.add("s3:GetObject"); s3st.actions.add("s3:ListBucket");
    }
    if (write) {
      s3st.actions.add("s3:PutObject"); s3st.actions.add("s3:DeleteObject");
    }
    s3st.resources.add(cfnArnExpression(res));
    s3st.resources.add(cfnArnSubExpression(res, "/*"));
    if (s3st.actions.notEmpty()) {
      addIamStatementMergedBySid(doc, s3st);
    }
  }
}

/** Computes unresolved access statement. */
operation unresolvedAccessStatement(source) {
  var st = allowStatement("ReviewGeneratedAccess" + pascalCase(firstText(source.name, source.id)));
  st.effect = AWSPSMENUMS!IamEffect#DENY;
  st.actions.add("*");
  st.resources.add("*");
  st.wildcardAction = true;
  st.wildcardResource = true;
  st.wildcardJustification = "The PIM dependency maps to an AWS-native placeholder or unresolved target; least-privilege actions/resources require review.";
  manualDecision("IAM_WILDCARD_REVIEW",
    "Review AWS access policy for " + source.name + " because at least one dependency maps to an unresolved AWS target.",
    KERNEL!Severity#WARNING, isProductionRoot(), Sequence{source},
    "Replace the placeholder statement with service-specific least-privilege permissions after selecting the AWS target service.");
  return st;
}

/** Adds or records add publish statement. */
operation addPublishStatement(doc, eventType) {
  for (topic in indexedValues(cachedTopicsByEventTypeId, cacheKeyFor(eventType))) {
    var sns = awsEquivalent(topic);
    if (sns.isDefined()) {
      var st = allowStatement("Publish" + sns.logicalId);
      st.actions.add("sns:Publish");
      st.resources.add(cfnArnExpression(sns));
      addIamStatementMergedBySid(doc, st);
    }
  }
  for (bus in indexedValues(cachedEventBusesByEventTypeId, cacheKeyFor(eventType))) {
    var eb = awsEquivalent(bus);
    if (eb.isDefined()) {
      var st2 = allowStatement("PutEvents" + eb.logicalId);
      st2.actions.add("events:PutEvents");
      st2.resources.add(cfnArnExpression(eb));
      addIamStatementMergedBySid(doc, st2);
    }
  }
}

/** Adds or records add subscribe statement. */
operation addSubscribeStatement(doc, eventType) {
  for (queue in indexedValues(cachedQueuesByEventTypeId, cacheKeyFor(eventType))) {
    var sqs = awsEquivalent(queue);
    if (sqs.isDefined()) {
      var st = allowStatement("Consume" + sqs.logicalId);
      st.actions.add("sqs:ReceiveMessage"); st.actions.add("sqs:DeleteMessage"); st.actions.add("sqs:GetQueueAttributes");
      st.resources.add(cfnArnExpression(sqs));
      addIamStatementMergedBySid(doc, st);
    }
  }
}

/** Adds or records add secret statement. */
operation addSecretStatement(doc, secret) {
  var sec = awsEquivalent(secret);
  if (sec.isUndefined()) {
    return;
  }
  var st = allowStatement("ReadSecret" + sec.logicalId);
  st.actions.add("secretsmanager:GetSecretValue");
  st.resources.add(cfnArnExpression(sec));
  addIamStatementMergedBySid(doc, st);
}

/** Adds a statement or merges repeated generation paths into the existing statement with the same Sid. */
operation addIamStatementMergedBySid(doc, statementObj) {
  var existing = doc.statements.selectOne(existingObj | existingObj.sid = statementObj.sid);
  if (existing.isUndefined()) {
    doc.statements.add(statementObj);
    return;
  }
  for (actionText in statementObj.actions) {
    if (not existing.actions.includes(actionText)) existing.actions.add(actionText);
  }
  for (resourceText in statementObj.resources) {
    if (not existing.resources.includes(resourceText)) existing.resources.add(resourceText);
  }
  existing.wildcardAction = existing.wildcardAction or statementObj.wildcardAction;
  existing.wildcardResource = existing.wildcardResource or statementObj.wildcardResource;
  if (not hasText(existing.wildcardJustification) and hasText(statementObj.wildcardJustification)) {
    existing.wildcardJustification = statementObj.wildcardJustification;
  }
  delete statementObj;
}

/** Computes if defined int. */
operation ifDefinedInt(holder, feature : String, fallback : Integer) {
  if (holder.isDefined()) {
    var value = holder.eGet(holder.eClass().getEStructuralFeature(feature));
    if (value.isDefined() and value > 0) {
      return value;
    }
  }
  return fallback;
}

/** Computes retry attempts. */
operation retryAttempts(resilience, fallback : Integer) {
  if (resilience.isDefined() and resilience.retry.isDefined() and resilience.retry.maxAttempts.isDefined() and resilience.retry.maxAttempts > 0) {
    return resilience.retry.maxAttempts;
  }
  return fallback;
}
