import "common.eol";

operation createTraceModel(source) {
  var tm = new KERNEL!TraceModel;
  tm.id = generatedId("trace_model", source, "awspsm");
  tm.name = firstText(source.name, "PIM") + " AWS PSM Trace";
  tm.generatedByTransformation = true;
  tm.manuallyMaintained = false;
  return tm;
}

operation createReadinessAssessment(source) {
  var r = new KERNEL!ProductionReadinessAssessment;
  r.id = generatedId("readiness", source, "awspsm");
  r.name = firstText(source.name, "PIM") + " AWS PSM Readiness";
  r.assessedBy = "pim-to-awspsm";
  r.readinessStatus = KERNEL!LifecycleStatus#REVIEW_REQUIRED;
  r.transformationReady = false;
  r.deploymentReady = false;
  r.productionReady = false;
  r.generatedByTransformation = true;
  r.manuallyMaintained = false;
  return r;
}

operation traceContainer() {
  if (awsRoot().traceModel.isDefined()) {
    return awsRoot().traceModel;
  }
  return null;
}

operation readinessContainer() {
  if (awsRoot().readiness.isDefined()) {
    return awsRoot().readiness;
  }
  return null;
}

operation createTrace(source, target, transformName : String, confidence : String, linkType) {
  var tm = traceContainer();
  if (tm.isUndefined()) {
    return;
  }
  var link = new KERNEL!TraceLink;
  link.id = generatedId("trace", source, transformName + "_" + target.id);
  link.name = transformName + ":" + firstText(source.name, source.id) + "->" + firstText(target.name, target.id);
  link.linkType = linkType;
  link.target = target;
  link.sourceElementId = source.id;
  link.targetElementId = target.id;
  link.transformationRule = transformName;
  link.confidence = mapTraceConfidence(confidence);
  link.generatedByTransformation = true;
  link.manuallyMaintained = false;
  tm.links.add(link);
}

operation mapTraceConfidence(confidence : String) {
  if (confidence = "VERIFIED") return KERNEL!TraceConfidence#VERIFIED;
  if (confidence = "MANUAL") return KERNEL!TraceConfidence#MANUAL;
  if (confidence = "HIGH") return KERNEL!TraceConfidence#HIGH;
  if (confidence = "LOW") return KERNEL!TraceConfidence#LOW;
  return KERNEL!TraceConfidence#MEDIUM;
}

operation manualDecision(decisionId : String, question : String, severity, blocking : Boolean, affected, recommendation : String) {
  var r = readinessContainer();
  if (r.isUndefined()) {
    return;
  }
  var decisionBaseId = "decision_" + slug(decisionId + "_" + affectedStableKey(affected) + "_" + question);
  if (cachedAwsReadinessDecisionIds.includes(decisionBaseId)) {
    return;
  }
  cachedAwsReadinessDecisionIds.add(decisionBaseId);
  var d = new KERNEL!ManualDecision;
  d.id = uniqueId(decisionBaseId);
  d.name = decisionId;
  d.question = question;
  d.severity = severity;
  d.blocking = blocking;
  d.reviewNotes = recommendation;
  d.generatedByTransformation = true;
  d.manuallyMaintained = false;
  addTargetAffected(d, affected);
  r.manualDecisions.add(d);

  var findingBaseId = "finding_" + slug(decisionId + "_" + affectedStableKey(affected) + "_" + question);
  if (cachedAwsReadinessFindingIds.includes(findingBaseId)) {
    return;
  }
  cachedAwsReadinessFindingIds.add(findingBaseId);
  var f = new KERNEL!ReadinessFinding;
  f.id = uniqueId(findingBaseId);
  f.name = decisionId + " finding";
  f.findingType = KERNEL!FindingType#MISSING_INFORMATION;
  f.severity = severity;
  f.ruleId = decisionId;
  f.message = question;
  f.recommendation = recommendation;
  f.blocking = blocking;
  f.generatedByTransformation = true;
  f.manuallyMaintained = false;
  addTargetAffected(f, affected);
  r.findings.add(f);
}

operation finding(checkId : String, message : String, severity, blocking : Boolean, affected, recommendation : String) {
  var r = readinessContainer();
  if (r.isUndefined()) {
    return;
  }
  var findingBaseId = "finding_" + slug(checkId + "_" + affectedStableKey(affected) + "_" + message);
  if (cachedAwsReadinessFindingIds.includes(findingBaseId)) {
    return;
  }
  cachedAwsReadinessFindingIds.add(findingBaseId);
  var f = new KERNEL!ReadinessFinding;
  f.id = uniqueId(findingBaseId);
  f.name = checkId;
  f.findingType = KERNEL!FindingType#VALIDATION_ERROR;
  f.severity = severity;
  f.ruleId = checkId;
  f.message = message;
  f.recommendation = recommendation;
  f.blocking = blocking;
  f.generatedByTransformation = true;
  f.manuallyMaintained = false;
  addTargetAffected(f, affected);
  r.findings.add(f);
}

operation check(checkId : String, passed : Boolean, message : String, severity, affected, remediation : String) {
  var r = readinessContainer();
  if (r.isUndefined()) {
    return;
  }
  var checkBaseId = "check_" + slug(checkId + "_" + affectedStableKey(affected) + "_" + message);
  if (cachedAwsReadinessCheckIds.includes(checkBaseId)) {
    return;
  }
  cachedAwsReadinessCheckIds.add(checkBaseId);
  var c = new KERNEL!ReadinessCheck;
  c.id = uniqueId(checkBaseId);
  c.name = checkId;
  c.checkId = checkId;
  c.passed = passed;
  c.message = message;
  c.severity = severity;
  c.remediation = remediation;
  c.generatedByTransformation = true;
  c.manuallyMaintained = false;
  addTargetAffected(c, affected);
  r.checks.add(c);
}

operation addTargetAffected(container, affected) {
  for (element in affected) {
    if (element.isDefined() and element.eClass().getEPackage().getNsURI().contains("awspsm")) {
      container.affectedElements.add(element);
    }
  }
}

operation affectedStableKey(affected) {
  if (affected.isUndefined()) {
    return "";
  }
  var key = "";
  for (element in affected) {
    if (element.isDefined()) {
      var part = cacheKeyFor(element);
      if (not hasText(part)) {
        part = element.eClass().getName();
      }
      if (hasText(key)) {
        key = key + "_";
      }
      key = key + part;
    }
  }
  return key;
}
