{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://varka.org/notation/cvs-v2.schema.json",
  "title": "Varka Concrete Visual Syntax v2",
  "description": "Formal concrete visual syntax specification derived from Ecore metamodels.",
  "type": "object",
  "required": [
    "cvsVersion",
    "metamodelRef",
    "elements",
    "views",
    "containers",
    "canvasPolicy",
    "rootTemplate"
  ],
  "additionalProperties": true,
  "$defs": {
    "themeColor": {
      "description": "Icon/accent or edge stroke color for light and dark UI themes.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": ["light", "dark"],
          "properties": {
            "light": {
              "type": "string"
            },
            "dark": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "properties": {
    "cvsVersion": {
      "type": "integer",
      "const": 2
    },
    "displayName": {
      "type": "string"
    },
    "metamodelRef": {
      "type": "object",
      "required": ["level", "ecore"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["cim", "pim", "psm"]
        },
        "ecore": {
          "type": "string"
        },
        "nsUri": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "color": {
            "$ref": "#/$defs/themeColor"
          },
          "category": {
            "type": "string"
          },
          "visualRole": {
            "type": "string",
            "enum": ["node", "container", "relationship", "detail", "support"]
          },
          "creatable": {
            "type": "boolean"
          },
          "containedOnly": {
            "type": "boolean"
          },
          "supportOnly": {
            "type": "boolean"
          },
          "relationshipElement": {
            "type": "boolean"
          },
          "visibleFields": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "palette", "canvas"],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "viewType": {
            "type": "string"
          },
          "palette": {
            "type": "array",
            "items": { "type": "string" }
          },
          "canvas": {
            "type": "array",
            "items": { "type": "string" }
          },
          "relationshipKinds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "layoutHint": { "type": "string" },
          "semanticDashboardColumns": { "type": "array" }
        }
      }
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["elementType", "palette", "canvas"],
        "properties": {
          "elementType": { "type": "string" },
          "palette": { "type": "array", "items": { "type": "string" } },
          "canvas": { "type": "array", "items": { "type": "string" } },
          "relationshipKinds": { "type": "array", "items": { "type": "string" } },
          "layoutHint": { "type": "string" }
        }
      }
    },
    "canvasPolicy": {
      "type": "object"
    },
    "boundedContext": {
      "type": "object"
    },
    "complexityManagement": {
      "type": "array"
    },
    "workbench": {
      "type": "object"
    },
    "scaffoldRecipes": {
      "type": "array"
    },
    "constraints": {
      "type": "array"
    },
    "strictnessModes": {
      "type": "array"
    },
    "rootTemplate": {
      "type": "object"
    },
    "starterTemplate": {
      "type": "object"
    }
  }
}
