  "relationshipVisualRules": [
    {
      "matchKinds": [
        "CONTAINS",
        "CONTAINS_COMMAND",
        "CONTAINS_QUERY",
        "CONTAINS_EVENT",
        "ROOT",
        "MEMBER"
      ],
      "className": "edge-domain-ownership",
      "stroke": {
        "light": "#475569",
        "dark": "#94a3b8"
      },
      "lineDash": [4, 3],
      "lineWidth": 2.2
    },
    {
      "matchKinds": ["DOMAIN_RELATIONSHIP"],
      "className": "edge-domain-relationship",
      "markerEnd": "",
      "stroke": {
        "light": "#2563eb",
        "dark": "#60a5fa"
      },
      "variants": [
        {
          "field": "relationshipType",
          "equals": "COMPOSITION",
          "className": "edge-domain-composition",
          "markerStart": "diamond-filled"
        },
        {
          "field": "relationshipType",
          "equals": "AGGREGATION",
          "className": "edge-domain-aggregation",
          "markerStart": "diamond-hollow"
        },
        {
          "field": "relationshipType",
          "equals": "GENERALIZATION",
          "className": "edge-domain-generalization",
          "markerEnd": "triangle-hollow"
        },
        {
          "field": "relationshipType",
          "values": ["DEPENDENCY", "OWNERSHIP"],
          "className": "edge-domain-dependency",
          "markerEnd": "arrow",
          "lineDash": [7, 4]
        }
      ]
    },
    {
      "matchKinds": ["DEPENDS_ON", "USES", "SUPPORTS", "REFINES", "MANAGES"],
      "matchEClasses": ["CapabilityDependency"],
      "className": "edge-domain-dependency",
      "stroke": {
        "light": "#0f766e",
        "dark": "#2dd4bf"
      },
      "lineDash": [7, 4]
    },
    {
      "matchKinds": ["TRANSITION", "TRIGGERS", "RESULTS_IN"],
      "className": "edge-process-transition",
      "stroke": {
        "light": "#0f766e",
        "dark": "#2dd4bf"
      }
    },
    {
      "matchKinds": ["TRACE"],
      "matchEClasses": ["TraceLink"],
      "className": "edge-trace-link",
      "stroke": {
        "light": "#7c3aed",
        "dark": "#a78bfa"
      },
      "lineDash": [2, 5]
    },
    {
      "matchKinds": ["CONFLICTS_WITH", "CONSTRAINS", "ATTACHED_TO"],
      "className": "edge-conflict",
      "markerEnd": "conflict-cross",
      "stroke": {
        "light": "#dc2626",
        "dark": "#f87171"
      },
      "lineDash": [8, 3, 2, 3]
    }
  ],
  "semanticReferenceRules": [],
  "semanticEdgeObjectRules": [
    {
      "eClass": "RequirementRelationship",
      "kindField": "kind",
      "matchKinds": ["DEPENDS_ON", "CONFLICTS_WITH", "REFINES", "DUPLICATES", "DERIVES_FROM"],
      "sourceType": "Requirement",
      "targetType": "Requirement",
      "rootFeature": "requirementRelationships",
      "sourceFeature": "source",
      "targetFeature": "target",
      "defaults": {
        "blocking": false,
        "rationale": ""
      }
    },
    {
      "eClass": "DomainRelationship",
      "matchKinds": ["DOMAIN_RELATIONSHIP"],
      "sourceType": "DomainConcept",
      "targetType": "DomainConcept",
      "rootFeature": "relationships",
      "sourceFeature": "source",
      "targetFeature": "target",
      "defaults": {
        "relationshipType": "ASSOCIATION"
      }
    },
    {
      "eClass": "CapabilityDependency",
      "matchKinds": ["DEPENDS_ON"],
      "sourceType": "BusinessCapability",
      "targetType": "BusinessCapability",
      "rootFeature": "capabilityDependencies",
      "sourceFeature": "source",
      "targetFeature": "target",
      "defaults": {
        "dependencyReason": "",
        "criticalPath": false
      }
    },
    {
      "eClass": "ProcessTransition",
      "matchKinds": ["TRANSITION"],
      "sourceType": "ProcessStep",
      "targetType": "ProcessStep",
      "rootFeature": "transitions",
      "sourceFeature": "source",
      "targetFeature": "target",
      "defaults": {
        "label": "",
        "conditionExpression": "",
        "orderIndex": 0
      }
    },
    {
      "eClass": "TraceLink",
      "matchKinds": ["TRACE"],
      "sourceType": "*",
      "targetType": "*",
      "rootFeature": "links",
      "ownerType": "TraceModel",
      "sourceFeature": "source",
      "targetFeature": "target",
      "defaults": {
        "linkType": "OTHER",
        "confidence": ""
      }
    }
  ],
  "semanticReferenceKindMappings": {
    "functionIntegration": "ROUTES_TO",
    "reads": "READS",
