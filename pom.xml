<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>modriss</artifactId>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <groupId>org.springframework.boot</groupId>
          <version>${spring.boot.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
            <release>${maven.compiler.release}</release>
          </configuration>
          <version>${maven.compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <argLine>${surefire.argLine}</argLine>
            <excludedGroups>${test.excluded.groups}</excludedGroups>
            <properties>
              <configurationParameters>
                junit.jupiter.execution.parallel.enabled=true
                junit.jupiter.execution.parallel.mode.default=same_thread
                junit.jupiter.execution.parallel.mode.classes.default=concurrent
                junit.jupiter.execution.parallel.config.strategy=dynamic
                junit.jupiter.execution.parallel.config.dynamic.factor=1.0
              </configurationParameters>
            </properties>
          </configuration>
          <version>${maven.surefire.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <configuration>
            <configLocation>${session.executionRootDirectory}/config/checkstyle/checkstyle.xml</configLocation>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>true</failOnViolation>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <linkXRef>false</linkXRef>
            <propertyExpansion>config_loc=${session.executionRootDirectory}/config/checkstyle</propertyExpansion>
            <violationSeverity>warning</violationSeverity>
          </configuration>
          <dependencies>
            <dependency>
              <artifactId>checkstyle</artifactId>
              <groupId>com.puppycrawl.tools</groupId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <groupId>org.apache.maven.plugins</groupId>
          <version>${maven.checkstyle.plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-pmd-plugin</artifactId>
          <configuration>
            <failOnViolation>true</failOnViolation>
            <includeTests>true</includeTests>
            <linkXRef>false</linkXRef>
            <minimumPriority>2</minimumPriority>
            <printFailingErrors>true</printFailingErrors>
            <rulesets>
              <ruleset>${session.executionRootDirectory}/config/pmd/ruleset.xml</ruleset>
            </rulesets>
            <targetJdk>${java.version}</targetJdk>
          </configuration>
          <groupId>org.apache.maven.plugins</groupId>
          <version>${maven.pmd.plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <configuration>
            <effort>Max</effort>
            <excludeFilterFile>${session.executionRootDirectory}/config/spotbugs/exclude-filter.xml</excludeFilterFile>
            <failOnError>true</failOnError>
            <fork>false</fork>
            <includeTests>true</includeTests>
            <threshold>High</threshold>
          </configuration>
          <groupId>com.github.spotbugs</groupId>
          <version>${spotbugs.maven.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>
      <plugin>
        <artifactId>maven-pmd-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>
      <plugin>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <groupId>com.github.spotbugs</groupId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
            </googleJavaFormat>
            <formatAnnotations />
            <removeUnusedImports />
            <trimTrailingWhitespace />
            <endWithNewline />
          </java>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
        <groupId>org.springframework.boot</groupId>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <!-- Resolve the inherited Surefire javaagent even in modules without Mockito tests. -->
    <dependency>
      <artifactId>mockito-core</artifactId>
      <groupId>org.mockito</groupId>
      <scope>test</scope>
      <version>${mockito.version}</version>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <artifactId>spring-boot-dependencies</artifactId>
        <groupId>org.springframework.boot</groupId>
        <scope>import</scope>
        <type>pom</type>
        <version>${spring.boot.version}</version>
      </dependency>
      <dependency>
        <artifactId>spring-ai-bom</artifactId>
        <groupId>org.springframework.ai</groupId>
        <scope>import</scope>
        <type>pom</type>
        <version>${spring.ai.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-shared-types</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-storage-api</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-user-authentication</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-project-management</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-model-workspace</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-artifact-management</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-mde-pipeline</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-storage-postgres</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-modeling-infrastructure</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-modeling-assistant</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>platform-project-export</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>epsilon-model-transformation</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>epsilon-text-generation</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>epsilon-model-validation</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <description>AI-assisted model-driven methodology for serverless software development.</description>
  <groupId>io.mehdieidi</groupId>

  <modelVersion>4.0.0</modelVersion>
  <modules>
    <module>packages/java/emf-compare-standalone</module>
    <module>apps/backend</module>
    <module>packages/java/platform-shared-types</module>
    <module>packages/java/platform-storage-api</module>
    <module>packages/java/platform-user-authentication</module>
    <module>packages/java/platform-project-management</module>
    <module>packages/java/platform-modeling-infrastructure</module>
    <module>packages/java/platform-model-workspace</module>
    <module>packages/java/platform-modeling-assistant</module>
    <module>packages/java/platform-project-export</module>
    <module>packages/java/platform-artifact-management</module>
    <module>packages/java/platform-mde-pipeline</module>
    <module>packages/java/platform-storage-postgres</module>
    <module>packages/java/epsilon-model-transformation</module>
    <module>packages/java/epsilon-model-validation</module>
    <module>packages/java/epsilon-text-generation</module>
    <module>tools/emfatic-to-ecore-cli</module>
    <module>tools/model-validator-cli</module>
    <module>tools/model-transformer-cli</module>
    <module>tools/code-generator-cli</module>
  </modules>

  <name>MODRISS</name>

  <packaging>pom</packaging>

  <properties>
    <checkstyle.version>10.23.1</checkstyle.version>
    <google-java-format.version>1.25.2</google-java-format.version>
    <java.version>17</java.version>
    <maven.checkstyle.plugin.version>3.6.0</maven.checkstyle.plugin.version>
    <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.pmd.plugin.version>3.26.0</maven.pmd.plugin.version>
    <mockito.version>5.23.0</mockito.version>
    <maven.surefire.version>3.5.4</maven.surefire.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spotbugs.maven.plugin.version>4.8.6.6</spotbugs.maven.plugin.version>
    <spotless.version>2.44.3</spotless.version>
    <spring.ai.version>2.0.0</spring.ai.version>
    <spring.boot.version>4.1.0</spring.boot.version>
    <surefire.argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar -Djdk.httpclient.allowRestrictedHeaders=host</surefire.argLine>
    <test.excluded.groups>llm-provider</test.excluded.groups>
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <profiles>
    <profile>
      <id>llm-provider-tests</id>
      <properties>
        <test.excluded.groups></test.excluded.groups>
      </properties>
    </profile>
  </profiles>

  <version>0.0.1-SNAPSHOT</version>
</project>
