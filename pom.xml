<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>modless</artifactId>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
          <version>${maven.compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <artifactId>mde-etl-runner</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>mde-m2t-runner</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <artifactId>mde-evl-validator</artifactId>
        <groupId>${project.groupId}</groupId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <description>Model-Driven Low-Code Platform for Serverless Software Development.</description>
  <groupId>io.mehdieidi</groupId>

  <modelVersion>4.0.0</modelVersion>
  <modules>
    <module>apps/backend</module>
    <module>packages/java/mde-etl-runner</module>
    <module>packages/java/mde-evl-validator</module>
    <module>packages/java/mde-m2t-runner</module>
    <module>tools/mde-cli</module>
    <module>tools/mde-evl-cli</module>
    <module>tools/mde-etl-cli</module>
    <module>tools/mde-m2t-cli</module>
  </modules>

  <name>Modless</name>

  <packaging>pom</packaging>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <maven.surefire.version>3.5.4</maven.surefire.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <version>0.0.1-SNAPSHOT</version>
</project>
