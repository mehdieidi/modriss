<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>backend</artifactId>

  <build>
    <plugins>
      <plugin>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
        <groupId>org.springframework.boot</groupId>
        <version>${spring.boot.version}</version>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <artifactId>platform-domain</artifactId>
      <groupId>${project.groupId}</groupId>
    </dependency>
    <dependency>
      <artifactId>platform-application</artifactId>
      <groupId>${project.groupId}</groupId>
    </dependency>
    <dependency>
      <artifactId>platform-storage-postgres</artifactId>
      <groupId>${project.groupId}</groupId>
    </dependency>
    <dependency>
      <artifactId>platform-modeling</artifactId>
      <groupId>${project.groupId}</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-validation</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-web</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-websocket</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-ai-client-chat</artifactId>
      <groupId>org.springframework.ai</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-ai-openai</artifactId>
      <groupId>org.springframework.ai</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-ai-google-genai</artifactId>
      <groupId>org.springframework.ai</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-ai-model-chat-memory-repository-jdbc</artifactId>
      <groupId>org.springframework.ai</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-ai-transformers</artifactId>
      <exclusions>
        <exclusion>
          <artifactId>onnxruntime</artifactId>
          <groupId>com.microsoft.onnxruntime</groupId>
        </exclusion>
        <exclusion>
          <artifactId>pytorch-engine</artifactId>
          <groupId>ai.djl.pytorch</groupId>
        </exclusion>
        <exclusion>
          <artifactId>api</artifactId>
          <groupId>ai.djl</groupId>
        </exclusion>
        <exclusion>
          <artifactId>model-zoo</artifactId>
          <groupId>ai.djl</groupId>
        </exclusion>
        <exclusion>
          <artifactId>tokenizers</artifactId>
          <groupId>ai.djl.huggingface</groupId>
        </exclusion>
      </exclusions>
      <groupId>org.springframework.ai</groupId>
    </dependency>
    <dependency>
      <artifactId>flyway-core</artifactId>
      <groupId>org.flywaydb</groupId>
    </dependency>
    <dependency>
      <artifactId>flyway-database-postgresql</artifactId>
      <groupId>org.flywaydb</groupId>
    </dependency>
    <dependency>
      <artifactId>postgresql</artifactId>
      <groupId>org.postgresql</groupId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-test</artifactId>
      <groupId>org.springframework.boot</groupId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <description>Spring Boot backend application for the Modless web frontend.</description>
  <modelVersion>4.0.0</modelVersion>

  <name>backend</name>
  <packaging>jar</packaging>
  <parent>
    <artifactId>modless</artifactId>
    <groupId>io.mehdieidi</groupId>
    <relativePath>../../pom.xml</relativePath>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <profiles>
    <profile>
      <id>onnx-embeddings</id>
      <dependencies>
        <dependency>
          <artifactId>onnxruntime</artifactId>
          <groupId>com.microsoft.onnxruntime</groupId>
          <version>1.20.0</version>
        </dependency>
        <dependency>
          <artifactId>pytorch-engine</artifactId>
          <groupId>ai.djl.pytorch</groupId>
          <version>0.32.0</version>
        </dependency>
        <dependency>
          <artifactId>api</artifactId>
          <groupId>ai.djl</groupId>
          <version>0.32.0</version>
        </dependency>
        <dependency>
          <artifactId>model-zoo</artifactId>
          <groupId>ai.djl</groupId>
          <version>0.32.0</version>
        </dependency>
        <dependency>
          <artifactId>tokenizers</artifactId>
          <groupId>ai.djl.huggingface</groupId>
          <version>0.32.0</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
