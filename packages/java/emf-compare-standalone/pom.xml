<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>emf-compare-standalone</artifactId>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>package-official-emf-compare-core</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/emf-compare-download" />
                <get src="${emf.compare.bundle.url}"
                  dest="${project.build.directory}/emf-compare-download/${emf.compare.bundle.file}"
                  skipexisting="true"
                  useragent="Varka-build/1.0" />
                <checksum
                  file="${project.build.directory}/emf-compare-download/${emf.compare.bundle.file}"
                  algorithm="SHA-256"
                  property="emf.compare.bundle.actual.sha256" />
                <fail message="The downloaded official EMF Compare bundle failed SHA-256 verification.">
                  <condition>
                    <not>
                      <equals arg1="${emf.compare.bundle.actual.sha256}"
                        arg2="${emf.compare.bundle.sha256}" casesensitive="false" />
                    </not>
                  </condition>
                </fail>
                <unzip
                  src="${project.build.directory}/emf-compare-download/${emf.compare.bundle.file}"
                  dest="${project.build.outputDirectory}">
                  <patternset>
                    <exclude name="META-INF/MANIFEST.MF" />
                    <exclude name="META-INF/ECLIPSE_.SF" />
                    <exclude name="META-INF/ECLIPSE_.RSA" />
                  </patternset>
                </unzip>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <artifactId>guava</artifactId>
      <groupId>com.google.guava</groupId>
      <version>33.4.8-jre</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.emf.ecore</artifactId>
      <groupId>org.eclipse.emf</groupId>
      <version>${emf.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
      <groupId>org.eclipse.emf</groupId>
      <version>${emf.version}</version>
    </dependency>
  </dependencies>
  <description>Verified standalone packaging of the official Eclipse EMF Compare core bundle.</description>
  <modelVersion>4.0.0</modelVersion>
  <name>EMF Compare Standalone Adapter</name>
  <packaging>jar</packaging>
  <parent>
    <artifactId>varka</artifactId>
    <groupId>io.mehdieidi</groupId>
    <relativePath>../../../pom.xml</relativePath>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <properties>
    <emf.compare.bundle.file>org.eclipse.emf.compare_3.5.3.202605071334.jar</emf.compare.bundle.file>
    <emf.compare.bundle.sha256>F4B25742EAFDA5EFFA4904BC028BC64638612B41AE9233B62956AE0EBF4F357C</emf.compare.bundle.sha256>
    <emf.compare.bundle.url>https://www.eclipse.org/downloads/download.php?file=/modeling/emf/compare/updates/releases/3.3/R202605071334/core/plugins/${emf.compare.bundle.file}&amp;r=1</emf.compare.bundle.url>
    <emf.version>2.40.0</emf.version>
  </properties>
</project>
