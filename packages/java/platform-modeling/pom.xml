<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <artifactId>platform-modeling</artifactId>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>../../../mde/metamodels/cim</directory>
        <includes>
          <include>cim-combined.ecore</include>
        </includes>
        <targetPath>modeling/metamodels/cim</targetPath>
      </resource>
      <resource>
        <directory>../../../mde/metamodels/pim</directory>
        <includes>
          <include>pim-combined.ecore</include>
        </includes>
        <targetPath>modeling/metamodels/pim</targetPath>
      </resource>
      <resource>
        <directory>../../../mde/metamodels/psm</directory>
        <includes>
          <include>psm-combined.ecore</include>
        </includes>
        <targetPath>modeling/metamodels/psm</targetPath>
      </resource>
    </resources>
  </build>
  <dependencies>
    <dependency>
      <artifactId>platform-domain</artifactId>
      <groupId>${project.groupId}</groupId>
    </dependency>
    <dependency>
      <artifactId>jackson-databind</artifactId>
      <groupId>com.fasterxml.jackson.core</groupId>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.emf.common</artifactId>
      <groupId>org.eclipse.emf</groupId>
      <version>${emf.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.emf.ecore</artifactId>
      <groupId>org.eclipse.emf</groupId>
      <version>${emf.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
      <groupId>org.eclipse.emf</groupId>
      <version>${emf.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.elk.core</artifactId>
      <groupId>org.eclipse.elk</groupId>
      <version>${elk.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.elk.graph</artifactId>
      <groupId>org.eclipse.elk</groupId>
      <version>${elk.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.elk.alg.layered</artifactId>
      <groupId>org.eclipse.elk</groupId>
      <version>${elk.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.elk.alg.mrtree</artifactId>
      <groupId>org.eclipse.elk</groupId>
      <version>${elk.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.elk.alg.radial</artifactId>
      <groupId>org.eclipse.elk</groupId>
      <version>${elk.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.elk.alg.force</artifactId>
      <groupId>org.eclipse.elk</groupId>
      <version>${elk.version}</version>
    </dependency>
    <dependency>
      <artifactId>org.eclipse.xtext.xbase.lib</artifactId>
      <groupId>org.eclipse.xtext</groupId>
      <version>${xtext.version}</version>
    </dependency>
    <dependency>
      <artifactId>junit-jupiter</artifactId>
      <groupId>org.junit.jupiter</groupId>
      <scope>test</scope>
      <version>${junit.version}</version>
    </dependency>
  </dependencies>
  <description>Platform modeling, metamodel resolution, XMI import/export, and layout services.
  </description>
  <modelVersion>4.0.0</modelVersion>
  <name>platform-modeling</name>
  <packaging>jar</packaging>
  <parent>
    <artifactId>modless</artifactId>
    <groupId>io.mehdieidi</groupId>
    <relativePath>../../../pom.xml</relativePath>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <properties>
    <elk.version>0.11.0</elk.version>
    <emf.version>2.40.0</emf.version>
    <junit.version>5.13.1</junit.version>
    <xtext.version>2.40.0</xtext.version>
  </properties>
</project>
