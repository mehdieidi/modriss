  "universalSyntax": [
    {
      "primitive": "Container",
      "notation": "Rounded large frame with title bar and optional swimlane/header.",
      "interaction": "Spatial containment changes containment or membership only when valid."
    },
    {
      "primitive": "Primary concept card",
      "notation": "Rounded card with title, stereotype token, badges, and collapsible compartments.",
      "interaction": "Primary attributes are shown inline; secondary attributes remain editable in the inspector."
    },
    {
      "primitive": "Behavioral node",
      "notation": "Meaning-specific CMD, QRY, EVT, ERR, condition, state, and process-step shapes.",
      "interaction": "Shape and token carry meaning without relying on color alone."
    },
    {
      "primitive": "Relationship edge",
      "notation": "Labeled line with arrowheads, endpoint roles, and multiplicity where available.",
      "interaction": "Dense edge layers are hidden, bundled, or exposed through focus mode."
    },
    {
      "primitive": "Reference chip",
      "notation": "Compact linked-element chip inside a card compartment or inspector row.",
      "interaction": "Clicking a chip navigates to or highlights the referenced element."
    }
  ],
  "kernelSyntax": [
    {
      "element": "ModelElement / TraceableElement",
      "notation": "Hidden metadata layer with lifecycle, generated, rationale, review, and trace badges.",
      "surfaces": [
        "inspector",
        "search",
        "trace overlay",
        "status badges"
      ]
    },
    {
      "element": "Annotation / KeyValue",
      "notation": "Key-value chips attached to a card or listed in an annotations tab.",
      "surfaces": [
        "inspector",
        "detail projection"
      ]
    },
    {
      "element": "TraceModel / TraceLink",
      "notation": "Separate traceability overlay with dashed labeled links and confidence filtering.",
      "surfaces": [
        "trace view",
        "relationship matrix"
      ]
    },
    {
      "element": "Expression / StructuredDocument",
      "notation": "Expandable expression or document editor with compact card badge.",
      "surfaces": [
        "inspector",
        "detail modal"
      ]
    },
    {
      "element": "ProductionReadinessAssessment / findings / checks / decisions",
      "notation": "Readiness board and severity markers on affected elements.",
      "surfaces": [
        "readiness board",
        "validation overlay"
      ]
    }
  ],
  "complexityManagement": [
    {
      "technique": "View decomposition",
      "behavior": "Use named synchronized views scoped by semantic purpose instead of a single all-elements canvas."
    },
    {
      "technique": "Containment and collapse",
      "behavior": "Major containers support collapsed, summary, and expanded modes with counts and exposed ports."
    },
    {
      "technique": "Semantic zoom",
      "behavior": "Far zoom shows containers and counts; mid zoom shows cards and ports; near zoom shows compartments and edge labels."
    },
    {
      "technique": "Layered edge visibility",
      "behavior": "Containment, structural, behavioral, policy, trace, readiness, and generated edges are independently filterable."
    },
    {
      "technique": "Focus mode",
      "behavior": "Selecting an element can focus a depth-1 or depth-2 neighborhood and fade unrelated nodes."
    },
    {
      "technique": "Model explorer and search",
      "behavior": "Search indexes names, ids, tags, source refs, routes, event names, logical ids, and AWS types where present."
    },
    {
      "technique": "Validation overlays",
      "behavior": "EVL/readiness findings appear as markers and sortable issue lists that highlight affected elements."
    },
    {
      "technique": "Trace overlay",
      "behavior": "Trace links remain a separate layer with confidence filters."
    },
    {
      "technique": "Saved viewpoints",
      "behavior": "Views persist filters, layout, camera positions, and edge-layer choices."
    }
  ],
