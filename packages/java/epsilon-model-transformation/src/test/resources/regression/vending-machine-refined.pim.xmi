  <businessRules id="d07f4d7c-fea2-54a2-ad99-1e0ea775b05b" name="Machine registration Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="4e180a70-c650-5cdd-bca6-4da5615fc501" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r01" traceId="TR-004:R01-&gt;d07f4d7c-fea2-54a2-ad99-1e0ea775b05b" generatedFrom="R01" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="The backend shall identify registered machines and reject actions from unknown or disabled machine identities." />
  <businessRules id="dc4ce9c6-44a8-501f-94c4-fd64c68d8db3" name="Machine status Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="97f8a98f-e8f2-5ec6-a270-2cfd52a8dbb6" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r02" traceId="TR-004:R02-&gt;dc4ce9c6-44a8-501f-94c4-fd64c68d8db3" generatedFrom="R02" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="The backend shall maintain an operational status derived from explicit operator state and recent heartbeat/fault evidence." />
  <businessRules id="167988b1-a5ca-56b6-a68a-6c66b16a1db5" name="Catalog and inventory Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="f321241b-fc55-57e8-a1ba-7ac412848c6d" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r03" traceId="TR-004:R03-&gt;167988b1-a5ca-56b6-a68a-6c66b16a1db5" generatedFrom="R03" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="The backend shall maintain products/slots and the available quantity per machine without exposing implementation-specific persistence to the requirement." />
  <businessRules id="96b2a021-b8e0-53a4-b150-e2aabfe721d7" name="Purchase request Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="012d67de-eb5c-51bd-90de-d55fd8afaf44" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r04" traceId="TR-004:R04-&gt;96b2a021-b8e0-53a4-b150-e2aabfe721d7" generatedFrom="R04" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="A customer/device request shall identify machine, product selection, price/currency context and a unique request/idempotency key." />
  <businessRules id="89b61764-fcec-5fce-838a-3b9c63b40717" name="Availability check Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="2b041bfb-dd9f-52c9-bcaa-c3141645edb6" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r05" traceId="TR-004:R05-&gt;89b61764-fcec-5fce-838a-3b9c63b40717" generatedFrom="R05" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="A purchase shall not proceed to a successful vend when the selected item is unavailable or the machine is not permitted to sell." />
  <businessRules id="a229584e-80c7-58d3-9c16-8bb0bcd0cf47" name="Atomic stock reservation Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="84d3a2a5-fae5-5926-8cfb-9b302f021314" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r06" traceId="TR-004:R06-&gt;a229584e-80c7-58d3-9c16-8bb0bcd0cf47" generatedFrom="R06" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Concurrent requests for the last available unit shall not oversell; at most one transaction may obtain the unit." />
  <businessRules id="98cb3ea6-8e8d-5a6f-b748-2dc018fab3ba" name="Payment integration Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="e7870e3a-5456-54ed-adb0-45966266becb" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r07" traceId="TR-004:R07-&gt;98cb3ea6-8e8d-5a6f-b748-2dc018fab3ba" generatedFrom="R07" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="The backend shall coordinate payment authorization/capture through an external provider without storing raw card credentials." />
  <businessRules id="b5cacc1c-07cd-51df-a5b3-51ab5bb96b29" name="Dispense coordination Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="41f91401-cef9-549f-bff1-4564e72761f4" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r08" traceId="TR-004:R08-&gt;b5cacc1c-07cd-51df-a5b3-51ab5bb96b29" generatedFrom="R08" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="After the selected payment condition is satisfied, the backend shall request exactly one logical dispense and correlate the device result with the transaction." />
  <businessRules id="6f3341c5-19a3-51fe-8704-15f89157ca81" name="Successful completion Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="97b1b08e-0052-5681-b836-9131e8f4492c" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r09" traceId="TR-004:R09-&gt;6f3341c5-19a3-51fe-8704-15f89157ca81" generatedFrom="R09" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="A confirmed dispense shall result in one completed sale and the corresponding inventory change." />
  <businessRules id="2397fa73-fa95-5f28-8ac0-0d0c157127fa" name="Failure compensation Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="84647556-3114-5cab-a248-404ed63100bf" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r10" traceId="TR-004:R10-&gt;2397fa73-fa95-5f28-8ac0-0d0c157127fa" generatedFrom="R10" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="If a paid/authorized transaction cannot be dispensed within policy, the backend shall execute the defined compensation/refund path and reach a reconcilable terminal state." />
  <businessRules id="e0124dad-95b7-5f33-9685-9663db7310ef" name="Idempotency Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="a5f2948d-6183-5874-b974-cb7df84654ce" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r11" traceId="TR-004:R11-&gt;e0124dad-95b7-5f33-9685-9663db7310ef" generatedFrom="R11" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Replayed commands/events shall not create duplicate charges, duplicate dispenses, duplicate inventory decrements or duplicate terminal transitions." />
  <businessRules id="f1fa404b-6c89-59f9-ba9b-fc483488a507" name="Out-of-order and duplicate events Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="a949cea5-1122-5e3e-9068-2b6fda50bb57" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r12" traceId="TR-004:R12-&gt;f1fa404b-6c89-59f9-ba9b-fc483488a507" generatedFrom="R12" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="The backend shall tolerate duplicate or late device/provider messages according to explicit state-transition rules." />
  <businessRules id="0829a258-2878-503c-b39c-815eeb8430a1" name="Low-stock event Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="ecfc2b25-049e-56dd-bf05-1aea654aa59f" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r13" traceId="TR-004:R13-&gt;0829a258-2878-503c-b39c-815eeb8430a1" generatedFrom="R13" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Crossing the configured low-stock threshold shall produce an operational signal without uncontrolled duplicate alerts." />
  <businessRules id="51aa090d-f2d9-5ec0-96fc-d6d43a2748b9" name="Heartbeat and offline detection Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="3b94e58e-70ee-5706-a993-45b5461b5704" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r14" traceId="TR-004:R14-&gt;51aa090d-f2d9-5ec0-96fc-d6d43a2748b9" generatedFrom="R14" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Missing heartbeat beyond the agreed threshold shall make the machine operationally visible as offline/unavailable according to policy." />
  <businessRules id="4a36a306-585e-5ab7-a3e3-438b7f4e826e" name="Fault handling Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="24ac2fef-dc7b-53b5-8606-bcdc11d54509" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r15" traceId="TR-004:R15-&gt;4a36a306-585e-5ab7-a3e3-438b7f4e826e" generatedFrom="R15" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Machine fault events shall be recorded and routed to an appropriate operational response without corrupting active transaction state." />
  <businessRules id="554e556a-fa93-520a-b3e0-7119bf873936" name="Refill Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="6b27d947-27ae-51f3-9a11-d5f49d14fae9" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r16" traceId="TR-004:R16-&gt;554e556a-fa93-520a-b3e0-7119bf873936" generatedFrom="R16" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="An authorized technician/operator can record a refill; inventory becomes available according to the accepted business rule and an audit entry is retained." />
  <businessRules id="4774f0a3-93cf-5ffd-b7a4-61c415dbfb29" name="Auditability Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="67c42438-1777-5f85-802d-b337dfafde57" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r18" traceId="TR-004:R18-&gt;4774f0a3-93cf-5ffd-b7a4-61c415dbfb29" generatedFrom="R18" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Security-sensitive and transaction state changes shall leave sufficient audit evidence for investigation while respecting retention/privacy policy." />
  <businessRules id="6b951ece-6b1e-5668-aaa8-ce0a6eb91fe7" name="Observability Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="370b17d1-0c5b-5ccf-8020-59686891c5a0" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r19" traceId="TR-004:R19-&gt;6b951ece-6b1e-5668-aaa8-ce0a6eb91fe7" generatedFrom="R19" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="The backend shall provide enough logs, metrics/traces and correlation identifiers to follow a transaction across API, payment, workflow and device integration boundaries." />
  <businessRules id="37e4a354-8fc3-5510-b6dd-6b3dbc172214" name="Retry and dead-letter behavior Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="8db365d9-2101-5b89-bfb6-cf03fa3ac544" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r20" traceId="TR-004:R20-&gt;37e4a354-8fc3-5510-b6dd-6b3dbc172214" generatedFrom="R20" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Transient integration failures shall use bounded retry/backoff and an explicit terminal/dead-letter/reconciliation path." />
  <businessRules id="30464bf6-c92b-57b0-bc57-f91450823589" name="Recovery Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="ea926e23-9a41-5a40-94f3-30f7499f4acc" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r22" traceId="TR-004:R22-&gt;30464bf6-c92b-57b0-bc57-f91450823589" generatedFrom="R22" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Restart/redeployment or worker failure shall not lose an acknowledged transaction and shall not repeat irreversible side effects." />
  <businessRules id="6ac7c98a-b43d-5bd8-8f01-d0edfa0550c8" name="Traceability Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="fe53f947-86dc-552f-b288-e3432165ba38" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r24" traceId="TR-004:R24-&gt;6ac7c98a-b43d-5bd8-8f01-d0edfa0550c8" generatedFrom="R24" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Selected requirements shall be traceable through models and verification evidence sufficiently to identify where a failed acceptance condition originates." />
  <businessRules id="1547121b-2058-57d8-aafb-78e4ed3d500c" name="Changeability Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="20d24a25-8d47-5c49-b374-68f74ca78134" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#r25" traceId="TR-004:R25-&gt;1547121b-2058-57d8-aafb-78e4ed3d500c" generatedFrom="R25" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="A defined policy change shall be propagated through affected model levels and regenerated artifacts with regression evidence." />
  <businessRules id="8a3dbc76-0942-54b6-b3fb-751f54d07bad" name="Configurable automatic sale suspension after heartbeat loss Requirement Rule" lifecycleStatus="APPROVED" incomingTraces="75a6d8fb-6f99-5148-9c33-123c495510f2" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#section-9-C1" traceId="TR-004:C1-&gt;8a3dbc76-0942-54b6-b3fb-751f54d07bad" generatedFrom="C1" generatedByTransformation="true" rationale="Generated by TR-004 from Requirement." reviewStatus="accepted" manuallyMaintained="false" naturalLanguageRule="Crossing the configured class threshold blocks new purchases with MACHINE_UNAVAILABLE, emits one signal, requires a valid new heartbeat before operator clear, and leaves in-flight transactions to their guarded finish/compensation path." />
