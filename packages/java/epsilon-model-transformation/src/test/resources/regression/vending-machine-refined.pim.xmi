  <readiness id="readiness_e32214ac-0153-5a12-97dd-9ec5694dce90" name="PIM readiness assessment" generatedFrom="vending-cim-root" generatedByTransformation="true" rationale="Generated by TR-001 to contain transformation readiness evidence." assessedBy="CIM-to-PIM transformation" transformationReady="true" deploymentReady="false" productionReady="false" readinessStatus="TRANSFORMATION_READY">
    <findings id="e61480b8-b504-5d72-9928-f93d958ffa55" name="Risk - Stock risk" ruleId="TR-160" message="Concurrent baskets race for scarce units." recommendation="Preserve atomic all-line stock changes and replay protection; run last-unit and partial-basket tests." blocking="false" findingType="OTHER" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="f2cfda39-05c9-5a38-835b-0938b3bc59e5" name="Risk - Late-Capture risk" ruleId="TR-160" message="Capture is learned after expiry or cancellation released stock." recommendation="Never reopen; durable full-refund obligation and stable financial keys; test reordered results." blocking="false" findingType="OTHER" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="7ffa2e37-8c5d-5d48-8f53-474e3a0a5043" name="Risk - Erasure risk" ruleId="TR-160" message="Payment/refund or event archives outlive or are erased before their obligation settles." recommendation="Retention inventory across every store; verify settlement before erasure, reject unknown late facts afterwards." blocking="false" findingType="OTHER" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="c2f3ae7f-6fad-5874-b96f-9f8c653cc101" name="Assumption - CV01 Expected active machines" ruleId="TR-160" message="10 active synthetic machines; deterministic fixture uses M1." recommendation="Run V15 with the 10-machine study profile; revise before any company workload claim." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="dd266b05-8f12-54d5-be8b-052a90aef9aa" name="Assumption - CV02 Purchase requests per minute" ruleId="TR-160" message="20 normal and 100 peak purchase requests per minute for the synthetic evaluation profile." recommendation="Measure 100 requests and report latency/error percentiles under normal and peak load." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="df03daae-c3e3-5098-b9f1-ccce38751e22" name="Assumption - CV03 Telemetry and heartbeat frequency" ruleId="TR-160" message="One authenticated heartbeat per machine every 60 seconds in the baseline fixture." recommendation="Advance the controllable clock and verify offline detection; C1 adds per-machine-class thresholds." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="77041d91-bcd9-5eb0-8d28-6d1b768f2e51" name="Assumption - CV04 Target API p95 and p99 latency" ruleId="TR-160" message="Study targets: p95 &lt;= 500 ms and p99 &lt;= 1000 ms at the declared fixture load." recommendation="Measure on Floci and report environment, cold/warm split, and all errors." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="d508d150-ed94-56e4-82c0-da27e3282225" name="Assumption - CV05 Maximum vend confirmation time" ruleId="TR-160" message="60 seconds from logical dispense dispatch to device confirmation before timeout/compensation handling." recommendation="Inject device timeout, duplicate, and late acknowledgement; verify one terminal outcome." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="c7e832f1-96eb-515d-9b4f-91f27cb384fa" name="Assumption - CV06 Payment-provider retry policy" ruleId="TR-160" message="At most three automatic attempts with 1, 2, and 4 second backoff; reuse one stable provider key. Refund retries remain bounded and use their stable refund key." recommendation="Inject decline, pre-acceptance failure, timeout-after-acceptance, and refund success/failure." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="30ebfcbd-1b84-5939-a82a-543b7461ec52" name="Assumption - CV07 Data retention and audit" ruleId="TR-160" message="Retain transaction/audit evidence for 90 days in the synthetic study; retain unresolved refund/reconciliation evidence until settled." recommendation="Inspect retention behavior and confirm unresolved obligations are not deleted." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="8b05e22e-71b2-5bcb-96b5-e5b287b85343" name="Assumption - CV08 Region and security constraints" ruleId="TR-160" message="Local Floci emulates us-east-1; synthetic identities only; no real card data or production credentials; no cross-region requirement is asserted." recommendation="Inspect generated source, environment, logs, and templates for embedded secrets or card data." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="256434eb-afd1-5681-afc9-bdf526bf7ff6" name="Assumption - CV09 Recovery objectives" ruleId="TR-160" message="Study targets: RTO 15 minutes and RPO 5 minutes for acknowledged transaction state." recommendation="Restart the emulator/application after a committed step and verify no repeated irreversible effect." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="4a855c20-1e73-5544-aa41-2eb57f9e306e" name="Assumption - CV10 Cost and monthly workload profile" ruleId="TR-160" message="Synthetic profile: 10 active machines, 20 normal and 100 peak requests/minute, 60-second heartbeat, and approximately 864,000 purchase requests/month at steady normal volume; no production cost budget is asserted." recommendation="Record the workload and environment; calculate actual cloud cost only in an approved account." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="09fae7a4-c65b-5c0d-b24f-017580bd8c3f" name="Assumption - CV11 Preferred non-production environment" ruleId="TR-160" message="MODRISS editor Test workspace deployed to an isolated local Floci emulator." recommendation="Capture editor deployment and API/Lambda/workflow execution evidence." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
    <findings id="5f4e812c-a4c5-58ee-a270-40f8bbbfa22c" name="Assumption - CV12 Assistant treatment" ruleId="TR-160" message="Disabled for this deterministic run; all models are authored and reviewed without an LLM assistant." recommendation="Confirm the assistant is not invoked in model construction or validation." blocking="false" findingType="TRANSFORMATION_ASSUMPTION" affectedElements="e32214ac-0153-5a12-97dd-9ec5694dce90" />
