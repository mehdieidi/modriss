    <constraints id="8bc2cff1-ee8c-5caf-8e56-c091c628d736" name="Compensation remains due Constraint" lifecycleStatus="APPROVED" incomingTraces="b06babd6-9fe0-5981-b8ab-9df4144c8127" sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#section-5" traceId="TR-070:cond-refund-&gt;8bc2cff1-ee8c-5caf-8e56-c091c628d736" generatedFrom="cond-refund" generatedByTransformation="true" rationale="Generated by TR-070 from Condition." reviewStatus="accepted" manuallyMaintained="false" expressionLanguage="NATURAL_LANGUAGE" expression="Verified capture, refund obligation pending, stable key and eligible retry instant; after automatic exhaustion only staff may initiate another submission. Initial attempt count zero is eligible immediately. Later automatic submission requires attempts &lt; 3 and a recorded failure/timeout with nextRefund due. Accepted pending submissions with no due failure are reconciled, not resubmitted automatically. At attempts &gt;= 3 only an explicit staff retry is eligible, using the same key." message="Verified capture, refund obligation pending, stable key and eligible retry instant; after automatic exhaustion only staff may initiate another submission. Initial attempt count zero is eligible immediately. Later automatic submission requires attempts &lt; 3 and a recorded failure/timeout with nextRefund due. Accepted pending submissions with no due failure are reconciled, not resubmitted automatically. At attempts &gt;= 3 only an explicit staff retry is eligible, using the same key." severity="WARNING" />
  </schemas>
