  "universalSyntax": [
    {
      "primitive": "Container",
      "notation": "Rounded large frame with title bar and optional swimlane/header.",
      "interaction": "Spatial containment changes containment or membership only when valid."
    },
    {
      "primitive": "Primary resource card",
      "notation": "AWS/SAM/CloudFormation card with logicalId, AWS type, physicalName, status badges, and service-specific tabs.",
      "interaction": "Primary deployment attributes are inline; full CloudFormation/SAM details remain editable in the inspector."
    },
    {
      "primitive": "Attached policy/constraint badge",
      "notation": "Small labeled pin for IAM, KMS, public access, tracing, logging, retry, retention, import, and deletion-protection concerns.",
      "interaction": "Click opens the deployable policy/config object; pinning creates a full card where valid."
    },
    {
      "primitive": "Generated relationship view",
      "notation": "Clean diagram edge backed by deployable resources such as permissions, integrations, subscriptions, event mappings, and notification rules.",
      "interaction": "The edge opens both the relationship view and the underlying deployable resources."
    },
    {
      "primitive": "Structured property row",
      "notation": "CloudFormation NativeProperty, ValueExpression, parameters, mappings, conditions, outputs, JSON, and ASL documents render as side-panel rows/editors.",
      "interaction": "Structured values are edited in the inspector instead of becoming graph nodes by default."
    }
  ],
  "kernelSyntax": [
    {
      "element": "ModelElement / TraceableElement",
      "notation": "Hidden metadata layer with lifecycle, generated, rationale, review, and trace badges.",
      "surfaces": [
        "inspector",
        "search",
        "trace overlay",
        "status badges"
      ]
    },
    {
      "element": "Annotation / KeyValue",
      "notation": "Key-value chips attached to a card or listed in an annotations tab.",
      "surfaces": [
        "inspector",
        "detail projection"
      ]
    },
    {
      "element": "TraceModel / TraceLink",
      "notation": "Separate traceability overlay with dashed labeled links and confidence filtering.",
      "surfaces": [
        "trace view",
        "relationship matrix"
      ]
    },
    {
      "element": "Expression / StructuredDocument",
      "notation": "Expandable expression or document editor with compact card badge.",
      "surfaces": [
        "inspector",
        "detail modal"
      ]
    },
    {
      "element": "ProductionReadinessAssessment / findings / checks / decisions",
      "notation": "Readiness board and severity markers on affected elements.",
      "surfaces": [
        "readiness board",
        "validation overlay"
      ]
    }
  ],
  "complexityManagement": [
    {
      "technique": "Stage and stack decomposition",
      "behavior": "AwsStage lanes and SamStack containers are the primary scale controls; overview dashboards show counts and blockers."
    },
    {
      "technique": "Service-specific detail tabs",
      "behavior": "Lambda, API Gateway, EventBridge, SQS, SNS, DynamoDB, S3, IAM, Cognito, Step Functions, CloudWatch, and VPC resources expose containment-specific tabs."
    },
    {
      "technique": "Structured CloudFormation panels",
      "behavior": "NativeProperty, ValueExpression, parameters, mappings, conditions, outputs, policy JSON, OpenAPI, and ASL render in structured side panels."
    },
    {
      "technique": "Generated relationship views",
      "behavior": "Common AWS integrations use clean relationship edges while preserving underlying deployable resources in the inspector."
    },
    {
      "technique": "Security matrix",
      "behavior": "IAM statements, wildcard warnings, KMS usage, secrets, and policy target resources default to matrix/table presentation."
    },
    {
      "technique": "Semantic zoom",
      "behavior": "Far zoom shows stages/stacks and resource counts; mid zoom shows resource cards and ports; near zoom shows compartments and edge labels."
    },
    {
      "technique": "Validation overlays",
      "behavior": "ProductionMode and AwsSecurityBaseline drive markers for public access, encryption, deletion protection, wildcard IAM, tracing/logging, and least privilege."
    },
    {
      "technique": "Trace overlay",
      "behavior": "Trace links remain a separate layer with confidence filters."
    },
    {
      "technique": "Saved viewpoints",
      "behavior": "Views persist filters, layout, camera positions, and edge-layer choices."
    }
  ],
