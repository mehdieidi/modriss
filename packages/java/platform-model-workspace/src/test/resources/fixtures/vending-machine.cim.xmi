  <requirements id="C1" xsi:type="cimorg:Requirement" name="Configurable automatic sale suspension after heartbeat loss" description="For each machine class, configure a heartbeat-loss threshold. Crossing it automatically suspends new sales with MACHINE_UNAVAILABLE and emits one operational event. An operator may clear suspension only after a new valid heartbeat. Existing in-flight transactions finish or compensate according to their current transaction state; the change must preserve authorization, idempotency, reconciliation, audit, and test evidence." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#section-9-C1" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="BUSINESS_RULE" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="ent-machine info-heartbeat-threshold cmd-checkout cmd-product evt-notice-prepared proc-notices" fitCriterion="Crossing the configured class threshold blocks new purchases with MACHINE_UNAVAILABLE, emits one signal, requires a valid new heartbeat before operator clear, and leaves in-flight transactions to their guarded finish/compensation path." generatedByTransformation="false" manuallyMaintained="true">
    <acceptanceCriteria id="C1-ac" xsi:type="cimorg:AcceptanceCriterion" name="Configurable automatic sale suspension after heartbeat loss acceptance" description="For each machine class, configure a heartbeat-loss threshold. Crossing it automatically suspends new sales with MACHINE_UNAVAILABLE and emits one operational event. An operator may clear suspension only after a new valid heartbeat. Existing in-flight transactions finish or compensate according to their current transaction state; the change must preserve authorization, idempotency, reconciliation, audit, and test evidence." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#section-9-C1" givenContext="An enabled machine of a configured class with one in-flight transaction and controllable heartbeat clock." whenAction="Advance beyond its class heartbeat threshold, attempt a new purchase, then send a valid heartbeat and request operator clearance." thenOutcome="The new purchase is rejected with MACHINE_UNAVAILABLE and one event; operator clearance succeeds only after the valid heartbeat; the in-flight transaction completes or compensates according to state." measurableTarget="No new sale is accepted while suspended; exactly one alert per crossing; no duplicate completion/refund for the in-flight request." automatableTestCandidate="true" />
  </requirements>
