  <aggregates id="agg-sale" name="Vend and stock consistency boundary" description="Reserve or decrement the selected slot once with the transaction state; payment/dispense failure compensation is durably correlated and cannot create a second sale." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#section-5" xsi:type="cimdomain:AggregateCandidate" root="ent-order" members="ent-order ent-line ent-product ent-payment ent-machine ent-slot" context="ctx-commerce" strongConsistencyRequired="true" consistencyExpectation="MULTI_ENTITY_STRONG_CONSISTENCY" consistencyBoundaryRationale="Prevent partial baskets, overselling, double stock release, stale payment acceptance and cancellation/readiness races." idempotencyBusinessKey="machine ID + transaction ID + actor + stable request/payment/device/refund key" handledCommands="cmd-product cmd-restock cmd-checkout cmd-open-payment cmd-payment cmd-reconcile cmd-expire cmd-cancel cmd-refund cmd-ready cmd-collect" generatedByTransformation="false" manuallyMaintained="false">
    <invariants id="inv-stock" name="Stock invariant" description="Available stock never falls below zero; a failed checkout changes no product and creates no order." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#sections-1-8" xsi:type="cimdomain:BusinessInvariant" naturalLanguageStatement="Available stock never falls below zero; a failed checkout changes no product and creates no order." constrainedConcepts="ent-product ent-order ent-line ent-payment" violationSeverity="ERROR" generatedByTransformation="false" manuallyMaintained="false" />
    <invariants id="inv-release" name="Release invariant" description="Each line releases its reserved or committed quantity at most once; collection never returns stock." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#sections-1-8" xsi:type="cimdomain:BusinessInvariant" naturalLanguageStatement="Each line releases its reserved or committed quantity at most once; collection never returns stock." constrainedConcepts="ent-product ent-order ent-line ent-payment" violationSeverity="ERROR" generatedByTransformation="false" manuallyMaintained="false" />
    <invariants id="inv-money" name="Money invariant" description="Order/line price snapshots are immutable; integer totals match provider capture and full refund amounts." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#sections-1-8" xsi:type="cimdomain:BusinessInvariant" naturalLanguageStatement="Order/line price snapshots are immutable; integer totals match provider capture and full refund amounts." constrainedConcepts="ent-product ent-order ent-line ent-payment" violationSeverity="ERROR" generatedByTransformation="false" manuallyMaintained="false" />
    <invariants id="inv-deadline" name="Deadline invariant" description="A first capture is accepted as PAID only if order awaiting and processing time and capturedAt are both strictly before expiresAt; duplicate applied captures remain no-ops." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#sections-1-8" xsi:type="cimdomain:BusinessInvariant" naturalLanguageStatement="A first capture is accepted as PAID only if order awaiting and processing time and capturedAt are both strictly before expiresAt; duplicate applied captures remain no-ops." constrainedConcepts="ent-product ent-order ent-line ent-payment" violationSeverity="ERROR" generatedByTransformation="false" manuallyMaintained="false" />
    <invariants id="inv-refund" name="Refund invariant" description="Each verified capture has at most one full refund obligation; closing an order and recording that obligation is one atomic change." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#sections-1-8" xsi:type="cimdomain:BusinessInvariant" naturalLanguageStatement="Each verified capture has at most one full refund obligation; closing an order and recording that obligation is one atomic change." constrainedConcepts="ent-product ent-order ent-line ent-payment" violationSeverity="ERROR" generatedByTransformation="false" manuallyMaintained="false" />
    <invariants id="inv-fulfill" name="Fulfill invariant" description="Only paid complete orders become READY; only READY orders become COLLECTED; cancellation and readiness cannot both win." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#sections-1-8" xsi:type="cimdomain:BusinessInvariant" naturalLanguageStatement="Only paid complete orders become READY; only READY orders become COLLECTED; cancellation and readiness cannot both win." constrainedConcepts="ent-product ent-order ent-line ent-payment" violationSeverity="ERROR" generatedByTransformation="false" manuallyMaintained="false" />
  </aggregates>
  <aggregates id="agg-notice" name="Operational alert consistency boundary" description="One alert identity is emitted per qualifying state transition; replay does not create uncontrolled duplicate notifications." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#section-5" xsi:type="cimdomain:AggregateCandidate" root="ent-notice" members="ent-notice" context="ctx-notices" strongConsistencyRequired="true" consistencyExpectation="SINGLE_ENTITY" consistencyBoundaryRationale="One intent per committed fact/order/kind and no concurrent duplicate attempt." idempotencyBusinessKey="fact + order + notice kind; notice + attempt ordinal" handledCommands="cmd-prepare-notice cmd-deliver-notice" generatedByTransformation="false" manuallyMaintained="false">
    <invariants id="inv-notice" name="Notice attempt invariant" description="A notice has at most three provider calls; exact replay and suppression have no extra call." sourceReference=".idea/03_Vending_Machine_Backend_Case_Pack.md#sections-1-8" xsi:type="cimdomain:BusinessInvariant" naturalLanguageStatement="At most three serialized delivery attempts per notice; one stable provider deduplication key." constrainedConcepts="ent-notice" violationSeverity="ERROR" generatedByTransformation="false" manuallyMaintained="false" />
  </aggregates>
