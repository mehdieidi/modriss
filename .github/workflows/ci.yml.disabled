name: CI

on:
  push:
    branches: [main, master]
  pull_request:

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: maven

      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm

      - uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Install Node dependencies
        run: npm ci

      - name: Install Python lint dependencies
        run: pip install -r config/requirements-lint.txt

      - name: Check formatting
        run: python scripts/format.py --check

      - name: Run linters
        run: python scripts/lint.py

      - name: Check Flyway migration versions
        run: python scripts/check-flyway-migration-versions.py --changed-only

      - name: Run Python tooling tests
        run: python -m unittest discover -s scripts/tests

      - name: Validate process coverage
        run: node methodology/process/tools/validate-coverage.mjs

      - name: Run Maven tests
        run: mvn test

  flyway-migrations:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
          cache: maven

      - name: Verify Flyway migrations on empty PostgreSQL
        run: python scripts/verify-flyway-migrations.py

  docker-build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Build backend image
        run: docker build -f deploy/Dockerfile -t modriss-backend:ci .
