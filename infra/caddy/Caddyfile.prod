{
	# Prometheus scrapes caddy:2019 over the Docker network; this port is not published on the host.
	admin :2019
	servers {
		metrics
	}
}

(security_headers) {
	header {
		?X-Content-Type-Options nosniff
		?X-Frame-Options DENY
		?Referrer-Policy no-referrer
		?Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}

(backend_routes) {
	@backend path /api/* /actuator/* /v3/api-docs* /swagger-ui* /swagger-ui.html
	reverse_proxy @backend backend:8080
}

(access_logs) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}
}

modriss.site {
	import security_headers
	import access_logs
	import backend_routes

	reverse_proxy landing:8083
}

www.modriss.site {
	import security_headers
	import access_logs
	redir https://modriss.site{uri} permanent
}

editor.modriss.site {
	import security_headers
	import access_logs
	import backend_routes
	header {
		# The editor serves unhashed JS/CSS files. Always revalidate them after a deployment.
		Cache-Control "no-cache, must-revalidate"
	}

	reverse_proxy frontend:8082
}

admin.modriss.site {
	import security_headers
	import access_logs
	import backend_routes

	reverse_proxy admin:8084
}

api.modriss.site {
	import security_headers
	import access_logs
	reverse_proxy backend:8080
}
