{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"varka-backend\"}[5m]))",
          "legendFormat": "requests/s"
        }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"varka-backend\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "title": "HTTP latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"varka-backend\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"varka-backend\"}",
          "legendFormat": "idle"
        }
      ],
      "title": "Database connection pool",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "increase(varka_mde_jobs_submitted_total[1h])",
          "legendFormat": "submitted"
        },
        {
          "expr": "increase(varka_mde_jobs_failed_total[1h])",
          "legendFormat": "failed"
        }
      ],
      "title": "MDE jobs (1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "increase(varka_assistant_requests_total[1h])",
          "legendFormat": "requests"
        },
        {
          "expr": "increase(varka_assistant_circuit_open_total[1h])",
          "legendFormat": "circuit open"
        }
      ],
      "title": "Assistant (1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 8,
      "targets": [
        {
          "expr": "sum by (outcome) (increase(varka_assistant_turn_outcome_total[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "title": "Assistant turn outcomes (1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 9,
      "targets": [
        {
          "expr": "sum by (provider, result) (increase(varka_assistant_provider_calls_total[1h]))",
          "legendFormat": "{{provider}} {{result}}"
        }
      ],
      "title": "Assistant provider calls (1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 6,
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"varka-backend\"})",
          "legendFormat": "used"
        }
      ],
      "title": "JVM memory used",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 7,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"varka-backend\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"varka-backend\"}[5m]))",
          "legendFormat": "5xx ratio"
        }
      ],
      "title": "HTTP 5xx error ratio",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["varka", "backend"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "label": "Datasource",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Varka Overview",
  "uid": "varka-overview",
  "version": 1
}
