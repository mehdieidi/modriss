<mxCell id="text-76" value="1 · Operations-only resolution with evidence" style="text;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#111111;verticalAlign=middle;align=left;whiteSpace=wrap;autosize=0;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="452" y="584.472" width="335.36" height="17.4" as="geometry"/></mxCell>
<mxCell id="text-77" value="2 · Shortest safe MDE path + release controls" style="text;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#111111;verticalAlign=middle;align=left;whiteSpace=wrap;autosize=0;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="452" y="604.472" width="342.8" height="17.4" as="geometry"/></mxCell>
