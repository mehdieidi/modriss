<mxCell id="text-81" value="The accepted baseline stays live while planned releases proceed." style="text;html=1;fontFamily=Times New Roman;fontSize=12;fontColor=#111111;verticalAlign=middle;align=left;whiteSpace=wrap;autosize=0;spacing=0;overflow=visible;" vertex="1" parent="1"><mxGeometry x="772" y="584.472" width="484.16" height="17.4" as="geometry"/></mxCell>
