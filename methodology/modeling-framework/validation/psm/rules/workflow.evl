/** Validates the semantic rules for workflow. */
import "../lib/psm-validation-helpers.eol";

/* Workflow / Step Functions / ASL */

context AWSPSM!StepFunctionStateMachine {
  /** Checks that state machine has role. */
  constraint StateMachineHasRole {
    check : self.role.isDefined()
    message : 'Step Functions state machine ' + self.resourceLabel() + ' has no execution role. Fix: attach an IamRole trusted by states.amazonaws.com.'
  }

  /** Checks that state machine has definition. */
  constraint StateMachineHasDefinition {
    check : self.definitionCount() >= 1
    message : 'Step Functions state machine ' + self.resourceLabel() + ' has no definition. Fix: provide definitionUri, definitionString, or aslDocument.'
  }

  /** Advises that state machine should use single definition source. */
  critique StateMachineShouldUseSingleDefinitionSource {
    check : self.definitionCount() <= 1
    message : 'Step Functions state machine ' + self.resourceLabel() + ' defines more than one definition source. Fix: keep exactly one of definitionUri, definitionString, or aslDocument to avoid ambiguity.'
  }

  /** Checks that state machine asl has states. */
  constraint StateMachineAslHasStates {
    guard : self.aslDocument.isDefined()
    check : self.aslDocument.states.notEmpty()
    message : 'Step Functions state machine ' + self.resourceLabel() + ' has an ASL document with no states. Fix: add AslState entries or remove the empty ASL document.'
  }

  /** Checks that publish alias requires alias name. */
  constraint PublishAliasRequiresAliasName {
    guard : self.publishAlias = true
    check : self.aliasName.hasText()
    message : 'Step Functions state machine ' + self.resourceLabel() + ' publishes an alias but aliasName is empty. Fix: set aliasName.'
  }

  /** Advises that production state machine should log and trace. */
  critique ProductionStateMachineShouldLogAndTrace {
    guard : self.isProductionScoped()
    check : self.logging.isDefined() and self.tracing.isDefined() and self.tracing.enabled = true
    message : 'Production-scoped state machine ' + self.resourceLabel() + ' lacks logging or tracing. Fix: add StepFunctionLoggingConfig and enable tracing.'
  }
}

/** Validates Asl Document elements. */
context AWSPSM!AslDocument {
  /** Checks that start at references existing state. */
  constraint StartAtReferencesExistingState {
    check : self.startAt.hasText() and self.hasStateNamed(self.startAt)
    message : 'ASL document startAt value ' + self.startAt + ' does not match any stateName. Fix: set startAt to the name of an existing AslState.'
  }

  /** Checks that state names unique. */
  constraint StateNamesUnique {
    check : self.duplicateStateNames().isEmpty()
    message : 'ASL document contains duplicate state names: ' + self.duplicateStateNames().concat(', ') + '. Fix: give every AslState a unique stateName.'
  }

  /** Checks that asl has terminal state. */
  constraint AslHasTerminalState {
    check : self.states.exists(stateItem |
      (stateItem.end = true) or stateItem.isKindOf(AWSPSM!AslSucceedState) or stateItem.isKindOf(AWSPSM!AslFailState))
    message : 'ASL document has no terminal state. Fix: mark one state end=true or add AslSucceedState/AslFailState.'
  }
}

/** Validates Asl State elements. */
context AWSPSM!AslState {
  /** Checks that non terminal state has next or terminal type. */
  constraint NonTerminalStateHasNextOrTerminalType {
    check : (self.end = true) or self.nextState.isDefined() or self.nextStateName.hasText() or
      self.isKindOf(AWSPSM!AslSucceedState) or self.isKindOf(AWSPSM!AslFailState) or self.isKindOf(AWSPSM!AslChoiceState)
    message : 'ASL state ' + self.stateName + ' is not terminal and has no next state. Fix: set nextState/nextStateName, mark end=true, or use a terminal/choice state class.'
  }

  /** Checks that terminal state does not have next. */
  constraint TerminalStateDoesNotHaveNext {
    guard : (self.end = true) or self.isKindOf(AWSPSM!AslSucceedState) or self.isKindOf(AWSPSM!AslFailState)
    check : self.nextState.isUndefined() and (not self.nextStateName.hasText())
    message : 'Terminal ASL state ' + self.stateName + ' also defines a next state. Fix: remove nextState/nextStateName from terminal states.'
  }

}

/** Validates ASL Task State elements. */
context AWSPSM!AslTaskState {
  /** Checks that task state has resource. */
  constraint TaskStateHasResource {
    check : self.resource.hasText() or self.invokedResource.isDefined()
    message : 'AslTaskState ' + self.stateName + ' has no resource or invokedResource. Fix: set the AWS service ARN/resource string or reference the invoked PSM resource.'
  }

  /** Prevents the Lambda optimized integration from being emitted without a function target. */
  constraint LambdaIntegrationHasFunctionTarget {
    guard : self.resource = 'arn:aws:states:::lambda:invoke' or self.resource = 'arn:aws:states:::lambda:invoke.waitForTaskToken'
    check : self.invokedResource.isDefined() or self.argumentsJson.hasText() or self.parametersJson.hasText()
    message : 'ASL Lambda integration ' + self.stateName + ' has no function target. Fix: reference invokedResource or provide FunctionName in Arguments/Parameters.'
  }

  /** Prevents nested execution integration from omitting the target state machine ARN. */
  constraint NestedExecutionHasStateMachineTarget {
    guard : self.resource = 'arn:aws:states:::states:startExecution.sync'
    check : self.invokedResource.isDefined() and self.argumentsJson.hasText()
    message : 'ASL nested execution ' + self.stateName + ' has no target state machine arguments. Fix: reference the nested Step Functions resource and provide StateMachineArn in Arguments.'
  }
}

/** Validates the query-language boundary used by generated ASL states. */
context AWSPSM!AslState {
  constraint JsonataStateDoesNotUseJsonPathFields {
    guard : self.queryLanguage = 'JSONata'
    check : not self.inputPath.hasText() and not self.outputPath.hasText() and
      not self.resultPath.hasText() and not self.parametersJson.hasText()
    message : 'JSONata ASL state ' + self.stateName + ' uses JSONPath-only fields. Fix: use Arguments/Output or change the state query language to JSONPath.'
  }
}

/** Validates ASL wait timing. */
context AWSPSM!AslWaitState {
  constraint WaitStateHasTiming {
    check : self.timeoutSeconds.isDefined() and self.timeoutSeconds >= 0
    message : 'ASL wait state ' + self.stateName + ' has no timing value. Fix: provide a supported duration or model callback/event completion before deployment.'
  }
}

/** Validates ASL Choice State elements. */
context AWSPSM!AslChoiceState {
  /** Checks that choice state has choices. */
  constraint ChoiceStateHasChoices {
    check : self.choices.notEmpty()
    message : 'AslChoiceState ' + self.stateName + ' has no choices. Fix: add one or more AslChoiceRule entries.'
  }
}

/** Validates Asl Retry Rule elements. */
context AWSPSM!AslRetryRule {
  /** Checks that retry rule ranges valid. */
  constraint RetryRuleRangesValid {
    check : ((self.intervalSeconds.isUndefined()) or (self.intervalSeconds >= 1)) and
      ((self.maxAttempts.isUndefined()) or (self.maxAttempts >= 0)) and
      ((self.backoffRate.isUndefined()) or (self.backoffRate >= 1.0)) and
      ((self.maxDelaySeconds.isUndefined()) or (self.maxDelaySeconds >= 1))
    message : 'ASL retry rule has invalid range values. Fix: use intervalSeconds >= 1, maxAttempts >= 0, backoffRate >= 1.0, and maxDelaySeconds >= 1.'
  }
}

/** Validates Asl Catch Rule elements. */
context AWSPSM!AslCatchRule {
  /** Checks that catch rule has errors and next. */
  constraint CatchRuleHasErrorsAndNext {
    check : self.errorEquals.notEmpty() and self.nextState.isDefined()
    message : 'ASL catch rule lacks errorEquals or nextState. Fix: list errors to catch and reference the recovery state.'
  }
}

/** Validates Asl Choice Rule elements. */
context AWSPSM!AslChoiceRule {
  /** Checks that choice rule has condition and next. */
  constraint ChoiceRuleHasConditionAndNext {
    check : (self.conditionExpression.hasText() or self.variable.hasText()) and self.nextState.isDefined()
    message : 'ASL choice rule lacks condition/variable or nextState. Fix: define the condition and target state for the choice branch.'
  }
}
