/** Validates the semantic rules for api. */
import "../lib/psm-validation-helpers.eol";

/* API Gateway */

context AWSPSM!ApiGatewayApi {
  /** Checks that api has routes. */
  constraint ApiHasRoutes {
    check : self.routes.notEmpty()
    message : 'API ' + self.resourceLabel() + ' has no routes. Fix: add at least one HttpApiRoute, RestApiRoute, or WebSocketRoute connected to an integration.'
  }

  /** Advises that api should have stage. */
  critique ApiShouldHaveStage {
    check : self.stages.notEmpty()
    message : 'API ' + self.resourceLabel() + ' has no stage. Fix: add an ApiGatewayStage so the API can be deployed.'
  }

  /** Checks that access logs require log group and format. */
  constraint AccessLogsRequireLogGroupAndFormat {
    guard : self.accessLogsEnabled = true
    check : self.accessLogGroup.isDefined()
    message : 'API ' + self.resourceLabel() + ' enables access logs but has no accessLogGroup. Fix: attach a CloudWatchLogGroup for API access logs.'
  }

  /** Advises that production api should have metrics and tracing. */
  critique ProductionApiShouldHaveMetricsAndTracing {
    guard : self.isProductionScoped()
    check : (self.metricsEnabled = true) and ((self.tracingEnabled = true) or self.tracingConfig.isDefined())
    message : 'Production-scoped API ' + self.resourceLabel() + ' does not enable both metrics and tracing. Fix: set metricsEnabled true and enable tracing/tracingConfig unless intentionally disabled with rationale.'
  }
}

/** Validates Http Api Route elements. */
context AWSPSM!HttpApiRoute {
  /** Checks that unique http route within api. */
  constraint UniqueHttpRouteWithinApi {
    check : not duplicateHttpApiRouteKeys().includes(self.httpApiRouteKey())
    message : 'HTTP API route ' + self.method.asString() + ' ' + self.path + ' is duplicated in API ' + self.api.resourceLabel() + '. Fix: make method+path unique within the API.'
  }
}

/** Validates Rest Api Route elements. */
context AWSPSM!RestApiRoute {
  /** Checks that unique rest route within api. */
  constraint UniqueRestRouteWithinApi {
    check : not duplicateRestApiRouteKeys().includes(self.restApiRouteKey())
    message : 'REST API route ' + self.method.asString() + ' ' + self.path + ' is duplicated in API ' + self.api.resourceLabel() + '. Fix: make method+path unique within the API.'
  }
}

/** Validates Web Socket Route elements. */
context AWSPSM!WebSocketRoute {
  /** Checks that unique web socket route key within api. */
  constraint UniqueWebSocketRouteKeyWithinApi {
    check : not duplicateWebSocketRouteKeys().includes(self.webSocketRouteKey())
    message : 'WebSocket routeKey ' + self.routeKey + ' is duplicated in API ' + self.api.resourceLabel() + '. Fix: give each WebSocket route a unique routeKey.'
  }
}

/** Validates Api Gateway Route elements. */
context AWSPSM!ApiGatewayRoute {
  /** Checks that route has api. */
  constraint RouteHasApi {
    check : self.api.isDefined()
    message : 'API route ' + self.resourceLabel() + ' has no owning API. Fix: set ApiGatewayRoute.api to the HttpApi, RestApi, or WebSocketApi that contains the route.'
  }

  /** Checks that protected route has required auth configuration. */
  constraint ProtectedRouteHasRequiredAuthConfiguration {
    check : (self.authorizationType = AWSPSMENUMS!ApiGatewayAuthorizationType#NONE) or
      (self.authorizationType = AWSPSMENUMS!ApiGatewayAuthorizationType#AWS_IAM) or
      (self.authorizationType = AWSPSMENUMS!ApiGatewayAuthorizationType#API_KEY) or
      self.authorizer.isDefined()
    message : 'Protected route ' + self.resourceLabel() + ' has authorizationType ' + self.authorizationType.asString() + ' but no authorizer. Fix: attach a matching JwtAuthorizer, CognitoAuthorizer, or LambdaAuthorizer; AWS_IAM/API_KEY do not require an authorizer object.'
  }

  /** Checks that route has integration. */
  constraint RouteHasIntegration {
    check : self.integration.isDefined()
    message : 'API route ' + self.resourceLabel() + ' has no integration. Fix: attach an ApiGatewayIntegration that points to Lambda, Step Functions, HTTP, AWS, or MOCK target configuration.'
  }

  /** Advises that integration timeout should not exceed lambda timeout. */
  critique IntegrationTimeoutShouldNotExceedLambdaTimeout {
    guard : self.integration.isDefined() and self.integration.lambdaTarget.isDefined() and self.timeoutInMillis.isDefined() and self.integration.lambdaTarget.timeoutSeconds.isDefined()
    check : self.timeoutInMillis >= (self.integration.lambdaTarget.timeoutSeconds * 1000)
    message : 'Route ' + self.resourceLabel() + ' may time out before Lambda ' + self.integration.lambdaTarget.resourceLabel() + '. Fix: align route/integration timeout with the Lambda timeout or make the operation asynchronous.'
  }
}

/** Validates Api Gateway Integration elements. */
context AWSPSM!ApiGatewayIntegration {
  /** Checks that integration has single target. */
  constraint IntegrationHasSingleTarget {
    check : self.targetCount() = 1 or self.integrationType = AWSPSMENUMS!ApiGatewayIntegrationType#MOCK
    message : 'API integration ' + self.resourceLabel() + ' must have exactly one backend target, unless it is MOCK. Fix: set one of lambdaTarget, stateMachineTarget, or integrationUri, and remove conflicting targets.'
  }

  /** Advises that long api gateway timeout requires quota review. */
  critique LongApiGatewayTimeoutRequiresQuotaReview {
    guard : self.timeoutInMillis.isDefined()
    check : self.timeoutInMillis <= 29000
    message : 'API integration ' + self.resourceLabel() + ' has timeoutInMillis greater than 29 seconds. Fix: verify that the API type, region, and account quota support the longer timeout, or redesign as asynchronous.'
  }

  /** Checks that credentials arn matches credentials role. */
  constraint CredentialsArnMatchesCredentialsRole {
    guard : self.credentialsArn.hasText()
    check : self.credentialsRole.isDefined() or self.credentialsArn.matches('^arn:aws[a-zA-Z-]*:iam::[0-9]{12}:role/.+')
    message : 'API integration ' + self.resourceLabel() + ' has a credentialsArn that is not a valid IAM role ARN and no credentialsRole reference. Fix: attach credentialsRole or provide a valid IAM role ARN.'
  }
}

/** Validates Api Gateway Stage elements. */
context AWSPSM!ApiGatewayStage {
  /** Checks that access log stage requires group and format. */
  constraint AccessLogStageRequiresGroupAndFormat {
    guard : self.accessLogEnabled = true
    check : self.resolvedAccessLogGroup().isDefined() and self.accessLogFormat.hasText()
    message : 'API stage ' + self.stageName + ' enables access logs but lacks an access log group or format. Fix: attach a CloudWatchLogGroup on the stage or API and define a JSON access log format.'
  }

  /** Advises that production stage should throttle. */
  critique ProductionStageShouldThrottle {
    guard : self.api.isDefined() and self.api.isProductionScoped()
    check : self.throttlingBurstLimit.isDefined() and self.throttlingRateLimit.isDefined()
    message : 'Production API stage ' + self.stageName + ' has no explicit throttling limits. Fix: set throttlingBurstLimit and throttlingRateLimit to protect backend services.'
  }
}

/** Validates Jwt Authorizer elements. */
context AWSPSM!JwtAuthorizer {
  /** Checks that jwt authorizer has issuer and audience. */
  constraint JwtAuthorizerHasIssuerAndAudience {
    check : self.issuer.hasText() and self.audience.notEmpty()
    message : 'JWT authorizer ' + self.resourceLabel() + ' is missing issuer or audience. Fix: set issuer and add one or more expected audience values.'
  }
}

/** Validates Cognito Authorizer elements. */
context AWSPSM!CognitoAuthorizer {
  /** Advises that cognito authorizer should reference clients. */
  critique CognitoAuthorizerShouldReferenceClients {
    check : self.clients.notEmpty()
    message : 'Cognito authorizer ' + self.resourceLabel() + ' references a user pool but no clients. Fix: attach expected CognitoUserPoolClient entries to restrict accepted app clients.'
  }
}

/** Validates Lambda Authorizer elements. */
context AWSPSM!LambdaAuthorizer {
  /** Checks that lambda authorizer has function. */
  constraint LambdaAuthorizerHasFunction {
    check : self.`function`.isDefined()
    message : 'Lambda authorizer ' + self.resourceLabel() + ' has no Lambda function. Fix: attach the AwsLambdaFunction that implements authorization.'
  }
}

/** Validates Api Gateway Domain Name elements. */
context AWSPSM!ApiGatewayDomainName {
  /** Checks that domain has certificate. */
  constraint DomainHasCertificate {
    check : self.certificateArn.hasText()
    message : 'API Gateway domain ' + self.domainName + ' has no certificateArn. Fix: attach an ACM certificate ARN in the appropriate region for the endpoint type.'
  }
}

/** Validates Api Gateway Usage Plan Key elements. */
context AWSPSM!ApiGatewayUsagePlanKey {
  /** Checks that usage plan key uses known type. */
  constraint UsagePlanKeyUsesKnownType {
    check : self.keyType.hasText() and self.keyType.toUpperCase() = 'API_KEY'
    message : 'Usage plan key ' + self.resourceLabel() + ' has invalid keyType. Fix: set keyType to API_KEY.'
  }
}
