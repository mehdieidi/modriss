/** Maps compute api model elements and supporting relationships. */
rule Function2AwsLambdaFunction
  transform f : COMPUTE!Function
  to l : AWSPSMCOMPUTE!AwsLambdaFunction {

  copyAwsResource(f, l, "Lambda", "AWS::Serverless::Function");
  l.id = idFor("lambda", f);
  l.functionName = l.physicalName;
  l.descriptionText = firstText(firstText(f.handlerResponsibility, f.responsibility), f.summary);
  l.code = createLambdaCodeConfig(f, pimRoot().implementationProfile);
  if (l.code.isKindOf(AWSPSMCOMPUTE!LambdaZipCodeConfig) and isTrue(l.code.generatedByTransformation)) {
    manualDecision("LAMBDA_BUSINESS_LOGIC_IMPLEMENTATION_REQUIRED",
      "Implement and test the generated business logic for Lambda " + f.name + ".",
      KERNEL!Severity#BLOCKER, true, Sequence{f, l},
      "Replace the generated NOT_IMPLEMENTED business-logic region with the behavior derived from the reviewed CIM/PIM model and add unit/integration tests before deployment.");
  }
  if (l.code.eClass().getName() = "LambdaImageCodeConfig") {
    l.packageType = AWSPSMENUMS!PackageType#IMAGE;
  }
  else {
    l.packageType = AWSPSMENUMS!PackageType#ZIP;
  }
  l.memorySizeMb = inferMemoryMb(f);
  l.timeoutSeconds = inferTimeoutSeconds(f);
  l.architecture = AWSPSMENUMS!LambdaArchitecture#ARM64;
  if (isTrue(f.requiresLargeTemporaryStorage)) {
    l.ephemeralStorageMb = 10240;
  }
  else {
    l.ephemeralStorageMb = 512;
  }
  l.reservedConcurrentExecutions = inferReservedConcurrency(f);
  l.recursiveLoopMode = AWSPSMENUMS!LambdaRecursiveLoopMode#TERMINATE;
  l.snapStartApplyOn = AWSPSMENUMS!LambdaSnapStartApplyOn#NONE;
  l.runtimeManagementMode = AWSPSMENUMS!LambdaRuntimeManagementMode#AUTO;
  l.publishVersion = isProductionRoot();
  if (isProductionRoot()) {
    l.autoPublishAlias = "live";
    l.codeSigningDecision = AWSPSMENUMS!Decision#NEEDS_REVIEW;
  }
  else {
    l.autoPublishAlias = "";
    l.codeSigningDecision = AWSPSMENUMS!Decision#UNDECIDED;
  }
  l.role = createLambdaRole(f);
  l.logGroup = createLogGroupFor(f, l.logicalId, "/aws/lambda/" + l.functionName);
  l.tracing = createLambdaTracing(f);
  l.logging = createLambdaLogging(l);
  l.environment.addAll(createLambdaEnvironment(f));
  if (isTrue(f.requiresNetworkAccess)) {
    l.vpcConfig = createVpcAttachmentDecision(f);
  }
  if (isTrue(f.requiresFileSystem)) {
    manualDecision("LAMBDA_EFS_REQUIRED",
      "Provide EFS access point ARN and mount path for Lambda " + f.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{f, l},
      "Model an AWS EFS attachment or remove Function.requiresFileSystem.");
  }
  applyIdempotency(f, l);
  applyFunctionPolicies(f, l);
  createTrace(f, l, "Function2AwsLambdaFunction", "HIGH", KERNEL!TraceLinkType#REALIZES);
}

/** Transforms Api elements into Http Api elements. */
rule Api2HttpApi
  transform api : API!Api
  to g : AWSPSMAPI!HttpApi {

  guard : (api.apiStyle = PIMTYPES!ApiStyle#RESOURCE_ORIENTED_HTTP or api.apiStyle = PIMTYPES!ApiStyle#RPC_HTTP or api.apiStyle = PIMTYPES!ApiStyle#WEBHOOK) and not requiresRestApi(api)

  copyAwsResource(api, g, "HttpApi", "AWS::Serverless::HttpApi");
  g.id = idFor("http_api", api);
  g.apiName = firstText(firstText(api.publicName, api.name), "HttpApi");
  g.descriptionText = api.summary;
  g.accessLogsEnabled = true;
  g.tracingEnabled = true;
  g.metricsEnabled = true;
  g.corsEnabled = isTrue(api.corsRequired);
  g.protocolType = "HTTP";
  g.disableExecuteApiEndpoint = false;
  g.minimumCompressionSize = 1024;
  g.failOnWarnings = true;
  g.openApiVersion = "3.0.3";
  if (isTrue(api.corsRequired)) {
    g.cors = createCors(api.cors);
  }
  if (isTrue(api.generatedOpenApiRequired)) {
    g.definitionBody = generateOpenApi(api);
  }
  g.accessLogGroup = createLogGroupFor(api, g.logicalId, "/aws/apigateway/" + g.physicalName);
  createApiStages(api, g);
  createApiAuthorizer(api, g);
  createTrace(api, g, "Api2HttpApi", "HIGH", KERNEL!TraceLinkType#REALIZES);
}

/** Transforms Api elements into Rest Api elements. */
rule Api2RestApi
  transform api : API!Api
  to g : AWSPSMAPI!RestApi {

  guard : (api.apiStyle = PIMTYPES!ApiStyle#RESOURCE_ORIENTED_HTTP or api.apiStyle = PIMTYPES!ApiStyle#RPC_HTTP or api.apiStyle = PIMTYPES!ApiStyle#WEBHOOK) and requiresRestApi(api)

  copyAwsResource(api, g, "RestApi", "AWS::Serverless::Api");
  g.id = idFor("rest_api", api);
  g.apiName = firstText(firstText(api.publicName, api.name), "RestApi");
  g.descriptionText = api.summary;
  g.accessLogsEnabled = true;
  g.tracingEnabled = true;
  g.metricsEnabled = true;
  g.corsEnabled = isTrue(api.corsRequired);
  g.endpointType = AWSPSMENUMS!ApiGatewayEndpointType#REGIONAL;
  g.minimumCompressionSize = 1024;
  g.failOnWarnings = true;
  g.apiKeyRequiredByDefault = api.routes.exists(r | inferAuthorizationType(r) = AWSPSMENUMS!ApiGatewayAuthorizationType#API_KEY);
  g.openApiVersion = "3.0.3";
  if (isTrue(api.corsRequired)) {
    g.cors = createCors(api.cors);
  }
  g.definitionBody = generateOpenApi(api);
  g.accessLogGroup = createLogGroupFor(api, g.logicalId, "/aws/apigateway/" + g.physicalName);
  createApiStages(api, g);
  createApiAuthorizer(api, g);
  createApiKeyAndUsagePlan(api, g);
  createTrace(api, g, "Api2RestApi", "HIGH", KERNEL!TraceLinkType#REALIZES);
}

/** Transforms Api elements into Native Unsupported Api elements. */
rule Api2NativeUnsupportedApi
  transform api : API!Api
  to n : AWSPSMCORE!AwsNativeResource {

  guard : not (api.apiStyle = PIMTYPES!ApiStyle#RESOURCE_ORIENTED_HTTP or api.apiStyle = PIMTYPES!ApiStyle#RPC_HTTP)

  copyAwsResource(api, n, "UnsupportedApi", "AWS::CloudFormation::CustomResource");
  n.id = idFor("native_api", api);
  n.cloudFormationType = "Custom::UnsupportedApiStyle";
  n.properties.add(nativeText("ServiceToken", "REVIEW_REQUIRED_SERVICE_TOKEN", KERNEL!StructuredFormat#TEXT, true, false));
  n.properties.add(nativeText("PimApiStyle", api.apiStyle.asString(), KERNEL!StructuredFormat#TEXT, true, false));
  manualDecision("API_STYLE_UNSUPPORTED_DIRECTLY",
    "Choose an AWS implementation for unsupported API style " + api.apiStyle.asString() + " on " + api.name + ".",
    KERNEL!Severity#ERROR, true, Sequence{api, n},
    "Use a supported HTTP API/REST API style or add a first-class PSM service for this API style.");
  createTrace(api, n, "Api2NativeUnsupportedApi", "LOW", KERNEL!TraceLinkType#MAPS_TO);
}

/** Resolves the owning PIM API for a route. */
operation apiForRoute(r) {
  if (r.api.isDefined()) {
    return r.api;
  }
  var container = r.eContainer();
  if (container.isDefined() and container.isKindOf(API!Api)) {
    return container;
  }
  return null;
}

/** Transforms Api Route elements into Http Api Route elements. */
rule ApiRoute2HttpApiRoute
  transform r : API!ApiRoute
  to gr : AWSPSMAPI!HttpApiRoute {

  guard : apiForRoute(r).isDefined() and awsEquivalent(apiForRoute(r)).isDefined() and not requiresRestApi(apiForRoute(r))

  gr = createHttpApiRouteFrom(r, awsEquivalent(apiForRoute(r)));
}

/** Transforms Api Route elements into Rest Api Route elements. */
rule ApiRoute2RestApiRoute
  transform r : API!ApiRoute
  to gr : AWSPSMAPI!RestApiRoute {

  guard : apiForRoute(r).isDefined() and awsEquivalent(apiForRoute(r)).isDefined() and requiresRestApi(apiForRoute(r))

  gr = createRestApiRouteFrom(r, awsEquivalent(apiForRoute(r)));
}

/** Creates any API routes that were skipped because API resources were not available yet. */
operation materializeApiRoutes() {
  for (r in API!ApiRoute.all) {
    if (awsEquivalent(r).isDefined()) {
      continue;
    }
    var pimApi = apiForRoute(r);
    if (pimApi.isUndefined()) {
      continue;
    }
    var awsApi = awsEquivalent(pimApi);
    if (awsApi.isUndefined()) {
      continue;
    }
    if (requiresRestApi(pimApi)) {
      createRestApiRouteFrom(r, awsApi);
    }
    else {
      createHttpApiRouteFrom(r, awsApi);
    }
  }
}

/** Creates create http api route from. */
operation createHttpApiRouteFrom(r, awsApi) {
  var gr = new AWSPSMAPI!HttpApiRoute;
  copyAwsResource(r, gr, "Route", "AWS::ApiGatewayV2::Route");
  gr.id = idFor("http_route", r);
  gr.method = mapHttpMethod(r.method);
  gr.path = r.pathTemplate;
  gr.routeKey = r.method.asString() + " " + r.pathTemplate;
  gr.operationName = firstText(r.operationId, camelCase(r.name));
  gr.authorizationType = inferAuthorizationType(r);
  gr.apiKeyRequired = false;
  gr.requestModelsJson = schemaRefJson(r.requestSchema);
  gr.responseModelsJson = schemaRefJson(r.responseSchema);
  gr.timeoutInMillis = inferRouteTimeoutMillis(r);
  gr.routeSettingsJson = "{ \"DetailedMetricsEnabled\": true }";
  awsApi.routes.add(gr);
  gr.integration = createApiIntegration(r, gr);
  gr.authorizer = findAuthorizerFor(r);
  applyAuthorizerFallback(r, gr);
  applyRouteAuthorizationRequirements(r, gr);
  attachOpenApiModels(r, gr);
  if (routeNeedsAuth(r)
      and gr.authorizationType <> AWSPSMENUMS!ApiGatewayAuthorizationType#AWS_IAM
      and gr.authorizationType <> AWSPSMENUMS!ApiGatewayAuthorizationType#API_KEY
      and gr.authorizer.isUndefined()) {
    manualDecision("API_ROUTE_AUTHORIZER_MISSING",
      "Provide an authorizer for protected route " + r.pathTemplate + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{r, gr},
      "Model an AuthPolicy/IdentityProvider or mark the route public.");
  }
  createTrace(r, gr, "ApiRoute2HttpApiRoute", "HIGH", KERNEL!TraceLinkType#REALIZES);
  return gr;
}

/** Creates create rest api route from. */
operation createRestApiRouteFrom(r, awsApi) {
  var gr = new AWSPSMAPI!RestApiRoute;
  copyAwsResource(r, gr, "Route", "AWS::ApiGateway::Method");
  gr.id = idFor("rest_route", r);
  gr.method = mapHttpMethod(r.method);
  gr.path = r.pathTemplate;
  gr.restApiResourcePath = r.pathTemplate;
  gr.operationName = firstText(r.operationId, camelCase(r.name));
  gr.authorizationType = inferAuthorizationType(r);
  gr.apiKeyRequired = gr.authorizationType = AWSPSMENUMS!ApiGatewayAuthorizationType#API_KEY;
  gr.requestModelsJson = schemaRefJson(r.requestSchema);
  gr.responseModelsJson = schemaRefJson(r.responseSchema);
  gr.timeoutInMillis = inferRouteTimeoutMillis(r);
  gr.routeSettingsJson = "{ \"DataTraceEnabled\": false, \"MetricsEnabled\": true }";
  awsApi.routes.add(gr);
  gr.integration = createApiIntegration(r, gr);
  attachOpenApiModels(r, gr);
  gr.authorizer = findAuthorizerFor(r);
  applyAuthorizerFallback(r, gr);
  applyRouteAuthorizationRequirements(r, gr);
  if (routeNeedsAuth(r) and gr.authorizationType <> AWSPSMENUMS!ApiGatewayAuthorizationType#AWS_IAM and gr.authorizationType <> AWSPSMENUMS!ApiGatewayAuthorizationType#API_KEY and gr.authorizer.isUndefined()) {
    manualDecision("API_ROUTE_AUTHORIZER_MISSING",
      "Provide an authorizer for protected route " + r.pathTemplate + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{r, gr},
      "Model an AuthPolicy/IdentityProvider or mark the route public.");
  }
  createTrace(r, gr, "ApiRoute2RestApiRoute", "HIGH", KERNEL!TraceLinkType#REALIZES);
  return gr;
}

/** Derives infer memory mb. */
operation inferMemoryMb(f) {
  if (f.computeProfile = PIMTYPES!ComputeProfile#MEMORY_INTENSIVE) {
    return 1024;
  }
  if (f.computeProfile = PIMTYPES!ComputeProfile#CPU_BOUND) {
    return 1024;
  }
  if (f.computeProfile = PIMTYPES!ComputeProfile#BATCH_ORIENTED) {
    return 2048;
  }
  if (f.computeProfile = PIMTYPES!ComputeProfile#LATENCY_SENSITIVE) {
    return 512;
  }
  return 256;
}

/** Derives infer timeout seconds. */
operation inferTimeoutSeconds(f) {
  var t = 29;
  if (f.timeout.isDefined() and f.timeout.timeoutSeconds.isDefined() and f.timeout.timeoutSeconds > 0) {
    t = f.timeout.timeoutSeconds;
  }
  else {
    if (f.expectedP95DurationMs.isDefined() and f.expectedP95DurationMs > 0) {
      t = (f.expectedP95DurationMs / 1000) + 1;
    }
  }
  if (t > 900) {
    manualDecision("LAMBDA_TIMEOUT_REDESIGN_REQUIRED",
      "Lambda timeout for " + f.name + " exceeds AWS Lambda maximum.",
      KERNEL!Severity#BLOCKER, true, Sequence{f},
      "Redesign the operation or move long-running work into Step Functions.");
    return 900;
  }
  return clamp(t, 1, 900);
}

/** Derives infer reserved concurrency. */
operation inferReservedConcurrency(f) {
  if (f.concurrency.isDefined() and f.concurrency.reservedConcurrencyHint.isDefined()) {
    return f.concurrency.reservedConcurrencyHint;
  }
  // Zero is an explicit AWS pause, not the absence of a reservation.
  return null;
}

/** Creates create lambda tracing. */
operation createLambdaTracing(f) {
  var t = new AWSPSMCOMPUTE!LambdaTracingConfig;
  t.id = generatedId("lambda_tracing", f, "xray");
  t.name = f.name + " tracing";
  t.enabled = true;
  t.mode = AWSPSMENUMS!LambdaTracingMode#ACTIVE;
  return t;
}

/** Creates create lambda logging. */
operation createLambdaLogging(l) {
  var cfg = new AWSPSMCOMPUTE!LambdaLoggingConfig;
  cfg.id = uniqueId("lambda_logging_" + slug(l.id));
  cfg.name = l.name + " logging";
  cfg.applicationLogLevel = "INFO";
  cfg.systemLogLevel = "INFO";
  cfg.logFormat = "JSON";
  cfg.logGroupName = l.logGroup.logGroupName;
  return cfg;
}

/** Creates create lambda environment. */
operation createLambdaEnvironment(f) {
  var out = Sequence{};
  for (ev in f.environmentVariables) {
    var le = new AWSPSMCOMPUTE!LambdaEnvironmentVariable;
    le.id = generatedId("lambda_env", f, ev.variableName);
    le.name = ev.variableName;
    le.variableName = ev.variableName;
    le.stageSpecific = false;
    if (ev.secret.isDefined()) {
      le.value = secretValue(awsEquivalent(ev.secret));
    }
    else {
      if (ev.parameter.isDefined()) {
        le.value = literalValue("${" + ev.parameter.name + "}", isTrue(ev.secretReference));
      }
      else {
        le.value = literalValue(firstText(ev.valueSource, ""), isTrue(ev.secretReference));
      }
    }
    out.add(le);
  }
  for (s in f.usesSecrets) {
    var se = new AWSPSMCOMPUTE!LambdaEnvironmentVariable;
    se.id = generatedId("lambda_env_secret", f, s.name);
    se.name = pascalCase(s.name) + " Secret Arn";
    se.variableName = slug(s.name).toUpperCase() + "_SECRET_ARN";
    se.value = getAtt(awsEquivalent(s), "Arn");
    se.stageSpecific = false;
    out.add(se);
  }
  for (store in f.reads) {
    out.add(resourceNameEnv(f, store));
  }
  for (store in f.writes) {
    if (out.none(e | e.variableName = slug(store.name).toUpperCase() + "_NAME")) {
      out.add(resourceNameEnv(f, store));
    }
  }
  var relationalStores = f.reads.includingAll(f.writes).asSet();
  for (access in indexedValues(cachedDataAccessesByFunctionId, cacheKeyFor(f))) {
    if (access.store.isDefined()) {
      relationalStores.add(access.store);
      if (out.none(env | env.variableName = slug(access.store.name).toUpperCase() + "_NAME")) out.add(resourceNameEnv(f, access.store));
    }
  }
  for (store in relationalStores) {
    var database = awsEquivalent(store);
    if (database.isDefined() and database.isKindOf(AWSPSMSTORAGE!RdsDbCluster)) {
      out.add(relationalEnvironment(f, store, "RESOURCE_ARN", getAtt(database, "DBClusterArn")));
      out.add(relationalEnvironment(f, store, "SECRET_ARN", refValue(database.credentialsSecret)));
      out.add(relationalEnvironment(f, store, "DATABASE", literalValue(database.databaseName, false)));
    }
  }
  var publicationEnv = eventPublisherEnvironment(f);
  if (publicationEnv.isDefined()) out.add(publicationEnv);
  return out;
}

/** Builds a function's event publication bindings from its modeled EventTypes and buses. */
operation eventPublisherEnvironment(f) {
  if (f.publishes.isEmpty()) return null;
  var bindings = "";
  var bindingCount = 0;
  for (eventType in f.publishes) {
    if (not hasText(eventType.semanticName) or not hasText(eventType.sourceDomain)) {
      manualDecision("EVENT_PUBLICATION_METADATA_REQUIRED", "Provide source and detail type for event published by " + f.name + ".",
        KERNEL!Severity#ERROR, true, Sequence{f, eventType},
        "Set EventType.sourceDomain and EventType.semanticName before generating the EventBridge publisher binding.");
      continue;
    }
    var buses = INTEGRATION!EventBus.all.select(bus | bus.eventTypes.includes(eventType));
    for (bus in buses) {
      var awsBus = awsEquivalent(bus);
      if (awsBus.isUndefined() or not hasText(awsBus.busName)) continue;
      if (bindingCount > 0) bindings = bindings + ",";
      bindings = bindings + "{\"eventBusName\":\"" + escapeJson(awsBus.busName) + "\",\"source\":\"" + escapeJson(eventType.sourceDomain) + "\",\"detailType\":\"" + escapeJson(eventType.semanticName) + "\"}";
      bindingCount = bindingCount + 1;
    }
  }
  if (bindingCount = 0) {
    manualDecision("EVENT_PUBLICATION_BUS_REQUIRED", "Map published EventTypes from " + f.name + " to an EventBus.",
      KERNEL!Severity#ERROR, true, Sequence{f},
      "Add each published EventType to the destination EventBus.eventTypes collection so generated bindings include the bus, source, and detail type.");
    return null;
  }
  var env = new AWSPSMCOMPUTE!LambdaEnvironmentVariable;
  env.id = generatedId("lambda_event_publications", f, "bindings");
  env.name = f.name + " modeled event publication bindings";
  env.variableName = "MODRISS_EVENT_PUBLICATIONS";
  env.value = literalValue("[" + bindings + "]", false);
  env.stageSpecific = false;
  return env;
}

operation relationalEnvironment(f, store, suffix : String, value) {
  var env = new AWSPSMCOMPUTE!LambdaEnvironmentVariable;
  env.id = generatedId("lambda_env_rds", f, store.id + suffix);
  env.name = store.name + " " + suffix;
  env.variableName = slug(store.name).toUpperCase() + "_" + suffix;
  env.value = value;
  env.stageSpecific = false;
  return env;
}

/** Computes resource name env. */
operation resourceNameEnv(f, store) {
  var le = new AWSPSMCOMPUTE!LambdaEnvironmentVariable;
  le.id = generatedId("lambda_env_resource", f, store.name);
  le.name = store.name + " name";
  le.variableName = slug(store.name).toUpperCase() + "_NAME";
  le.value = refValue(awsEquivalent(store));
  le.stageSpecific = false;
  return le;
}

/** Creates create lambda role. */
operation createLambdaRole(f) {
  var role = new AWSPSMSECURITY!IamRole;
  copyAwsResource(f, role, "LambdaRole", "AWS::IAM::Role");
  role.id = generatedId("iam_role", f, "lambda");
  role.roleName = role.physicalName;
  role.path = "/";
  role.maxSessionDuration = 3600;
  role.descriptionText = "Execution role for " + f.name;
  role.assumeRolePolicy = serviceAssumeRolePolicy("lambda.amazonaws.com", f.id);
  return role;
}

/** Creates create vpc attachment decision. */
operation createVpcAttachmentDecision(f) {
  var v = new AWSPSMNETWORKING!VpcAttachmentConfig;
  v.id = generatedId("vpc_attachment", f, "lambda");
  v.name = f.name + " VPC Attachment";
  v.privateSubnetsRequireNatOrEndpoints = true;
  manualDecision("LAMBDA_VPC_DETAILS_REQUIRED",
    "Provide VPC, subnet, and security group IDs for Lambda " + f.name + ".",
    KERNEL!Severity#ERROR, isProductionRoot(), Sequence{f},
    "Add AWS placement hints or model networking resources for private access.");
  return v;
}

/** Computes route needs auth. */
operation routeNeedsAuth(r) {
  if (r.authRequired.isDefined()) {
    return isTrue(r.authRequired);
  }
  if (r.api.isDefined() and r.api.authRequired.isDefined()) {
    return isTrue(r.api.authRequired);
  }
  return not isTrue(r.publicRoute);
}

/** Derives infer authorization type. */
operation applyRouteAuthorizationRequirements(r, gr) {
  if (r.authorization.isDefined() and hasText(r.authorization.roleOrScopeRequired)) {
    manualDecision("ROUTE_AUTHORIZATION_REFINEMENT_REQUIRED",
      "Implement the route authorization requirement for " + r.pathTemplate + ": " + r.authorization.roleOrScopeRequired,
      KERNEL!Severity#ERROR, true, Sequence{r, gr},
      "The configured gateway scheme authenticates the caller. Enforce the modeled role, ownership, and resource-scope rule in the handler or a reviewed authorizer; prose is not an OAuth scope.");
  }
  if (r.api.isDefined() and r.api.auth.isDefined() and hasText(r.api.auth.scopesRequired)) {
    var text = r.api.auth.scopesRequired.trim();
    if (text.toLowerCase().contains("review-required") or text.toLowerCase().contains("review_required") or text.toLowerCase() = "tbd") {
      manualDecision("API_OAUTH_SCOPES_REQUIRED", "Resolve the OAuth scopes for API " + r.api.name + ".",
        KERNEL!Severity#ERROR, true, Sequence{r, gr},
        "Replace the review placeholder with actual space/comma-separated OAuth scopes, or explicitly remove the scope requirement after review.");
    }
    else if (gr.authorizationType = AWSPSMENUMS!ApiGatewayAuthorizationType#JWT or gr.authorizationType = AWSPSMENUMS!ApiGatewayAuthorizationType#COGNITO_USER_POOLS) {
      for (scope in text.replace(",", " ").split(" ")) {
        if (hasText(scope) and not gr.authorizationScopes.includes(scope.trim())) gr.authorizationScopes.add(scope.trim());
      }
    }
  }
}

operation inferAuthorizationType(r) {
  if (not routeNeedsAuth(r)) {
    return AWSPSMENUMS!ApiGatewayAuthorizationType#NONE;
  }
  if (r.authorization.isDefined() and hasText(r.authorization.roleOrScopeRequired)) {
    if (not (r.api.isDefined() and isTrue(r.api.authRequired) and r.api.auth.isDefined())) {
      return AWSPSMENUMS!ApiGatewayAuthorizationType#NONE;
    }
  }
  if (r.authorization.isDefined()
      and not (r.api.isDefined() and isTrue(r.api.authRequired) and r.api.auth.isDefined())) {
    return AWSPSMENUMS!ApiGatewayAuthorizationType#NONE;
  }
  if (r.api.isDefined() and isTrue(r.api.authRequired) and r.api.auth.isDefined()) {
    var scheme = asText(r.api.auth.authScheme).toLowerCase().trim();
    if (hasText(scheme)) {
      if (scheme.contains("jwt") or scheme.contains("oauth") or scheme.contains("oidc")) {
        return AWSPSMENUMS!ApiGatewayAuthorizationType#JWT;
      }
      if (scheme.contains("iam") or scheme.contains("sigv4") or scheme.contains("sigv 4")) {
        return AWSPSMENUMS!ApiGatewayAuthorizationType#AWS_IAM;
      }
      if (scheme.contains("api key") or scheme.contains("api_key") or scheme.contains("apikey")) {
        return AWSPSMENUMS!ApiGatewayAuthorizationType#API_KEY;
      }
      if (scheme.contains("cognito")) {
        if (r.api.auth.identityProvider.isDefined()) {
          return AWSPSMENUMS!ApiGatewayAuthorizationType#COGNITO_USER_POOLS;
        }
        manualDecision("API_COGNITO_IDENTITY_PROVIDER_REQUIRED",
          "Model an identity provider for Cognito-protected API " + r.api.name + ".",
          KERNEL!Severity#ERROR, true, Sequence{r.api, r},
          "Attach a PIM IdentityProvider to AuthPolicy.identityProvider or choose another explicit supported scheme.");
        return AWSPSMENUMS!ApiGatewayAuthorizationType#NONE;
      }
      if (scheme.contains("lambda") or scheme.contains("custom")) {
        return AWSPSMENUMS!ApiGatewayAuthorizationType#CUSTOM_LAMBDA;
      }
      manualDecision("AUTH_SCHEME_AMBIGUOUS",
        "Choose a supported AWS authorization scheme for API " + r.api.name + ".",
        KERNEL!Severity#ERROR, true, Sequence{r.api, r},
        "Use a recognized AuthPolicy.authScheme value. An attached identity provider does not override an explicit but unrecognized scheme.");
      return AWSPSMENUMS!ApiGatewayAuthorizationType#NONE;
    }
    if (r.api.auth.identityProvider.isDefined()) {
      return AWSPSMENUMS!ApiGatewayAuthorizationType#COGNITO_USER_POOLS;
    }
    else {
      manualDecision("AUTH_SCHEME_REQUIRED",
        "Choose an auth scheme for API " + r.api.name + ".",
        KERNEL!Severity#ERROR, isProductionRoot(), Sequence{r.api, r},
        "Set AuthPolicy.authScheme to JWT/OIDC/OAuth, Cognito, IAM/SigV4, API key, or Lambda/custom.");
      return AWSPSMENUMS!ApiGatewayAuthorizationType#NONE;
    }
  }
  manualDecision("AUTH_SCHEME_AMBIGUOUS",
    "Choose an AWS API authorization scheme for route " + r.pathTemplate + ".",
    KERNEL!Severity#ERROR, true, Sequence{r},
    "Set an explicit AuthPolicy.authScheme or model authorization as an application-level rule; an AWS IAM fallback would change the caller identity contract.");
  return AWSPSMENUMS!ApiGatewayAuthorizationType#NONE;
}

/** Computes apply authorizer fallback. */
operation applyAuthorizerFallback(r, gr) {
  if (routeNeedsAuth(r) and r.api.isDefined() and r.api.auth.isDefined()
      and hasText(r.api.auth.authScheme) and requiresRestApi(r.api)
      and (r.api.auth.authScheme.toLowerCase().contains("jwt")
        or r.api.auth.authScheme.toLowerCase().contains("oauth")
        or r.api.auth.authScheme.toLowerCase().contains("oidc"))
      and gr.authorizer.isUndefined()) {
    gr.authorizationType = AWSPSMENUMS!ApiGatewayAuthorizationType#CUSTOM_LAMBDA;
    manualDecision("REST_API_JWT_AUTHORIZER_REQUIRED",
      "Configure Cognito or a JWT-validating Lambda authorizer for REST route " + r.pathTemplate + ".",
      KERNEL!Severity#ERROR, true, Sequence{r, gr},
      "REST validation/API-key requirements are retained. Supply a REST-compatible authorizer; native JWT is supported only by HTTP APIs.");
    return;
  }
}

/** Computes map http method. */
operation mapHttpMethod(m) {
  if (m = PIMTYPES!HttpMethod#GET) {
    return AWSPSMENUMS!ApiGatewayHttpMethod#GET;
  }
  if (m = PIMTYPES!HttpMethod#POST) {
    return AWSPSMENUMS!ApiGatewayHttpMethod#POST;
  }
  if (m = PIMTYPES!HttpMethod#PUT) {
    return AWSPSMENUMS!ApiGatewayHttpMethod#PUT;
  }
  if (m = PIMTYPES!HttpMethod#PATCH) {
    return AWSPSMENUMS!ApiGatewayHttpMethod#PATCH;
  }
  if (m = PIMTYPES!HttpMethod#DELETE) {
    return AWSPSMENUMS!ApiGatewayHttpMethod#DELETE;
  }
  if (m = PIMTYPES!HttpMethod#OPTIONS) {
    return AWSPSMENUMS!ApiGatewayHttpMethod#OPTIONS;
  }
  if (m = PIMTYPES!HttpMethod#HEAD) {
    return AWSPSMENUMS!ApiGatewayHttpMethod#HEAD;
  }
  return AWSPSMENUMS!ApiGatewayHttpMethod#ANY;
}

/** Derives infer route timeout millis. */
operation inferRouteTimeoutMillis(r) {
  if (r.timeout.isDefined() and r.timeout.clientTimeoutSeconds.isDefined() and r.timeout.clientTimeoutSeconds > 0) {
    return clamp(r.timeout.clientTimeoutSeconds * 1000, 50, 29000);
  }
  return 29000;
}

/** Creates create api integration. */
operation createApiIntegration(r, gr) {
  var i = new AWSPSMAPI!ApiGatewayIntegration;
  if (gr.isKindOf(AWSPSMAPI!RestApiRoute)) {
    copyAwsResource(r, i, "Integration", "AWS::ApiGateway::Integration");
    i.integrationMethod = "POST";
    i.payloadFormatVersion = "1.0";
  }
  else {
    copyAwsResource(r, i, "Integration", "AWS::ApiGatewayV2::Integration");
    i.integrationMethod = "POST";
    i.payloadFormatVersion = "2.0";
  }
  i.id = generatedId("api_integration", r, "target");
  i.integrationType = AWSPSMENUMS!ApiGatewayIntegrationType#AWS_PROXY;
  i.timeoutInMillis = gr.timeoutInMillis;
  if (r.functionIntegration.isDefined()) {
    i.lambdaTarget = awsEquivalent(r.functionIntegration);
    i.integrationUri = cfnArnExpression(i.lambdaTarget);
    createLambdaPermissionFor("ApiGatewayInvoke", r, i.lambdaTarget, "apigateway.amazonaws.com", apiGatewayRouteSourceArn(gr));
  }
  else {
    if (r.workflowIntegration.isDefined()) {
      i.stateMachineTarget = awsEquivalent(r.workflowIntegration);
      i.integrationUri = cfnArnExpression(i.stateMachineTarget);
    }
    else {
      manualDecision("API_ROUTE_TARGET_REQUIRED",
        "Choose exactly one Lambda or workflow integration for route " + r.pathTemplate + ".",
        KERNEL!Severity#ERROR, true, Sequence{r, gr},
        "Set ApiRoute.functionIntegration or ApiRoute.workflowIntegration.");
    }
  }
  return i;
}

/** Returns whether the receiver requires rest api. */
operation requiresRestApi(api) {
  return api.routes.exists(r | inferAuthorizationType(r) = AWSPSMENUMS!ApiGatewayAuthorizationType#COGNITO_USER_POOLS)
    or api.routes.exists(r | isTrue(r.requestValidationRequired) or isTrue(r.responseValidationRequired) or inferAuthorizationType(r) = AWSPSMENUMS!ApiGatewayAuthorizationType#API_KEY);
}

/** Creates create api stages. */
operation createApiStages(api, g) {
  for (stage in AWSPSMCORE!AwsStage.all) {
    if (g.eClass().getName() = "RestApi") {
      var rs = new AWSPSMAPI!RestApiStage;
      copyAwsResource(api, rs, "Stage" + pascalCase(stage.stageName), "AWS::ApiGateway::Stage");
      rs.id = generatedId("api_stage", api, stage.stageName);
      fillApiStage(rs, stage, api, g);
      var dep = new AWSPSMAPI!ApiGatewayDeployment;
      copyAwsResource(api, dep, "Deployment" + pascalCase(stage.stageName), "AWS::ApiGateway::Deployment");
      dep.id = generatedId("api_deployment", api, stage.stageName);
      dep.descriptionText = "Deployment for " + api.name + " " + stage.stageName;
      dep.api = g;
      rs.deployment = dep;
    }
    else {
      var hs = new AWSPSMAPI!HttpApiStage;
      copyAwsResource(api, hs, "Stage" + pascalCase(stage.stageName), "AWS::ApiGatewayV2::Stage");
      hs.id = generatedId("http_api_stage", api, stage.stageName);
      fillApiStage(hs, stage, api, g);
    }
  }
}

/** Computes fill api stage. */
operation fillApiStage(apiStage, stage, api, g) {
  apiStage.stageName = stage.stageName;
  apiStage.autoDeploy = not isProductionRoot();
  apiStage.accessLogEnabled = true;
  apiStage.accessLogFormat = "{ \"requestId\":\"$context.requestId\", \"status\":\"$context.status\" }";
  apiStage.metricsEnabled = true;
  apiStage.dataTraceEnabled = false;
  apiStage.loggingLevel = "INFO";
  if (api.rateLimit.isDefined()) {
    apiStage.throttlingBurstLimit = positiveOr(api.rateLimit.burstLimit, 100);
    if (api.rateLimit.requestsPerSecond.isDefined()) {
      apiStage.throttlingRateLimit = api.rateLimit.requestsPerSecond.asDouble();
    }
    if (isTrue(api.rateLimit.clientSpecific) and g.eClass().getName() = "HttpApi") {
      manualDecision("HTTP_API_CLIENT_SPECIFIC_RATE_LIMIT",
        "Client-specific throttling for " + api.name + " needs API keys/usage plan, WAF, or custom authorizer design.",
        KERNEL!Severity#WARNING, false, Sequence{api, g},
        "Use RestApi usage plans or implement client-specific throttling externally.");
    }
  }
  else if (isProductionRoot()) {
    apiStage.throttlingBurstLimit = 100;
    apiStage.throttlingRateLimit = 50.0d;
  }
  g.stages.add(apiStage);
}

/** Creates create api authorizer. */
operation createApiAuthorizer(api, g) {
  if (api.auth.isUndefined() or not isTrue(api.authRequired)) {
    return null;
  }
  var scheme = asText(api.auth.authScheme).toLowerCase().trim();
  var cognitoRequired = api.routes.exists(r | inferAuthorizationType(r) = AWSPSMENUMS!ApiGatewayAuthorizationType#COGNITO_USER_POOLS);
  var jwtRequired = api.routes.exists(r | inferAuthorizationType(r) = AWSPSMENUMS!ApiGatewayAuthorizationType#JWT);
  if (cognitoRequired and api.auth.identityProvider.isDefined()) {
    var pool = awsEquivalent(api.auth.identityProvider);
    if (pool.isDefined()) {
      var c = new AWSPSMAPI!CognitoAuthorizer;
      copyAwsResource(api.auth, c, "Authorizer", "AWS::ApiGateway::Authorizer");
      c.id = generatedId("cognito_authorizer", api, api.auth.name);
      c.authorizerName = firstText(api.auth.name, api.name + "Authorizer");
      c.authorizationType = AWSPSMENUMS!ApiGatewayAuthorizationType#COGNITO_USER_POOLS;
      c.identitySource = "method.request.header.Authorization";
      c.authorizerResultTtlInSeconds = 300;
      g.authorizers.add(c);
      c.userPool = pool;
      cachedAwsAuthorizerByApiId.put(g.id, c);
      return c;
    }
  }
  if (not jwtRequired and not hasText(scheme)) {
    manualDecision("AUTH_SCHEME_REQUIRED",
      "Choose an auth scheme for API " + api.name + ".",
      KERNEL!Severity#ERROR, isProductionRoot(), Sequence{api, g},
      "Set AuthPolicy.authScheme before generating an authorizer.");
    return null;
  }
  if (jwtRequired or scheme.contains("jwt") or scheme.contains("oauth") or scheme.contains("oidc")) {
    if (g.eClass().getName() <> "HttpApi") {
      manualDecision("REST_API_JWT_AUTHORIZER_REQUIRED",
        "Choose a REST-compatible JWT validation mechanism for API " + api.name + ".",
        KERNEL!Severity#ERROR, true, Sequence{api, g},
        "Use Cognito or a Lambda authorizer. Native JWT authorizers cannot be attached to a REST API.");
      return null;
    }
    var j = new AWSPSMAPI!JwtAuthorizer;
    copyAwsResource(api.auth, j, "JwtAuthorizer", "AWS::ApiGatewayV2::Authorizer");
    j.id = generatedId("jwt_authorizer", api, api.auth.name);
    j.authorizerName = firstText(api.auth.name, api.name + "JwtAuthorizer");
    j.authorizationType = AWSPSMENUMS!ApiGatewayAuthorizationType#JWT;
    j.identitySource = "$request.header.Authorization";
    j.authorizerResultTtlInSeconds = 300;
    g.authorizers.add(j);
    var rules = asText(api.auth.tokenValidationRules).trim();
    j.issuer = annotationValue(rules, "issuer");
    if (rules.startsWith("https://") and not rules.contains(" ") and not rules.contains(";")) j.issuer = rules;
    var audiences = annotationValue(rules, "audience");
    if (hasText(audiences)) {
      for (audience in audiences.split(",")) if (hasText(audience.trim())) j.audience.add(audience.trim());
    }
    if (not hasText(j.issuer) or not j.issuer.startsWith("https://") or j.audience.isEmpty()) {
      manualDecision("API_ROUTE_AUTHORIZER_MISSING",
        "Provide JWT issuer/audience for API " + api.name + ".",
        KERNEL!Severity#ERROR, true, Sequence{api, j},
        "Set AuthPolicy.tokenValidationRules to issuer=https://your-issuer;audience=client-id. Scopes are not client audiences.");
    }
    cachedAwsAuthorizerByApiId.put(g.id, j);
    return j;
  }
  return null;
}

/** Resolves find authorizer for. */
operation findAuthorizerFor(r) {
  var apiTarget = awsEquivalent(r.api);
  if (apiTarget.isUndefined()) {
    return null;
  }
  if (cachedAwsAuthorizerByApiId.containsKey(apiTarget.id)) {
    return cachedAwsAuthorizerByApiId.get(apiTarget.id);
  }
  return null;
}

/** Creates create cors. */
operation createCors(policy) {
  var c = new AWSPSMCORE!CorsConfiguration;
  c.id = uniqueId("cors_" + slug(rootName()));
  c.name = "CORS";
  if (policy.isDefined() and policy.allowedOrigins.notEmpty()) {
    c.allowOrigins.addAll(policy.allowedOrigins);
  }
  else {
    c.allowOrigins.add("*");
  }
  if (policy.isDefined() and policy.allowedMethods.notEmpty()) {
    c.allowMethods.addAll(policy.allowedMethods);
  }
  else {
    c.allowMethods.add("GET"); c.allowMethods.add("POST"); c.allowMethods.add("PUT"); c.allowMethods.add("PATCH"); c.allowMethods.add("DELETE"); c.allowMethods.add("OPTIONS");
  }
  if (policy.isDefined() and policy.allowedHeaders.notEmpty()) {
    c.allowHeaders.addAll(policy.allowedHeaders);
  }
  else {
    c.allowHeaders.add("Content-Type"); c.allowHeaders.add("Authorization"); c.allowHeaders.add("X-Correlation-Id");
  }
  if (policy.isDefined()) {
    c.exposeHeaders.addAll(policy.exposedHeaders);
    c.allowCredentials = isTrue(policy.credentialsAllowed);
    c.maxAgeSeconds = positiveOr(policy.maxAgeSeconds, 3600);
  }
  else {
    c.allowCredentials = false;
    c.maxAgeSeconds = 3600;
  }
  return c;
}

/** Computes schema ref json. */
operation schemaRefJson(schema) {
  if (schema.isUndefined()) {
    return "";
  }
  return "{ \"" + schema.name + "\": \"" + firstText(schema.externalSchemaUri, schema.id) + "\" }";
}

/** Adds or records attach open api models. */
operation attachOpenApiModels(route, awsRoute) {
  if (route.requestSchema.isDefined()) {
    awsRoute.requestModels.add(createRequestModel(route, route.requestSchema));
  }
  if (route.responseSchema.isDefined()) {
    awsRoute.responseModels.add(createResponseModel(route, route.responseSchema, positiveOr(route.expectedSuccessStatus, 200).asString()));
  }
  var emittedStatuses = Set{};
  for (errorMapping in route.errorMappings.select(em | em.errorSchema.isDefined())) {
    var statusText = statusForError(errorMapping);
    if (not hasText(statusText)) {
      manualDecision("HTTP_ERROR_STATUS_REQUIRED", "Assign a single HTTP status code to error mapping " + errorMapping.name + ".",
        KERNEL!Severity#ERROR, true, Sequence{errorMapping},
        "Set ErrorMapping.abstractStatusClass to a three-digit HTTP status followed by an optional classification, for example 409_CONFLICT.");
    }
    if (hasText(statusText) and not emittedStatuses.includes(statusText)) {
      var sameStatusMappings = route.errorMappings.select(em | em.errorSchema.isDefined() and statusForError(em) = statusText);
      awsRoute.responseModels.add(createErrorResponseModel(route, statusText, sameStatusMappings));
      emittedStatuses.add(statusText);
    }
  }
}

/** Creates create request model. */
operation createRequestModel(route, schema) {
  var apiModel = new AWSPSMAPI!ApiGatewayRequestModel;
  copyTraceable(schema, apiModel);
  apiModel.id = generatedId("api_request_model", route, schema.id);
  apiModel.name = pascalCase(firstText(schema.name, schema.id)) + "RequestModel";
  apiModel.modelName = pascalCase(firstText(schema.name, schema.id));
  apiModel.contentType = "application/json";
  apiModel.schemaJson = schemaToOpenApiSchema(schema);
  return apiModel;
}

/** Creates create response model. */
operation createResponseModel(route, schema, statusCode : String) {
  var apiModel = new AWSPSMAPI!ApiGatewayResponseModel;
  copyTraceable(schema, apiModel);
  apiModel.id = generatedId("api_response_model", route, statusCode + "_" + schema.id);
  apiModel.name = pascalCase(firstText(schema.name, schema.id));
  apiModel.statusCode = statusCode;
  apiModel.contentType = "application/json";
  apiModel.schemaJson = schemaToOpenApiSchema(schema);
  return apiModel;
}

/** Combines all modeled error schemas for one HTTP status into one API response model. */
operation createErrorResponseModel(route, statusCode : String, errorMappings) {
  var apiModel = new AWSPSMAPI!ApiGatewayResponseModel;
  var schemaList = "";
  var emittedCodes = Set{};
  for (mapping in errorMappings) {
    if (hasText(schemaList)) schemaList = schemaList + ", ";
    schemaList = schemaList + schemaToOpenApiSchema(mapping.errorSchema);
    if (hasText(mapping.domainErrorCode) and not emittedCodes.includes(mapping.domainErrorCode)) {
      apiModel.errorCodes.add(mapping.domainErrorCode);
      emittedCodes.add(mapping.domainErrorCode);
    }
  }
  copyTraceable(errorMappings.first().errorSchema, apiModel);
  apiModel.id = generatedId("api_error_response_model", route, statusCode);
  apiModel.name = pascalCase(firstText(route.name, route.id)) + statusCode + "ErrorResponse";
  apiModel.statusCode = statusCode;
  apiModel.contentType = "application/json";
  if (errorMappings.size() = 1) {
    apiModel.schemaJson = schemaList;
  }
  else {
    apiModel.schemaJson = "{ \"oneOf\": [ " + schemaList + " ] }";
  }
  return apiModel;
}

/** Computes generate open api. */
operation generateOpenApi(api) {
  var paths = "";
  for (r in api.routes) {
    if (hasText(paths)) {
      paths = paths + ",";
    }
    paths = paths + "\"" + escapeJson(r.pathTemplate) + "\": { \"" + r.method.asString().toLowerCase() + "\": { \"operationId\": \"" +
      escapeJson(firstText(r.operationId, camelCase(r.name))) + "\", \"description\": \"" + escapeJson(r.descriptionForConsumers) +
      "\", \"requestBody\": " + openApiRequestBody(r) + ", \"responses\": " + openApiResponses(r) +
      ", \"security\": " + openApiSecurity(r) + " } }";
  }
  return "{ \"openapi\": \"3.0.3\", \"info\": { \"title\": \"" + escapeJson(firstText(api.publicName, api.name)) +
    "\", \"version\": \"" + escapeJson(firstText(api.version, "1.0.0")) + "\" }, \"paths\": { " + paths +
    " }, \"components\": { \"schemas\": " + openApiSchemas(api) + ", \"securitySchemes\": " + openApiSecuritySchemes(api) + " } }";
}

/** Computes open api schemas. */
operation openApiSchemas(api) {
  var schemas = Sequence{};
  for (route in api.routes) {
    addSchemaOnce(schemas, route.requestSchema);
    addSchemaOnce(schemas, route.responseSchema);
    for (err in route.errorMappings) {
      addSchemaOnce(schemas, err.errorSchema);
    }
  }
  var out = "";
  for (schema in schemas) {
    if (hasText(out)) {
      out = out + ", ";
    }
    out = out + "\"" + escapeJson(pascalCase(schema.name)) + "\": " + schemaToOpenApiSchema(schema);
  }
  return "{ " + out + " }";
}

/** Adds or records add schema once. */
operation addSchemaOnce(schemas, schema) {
  if (schema.isDefined() and not schemas.includes(schema)) {
    schemas.add(schema);
  }
}

/** Computes open api request body. */
operation openApiRequestBody(r) {
  if (r.requestSchema.isUndefined()) {
    return "null";
  }
  return "{ \"required\": " + isTrue(r.requestValidationRequired).asString() +
    ", \"content\": { \"application/json\": { \"schema\": { \"$ref\": \"#/components/schemas/" +
    escapeJson(pascalCase(r.requestSchema.name)) + "\" } } } }";
}

/** Computes open api responses. */
operation openApiResponses(r) {
  var successStatus = positiveOr(r.expectedSuccessStatus, 200).asString();
  var emittedStatuses = Set{successStatus};
  var responses = "\"" + successStatus + "\": { \"description\": \"Success\"";
  if (r.responseSchema.isDefined()) {
    responses = responses + ", \"content\": { \"application/json\": { \"schema\": { \"$ref\": \"#/components/schemas/" + escapeJson(pascalCase(r.responseSchema.name)) + "\" } } }";
  }
  responses = responses + " }";
  for (e in r.errorMappings) {
    var errorStatus = statusForError(e);
    if (hasText(errorStatus) and not emittedStatuses.includes(errorStatus)) {
      var mappings = r.errorMappings.select(candidate | statusForError(candidate) = errorStatus and candidate.errorSchema.isDefined());
      var schemaRefs = "";
      for (mapping in mappings) {
        if (hasText(schemaRefs)) schemaRefs = schemaRefs + ", ";
        schemaRefs = schemaRefs + "{ \"$ref\": \"#/components/schemas/" + escapeJson(pascalCase(mapping.errorSchema.name)) + "\" }";
      }
      var schemaJson = "{}";
      if (mappings.size() = 1) schemaJson = schemaRefs;
      else if (mappings.size() > 1) schemaJson = "{ \"oneOf\": [ " + schemaRefs + " ] }";
      responses = responses + ", \"" + errorStatus + "\": { \"description\": \"" + escapeJson(firstText(e.responseMessage, e.domainErrorCode)) + "\", \"content\": { \"application/json\": { \"schema\": " + schemaJson + " } } }";
      emittedStatuses.add(errorStatus);
    }
  }
  return "{ " + responses + " }";
}

/** Computes status for error. */
operation statusForError(e) {
  var statusClass = firstText(e.abstractStatusClass, "").trim();
  if (statusClass.length() >= 3) {
    var statusText = statusClass.substring(0, 3);
    if (statusText.matches("^[1-5][0-9]{2}$") and (statusClass.length() = 3 or statusClass.substring(3, 4).matches("[_ -]"))) {
      return statusText;
    }
  }
  return "";
}

/** Computes open api security. */
operation openApiSecurity(r) {
  if (not routeNeedsAuth(r)) {
    return "[]";
  }
  if (inferAuthorizationType(r) = AWSPSMENUMS!ApiGatewayAuthorizationType#NONE) {
    return "[]";
  }
  if (inferAuthorizationType(r) = AWSPSMENUMS!ApiGatewayAuthorizationType#API_KEY) {
    return "[ { \"ApiKeyAuth\": [] } ]";
  }
  if (inferAuthorizationType(r) = AWSPSMENUMS!ApiGatewayAuthorizationType#AWS_IAM) {
    return "[ { \"AwsIamAuth\": [] } ]";
  }
  return "[ { \"DefaultAuthorizer\": " + scopesJson(r) + " } ]";
}

/** Computes scopes json. */
operation scopesJson(r) {
  if (r.authorization.isDefined() and hasText(r.authorization.roleOrScopeRequired)) {
    return "[ \"" + escapeJson(r.authorization.roleOrScopeRequired) + "\" ]";
  }
  if (r.api.auth.isDefined() and hasText(r.api.auth.scopesRequired)) {
    return "[ \"" + escapeJson(r.api.auth.scopesRequired) + "\" ]";
  }
  return "[]";
}

/** Computes open api security schemes. */
operation openApiSecuritySchemes(api) {
  if (not isTrue(api.authRequired)) {
    return "{}";
  }
  return "{ \"DefaultAuthorizer\": { \"type\": \"http\", \"scheme\": \"bearer\", \"bearerFormat\": \"JWT\" }, \"ApiKeyAuth\": { \"type\": \"apiKey\", \"in\": \"header\", \"name\": \"x-api-key\" }, \"AwsIamAuth\": { \"type\": \"apiKey\", \"in\": \"header\", \"name\": \"Authorization\" } }";
}

/** Creates create api key and usage plan. */
operation createApiKeyAndUsagePlan(api, g) {
  if (not api.routes.exists(r | inferAuthorizationType(r) = AWSPSMENUMS!ApiGatewayAuthorizationType#API_KEY)) {
    return;
  }
  var key = new AWSPSMAPI!ApiGatewayApiKey;
  copyAwsResource(api, key, "ApiKey", "AWS::ApiGateway::ApiKey");
  key.id = generatedId("api_key", api, "default");
  key.apiKeyName = physicalName(api, "api-key", defaultStage());
  key.enabled = true;
  key.descriptionText = "Generated API key placeholder for " + api.name;
  var restStages = g.stages.select(stage | stage.isKindOf(AWSPSMAPI!RestApiStage));
  for (s in restStages) {
    key.stages.add(s);
  }

  var plan = new AWSPSMAPI!ApiGatewayUsagePlan;
  copyAwsResource(api, plan, "UsagePlan", "AWS::ApiGateway::UsagePlan");
  plan.id = generatedId("usage_plan", api, "default");
  plan.usagePlanName = physicalName(api, "usage-plan", defaultStage());
  plan.descriptionText = "Generated usage plan for API-key protected routes.";
  if (api.rateLimit.isDefined()) {
    plan.throttleBurstLimit = positiveOr(api.rateLimit.burstLimit, 100);
    if (api.rateLimit.requestsPerSecond.isDefined()) {
      plan.throttleRateLimit = api.rateLimit.requestsPerSecond.asDouble();
    }
  }
  plan.quotaPeriod = "MONTH";
  for (stage in restStages) {
    plan.apiStages.add(stage);
  }

  var link = new AWSPSMAPI!ApiGatewayUsagePlanKey;
  copyAwsResource(api, link, "UsagePlanKey", "AWS::ApiGateway::UsagePlanKey");
  link.id = generatedId("usage_plan_key", api, "default");
  link.keyType = "API_KEY";
  link.apiKey = key;
  link.usagePlan = plan;
}

/** Computes secret value. */
operation secretValue(secret) {
  var v = new AWSPSMSECURITY!SecretValueExpression;
  var reference = "REVIEW_REQUIRED_SECRET_REFERENCE";
  if (secret.isDefined()) {
    reference = firstText(secret.secretName, firstText(secret.physicalName, secret.logicalId));
  }
  v.id = uniqueId("secret_value_" + slug(reference));
  v.name = "Secret reference " + reference;
  v.sourceKind = AWSPSMENUMS!ValueSourceKind#SECRETS_MANAGER_REFERENCE;
  v.expression = reference;
  v.secret = true;
  if (secret.isDefined()) {
    v.secretRef = secret;
  }
  return v;
}
