/** Provides reusable mapping operations. */
import "common.eol";

/** Computes map field type. */
operation mapFieldType(item : CIMDOMAIN!InformationItem) {
  var t = item.type.asString();
  if (t = "TEXT") return PIMTYPES!FieldType#STRING;
  if (t = "NUMBER") return PIMTYPES!FieldType#NUMBER;
  if (t = "INTEGER") return PIMTYPES!FieldType#INTEGER;
  if (t = "DECIMAL") return PIMTYPES!FieldType#NUMBER;
  if (t = "BOOLEAN") return PIMTYPES!FieldType#BOOLEAN;
  if (t = "DATE") return PIMTYPES!FieldType#DATE;
  if (t = "TIME") return PIMTYPES!FieldType#TIME;
  if (t = "DATETIME") return PIMTYPES!FieldType#DATETIME;
  if (t = "MONEY") return PIMTYPES!FieldType#MONEY;
  if (t = "EMAIL") return PIMTYPES!FieldType#EMAIL;
  if (t = "PHONE") return PIMTYPES!FieldType#STRING;
  if (t = "ADDRESS") {
    if (item.subItems.notEmpty()) {
      return PIMTYPES!FieldType#OBJECT;
    }
    else {
      return PIMTYPES!FieldType#STRING;
    }
  }
  if (t = "IDENTIFIER" and item.formatHint.isDefined() and item.formatHint.toLowerCase().contains("uuid")) return PIMTYPES!FieldType#UUID;
  if (t = "IDENTIFIER") return PIMTYPES!FieldType#STRING;
  if (t = "ENUMERATION") return PIMTYPES!FieldType#ENUM;
  if (t = "OBJECT") return PIMTYPES!FieldType#OBJECT;
  if (t = "LIST") return PIMTYPES!FieldType#ARRAY;
  if (t = "DOCUMENT") return PIMTYPES!FieldType#OBJECT;
  if (t = "BINARY") return PIMTYPES!FieldType#BINARY;
  return PIMTYPES!FieldType#STRING;
}

/** Derives derive format. */
operation deriveFormat(item : CIMDOMAIN!InformationItem) {
  if (item.type.asString() = "EMAIL") return "email";
  if (item.type.asString() = "PHONE") return "phone";
  if (item.type.asString() = "IDENTIFIER" and item.formatHint.isDefined() and item.formatHint.toLowerCase().contains("uuid")) return "uuid";
  return item.formatHint;
}

/** Returns whether the receiver is personal. */
operation isPersonal(item : CIMDOMAIN!InformationItem) {
  if (item.classification.isUndefined()) {
    return false;
  }
  return item.classification.kind.asString() = "PERSONAL" or
    item.classification.kind.asString() = "SENSITIVE_PERSONAL" or
    item.classification.kind.asString() = "HEALTH" or
    item.classification.identifiability.asString() <> "NON_PERSONAL";
}

/** Returns whether the receiver is sensitive. */
operation isSensitive(item : CIMDOMAIN!InformationItem) {
  if (item.classification.isUndefined()) {
    return false;
  }
  var k = item.classification.kind.asString();
  return k = "CONFIDENTIAL" or k = "SENSITIVE_PERSONAL" or k = "FINANCIAL" or
    k = "HEALTH" or k = "AUTHENTICATION_SECRET" or k = "REGULATED";
}

/** Returns whether the receiver is secret. */
operation isSecret(item : CIMDOMAIN!InformationItem) {
  return item.classification.isDefined() and item.classification.kind.asString() = "AUTHENTICATION_SECRET";
}

/** Returns whether the receiver is sensitive classification. */
operation isSensitiveClassification(dc : CIMDOMAIN!DataClassification) {
  var k = dc.kind.asString();
  return k = "CONFIDENTIAL" or k = "SENSITIVE_PERSONAL" or k = "FINANCIAL" or
    k = "HEALTH" or k = "AUTHENTICATION_SECRET" or k = "REGULATED";
}

/** Computes map principal kind. */
operation mapPrincipalKind(actorType) {
  var t = actorType.asString();
  if (t = "HUMAN") return PIMTYPES!PrincipalKind#HUMAN_USER;
  if (t = "DEPARTMENT") return PIMTYPES!PrincipalKind#GROUP;
  if (t = "ORGANIZATION") return PIMTYPES!PrincipalKind#GROUP;
  if (t = "EXTERNAL_ORGANIZATION") return PIMTYPES!PrincipalKind#EXTERNAL_SYSTEM;
  if (t = "EXTERNAL_SYSTEM") return PIMTYPES!PrincipalKind#EXTERNAL_SYSTEM;
  if (t = "TIME") return PIMTYPES!PrincipalKind#SERVICE;
  if (t = "REGULATOR") return PIMTYPES!PrincipalKind#EXTERNAL_SYSTEM;
  return PIMTYPES!PrincipalKind#GROUP;
}

/** Derives infer store kind. */
operation inferStoreKind(ag : CIMDOMAIN!AggregateCandidate) {
  if (ag.consistencyExpectation.asString() = "MULTI_ENTITY_STRONG_CONSISTENCY") return PIMTYPES!StoreKind#RELATIONAL;
  if (ag.members.size() > 1) return PIMTYPES!StoreKind#DOCUMENT;
  if (ag.root.attributes.size() <= 6 and ag.handledCommands.isEmpty()) return PIMTYPES!StoreKind#KEY_VALUE;
  return PIMTYPES!StoreKind#DOCUMENT;
}

/** Derives infer consistency. */
operation inferConsistency(ag : CIMDOMAIN!AggregateCandidate) {
  if (ag.consistencyExpectation.asString() = "MULTI_ENTITY_STRONG_CONSISTENCY") return PIMTYPES!ConsistencyNeed#TRANSACTIONAL;
  if (ag.consistencyExpectation.asString() = "SINGLE_ENTITY") return PIMTYPES!ConsistencyNeed#READ_YOUR_WRITES;
  return PIMTYPES!ConsistencyNeed#EVENTUAL;
}

/** Derives infer http method. */
operation inferHttpMethod(cmd : CIMBEHAVIOR!Command) {
  var n = (cmd.name + " " + cmd.intent).toLowerCase();
  if (n.startsWith("create") or n.contains(" create")) return PIMTYPES!HttpMethod#POST;
  if (n.startsWith("update") or n.startsWith("change") or n.contains(" update") or n.contains(" change")) return PIMTYPES!HttpMethod#PATCH;
  if (n.startsWith("replace")) return PIMTYPES!HttpMethod#PUT;
  if (n.startsWith("delete") or n.startsWith("cancel") or n.contains(" delete") or n.contains(" cancel")) return PIMTYPES!HttpMethod#DELETE;
  return PIMTYPES!HttpMethod#POST;
}

/** Derives infer command execution model. */
operation inferCommandExecutionModel(cmd : CIMBEHAVIOR!Command) {
  if (cmd.interactionExpectation.asString() = "RESPONSE_CAN_BE_DELAYED" or cmd.commandType.asString() = "POLICY_TRIGGERED_INTENT") {
    return PIMTYPES!ExecutionModel#ASYNC_EVENT;
  }
  return PIMTYPES!ExecutionModel#REQUEST_RESPONSE;
}

/** Derives infer compute profile. */
operation inferComputeProfile(source) {
  return PIMTYPES!ComputeProfile#LIGHTWEIGHT;
}

/** Computes map workflow kind. */
operation mapWorkflowKind(bp : CIMPROCESS!BusinessProcess) {
  if (bp.processKind.asString() = "SAGA_LIKE_BUSINESS_PROCESS") return PIMTYPES!WorkflowKind#SAGA;
  if (bp.processKind.asString() = "HUMAN_INVOLVED" or bp.processKind.asString() = "CASE_MANAGEMENT" or isTrue(bp.humanApprovalPossible)) return PIMTYPES!WorkflowKind#HUMAN_APPROVAL;
  if (isTrue(bp.longRunning) or bp.processKind.asString() = "LONG_RUNNING") return PIMTYPES!WorkflowKind#LONG_RUNNING_PROCESS;
  if (bp.processKind.asString() = "REPORTING_PROCESS") return PIMTYPES!WorkflowKind#BATCH_COORDINATION;
  return PIMTYPES!WorkflowKind#ORCHESTRATION;
}

/** Computes map risk severity. */
operation mapRiskSeverity(impact, probability) {
  var i = asText(impact).toLowerCase();
  var p = asText(probability).toLowerCase();
  if (i.contains("critical") or i.contains("high") and p.contains("high")) return KERNEL!Severity#CRITICAL;
  if (i.contains("high") or p.contains("high")) return KERNEL!Severity#ERROR;
  if (i.contains("medium") or p.contains("medium")) return KERNEL!Severity#WARNING;
  return KERNEL!Severity#INFO;
}

/** Computes map severity. */
operation mapSeverity(severity) {
  var value = severity.asString();
  if (value = "BLOCKER") return KERNEL!Severity#BLOCKER;
  if (value = "CRITICAL") return KERNEL!Severity#CRITICAL;
  if (value = "ERROR") return KERNEL!Severity#ERROR;
  if (value = "WARNING") return KERNEL!Severity#WARNING;
  if (value = "INFO") return KERNEL!Severity#INFO;
  return KERNEL!Severity#WARNING;
}
