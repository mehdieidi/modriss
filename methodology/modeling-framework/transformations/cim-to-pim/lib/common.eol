/** Provides reusable common operations. */
/** Initializes shared roots, lookup maps, and deduplication sets for the CIM-to-PIM run. */
operation initialiseCimToPimCaches() {
  cachedCimRoot = CIM!CIMModel.all.first();
  cachedPimRoot = null;
  cachedCimAggregateByEntityId = new Map;
  cachedCimContextByCapabilityId = new Map;
  cachedCimOwnerContextByElementId = new Map;
  cachedCimServiceBySourceId = new Map;
  cachedCimEquivalentByRule = new Map;
  cachedGeneratedIdByKey = new Map;
  cachedCimFallbackService = null;
  cachedCimPolicyTargetsBySourceId = new Map;
  cachedPimObservabilityById = new Map;
  cachedPimResilienceById = new Map;
  cachedPimIdempotencyById = new Map;
  cachedPimSchemaById = new Map;
  cachedPimElementById = new Map;
  cachedPimValidationTargets = Sequence{};
  cachedPimDataAccessIds = Set{};
  cachedPimExternalFlowIds = Set{};
  cachedPimQueueById = new Map;
  cachedPimServiceOwnedKeys = Set{};
  cachedPimServiceMembershipKeys = Set{};
  cachedPimRetentionPolicyById = new Map;
  cachedPimBackupPolicyById = new Map;
  cachedPimSchemasByItemId = new Map;
  cachedReadinessManualDecisionsById = new Map;
  cachedReadinessFindingsById = new Map;
  cachedReadinessChecksById = new Map;

  for (ag in cachedCimRoot.aggregates) {
    cacheAggregateEntity(ag.root, ag);
    for (member in ag.members) {
      cacheAggregateEntity(member, ag);
    }
  }
  for (context in cachedCimRoot.boundedContexts) {
    for (capability in context.capabilities) {
      cacheContextByCapability(capability, context);
    }
    cacheContextElements(context.commands, context);
    cacheContextElements(context.queries, context);
    cacheContextElements(context.events, context);
    cacheContextElements(context.entities, context);
    cacheContextElements(context.policies, context);
  }
}

/** Computes cim root. */
operation cimRoot() {
  return cachedCimRoot;
}

/** Computes cache key for. */
operation cacheKeyFor(element) {
  if (element.isUndefined()) {
    return "";
  }
  if (hasText(element.id)) {
    return element.id;
  }
  if (hasText(element.name)) {
    return element.eClass().getName() + "_" + slug(element.name);
  }
  return element.eClass().getName() + "_" + slug(element.asString());
}

/** Computes cache aggregate entity. */
operation cacheAggregateEntity(entity, aggregate) {
  var key = cacheKeyFor(entity);
  if (hasText(key)) {
    cachedCimAggregateByEntityId.put(key, aggregate);
  }
}

/** Computes cache context by capability. */
operation cacheContextByCapability(capability, context) {
  var key = cacheKeyFor(capability);
  if (hasText(key)) {
    cachedCimContextByCapabilityId.put(key, context);
  }
}

/** Computes cache context elements. */
operation cacheContextElements(elements, context) {
  for (element in elements) {
    var key = cacheKeyFor(element);
    if (hasText(key)) {
      cachedCimOwnerContextByElementId.put(key, context);
    }
  }
}

/** Computes cached aggregate for entity. */
operation cachedAggregateForEntity(entity) {
  return cachedCimAggregateByEntityId.get(cacheKeyFor(entity));
}

/** Computes cached context for capability. */
operation cachedContextForCapability(capability) {
  return cachedCimContextByCapabilityId.get(cacheKeyFor(capability));
}

/** Computes cached owner context for. */
operation cachedOwnerContextFor(element) {
  return cachedCimOwnerContextByElementId.get(cacheKeyFor(element));
}

/** Resolves cached equivalent. */
operation cachedEquivalent(source, ruleName : String) {
  var key = ruleName + "::" + cacheKeyFor(source);
  if (cachedCimEquivalentByRule.containsKey(key)) {
    var cached = cachedCimEquivalentByRule.get(key);
    if (cached = "__NONE__") return null;
    return cached;
  }
  var deterministicTarget = cachedDeterministicEquivalent(source, ruleName, "");
  if (deterministicTarget.isDefined()) {
    cachedCimEquivalentByRule.put(key, deterministicTarget);
    return deterministicTarget;
  }
  var target = source.equivalents(ruleName).first();
  if (target.isDefined()) {
    cachedCimEquivalentByRule.put(key, target);
  }
  // Do not cache a miss.  ETL rules are evaluated in dependency order only
  // where the source model requires it; a referenced target may legitimately
  // be created by a later rule in the same transformation.  Caching the miss
  // made resolution depend on rule ordering and permanently severed valid
  // generated references.
  return target;
}

/** Resolves cached equivalent of class. */
operation cachedEquivalentOfClass(source, ruleName : String, className : String) {
  var key = ruleName + "::" + cacheKeyFor(source) + "::" + className;
  if (cachedCimEquivalentByRule.containsKey(key)) {
    var cached = cachedCimEquivalentByRule.get(key);
    if (cached = "__NONE__") return null;
    return cached;
  }
  var deterministicTarget = cachedDeterministicEquivalent(source, ruleName, className);
  if (deterministicTarget.isDefined()) {
    cachedCimEquivalentByRule.put(key, deterministicTarget);
    return deterministicTarget;
  }
  var target = source.equivalents(ruleName).selectOne(x | x.eClass().getName() = className);
  if (target.isDefined()) {
    cachedCimEquivalentByRule.put(key, target);
  }
  // Keep unresolved values retryable for the same reason as cachedEquivalent.
  return target;
}

/** Computes cache pim target. */
operation cachePimTarget(target) {
  if (target.isDefined() and hasText(target.id)) {
    if (not cachedPimElementById.containsKey(target.id)) {
      cachedPimValidationTargets.add(target);
    }
    cachedPimElementById.put(target.id, target);
  }
}

/** Computes cached pim target by id. */
operation cachedPimTargetById(id : String) {
  if (hasText(id) and cachedPimElementById.containsKey(id)) {
    return cachedPimElementById.get(id);
  }
  return null;
}

/** Computes cached deterministic equivalent. */
operation cachedDeterministicEquivalent(source, ruleName : String, className : String) {
  var id = deterministicEquivalentId(source, ruleName, className);
  if (not hasText(id)) {
    return null;
  }
  return cachedPimTargetById(id);
}

/** Computes deterministic equivalent id. */
operation deterministicEquivalentId(source, ruleName : String, className : String) {
  if (source.isUndefined()) {
    return "";
  }
  if (ruleName = "BoundedContext2Service") return idFor("svc_ctx", source);
  if (ruleName = "Capability2Service") return idFor("svc_cap", source);
  if (ruleName = "Actor2Principal") return idFor("principal", source);
  if (ruleName = "ExternalSystem2Adapter") return idFor("adapter", source);
  if (ruleName = "Entity2Schema") return idFor("schema_entity", source);
  if (ruleName = "ValueObject2Schema") return idFor("schema_value", source);
  if (ruleName = "Aggregate2DataStore" and className = "DataStore") return idFor("store", source);
  if (ruleName = "BusinessError2ErrorSchema") return idFor("schema_error", source);
  if (ruleName = "BusinessEvent2EventType" and className = "EventType") return idFor("eventtype", source);
  if (ruleName = "Command2Function") return idFor("fn_cmd", source);
  if (ruleName = "UserInitiatedCommand2ApiRoute") return idFor("route_cmd", source);
  if (ruleName = "Query2Function") return idFor("fn_query", source);
  if (ruleName = "Query2ApiRoute") return idFor("route_query", source);
  if (ruleName = "Policy2PolicyHandlerFunction") return idFor("fn_policy", source);
  if (ruleName = "DecisionTable2ChoiceLogic") return idFor("fn_decision", source);
  if (ruleName = "BusinessProcess2Workflow") return idFor("workflow", source);
  if (ruleName = "StartStep2WorkflowStartStep") return idFor("step", source);
  if (ruleName = "EndStep2WorkflowSuccessEndStep") return idFor("step", source);
  if (ruleName = "DecisionStep2WorkflowChoiceStep") return idFor("step", source);
  if (ruleName = "WaitLikeStep2WorkflowWaitStep") return idFor("step", source);
  if (ruleName = "ProcessStep2WorkflowTaskStep") return idFor("step", source);
  if (ruleName = "ProcessTransition2WorkflowTransition") return idFor("wf_transition", source);
  if (ruleName = "ExceptionScenario2ErrorHandler") return idFor("errorhandler", source);
  return "";
}

/** Converts the receiver to text. */
operation asText(value) {
  return etlTextChecks.asText(value);
}

/** Computes or default. */
operation Any orDefault(defaultValue : String) {
  if (self.isUndefined() or self.trim().isEmpty()) {
    return defaultValue;
  }
  return self;
}

/** Returns whether the receiver has text. */
operation hasText(value) {
  return etlTextChecks.hasText(value);
}

/** Computes first text. */
operation firstText(primary, fallback) {
  return etlTextChecks.firstText(primary, fallback);
}

/** Converts the receiver to slug. */
operation slug(value) {
  return etlTextChecks.slug(value);
}

/** Converts the receiver to kebab. */
operation kebab(value) {
  return etlTextChecks.kebab(value);
}

/** Converts the receiver to camel case. */
operation camelCase(value) {
  return etlTextChecks.camelCase(value);
}

/** Converts the receiver to pascal case. */
operation pascalCase(value) {
  return etlTextChecks.pascalCase(value);
}

/** Computes remove suffix. */
operation removeSuffix(value : String, suffix : String) {
  if (value.isDefined() and value.endsWith(suffix)) {
    return value.substring(0, value.length() - suffix.length());
  }
  return value;
}

/** Converts the receiver to pluralize. */
operation pluralize(value) {
  var text = asText(value);
  if (text.isEmpty()) {
    return "resources";
  }
  if (text.toLowerCase().endsWith("s")) {
    return text;
  }
  if (text.toLowerCase().endsWith("y") and text.length() > 1) {
    return text.substring(0, text.length() - 1) + "ies";
  }
  return text + "s";
}

/** Computes id for. */
operation idFor(prefix : String, source) {
  return generatedId(prefix, cacheKeyFor(source));
}

/** Computes name for. */
operation nameFor(source, suffix : String) {
  var baseName = source.name;
  if (not hasText(baseName)) {
    baseName = source.id;
  }
  return baseName.orDefault("Unnamed") + suffix;
}

/** Creates new id. */
operation newId(prefix : String, seed) {
  return generatedId(prefix, seed);
}

/** Generates a deterministic id per transformation/source/target-role key. */
operation generatedId(prefix : String, seed) {
  var key = prefix + "::" + seed.asString();
  if (not cachedGeneratedIdByKey.containsKey(key)) {
    cachedGeneratedIdByKey.put(key, modelElementIdGenerator.deterministicId("cim-to-pim", key));
  }
  return cachedGeneratedIdByKey.get(key);
}

/** Adds or records collection text. */
operation collectionText(items) {
  return joinText(items.collect(i | i.name), ", ");
}

/** Computes join text. */
operation joinText(items, separator : String) {
  var result = "";
  for (item in items) {
    if (hasText(item)) {
      if (hasText(result)) {
        result = result + separator;
      }
      result = result + item.asString();
    }
  }
  return result;
}

/** Returns whether the receiver has any. */
operation hasAny(items) {
  return items.isDefined() and not items.isEmpty();
}

/** Returns whether the receiver is true. */
operation isTrue(value) {
  return value.isDefined() and value;
}

/** Returns whether the receiver is public actor. */
operation isPublicActor(actor) {
  return actor.isDefined() and actor.actorType.isDefined() and
    actor.actorType.asString() <> "TIME";
}

/** Computes set feature. */
operation setFeature(element, featureName : String, value) {
  var feature = element.eClass().getEStructuralFeature(featureName);
  if (feature.isUndefined()) {
    throw "Feature " + featureName + " does not exist on " + element.eClass().getName() + ".";
  }
  element.eSet(feature, value);
}

/** Computes feature value. */
operation featureValue(element, featureName : String) {
  if (element.isUndefined()) {
    return null;
  }
  var feature = element.eClass().getEStructuralFeature(featureName);
  if (feature.isUndefined()) {
    return null;
  }
  return element.eGet(feature);
}

/** Computes expression text. */
operation expressionText(element) : String {
  if (element.isUndefined()) {
    return "";
  }
  if (element.eClass().getName() = "Expression") {
    return element.body;
  }
  var expressionModel = featureValue(element, "expressionModel");
  if (expressionModel.isDefined()) {
    return expressionText(expressionModel);
  }
  var expressionValue = featureValue(element, "expression");
  if (hasText(expressionValue)) {
    return expressionValue.asString();
  }
  var naturalLanguageValue = featureValue(element, "naturalLanguage");
  if (hasText(naturalLanguageValue)) {
    return naturalLanguageValue.asString();
  }
  var naturalLanguageStatement = featureValue(element, "naturalLanguageStatement");
  if (hasText(naturalLanguageStatement)) {
    return naturalLanguageStatement.asString();
  }
  return "";
}

/** Computes expression language text. */
operation expressionLanguageText(element) : String {
  if (element.isUndefined()) {
    return "NATURAL_LANGUAGE";
  }
  if (element.eClass().getName() = "Expression" and element.language.isDefined()) {
    return element.language.asString();
  }
  var expressionModel = featureValue(element, "expressionModel");
  if (expressionModel.isDefined() and expressionModel.language.isDefined()) {
    return expressionModel.language.asString();
  }
  var languageValue = featureValue(element, "expressionLanguage");
  if (languageValue.isDefined()) {
    return languageValue.asString();
  }
  return "NATURAL_LANGUAGE";
}

/** Returns whether the receiver has multiplicity bounds. */
operation Any hasMultiplicityBounds() : Boolean {
  return self.isDefined() and self.eClass().getName() = "Multiplicity" and
    self.lowerBound.isDefined() and
    (self.upperBound.isDefined() or self.unbounded = true);
}

/** Returns whether the receiver is many. */
operation Any isMany() : Boolean {
  return self.isDefined() and self.eClass().getName() = "Multiplicity" and
    (self.unbounded = true or (self.upperBound.isDefined() and self.upperBound > 1));
}

/** Returns the ServerlessService val-containment feature name for a deployable element. */
operation deployableContainmentFeature(element) : String {
  if (element.isKindOf(COMPUTE!Function)) {
    return "functions";
  }
  if (element.isKindOf(API!Api)) {
    return "apis";
  }
  if (element.isKindOf(INTEGRATION!Schedule)) {
    return "schedules";
  }
  if (element.isKindOf(INTEGRATION!EventChannel)) {
    return "channels";
  }
  if (element.isKindOf(DATA!StorageElement)) {
    return "stores";
  }
  if (element.isKindOf(WORKFLOW!Workflow)) {
    return "workflows";
  }
  if (element.isKindOf(EXTERNAL!ExternalAdapter)) {
    return "adapters";
  }
  return "";
}

/** Adds a deployable element to a service containment feature once. */
operation containDeployableOnce(service, element) {
  if (service.isUndefined() or element.isUndefined()) {
    return;
  }
  var featureName = deployableContainmentFeature(element);
  if (not hasText(featureName)) {
    return;
  }
  var key = cacheKeyFor(service) + "::" + featureName + "::" + cacheKeyFor(element);
  if (cachedPimServiceOwnedKeys.includes(key)) {
    return;
  }
  cacheOwnedKey(service, featureName, element);
  service.eGet(service.eClass().getEStructuralFeature(featureName)).add(element);
}

/** Collects all functions contained by services. */
operation allServiceFunctions() : Sequence {
  var functions = Sequence{};
  for (service in pimRoot().services) {
    functions.addAll(service.functions);
  }
  return functions;
}

/** Finds the service that val-contains the deployable element, if any. */
operation serviceOwningDeployable(element) {
  if (element.isUndefined()) {
    return null;
  }
  for (service in pimRoot().services) {
    if (service.functions.includes(element) or service.apis.includes(element) or
        service.channels.includes(element) or service.stores.includes(element) or
        service.workflows.includes(element) or service.adapters.includes(element) or
        service.schedules.includes(element)) {
      return service;
    }
  }
  if (element.isKindOf(COMPUTE!Trigger) and element.`function`.isDefined()) {
    return serviceOwningDeployable(element.`function`);
  }
  return null;
}

/** Resolves the service that should own a dead-letter queue for a seed element. */
operation serviceForDeadLetterSeed(seed) {
  var owner = serviceOwningDeployable(seed);
  if (owner.isDefined()) {
    return owner;
  }
  if (seed.isKindOf(INTEGRATION!Flow) and seed.source.isDefined()) {
    owner = serviceOwningDeployable(seed.source);
    if (owner.isDefined()) {
      return owner;
    }
  }
  if (seed.isKindOf(INTEGRATION!Flow) and seed.target.isDefined()) {
    owner = serviceOwningDeployable(seed.target);
    if (owner.isDefined()) {
      return owner;
    }
  }
  if (pimRoot().services.notEmpty()) {
    return pimRoot().services.first();
  }
  return null;
}

/** Adds a trigger under its hosting function containment. */
operation addTriggerToService(trigger, service) {
  if (trigger.isUndefined()) {
    return;
  }
  var host = trigger.`function`;
  if (host.isUndefined() and service.isDefined()) {
    host = firstOwnedFunction(service);
  }
  if (host.isDefined()) {
    host.triggers.add(trigger);
  }
}
