<?xml version='1.0' encoding='UTF-8'?>
<cim:CIMModel xmlns:cim="https://modriss.org/cim/1.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" id="shop-cim" name="Corner Shop" description="A small stationery shop: online ordering, atomic stock holds, hosted payment, full cancellation refunds, and store pickup. Fictional evaluation baseline." sourceReference="README.md" domainName="Online stationery ordering for store collection" organizationName="Corner Shop (fictional single-store retailer)" businessScope="Up to twenty active products, five distinct products per order, one currency, online full payment and full refunds before ready-for-collection; no shipping, partial fulfillment, discounts, returns, or account administration." language="en" modelingDate="2026-10-19T00:00:00.000+0000" lifecycleStatus="DRAFT" xmlns:cimorg="https://modriss.org/cim/organization/1.0" xmlns:cimdomain="https://modriss.org/cim/domain-data/1.0" xmlns:cimbehavior="https://modriss.org/cim/behavior/1.0" xmlns:cimprocess="https://modriss.org/cim/process-policy/1.0" xmlns:cimgov="https://modriss.org/cim/governance/1.0" xmlns:cimtransform="https://modriss.org/cim/transformation/1.0" xmlns:kernel="https://modriss.org/kernel/1.0" generatedByTransformation="false" manuallyMaintained="false">
  <requirements id="R01" name="Maintain a small product catalogue" description="Staff shall create or revise products with a unique immutable SKU, name (1-80 characters), price (1-100000 USD cents), and ACTIVE or WITHDRAWN state. At most twenty products are active. A price change increments its revision. Withdrawal prevents new checkouts, while existing orders keep their original line snapshots. Withdrawn products cannot be reactivated in this baseline. Creation starts with zero available stock." sourceReference="requirements.md#r01" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-product ent-product" fitCriterion="Valid changes affect future catalogue/checkouts only; duplicate SKU, invalid price/name, active-product overflow, or attempted reactivation has no effect." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R01-ac" name="Maintain a small product catalogue acceptance" description="the existing order still shows 500 cents and the product is unavailable to a new checkout" sourceReference="requirements.md#r01" xsi:type="cimorg:AcceptanceCriterion" givenContext="a product at 500 cents and an existing order containing it" whenAction="staff changes its price to 600 cents and later withdraws it" thenOutcome="the existing order still shows 500 cents and the product is unavailable to a new checkout" measurableTarget="Valid changes affect future catalogue/checkouts only; duplicate SKU, invalid price/name, active-product overflow, or attempted reactivation has no effect." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R02" name="Browse products" description="Anyone may browse ACTIVE products with SKU, name, current price/revision, currency, and advisory available quantity. Return twenty per page, ordered by name then SKU, with stable continuation. Browsing does not reserve stock and exposes no customer or payment data." sourceReference="requirements.md#r02" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="qry-catalogue" fitCriterion="Only active products appear; browsing out-of-stock products is allowed but the screen states that checkout cannot reserve unavailable units." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R02-ac" name="Browse products acceptance" description="only active products appear with correct prices and advisory stock, without personal information" sourceReference="requirements.md#r02" xsi:type="cimorg:AcceptanceCriterion" givenContext="active, withdrawn, and out-of-stock products" whenAction="a visitor browses" thenOutcome="only active products appear with correct prices and advisory stock, without personal information" measurableTarget="Only active products appear; browsing out-of-stock products is allowed but the screen states that checkout cannot reserve unavailable units." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R03" name="Add stock explicitly" description="Staff shall add a positive integer quantity from 1 to 1000 to an ACTIVE product using a reason and a request key. Available stock may not be directly overwritten. Replaying the same addition has no extra effect. Existing holds and sold units are unaffected." sourceReference="requirements.md#r03" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-restock ent-product" fitCriterion="A stock addition increases available quantity exactly once; zero, negative, fractional quantities and unauthorized additions fail without mutation." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R03-ac" name="Add stock explicitly acceptance" description="available quantity is seven and one stock-addition history entry exists" sourceReference="requirements.md#r03" xsi:type="cimorg:AcceptanceCriterion" givenContext="a product with two available units" whenAction="staff adds five units and replays that request" thenOutcome="available quantity is seven and one stock-addition history entry exists" measurableTarget="A stock addition increases available quantity exactly once; zero, negative, fractional quantities and unauthorized additions fail without mutation." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R04" name="Check out a bounded basket" description="An identified customer shall submit 1-5 distinct ACTIVE products with integer quantities 1-5 each, quoted unit prices and price revisions, their verified display name/email, and a request key. Reject duplicate product lines, stale price/revision, invalid input, or insufficient stock without creating any order or hold. A valid checkout atomically creates an AWAITING_PAYMENT order, immutable line snapshots, one payment record, and HELD line quantities; deduct all requested units from availability. Set expiresAt to committed checkout instant plus fifteen minutes. The basket is a client-side draft, not a separately persisted business record." sourceReference="requirements.md#r04" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-checkout ent-order ent-line agg-sale" fitCriterion="Either every line is reserved and the order exists or no line changes; client-supplied totals cannot determine the charge." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R04-ac" name="Check out a bounded basket acceptance" description="one order with correct immutable lines and a fifteen-minute deadline is returned, and both stock quantities decrease" sourceReference="requirements.md#r04" xsi:type="cimorg:AcceptanceCriterion" givenContext="two products with enough stock and current quoted prices" whenAction="a customer checks out both products" thenOutcome="one order with correct immutable lines and a fifteen-minute deadline is returned, and both stock quantities decrease" measurableTarget="Either every line is reserved and the order exists or no line changes; client-supplied totals cannot determine the charge." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R05" name="Prevent overselling and double release" description="Checkout and each later stock-affecting transition shall preserve nonnegative availability across all affected products. A line progresses HELD to COMMITTED on timely payment, or HELD/COMMITTED to RELEASED on eligible expiry/cancellation; collection makes COMMITTED into FULFILLED. Release each line at most once. Concurrent expiry, payment, cancellation, restocking, and checkout must serialize into valid complete outcomes. A failed multi-product checkout may not hold any subset." sourceReference="requirements.md#r05" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="BUSINESS_RULE" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="agg-sale cmd-checkout cmd-expire cmd-cancel cmd-payment" fitCriterion="Ten customers competing for one unit produce exactly one held order and nine OUT_OF_STOCK outcomes; racing closure paths return stock at most once." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R05-ac" name="Prevent overselling and double release acceptance" description="one order holds the unit, nine requests fail, and availability is zero" sourceReference="requirements.md#r05" xsi:type="cimorg:AcceptanceCriterion" givenContext="one available unit and ten different customers" whenAction="ten valid checkouts race" thenOutcome="one order holds the unit, nine requests fail, and availability is zero" measurableTarget="Ten customers competing for one unit produce exactly one held order and nine OUT_OF_STOCK outcomes; racing closure paths return stock at most once." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R06" name="Open a hosted payment session" description="The owner of an unexpired AWAITING_PAYMENT order may open its hosted payment session. Send authoritative order reference, amount, USD currency and expiresAt to the provider. Use one stable provider session key per order; repeated requests return the same session. A provider timeout may be retried using that key while the order is eligible. The application never collects card data. Visiting a payment return URL does not mark an order paid." sourceReference="requirements.md#r06" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-open-payment actor-payment" fitCriterion="A session uses the server-computed amount/deadline; at now &gt;= expiresAt or after cancellation no new session is opened; a timeout/retry does not create another session." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R06-ac" name="Open a hosted payment session acceptance" description="the same provider session for the authoritative amount is returned and the order is still AWAITING_PAYMENT" sourceReference="requirements.md#r06" xsi:type="cimorg:AcceptanceCriterion" givenContext="an unpaid unexpired order" whenAction="its owner opens payment twice" thenOutcome="the same provider session for the authoritative amount is returned and the order is still AWAITING_PAYMENT" measurableTarget="A session uses the server-computed amount/deadline; at now &gt;= expiresAt or after cancellation no new session is opened; a timeout/retry does not create another session." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R07" name="Apply verified payment results" description="Only authenticated provider facts or trusted reconciliation observations may change payment state. Verify order/session association, one capture reference per order, amount, currency, fact identity, and provider occurrence time. A first matching capture pays an AWAITING_PAYMENT order only when both provider capturedAt and processing time are strictly before expiresAt. Commit PAID, payment CAPTURED and HELD-to-COMMITTED together. A capture first learned at/after the deadline or after cancellation/expiry creates one full refund obligation; never reopen that order. A repeated already-applied capture is a no-op even after the deadline. Stale unpaid/decline facts cannot downgrade a capture. Invalid, conflicting, or mismatched facts are quarantined for staff inspection with no order/stock mutation. Unknown or erased order references are rejected without retaining the supplied personal or financial references; only an anonymous rejection count may remain. Quarantine applies to verifiable existing retained orders." sourceReference="requirements.md#r07" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="BUSINESS_RULE" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-payment dt-payment ent-payment" fitCriterion="A valid timely capture produces PAID once; a late capture remains CANCELLED/EXPIRED with REFUND_PENDING; duplicates never refund a timely PAID/READY/COLLECTED order." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R07-ac" name="Apply verified payment results acceptance" description="the order is PAID once with committed lines and no stock release or duplicate effect" sourceReference="requirements.md#r07" xsi:type="cimorg:AcceptanceCriterion" givenContext="an awaiting order and a verified exact-amount capture before its deadline" whenAction="the capture fact is applied twice" thenOutcome="the order is PAID once with committed lines and no stock release or duplicate effect" measurableTarget="A valid timely capture produces PAID once; a late capture remains CANCELLED/EXPIRED with REFUND_PENDING; duplicates never refund a timely PAID/READY/COLLECTED order." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R08" name="Expire unpaid orders" description="At now &gt;= expiresAt, trusted due processing shall change each still-AWAITING_PAYMENT order to EXPIRED and release every HELD line atomically, completing within sixty seconds. A verified definitive unpaid/declined result before expiry instead changes an awaiting order to CANCELLED and releases its holds. Already-paid orders are never expired. Unknown payment outcomes remain under reconciliation, and a later discovered capture follows the refund rule." sourceReference="requirements.md#r08" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-expire cmd-payment pol-expiry" fitCriterion="At deadline minus 1ms expiry has no effect; at the deadline it releases stock once. Repeated expiry or stale decline facts cannot release paid stock." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R08-ac" name="Expire unpaid orders acceptance" description="the order is EXPIRED and each held unit returns once to availability" sourceReference="requirements.md#r08" xsi:type="cimorg:AcceptanceCriterion" givenContext="an unpaid order at its exact deadline" whenAction="expiry runs twice" thenOutcome="the order is EXPIRED and each held unit returns once to availability" measurableTarget="At deadline minus 1ms expiry has no effect; at the deadline it releases stock once. Repeated expiry or stale decline facts cannot release paid stock." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R09" name="Cancel before packing is complete" description="A customer may cancel only their own AWAITING_PAYMENT or PAID order. Cancellation of an awaiting order before its deadline produces CANCELLED and releases holds; at/after the deadline it is processed as EXPIRED. Cancellation of PAID atomically produces CANCELLED, releases committed stock, and records REFUND_PENDING with a full-refund obligation. READY and COLLECTED orders cannot be cancelled. Repeating a completed cancellation is harmless. If staff readiness races cancellation, exactly one eligible transition wins." sourceReference="requirements.md#r09" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-cancel pol-cancel" fitCriterion="Paid cancellation immediately restores stock but reports refund pending; it never claims money has already been returned. A losing cancel/ready request has no partial effects." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R09-ac" name="Cancel before packing is complete acceptance" description="the order is CANCELLED, stock is released once, and one full refund is pending" sourceReference="requirements.md#r09" xsi:type="cimorg:AcceptanceCriterion" givenContext="a paid order not yet ready" whenAction="the owner cancels" thenOutcome="the order is CANCELLED, stock is released once, and one full refund is pending" measurableTarget="Paid cancellation immediately restores stock but reports refund pending; it never claims money has already been returned. A losing cancel/ready request has no partial effects." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R10" name="Complete or expose full refunds" description="Refunds are full amount only, against the verified capture, using one immutable provider refund key per capture. Durable refund obligations arise from paid cancellation or late capture. Trusted processing submits immediately, then retries eligible failures after at least one minute and five minutes, within sixty seconds of each due time, with at most three automatic submission attempts. A timeout uses lookup/reconciliation and the same key, never a new refund. Verified completion changes payment to REFUNDED and records refundedAt. After automatic exhaustion keep REFUND_PENDING with needsAttention=true; staff may retry the same obligation/key, without changing order or stock. Provider acceptance of a refund request alone is not refund completion." sourceReference="requirements.md#r10" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-refund cmd-payment pol-refund" fitCriterion="No refund exceeds captured amount or occurs twice; three failures remain visible to staff. Provider timeout-after-success plus retry yields one completed refund." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R10-ac" name="Complete or expose full refunds acceptance" description="the same key is used, one full refund completes, and payment becomes REFUNDED without another stock change" sourceReference="requirements.md#r10" xsi:type="cimorg:AcceptanceCriterion" givenContext="a cancelled paid order and a provider failing its first two refund submissions" whenAction="the obligation and due retries run, then a verified completion arrives" thenOutcome="the same key is used, one full refund completes, and payment becomes REFUNDED without another stock change" measurableTarget="No refund exceeds captured amount or occurs twice; three failures remain visible to staff. Provider timeout-after-success plus retry yields one completed refund." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R11" name="Mark an order ready" description="Staff shall mark only a PAID order with matching captured payment and COMMITTED lines READY after physically packing the complete order. This closes customer cancellation and creates a ready-for-collection notice obligation. Repeating readiness is a no-op. Partial packing and substitutions are outside scope." sourceReference="requirements.md#r11" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-ready" fitCriterion="Unpaid, cancelled, expired, or collected orders cannot newly become READY; paid readiness preserves inventory counters." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R11-ac" name="Mark an order ready acceptance" description="the order is READY once and exactly one ready notice obligation exists" sourceReference="requirements.md#r11" xsi:type="cimorg:AcceptanceCriterion" givenContext="a paid complete order and packed goods" whenAction="staff marks it ready twice" thenOutcome="the order is READY once and exactly one ready notice obligation exists" measurableTarget="Unpaid, cancelled, expired, or collected orders cannot newly become READY; paid readiness preserves inventory counters." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R12" name="Record store collection" description="Staff shall record collection only for a READY order after checking the order reference and the customer identity shown on its receipt. Atomically change the order to COLLECTED and all COMMITTED lines to FULFILLED. Repeated collection is a no-op; collection never increases available stock. Uncollected READY orders remain visible for staff follow-up; no automatic pickup deadline or refund is assumed." sourceReference="requirements.md#r12" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-collect" fitCriterion="Only READY to COLLECTED succeeds, exactly once; there is no available-stock increase." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R12-ac" name="Record store collection acceptance" description="one COLLECTED state change exists, its lines are FULFILLED, and availability is unchanged" sourceReference="requirements.md#r12" xsi:type="cimorg:AcceptanceCriterion" givenContext="a ready order whose customer presents its receipt" whenAction="staff verifies identity and records collection twice" thenOutcome="one COLLECTED state change exists, its lines are FULFILLED, and availability is unchanged" measurableTarget="Only READY to COLLECTED succeeds, exactly once; there is no available-stock increase." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R13" name="Inspect customer and staff order views" description="Customers shall see only their own orders with immutable line details, total, order/payment state, payment deadline, session action when eligible, refund progress, and chronological status history. Staff shall see all orders, stock movement history, payment exceptions and refund obligations needing attention; delivery failures are separately listed. Lists use twenty results per page with stable continuation, filters by relevant state, and newest creation time then order identifier. Reads after acknowledged mutations reflect committed state." sourceReference="requirements.md#r13" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="qry-mine qry-staff qry-notice-failures" fitCriterion="Changing an order identifier never exposes another customer; staff can distinguish waiting for payment, paid, ready, collected, cancelled/refund pending, refunded, and expired." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R13-ac" name="Inspect customer and staff order views acceptance" description="customers see only their orders; staff sees correct states, history, and the refund needing attention" sourceReference="requirements.md#r13" xsi:type="cimorg:AcceptanceCriterion" givenContext="two customers with different order states and one failed refund obligation" whenAction="each customer and a staff member opens the appropriate view" thenOutcome="customers see only their orders; staff sees correct states, history, and the refund needing attention" measurableTarget="Changing an order identifier never exposes another customer; staff can distinguish waiting for payment, paid, ready, collected, cancelled/refund pending, refunded, and expired." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R14" name="Deliver relevant order notices" description="Committed paid, cancelled, ready, and refund-completed facts shall create one durable notice intent per fact/order/kind. Include order reference, resulting status, authoritative amount when relevant, and store pickup details for readiness. Deduplicate redelivered facts. Before every send, suppress obsolete notices: PAID requires order PAID, READY requires READY, CANCELLED requires CANCELLED, REFUNDED requires payment REFUNDED. Each kind also requires unexpired retention. Provider acceptance means accepted for email delivery, not arrival in an inbox. Retry failures after one and five minutes, three total attempts maximum; exhausted failures remain visible to staff and never change order/payment/stock." sourceReference="requirements.md#r14" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-prepare-notice cmd-deliver-notice ent-notice" fitCriterion="Duplicate facts create one intent; a held PAID notice is suppressed if readiness supersedes it; provider failures do not change purchase outcomes." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R14-ac" name="Deliver relevant order notices acceptance" description="one relevant notice intent is accepted or visibly exhausted, without another order or stock mutation" sourceReference="requirements.md#r14" xsi:type="cimorg:AcceptanceCriterion" givenContext="a paid fact delivered twice and a temporarily failing email service" whenAction="notice processing and eligible retries run" thenOutcome="one relevant notice intent is accepted or visibly exhausted, without another order or stock mutation" measurableTarget="Duplicate facts create one intent; a held PAID notice is suppressed if readiness supersedes it; provider failures do not change purchase outcomes." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R15" name="Make every mutation replay safe" description="Customer/staff mutations use verified actor + command kind + client request identifier and a payload fingerprint. Exact replay returns the original outcome without extra stock changes, charge/session/refund requests, audit state changes, or notice obligations. Reusing a key with changed payload returns REQUEST_KEY_REUSED. Internal keys identify order expiry, provider fact/capture, refund obligation/attempt, notice intent/attempt, or retention run. Provider session/capture/refund keys remain stable across caller retries. New customer/staff mutations carry a trusted operation validity deadline fixed at issue time plus twenty-four hours and bound to the original actor/key/payload. Unknown or erased keys cannot start a mutation at/after that deadline. A retained exact-replay result may still be read afterwards. A caller cannot extend an old operation validity window by changing a timestamp." sourceReference="requirements.md#r15" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="BUSINESS_RULE" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-checkout cmd-cancel cmd-payment cmd-refund agg-sale" fitCriterion="Exact duplicate checkout creates one order/hold, duplicate cancellation releases once, and changed-payload reuse has no effects." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R15-ac" name="Make every mutation replay safe acceptance" description="the replay returns the original order and changed payload is rejected without stock mutation" sourceReference="requirements.md#r15" xsi:type="cimorg:AcceptanceCriterion" givenContext="a successful checkout and its original request key" whenAction="the request is replayed and then a changed basket uses the same key" thenOutcome="the replay returns the original order and changed payload is rejected without stock mutation" measurableTarget="Exact duplicate checkout creates one order/hold, duplicate cancellation releases once, and changed-payload reuse has no effects." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R16" name="Enforce identities and permissions" description="Customer identities and verified contact details are provisioned for evaluation. Customers may act only on their own orders. Staff alone maintain catalogue/stock, mark readiness/collection, inspect all orders/history and retry exhausted refunds. Trusted services perform due, reconciliation, notice, and retention work. Provider callback identities may supply verified payment facts but cannot edit catalogue, cancel arbitrary orders, or mark collection. Anonymous browsing is public; private reads and all mutations require their assigned identity." sourceReference="requirements.md#r16" xsi:type="cimgov:SecurityConstraint" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="SECURITY" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="actor-customer actor-staff cmd-checkout cmd-cancel cmd-payment qry-mine qry-staff" fitCriterion="Anonymous checkout, cross-customer reads/cancellation, customer staff-view access, forged callbacks and provider-origin inventory mutations fail without unauthorized effects or disclosure." qualityType="SECURITY" metric="Enforce identities and permissions" target="Anonymous checkout, cross-customer reads/cancellation, customer staff-view access, forged callbacks and provider-origin inventory mutations fail without unauthorized effects or disclosure." measurementMethod="Execute the acceptance criterion and linked deterministic scenarios." environmentAssumption="Controlled clock, provisioned identities, sandbox provider ledgers, and one-store evaluation deployment." constrainedElements="actor-customer actor-staff cmd-checkout cmd-cancel cmd-payment qry-mine qry-staff" authenticationNeed="Verified customer/staff/service identities and authenticated provider facts." authorizationRule="Owner-only customer orders; staff-only operations; trusted service due work; provider payment-fact scope only." threatRationale="Prevent account impersonation, tampered totals, forged captures/refunds, and stock manipulation." constrainedActors="actor-customer actor-staff" constrainedCommands="cmd-checkout cmd-cancel cmd-payment" constrainedQueries="qry-mine qry-staff" generatedByTransformation="false" manuallyMaintained="false" segregationOfDutiesRequired="false" nonRepudiationRequired="false" auditAccessRequired="false">
    <acceptanceCriteria id="R16-ac" name="Enforce identities and permissions acceptance" description="all are denied with unchanged business state and no foreign personal-data response" sourceReference="requirements.md#r16" xsi:type="cimorg:AcceptanceCriterion" givenContext="Alice and Ben have different accounts and one order each" whenAction="Alice requests Ben's order/cancellation and a forged callback is submitted" thenOutcome="all are denied with unchanged business state and no foreign personal-data response" measurableTarget="Anonymous checkout, cross-customer reads/cancellation, customer staff-view access, forged callbacks and provider-origin inventory mutations fail without unauthorized effects or disclosure." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R16-scenario" name="Enforce identities and permissions quality scenario" description="Anonymous checkout, cross-customer reads/cancellation, customer staff-view access, forged callbacks and provider-origin inventory mutations fail without unauthorized effects or disclosure." sourceReference="requirements.md#r16" xsi:type="cimgov:QualityScenario" qualityType="SECURITY" source="Customer, staff, provider, or evaluation fault operator" stimulus="Alice requests Ben's order/cancellation and a forged callback is submitted" environment="Alice and Ben have different accounts and one order each" artifact="Ordering application and its authoritative business records" response="all are denied with unchanged business state and no foreign personal-data response" responseMeasure="Anonymous checkout, cross-customer reads/cancellation, customer staff-view access, forged callbacks and provider-origin inventory mutations fail without unauthorized effects or disclosure." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R17" name="Reconcile missing provider results" description="While payment outcome is unresolved, or a refund is pending, trusted processing shall query the provider ledger by the stable order/capture/refund keys at least once per sixty seconds while the provider is reachable. Apply verified observations through the same guarded payment-result command as callbacks. Recover missed captured, definitively unpaid, and completed-refund results. A definitive unpaid result for an existing capture is stale and cannot downgrade it. Invalid/conflicting facts are visible for staff review. The test provider supplies a final unpaid/capture result no later than ten minutes after session expiry." sourceReference="requirements.md#r17" xsi:type="cimgov:NonFunctionalRequirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="QUALITY" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-reconcile cmd-payment" fitCriterion="If a callback is lost, the next reachable reconciliation recovers it within sixty seconds without a second capture/refund or an order reopening." qualityType="RELIABILITY" metric="Reconcile missing provider results" target="If a callback is lost, the next reachable reconciliation recovers it within sixty seconds without a second capture/refund or an order reopening." measurementMethod="Execute the acceptance criterion and linked deterministic scenarios." environmentAssumption="Controlled clock, provisioned identities, sandbox provider ledgers, and one-store evaluation deployment." constrainedElements="cmd-reconcile cmd-payment" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R17-ac" name="Reconcile missing provider results acceptance" description="the correct guarded state appears within sixty seconds without duplicate financial effects" sourceReference="requirements.md#r17" xsi:type="cimorg:AcceptanceCriterion" givenContext="a captured payment or completed refund with its callback withheld" whenAction="the next due reconciliation succeeds" thenOutcome="the correct guarded state appears within sixty seconds without duplicate financial effects" measurableTarget="If a callback is lost, the next reachable reconciliation recovers it within sixty seconds without a second capture/refund or an order reopening." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R17-scenario" name="Reconcile missing provider results quality scenario" description="If a callback is lost, the next reachable reconciliation recovers it within sixty seconds without a second capture/refund or an order reopening." sourceReference="requirements.md#r17" xsi:type="cimgov:QualityScenario" qualityType="RELIABILITY" source="Customer, staff, provider, or evaluation fault operator" stimulus="the next due reconciliation succeeds" environment="a captured payment or completed refund with its callback withheld" artifact="Ordering application and its authoritative business records" response="the correct guarded state appears within sixty seconds without duplicate financial effects" responseMeasure="If a callback is lost, the next reachable reconciliation recovers it within sixty seconds without a second capture/refund or an order reopening." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R18" name="Calculate totals exactly" description="All prices and amounts are integer USD cents, bounded as in R01/R04. Line total equals snapshotted unit price times quantity; order total equals the exact sum. Listed prices include all charges for this fictional pickup shop; tax calculation, shipping fees, coupons and currency conversion are outside scope. Reject float/fractional quantities and inconsistent quotes; do not trust a client total. Refunds equal the captured order total and never exceed it." sourceReference="requirements.md#r18" xsi:type="cimorg:Requirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="BUSINESS_RULE" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="ent-line ent-order info-order-total cmd-checkout" fitCriterion="Two notebooks at 500 cents and one pen at 200 cents cost 1200 cents; later product price edits leave that order total unchanged." generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R18-ac" name="Calculate totals exactly acceptance" description="line totals are 1000 and 200 cents, total is 1200, and provider/refund amounts match exactly" sourceReference="requirements.md#r18" xsi:type="cimorg:AcceptanceCriterion" givenContext="a basket of two 500-cent notebooks and one 200-cent pen" whenAction="checkout computes its total" thenOutcome="line totals are 1000 and 200 cents, total is 1200, and provider/refund amounts match exactly" measurableTarget="Two notebooks at 500 cents and one pen at 200 cents cost 1200 cents; later product price edits leave that order total unchanged." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R19" name="Recover committed obligations" description="An acknowledged stock/order/payment transition and its required refund/notice obligations shall survive worker restart. After recovery within ten minutes, process pending obligations within sixty seconds of becoming eligible/reachable. Do not require the customer to resubmit checkout. A crash between provider acceptance and local recording must reconcile using stable keys. Do not publish a receipt indicating payment or refund completion before it is verified." sourceReference="requirements.md#r19" xsi:type="cimgov:NonFunctionalRequirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="QUALITY" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-cancel cmd-refund cmd-prepare-notice agg-sale" fitCriterion="Crash after paid cancellation commits but before refund submission: one cancelled order and released inventory survive; one refund obligation is recovered and submitted without duplicate stock release." qualityType="RELIABILITY" metric="Recover committed obligations" target="Crash after paid cancellation commits but before refund submission: one cancelled order and released inventory survive; one refund obligation is recovered and submitted without duplicate stock release." measurementMethod="Execute the acceptance criterion and linked deterministic scenarios." environmentAssumption="Controlled clock, provisioned identities, sandbox provider ledgers, and one-store evaluation deployment." constrainedElements="cmd-cancel cmd-refund cmd-prepare-notice agg-sale" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R19-ac" name="Recover committed obligations acceptance" description="one durable refund and notice obligation survives and completes according to provider outcomes" sourceReference="requirements.md#r19" xsi:type="cimorg:AcceptanceCriterion" givenContext="a committed paid cancellation before refund or notice processing" whenAction="processing restarts and resumes within ten minutes" thenOutcome="one durable refund and notice obligation survives and completes according to provider outcomes" measurableTarget="Crash after paid cancellation commits but before refund submission: one cancelled order and released inventory survive; one refund obligation is recovered and submitted without duplicate stock release." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R19-scenario" name="Recover committed obligations quality scenario" description="Crash after paid cancellation commits but before refund submission: one cancelled order and released inventory survive; one refund obligation is recovered and submitted without duplicate stock release." sourceReference="requirements.md#r19" xsi:type="cimgov:QualityScenario" qualityType="RELIABILITY" source="Customer, staff, provider, or evaluation fault operator" stimulus="processing restarts and resumes within ten minutes" environment="a committed paid cancellation before refund or notice processing" artifact="Ordering application and its authoritative business records" response="one durable refund and notice obligation survives and completes according to provider outcomes" responseMeasure="Crash after paid cancellation commits but before refund submission: one cancelled order and released inventory survive; one refund obligation is recovered and submitted without duplicate stock release." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R20" name="Handle a small launch burst" description="For a documented test deployment, measure 100 catalogue, own-order and checkout requests over sixty seconds, up to twenty concurrently, including cold starts and rejections. The 95th percentile response time shall be at most two seconds for those local interactions; external hosted-payment and email time is measured separately. Report sample count, errors, concurrency, deployment/environment and percentile method. Stock invariants must hold." sourceReference="requirements.md#r20" xsi:type="cimgov:NonFunctionalRequirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="QUALITY" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-checkout qry-catalogue qry-mine" fitCriterion="At least 100 measured interactions meet p95 &lt;=2 seconds with no overselling; unsuccessful requests are not omitted from results." qualityType="PERFORMANCE" metric="Handle a small launch burst" target="At least 100 measured interactions meet p95 &lt;=2 seconds with no overselling; unsuccessful requests are not omitted from results." measurementMethod="Execute the acceptance criterion and linked deterministic scenarios." environmentAssumption="Controlled clock, provisioned identities, sandbox provider ledgers, and one-store evaluation deployment." constrainedElements="cmd-checkout qry-catalogue qry-mine" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R20-ac" name="Handle a small launch burst acceptance" description="p95 local response latency is at most two seconds and all inventory invariants hold" sourceReference="requirements.md#r20" xsi:type="cimorg:AcceptanceCriterion" givenContext="an initially idle deployment and the stated 100-request workload" whenAction="the burst runs" thenOutcome="p95 local response latency is at most two seconds and all inventory invariants hold" measurableTarget="At least 100 measured interactions meet p95 &lt;=2 seconds with no overselling; unsuccessful requests are not omitted from results." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R20-scenario" name="Handle a small launch burst quality scenario" description="At least 100 measured interactions meet p95 &lt;=2 seconds with no overselling; unsuccessful requests are not omitted from results." sourceReference="requirements.md#r20" xsi:type="cimgov:QualityScenario" qualityType="PERFORMANCE" source="Customer, staff, provider, or evaluation fault operator" stimulus="the burst runs" environment="an initially idle deployment and the stated 100-request workload" artifact="Ordering application and its authoritative business records" response="p95 local response latency is at most two seconds and all inventory invariants hold" responseMeasure="At least 100 measured interactions meet p95 &lt;=2 seconds with no overselling; unsuccessful requests are not omitted from results." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R21" name="Minimize and remove identifying data" description="Use only customer identifier, display name, verified email, order history and provider transaction references needed for this scenario; no card data, shipping address, or marketing profile is stored. For CANCELLED, EXPIRED or COLLECTED orders, erase identifying orders/lines/payment/notice/audit/fact/request-key records within twenty-four hours after the later of terminal order time plus thirty days and financial settlement time. Financial settlement means verified captured payment for a collected order, definitive unpaid closure, or verified full refund for a cancelled/expired charged order. Pending/unresolved refunds are not erased and remain visible to staff. Retain only anonymous sales/refund totals, product data, and a non-identifying erasure receipt that cannot link back to a person/order/provider reference. Stop late facts from recreating erased personal records." sourceReference="requirements.md#r21" xsi:type="cimgov:PrivacyConstraint" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="PRIVACY" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="cmd-purge pol-retention ent-order ent-payment ent-notice" fitCriterion="Eligible cleanup removes all scoped identifiers and contact/transaction/history data across every store while anonymous totals remain; unresolved refunds are retained and flagged." qualityType="PRIVACY" metric="Minimize and remove identifying data" target="Eligible cleanup removes all scoped identifiers and contact/transaction/history data across every store while anonymous totals remain; unresolved refunds are retained and flagged." measurementMethod="Execute the acceptance criterion and linked deterministic scenarios." environmentAssumption="Controlled clock, provisioned identities, sandbox provider ledgers, and one-store evaluation deployment." constrainedElements="cmd-purge pol-retention ent-order ent-payment ent-notice" purpose="Fulfill sandbox pickup orders, reconcile their payments/refunds, and keep short-lived accountability." legalBasis="CONTRACT" retentionPeriod="Later of terminal order time + 30 days and verified financial settlement; erase within 24 hours." minimizationRule="No card data or shipping address; remove identifying order, provider, notice, history and replay records; keep anonymous totals only." law="Fictional evaluation retention policy; no jurisdiction-specific compliance is asserted." jurisdiction="Evaluation sandbox; real deployment retention requires a separate decision." dataSubjectType="Customers and identified staff in order history" dataSubjects="actor-customer actor-staff" deletionRequired="true" dataItems="info-order-id info-customer-id info-name info-email info-order-state info-created info-expires info-terminal-at info-order-total info-line-id info-quantity info-snapshot-name info-snapshot-price info-line-total info-line-state info-payment-id info-session-id info-capture-id info-payment-state info-captured-at info-provider-fact info-provider-result info-provider-amount info-session-key info-refund-key info-refund-attempts info-next-refund info-settled-at info-needs-attention info-payment-exceptions info-operation-key info-fact-id info-notice-id info-notice-kind info-notice-state info-notice-content info-notice-attempts info-next-notice info-order-view info-staff-view info-provider-occurred info-refunded-at info-operation-valid-until info-basket basket-sku basket-quantity basket-quotedPrice basket-quotedRevision info-audit audit-operationKey audit-actor audit-occurredAt audit-relatedIdentity audit-before audit-after audit-quantity audit-reason" generatedByTransformation="false" manuallyMaintained="false" consentRequired="false" portabilityRequired="false" rectificationRequired="false" dataResidencyRequired="false" crossBorderTransferAllowed="false">
    <acceptanceCriteria id="R21-ac" name="Minimize and remove identifying data acceptance" description="the eligible order's identifying records are gone and the unresolved refund remains visible; replay cannot recreate erased data" sourceReference="requirements.md#r21" xsi:type="cimorg:AcceptanceCriterion" givenContext="a terminal financially settled order beyond its retention eligibility and a separate unresolved refund" whenAction="retention processing runs twice" thenOutcome="the eligible order's identifying records are gone and the unresolved refund remains visible; replay cannot recreate erased data" measurableTarget="Eligible cleanup removes all scoped identifiers and contact/transaction/history data across every store while anonymous totals remain; unresolved refunds are retained and flagged." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R21-scenario" name="Minimize and remove identifying data quality scenario" description="Eligible cleanup removes all scoped identifiers and contact/transaction/history data across every store while anonymous totals remain; unresolved refunds are retained and flagged." sourceReference="requirements.md#r21" xsi:type="cimgov:QualityScenario" qualityType="PRIVACY" source="Customer, staff, provider, or evaluation fault operator" stimulus="retention processing runs twice" environment="a terminal financially settled order beyond its retention eligibility and a separate unresolved refund" artifact="Ordering application and its authoritative business records" response="the eligible order's identifying records are gone and the unresolved refund remains visible; replay cannot recreate erased data" responseMeasure="Eligible cleanup removes all scoped identifiers and contact/transaction/history data across every store while anonymous totals remain; unresolved refunds are retained and flagged." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R22" name="Keep accountable history" description="Every successful product/stock/order/payment state change shall record operation key, responsible verified actor/role, occurrence time, related identifiers, and before/after values. Stock entries include quantity and reason; payment/refund entries include safe provider references and result, never card secrets. No-op replay does not append another state change. Staff alone inspect identifying history; operational logs contain no email, payment credentials, or message bodies. Identifying history follows R21." sourceReference="requirements.md#r22" xsi:type="cimgov:NonFunctionalRequirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="AUDIT" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="info-audit qry-staff cmd-payment cmd-cancel" fitCriterion="Checkout, capture, cancellation, refund and stock restoration can be reconstructed; replay adds no duplicate transition, and retention removes identifying history." qualityType="AUDITABILITY" metric="Keep accountable history" target="Checkout, capture, cancellation, refund and stock restoration can be reconstructed; replay adds no duplicate transition, and retention removes identifying history." measurementMethod="Execute the acceptance criterion and linked deterministic scenarios." environmentAssumption="Controlled clock, provisioned identities, sandbox provider ledgers, and one-store evaluation deployment." constrainedElements="info-audit qry-staff cmd-payment cmd-cancel" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R22-ac" name="Keep accountable history acceptance" description="one coherent transition history and one release/refund appear, without sensitive secrets" sourceReference="requirements.md#r22" xsi:type="cimorg:AcceptanceCriterion" givenContext="an order that is checked out, paid, then cancelled and refunded" whenAction="staff inspects its history after duplicate callbacks" thenOutcome="one coherent transition history and one release/refund appear, without sensitive secrets" measurableTarget="Checkout, capture, cancellation, refund and stock restoration can be reconstructed; replay adds no duplicate transition, and retention removes identifying history." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R22-scenario" name="Keep accountable history quality scenario" description="Checkout, capture, cancellation, refund and stock restoration can be reconstructed; replay adds no duplicate transition, and retention removes identifying history." sourceReference="requirements.md#r22" xsi:type="cimgov:QualityScenario" qualityType="AUDITABILITY" source="Customer, staff, provider, or evaluation fault operator" stimulus="staff inspects its history after duplicate callbacks" environment="an order that is checked out, paid, then cancelled and refunded" artifact="Ordering application and its authoritative business records" response="one coherent transition history and one release/refund appear, without sensitive secrets" responseMeasure="Checkout, capture, cancellation, refund and stock restoration can be reconstructed; replay adds no duplicate transition, and retention removes identifying history." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R23" name="Make ordering and refund states understandable" description="Show a readable receipt with product/quantity/price snapshots, exact total, order state, payment deadline with timezone, and next eligible action. Distinguish awaiting payment, paid, ready, collected, expired, cancelled/refund pending, and refunded. Explain that stock is held for fifteen minutes and a browser payment-return screen is not proof of payment. Own-order status remains authoritative when email is delayed." sourceReference="requirements.md#r23" xsi:type="cimgov:NonFunctionalRequirement" mandatory="true" productionBlocking="true" priority="HIGH" requirementType="QUALITY" sourceType="ASSUMPTION" supportsGoals="goal-correct goal-clear" constrains="qry-mine cmd-checkout cmd-cancel" fitCriterion="In a pilot, a first-time customer can order the fixture basket and correctly explain total, hold deadline and payment state in five minutes without moderator instruction; after cancellation correctly distinguish refund pending from refunded." qualityType="USABILITY" metric="Make ordering and refund states understandable" target="In a pilot, a first-time customer can order the fixture basket and correctly explain total, hold deadline and payment state in five minutes without moderator instruction; after cancellation correctly distinguish refund pending from refunded." measurementMethod="Execute the acceptance criterion and linked deterministic scenarios." environmentAssumption="Controlled clock, provisioned identities, sandbox provider ledgers, and one-store evaluation deployment." constrainedElements="qry-mine cmd-checkout cmd-cancel" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R23-ac" name="Make ordering and refund states understandable acceptance" description="they explain total, deadline and states correctly within five minutes; record misunderstandings" sourceReference="requirements.md#r23" xsi:type="cimorg:AcceptanceCriterion" givenContext="a first-time customer and the reference catalogue" whenAction="they order and inspect a cancellation/refund example" thenOutcome="they explain total, deadline and states correctly within five minutes; record misunderstandings" measurableTarget="In a pilot, a first-time customer can order the fixture basket and correctly explain total, hold deadline and payment state in five minutes without moderator instruction; after cancellation correctly distinguish refund pending from refunded." automatableTestCandidate="false" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R23-scenario" name="Make ordering and refund states understandable quality scenario" description="In a pilot, a first-time customer can order the fixture basket and correctly explain total, hold deadline and payment state in five minutes without moderator instruction; after cancellation correctly distinguish refund pending from refunded." sourceReference="requirements.md#r23" xsi:type="cimgov:QualityScenario" qualityType="USABILITY" source="Customer, staff, provider, or evaluation fault operator" stimulus="they order and inspect a cancellation/refund example" environment="a first-time customer and the reference catalogue" artifact="Ordering application and its authoritative business records" response="they explain total, deadline and states correctly within five minutes; record misunderstandings" responseMeasure="In a pilot, a first-time customer can order the fixture basket and correctly explain total, hold deadline and payment state in five minutes without moderator instruction; after cancellation correctly distinguish refund pending from refunded." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
