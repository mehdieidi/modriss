    <rules id="checkout-rule-4" name="Ordered checkout decisions 4" description="Reject OUT_OF_STOCK; no partial hold." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="4" condition="Any requested quantity exceeds available stock." outcome="Reject OUT_OF_STOCK; no partial hold." generatedByTransformation="false" manuallyMaintained="false" />
    <rules id="checkout-rule-5" name="Ordered checkout decisions 5" description="Atomically create order/payment/lines and all holds; emit OrderPlaced." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="5" condition="All prior guards pass." outcome="Atomically create order/payment/lines and all holds; emit OrderPlaced." generatedByTransformation="false" manuallyMaintained="false" />
  </decisionTables>
  <decisionTables id="dt-payment" name="Ordered provider-fact decisions" description="Evaluate the first matching row; exact replay is resolved before any new business change." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionTable" hitPolicy="FIRST" complete="false" defaultOutcome="Flag unmatched conflicting/invalid state for staff; preserve stock and monetary state." inputs="info-provider-fact info-provider-result info-provider-amount info-currency info-captured-at info-expires info-payment-state info-order-state" outputs="info-order-state info-payment-state info-needs-attention" generatedByTransformation="false" manuallyMaintained="false">
    <rules id="payment-rule-1" name="Ordered provider-fact decisions 1" description="Quarantine for staff review; no order/stock/monetary state mutation." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="1" condition="Authentication, association, amount/currency, occurrence-time or conflicting capture/refund validation fails." outcome="Quarantine for staff review; no order/stock/monetary state mutation." generatedByTransformation="false" manuallyMaintained="false" />
    <rules id="payment-rule-2" name="Ordered provider-fact decisions 2" description="No-op; never downgrade payment or repeat stock/refund effects." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="2" condition="Verified capture/refund/fact already applied, or unpaid fact is stale after a known capture." outcome="No-op; never downgrade payment or repeat stock/refund effects." generatedByTransformation="false" manuallyMaintained="false" />
    <rules id="payment-rule-3" name="Ordered provider-fact decisions 3" description="Commit PAID/CAPTURED with COMMITTED lines; emit OrderPaid." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="3" condition="First verified capture, awaiting order, and processing time and capturedAt both strictly before expiresAt." outcome="Commit PAID/CAPTURED with COMMITTED lines; emit OrderPaid." generatedByTransformation="false" manuallyMaintained="false" />
    <rules id="payment-rule-4" name="Ordered provider-fact decisions 4" description="Keep closed or expire/release awaiting order; record REFUND_PENDING and one RefundRequired obligation." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="4" condition="First verified capture after deadline or after order CANCELLED/EXPIRED." outcome="Keep closed or expire/release awaiting order; record REFUND_PENDING and one RefundRequired obligation." generatedByTransformation="false" manuallyMaintained="false" />
    <rules id="payment-rule-5" name="Ordered provider-fact decisions 5" description="CANCELLED before deadline or EXPIRED at/after deadline; release once and record verified unpaid state." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="5" condition="Verified definitive unpaid/decline, no capture, and order still awaiting." outcome="CANCELLED before deadline or EXPIRED at/after deadline; release once and record verified unpaid state." generatedByTransformation="false" manuallyMaintained="false" />
    <rules id="payment-rule-6" name="Ordered provider-fact decisions 6" description="Record UNPAID settlement without another release." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="6" condition="Verified final unpaid for already cancelled/expired order with no capture." outcome="Record UNPAID settlement without another release." generatedByTransformation="false" manuallyMaintained="false" />
    <rules id="payment-rule-7" name="Ordered provider-fact decisions 7" description="Record REFUNDED and settlement instant; emit RefundCompleted once." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="7" condition="Verified full refund of the known capture with correct refund key and amount." outcome="Record REFUNDED and settlement instant; emit RefundCompleted once." generatedByTransformation="false" manuallyMaintained="false" />
