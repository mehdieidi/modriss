  <commands id="cmd-refund" name="Submit pending full refund" description="Trusted refund worker or staff retry of an exhausted pending obligation; exact full amount and stable capture key only. Verified capture, refund obligation pending, stable key and eligible retry instant; after automatic exhaustion only staff may initiate another submission. Initial attempt count zero is eligible immediately. Later automatic submission requires attempts &lt; 3 and a recorded failure/timeout with nextRefund due. Accepted pending submissions with no due failure are reconciled, not resubmitted automatically. At attempts &gt;= 3 only an explicit staff retry is eligible, using the same key. For a new client-origin operation, enforce the trusted fixed operation validity window from R15; a retained exact replay returns its stored outcome." sourceReference="model-guide.md" xsi:type="cimbehavior:Command" intent="Submit pending full refund" issuedBy="actor-staff actor-time" targetCapability="cap-payments" targetAggregate="agg-sale" input="info-order-id info-capture-id info-refund-key info-operation-valid-until info-operation-key" preconditions="cond-refund" expectedEvents="evt-refund-attempt" possibleErrors="err-state err-access err-provider err-key" authorizationRequired="true" authorizationRule="Trusted refund worker or staff retry of an exhausted pending obligation; exact full amount and stable capture key only." duplicateSubmissionPossible="true" idempotencyBusinessKey="capture reference + full-refund obligation; submission attempt ordinal" auditRequired="true" userInitiated="false" commandType="POLICY_TRIGGERED_INTENT" interactionExpectation="BACK_OFFICE_PROCESSING" priority="HIGH" generatedByTransformation="false" manuallyMaintained="false">
