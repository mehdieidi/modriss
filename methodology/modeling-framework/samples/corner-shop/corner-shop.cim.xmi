    <rules id="checkout-rule-2" name="Ordered checkout decisions 2" description="Reject INVALID_INPUT; no mutation." sourceReference="model-guide.md" xsi:type="cimprocess:DecisionRule" priorityOrder="2" condition="Invalid/duplicate/withdrawn basket line or size/quantity bound fails." outcome="Reject INVALID_INPUT; no mutation." generatedByTransformation="false" manuallyMaintained="false" />
