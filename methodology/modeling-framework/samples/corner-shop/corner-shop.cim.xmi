  <processes id="proc-catalogue" name="Maintain catalogue and stock" description="Authorized staff requests a catalogue change or additive stock movement." sourceReference="model-guide.md" xsi:type="cimprocess:BusinessProcess" owningCapability="cap-sales" businessTriggerDescription="Authorized staff requests a catalogue change or additive stock movement." completionCriterion="Reached business outcomes and their durable obligations are committed, or the caller receives an error with no partial business mutation." processKind="STRAIGHT_THROUGH" longRunning="false" triggeringActor="actor-staff" generatedByTransformation="false" manuallyMaintained="false" humanApprovalPossible="false" compensationExpected="false">
