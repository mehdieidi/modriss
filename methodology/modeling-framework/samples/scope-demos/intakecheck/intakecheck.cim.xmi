  <requirements xsi:type="cimorg:Requirement" id="610c44e2-ca38-55af-8eeb-7caf37d47d70" name="IC-R1" mandatory="true" productionBlocking="false" externalId="IC-R1" description="A supplier registers/reads only their submissions and uploads only to the issued object key. Reject size/type violations explicitly." fitCriterion="A supplier registers/reads only their submissions and uploads only to the issued object key. Reject size/type violations explicitly." requirementType="FUNCTIONAL" constrains="e124c870-9ec4-55c8-872f-a3600c5b8a7b" supportsGoals="d31f5e8d-7e3b-556e-bd63-318983623b07">
