  <policies xsi:type="cimprocess:Policy" id="765938b7-cda2-59c1-99ee-89fcfe18c285" name="ExportQueue rule 2" auditRequired="false" naturalLanguageRule="Select at most 1000 rows from the immutable 10000-row snapshot; publish one correct private CSV per job." policyType="GUARD" guards="66ce08e1-ddeb-58a9-a5c2-871bbc6267c3 cc0a021f-8938-524b-a2c5-4eac6041fc78 65874735-9fe5-5843-9532-95f5a2b91560" />
  <policies xsi:type="cimprocess:Policy" id="5b0801ff-2a84-5114-8437-b748c64ff63a" name="ExportQueue rule 3" auditRequired="false" naturalLanguageRule="Cancellation commits only in QUEUED/RUNNING; if it wins workers cannot publish success, and if success wins cancellation conflicts." policyType="GUARD" guards="66ce08e1-ddeb-58a9-a5c2-871bbc6267c3 cc0a021f-8938-524b-a2c5-4eac6041fc78 65874735-9fe5-5843-9532-95f5a2b91560" />
  <policies xsi:type="cimprocess:Policy" id="ad043a3c-05f5-58e8-94e3-f704458d5e1e" name="ExportQueue rule 4" auditRequired="false" naturalLanguageRule="Only owners see status/cancel/download; CANCELLED jobs have no result. Configure five concurrent workers and recover partial batches." policyType="GUARD" guards="66ce08e1-ddeb-58a9-a5c2-871bbc6267c3 cc0a021f-8938-524b-a2c5-4eac6041fc78 65874735-9fe5-5843-9532-95f5a2b91560" />
  <requirements xsi:type="cimorg:Requirement" id="815f050c-44a5-51bc-be81-f9295ee25b7f" name="EQ-R1" mandatory="true" productionBlocking="false" externalId="EQ-R1" description="Return acceptance only after the job and recoverable dispatch intent are durable; identical request replay returns the original job." fitCriterion="Return acceptance only after the job and recoverable dispatch intent are durable; identical request replay returns the original job." requirementType="FUNCTIONAL" constrains="6a1f9317-4320-56d4-bc51-4eb4bd0ccd57" supportsGoals="a2742783-6ad9-5f8f-bd7e-af37ec37633e">
