  </requirements>
  <requirements xsi:type="cimorg:Requirement" id="e528ca81-4056-5374-a145-11327260702d" name="EQ-R2" mandatory="true" productionBlocking="false" externalId="EQ-R2" description="Process the immutable selected snapshot, create correct CSV and publish one result reference per job despite redelivery." fitCriterion="Process the immutable selected snapshot, create correct CSV and publish one result reference per job despite redelivery." requirementType="FUNCTIONAL" constrains="6a1f9317-4320-56d4-bc51-4eb4bd0ccd57" supportsGoals="a2742783-6ad9-5f8f-bd7e-af37ec37633e">
