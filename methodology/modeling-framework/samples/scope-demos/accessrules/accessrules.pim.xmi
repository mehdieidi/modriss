  <eventTypes xsi:type="contracts:EventType" id="08a4125f-ebcd-515d-b1e5-50fcda644b8d" name="EligibilityEvaluated" externalEvent="false" auditEvent="false" replayable="true" containsPersonalData="false" semanticName="EligibilityEvaluated" version="1" schema="0832b450-638d-5b76-b676-de834586629e" orderingKey="decisionId" />
  <businessRules xsi:type="policy:BusinessRule" id="ec8d9c9f-6b18-562b-bea1-72cf9121fd07" name="AccessRules rule 1" naturalLanguageRule="FIRST-match v1: SUSPENDED -&gt; DENY/SUSPENDED; missing remaining fact -&gt; NEEDS_INFO/MISSING_FACT; inactive/expired membership -&gt; DENY/MEMBERSHIP_INACTIVE; expired certificate -&gt; DENY/CERTIFICATION_EXPIRED; bookings &gt;= 3 -&gt; WAITLIST/BOOKING_LIMIT; default -&gt; ALLOW/ELIGIBLE." enforcedBy="aa6f378f-6476-5f7f-aec9-74bada6f8334 0107c021-ba0b-51d6-9a9b-64223c50ab16" />
  <businessRules xsi:type="policy:BusinessRule" id="53140123-6da0-5b31-b14e-ab4936172d96" name="AccessRules rule 2" naturalLanguageRule="UTC validity dates are inclusive; malformed dates/enums/counts are request errors rather than NEEDS_INFO." enforcedBy="aa6f378f-6476-5f7f-aec9-74bada6f8334 0107c021-ba0b-51d6-9a9b-64223c50ab16" />
  <businessRules xsi:type="policy:BusinessRule" id="aef3c091-4a86-54e0-9881-85eb5e61497b" name="AccessRules rule 3" naturalLanguageRule="Persist immutable facts/hash and actual policy version; same request key and same facts/version returns the same decision, changed reuse conflicts." enforcedBy="aa6f378f-6476-5f7f-aec9-74bada6f8334 0107c021-ba0b-51d6-9a9b-64223c50ab16" />
  <businessRules xsi:type="policy:BusinessRule" id="1dfc5009-e631-5db6-91d1-ccdf36287839" name="AccessRules rule 4" naturalLanguageRule="Only the policy owner activates reviewed versions; evaluator implementation is developer-owned, with independent expected vectors." enforcedBy="aa6f378f-6476-5f7f-aec9-74bada6f8334 0107c021-ba0b-51d6-9a9b-64223c50ab16" />
  <policies xsi:type="policy:IdempotencyPolicy" id="533603c0-ae69-5b03-bde5-0eeff6f66fe7" name="Durable scoped request/event keys" storeRequired="true" appliesToRetries="true" appliesToDuplicateRequests="true" productionRequired="false" keySource="verified-owner/requestKey or eventId" scope="AccessRules" attachedTo="aa6f378f-6476-5f7f-aec9-74bada6f8334 0107c021-ba0b-51d6-9a9b-64223c50ab16" />
  <decisionModels xsi:type="policy:DecisionModel" id="5b9db6d0-98f7-5c51-af92-b43360230e1e" name="Eligibility v1 FIRST" hitPolicy="FIRST">
    <rules xsi:type="policy:DecisionRule" id="adcf4b6f-6451-5f7d-9799-3916593db8fe" name="Suspended">
      <condition xsi:type="kernel:Expression" id="476ed746-2977-589c-ac7d-dc4940396bc9" name="condition" sideEffectFree="false" language="NATURAL_LANGUAGE" body="membershipState = SUSPENDED" phase="DESIGN_TIME" />
      <outcome xsi:type="kernel:Expression" id="1cc231f9-2d5a-5cf9-b74e-3d5351cf2e3f" name="outcome" sideEffectFree="false" language="NATURAL_LANGUAGE" body="DENY / SUSPENDED" phase="DESIGN_TIME" />
    </rules>
    <rules xsi:type="policy:DecisionRule" id="7a73a44f-b6c0-58f4-a4fe-880f17cb9bfa" name="Missing facts">
      <condition xsi:type="kernel:Expression" id="2ddd0467-02dd-5dbc-b263-75113d7aea2c" name="condition" sideEffectFree="false" language="NATURAL_LANGUAGE" body="Any remaining required business fact is unknown" phase="DESIGN_TIME" />
      <outcome xsi:type="kernel:Expression" id="e3766d1d-e810-58c2-b364-66d7106a95e3" name="outcome" sideEffectFree="false" language="NATURAL_LANGUAGE" body="NEEDS_INFO / MISSING_FACT" phase="DESIGN_TIME" />
    </rules>
    <rules xsi:type="policy:DecisionRule" id="ea119de3-8f27-5f26-8cb4-8ea1ec572d83" name="Inactive membership">
      <condition xsi:type="kernel:Expression" id="042ecf49-32e7-5427-92a7-b1a306e5fd8c" name="condition" sideEffectFree="false" language="NATURAL_LANGUAGE" body="membershipState = INACTIVE or validThrough &lt; requestedDate" phase="DESIGN_TIME" />
      <outcome xsi:type="kernel:Expression" id="a697b8f6-a4cc-5aa3-8b57-dcdaf16d44af" name="outcome" sideEffectFree="false" language="NATURAL_LANGUAGE" body="DENY / MEMBERSHIP_INACTIVE" phase="DESIGN_TIME" />
    </rules>
    <rules xsi:type="policy:DecisionRule" id="74fb4d80-3603-5fa2-9f2d-b6cf4ff83e28" name="Expired certification">
      <condition xsi:type="kernel:Expression" id="6afd9e7f-35a5-5155-b9e4-145956df3dee" name="condition" sideEffectFree="false" language="NATURAL_LANGUAGE" body="certificationValidThrough &lt; requestedDate" phase="DESIGN_TIME" />
      <outcome xsi:type="kernel:Expression" id="82ec6809-3556-5768-8b38-0a1e0d813c99" name="outcome" sideEffectFree="false" language="NATURAL_LANGUAGE" body="DENY / CERTIFICATION_EXPIRED" phase="DESIGN_TIME" />
    </rules>
    <rules xsi:type="policy:DecisionRule" id="089b09d9-8a63-5fbb-b8dd-ecbe8a098cec" name="Booking limit">
      <condition xsi:type="kernel:Expression" id="3cc59388-e5ff-5ce8-bd0e-f6a5b3ed6724" name="condition" sideEffectFree="false" language="NATURAL_LANGUAGE" body="activeBookings &gt;= 3" phase="DESIGN_TIME" />
      <outcome xsi:type="kernel:Expression" id="bedfbedb-bc41-5a26-a43d-69cc1d3f85be" name="outcome" sideEffectFree="false" language="NATURAL_LANGUAGE" body="WAITLIST / BOOKING_LIMIT" phase="DESIGN_TIME" />
    </rules>
    <rules xsi:type="policy:DecisionRule" id="721afc32-ab76-5197-b109-98fdbd80e203" name="Eligible default">
      <condition xsi:type="kernel:Expression" id="452bd6d9-67a3-5015-9b6f-427370217bcf" name="condition" sideEffectFree="false" language="NATURAL_LANGUAGE" body="Otherwise" phase="DESIGN_TIME" />
      <outcome xsi:type="kernel:Expression" id="d2849244-30ed-5a70-aa26-39e6faffccf8" name="outcome" sideEffectFree="false" language="NATURAL_LANGUAGE" body="ALLOW / ELIGIBLE" phase="DESIGN_TIME" />
    </rules>
  </decisionModels>
