  <businessRules xsi:type="policy:BusinessRule" id="79563c64-9aee-51b8-8c94-963a0920a86c" name="ColdChain Sentinel rule 2" naturalLanguageRule="Retain occurrence/receipt time and stable reading identity; duplicate/late arrivals follow a reviewed per-shipment sequencing policy." enforcedBy="01053d4c-f4ab-5630-baa7-7a75ac8e1f28 a2faf831-753d-5558-9200-81ff063f01d2 7fd258ab-b133-5d37-b802-d3a04900fc5f faeb6042-7587-5caa-8790-b65d910cf96a 54d9d8eb-f5ea-5b4a-ac72-cc18288adadc 56072a6d-fb7e-5e40-9bed-f82dd5fa5248 7eabc23f-a971-5780-a4bc-f28f71b9e6ec" />
  <businessRules xsi:type="policy:BusinessRule" id="518e5f9b-9da3-50a1-8e8d-fd4d4e7cc84c" name="ColdChain Sentinel rule 3" naturalLanguageRule="Correlate one alert identity with an excursion, record acknowledgement, and retry/escalate without duplicate delivery effects." enforcedBy="01053d4c-f4ab-5630-baa7-7a75ac8e1f28 a2faf831-753d-5558-9200-81ff063f01d2 7fd258ab-b133-5d37-b802-d3a04900fc5f faeb6042-7587-5caa-8790-b65d910cf96a 54d9d8eb-f5ea-5b4a-ac72-cc18288adadc 56072a6d-fb7e-5e40-9bed-f82dd5fa5248 7eabc23f-a971-5780-a4bc-f28f71b9e6ec" />
  <businessRules xsi:type="policy:BusinessRule" id="ae246a5e-6479-50be-8b1e-084dad0d68dc" name="ColdChain Sentinel rule 4" naturalLanguageRule="Retain versioned excursion evidence for review; ERP connectivity and provider-exit remain explicit human review decisions." enforcedBy="01053d4c-f4ab-5630-baa7-7a75ac8e1f28 a2faf831-753d-5558-9200-81ff063f01d2 7fd258ab-b133-5d37-b802-d3a04900fc5f faeb6042-7587-5caa-8790-b65d910cf96a 54d9d8eb-f5ea-5b4a-ac72-cc18288adadc 56072a6d-fb7e-5e40-9bed-f82dd5fa5248 7eabc23f-a971-5780-a4bc-f28f71b9e6ec" />
