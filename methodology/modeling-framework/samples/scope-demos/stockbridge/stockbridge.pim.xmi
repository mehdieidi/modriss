  <businessRules xsi:type="policy:BusinessRule" id="ec786fbd-3538-5d59-93ca-53ec345abf85" name="StockBridge rule 1" naturalLanguageRule="Map itemCode/availableQty/itemVersion deterministically to sku/stockAvailable/sourceVersion; quantities are nonnegative integers." enforcedBy="f9bba428-0a72-5d30-8439-e3bd88720001 e7536eac-53ff-5000-ae83-f7304d61680b 206d7f46-db53-562a-a9f0-15be6498dfae" />
  <businessRules xsi:type="policy:BusinessRule" id="a70ac9d3-9660-5d09-b81c-215aa7580a59" name="StockBridge rule 2" naturalLanguageRule="Newest full snapshot wins per SKU; older snapshots never revert destination stock." enforcedBy="f9bba428-0a72-5d30-8439-e3bd88720001 e7536eac-53ff-5000-ae83-f7304d61680b 206d7f46-db53-562a-a9f0-15be6498dfae" />
  <businessRules xsi:type="policy:BusinessRule" id="24eed762-a290-5d0d-bfdb-9281a8a3f4a8" name="StockBridge rule 3" naturalLanguageRule="Stable exchange ID and payload hash resolve timeout-after-commit; provider 429 is retriable, malformed contracts fail permanently." enforcedBy="f9bba428-0a72-5d30-8439-e3bd88720001 e7536eac-53ff-5000-ae83-f7304d61680b 206d7f46-db53-562a-a9f0-15be6498dfae" />
  <businessRules xsi:type="policy:BusinessRule" id="9b526a5d-ea6a-5289-a348-57bcef57fe30" name="StockBridge rule 4" naturalLanguageRule="Operator replay is authorized and audited; simulators use controlled study endpoints and credentials." enforcedBy="f9bba428-0a72-5d30-8439-e3bd88720001 e7536eac-53ff-5000-ae83-f7304d61680b 206d7f46-db53-562a-a9f0-15be6498dfae" />
