  <businessRules xsi:type="policy:BusinessRule" id="9765703c-939e-54a4-8dae-5d9b8f8773da" name="WorkspaceFlow rule 2" naturalLanguageRule="ValidateRequest -&gt; ALLOW/DENY -&gt; AllocateWorkspace -&gt; CreateManifest -&gt; five-second wait -&gt; VerifyWorkspace -&gt; READY/FAILED." enforcedBy="4120a3b3-ef10-5164-b4dd-0a686c07115c 2159bd98-93f0-5708-a15e-ab12039d53a1 dd5674fb-1b19-5fdb-8d2f-aebf9489ea79 c87d5e18-105b-5ebe-9ac6-ae7ec0daac55 2528aecc-18df-5e05-a974-33d25dac0892 754637fd-982c-509d-ae4a-dd9c7ea6bd23" />
  <businessRules xsi:type="policy:BusinessRule" id="08b7acb6-acff-53dd-aced-99d9642abbcc" name="WorkspaceFlow rule 3" naturalLanguageRule="Task results retain request identity at $.stepResults; evaluator tasks return explicit outcome envelopes and unknown values fail." enforcedBy="4120a3b3-ef10-5164-b4dd-0a686c07115c 2159bd98-93f0-5708-a15e-ab12039d53a1 dd5674fb-1b19-5fdb-8d2f-aebf9489ea79 c87d5e18-105b-5ebe-9ac6-ae7ec0daac55 2528aecc-18df-5e05-a974-33d25dac0892 754637fd-982c-509d-ae4a-dd9c7ea6bd23" />
  <businessRules xsi:type="policy:BusinessRule" id="5a487f9d-61fe-53fa-bebf-683de2f7b9d3" name="WorkspaceFlow rule 4" naturalLanguageRule="Stable task identities prevent duplicate workspace/manifest; failures remain visible for authorized recovery, without automatic compensation." enforcedBy="4120a3b3-ef10-5164-b4dd-0a686c07115c 2159bd98-93f0-5708-a15e-ab12039d53a1 dd5674fb-1b19-5fdb-8d2f-aebf9489ea79 c87d5e18-105b-5ebe-9ac6-ae7ec0daac55 2528aecc-18df-5e05-a974-33d25dac0892 754637fd-982c-509d-ae4a-dd9c7ea6bd23" />
