    <resources xsi:type="awspsmworkflow:StepFunctionStateMachine" id="e4240614-ded9-59aa-a86f-63d1e756ae57" name="Workspace provisioning" publishAlias="false" retainInProduction="false" productionCritical="false" importedResource="false" logicalId="ProvisioningWorkflow" stateMachineType="STANDARD" role="a622b0f3-3d24-5e31-98d7-ec8f294a1b73" definitionString="{&quot;StartAt&quot;:&quot;ValidateRequest&quot;,&quot;States&quot;:{&quot;ValidateRequest&quot;:{&quot;Type&quot;:&quot;Task&quot;,&quot;Resource&quot;:&quot;${ValidateRequestArn}&quot;,&quot;ResultPath&quot;:&quot;$.stepResults.validateRequest&quot;,&quot;Retry&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.TaskFailed&quot;],&quot;IntervalSeconds&quot;:2,&quot;MaxAttempts&quot;:3,&quot;BackoffRate&quot;:2}],&quot;Catch&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.ALL&quot;],&quot;Next&quot;:&quot;Fail&quot;}],&quot;Next&quot;:&quot;AllowOrDeny&quot;},&quot;AllowOrDeny&quot;:{&quot;Type&quot;:&quot;Choice&quot;,&quot;Choices&quot;:[{&quot;Variable&quot;:&quot;$.stepResults.validateRequest.outcome&quot;,&quot;StringEquals&quot;:&quot;ALLOW&quot;,&quot;Next&quot;:&quot;AllocateWorkspace&quot;}],&quot;Default&quot;:&quot;Fail&quot;},&quot;AllocateWorkspace&quot;:{&quot;Type&quot;:&quot;Task&quot;,&quot;Resource&quot;:&quot;${AllocateWorkspaceArn}&quot;,&quot;ResultPath&quot;:&quot;$.stepResults.allocateWorkspace&quot;,&quot;Retry&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.TaskFailed&quot;],&quot;IntervalSeconds&quot;:2,&quot;MaxAttempts&quot;:3,&quot;BackoffRate&quot;:2}],&quot;Catch&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.ALL&quot;],&quot;Next&quot;:&quot;Fail&quot;}],&quot;Next&quot;:&quot;CreateManifest&quot;},&quot;CreateManifest&quot;:{&quot;Type&quot;:&quot;Task&quot;,&quot;Resource&quot;:&quot;${CreateManifestArn}&quot;,&quot;ResultPath&quot;:&quot;$.stepResults.createManifest&quot;,&quot;Retry&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.TaskFailed&quot;],&quot;IntervalSeconds&quot;:2,&quot;MaxAttempts&quot;:3,&quot;BackoffRate&quot;:2}],&quot;Catch&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.ALL&quot;],&quot;Next&quot;:&quot;Fail&quot;}],&quot;Next&quot;:&quot;WaitForCheck&quot;},&quot;WaitForCheck&quot;:{&quot;Type&quot;:&quot;Wait&quot;,&quot;Seconds&quot;:5,&quot;Next&quot;:&quot;VerifyWorkspace&quot;},&quot;VerifyWorkspace&quot;:{&quot;Type&quot;:&quot;Task&quot;,&quot;Resource&quot;:&quot;${VerifyWorkspaceArn}&quot;,&quot;ResultPath&quot;:&quot;$.stepResults.verifyWorkspace&quot;,&quot;Retry&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.TaskFailed&quot;],&quot;IntervalSeconds&quot;:2,&quot;MaxAttempts&quot;:3,&quot;BackoffRate&quot;:2}],&quot;Catch&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.ALL&quot;],&quot;Next&quot;:&quot;Fail&quot;}],&quot;Next&quot;:&quot;ReadyOrFailed&quot;},&quot;ReadyOrFailed&quot;:{&quot;Type&quot;:&quot;Choice&quot;,&quot;Choices&quot;:[{&quot;Variable&quot;:&quot;$.stepResults.verifyWorkspace.outcome&quot;,&quot;StringEquals&quot;:&quot;READY&quot;,&quot;Next&quot;:&quot;Complete&quot;}],&quot;Default&quot;:&quot;Fail&quot;},&quot;Complete&quot;:{&quot;Type&quot;:&quot;Succeed&quot;},&quot;Fail&quot;:{&quot;Type&quot;:&quot;Fail&quot;}}}">
      <aslDocument xsi:type="awspsmworkflow:AslDocument" id="3f63ec16-f113-524b-876f-457ad6f128fb" name="Provisioning ASL" format="ASL_JSON" startAt="ValidateRequest">
