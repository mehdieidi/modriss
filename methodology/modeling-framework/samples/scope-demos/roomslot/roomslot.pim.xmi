  <businessRules xsi:type="policy:BusinessRule" id="4a09e7b4-8744-5421-b561-52f04953914e" name="RoomSlot rule 1" naturalLanguageRule="Slots are fixed 30-minute UTC units; slot allocation and reservation commit atomically." enforcedBy="8342ff01-ea94-5e60-89e1-83c484c2904a 74f139aa-aa0e-5e69-bb7b-e2b7136ddd4b a531c864-4a10-565f-9e10-d10380397112 a3029ecd-724d-5bfd-8b09-97b63c22cfa3 ff13d7bd-0965-5ccc-b317-2d3a6ba62d9b" />
  <businessRules xsi:type="policy:BusinessRule" id="64d50ede-72ef-57fe-8b58-002f3b784fd6" name="RoomSlot rule 2" naturalLanguageRule="A hold lasts five minutes; confirmation requires now &lt; expiresAt, and expiry wins at equality." enforcedBy="8342ff01-ea94-5e60-89e1-83c484c2904a 74f139aa-aa0e-5e69-bb7b-e2b7136ddd4b a531c864-4a10-565f-9e10-d10380397112 a3029ecd-724d-5bfd-8b09-97b63c22cfa3 ff13d7bd-0965-5ccc-b317-2d3a6ba62d9b" />
  <businessRules xsi:type="policy:BusinessRule" id="7a53c92b-3be2-5def-924a-a776b7b132c0" name="RoomSlot rule 3" naturalLanguageRule="Availability is advisory; allocation commands reread authoritative state. Staff close only unallocated slots." enforcedBy="8342ff01-ea94-5e60-89e1-83c484c2904a 74f139aa-aa0e-5e69-bb7b-e2b7136ddd4b a531c864-4a10-565f-9e10-d10380397112 a3029ecd-724d-5bfd-8b09-97b63c22cfa3 ff13d7bd-0965-5ccc-b317-2d3a6ba62d9b" />
