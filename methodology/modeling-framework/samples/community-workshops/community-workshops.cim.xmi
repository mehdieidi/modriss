  <commands id="cmd-close" name="Close ended workshop" description="At or after end, passage of time shall close each still-PUBLISHED workshop: CONFIRMED becomes NO_SHOW, WAITLISTED becomes EXPIRED, ATTENDED remains unchanged, and the workshop becomes COMPLETED. Freeze anonymous attended, no-show, and expired totals. CANCELLED workshops are not completed. Repeated closure is a no-op." sourceReference="README.md" xsi:type="cimbehavior:Command" intent="Close ended workshop" issuedBy="actor-time" targetCapability="cap-booking" targetAggregate="agg-booking" input="info-workshop-id" preconditions="cond-ended" expectedEvents="evt-closed" possibleErrors="err-state err-access" authorizationRequired="true" authorizationRule="Only a trusted service identity may close due workshops." userInitiated="false" duplicateSubmissionPossible="true" idempotencyBusinessKey="workshop identifier + closure" auditRequired="true" commandType="POLICY_TRIGGERED_INTENT" interactionExpectation="BACK_OFFICE_PROCESSING" priority="HIGH" generatedByTransformation="false" manuallyMaintained="false">
