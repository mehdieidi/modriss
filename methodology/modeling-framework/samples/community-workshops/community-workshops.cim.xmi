  </commands>
  <commands id="cmd-dispatch" name="Dispatch eligible notice" description="A failed or timed-out delivery shall retry at least one minute after attempt one and at least five minutes after attempt two, with each eligible retry starting within 60 seconds. Allow three total attempts. Exhaustion becomes FAILED and appears to organizers. Recheck relevance before every attempt. Use the same notice identifier as provider deduplication key, including timeout retries; the test provider supports that key. Concurrent dispatches must not create extra attempts. A processed provider failure is an accepted command outcome that records a failed attempt, not an allocation rollback. Suppressed notices make no provider call." sourceReference="README.md" xsi:type="cimbehavior:Command" intent="Dispatch eligible notice" issuedBy="actor-time" targetCapability="cap-notices" targetAggregate="agg-notice" input="info-notice-id" preconditions="cond-retry" expectedEvents="evt-notice-accepted evt-notice-failed evt-notice-suppressed" possibleErrors="err-delivery err-state err-access" authorizationRequired="true" authorizationRule="Only trusted communication processing may dispatch an eligible notice." userInitiated="false" duplicateSubmissionPossible="true" idempotencyBusinessKey="notice identifier + attempt ordinal; provider key = notice identifier" auditRequired="true" commandType="POLICY_TRIGGERED_INTENT" interactionExpectation="BACK_OFFICE_PROCESSING" priority="HIGH" generatedByTransformation="false" manuallyMaintained="false">
    <outcomes id="cmd-dispatch-success" name="Dispatch eligible notice accepted" description="Successful mutation commits its eligible facts; an exact replay returns the original outcome with no new facts." sourceReference="requirements.md" xsi:type="cimbehavior:CommandOutcome" success="true" resultDescription="Attempt processed: record provider acceptance, suppression, or a failed/timed-out attempt with retry/exhaustion state. Provider failure does not reverse any booking." emittedEvents="evt-notice-accepted evt-notice-failed evt-notice-suppressed" output="" errors="err-delivery" generatedByTransformation="false" manuallyMaintained="false" />
    <outcomes id="cmd-dispatch-rejected" name="Dispatch eligible notice rejected" description="An ineligible business request returns one matching business error without mutation." sourceReference="requirements.md" xsi:type="cimbehavior:CommandOutcome" success="false" resultDescription="No business state mutation for invalid inputs, permissions, operation key, time, or state." errors="err-state err-access" generatedByTransformation="false" manuallyMaintained="false" />
  </commands>
  <commands id="cmd-purge" name="Remove expired personal records" description="Collect only verified participant identifier, display name, email, and booking history needed to run the workshop. At end plus 30 days (also for cancelled workshops), remove identifying registrations, notices, audit details, and related idempotency records within 24 hours. Retain workshop details and anonymous totals only; retained totals must contain no person or registration identifiers. Do not copy personal data into operational logs or durable event archives beyond this retention boundary." sourceReference="README.md" xsi:type="cimbehavior:Command" intent="Remove expired personal records" issuedBy="actor-time" targetCapability="cap-booking" targetAggregate="agg-booking" input="info-workshop-id" preconditions="cond-retention" expectedEvents="evt-purged" possibleErrors="err-state err-access" authorizationRequired="true" authorizationRule="Only a trusted retention service identity may remove expired personal records." userInitiated="false" duplicateSubmissionPossible="true" idempotencyBusinessKey="workshop identifier + retention-cleanup" auditRequired="true" commandType="POLICY_TRIGGERED_INTENT" interactionExpectation="BACK_OFFICE_PROCESSING" priority="HIGH" generatedByTransformation="false" manuallyMaintained="false">
