  <commands id="cmd-cancel" name="Cancel registration" description="A participant shall cancel their own CONFIRMED or WAITLISTED registration strictly before cutoff. Cancellation of a confirmed seat and promotion of the oldest waiting registration shall be one indivisible business change. Cancelling a waiting entry releases no seat. Cancelling an already CANCELLED registration is a no-op, including after cutoff. A different active registration is never cancelled by replay." sourceReference="README.md" xsi:type="cimbehavior:Command" intent="Cancel registration" issuedBy="actor-participant" targetCapability="cap-booking" targetAggregate="agg-booking" input="info-registration-id info-operation-key" preconditions="cond-booking-open" expectedEvents="evt-cancelled evt-promoted" possibleErrors="err-closed err-state err-access err-key" authorizationRequired="true" authorizationRule="Verified participant may cancel only their own registration." userInitiated="true" duplicateSubmissionPossible="true" idempotencyBusinessKey="actor identifier + cancel-registration + client request identifier" auditRequired="true" commandType="USER_INTENT" interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" priority="HIGH" generatedByTransformation="false" manuallyMaintained="false">
