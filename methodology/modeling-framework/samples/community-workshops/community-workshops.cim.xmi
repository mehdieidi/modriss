  <commands id="cmd-cancel-workshop" name="Cancel workshop" description="An organizer shall cancel a PUBLISHED workshop only before start. The workshop and all CONFIRMED or WAITLISTED registrations become CANCELLED atomically, no waiting participant is promoted, and each affected participant receives one workshop-cancellation notice. Repeating cancellation is a no-op. Unsent reminders and obsolete confirmation notices are suppressed." sourceReference="README.md" xsi:type="cimbehavior:Command" intent="Cancel workshop" issuedBy="actor-organizer" targetCapability="cap-booking" targetAggregate="agg-booking" input="info-workshop-id info-operation-key" preconditions="cond-cancelable" expectedEvents="evt-workshop-cancelled" possibleErrors="err-state err-access err-key" authorizationRequired="true" authorizationRule="Only centre organizers may cancel a workshop." userInitiated="true" duplicateSubmissionPossible="true" idempotencyBusinessKey="actor identifier + cancel-workshop + client request identifier" auditRequired="true" commandType="USER_INTENT" interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" priority="HIGH" generatedByTransformation="false" manuallyMaintained="false">
