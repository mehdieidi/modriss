  </commands>
  <commands id="cmd-remind" name="Request due reminders" description="During [start minus 24 hours, cutoff), due checks shall request at most one reminder per currently CONFIRMED registration, within 60 seconds of becoming eligible. A participant confirmed later in that window is included by the next check. WAITLISTED and cancelled registrations receive no reminder. A missed window is not replayed after cutoff." sourceReference="README.md" xsi:type="cimbehavior:Command" intent="Request due reminders" issuedBy="actor-time" targetCapability="cap-booking" targetAggregate="agg-booking" input="info-workshop-id" preconditions="cond-reminder" expectedEvents="evt-reminder" possibleErrors="err-state err-access" authorizationRequired="true" authorizationRule="Only a trusted service identity may request due reminders." userInitiated="false" duplicateSubmissionPossible="true" idempotencyBusinessKey="registration identifier + reminder" auditRequired="true" commandType="POLICY_TRIGGERED_INTENT" interactionExpectation="BACK_OFFICE_PROCESSING" priority="HIGH" generatedByTransformation="false" manuallyMaintained="false">
