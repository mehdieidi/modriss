  <commands id="cmd-attend" name="Record attendance" description="During [start, end), an organizer shall mark a CONFIRMED registration ATTENDED. Repeating the same attendance mark is a no-op. WAITLISTED, CANCELLED, EXPIRED, and NO_SHOW registrations cannot attend; no mark can be introduced before start or at/after end." sourceReference="README.md" xsi:type="cimbehavior:Command" intent="Record attendance" issuedBy="actor-organizer" targetCapability="cap-booking" targetAggregate="agg-booking" input="info-registration-id info-operation-key" preconditions="cond-attendance" expectedEvents="evt-attended" possibleErrors="err-state err-access err-key" authorizationRequired="true" authorizationRule="Only centre organizers may mark workshop attendance." userInitiated="true" duplicateSubmissionPossible="true" idempotencyBusinessKey="actor identifier + record-attendance + client request identifier" auditRequired="true" commandType="USER_INTENT" interactionExpectation="IMMEDIATE_RESPONSE_EXPECTED" priority="HIGH" generatedByTransformation="false" manuallyMaintained="false">
