  <requirements id="R21" name="Make outcomes understandable" description="For each seat request or cancellation, show the resulting status or a plain-language business error, workshop name, local start and cutoff times with timezone, and current waiting position when applicable. Clearly state that waiting is not a confirmed seat and that joining consents to automatic promotion. The own-bookings view remains the authoritative status when email is delayed." sourceReference="requirements.md#r21" xsi:type="cimgov:NonFunctionalRequirement" requirementType="QUALITY" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="A first-time participant can find the workshop, request a seat, correctly distinguish confirmed from waiting, and find the cancellation cutoff in at most five minutes without moderator instruction; record success and misunderstandings in the pilot." supportsGoals="goal-fair goal-clear" constrains="qry-browse qry-mine cmd-request cmd-cancel" qualityType="USABILITY" metric="Make outcomes understandable" target="A first-time participant can find the workshop, request a seat, correctly distinguish confirmed from waiting, and find the cancellation cutoff in at most five minutes without moderator instruction; record success and misunderstandings in the pilot." measurementMethod="Execute the given/when/then acceptance criterion and the linked evaluation scenarios." environmentAssumption="Fictional single-centre evaluation baseline; controlled identities, clock, and delivery test double." constrainedElements="qry-browse qry-mine cmd-request cmd-cancel" generatedByTransformation="false" manuallyMaintained="false">
