<?xml version='1.0' encoding='UTF-8'?>
<cim:CIMModel xmlns:cim="https://modriss.org/cim/1.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" id="cw-cim" name="Community Workshops" description="Free community workshop booking, fair seat allocation, essential notices, attendance, and limited retention. Fictional evaluation baseline." sourceReference="README.md" domainName="Free community workshop bookings" organizationName="Neighbourhood Community Centre (fictional)" businessScope="One centre; one seat per participant per workshop; capacities 1-30 and waiting lists up to ten; no payments, account administration, recurring workshops, or inventory." language="en" modelingDate="2026-10-18T00:00:00.000+0000" lifecycleStatus="DRAFT" xmlns:cimorg="https://modriss.org/cim/organization/1.0" xmlns:cimdomain="https://modriss.org/cim/domain-data/1.0" xmlns:cimbehavior="https://modriss.org/cim/behavior/1.0" xmlns:cimprocess="https://modriss.org/cim/process-policy/1.0" xmlns:cimgov="https://modriss.org/cim/governance/1.0" xmlns:cimtransform="https://modriss.org/cim/transformation/1.0" xmlns:kernel="https://modriss.org/kernel/1.0" generatedByTransformation="false" manuallyMaintained="false">
  <requirements id="R01" name="Publish a workshop" description="An organizer shall publish an immutable workshop with a title (1-80 characters), venue (1-120), start, end, and capacity (integer 1-30). Start must be at least 26 hours after publication, and end must be after start. The booking cutoff is start minus two hours." sourceReference="requirements.md#r01" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Valid publication produces PUBLISHED; missing fields, invalid capacity, reversed times, or a start less than 26 hours away produce INVALID_WORKSHOP and no workshop." supportsGoals="goal-fair goal-clear" constrains="cmd-publish ent-workshop" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R01-ac" name="Publish a workshop acceptance" description="one PUBLISHED workshop is visible with the submitted details and derived cutoff" sourceReference="requirements.md#r01" xsi:type="cimorg:AcceptanceCriterion" givenContext="An organizer and a complete workshop starting in 48 hours" whenAction="the organizer publishes it" thenOutcome="one PUBLISHED workshop is visible with the submitted details and derived cutoff" measurableTarget="Valid publication produces PUBLISHED; missing fields, invalid capacity, reversed times, or a start less than 26 hours away produce INVALID_WORKSHOP and no workshop." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R02" name="Browse upcoming workshops" description="Anyone may browse PUBLISHED workshops whose start is in the future, ordered by start then workshop identifier, with title, venue, times, cutoff, capacity, available seats, waiting count, and booking-open indicator. Show no participant data. Availability is advisory until a seat request commits." sourceReference="requirements.md#r02" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Return only upcoming PUBLISHED workshops, 20 per page, with stable continuation; cancelled and completed workshops are absent." supportsGoals="goal-fair goal-clear" constrains="qry-browse ent-workshop" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R02-ac" name="Browse upcoming workshops acceptance" description="only future PUBLISHED workshops appear and no participant identifiers or email addresses appear" sourceReference="requirements.md#r02" xsi:type="cimorg:AcceptanceCriterion" givenContext="published, cancelled, completed, and past workshops" whenAction="a visitor browses the catalogue" thenOutcome="only future PUBLISHED workshops appear and no participant identifiers or email addresses appear" measurableTarget="Return only upcoming PUBLISHED workshops, 20 per page, with stable continuation; cancelled and completed workshops are absent." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R03" name="Request one seat" description="An identified participant shall request one seat for themselves while the workshop is PUBLISHED and now is strictly before the cutoff. A free seat yields CONFIRMED immediately. At most one active registration (CONFIRMED or WAITLISTED) may exist per participant and workshop. A cancelled participant may submit a new request and gets a new registration." sourceReference="requirements.md#r03" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="A valid request returns one registration and explicit CONFIRMED or WAITLISTED status. A second independent request while active returns ALREADY_REGISTERED; closed booking returns BOOKING_CLOSED without mutation." supportsGoals="goal-fair goal-clear" constrains="cmd-request ent-registration" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R03-ac" name="Request one seat acceptance" description="one CONFIRMED registration exists and available seats decrease by one" sourceReference="requirements.md#r03" xsi:type="cimorg:AcceptanceCriterion" givenContext="one remaining seat and an eligible participant" whenAction="the participant requests a seat before cutoff" thenOutcome="one CONFIRMED registration exists and available seats decrease by one" measurableTarget="A valid request returns one registration and explicit CONFIRMED or WAITLISTED status. A second independent request while active returns ALREADY_REGISTERED; closed booking returns BOOKING_CLOSED without mutation." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R04" name="Join and order the waiting list" description="When no seat is available, a seat request shall create WAITLISTED only if fewer than ten entries are waiting. The participant must explicitly accept automatic promotion before cutoff. Priority is committed join time then registration identifier; a new request after cancellation goes to the tail. No consent produces WAITLIST_CONSENT_REQUIRED; a full list produces WAITLIST_FULL." sourceReference="requirements.md#r04" xsi:type="cimorg:Requirement" requirementType="BUSINESS_RULE" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="An eleventh waiting request is rejected without mutation; equal join timestamps are ordered by registration identifier; waiting position is 1-based among current waiting entries." supportsGoals="goal-fair goal-clear" constrains="cmd-request pol-allocation dt-allocation" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R04-ac" name="Join and order the waiting list acceptance" description="the first becomes tenth on the waiting list and the second gets WAITLIST_FULL" sourceReference="requirements.md#r04" xsi:type="cimorg:AcceptanceCriterion" givenContext="a full workshop, nine waiting participants, and explicit promotion consent" whenAction="two different participants request seats in sequence" thenOutcome="the first becomes tenth on the waiting list and the second gets WAITLIST_FULL" measurableTarget="An eleventh waiting request is rejected without mutation; equal join timestamps are ordered by registration identifier; waiting position is 1-based among current waiting entries." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R05" name="Cancel and promote fairly" description="A participant shall cancel their own CONFIRMED or WAITLISTED registration strictly before cutoff. Cancellation of a confirmed seat and promotion of the oldest waiting registration shall be one indivisible business change. Cancelling a waiting entry releases no seat. Cancelling an already CANCELLED registration is a no-op, including after cutoff. A different active registration is never cancelled by replay." sourceReference="requirements.md#r05" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="One confirmed cancellation with a nonempty list yields CANCELLED for the caller and CONFIRMED for the oldest waiting participant; no vacancy is exposed between those changes. At cutoff an active cancellation returns BOOKING_CLOSED." supportsGoals="goal-fair goal-clear" constrains="cmd-cancel pol-promotion agg-booking" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R05-ac" name="Cancel and promote fairly acceptance" description="Alice is CANCELLED, Cara is CONFIRMED, Dev is first waiting, and occupancy is unchanged" sourceReference="requirements.md#r05" xsi:type="cimorg:AcceptanceCriterion" givenContext="a confirmed Alice, waitlisted Cara then Dev, and time before cutoff" whenAction="Alice cancels" thenOutcome="Alice is CANCELLED, Cara is CONFIRMED, Dev is first waiting, and occupancy is unchanged" measurableTarget="One confirmed cancellation with a nonempty list yields CANCELLED for the caller and CONFIRMED for the oldest waiting participant; no vacancy is exposed between those changes. At cutoff an active cancellation returns BOOKING_CLOSED." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R06" name="Cancel a workshop" description="An organizer shall cancel a PUBLISHED workshop only before start. The workshop and all CONFIRMED or WAITLISTED registrations become CANCELLED atomically, no waiting participant is promoted, and each affected participant receives one workshop-cancellation notice. Repeating cancellation is a no-op. Unsent reminders and obsolete confirmation notices are suppressed." sourceReference="requirements.md#r06" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="All active registrations are cancelled; occupancy and waiting count are zero; no promotion event occurs. At or after start a new cancellation returns INVALID_STATE." supportsGoals="goal-fair goal-clear" constrains="cmd-cancel-workshop pol-cancel-workshop" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R06-ac" name="Cancel a workshop acceptance" description="the workshop and active registrations are CANCELLED, only cancellation notices remain eligible, and the workshop disappears from browse results" sourceReference="requirements.md#r06" xsi:type="cimorg:AcceptanceCriterion" givenContext="a published workshop with confirmed and waiting participants" whenAction="an organizer cancels before start" thenOutcome="the workshop and active registrations are CANCELLED, only cancellation notices remain eligible, and the workshop disappears from browse results" measurableTarget="All active registrations are cancelled; occupancy and waiting count are zero; no promotion event occurs. At or after start a new cancellation returns INVALID_STATE." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R07" name="View my bookings" description="An identified participant shall view only their own retained registrations, including workshop details, current status, and current waiting position where applicable; newest join time first, 20 per page. A participant cannot obtain another participant's booking through a changed identifier or filter." sourceReference="requirements.md#r07" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="A read after an acknowledged booking or cancellation reflects the committed state; another participant's details never appear." supportsGoals="goal-fair goal-clear" constrains="qry-mine ent-registration" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R07-ac" name="View my bookings acceptance" description="Cara sees CONFIRMED and no waiting position; Ben's booking is absent" sourceReference="requirements.md#r07" xsi:type="cimorg:AcceptanceCriterion" givenContext="Cara has just been promoted and Ben also has a booking" whenAction="Cara views her bookings" thenOutcome="Cara sees CONFIRMED and no waiting position; Ben's booking is absent" measurableTarget="A read after an acknowledged booking or cancellation reflects the committed state; another participant's details never appear." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R08" name="View roster and delivery failures" description="An organizer shall view a workshop roster with display name, participant identifier, status, waiting position, and attendance summary, and a separate list of notices that exhausted delivery attempts. Results are current after acknowledged changes, 20 per page, filterable by workshop and status. Participants have no access." sourceReference="requirements.md#r08" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Roster totals match authoritative registrations; failed notices show workshop, recipient, notice kind, attempt count, and last failure time without exposing message content in operational logs." supportsGoals="goal-fair goal-clear" constrains="qry-roster qry-failures" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R08-ac" name="View roster and delivery failures acceptance" description="counts match active records and the failed notice is visible with three attempts" sourceReference="requirements.md#r08" xsi:type="cimorg:AcceptanceCriterion" givenContext="a workshop with confirmed, waiting, and cancelled registrations and an exhausted notice" whenAction="an organizer reads its roster and failed deliveries" thenOutcome="counts match active records and the failed notice is visible with three attempts" measurableTarget="Roster totals match authoritative registrations; failed notices show workshop, recipient, notice kind, attempt count, and last failure time without exposing message content in operational logs." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R09" name="Record attendance" description="During [start, end), an organizer shall mark a CONFIRMED registration ATTENDED. Repeating the same attendance mark is a no-op. WAITLISTED, CANCELLED, EXPIRED, and NO_SHOW registrations cannot attend; no mark can be introduced before start or at/after end." sourceReference="requirements.md#r09" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Only CONFIRMED to ATTENDED is accepted in the attendance window; invalid marks produce INVALID_STATE and no state change." supportsGoals="goal-fair goal-clear" constrains="cmd-attend ent-registration" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R09-ac" name="Record attendance acceptance" description="Ben is ATTENDED once and the attendance total increases by exactly one" sourceReference="requirements.md#r09" xsi:type="cimorg:AcceptanceCriterion" givenContext="a confirmed Ben at the workshop start instant" whenAction="the organizer records Ben's attendance twice" thenOutcome="Ben is ATTENDED once and the attendance total increases by exactly one" measurableTarget="Only CONFIRMED to ATTENDED is accepted in the attendance window; invalid marks produce INVALID_STATE and no state change." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R10" name="Close workshops and classify absences" description="At or after end, passage of time shall close each still-PUBLISHED workshop: CONFIRMED becomes NO_SHOW, WAITLISTED becomes EXPIRED, ATTENDED remains unchanged, and the workshop becomes COMPLETED. Freeze anonymous attended, no-show, and expired totals. CANCELLED workshops are not completed. Repeated closure is a no-op." sourceReference="requirements.md#r10" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Before end closure is rejected; within 60 seconds after end an eligible workshop is COMPLETED with accurate totals, independent of notice delivery." supportsGoals="goal-fair goal-clear" constrains="cmd-close pol-close" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R10-ac" name="Close workshops and classify absences acceptance" description="the workshop is COMPLETED with one attended, one no-show, and one expired; totals do not change on replay" sourceReference="requirements.md#r10" xsi:type="cimorg:AcceptanceCriterion" givenContext="an ended workshop with one ATTENDED, one CONFIRMED, and one WAITLISTED registration" whenAction="the due closure runs twice" thenOutcome="the workshop is COMPLETED with one attended, one no-show, and one expired; totals do not change on replay" measurableTarget="Before end closure is rejected; within 60 seconds after end an eligible workshop is COMPLETED with accurate totals, independent of notice delivery." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R11" name="Request due reminders" description="During [start minus 24 hours, cutoff), due checks shall request at most one reminder per currently CONFIRMED registration, within 60 seconds of becoming eligible. A participant confirmed later in that window is included by the next check. WAITLISTED and cancelled registrations receive no reminder. A missed window is not replayed after cutoff." sourceReference="requirements.md#r11" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Repeated due checks create one reminder intent per registration; newly promoted participants in the window become eligible; no new reminder is requested at cutoff." supportsGoals="goal-fair goal-clear" constrains="cmd-remind pol-remind" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R11-ac" name="Request due reminders acceptance" description="one reminder is requested for the confirmed participant and none for the waiting participant" sourceReference="requirements.md#r11" xsi:type="cimorg:AcceptanceCriterion" givenContext="a confirmed and a waiting registration at start minus 24 hours" whenAction="two due checks execute" thenOutcome="one reminder is requested for the confirmed participant and none for the waiting participant" measurableTarget="Repeated due checks create one reminder intent per registration; newly promoted participants in the window become eligible; no new reminder is requested at cutoff." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R12" name="Prepare and deliver essential notices" description="Committed confirmation, waiting assignment, registration cancellation, promotion, workshop cancellation, and reminder facts shall each yield one durable notice intent per affected registration and kind. Notice content includes workshop title, venue, start with timezone, cutoff where relevant, and resulting booking status. Dispatch rechecks current state and suppresses obsolete waiting, confirmation, promotion, or reminder notices. Terminal registration/workshop cancellation notices may still be delivered. Provider acceptance means accepted by the provider, not inbox receipt." sourceReference="requirements.md#r12" xsi:type="cimorg:Requirement" requirementType="FUNCTIONAL" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Duplicate facts create no duplicate intents; provider acceptance records ACCEPTED, permanent suppression records SUPPRESSED. Workshop cancellation supersedes all unsent booking/reminder notices. A reminder at/after start is obsolete." supportsGoals="goal-fair goal-clear" constrains="cmd-prepare cmd-dispatch ent-notice pol-notice" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R12-ac" name="Prepare and deliver essential notices acceptance" description="one notice exists with one provider acceptance; the booking remains unchanged" sourceReference="requirements.md#r12" xsi:type="cimorg:AcceptanceCriterion" givenContext="a CONFIRMED fact is redelivered and its resulting notice is pending" whenAction="the preparation process runs twice and then delivery succeeds" thenOutcome="one notice exists with one provider acceptance; the booking remains unchanged" measurableTarget="Duplicate facts create no duplicate intents; provider acceptance records ACCEPTED, permanent suppression records SUPPRESSED. Workshop cancellation supersedes all unsent booking/reminder notices. A reminder at/after start is obsolete." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R13" name="Retry delivery without changing bookings" description="A failed or timed-out delivery shall retry at least one minute after attempt one and at least five minutes after attempt two, with each eligible retry starting within 60 seconds. Allow three total attempts. Exhaustion becomes FAILED and appears to organizers. Recheck relevance before every attempt. Use the same notice identifier as provider deduplication key, including timeout retries; the test provider supports that key. Concurrent dispatches must not create extra attempts." sourceReference="requirements.md#r13" xsi:type="cimorg:Requirement" requirementType="BUSINESS_RULE" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Simulated failure, failure, success yields three attempts and ACCEPTED; three failures yield FAILED with no fourth attempt. Seat allocation and waiting order never change. An ambiguous timeout must reuse the same provider key." supportsGoals="goal-fair goal-clear" constrains="cmd-dispatch pol-retry ent-notice" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R13-ac" name="Retry delivery without changing bookings acceptance" description="attempt times respect the delays, attempt count is three, and the final state is ACCEPTED with unchanged registration state" sourceReference="requirements.md#r13" xsi:type="cimorg:AcceptanceCriterion" givenContext="a still-relevant notice and a provider failing the first two calls" whenAction="the first attempt and both eligible retries run" thenOutcome="attempt times respect the delays, attempt count is three, and the final state is ACCEPTED with unchanged registration state" measurableTarget="Simulated failure, failure, success yields three attempts and ACCEPTED; three failures yield FAILED with no fourth attempt. Seat allocation and waiting order never change. An ambiguous timeout must reuse the same provider key." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R14" name="Limit personal data and retention" description="Collect only verified participant identifier, display name, email, and booking history needed to run the workshop. At end plus 30 days (also for cancelled workshops), remove identifying registrations, notices, audit details, and related idempotency records within 24 hours. Retain workshop details and anonymous totals only; retained totals must contain no person or registration identifiers. Do not copy personal data into operational logs or durable event archives beyond this retention boundary." sourceReference="requirements.md#r14" xsi:type="cimgov:PrivacyConstraint" requirementType="PRIVACY" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="After retention cleanup no participant, email, registration, notice-recipient, request key, or identifying audit/event record remains for the workshop; anonymous totals are unchanged." supportsGoals="goal-fair goal-clear" constrains="cmd-purge pol-retention ent-registration ent-notice" qualityType="PRIVACY" metric="Limit personal data and retention" target="After retention cleanup no participant, email, registration, notice-recipient, request key, or identifying audit/event record remains for the workshop; anonymous totals are unchanged." measurementMethod="Execute the given/when/then acceptance criterion and the linked evaluation scenarios." environmentAssumption="Fictional single-centre evaluation baseline; controlled identities, clock, and delivery test double." constrainedElements="cmd-purge pol-retention ent-registration ent-notice" deletionRequired="true" consentRequired="false" portabilityRequired="false" rectificationRequired="false" dataResidencyRequired="false" crossBorderTransferAllowed="false" purpose="Arrange free workshop bookings, essential notices, and short-lived attendance accountability." legalBasis="CONTRACT" retentionPeriod="Workshop end plus 30 days; erase within the next 24 hours, including cancelled workshops." minimizationRule="Keep only participant identity, display name, email and essential history; after cleanup keep anonymous workshop totals only." dataSubjectType="Workshop participants and actors identified in audit records" dataSubjects="actor-participant actor-organizer" jurisdiction="Fictional evaluation centre; deployment-specific legal review is required." law="Evaluation retention policy; no jurisdiction-specific legal compliance is asserted." dataItems="info-affected-registrations info-registration-id info-participant-id info-display-name info-email info-registration-status info-joined info-position info-consent info-reminder-requested info-operation-key info-actor-id info-fact-id info-previous-state info-next-state info-notice-id info-notice-kind info-notice-content info-notice-status info-attempts info-last-attempt info-next-attempt info-delivery-key info-roster info-booking-view info-audit audit-operationKey audit-actor audit-workshop audit-registration audit-occurredAt audit-before audit-after" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R14-ac" name="Limit personal data and retention acceptance" description="all scoped identifying records are removed once and anonymous totals remain intact" sourceReference="requirements.md#r14" xsi:type="cimorg:AcceptanceCriterion" givenContext="a completed workshop at end plus 30 days with identifying notices and audit records" whenAction="the retention cleanup runs and is repeated" thenOutcome="all scoped identifying records are removed once and anonymous totals remain intact" measurableTarget="After retention cleanup no participant, email, registration, notice-recipient, request key, or identifying audit/event record remains for the workshop; anonymous totals are unchanged." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R14-scenario" name="Limit personal data and retention quality scenario" description="After retention cleanup no participant, email, registration, notice-recipient, request key, or identifying audit/event record remains for the workshop; anonymous totals are unchanged." sourceReference="requirements.md#r14" xsi:type="cimgov:QualityScenario" qualityType="PRIVACY" source="Participant or authorized evaluation operator" stimulus="the retention cleanup runs and is repeated" environment="a completed workshop at end plus 30 days with identifying notices and audit records" artifact="Community Workshops service and retained business records" response="all scoped identifying records are removed once and anonymous totals remain intact" responseMeasure="After retention cleanup no participant, email, registration, notice-recipient, request key, or identifying audit/event record remains for the workshop; anonymous totals are unchanged." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R15" name="Protect seat and waiting invariants" description="Each workshop is an independent strong consistency boundary. Confirmed plus attended registrations never exceed capacity. Current waiting entries never exceed ten. Allocation, cancellation/promotion, and workshop-wide cancellation preserve these invariants even when requests are simultaneous. A waiting participant cannot be bypassed by a newcomer for a released seat. Requests for different workshops do not need a shared business transaction." sourceReference="requirements.md#r15" xsi:type="cimorg:Requirement" requirementType="BUSINESS_RULE" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Ten distinct participants race for one remaining seat: exactly one is confirmed, nine wait if room exists, occupancy equals capacity, and all active participant/workshop pairs are unique." supportsGoals="goal-fair goal-clear" constrains="agg-booking cmd-request cmd-cancel cmd-cancel-workshop" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R15-ac" name="Protect seat and waiting invariants acceptance" description="one becomes CONFIRMED and nine become WAITLISTED; no capacity or uniqueness invariant is violated" sourceReference="requirements.md#r15" xsi:type="cimorg:AcceptanceCriterion" givenContext="one remaining seat, an empty waiting list, and ten distinct participants" whenAction="all ten request seats concurrently" thenOutcome="one becomes CONFIRMED and nine become WAITLISTED; no capacity or uniqueness invariant is violated" measurableTarget="Ten distinct participants race for one remaining seat: exactly one is confirmed, nine wait if room exists, occupancy equals capacity, and all active participant/workshop pairs are unique." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R16" name="Handle duplicate operations" description="Every mutation shall carry a stable business operation key. A participant/organizer request is identified by actor identifier, command kind, and client request identifier; replay with the same payload returns the original outcome and creates no further effects. Reuse with different payload is rejected as REQUEST_KEY_REUSED. Internal keys identify the workshop closure, registration reminder, event/recipient/kind notice intent, notice attempt ordinal, or workshop retention run. After personal cleanup, retained identities cannot be replayed into a past workshop." sourceReference="requirements.md#r16" xsi:type="cimorg:Requirement" requirementType="BUSINESS_RULE" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Exact replay creates no duplicate registration, promotion, audit state change, reminder, or notice; key/payload mismatch has no mutation. Retries share the provider notice key but have distinct attempt ordinals." supportsGoals="goal-fair goal-clear" constrains="cmd-request cmd-cancel cmd-dispatch" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R16-ac" name="Handle duplicate operations acceptance" description="the replay returns the original outcome with no side effects and changed payload yields REQUEST_KEY_REUSED" sourceReference="requirements.md#r16" xsi:type="cimorg:AcceptanceCriterion" givenContext="a successful seat request and its original business operation key" whenAction="the same request is replayed, followed by a changed-payload request using that key" thenOutcome="the replay returns the original outcome with no side effects and changed payload yields REQUEST_KEY_REUSED" measurableTarget="Exact replay creates no duplicate registration, promotion, audit state change, reminder, or notice; key/payload mismatch has no mutation. Retries share the provider notice key but have distinct attempt ordinals." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R17" name="Enforce business permissions" description="Only verified participants may mutate or read their own bookings. Only centre organizers may publish, cancel workshops, see rosters/failures, or record attendance. Time- and policy-initiated operations require a trusted service identity. The email provider may receive intended notices but may not issue booking mutations. Unauthorized requests return an access error without exposing another person's data or changing any state." sourceReference="requirements.md#r17" xsi:type="cimgov:SecurityConstraint" requirementType="SECURITY" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Anonymous mutation, participant roster read, and cross-participant cancellation all fail; authorized equivalents succeed; no unauthorized effect or personal-data response occurs." supportsGoals="goal-fair goal-clear" constrains="actor-participant actor-organizer cmd-request cmd-cancel qry-mine qry-roster qry-failures" qualityType="SECURITY" metric="Enforce business permissions" target="Anonymous mutation, participant roster read, and cross-participant cancellation all fail; authorized equivalents succeed; no unauthorized effect or personal-data response occurs." measurementMethod="Execute the given/when/then acceptance criterion and the linked evaluation scenarios." environmentAssumption="Fictional single-centre evaluation baseline; controlled identities, clock, and delivery test double." constrainedElements="actor-participant actor-organizer cmd-request cmd-cancel qry-mine qry-roster qry-failures" authenticationNeed="Verified participant identity or centre-issued organizer/service identity." authorizationRule="Participants act only for themselves; organizers administer centre workshops; trusted service identities perform due and policy operations." threatRationale="Prevent impersonation, cross-person access, and unauthorized capacity changes." constrainedActors="actor-participant actor-organizer" constrainedCommands="cmd-request cmd-cancel" constrainedQueries="qry-mine qry-roster qry-failures" generatedByTransformation="false" manuallyMaintained="false" segregationOfDutiesRequired="false" nonRepudiationRequired="false" auditAccessRequired="false">
    <acceptanceCriteria id="R17-ac" name="Enforce business permissions acceptance" description="both are denied without state changes or disclosure" sourceReference="requirements.md#r17" xsi:type="cimorg:AcceptanceCriterion" givenContext="Alice and Ben with separate identities and one organizer" whenAction="Alice tries to cancel Ben's booking and read the roster" thenOutcome="both are denied without state changes or disclosure" measurableTarget="Anonymous mutation, participant roster read, and cross-participant cancellation all fail; authorized equivalents succeed; no unauthorized effect or personal-data response occurs." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R17-scenario" name="Enforce business permissions quality scenario" description="Anonymous mutation, participant roster read, and cross-participant cancellation all fail; authorized equivalents succeed; no unauthorized effect or personal-data response occurs." sourceReference="requirements.md#r17" xsi:type="cimgov:QualityScenario" qualityType="SECURITY" source="Participant or authorized evaluation operator" stimulus="Alice tries to cancel Ben's booking and read the roster" environment="Alice and Ben with separate identities and one organizer" artifact="Community Workshops service and retained business records" response="both are denied without state changes or disclosure" responseMeasure="Anonymous mutation, participant roster read, and cross-participant cancellation all fail; authorized equivalents succeed; no unauthorized effect or personal-data response occurs." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R18" name="Respond promptly under announcement load" description="With 100 identified participants, up to 20 concurrent requests, and 100 catalogue/booking requests over 60 seconds, the 95th percentile response time for catalogue, own-booking, and seat-request interactions shall be at most two seconds. Include cold starts and rejected requests; exclude deliberate provider-delay time. Report environment, region, concurrency, sample count, and errors. All seat invariants still hold." sourceReference="requirements.md#r18" xsi:type="cimgov:NonFunctionalRequirement" requirementType="QUALITY" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="At least 100 measured interactions in the stated environment meet p95 &lt;= 2 seconds and produce zero invariant violations; record failures separately rather than dropping them." supportsGoals="goal-fair goal-clear" constrains="cmd-request qry-browse qry-mine" qualityType="PERFORMANCE" metric="Respond promptly under announcement load" target="At least 100 measured interactions in the stated environment meet p95 &lt;= 2 seconds and produce zero invariant violations; record failures separately rather than dropping them." measurementMethod="Execute the given/when/then acceptance criterion and the linked evaluation scenarios." environmentAssumption="Fictional single-centre evaluation baseline; controlled identities, clock, and delivery test double." constrainedElements="cmd-request qry-browse qry-mine" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R18-ac" name="Respond promptly under announcement load acceptance" description="p95 response time is at most two seconds and seat invariants hold" sourceReference="requirements.md#r18" xsi:type="cimorg:AcceptanceCriterion" givenContext="the documented evaluation deployment and a 100-request workload" whenAction="the announcement workload runs including initially idle components" thenOutcome="p95 response time is at most two seconds and seat invariants hold" measurableTarget="At least 100 measured interactions in the stated environment meet p95 &lt;= 2 seconds and produce zero invariant violations; record failures separately rather than dropping them." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R18-scenario" name="Respond promptly under announcement load quality scenario" description="At least 100 measured interactions in the stated environment meet p95 &lt;= 2 seconds and produce zero invariant violations; record failures separately rather than dropping them." sourceReference="requirements.md#r18" xsi:type="cimgov:QualityScenario" qualityType="PERFORMANCE" source="Participant or authorized evaluation operator" stimulus="the announcement workload runs including initially idle components" environment="the documented evaluation deployment and a 100-request workload" artifact="Community Workshops service and retained business records" response="p95 response time is at most two seconds and seat invariants hold" responseMeasure="At least 100 measured interactions in the stated environment meet p95 &lt;= 2 seconds and produce zero invariant violations; record failures separately rather than dropping them." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R19" name="Preserve committed work across failures" description="An acknowledged booking outcome and its notice obligation shall survive worker restart or message redelivery. A provider outage never reverses a committed registration. In the fault test, restart after booking commit but before notice preparation; after recovery within ten minutes, materialize the missing notice within 60 seconds, without requiring the participant to resubmit. Existing exhausted delivery attempts remain visible rather than restarting silently." sourceReference="requirements.md#r19" xsi:type="cimgov:NonFunctionalRequirement" requirementType="QUALITY" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="Inject a restart at the commit/notice boundary: one booking survives, exactly one notice intent is recovered, and its registration outcome is unchanged. No claim of exactly-once inbox delivery is made." supportsGoals="goal-fair goal-clear" constrains="cmd-request cmd-prepare cmd-dispatch ent-notice" qualityType="RELIABILITY" metric="Preserve committed work across failures" target="Inject a restart at the commit/notice boundary: one booking survives, exactly one notice intent is recovered, and its registration outcome is unchanged. No claim of exactly-once inbox delivery is made." measurementMethod="Execute the given/when/then acceptance criterion and the linked evaluation scenarios." environmentAssumption="Fictional single-centre evaluation baseline; controlled identities, clock, and delivery test double." constrainedElements="cmd-request cmd-prepare cmd-dispatch ent-notice" generatedByTransformation="false" manuallyMaintained="false">
    <acceptanceCriteria id="R19-ac" name="Preserve committed work across failures acceptance" description="the booking survives and one pending notice intent is recovered within 60 seconds" sourceReference="requirements.md#r19" xsi:type="cimorg:AcceptanceCriterion" givenContext="a committed booking whose notice obligation has not yet been processed" whenAction="the worker restarts and processing resumes within ten minutes" thenOutcome="the booking survives and one pending notice intent is recovered within 60 seconds" measurableTarget="Inject a restart at the commit/notice boundary: one booking survives, exactly one notice intent is recovered, and its registration outcome is unchanged. No claim of exactly-once inbox delivery is made." automatableTestCandidate="true" generatedByTransformation="false" manuallyMaintained="false" />
    <scenarios id="R19-scenario" name="Preserve committed work across failures quality scenario" description="Inject a restart at the commit/notice boundary: one booking survives, exactly one notice intent is recovered, and its registration outcome is unchanged. No claim of exactly-once inbox delivery is made." sourceReference="requirements.md#r19" xsi:type="cimgov:QualityScenario" qualityType="RELIABILITY" source="Participant or authorized evaluation operator" stimulus="the worker restarts and processing resumes within ten minutes" environment="a committed booking whose notice obligation has not yet been processed" artifact="Community Workshops service and retained business records" response="the booking survives and one pending notice intent is recovered within 60 seconds" responseMeasure="Inject a restart at the commit/notice boundary: one booking survives, exactly one notice intent is recovered, and its registration outcome is unchanged. No claim of exactly-once inbox delivery is made." generatedByTransformation="false" manuallyMaintained="false" />
  </requirements>
  <requirements id="R20" name="Keep accountable business history" description="Every successful workshop or registration state change shall append a business audit entry containing operation key, actor or responsible role, workshop and registration where relevant, occurrence time, previous state, and new state. Replayed no-ops do not append another state change. Organizers can inspect the history for their workshop. Access is restricted and identifying history follows R14 retention." sourceReference="requirements.md#r20" xsi:type="cimgov:NonFunctionalRequirement" requirementType="AUDIT" sourceType="ASSUMPTION" priority="HIGH" mandatory="true" productionBlocking="true" fitCriterion="The main lifecycle can be reconstructed in order; a replay has one state-change entry; privacy cleanup removes identifying history and retains only anonymous totals." supportsGoals="goal-fair goal-clear" constrains="info-audit qry-roster cmd-request cmd-cancel" qualityType="AUDITABILITY" metric="Keep accountable business history" target="The main lifecycle can be reconstructed in order; a replay has one state-change entry; privacy cleanup removes identifying history and retains only anonymous totals." measurementMethod="Execute the given/when/then acceptance criterion and the linked evaluation scenarios." environmentAssumption="Fictional single-centre evaluation baseline; controlled identities, clock, and delivery test double." constrainedElements="info-audit qry-roster cmd-request cmd-cancel" generatedByTransformation="false" manuallyMaintained="false">
