  <policies id="pol-allocation" name="Seat allocation" description="Booking open, valid identity and unique active pair: confirm if a seat is free; otherwise wait only with consent and fewer than ten waiting entries; otherwise reject. See the ordered allocation decision table." sourceReference="README.md" xsi:type="cimprocess:Policy" naturalLanguageRule="Booking open, valid identity and unique active pair: confirm if a seat is free; otherwise wait only with consent and fewer than ten waiting entries; otherwise reject. See the ordered allocation decision table." policyType="GUARD" guards="cmd-request" triggeredBy="" emitsCommands="" decisionTable="dt-allocation" enforcementStrength="MANDATORY" violationSeverity="ERROR" auditRequired="true" generatedByTransformation="false" manuallyMaintained="false" />
  <policies id="pol-promotion" name="FIFO promotion" description="A confirmed participant cancellation before cutoff cancels that registration and confirms the oldest waiting entry in one business change. Waiting cancellation has no promotion. Newcomers cannot bypass a waiting entry." sourceReference="README.md" xsi:type="cimprocess:Policy" naturalLanguageRule="A confirmed participant cancellation before cutoff cancels that registration and confirms the oldest waiting entry in one business change. Waiting cancellation has no promotion. Newcomers cannot bypass a waiting entry." policyType="GUARD" guards="cmd-cancel" triggeredBy="" emitsCommands="" decisionTable="" enforcementStrength="MANDATORY" violationSeverity="ERROR" auditRequired="true" generatedByTransformation="false" manuallyMaintained="false" />
  <policies id="pol-cancel-workshop" name="Workshop cancellation takes precedence" description="Before start, organizer cancellation atomically cancels workshop and all active registrations; never promote and suppress unsent obsolete messages." sourceReference="README.md" xsi:type="cimprocess:Policy" naturalLanguageRule="Before start, organizer cancellation atomically cancels workshop and all active registrations; never promote and suppress unsent obsolete messages." policyType="GUARD" guards="cmd-cancel-workshop" triggeredBy="" emitsCommands="" decisionTable="" enforcementStrength="MANDATORY" violationSeverity="ERROR" auditRequired="true" generatedByTransformation="false" manuallyMaintained="false" />
  <policies id="pol-close" name="Workshop closure timing" description="Close only PUBLISHED workshops at or after end; preserve ATTENDED, classify confirmed as NO_SHOW and waiting as EXPIRED; freeze anonymous totals." sourceReference="README.md" xsi:type="cimprocess:Policy" naturalLanguageRule="Close only PUBLISHED workshops at or after end; preserve ATTENDED, classify confirmed as NO_SHOW and waiting as EXPIRED; freeze anonymous totals." policyType="GUARD" guards="cmd-close" triggeredBy="" emitsCommands="" decisionTable="" enforcementStrength="MANDATORY" violationSeverity="ERROR" auditRequired="true" generatedByTransformation="false" manuallyMaintained="false" />
  <policies id="pol-remind" name="Reminder eligibility window" description="Within [start-24h, cutoff), request once per CONFIRMED registration; repeat scans include late confirmations; never request after cutoff." sourceReference="README.md" xsi:type="cimprocess:Policy" naturalLanguageRule="Within [start-24h, cutoff), request once per CONFIRMED registration; repeat scans include late confirmations; never request after cutoff." policyType="GUARD" guards="cmd-remind" triggeredBy="" emitsCommands="" decisionTable="" enforcementStrength="MANDATORY" violationSeverity="ERROR" auditRequired="true" generatedByTransformation="false" manuallyMaintained="false" />
  <policies id="pol-notice" name="Essential notice obligation" description="For each committed confirmation, waiting assignment, registration cancellation, promotion, workshop cancellation, or reminder fact, prepare one durable intent per affected registration and notice kind. For workshop cancellation include each formerly active participant. Recheck authoritative relevance before sending." sourceReference="README.md" xsi:type="cimprocess:Policy" naturalLanguageRule="For each committed confirmation, waiting assignment, registration cancellation, promotion, workshop cancellation, or reminder fact, prepare one durable intent per affected registration and notice kind. For workshop cancellation include each formerly active participant. Recheck authoritative relevance before sending. Never recreate personal notice records after retention has elapsed or cleanup completed; duplicate or obsolete source facts have no new effects. CONFIRMATION/PROMOTION requires PUBLISHED workshop, CONFIRMED registration, and now &lt; start. WAITING requires PUBLISHED, WAITLISTED, and now &lt; cutoff. REMINDER requires PUBLISHED, CONFIRMED, and now &lt; start. Individual CANCELLATION requires that registration CANCELLED and workshop not CANCELLED. WORKSHOP_CANCELLATION requires workshop CANCELLED and the recipient in the formerly-active cancellation snapshot. Every kind requires unexpired retention." policyType="REACTION" guards="" triggeredBy="evt-confirmed evt-waiting evt-cancelled evt-promoted evt-workshop-cancelled evt-reminder" emitsCommands="cmd-prepare" decisionTable="" enforcementStrength="MANDATORY" violationSeverity="ERROR" auditRequired="true" generatedByTransformation="false" manuallyMaintained="false" />
  <policies id="pol-dispatch" name="Prepared notice delivery" description="A newly prepared notice is eligible for its initial attempt, after a relevance check; delivery cannot mutate bookings." sourceReference="README.md" xsi:type="cimprocess:Policy" naturalLanguageRule="A newly prepared notice is eligible for its initial attempt, after a relevance check; delivery cannot mutate bookings." policyType="REACTION" guards="" triggeredBy="evt-notice-prepared" emitsCommands="cmd-dispatch" decisionTable="" enforcementStrength="MANDATORY" violationSeverity="ERROR" auditRequired="true" generatedByTransformation="false" manuallyMaintained="false" />
  <policies id="pol-retry" name="Bounded delivery retry" description="On attempt failure, if attempts &lt; 3 and the notice is relevant, schedule next dispatch after one minute (first failure) or five minutes (second). At three failures mark FAILED; an accepted or suppressed notice has no retry." sourceReference="README.md" xsi:type="cimprocess:Policy" naturalLanguageRule="On attempt failure, if attempts &lt; 3 and the notice is relevant, schedule next dispatch after one minute (first failure) or five minutes (second). At three failures mark FAILED; an accepted or suppressed notice has no retry." policyType="REACTION" guards="" triggeredBy="evt-notice-failed" emitsCommands="cmd-dispatch" decisionTable="" enforcementStrength="MANDATORY" violationSeverity="ERROR" auditRequired="true" generatedByTransformation="false" manuallyMaintained="false" />
  <policies id="pol-retention" name="Personal record retention" description="At end+30 days, erase registrations, notices, request keys and identifying audit/event records within 24 hours, retaining only non-identifying workshop details and totals. Applies to cancelled workshops too." sourceReference="README.md" xsi:type="cimprocess:Policy" naturalLanguageRule="At end+30 days, erase registrations, notices, request keys and identifying audit/event records within 24 hours, retaining only non-identifying workshop details and totals. Applies to cancelled workshops too. Record a non-identifying cleanup-complete marker. Block late notice preparation and dispatch when retention has elapsed or cleanup completed." policyType="GUARD" guards="cmd-purge" triggeredBy="" emitsCommands="" decisionTable="" enforcementStrength="MANDATORY" violationSeverity="ERROR" auditRequired="true" generatedByTransformation="false" manuallyMaintained="false" />
