  <commands id="cmd-prepare" name="Prepare essential notice" description="Committed confirmation, waiting assignment, registration cancellation, promotion, workshop cancellation, and reminder facts shall each yield one durable notice intent per affected registration and kind. Notice content includes workshop title, venue, start with timezone, cutoff where relevant, and resulting booking status. Dispatch rechecks current state and suppresses obsolete waiting, confirmation, promotion, or reminder notices. Terminal registration/workshop cancellation notices may still be delivered. Provider acceptance means accepted by the provider, not inbox receipt." sourceReference="README.md" xsi:type="cimbehavior:Command" intent="Prepare essential notice" issuedBy="" targetCapability="cap-notices" targetAggregate="agg-notice" input="info-fact-id info-workshop-id info-registration-id info-notice-kind" preconditions="cond-notice-fact" expectedEvents="evt-notice-prepared" possibleErrors="err-state err-access" authorizationRequired="true" authorizationRule="Only trusted policy processing may prepare a notice from a committed business fact." userInitiated="false" duplicateSubmissionPossible="true" idempotencyBusinessKey="fact identifier + registration identifier + notice kind" auditRequired="true" commandType="POLICY_TRIGGERED_INTENT" interactionExpectation="BACK_OFFICE_PROCESSING" priority="HIGH" generatedByTransformation="false" manuallyMaintained="false">
    <outcomes id="cmd-prepare-success" name="Prepare essential notice accepted" description="Successful mutation commits its eligible facts; an exact replay returns the original outcome with no new facts." sourceReference="requirements.md" xsi:type="cimbehavior:CommandOutcome" success="true" resultDescription="Business action accepted; emitted events depend on the applicable branch." emittedEvents="evt-notice-prepared" output="" generatedByTransformation="false" manuallyMaintained="false" />
