    <resources xsi:type="awspsmworkflow:StepFunctionStateMachine" id="6ed5ed3e-a0f1-5aff-b282-391248d7b950" name="Workspace provisioning" publishAlias="false" retainInProduction="false" productionCritical="false" importedResource="false" logicalId="ProvisioningWorkflow" stateMachineType="STANDARD" role="c1c16192-994d-5913-8e55-682d2c78759a" definitionString="{&quot;StartAt&quot;:&quot;ValidateRequest&quot;,&quot;States&quot;:{&quot;ValidateRequest&quot;:{&quot;Type&quot;:&quot;Task&quot;,&quot;Resource&quot;:&quot;${ValidateRequestArn}&quot;,&quot;ResultPath&quot;:&quot;$.stepResults.validateRequest&quot;,&quot;Retry&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.TaskFailed&quot;],&quot;IntervalSeconds&quot;:2,&quot;MaxAttempts&quot;:3,&quot;BackoffRate&quot;:2}],&quot;Catch&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.ALL&quot;],&quot;Next&quot;:&quot;Fail&quot;}],&quot;Next&quot;:&quot;AllowOrDeny&quot;},&quot;AllowOrDeny&quot;:{&quot;Type&quot;:&quot;Choice&quot;,&quot;Choices&quot;:[{&quot;Variable&quot;:&quot;$.stepResults.validateRequest.outcome&quot;,&quot;StringEquals&quot;:&quot;ALLOW&quot;,&quot;Next&quot;:&quot;AllocateWorkspace&quot;}],&quot;Default&quot;:&quot;Fail&quot;},&quot;AllocateWorkspace&quot;:{&quot;Type&quot;:&quot;Task&quot;,&quot;Resource&quot;:&quot;${AllocateWorkspaceArn}&quot;,&quot;ResultPath&quot;:&quot;$.stepResults.allocateWorkspace&quot;,&quot;Retry&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.TaskFailed&quot;],&quot;IntervalSeconds&quot;:2,&quot;MaxAttempts&quot;:3,&quot;BackoffRate&quot;:2}],&quot;Catch&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.ALL&quot;],&quot;Next&quot;:&quot;Fail&quot;}],&quot;Next&quot;:&quot;CreateManifest&quot;},&quot;CreateManifest&quot;:{&quot;Type&quot;:&quot;Task&quot;,&quot;Resource&quot;:&quot;${CreateManifestArn}&quot;,&quot;ResultPath&quot;:&quot;$.stepResults.createManifest&quot;,&quot;Retry&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.TaskFailed&quot;],&quot;IntervalSeconds&quot;:2,&quot;MaxAttempts&quot;:3,&quot;BackoffRate&quot;:2}],&quot;Catch&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.ALL&quot;],&quot;Next&quot;:&quot;Fail&quot;}],&quot;Next&quot;:&quot;WaitForCheck&quot;},&quot;WaitForCheck&quot;:{&quot;Type&quot;:&quot;Wait&quot;,&quot;Seconds&quot;:5,&quot;Next&quot;:&quot;VerifyWorkspace&quot;},&quot;VerifyWorkspace&quot;:{&quot;Type&quot;:&quot;Task&quot;,&quot;Resource&quot;:&quot;${VerifyWorkspaceArn}&quot;,&quot;ResultPath&quot;:&quot;$.stepResults.verifyWorkspace&quot;,&quot;Retry&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.TaskFailed&quot;],&quot;IntervalSeconds&quot;:2,&quot;MaxAttempts&quot;:3,&quot;BackoffRate&quot;:2}],&quot;Catch&quot;:[{&quot;ErrorEquals&quot;:[&quot;States.ALL&quot;],&quot;Next&quot;:&quot;Fail&quot;}],&quot;Next&quot;:&quot;ReadyOrFailed&quot;},&quot;ReadyOrFailed&quot;:{&quot;Type&quot;:&quot;Choice&quot;,&quot;Choices&quot;:[{&quot;Variable&quot;:&quot;$.stepResults.verifyWorkspace.outcome&quot;,&quot;StringEquals&quot;:&quot;READY&quot;,&quot;Next&quot;:&quot;Complete&quot;}],&quot;Default&quot;:&quot;Fail&quot;},&quot;Complete&quot;:{&quot;Type&quot;:&quot;Succeed&quot;},&quot;Fail&quot;:{&quot;Type&quot;:&quot;Fail&quot;}}}">
