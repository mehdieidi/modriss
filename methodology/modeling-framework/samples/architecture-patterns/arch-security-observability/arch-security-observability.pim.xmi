  <businessRules xsi:type="policy:BusinessRule" id="d4613622-338b-5e2a-808f-f6d0f8cca386" name="Security and observability patterns beyond infrastructure rule 1" naturalLanguageRule="Trace authorized/denied evidence actions using correlated logs and reviewed recovery telemetry." enforcedBy="6fe7f97f-e183-5c38-9f65-6238d176a5ef 91bf1bc1-9a67-5eb9-a380-fa22fa043458 b07d7080-cd3a-599b-aca0-6b9909bdc503 15215a56-cfd8-5e37-9121-7e8eebe041c9 af6e06b6-031d-5a43-932e-df21d6d180a8 5b138f9c-1beb-5a4f-a530-a00719547040" />
  <businessRules xsi:type="policy:BusinessRule" id="53b8f429-498f-5f26-a455-232f57901999" name="Security and observability patterns beyond infrastructure rule 2" naturalLanguageRule="Bind evidence and review to exact object version/hash; contributors cannot review their own evidence." enforcedBy="6fe7f97f-e183-5c38-9f65-6238d176a5ef 91bf1bc1-9a67-5eb9-a380-fa22fa043458 b07d7080-cd3a-599b-aca0-6b9909bdc503 15215a56-cfd8-5e37-9121-7e8eebe041c9 af6e06b6-031d-5a43-932e-df21d6d180a8 5b138f9c-1beb-5a4f-a530-a00719547040" />
  <businessRules xsi:type="policy:BusinessRule" id="2cb6de59-593b-57d9-a197-e6714038042e" name="Security and observability patterns beyond infrastructure rule 3" naturalLanguageRule="Only authorized roles access provenance/content or change holds; distinguish denied attempts from accepted actions." enforcedBy="6fe7f97f-e183-5c38-9f65-6238d176a5ef 91bf1bc1-9a67-5eb9-a380-fa22fa043458 b07d7080-cd3a-599b-aca0-6b9909bdc503 15215a56-cfd8-5e37-9121-7e8eebe041c9 af6e06b6-031d-5a43-932e-df21d6d180a8 5b138f9c-1beb-5a4f-a530-a00719547040" />
