  <businessRules xsi:type="policy:BusinessRule" id="43fcc474-accc-5fc2-b418-f4664032cf7b" name="Full Parallel workflow rule 1" naturalLanguageRule="Two executable branches must complete with explicit join and failure semantics." enforcedBy="5bf9ce0e-6ed6-5a89-a109-48f58d678547 cf012ec4-0162-5bc6-bbaf-296259f8ab9e c1055c60-3871-5110-83f1-ad2eea252f6d 6fc34e51-b34b-5537-95a2-4cd22b6dd7c7 b87d2b8c-7c0b-594a-8248-7bb5020d27a4 ec8fba64-23c4-5d96-a8ae-a17b1ce34152" />
  <businessRules xsi:type="policy:BusinessRule" id="faf3ad3d-7389-5fbe-b3ce-145ea7562b03" name="Full Parallel workflow rule 2" naturalLanguageRule="Require 1 through 30 seats and nonblank courseCode; request replay preserves one identity." enforcedBy="5bf9ce0e-6ed6-5a89-a109-48f58d678547 cf012ec4-0162-5bc6-bbaf-296259f8ab9e c1055c60-3871-5110-83f1-ad2eea252f6d 6fc34e51-b34b-5537-95a2-4cd22b6dd7c7 b87d2b8c-7c0b-594a-8248-7bb5020d27a4 ec8fba64-23c4-5d96-a8ae-a17b1ce34152" />
  <businessRules xsi:type="policy:BusinessRule" id="70abb8cb-4a12-5102-83fe-99326be7d2c8" name="Full Parallel workflow rule 3" naturalLanguageRule="ValidateRequest -&gt; ALLOW/DENY -&gt; AllocateWorkspace -&gt; CreateManifest -&gt; five-second wait -&gt; VerifyWorkspace -&gt; READY/FAILED." enforcedBy="5bf9ce0e-6ed6-5a89-a109-48f58d678547 cf012ec4-0162-5bc6-bbaf-296259f8ab9e c1055c60-3871-5110-83f1-ad2eea252f6d 6fc34e51-b34b-5537-95a2-4cd22b6dd7c7 b87d2b8c-7c0b-594a-8248-7bb5020d27a4 ec8fba64-23c4-5d96-a8ae-a17b1ce34152" />
