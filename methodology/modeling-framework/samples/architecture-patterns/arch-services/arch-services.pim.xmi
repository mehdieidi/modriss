  <businessRules xsi:type="policy:BusinessRule" id="78915712-ee5e-54f0-95a1-8f7bd2eea9ed" name="Bounded-context decomposition and microservices rule 1" naturalLanguageRule="Separate notice ownership from delivery ownership with explicit contracts and release units." enforcedBy="b6e822be-ecae-51e1-acb2-855f1e59013d 2e238614-5305-5fcd-92c1-9351742d8f4d e9cf9ba3-00b8-53c6-882c-f476267e78a7 bf8dea44-96b0-53fd-9c2f-5614622573df e21304a8-7311-5c9a-a0f8-4cc3fa93c7bf" />
  <businessRules xsi:type="policy:BusinessRule" id="9fb87298-fc1c-5f2c-8bfb-07b7b75e7679" name="Bounded-context decomposition and microservices rule 2" naturalLanguageRule="Publish stable-ID closure/reopening events to two independent consumers." enforcedBy="b6e822be-ecae-51e1-acb2-855f1e59013d 2e238614-5305-5fcd-92c1-9351742d8f4d e9cf9ba3-00b8-53c6-882c-f476267e78a7 bf8dea44-96b0-53fd-9c2f-5614622573df e21304a8-7311-5c9a-a0f8-4cc3fa93c7bf" />
  <businessRules xsi:type="policy:BusinessRule" id="5a78d8d5-d7fb-53c5-806d-f340c500b473" name="Bounded-context decomposition and microservices rule 3" naturalLanguageRule="Recheck enabled building preferences immediately before sending; later opt-out cannot retract an accepted send." enforcedBy="b6e822be-ecae-51e1-acb2-855f1e59013d 2e238614-5305-5fcd-92c1-9351742d8f4d e9cf9ba3-00b8-53c6-882c-f476267e78a7 bf8dea44-96b0-53fd-9c2f-5614622573df e21304a8-7311-5c9a-a0f8-4cc3fa93c7bf" />
  <businessRules xsi:type="policy:BusinessRule" id="f38ef72b-d927-593b-bf12-817c82d8d153" name="Bounded-context decomposition and microservices rule 4" naturalLanguageRule="A delivery key is eventId/subjectId/channel; matching simulator replay returns one provider reference." enforcedBy="b6e822be-ecae-51e1-acb2-855f1e59013d 2e238614-5305-5fcd-92c1-9351742d8f4d e9cf9ba3-00b8-53c6-882c-f476267e78a7 bf8dea44-96b0-53fd-9c2f-5614622573df e21304a8-7311-5c9a-a0f8-4cc3fa93c7bf" />
  <businessRules xsi:type="policy:BusinessRule" id="3298f05b-6d4e-5b44-b29d-19f5c3aa84a7" name="Bounded-context decomposition and microservices rule 5" naturalLanguageRule="Retain failed/skipped/accepted delivery outcomes for authorized replay; no real email or SMS." enforcedBy="b6e822be-ecae-51e1-acb2-855f1e59013d 2e238614-5305-5fcd-92c1-9351742d8f4d e9cf9ba3-00b8-53c6-882c-f476267e78a7 bf8dea44-96b0-53fd-9c2f-5614622573df e21304a8-7311-5c9a-a0f8-4cc3fa93c7bf" />
