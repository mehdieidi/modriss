  <businessRules xsi:type="policy:BusinessRule" id="855d1b13-f20d-5691-a83d-b3bbe35bd774" name="Scheduled function and finite background job rule 3" naturalLanguageRule="At 02:00 UTC for date D apply valid renewals first; expire only validThrough &lt; D." enforcedBy="a69ceeb5-43c0-5f27-b5bc-ca8cde0949ef c48745bd-4c22-5c00-8637-14b150663f3b 6d9a1bff-e23a-59b5-a052-a2c9662db0fc 3ecbe5a3-3168-598e-bca7-6612d9d8e36e" />
