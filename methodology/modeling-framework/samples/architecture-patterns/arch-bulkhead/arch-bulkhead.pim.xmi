  <businessRules xsi:type="policy:BusinessRule" id="1f4f3eb6-e229-552e-bf2b-25729a848f70" name="Bulkhead isolation rule 1" naturalLanguageRule="Limit the publishing worker to five reserved concurrent executions; downstream isolation needs code." enforcedBy="c9316d78-4cc8-5981-bf1f-8516c2139a76 7faf733c-6115-535d-8cb7-803fc6fe66e1 8be1d3ac-6b0a-5c08-93a4-df4fad8637c1" />
  <businessRules xsi:type="policy:BusinessRule" id="36806ff5-d281-5d25-816a-5a7b8e32b510" name="Bulkhead isolation rule 2" naturalLanguageRule="Map itemCode/availableQty/itemVersion deterministically to sku/stockAvailable/sourceVersion; quantities are nonnegative integers." enforcedBy="c9316d78-4cc8-5981-bf1f-8516c2139a76 7faf733c-6115-535d-8cb7-803fc6fe66e1 8be1d3ac-6b0a-5c08-93a4-df4fad8637c1" />
  <businessRules xsi:type="policy:BusinessRule" id="3bedbe64-e0da-5de3-9aaa-7206edee3712" name="Bulkhead isolation rule 3" naturalLanguageRule="Newest full snapshot wins per SKU; older snapshots never revert destination stock." enforcedBy="c9316d78-4cc8-5981-bf1f-8516c2139a76 7faf733c-6115-535d-8cb7-803fc6fe66e1 8be1d3ac-6b0a-5c08-93a4-df4fad8637c1" />
  <businessRules xsi:type="policy:BusinessRule" id="ef60c85b-fde0-59ed-a260-9d13768cd5ef" name="Bulkhead isolation rule 4" naturalLanguageRule="Stable exchange ID and payload hash resolve timeout-after-commit; provider 429 is retriable, malformed contracts fail permanently." enforcedBy="c9316d78-4cc8-5981-bf1f-8516c2139a76 7faf733c-6115-535d-8cb7-803fc6fe66e1 8be1d3ac-6b0a-5c08-93a4-df4fad8637c1" />
  <businessRules xsi:type="policy:BusinessRule" id="48894c57-9502-5c64-9528-bcd42b3bfc95" name="Bulkhead isolation rule 5" naturalLanguageRule="Operator replay is authorized and audited; simulators use controlled study endpoints and credentials." enforcedBy="c9316d78-4cc8-5981-bf1f-8516c2139a76 7faf733c-6115-535d-8cb7-803fc6fe66e1 8be1d3ac-6b0a-5c08-93a4-df4fad8637c1" />
