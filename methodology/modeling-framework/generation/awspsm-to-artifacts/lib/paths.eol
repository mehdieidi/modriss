/** Provides reusable paths operations. */
import "naming.eol";
import "values.eol";

/** Computes source extension. */
operation Any sourceExtension() : String {
  return "go";
}

/** Computes test extension. */
operation Any testExtension() : String {
  return self.sourceExtension();
}

/** Computes primary language. */
operation Map primaryLanguage() : String {
  return "GO";
}

/** Computes source extension. */
operation Map sourceExtension() : String {
  return self.primaryLanguage().sourceExtension();
}

/** Computes test extension. */
operation Map testExtension() : String {
  return self.primaryLanguage().testExtension();
}

/** Computes function path segment. */
operation AWSPSMCOMPUTE!AwsLambdaFunction functionPathSegment(profileMap : Map) : String {
  return self.functionSlug();
}

/** Computes service directory segment, with a stable application fallback for unassigned resources. */
operation AWSPSMCORE!AwsResource servicePathSegment() : String {
  if (self.service.isDefined()) {
    return artifactPathNaming.name(self.service, "service", AWSPSMCORE!AwsService.all);
  }
  return "application";
}

/** Computes the generated source root for a modeled service. */
operation AWSPSMCORE!AwsService serviceRoot() : String {
  return "services/" + artifactPathNaming.name(self, "service", AWSPSMCORE!AwsService.all);
}

/** Computes the create-once service application entry for a Lambda use case. */
operation AWSPSMCOMPUTE!AwsLambdaFunction serviceApplicationHandlerPath(profileMap : Map) : String {
  return "services/" + self.servicePathSegment() + "/internal/application/" + self.functionPathSegment(profileMap) + ".go";
}

/** Computes a stable exported use-case entry point for a generated Lambda. */
operation AWSPSMCOMPUTE!AwsLambdaFunction serviceApplicationHandlerName() : String {
  return "Handle" + self.cfnLogicalId();
}

/** Returns the modeled successful API status for this Lambda, or the standard success default for non-API invocations. */
operation AWSPSMCOMPUTE!AwsLambdaFunction apiSuccessStatusCode() : String {
  var routes = AWSPSMAPI!ApiGatewayRoute.all.select(routeObj |
    routeObj.integration.isDefined() and routeObj.integration.lambdaTarget = self);
  for (routeObj in routes) {
    var successModels = routeObj.responseModels.select(modelObj | modelObj.statusCode.matches("^2[0-9]{2}$"));
    if (successModels.notEmpty()) return successModels.first().statusCode;
  }
  return "200";
}

/** Renders modeled API domain-error status mappings for this function as Go source. */
operation AWSPSMCOMPUTE!AwsLambdaFunction apiErrorStatusMap() : String {
  var routes = AWSPSMAPI!ApiGatewayRoute.all.select(routeObj |
    routeObj.integration.isDefined() and routeObj.integration.lambdaTarget = self);
  var seenCodes = Set{};
  var entries = "";
  for (routeObj in routes) {
    for (modelObj in routeObj.responseModels.select(modelObj | modelObj.statusCode.matches("^[45][0-9]{2}$"))) {
      for (codeText in modelObj.errorCodes) {
        if (codeText.isDefined() and codeText.trim().length() > 0 and not seenCodes.includes(codeText)) {
          if (entries.length() > 0) entries = entries + ", ";
          entries = entries + "\"" + codeText.jsonEscape() + "\": " + modelObj.statusCode;
          seenCodes.add(codeText);
        }
      }
    }
  }
  // API handlers can enforce modeled application roles after the gateway has accepted the
  // request. Keep that standard authorization failure in the HTTP contract even when a route
  // does not repeat ACCESS_DENIED in every response model.
  if (routes.notEmpty() and not seenCodes.includes("ACCESS_DENIED")) {
    if (entries.length() > 0) entries = entries + ", ";
    entries = entries + "\"ACCESS_DENIED\": 403";
  }
  return "map[string]int{" + entries + "}";
}

/** Renders one contract-compatible fallback error code for generated runtime errors by status. */
operation AWSPSMCOMPUTE!AwsLambdaFunction apiErrorCodeByStatusMap() : String {
  var routes = AWSPSMAPI!ApiGatewayRoute.all.select(routeObj |
    routeObj.integration.isDefined() and routeObj.integration.lambdaTarget = self);
  var emittedStatuses = Set{};
  var entries = "";
  for (routeObj in routes) {
    for (modelObj in routeObj.responseModels.select(modelObj | modelObj.statusCode.matches("^[45][0-9]{2}$"))) {
      if (modelObj.errorCodes.notEmpty() and not emittedStatuses.includes(modelObj.statusCode)) {
        if (entries.length() > 0) entries = entries + ", ";
        entries = entries + modelObj.statusCode + ": \"" + modelObj.errorCodes.first().jsonEscape() + "\"";
        emittedStatuses.add(modelObj.statusCode);
      }
    }
  }
  return "map[int]string{" + entries + "}";
}

/** Computes service source directory for a Lambda function. */
operation AWSPSMCOMPUTE!AwsLambdaFunction sourcePath() : String {
  return "services/" + self.servicePathSegment() + "/cmd/" + self.functionSlug();
}

/** Computes handler path. */
operation AWSPSMCOMPUTE!AwsLambdaFunction handlerPath(profileMap : Map) : String {
  var legacySlug = firstText(self.functionName, firstText(self.logicalId, self.name)).toSlug();
  return artifactPathNaming.preservePath(self.sourcePath() + "/main." + profileMap.sourceExtension(), "src/functions/" + legacySlug + "/handler." + profileMap.sourceExtension(), self.stableKey(), "LAMBDA_HANDLER");
}

/** Computes local schema path. */
operation AWSPSMCOMPUTE!AwsLambdaFunction localSchemaPath(profileMap : Map) : String {
  var legacySlug = firstText(self.functionName, firstText(self.logicalId, self.name)).toSlug();
  return artifactPathNaming.preservePath("services/" + self.servicePathSegment() + "/contracts/api/" + self.functionPathSegment(profileMap) + ".schema.json", "src/functions/" + legacySlug + "/schema.json", self.stableKey(), "FUNCTION_SCHEMA");
}

/** Computes local schema path. */
operation AWSPSMCOMPUTE!AwsLambdaFunction localSchemaPath() : String {
  return self.localSchemaPath(AWSPSM!AwsPsmModel.all.first().defaultEmitContext());
}

/** Computes generated handler name. */
operation AWSPSMCOMPUTE!AwsLambdaFunction generatedHandlerName(profileMap : Map) : String {
  return "bootstrap";
}

/** Computes generated code uri. */
operation AWSPSMCOMPUTE!AwsLambdaFunction generatedCodeUri(profileMap : Map) : String {
  if (self.stack.isDefined() and self.stack.stackTemplatePath().startsWith("infrastructure/units/")) {
    return "../../../bin/" + self.functionPathSegment(profileMap);
  }
  return "bin/" + self.functionPathSegment(profileMap);
}

/** Computes unit test path. */
operation AWSPSMCOMPUTE!AwsLambdaFunction unitTestPath(profileMap : Map) : String {
  var extText = profileMap.testExtension();
  var legacySlug = firstText(self.functionName, firstText(self.logicalId, self.name)).toSlug();
  return artifactPathNaming.preservePath("services/" + self.servicePathSegment() + "/tests/unit/" + self.functionSlug() + "_test." + extText, "tests/unit/" + legacySlug + "_test." + extText, self.stableKey(), "UNIT_TEST");
}

/** Computes integration test path. */
operation AWSPSMCOMPUTE!AwsLambdaFunction integrationTestPath(profileMap : Map) : String {
  var extText = profileMap.testExtension();
  var legacySlug = firstText(self.functionName, firstText(self.logicalId, self.name)).toSlug();
  return artifactPathNaming.preservePath("services/" + self.servicePathSegment() + "/tests/integration/" + self.functionSlug() + "_integration_test." + extText, "tests/integration/" + legacySlug + "_integration_test." + extText, self.stableKey(), "INTEGRATION_TEST");
}

/** Computes open api path. */
operation AWSPSMAPI!ApiGatewayApi openApiPath() : String {
  var legacySlug = firstText(self.apiName, firstText(self.logicalId, self.name)).toSlug();
  return artifactPathNaming.preservePath("services/" + self.servicePathSegment() + "/contracts/api/" + self.apiSlug() + ".openapi.yaml", "openapi/" + legacySlug + ".openapi.yaml", self.stableKey(), "OPENAPI");
}

/** Renders asl path. */
operation AWSPSMWORKFLOW!StepFunctionStateMachine aslPath() : String {
  var legacySlug = firstText(self.stateMachineName, firstText(self.logicalId, self.name)).toSlug();
  return artifactPathNaming.preservePath("services/" + self.servicePathSegment() + "/workflows/" + self.workflowSlug() + ".asl.json", "asl/" + legacySlug + ".asl.json", self.stableKey(), "ASL_JSON");
}

/** Computes workflow DefinitionUri relative to a deployment-unit template. */
operation AWSPSMWORKFLOW!StepFunctionStateMachine aslTemplateUri() : String {
  if (self.stack.isDefined() and self.stack.stackTemplatePath().startsWith("infrastructure/units/")) {
    return "../../../" + self.aslPath();
  }
  return self.aslPath();
}

/** Computes workflow path relative to its service-owned test package. */
operation AWSPSMWORKFLOW!StepFunctionStateMachine workflowTestAslRelativePath() : String {
  return "../../workflows/" + self.workflowSlug() + ".asl.json";
}

/** Computes document path. */
operation KERNEL!StructuredDocument documentPath() : String {
  var baseName = artifactPathNaming.name(self, "document", KERNEL!StructuredDocument.all);
  if (self.id.isPresent() and self.id.startsWith("schema_doc_")) {
    return "contracts/public/schemas/contracts/" + baseName + ".schema.json";
  }
  if (self.id.isPresent() and self.id.startsWith("event_contract_")) {
    return "contracts/public/schemas/events/" + baseName + ".json";
  }
  if (self.id.isPresent() and self.id.startsWith("service_metadata_")) {
    return "generated/documents/services/" + baseName + ".json";
  }
  if (self.format.isDefined() and self.format.asString() = "YAML") {
    return "generated/documents/" + baseName + ".yaml";
  }
  if (self.format.isDefined() and self.format.asString() = "MARKDOWN") {
    return "generated/documents/" + baseName + ".md";
  }
  if (self.format.isDefined() and (self.format.asString() = "JSON" or self.format.asString() = "ASL_JSON" or self.format.asString() = "IAM_POLICY_JSON")) {
    return "generated/documents/" + baseName + ".json";
  }
  return "generated/documents/" + baseName + ".txt";
}

/** Computes workflow test path. */
operation AWSPSMWORKFLOW!StepFunctionStateMachine workflowTestPath(profileMap : Map) : String {
  var extText = profileMap.testExtension();
  var legacySlug = firstText(self.stateMachineName, firstText(self.logicalId, self.name)).toSlug();
  return artifactPathNaming.preservePath("services/" + self.servicePathSegment() + "/tests/workflows/" + self.workflowSlug() + "_workflow_test." + extText, "tests/workflows/" + legacySlug + "_workflow_test." + extText, self.stableKey(), "WORKFLOW_TEST");
}

/** Computes fixture slug. */
operation KERNEL!TraceableElement fixtureSlug(fallbackText : String) : String {
  if (self.isKindOf(AWSPSMEVENTS!EventBridgeRule)) {
    return artifactPathNaming.name(self, "event-fixture", AWSPSMEVENTS!EventBridgeRule.all);
  }
  if (self.isKindOf(AWSPSMMESSAGING!SqsQueue)) {
    return artifactPathNaming.name(self, "queue-fixture", AWSPSMMESSAGING!SqsQueue.all);
  }
  return artifactPathNaming.name(self, "topic-fixture", AWSPSMMESSAGING!SnsTopic.all);
}

/** Computes event fixture path. */
operation AWSPSMEVENTS!EventBridgeRule eventFixturePath() : String {
  return "services/" + self.servicePathSegment() + "/contracts/events/samples/" + self.fixtureSlug(self.eventRuleSlug()) + ".json";
}

/** Computes queue fixture path. */
operation AWSPSMMESSAGING!SqsQueue queueFixturePath() : String {
  return "services/" + self.servicePathSegment() + "/contracts/events/samples/" + self.fixtureSlug(self.queueSlug()) + "-sqs-message.json";
}

/** Converts the receiver to topic fixture path. */
operation AWSPSMMESSAGING!SnsTopic topicFixturePath() : String {
  return "services/" + self.servicePathSegment() + "/contracts/events/samples/" + self.fixtureSlug(self.topicSlug()) + "-sns-message.json";
}

/** Computes env path. */
operation AWSPSMCORE!AwsStage envPath() : String {
  if (self.environmentClass.asString() = "PROD") {
    return artifactPathNaming.preservePath("infrastructure/environments/prod.example.json", "env/prod.example.json", self.stableKey(), "ENVIRONMENT_CONFIG");
  }
  return artifactPathNaming.preservePath("infrastructure/environments/" + self.stageSlug() + ".json", "env/" + self.stageSlug() + ".json", self.stableKey(), "ENVIRONMENT_CONFIG");
}

/** Computes a project-level generated environment path with a legacy mapping. */
operation Map defaultEnvironmentPath(stageNameText : String) : String {
  return artifactPathNaming.preservePath("infrastructure/environments/" + stageNameText + ".json", "env/" + stageNameText + ".json", awsRoot().stableKey() + "-environment-" + stageNameText, "ENVIRONMENT_CONFIG");
}

/** Computes the moved project SAM configuration path and preserves its protected region. */
operation Map projectSamConfigPath() : String {
  return artifactPathNaming.preservePath("infrastructure/samconfig.toml", "samconfig.toml", awsRoot().stableKey(), "SAM_CONFIG");
}

/** Computes a moved cross-cutting runtime artifact path. */
operation Map platformRuntimePath(fileNameText : String) : String {
  return artifactPathNaming.preservePath("platform/runtime/" + fileNameText, "src/shared/" + fileNameText, awsRoot().stableKey(), "SHARED_RUNTIME");
}

/** Computes path kind. */
operation Any pathKind(pathText : String) : String {
  if (pathText.endsWith(".yaml") or pathText.endsWith(".yml")) {
    return "YAML";
  }
  if (pathText.endsWith(".json")) {
    return "JSON";
  }
  if (pathText.endsWith(".md")) {
    return "MARKDOWN";
  }
  if (pathText.endsWith(".sh")) {
    return "SHELL";
  }
  if (pathText.endsWith(".go")) {
    return "GO";
  }
  return "TEXT";
}

/** Computes path kind. */
operation String pathKind() : String {
  if (self.endsWith(".yaml") or self.endsWith(".yml")) {
    return "YAML";
  }
  if (self.endsWith(".json")) {
    return "JSON";
  }
  if (self.endsWith(".md")) {
    return "MARKDOWN";
  }
  if (self.endsWith(".sh")) {
    return "SHELL";
  }
  if (self.endsWith(".go")) {
    return "GO";
  }
  return "TEXT";
}

/** Computes go module path. */
operation Map goModulePath() : String {
  return "example.com/" + self.get("projectSlug");
}
