[% /* Generates the validate models artifact. */ %]#!/usr/bin/env bash
set -euo pipefail

echo "Generated PSM model validation gate"
echo "Generator version: [%= emitCtx.get("generatorVersion") %]"
echo "Manual issues recorded during generation: [%= emitCtx.get("manualIssueList").size() %]"

if [[ -s generated/reports/manual-actions.md ]] && grep -q "BLOCKER" generated/reports/manual-actions.md; then
  echo "Blocking manual actions exist. Review generated/reports/manual-actions.md" >&2
  exit 1
fi

source_roots=()
for candidate in src services internal platform cmd tests; do
  if [[ -d "$candidate" ]]; then
    source_roots+=("$candidate")
  fi
done

# Split marker literals so this generated script does not match itself.
marker_not_implemented="NOT""_IMPLEMENTED"
marker_todo_developer="TODO: add ""developer-owned"
marker_todo_implement="TODO: ""implement"
if ((${#source_roots[@]})) && grep -R -n \
  -e "$marker_not_implemented" \
  -e "$marker_todo_developer" \
  -e "$marker_todo_implement" \
  "${source_roots[@]}" 2>/dev/null; then
  echo "Required protected regions still contain generated default content." >&2
  echo "Fill the relevant manual regions or waive them outside production export." >&2
  exit 1
fi

[%=out.startPreserve("#", "", awsRoot.manualRegionId("validate-models-customizations"), true)%]
# Add repository-specific model validation commands here.
[%=out.stopPreserve()%]
