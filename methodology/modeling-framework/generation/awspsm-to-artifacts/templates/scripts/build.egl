[% /* Generates the build artifact. */ %]#!/usr/bin/env bash
set -euo pipefail

mode_text="${1:-}"

# Keep successfully downloaded modules when a registry connection fails mid-download.
for dependency_attempt in 1 2 3; do
  if go mod tidy; then
    break
  fi
  if [[ "$dependency_attempt" == "3" ]]; then
    echo "Dependency resolution failed after 3 attempts; inspect the registry/network error above." >&2
    exit 1
  fi
  echo "Retrying dependency resolution (attempt $((dependency_attempt + 1))/3)…" >&2
  sleep "$((dependency_attempt * 2))"
done
if [[ "$mode_text" == "--install-only" ]]; then
  exit 0
fi
go test ./...
[% for (awsFn in AWSPSMCOMPUTE!AwsLambdaFunction.all.sortBy(awsFn | awsFn.cfnLogicalId())) { %]
mkdir -p "bin/[%= awsFn.functionPathSegment(emitCtx) %]"
[% if (awsFn.architecture.isDefined() and awsFn.architecture.asString() = "ARM64") { %]
GOOS=linux GOARCH=arm64 go build -o "bin/[%= awsFn.functionPathSegment(emitCtx) %]/bootstrap" "./[%= awsFn.sourcePath() %]"
[% } else { %]
GOOS=linux GOARCH=amd64 go build -o "bin/[%= awsFn.functionPathSegment(emitCtx) %]/bootstrap" "./[%= awsFn.sourcePath() %]"
[% } %]
[% } %]

[%=out.startPreserve("#", "", awsRoot.manualRegionId("build-customizations"), true)%]
# Add project-specific build steps here.
[%=out.stopPreserve()%]
