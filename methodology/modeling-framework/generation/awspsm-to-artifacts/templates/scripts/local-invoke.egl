[% /* Generates the local invoke artifact. */ %]#!/usr/bin/env bash
set -euo pipefail

function_logical_id="${1:?Usage: scripts/local-invoke.sh <FunctionLogicalId> <event-json>}"
event_path="${2:?Usage: scripts/local-invoke.sh <FunctionLogicalId> <event-json>}"
mapfile -t matching_templates < <(grep -l "^  ${function_logical_id}:$" infrastructure/units/*/template*.yaml template*.yaml 2>/dev/null | sort)
if [[ "${#matching_templates[@]}" -ne 1 ]]; then
  echo "Expected exactly one template containing ${function_logical_id}; found ${#matching_templates[@]}." >&2
  exit 2
fi
template_path="${matching_templates[0]}"
build_dir=".aws-sam/local-invoke-${function_logical_id}"
sam_config_file="infrastructure/samconfig.toml"
if [[ "$template_path" == infrastructure/units/* ]]; then sam_config_file="../../samconfig.toml"; fi
sam build --config-file "$sam_config_file" --template-file "$template_path" --build-dir "$build_dir"
sam local invoke "$function_logical_id" --config-file "../../infrastructure/samconfig.toml" --template "$build_dir/template.yaml" --event "$event_path"

[%=out.startPreserve("#", "", awsRoot.manualRegionId("local-invoke-customizations"), true)%]
# Add local environment wiring here.
[%=out.stopPreserve()%]
