[% /* Generates the shared errors artifact. */ %]package runtime

import "encoding/json"
import "errors"

type GeneratedHandlerError struct {
	Code    string
	Message string
}

func NewGeneratedHandlerError(codeText string, messageText string) GeneratedHandlerError {
	return GeneratedHandlerError{Code: codeText, Message: messageText}
}

func (errObj GeneratedHandlerError) Error() string {
	return errObj.Code + ": " + errObj.Message
}

type GeneratedErrorResponse struct {
	StatusCode int               `json:"statusCode"`
	Headers    map[string]string `json:"headers"`
	Body       string            `json:"body"`
}

func JSONBody(value any) string {
	bodyBytes, err := json.Marshal(value)
	if err != nil {
		return `{"code":"INTERNAL_ERROR","message":"Response serialization failed"}`
	}
	return string(bodyBytes)
}

func MapKnownError(err error, correlationID string, modeledStatusByCode map[string]int, modeledCodeByStatus map[int]string) GeneratedErrorResponse {
	statusCode := 500
	codeText := "INTERNAL_ERROR"
	messageText := "Internal server error"
	var generatedErr GeneratedHandlerError
	if errors.As(err, &generatedErr) {
		if modeledStatus, ok := modeledStatusByCode[generatedErr.Code]; ok {
			statusCode = modeledStatus
			codeText = generatedErr.Code
			messageText = generatedErr.Message
		} else if generatedErr.Code == "VALIDATION_ERROR" {
			// The generic request decoder can identify malformed input before application code
			// selects a domain error. Use the API's modeled 400 contract, when one exists.
			if modeledCode, ok := modeledCodeByStatus[400]; ok {
				statusCode = 400
				codeText = modeledCode
				messageText = generatedErr.Message
			}
		}
	}
	return GeneratedErrorResponse{
		StatusCode: statusCode,
		Headers: map[string]string{
			"content-type":     "application/json",
			"x-correlation-id": correlationID,
		},
		Body: JSONBody(map[string]any{"code": codeText, "message": messageText, "correlationId": correlationID}),
	}
}

// IsApiGatewayEvent identifies the HTTP proxy envelope so business failures can
// be returned as HTTP responses while workflow failures remain Lambda errors.
func IsApiGatewayEvent(event map[string]any) bool {
	_, ok := event["requestContext"].(map[string]any)
	return ok
}
