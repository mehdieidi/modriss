[% /* Generates the shared config artifact. */ %]package shared

import "os"

type GeneratedConfig struct {
	Stage             string
	EventBridgeBusArn string
}

func LoadConfig() GeneratedConfig {
	stageText := os.Getenv("STAGE")
	if stageText == "" {
		stageText = "local"
	}
	return GeneratedConfig{
		Stage:             stageText,
		EventBridgeBusArn: os.Getenv("EVENTBRIDGE_BUS_ARN"),
	}
}
