[% /* Generates the shared tracer artifact. */ %]package shared

type Tracer struct {
	CorrelationID  string
	SourceStableID string
}

func NewTracer(correlationID string, sourceStableID string) Tracer {
	return Tracer{CorrelationID: correlationID, SourceStableID: sourceStableID}
}

func (tracerObj Tracer) Flush() {
}
