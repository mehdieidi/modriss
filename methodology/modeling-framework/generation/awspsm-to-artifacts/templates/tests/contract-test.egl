[% /* Generates the contract test artifact. */ %]package contract

import (
	"encoding/json"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestGeneratedJSONContractsParse(t *testing.T) {
	for _, rootText := range []string{"../../schemas", "../../src/functions", "../../events/samples", "../../asl"} {
		if _, err := os.Stat(rootText); err != nil {
			continue
		}
		err := filepath.WalkDir(rootText, func(pathText string, entryObj os.DirEntry, walkErr error) error {
			if walkErr != nil || entryObj.IsDir() || filepath.Ext(pathText) != ".json" {
				return walkErr
			}
			encodedBytes, err := os.ReadFile(pathText)
			if err != nil {
				return err
			}
			if err := rejectCaseInsensitiveDuplicateJSONKeys(strings.NewReader(string(encodedBytes))); err != nil {
				return fmt.Errorf("%s: %w", pathText, err)
			}
			var decodedObj any
			return json.Unmarshal(encodedBytes, &decodedObj)
		})
		if err != nil {
			t.Fatalf("contract JSON parse failed: %v", err)
		}
	}
[%=out.startPreserve("/*", "*/", awsRoot.manualRegionId("contract-custom-assertions"), true)%]
	if false {
		t.Fatal("unreachable custom assertion guard")
	}
[%=out.stopPreserve()%]
}

func rejectCaseInsensitiveDuplicateJSONKeys(readerObj io.Reader) error {
	decoderObj := json.NewDecoder(readerObj)
	if err := scanJSONValue(decoderObj); err != nil {
		return err
	}
	if _, err := decoderObj.Token(); err != io.EOF {
		return fmt.Errorf("expected end of JSON document")
	}
	return nil
}

func scanJSONValue(decoderObj *json.Decoder) error {
	tokenObj, err := decoderObj.Token()
	if err != nil {
		return err
	}
	delimiterObj, isDelimiter := tokenObj.(json.Delim)
	if !isDelimiter {
		return nil
	}

	switch delimiterObj {
	case '{':
		seenKeys := map[string]string{}
		for decoderObj.More() {
			keyToken, err := decoderObj.Token()
			if err != nil {
				return err
			}
			keyText := keyToken.(string)
			normalizedKey := strings.ToLower(keyText)
			if previousKey, exists := seenKeys[normalizedKey]; exists {
				return fmt.Errorf("object keys %q and %q differ only by case", previousKey, keyText)
			}
			seenKeys[normalizedKey] = keyText
			if err := scanJSONValue(decoderObj); err != nil {
				return err
			}
		}
	case '[':
		for decoderObj.More() {
			if err := scanJSONValue(decoderObj); err != nil {
				return err
			}
		}
	default:
		return fmt.Errorf("unexpected JSON delimiter %q", delimiterObj)
	}

	_, err = decoderObj.Token()
	return err
}
