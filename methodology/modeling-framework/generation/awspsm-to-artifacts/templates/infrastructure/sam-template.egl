[% /* Generates the sam template artifact. */ %]AWSTemplateFormatVersion: '2010-09-09'
[% if (stackObj.useSamTransform.isUndefined() or stackObj.useSamTransform = true) { %]
Transform: AWS::Serverless-2016-10-31
[% } %]
Description: [%= stackObj.templateDescription.orElseText(emitCtx.get("projectName") + " generated serverless stack") %]

[%= stackObj.parametersSection() %]
[%= stackObj.mappingsSection() %]
[%= stackObj.conditionsSection() %]
[%= stackObj.globalsSection(awsRoot) %]
[% /* Resources are emitted in dependency order so generated templates remain deterministic. */ %][%= stackObj.resourcesSection(emitCtx) %]
[%= stackObj.outputsSection() %]
[%= out.startPreserve("#", "", stackObj.manualRegionId("yaml-extension"), true) %]
# Optional developer-owned CloudFormation/SAM additions that cannot yet be represented in the PSM.
[%= out.stopPreserve() %]

[%
@template
/** Computes parameters section. */
operation AWSPSMCORE!SamStack parametersSection() { %]
[% if (self.uniqueParameters().notEmpty()) { %]
Parameters:
[% for (paramObj in self.uniqueParameters()) { %]
  [%= paramObj.parameterName.toCfnLogicalId() %]:
[%= emitYamlScalarProperty("Type", paramObj.cloudFormationType(), 4) %]
[%= emitYamlScalarProperty("Description", paramObj.parameterDescription, 4) %]
[% if (paramObj.defaultValue.isDefined()) { %][%= paramObj.defaultValue.emitCfnValueProperty("Default", 4) %][% } %]
[%= emitYamlStringListProperty("AllowedValues", paramObj.allowedValues, 4) %]
[%= emitYamlScalarProperty("AllowedPattern", paramObj.allowedPattern, 4) %]
[%= emitYamlBooleanProperty("NoEcho", paramObj.noEcho, 4) %]
[% } %]

[% } %]
[% }

/** Maps common model-friendly aliases to valid CloudFormation parameter type names. */
operation AWSPSMCORE!CfnParameter cloudFormationType() : String {
  var typeText = self.type.trim();
  if (typeText.toUpperCase() = "STRING") return "String";
  if (typeText.toUpperCase() = "NUMBER") return "Number";
  if (typeText.toUpperCase() = "LIST_NUMBER" or typeText.toUpperCase() = "LIST<NUMBER>") return "List<Number>";
  if (typeText.toUpperCase() = "STRING_LIST" or typeText.toUpperCase() = "COMMA_DELIMITED_LIST") return "CommaDelimitedList";
  return typeText;
}

@template
/** Computes mappings section. */
operation AWSPSMCORE!SamStack mappingsSection() { %]
[% if (self.mappings.notEmpty()) { %]
Mappings:
[% for (mappingObj in self.mappings.sortBy(mappingObj | mappingObj.mappingName)) { %]
[% if (mappingObj.content.isPresent()) { %][%= yamlBlock(mappingObj.mappingName.toCfnLogicalId(), mappingObj.content, 2) %][% } %]
[% } %]

[% } %]
[% }

@template
/** Computes conditions section. */
operation AWSPSMCORE!SamStack conditionsSection() { %]
[% if (self.conditions.notEmpty()) { %]
Conditions:
[% for (condObj in self.conditions.sortBy(condObj | condObj.conditionName)) { %]
[% if (condObj.expressionValue.isDefined()) { %][%= condObj.expressionValue.emitCfnValueProperty(condObj.conditionName.toCfnLogicalId(), 2) %][% } else { %]  [%= condObj.conditionName.toCfnLogicalId() %]: [%= condObj.expression.orElseText("true") %]
[% } %]
[% } %]

[% } %]
[% }

@template
/** Computes globals section. */
operation AWSPSMCORE!SamStack globalsSection(awsRoot : AWSPSM!AwsPsmModel) { %]
[% if (awsRoot.samGlobals.isDefined() or self.globals.notEmpty()) { %]
Globals:
[% if (awsRoot.samGlobals.isDefined()) { %][%= awsRoot.samGlobals.samGlobalsBody() %][% } %]
[% if (self.globals.notEmpty()) { %][%= self.globals.emitNativePropertiesYaml(2) %][% } %]

[% } %]
[% }

/** Computes sam globals body. */
operation AWSPSMCORE!SamGlobals samGlobalsBody() : String {
  var outText = "";
  if (self.functionGlobals.notEmpty()) {
    outText = outText + "  Function:\n";
    for (globalObj in self.functionGlobals) {
      if (globalObj.propertyName = "RuntimeManagementConfig") {
        outText =
          outText
          + "    RuntimeManagementConfig:\n"
          + "      UpdateRuntimeOn: "
          + globalObj.value.cfnInlineYaml()
          + "\n";
      }
      else {
        outText = outText + globalObj.emitNativePropertyYaml(4);
      }
    }
  }
  if (self.apiGlobals.notEmpty()) {
    outText = outText + "  Api:\n" + self.apiGlobals.emitNativePropertiesYaml(4);
  }
  if (self.httpApiGlobals.notEmpty()) {
    outText = outText + "  HttpApi:\n" + self.httpApiGlobals.emitNativePropertiesYaml(4);
  }
  if (self.stateMachineGlobals.notEmpty()) {
    outText = outText + "  StateMachine:\n" + self.stateMachineGlobals.emitNativePropertiesYaml(4);
  }
  return outText;
}

@template
/** Computes resources section. */
operation AWSPSMCORE!SamStack resourcesSection(emitCtx : Map) { %]
[% if (self.resources.notEmpty()) { %]
Resources:
[% for (resObj in self.orderedResources()) { %]
[%= resObj.emitCfnResourceYaml(emitCtx) %]
[% } %]

[% } %]
[% }

@template
/** Computes outputs section. */
operation AWSPSMCORE!SamStack outputsSection() { %]
[% if (self.outputs.notEmpty()) { %]
Outputs:
[% for (outObj in self.outputs.sortBy(outObj | outObj.outputName)) { %]
  [%= outObj.outputName.toCfnLogicalId() %]:
[%= emitYamlScalarProperty("Description", outObj.outputDescription.orElseText(outObj.outputName), 4) %]
[%= outObj.value.emitCfnValueProperty("Value", 4) %]
[% if (outObj.exportName.isPresent()) { %]    Export:
[%= emitYamlScalarProperty("Name", outObj.exportName, 6) %][% } %]
[% } %]

[% } %]
[% }
%]
